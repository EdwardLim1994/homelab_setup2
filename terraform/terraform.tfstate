              "F-22-rollback-story.json": "{\r\n  \"name\": \"F-22 /rollback_story\",\r\n  \"nodes\": [\r\n    {\r\n      \"id\": \"fad1f1c4-8a4f-4088-8a6f-09f0aa09e331\",\r\n      \"name\": \"Webhook Trigger\",\r\n      \"type\": \"n8n-nodes-base.webhook\",\r\n      \"typeVersion\": 2,\r\n      \"position\": [\r\n        240,\r\n        300\r\n      ],\r\n      \"parameters\": {\r\n        \"path\": \"rollback-story\",\r\n        \"httpMethod\": \"POST\",\r\n        \"responseMode\": \"onReceived\",\r\n        \"responseData\": \"allEntries\"\r\n      },\r\n      \"webhookId\": \"a4896378-3cae-46f1-863a-2e798a4879d8\"\r\n    },\r\n    {\r\n      \"id\": \"9e00da93-455c-423e-9e11-d7f91658e720\",\r\n      \"name\": \"Respond OK\",\r\n      \"type\": \"n8n-nodes-base.respondToWebhook\",\r\n      \"typeVersion\": 1,\r\n      \"position\": [\r\n        460,\r\n        300\r\n      ],\r\n      \"parameters\": {\r\n        \"respondWith\": \"json\",\r\n        \"responseBody\": \"{\\\"status\\\":\\\"accepted\\\"}\"\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"09ac856d-3d58-4321-b07d-ce705b364c9a\",\r\n      \"name\": \"Notify: Story rollback started\",\r\n      \"type\": \"n8n-nodes-base.httpRequest\",\r\n      \"typeVersion\": 4.2,\r\n      \"position\": [\r\n        680,\r\n        300\r\n      ],\r\n      \"parameters\": {\r\n        \"method\": \"POST\",\r\n        \"url\": \"={{ $env.OPENWEBUI_CALLBACK_URL }}\",\r\n        \"sendHeaders\": true,\r\n        \"headerParameters\": {\r\n          \"parameters\": [\r\n            {\r\n              \"name\": \"Content-Type\",\r\n              \"value\": \"application/json\"\r\n            }\r\n          ]\r\n        },\r\n        \"sendBody\": true,\r\n        \"bodyParameters\": {\r\n          \"parameters\": [\r\n            {\r\n              \"name\": \"flow_id\",\r\n              \"value\": \"={{ $json.flow_id ?? '' }}\"\r\n            },\r\n            {\r\n              \"name\": \"message\",\r\n              \"value\": \"\\u23ea Story rollback initiated for {{ $json.body.story_id }}\"\r\n            },\r\n            {\r\n              \"name\": \"notes\",\r\n              \"value\": \"\"\r\n            }\r\n          ]\r\n        }\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"47c483dc-4cf8-4115-87b0-c692f9512572\",\r\n      \"name\": \"TL: Dependency Check\",\r\n      \"type\": \"n8n-nodes-base.executeCommand\",\r\n      \"typeVersion\": 1,\r\n      \"position\": [\r\n        900,\r\n        300\r\n      ],\r\n      \"parameters\": {\r\n        \"command\": \"omp --role tech-lead --model slow --project {{ $env.REPO_DIR }} --prompt 'Check if story {{ $json.body.story_id }} has downstream dependents already merged. Output: safe/blocked with list.' --non-interactive\"\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"26772671-af9c-4ef6-b1cb-86213621a230\",\r\n      \"name\": \"Safe to Revert?\",\r\n      \"type\": \"n8n-nodes-base.if\",\r\n      \"typeVersion\": 2,\r\n      \"position\": [\r\n        1120,\r\n        300\r\n      ],\r\n      \"parameters\": {\r\n        \"conditions\": {\r\n          \"options\": {\r\n            \"leftValue\": \"={{ JSON.parse($json.stdout).status }}\",\r\n            \"operation\": \"equals\",\r\n            \"rightValue\": \"safe\"\r\n          }\r\n        }\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"6eec7698-ac02-4554-b95e-15786702d88e\",\r\n      \"name\": \"TL: Open Revert MR\",\r\n      \"type\": \"n8n-nodes-base.executeCommand\",\r\n      \"typeVersion\": 1,\r\n      \"position\": [\r\n        1340,\r\n        200\r\n      ],\r\n      \"parameters\": {\r\n        \"command\": \"opencode --role tech-lead --model sonnet --prompt 'Open revert MR for us/{{ $json.body.story_id }} via glab. Notify Edward for merge.' --non-interactive\"\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"18aa5a88-e841-418f-ac64-474d92749e96\",\r\n      \"name\": \"Notify: Revert MR ready\",\r\n      \"type\": \"n8n-nodes-base.httpRequest\",\r\n      \"typeVersion\": 4.2,\r\n      \"position\": [\r\n        1560,\r\n        200\r\n      ],\r\n      \"parameters\": {\r\n        \"method\": \"POST\",\r\n        \"url\": \"={{ $env.OPENWEBUI_CALLBACK_URL }}\",\r\n        \"sendHeaders\": true,\r\n        \"headerParameters\": {\r\n          \"parameters\": [\r\n            {\r\n              \"name\": \"Content-Type\",\r\n              \"value\": \"application/json\"\r\n            }\r\n          ]\r\n        },\r\n        \"sendBody\": true,\r\n        \"bodyParameters\": {\r\n          \"parameters\": [\r\n            {\r\n              \"name\": \"flow_id\",\r\n              \"value\": \"={{ $json.flow_id ?? '' }}\"\r\n            },\r\n            {\r\n              \"name\": \"message\",\r\n              \"value\": \"\\ud83d\\udc64 Revert MR ready \\u2014 Edward please merge to complete rollback\"\r\n            },\r\n            {\r\n              \"name\": \"notes\",\r\n              \"value\": \"\"\r\n            }\r\n          ]\r\n        }\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"f7e91a1d-f23f-450b-81f7-f2dc6a064ed8\",\r\n      \"name\": \"Notify: Rollback blocked\",\r\n      \"type\": \"n8n-nodes-base.httpRequest\",\r\n      \"typeVersion\": 4.2,\r\n      \"position\": [\r\n        1340,\r\n        400\r\n      ],\r\n      \"parameters\": {\r\n        \"method\": \"POST\",\r\n        \"url\": \"={{ $env.OPENWEBUI_CALLBACK_URL }}\",\r\n        \"sendHeaders\": true,\r\n        \"headerParameters\": {\r\n          \"parameters\": [\r\n            {\r\n              \"name\": \"Content-Type\",\r\n              \"value\": \"application/json\"\r\n            }\r\n          ]\r\n        },\r\n        \"sendBody\": true,\r\n        \"bodyParameters\": {\r\n          \"parameters\": [\r\n            {\r\n              \"name\": \"flow_id\",\r\n              \"value\": \"={{ $json.flow_id ?? '' }}\"\r\n            },\r\n            {\r\n              \"name\": \"message\",\r\n              \"value\": \"\\ud83d\\udeab Story rollback blocked \\u2014 dependents found: {{ JSON.parse($node['TL: Dependency Check'].json.stdout).list }}\"\r\n            },\r\n            {\r\n              \"name\": \"notes\",\r\n              \"value\": \"\"\r\n            }\r\n          ]\r\n        }\r\n      }\r\n    }\r\n  ],\r\n  \"connections\": {\r\n    \"fad1f1c4-8a4f-4088-8a6f-09f0aa09e331\": {\r\n      \"main\": [\r\n        [\r\n          {\r\n            \"node\": \"9e00da93-455c-423e-9e11-d7f91658e720\",\r\n            \"type\": \"main\",\r\n            \"index\": 0\r\n          },\r\n          {\r\n            \"node\": \"09ac856d-3d58-4321-b07d-ce705b364c9a\",\r\n            \"type\": \"main\",\r\n            \"index\": 0\r\n          }\r\n        ]\r\n      ]\r\n    },\r\n    \"09ac856d-3d58-4321-b07d-ce705b364c9a\": {\r\n      \"main\": [\r\n        [\r\n          {\r\n            \"node\": \"47c483dc-4cf8-4115-87b0-c692f9512572\",\r\n            \"type\": \"main\",\r\n            \"index\": 0\r\n          }\r\n        ]\r\n      ]\r\n    },\r\n    \"47c483dc-4cf8-4115-87b0-c692f9512572\": {\r\n      \"main\": [\r\n        [\r\n          {\r\n            \"node\": \"26772671-af9c-4ef6-b1cb-86213621a230\",\r\n            \"type\": \"main\",\r\n            \"index\": 0\r\n          }\r\n        ]\r\n      ]\r\n    },\r\n    \"26772671-af9c-4ef6-b1cb-86213621a230\": {\r\n      \"main\": [\r\n        [\r\n          {\r\n            \"node\": \"6eec7698-ac02-4554-b95e-15786702d88e\",\r\n            \"type\": \"main\",\r\n            \"index\": 0\r\n          }\r\n        ],\r\n        [\r\n          {\r\n            \"node\": \"f7e91a1d-f23f-450b-81f7-f2dc6a064ed8\",\r\n            \"type\": \"main\",\r\n            \"index\": 0\r\n          }\r\n        ]\r\n      ]\r\n    },\r\n    \"6eec7698-ac02-4554-b95e-15786702d88e\": {\r\n      \"main\": [\r\n        [\r\n          {\r\n            \"node\": \"18aa5a88-e841-418f-ac64-474d92749e96\",\r\n            \"type\": \"main\",