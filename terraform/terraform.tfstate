            "set_sensitive": [],
            "skip_crds": false,
            "status": "deployed",
            "timeout": 900,
            "upgrade_install": null,
            "values": [
              "# ponytail: terraform/Tiltfile do a plain string-replace of desktop-qv5aogf.tail60240b.ts.net across\n# this file, so exposing it as a value lets templates/dashboards.yaml reuse the\n# substituted host without a second injection path.\ntsHost: \"desktop-qv5aogf.tail60240b.ts.net\"\n# ponytail: tailnet MagicDNS suffix — dashboards/*.json use https://\u003capp\u003e.tail60240b.ts.net\n# for their nav links now that each app has its own tailscale-operator host.\ntailnetDomain: \"tail60240b.ts.net\"\n\ngrafana:\n  # ponytail: chart refuses to render any sensitive key (client_secret,\n  # adminPassword, etc.) in plain values as a guard against accidental\n  # secret commits. Our placeholder-replacement approach handles this at\n  # Tiltfile load time — disable the guard so helm template succeeds.\n  assertNoLeakedSecrets: false\n\n  adminPassword: \"dev-grafana-admin-password\"\n\n  grafana.ini:\n    server:\n      root_url: \"https://grafana.tail60240b.ts.net\"\n    auth:\n      # ponytail: keep login form so local admin still works as fallback\n      disable_login_form: \"false\"\n      # ponytail: Grafana 11+ defaults this false and stops matching an OAuth\n      # login to an existing user by email — so when Authentik's `sub` changes\n      # (provider re-provisioned on a cluster rebuild), the old user row is\n      # orphaned and login dies with \"user.sync: unable to create user: user\n      # not found\". Authentik verifies the email, so matching on it is safe here.\n      oauth_allow_insecure_email_lookup: \"true\"\n    auth.generic_oauth:\n      enabled: \"true\"\n      name: \"Authentik\"\n      client_id: \"dev-grafana-oidc-client-id\"\n      client_secret: \"dev-grafana-oidc-client-secret-not-for-prod-use\"\n      scopes: \"openid profile email\"\n      auth_url: \"https://authentik.tail60240b.ts.net/application/o/authorize/\"\n      # ponytail: token/userinfo use in-cluster DNS — browser never touches\n      # these endpoints so no need for the Tailscale HTTPS port here.\n      token_url: \"http://authentik-server.authentik.svc.cluster.local/application/o/token/\"\n      api_url: \"http://authentik-server.authentik.svc.cluster.local/application/o/userinfo/\"\n      role_attribute_path: \"email == 'edwardlimkoksiong1994@gmail.com' \u0026\u0026 'Admin' || 'Viewer'\"\n      allow_sign_up: \"true\"\n\n  datasources:\n    datasources.yaml:\n      apiVersion: 1\n      datasources:\n        - name: Mimir\n          uid: mimir\n          type: prometheus\n          url: http://observability-mimir-query-frontend.observability.svc.cluster.local:8080/prometheus\n          isDefault: true\n          jsonData:\n            timeInterval: 15s\n        - name: Prometheus\n          uid: prometheus\n          type: prometheus\n          url: http://observability-prometheus-server.observability.svc.cluster.local\n          jsonData:\n            timeInterval: 15s\n        - name: Loki\n          uid: loki\n          type: loki\n          url: http://observability-loki.observability.svc.cluster.local:3100\n        - name: Tempo\n          uid: tempo\n          type: tempo\n          url: http://observability-tempo.observability.svc.cluster.local:3100\n          jsonData:\n            tracesToLogsV2:\n              datasourceUid: loki\n            serviceMap:\n              datasourceUid: mimir\n\n  ingress:\n    enabled: true\n    ingressClassName: traefik\n    annotations:\n      cert-manager.io/cluster-issuer: homelab-ca-issuer\n    hosts:\n      - grafana.local\n    tls:\n      - secretName: grafana.local-tls\n        hosts:\n          - grafana.local\n\n  persistence:\n    enabled: true\n    size: 2Gi\n\n  # ponytail: sidecar auto-loads any ConfigMap in this namespace labelled\n  # grafana_dashboard. templates/dashboards.yaml emits one per dashboards/*.json.\n  sidecar:\n    dashboards:\n      enabled: true\n      label: grafana_dashboard\n      searchNamespace: observability\n      folder: /tmp/dashboards\n      provider:\n        foldersFromFilesStructure: false\n\n  resources:\n    requests:\n      cpu: 50m\n      memory: 128Mi\n    limits:\n      memory: 256Mi\n\n# ── Loki ──────────────────────────────────────────────────────────────────────\nloki:\n  # ponytail: SingleBinary = one pod, no object storage, no kafka, no cache.\n  # SimpleScalable (chart default) needs 3 write + 3 read + 3 backend pods —\n  # far too heavy for a single-node homelab.\n  deploymentMode: SingleBinary\n\n  loki:\n    auth_enabled: false\n    commonConfig:\n      replication_factor: 1\n    storage:\n      type: filesystem\n    schemaConfig:\n      configs:\n        - from: \"2024-01-01\"\n          store: tsdb\n          object_store: filesystem\n          schema: v13\n          index:\n            prefix: index_\n            period: 24h\n\n  singleBinary:\n    replicas: 1\n    persistence:\n      enabled: true\n      size: 10Gi\n    resources:\n      requests:\n        cpu: 50m\n        memory: 256Mi\n      limits:\n        memory: 512Mi\n\n  # ponytail: zero out the scalable-mode components that SingleBinary doesn't use\n  read:\n    replicas: 0\n  write:\n    replicas: 0\n  backend:\n    replicas: 0\n\n  gateway:\n    enabled: false\n  lokiCanary:\n    enabled: false\n  test:\n    enabled: false\n  # ponytail: caches need memcached sub-charts — overkill for homelab\n  chunksCache:\n    enabled: false\n  resultsCache:\n    enabled: false\n\n# ── Tempo ─────────────────────────────────────────────────────────────────────\ntempo:\n  tempo:\n    # ponytail: metrics-generator turns spans into RED metrics (rate/errors/\n    # duration) and remote-writes them to Mimir — that's the latency + traffic\n    # panels. Needs traces flowing in via OTLP (already wired through Alloy).\n    metricsGenerator:\n      enabled: true\n      remoteWriteUrl: \"http://observability-mimir-distributor.observability.svc.cluster.local:8080/api/v1/push\"\n      processor:\n        span_metrics:\n          enable_target_info: true\n        service_graphs: {}\n      storage:\n        path: /var/tempo/generator/wal\n      traces_storage:\n        path: /var/tempo/generator/traces\n    overrides:\n      defaults:\n        metrics_generator:\n          processors:\n            - service-graphs\n            - span-metrics\n    storage:\n      trace:\n        backend: local\n        local:\n          path: /var/tempo/traces\n        wal:\n          path: /var/tempo/wal\n    receivers:\n      otlp:\n        protocols:\n          grpc:\n            endpoint: 0.0.0.0:4317\n          http:\n            endpoint: 0.0.0.0:4318\n\n  persistence:\n    enabled: true\n    size: 10Gi\n\n  resources:\n    requests:\n      cpu: 50m\n      memory: 256Mi\n    limits:\n      memory: 512Mi\n\n# ── Mimir ─────────────────────────────────────────────────────────────────────\nmimir-distributed:\n  # ponytail: chart defaults to ingest-storage architecture (Kafka between\n  # distributor and ingester) — one more stateful thing to babysit for no\n  # benefit on a single-node homelab. Classic push-based ingesters instead.\n  kafka:\n    enabled: false\n\n  mimir:\n    structuredConfig:\n      multitenancy_enabled: false\n      # ponytail: usage-stats reporter defaults to its own S3 bucket client\n      # regardless of common.storage.backend — fails hard with no S3 endpoint\n      # configured. No need for anonymous telemetry on a homelab anyway.\n      usage_stats:\n        enabled: false\n      common:\n        storage:\n          backend: filesystem\n          filesystem:\n            dir: /data\n      # ponytail: chart's base config hardcodes blocks_storage.backend: s3\n      # (for its bundled minio demo) — component-specific config always wins\n      # over `common`, so filesystem must be set here explicitly too.\n      blocks_storage:\n        backend: filesystem\n        # ponytail: must differ from tsdb.dir (chart default /data/tsdb) —\n        # filesystem.dir is the simulated \"bucket\", tsdb.dir is local WAL/head.\n        filesystem:\n          dir: /data/blocks\n      # ponytail: chart default compactor.data_dir is \"/data\", which is a\n      # parent of blocks_storage.filesystem.dir above — must be a sibling.\n      compactor:\n        data_dir: /data/compactor\n      ingest_storage:\n        enabled: false\n      ingester:\n        push_grpc_method_enabled: true\n\n  # ponytail: single replicas throughout — no HA, no zone awareness.\n  # The rollout_operator and zone-aware replication exist for production\n  # multi-zone clusters, not a one-node homelab.\n  rollout_operator:\n    enabled: false\n\n  ingester:\n    replicas: 1\n    zoneAwareReplication:\n      enabled: false\n    persistentVolume:\n      enabled: true\n      size: 10Gi\n    resources:\n      requests:\n        cpu: 50m\n        memory: 256Mi\n      limits:\n        memory: 512Mi\n\n  distributor:\n    replicas: 1\n    resources:\n      requests:\n        cpu: 50m\n        memory: 128Mi\n      limits:\n        memory: 256Mi\n\n  querier:\n    replicas: 1\n    resources:\n      requests:\n        cpu: 50m\n        memory: 128Mi\n      limits:\n        memory: 256Mi\n\n  query_frontend:\n    replicas: 1\n    resources:\n      requests:\n        cpu: 50m\n        memory: 128Mi\n      limits:\n        memory: 256Mi\n\n  compactor:\n    replicas: 1\n    persistentVolume:\n      enabled: true\n      size: 10Gi\n    resources:\n      requests:\n        cpu: 50m\n        memory: 128Mi\n      limits:\n        memory: 256Mi\n\n  store_gateway:\n    replicas: 1\n    zoneAwareReplication:\n      enabled: false\n    persistentVolume:\n      enabled: true\n      size: 10Gi\n    resources:\n      requests:\n        cpu: 50m\n        memory: 128Mi\n      limits:\n        memory: 256Mi\n\n  # ponytail: disable optional components not needed for basic metrics ingestion\n  alertmanager:\n    enabled: false\n  ruler:\n    enabled: false\n  query_scheduler:\n    enabled: false\n  overrides_exporter:\n    enabled: false\n\n  # ponytail: mimir-distributed bundles its own minio subchart for demos;\n  # we use the already-deployed MinIO in the minio namespace instead.\n  minio:\n    enabled: false\n\n# ── Alloy ─────────────────────────────────────────────────────────────────────\nalloy:\n  alloy:\n    # ponytail: extraPorts needed so the Service exposes OTLP endpoints\n    # for apps to send traces/metrics/logs to. Without this, only Alloy's\n    # own UI port (12345) is in the Service spec.\n    extraPorts:\n      - name: otlp-grpc\n        port: 4317\n        targetPort: 4317\n        protocol: TCP\n      - name: otlp-http\n        port: 4318\n        targetPort: 4318\n        protocol: TCP\n\n    configMap:\n      content: |\n        // ── K8s pod logs → Loki ──────────────────────────────────────────────\n        discovery.kubernetes \"pods\" {\n          role = \"pod\"\n        }\n\n        discovery.relabel \"pod_logs\" {\n          targets = discovery.kubernetes.pods.targets\n          rule {\n            source_labels = [\"__meta_kubernetes_pod_node_name\"]\n            target_label  = \"node\"\n          }\n          rule {\n            source_labels = [\"__meta_kubernetes_namespace\"]\n            target_label  = \"namespace\"\n          }\n          rule {\n            source_labels = [\"__meta_kubernetes_pod_name\"]\n            target_label  = \"pod\"\n          }\n          rule {\n            source_labels = [\"__meta_kubernetes_pod_container_name\"]\n            target_label  = \"container\"\n          }\n          rule {\n            source_labels = [\"__meta_kubernetes_pod_label_app_kubernetes_io_name\"]\n            target_label  = \"app\"\n          }\n        }\n\n        loki.source.kubernetes \"pods\" {\n          targets    = discovery.relabel.pod_logs.output\n          forward_to = [loki.write.default.receiver]\n        }\n\n        loki.write \"default\" {\n          endpoint {\n            url = \"http://observability-loki.observability.svc.cluster.local:3100/loki/api/v1/push\"\n          }\n        }\n\n        // ── OTLP receiver (apps → Alloy) ─────────────────────────────────────\n        otelcol.receiver.otlp \"default\" {\n          http { endpoint = \"0.0.0.0:4318\" }\n          grpc { endpoint = \"0.0.0.0:4317\" }\n          output {\n            metrics = [otelcol.exporter.prometheus.mimir.input]\n            logs    = [otelcol.exporter.loki.default.input]\n            traces  = [otelcol.exporter.otlp.tempo.input]\n          }\n        }\n\n        // ── OTLP metrics → Mimir ─────────────────────────────────────────────\n        otelcol.exporter.prometheus \"mimir\" {\n          forward_to = [prometheus.remote_write.mimir.receiver]\n        }\n\n        prometheus.remote_write \"mimir\" {\n          endpoint {\n            url = \"http://observability-mimir-distributor.observability.svc.cluster.local:8080/api/v1/push\"\n          }\n        }\n\n        // ── OTLP logs → Loki ─────────────────────────────────────────────────\n        otelcol.exporter.loki \"default\" {\n          forward_to = [loki.write.default.receiver]\n        }\n\n        // ── OTLP traces → Tempo ──────────────────────────────────────────────\n        otelcol.exporter.otlp \"tempo\" {\n          client {\n            endpoint = \"observability-tempo.observability.svc.cluster.local:4317\"\n            tls { insecure = true }\n          }\n        }\n\n  clustering:\n    enabled: false\n\n  rbac:\n    create: true\n\n  serviceAccount:\n    create: true\n\n# ── Prometheus ────────────────────────────────────────────────────────────────\nprometheus:\n  server:\n    global:\n      scrape_interval: 15s\n      evaluation_interval: 15s\n    # ponytail: remote_write to Mimir so metrics survive beyond Prometheus's\n    # own retention window and are queryable from Grafana's Mimir datasource.\n    remoteWrite:\n      - url: \"http://observability-mimir-distributor.observability.svc.cluster.local:8080/api/v1/push\"\n    persistentVolume:\n      enabled: true\n      size: 10Gi\n    # ponytail: 3d not 7d — one node, cadvisor + kube-state + node-exporter +\n    # traefik is a lot of series; longer history lives in Mimir via remoteWrite.\n    retention: \"3d\"\n    resources:\n      requests:\n        cpu: 50m\n        # ponytail: 512Mi OOMKills mid-WAL-replay -\u003e 503 on every query -\u003e\n        # crashloop. WAL replay is the memory peak; 2Gi clears it. Drop back\n        # toward 1Gi if the node gets tight.\n        memory: 512Mi\n      limits:\n        memory: 2Gi\n\n  alertmanager:\n    enabled: false\n  prometheus-pushgateway:\n    enabled: false\n  kube-state-metrics:\n    enabled: true\n  prometheus-node-exporter:\n    enabled: true\n\n# dashboards-hash: 362f901177022faaa1ff3a30e3384f05f35b8601"
            ],
            "verify": false,
            "version": "0.1.0",
            "wait": false,
            "wait_for_jobs": false
          },
          "sensitive_attributes": [
            [
              {
                "type": "get_attr",
                "value": "repository_password"
              }
            ],
            [
              {
                "type": "get_attr",
                "value": "values"
              },
              {
                "type": "index",
                "value": {
                  "value": 0,
                  "type": "number"
                }
              }
            ]
          ],
          "private": "eyJzY2hlbWFfdmVyc2lvbiI6IjEifQ==",
          "dependencies": [
            "kubernetes_namespace.observability"
          ]
        }
      ]
    },
    {
      "mode": "managed",
      "type": "helm_release",
      "name": "omp",
      "provider": "provider[\"registry.opentofu.org/hashicorp/helm\"]",
      "instances": [
        {
          "schema_version": 1,
          "attributes": {
            "atomic": false,
            "chart": "./../helm/omp",
            "cleanup_on_fail": false,
            "create_namespace": false,
            "dependency_update": true,
            "description": null,
            "devel": null,
            "disable_crd_hooks": false,
            "disable_openapi_validation": false,
            "disable_webhooks": false,
            "force_update": false,
            "id": "omp",
            "keyring": null,
            "lint": false,
            "manifest": null,
            "max_history": 0,
            "metadata": [
              {
                "app_version": "",
                "chart": "omp",
                "first_deployed": 1789017132,
                "last_deployed": 1789017132,
                "name": "omp",
                "namespace": "omp",
                "notes": "",
                "revision": 1,
                "values": "{\"adapter\":{\"enabled\":true,\"image\":\"python:3.12-slim\",\"port\":8000},\"args\":[\"/opt/pod-openai.py\"],\"claudeAuth\":{\"secretName\":\"omp-claude-auth\"},\"command\":[\"python3\"],\"dockerSocket\":{\"enabled\":false,\"hostPath\":\"/var/run/docker.sock\"},\"env\":{},\"image\":\"k3d-registry:5111/omp-box:dev\",\"persistence\":{\"enabled\":true,\"size\":\"20Gi\"},\"port\":4096,\"replicas\":0,\"resources\":{\"limits\":{\"memory\":\"2Gi\"},\"requests\":{\"cpu\":\"250m\",\"memory\":\"512Mi\"}},\"roles\":[\"backend-developer\",\"data-engineer\",\"devops-engineer\",\"frontend-developer\",\"product-owner\",\"project-manager\",\"qa-engineer\",\"release-manager\",\"security-engineer\",\"solution-architect\",\"tech-lead\",\"uiux-designer\"],\"skillsRepo\":\"\",\"slots\":{\"count\":3,\"defaultSkillsRepo\":\"http://gitlab-webservice-default.gitlab.svc:8181/EdwardLim1994/internal-agent-skills.git\"},\"spawner\":{\"enabled\":true,\"subjectServiceAccount\":{\"name\":\"n8n\",\"namespace\":\"n8n\"}}}",
                "version": "0.1.0"
              }
            ],
            "name": "omp",
            "namespace": "omp",
            "pass_credentials": false,
            "postrender": [],
            "recreate_pods": false,
            "render_subchart_notes": true,
            "replace": false,
            "repository": null,
            "repository_ca_file": null,
            "repository_cert_file": null,
            "repository_key_file": null,
            "repository_password": null,
            "repository_username": null,
            "reset_values": false,
            "reuse_values": false,
            "set": [
              {
                "name": "dockerSocket.enabled",
                "type": "",
                "value": "false"
              },
              {
                "name": "image",
                "type": "",
                "value": "k3d-registry:5111/omp-box:dev"
              }
            ],
            "set_list": [],
            "set_sensitive": [],
            "skip_crds": false,
            "status": "deployed",
            "timeout": 300,
            "upgrade_install": null,
            "values": [
              "# ponytail: one Deployment + Service + PVC. No HPA, no ServiceAccount, no\n# Ingress until something needs them.\nimage: omp-box:dev\n\n# ponytail: scale-to-zero by default = \"waked on demand\". Wake it with\n#   kubectl -n omp scale deploy/omp --replicas=1\n# and let it idle back to 0 (cron, or by hand). Swap in KEDA http-add-on\n# only if you want an inbound request to trigger the wake.\nreplicas: 0\n\n# ponytail: keep `port` and the pod-openai shim's PORT in sync — single knob.\n# The pod runs pod-openai.py (OpenAI-compatible API backed by a persistent\n# `omp --mode rpc` session). Interactive TUI is still `kubectl exec -it\n# deploy/omp -- omp`.\nport: 4096\ncommand: [\"python3\"]\nargs: [\"/opt/pod-openai.py\"]\n\nenv: {}\n\n# ponytail: Secret (key CLAUDE_CODE_OAUTH_TOKEN) mounted as envFrom into every\n# omp pod — used when a pod runs the `claude` CLI instead of omp. The Tiltfile\n# creates it from TF_VAR_claude_code_token in .env. Set secretName: \"\" to drop\n# the mount entirely.\nclaudeAuth:\n  secretName: omp-claude-auth\n\n# ponytail: git URL of a skills repo (layout: skills/\u003cname\u003e/SKILL.md, same as\n# caveman/ponytail). When set, an initContainer clones it and the main\n# container copies skills/* into omp's skill dir on start — on top of the\n# caveman/ponytail skills already baked into the image. Empty = image skills\n# only. This is the per-agent knob a spawned pod overrides.\nskillsRepo: \"\"\n\n# ponytail: pre-created scale-to-zero pods the spawn-agent flow claims. Each\n# renders with the fetch-skills initContainer already wired (cloning\n# defaultSkillsRepo); the flow PATCHes replicas=1 + that initContainer's\n# args to the repo it actually wants. Point defaultSkillsRepo at the\n# homelab skills repo once it exists.\nslots:\n  count: 3\n  # ponytail: in-cluster clone URL — pods reach GitLab by Service DNS, not the\n  # tailnet name (no SSH exposed, and the tailnet round-trips out and back).\n  # Private repo: prefix creds, e.g.\n  #   http://oauth2:\u003cproject-access-token\u003e@gitlab-webservice-default.gitlab.svc:8181/\u003cgroup\u003e/\u003crepo\u003e.git\n  defaultSkillsRepo: \"http://gitlab-webservice-default.gitlab.svc:8181/EdwardLim1994/internal-agent-skills.git\"\n\n# ponytail: one Deployment+Service+ConfigMap per role. Base = the same omp\n# image; the role's roles/\u003cname\u003e/SKILL.md (in this chart) is mounted into the\n# skill dir via ConfigMap — no git clone. All at replicas 0; wake one:\n#   kubectl -n omp scale deploy/omp-\u003crole\u003e --replicas=1\n# Drop a name from this list to stop shipping that role's pod.\nroles:\n  - backend-developer\n  - data-engineer\n  - devops-engineer\n  - frontend-developer\n  - product-owner\n  - project-manager\n  - qa-engineer\n  - release-manager\n  - security-engineer\n  - solution-architect\n  - tech-lead\n  - uiux-designer\n\n# ponytail: scale-to-zero waker + flat proxy (helm/omp/adapter/server.py) so\n# LiteLLM can list the omp pods as models. The pods already serve an\n# OpenAI-compatible API (pod-openai.py); the adapter only scales a role pod to\n# 1 on first request and presents one /v1 surface. Register in LiteLLM: model\n# omp[-\u003crole\u003e], api_base http://omp-adapter.omp.svc:8000/v1.\nadapter:\n  enabled: true\n  image: python:3.12-slim\n  port: 8000\n\npersistence:\n  enabled: true\n  size: 20Gi\n\n# ponytail: mount the host's docker socket instead of running a dind daemon\n# in-pod (no privileged container). Switch to sysbox/dind if you need real\n# isolation between this pod and the host's other containers.\ndockerSocket:\n  enabled: true\n  hostPath: /var/run/docker.sock\n\n# ponytail: RBAC so an external service (n8n) can spawn/kill extra omp\n# Deployments in this namespace via the k8s API. Bound to n8n's SA. Ships\n# once with the base `omp` release; per-agent spawns are plain Deployments\n# the flow POSTs, not new Helm releases.\nspawner:\n  enabled: true\n  subjectServiceAccount:\n    name: n8n\n    namespace: n8n\n\nresources:\n  requests:\n    cpu: 250m\n    memory: 512Mi\n  limits:\n    memory: 2Gi\n"
            ],
            "verify": false,
            "version": "0.1.0",
            "wait": false,
            "wait_for_jobs": false
          },
          "sensitive_attributes": [
            [
              {
                "type": "get_attr",
                "value": "repository_password"
              }
            ]
          ],
          "private": "eyJzY2hlbWFfdmVyc2lvbiI6IjEifQ==",
          "dependencies": [
            "kubernetes_namespace.omp",
            "kubernetes_secret.omp_claude_auth",
            "null_resource.omp_image"
          ]
        }
      ]
    },
    {
