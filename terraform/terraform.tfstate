                "type": "",
                "value": "dev-nextcloud-admin-password"
              }
            ],
            "skip_crds": false,
            "status": "deployed",
            "timeout": 1500,
            "upgrade_install": null,
            "values": [
              "nextcloud:\n  nextcloud:\n    # ponytail: ingress rule host stays the LAN name; the tailnet name is the\n    # \"real\" external URL Nextcloud bakes into generated links, injected via\n    # OVERWRITEHOST/CLIURL below. nextcloud.tail60240b.ts.net (no scheme) / https://nextcloud.tail60240b.ts.net (with\n    # https) are string-replaced by terraform + Tiltfile with the tailscale\n    # operator MagicDNS name (nextcloud.\u003ctailnet\u003e.ts.net).\n    host: nextcloud.local\n    username: admin\n    password: \"\"  # set via Tiltfile/terraform\n    extraEnv:\n      # ponytail: both names must be trusted or Nextcloud 400s the request whose\n      # Host header it doesn't recognise (tailnet host arrives via the operator).\n      - name: NEXTCLOUD_TRUSTED_DOMAINS\n        value: \"nextcloud.local nextcloud.tail60240b.ts.net\"\n      - name: OVERWRITEHOST\n        value: nextcloud.tail60240b.ts.net\n      - name: OVERWRITEPROTOCOL\n        value: https\n      - name: OVERWRITECLIURL\n        value: https://nextcloud.tail60240b.ts.net\n      # ponytail: traefik pod (cluster CIDR) + tailscale operator proxy\n      # (100.64/10 CGNAT) sit in front — without this, X-Forwarded-* is\n      # ignored and every generated link points at the in-pod address.\n      - name: TRUSTED_PROXIES\n        value: \"10.0.0.0/8 100.64.0.0/10\"\n    # ponytail: single pod, so APCu local cache is enough — no redis subchart,\n    # no \"don't name the Service 'redis'\" dance seafile needed. apcu.config.php\n    # is on by default via defaultConfigs.\n\n    # ponytail: chart default fsGroupChangePolicy is Always, so the kubelet\n    # recursively chowns all ~15k files of the data PVC on every pod start —\n    # minutes of stall on local-path storage, and it made helm --wait time out\n    # (\"Setting volume ownership ... is taking longer than expected\"). This\n    # replaces the chart's default block, so fsGroup: 33 must stay. OnRootMismatch\n    # only chowns when the volume root's gid is wrong (i.e. first boot only).\n    podSecurityContext:\n      fsGroup: 33\n      fsGroupChangePolicy: OnRootMismatch\n\n  # ponytail: OAuth wiring via `occ` in postStart — the chart has no init\n  # hook-point after the entrypoint's first-boot install. Polls until installed,\n  # then every boot re-applies the Social Login provider so URL changes take\n  # effect. Key is nextcloud.lifecycle (chart root), NOT nextcloud.nextcloud.*.\n  # https://authentik.tail60240b.ts.net / dev-nextcloud-oidc-client-id / _SECRET__ are string-\n  # replaced on the rendered YAML by terraform + Tiltfile (not --set — this is\n  # one multi-line shell string). authorizeUrl is the external tailnet URL (the\n  # browser hits it); token + userinfo are in-cluster http (the pod hits them).\n  lifecycle:\n    postStartCommand:\n      - /bin/sh\n      - -c\n      - |\n        OCC=\"runuser -u www-data -- php /var/www/html/occ\"\n        i=0\n        until $OCC status 2\u003e/dev/null | grep -q 'installed: true'; do\n          i=$((i+1)); [ $i -ge 240 ] \u0026\u0026 exit 0; sleep 2\n        done\n        # ponytail: the k3d node's egress to apps.nextcloud.com is flaky (same\n        # i/o timeouts that hit ACME) — a single app:install often stalls\n        # mid-download. Retry, and only wire up SSO once the app is actually\n        # enabled, so a failed download leaves nextcloud usable (local login)\n        # instead of half-configured. Runs every boot; no-ops once installed.\n        n=0\n        until $OCC app:list --output=json 2\u003e/dev/null | grep -q '\"sociallogin\"'; do\n          n=$((n+1)); [ $n -ge 15 ] \u0026\u0026 break\n          $OCC app:install sociallogin 2\u003e/dev/null || $OCC app:enable sociallogin 2\u003e/dev/null || true\n          sleep 6\n        done\n        if $OCC app:list --output=json 2\u003e/dev/null | grep -q '\"sociallogin\"'; then\n          $OCC config:system:set allow_local_remote_servers --type=boolean --value=true\n          $OCC config:app:set sociallogin custom_providers --value='{\"custom_oidc\":[{\"name\":\"authentik\",\"title\":\"Authentik\",\"authorizeUrl\":\"https://authentik.tail60240b.ts.net/application/o/authorize/\",\"tokenUrl\":\"http://authentik-server.authentik.svc.cluster.local/application/o/token/\",\"userInfoUrl\":\"http://authentik-server.authentik.svc.cluster.local/application/o/userinfo/\",\"logoutUrl\":\"\",\"clientId\":\"dev-nextcloud-oidc-client-id\",\"clientSecret\":\"dev-nextcloud-oidc-client-secret-not-for-prod-use\",\"scope\":\"openid profile email\",\"groupsClaim\":\"groups\",\"displayNameClaim\":\"name\",\"style\":\"\",\"defaultGroup\":\"\"}]}'\n          $OCC config:app:set sociallogin update_profile_on_login --value=1\n          $OCC config:app:set sociallogin disable_registration --value=0\n          # ponytail: auto-redirect login page straight to Authentik. Reach the\n          # local login form at /login?noredir=1 if you ever need it.\n          $OCC config:system:set social_login_auto_redirect --type=boolean --value=true\n        fi\n\n  # ponytail: first boot rsyncs ~10k files of /var/www/html onto local-path\n  # storage (slow on a Docker-Desktop bind mount) - the default liveness probe\n  # SIGKILLs the container mid-init (exit 137) and it never finishes. startupProbe\n  # suspends liveness until install completes; 120 x 10s = 20 min ceiling. Raise\n  # failureThreshold if a fresh PVC still gets killed.\n  startupProbe:\n    enabled: true\n    initialDelaySeconds: 30\n    periodSeconds: 10\n    failureThreshold: 120\n\n  internalDatabase:\n    enabled: false\n\n  # ponytail: bundled bitnami mariadb off — replaced by templates/mariadb.yaml\n  # (plain official mariadb:11 image, same pattern as helm/n8n's postgres).\n  mariadb:\n    enabled: false\n  externalDatabase:\n    enabled: true\n    type: mysql\n    host: nextcloud-mariadb\n    database: nextcloud\n    user: nextcloud\n    password: \"\"  # set via Tiltfile/terraform\n\n  redis:\n    enabled: false\n\n  persistence:\n    enabled: true\n    accessMode: ReadWriteOnce\n    size: 20Gi\n\n  resources:\n    requests:\n      cpu: 100m\n      memory: 512Mi\n    limits:\n      memory: 1536Mi\n\n  ingress:\n    enabled: true\n    className: traefik\n    annotations:\n      cert-manager.io/cluster-issuer: homelab-ca-issuer\n    tls:\n      - secretName: nextcloud.local-tls\n        hosts:\n          - nextcloud.local\n\n# ponytail: consumed by templates/mariadb.yaml (this wrapper chart's own\n# template). Keep database/user/password in sync with nextcloud.externalDatabase.\nmariadb:\n  image: mariadb:11.4\n  database: nextcloud\n  username: nextcloud\n  password: \"\"       # set via terraform / Tiltfile\n  rootPassword: \"\"   # set via terraform / Tiltfile\n  storageSize: 4Gi\n  resources:\n    requests:\n      cpu: 50m\n      memory: 256Mi\n    limits:\n      memory: 512Mi\n"
            ],
            "verify": false,
            "version": "0.1.0",
            "wait": true,
            "wait_for_jobs": false
          },
          "sensitive_attributes": [
            [
              {
                "type": "get_attr",
                "value": "repository_password"
              }
            ],
            [
              {
                "type": "get_attr",
                "value": "set_sensitive"
              }
            ],
            [
              {
                "type": "get_attr",
                "value": "values"
              },
              {
                "type": "index",
                "value": {
                  "value": 0,
                  "type": "number"
                }
              }
            ]
          ],
          "private": "eyJzY2hlbWFfdmVyc2lvbiI6IjEifQ==",
          "dependencies": [
            "kubernetes_namespace.nextcloud"
          ]
        }
      ]
    },
    {
      "mode": "managed",
      "type": "helm_release",
      "name": "observability",
      "provider": "provider[\"registry.opentofu.org/hashicorp/helm\"]",
      "instances": [
        {
          "schema_version": 1,
          "attributes": {
            "atomic": false,
            "chart": "./../helm/observability",
            "cleanup_on_fail": false,
            "create_namespace": false,
            "dependency_update": true,
            "description": null,
            "devel": null,
            "disable_crd_hooks": false,
            "disable_openapi_validation": false,
            "disable_webhooks": false,
            "force_update": false,
            "id": "observability",
            "keyring": null,
            "lint": false,
            "manifest": null,
            "max_history": 0,
            "metadata": [
              {
                "app_version": "",
                "chart": "observability",
                "first_deployed": 1789017135,
                "last_deployed": 1789115558,
                "name": "observability",
                "namespace": "observability",
                "notes": "***********************************************************************\n Welcome to Grafana Loki\n Chart version: 7.3.0\n Chart Name: loki\n Loki version: 3.6.12\n***********************************************************************\n\n** Please be patient while the chart is being deployed **\n\nTip:\n\n  Watch the deployment status using the command: kubectl get pods -w --namespace observability\n\nIf pods are taking too long to schedule make sure pod affinity can be fulfilled in the current cluster.\n\n***********************************************************************\nInstalled components:\n***********************************************************************\n* loki\n\nLoki has been deployed as a single binary.\nThis means a single pod is handling reads and writes. You can scale that pod vertically by adding more CPU and memory resources.\n\n\n***********************************************************************\nSending logs to Loki\n***********************************************************************\n\nYou can send logs from inside the cluster using the cluster DNS:\n\nhttp://observability-loki.observability.svc.cluster.local:3100/loki/api/v1/push\n\nYou can test to send data from outside the cluster by port-forwarding the gateway to your local machine:\n\n  kubectl port-forward --namespace observability svc/observability-loki 3100:3100 \u0026\n\nAnd then using http://127.0.0.1:3100/loki/api/v1/push URL as shown below:\n\n```\ncurl -H \"Content-Type: application/json\" -XPOST -s \"http://127.0.0.1:3100/loki/api/v1/push\"  \\\n--data-raw \"{\\\"streams\\\": [{\\\"stream\\\": {\\\"job\\\": \\\"test\\\"}, \\\"values\\\": [[\\\"$(date +%s)000000000\\\", \\\"fizzbuzz\\\"]]}]}\"\n```\n\nThen verify that Loki did receive the data using the following command:\n\n```\ncurl \"http://127.0.0.1:3100/loki/api/v1/query_range\" --data-urlencode 'query={job=\"test\"}' | jq .data.result\n```\n\n***********************************************************************\nConnecting Grafana to Loki\n***********************************************************************\n\nIf Grafana operates within the cluster, you'll set up a new Loki datasource by utilizing the following URL:\n\nhttp://observability-loki.observability.svc.cluster.local:3100/\n\nWelcome to Grafana Alloy!\n\nWelcome to Grafana Mimir!\nRemote write endpoints for Prometheus or Grafana Agent:\nIngress is not enabled, see the gateway.ingress values.\nFrom inside the cluster:\n  http://observability-mimir-gateway.observability.svc:80/api/v1/push\n\nRead address, Grafana data source (Prometheus) URL:\nIngress is not enabled, see the gateway.ingress values.\nFrom inside the cluster:\n  http://observability-mimir-gateway.observability.svc:80/prometheus\n\n**IMPORTANT**: Always consult CHANGELOG.md file at https://github.com/grafana/mimir/blob/main/operations/helm/charts/mimir-distributed/CHANGELOG.md and the deprecation list there to learn about breaking changes that require action during upgrade.\n\nThe Prometheus server can be accessed via port 80 on the following DNS name from within your cluster:\nobservability-prometheus-server.observability.svc.cluster.local\n\n\nGet the Prometheus server URL by running these commands in the same shell:\n  export POD_NAME=$(kubectl get pods --namespace observability -l \"app.kubernetes.io/name=prometheus,app.kubernetes.io/instance=observability\" -o jsonpath=\"{.items[0].metadata.name}\")\n  kubectl --namespace observability port-forward $POD_NAME 9090\n\n\n\n\n\nFor more information on running Prometheus, visit:\nhttps://prometheus.io/\n\nkube-state-metrics is a simple service that listens to the Kubernetes API server and generates metrics about the state of the objects.\nThe exposed metrics can be found here:\nhttps://github.com/kubernetes/kube-state-metrics/blob/master/docs/README.md#exposed-metrics\n\nThe metrics are exported on the HTTP endpoint /metrics on the listening port.\nIn your case, observability-kube-state-metrics.observability.svc.cluster.local:8080/metrics\n\nThey are served either as plaintext or protobuf depending on the Accept header.\nThey are designed to be consumed either by Prometheus itself or by a scraper that is compatible with scraping a Prometheus client endpoint.\n\n1. Get the application URL by running these commands:\n  export POD_NAME=$(kubectl get pods --namespace observability -l \"app.kubernetes.io/name=prometheus-node-exporter,app.kubernetes.io/instance=observability\" -o jsonpath=\"{.items[0].metadata.name}\")\n  echo \"Visit http://127.0.0.1:9100 to use your application\"\n  kubectl port-forward --namespace observability $POD_NAME 9100\n1. Get your 'admin' user password by running:\n\n   kubectl get secret --namespace observability observability-grafana -o jsonpath=\"{.data.admin-password}\" | base64 --decode ; echo\n\n\n2. The Grafana server can be accessed via port 80 on the following DNS name from within your cluster:\n\n   observability-grafana.observability.svc.cluster.local\n\n   If you bind grafana to 80, please update values in values.yaml and reinstall:\n   ```\n   securityContext:\n     runAsUser: 0\n     runAsGroup: 0\n     fsGroup: 0\n\n   command:\n   - \"setcap\"\n   - \"'cap_net_bind_service=+ep'\"\n   - \"/usr/sbin/grafana-server \u0026\u0026\"\n   - \"sh\"\n   - \"/run.sh\"\n   ```\n   Details refer to https://grafana.com/docs/installation/configuration/#http-port.\n   Or grafana would always crash.\n\n   From outside the cluster, the server URL(s) are:\n     http://grafana.local\n\n3. Login with the password from step 1 and the username: admin\n",
                "revision": 4,
                "values": "{\"alloy\":{\"alloy\":{\"configMap\":{\"content\":\"// ── K8s pod logs → Loki ──────────────────────────────────────────────\\ndiscovery.kubernetes \\\"pods\\\" {\\n  role = \\\"pod\\\"\\n}\\n\\ndiscovery.relabel \\\"pod_logs\\\" {\\n  targets = discovery.kubernetes.pods.targets\\n  rule {\\n    source_labels = [\\\"__meta_kubernetes_pod_node_name\\\"]\\n    target_label  = \\\"node\\\"\\n  }\\n  rule {\\n    source_labels = [\\\"__meta_kubernetes_namespace\\\"]\\n    target_label  = \\\"namespace\\\"\\n  }\\n  rule {\\n    source_labels = [\\\"__meta_kubernetes_pod_name\\\"]\\n    target_label  = \\\"pod\\\"\\n  }\\n  rule {\\n    source_labels = [\\\"__meta_kubernetes_pod_container_name\\\"]\\n    target_label  = \\\"container\\\"\\n  }\\n  rule {\\n    source_labels = [\\\"__meta_kubernetes_pod_label_app_kubernetes_io_name\\\"]\\n    target_label  = \\\"app\\\"\\n  }\\n}\\n\\nloki.source.kubernetes \\\"pods\\\" {\\n  targets    = discovery.relabel.pod_logs.output\\n  forward_to = [loki.write.default.receiver]\\n}\\n\\nloki.write \\\"default\\\" {\\n  endpoint {\\n    url = \\\"http://observability-loki.observability.svc.cluster.local:3100/loki/api/v1/push\\\"\\n  }\\n}\\n\\n// ── OTLP receiver (apps → Alloy) ─────────────────────────────────────\\notelcol.receiver.otlp \\\"default\\\" {\\n  http { endpoint = \\\"0.0.0.0:4318\\\" }\\n  grpc { endpoint = \\\"0.0.0.0:4317\\\" }\\n  output {\\n    metrics = [otelcol.exporter.prometheus.mimir.input]\\n    logs    = [otelcol.exporter.loki.default.input]\\n    traces  = [otelcol.exporter.otlp.tempo.input]\\n  }\\n}\\n\\n// ── OTLP metrics → Mimir ─────────────────────────────────────────────\\notelcol.exporter.prometheus \\\"mimir\\\" {\\n  forward_to = [prometheus.remote_write.mimir.receiver]\\n}\\n\\nprometheus.remote_write \\\"mimir\\\" {\\n  endpoint {\\n    url = \\\"http://observability-mimir-distributor.observability.svc.cluster.local:8080/api/v1/push\\\"\\n  }\\n}\\n\\n// ── OTLP logs → Loki ─────────────────────────────────────────────────\\notelcol.exporter.loki \\\"default\\\" {\\n  forward_to = [loki.write.default.receiver]\\n}\\n\\n// ── OTLP traces → Tempo ──────────────────────────────────────────────\\notelcol.exporter.otlp \\\"tempo\\\" {\\n  client {\\n    endpoint = \\\"observability-tempo.observability.svc.cluster.local:4317\\\"\\n    tls { insecure = true }\\n  }\\n}\\n\"},\"extraPorts\":[{\"name\":\"otlp-grpc\",\"port\":4317,\"protocol\":\"TCP\",\"targetPort\":4317},{\"name\":\"otlp-http\",\"port\":4318,\"protocol\":\"TCP\",\"targetPort\":4318}]},\"clustering\":{\"enabled\":false},\"rbac\":{\"create\":true},\"serviceAccount\":{\"create\":true}},\"grafana\":{\"adminPassword\":\"dev-grafana-admin-password\",\"assertNoLeakedSecrets\":false,\"datasources\":{\"datasources.yaml\":{\"apiVersion\":1,\"datasources\":[{\"isDefault\":true,\"jsonData\":{\"timeInterval\":\"15s\"},\"name\":\"Mimir\",\"type\":\"prometheus\",\"uid\":\"mimir\",\"url\":\"http://observability-mimir-query-frontend.observability.svc.cluster.local:8080/prometheus\"},{\"jsonData\":{\"timeInterval\":\"15s\"},\"name\":\"Prometheus\",\"type\":\"prometheus\",\"uid\":\"prometheus\",\"url\":\"http://observability-prometheus-server.observability.svc.cluster.local\"},{\"name\":\"Loki\",\"type\":\"loki\",\"uid\":\"loki\",\"url\":\"http://observability-loki.observability.svc.cluster.local:3100\"},{\"jsonData\":{\"serviceMap\":{\"datasourceUid\":\"mimir\"},\"tracesToLogsV2\":{\"datasourceUid\":\"loki\"}},\"name\":\"Tempo\",\"type\":\"tempo\",\"uid\":\"tempo\",\"url\":\"http://observability-tempo.observability.svc.cluster.local:3100\"}]}},\"grafana.ini\":{\"auth\":{\"disable_login_form\":\"false\",\"oauth_allow_insecure_email_lookup\":\"true\"},\"auth.generic_oauth\":{\"allow_sign_up\":\"true\",\"api_url\":\"http://authentik-server.authentik.svc.cluster.local/application/o/userinfo/\",\"auth_url\":\"https://authentik.tail60240b.ts.net/application/o/authorize/\",\"client_id\":\"dev-grafana-oidc-client-id\",\"client_secret\":\"dev-grafana-oidc-client-secret-not-for-prod-use\",\"enabled\":\"true\",\"name\":\"Authentik\",\"role_attribute_path\":\"email == 'edwardlimkoksiong1994@gmail.com' \\u0026\\u0026 'Admin' || 'Viewer'\",\"scopes\":\"openid profile email\",\"token_url\":\"http://authentik-server.authentik.svc.cluster.local/application/o/token/\"},\"server\":{\"root_url\":\"https://grafana.tail60240b.ts.net\"}},\"ingress\":{\"annotations\":{\"cert-manager.io/cluster-issuer\":\"homelab-ca-issuer\"},\"enabled\":true,\"hosts\":[\"grafana.local\"],\"ingressClassName\":\"traefik\",\"tls\":[{\"hosts\":[\"grafana.local\"],\"secretName\":\"grafana.local-tls\"}]},\"persistence\":{\"enabled\":true,\"size\":\"2Gi\"},\"resources\":{\"limits\":{\"memory\":\"256Mi\"},\"requests\":{\"cpu\":\"50m\",\"memory\":\"128Mi\"}},\"sidecar\":{\"dashboards\":{\"enabled\":true,\"folder\":\"/tmp/dashboards\",\"label\":\"grafana_dashboard\",\"provider\":{\"foldersFromFilesStructure\":false},\"searchNamespace\":\"observability\"}}},\"loki\":{\"backend\":{\"replicas\":0},\"chunksCache\":{\"enabled\":false},\"deploymentMode\":\"SingleBinary\",\"gateway\":{\"enabled\":false},\"loki\":{\"auth_enabled\":false,\"commonConfig\":{\"replication_factor\":1},\"schemaConfig\":{\"configs\":[{\"from\":\"2024-01-01\",\"index\":{\"period\":\"24h\",\"prefix\":\"index_\"},\"object_store\":\"filesystem\",\"schema\":\"v13\",\"store\":\"tsdb\"}]},\"storage\":{\"type\":\"filesystem\"}},\"lokiCanary\":{\"enabled\":false},\"read\":{\"replicas\":0},\"resultsCache\":{\"enabled\":false},\"singleBinary\":{\"persistence\":{\"enabled\":true,\"size\":\"10Gi\"},\"replicas\":1,\"resources\":{\"limits\":{\"memory\":\"512Mi\"},\"requests\":{\"cpu\":\"50m\",\"memory\":\"256Mi\"}}},\"test\":{\"enabled\":false},\"write\":{\"replicas\":0}},\"mimir-distributed\":{\"alertmanager\":{\"enabled\":false},\"compactor\":{\"persistentVolume\":{\"enabled\":true,\"size\":\"10Gi\"},\"replicas\":1,\"resources\":{\"limits\":{\"memory\":\"256Mi\"},\"requests\":{\"cpu\":\"50m\",\"memory\":\"128Mi\"}}},\"distributor\":{\"replicas\":1,\"resources\":{\"limits\":{\"memory\":\"256Mi\"},\"requests\":{\"cpu\":\"50m\",\"memory\":\"128Mi\"}}},\"ingester\":{\"persistentVolume\":{\"enabled\":true,\"size\":\"10Gi\"},\"replicas\":1,\"resources\":{\"limits\":{\"memory\":\"512Mi\"},\"requests\":{\"cpu\":\"50m\",\"memory\":\"256Mi\"}},\"zoneAwareReplication\":{\"enabled\":false}},\"kafka\":{\"enabled\":false},\"mimir\":{\"structuredConfig\":{\"blocks_storage\":{\"backend\":\"filesystem\",\"filesystem\":{\"dir\":\"/data/blocks\"}},\"common\":{\"storage\":{\"backend\":\"filesystem\",\"filesystem\":{\"dir\":\"/data\"}}},\"compactor\":{\"data_dir\":\"/data/compactor\"},\"ingest_storage\":{\"enabled\":false},\"ingester\":{\"push_grpc_method_enabled\":true},\"multitenancy_enabled\":false,\"usage_stats\":{\"enabled\":false}}},\"minio\":{\"enabled\":false},\"overrides_exporter\":{\"enabled\":false},\"querier\":{\"replicas\":1,\"resources\":{\"limits\":{\"memory\":\"256Mi\"},\"requests\":{\"cpu\":\"50m\",\"memory\":\"128Mi\"}}},\"query_frontend\":{\"replicas\":1,\"resources\":{\"limits\":{\"memory\":\"256Mi\"},\"requests\":{\"cpu\":\"50m\",\"memory\":\"128Mi\"}}},\"query_scheduler\":{\"enabled\":false},\"rollout_operator\":{\"enabled\":false},\"ruler\":{\"enabled\":false},\"store_gateway\":{\"persistentVolume\":{\"enabled\":true,\"size\":\"10Gi\"},\"replicas\":1,\"resources\":{\"limits\":{\"memory\":\"256Mi\"},\"requests\":{\"cpu\":\"50m\",\"memory\":\"128Mi\"}},\"zoneAwareReplication\":{\"enabled\":false}}},\"prometheus\":{\"alertmanager\":{\"enabled\":false},\"kube-state-metrics\":{\"enabled\":true},\"prometheus-node-exporter\":{\"enabled\":true},\"prometheus-pushgateway\":{\"enabled\":false},\"server\":{\"global\":{\"evaluation_interval\":\"15s\",\"scrape_interval\":\"15s\"},\"persistentVolume\":{\"enabled\":true,\"size\":\"10Gi\"},\"remoteWrite\":[{\"url\":\"http://observability-mimir-distributor.observability.svc.cluster.local:8080/api/v1/push\"}],\"resources\":{\"limits\":{\"memory\":\"2Gi\"},\"requests\":{\"cpu\":\"50m\",\"memory\":\"512Mi\"}},\"retention\":\"3d\"}},\"tailnetDomain\":\"tail60240b.ts.net\",\"tempo\":{\"persistence\":{\"enabled\":true,\"size\":\"10Gi\"},\"resources\":{\"limits\":{\"memory\":\"512Mi\"},\"requests\":{\"cpu\":\"50m\",\"memory\":\"256Mi\"}},\"tempo\":{\"metricsGenerator\":{\"enabled\":true,\"processor\":{\"service_graphs\":{},\"span_metrics\":{\"enable_target_info\":true}},\"remoteWriteUrl\":\"http://observability-mimir-distributor.observability.svc.cluster.local:8080/api/v1/push\",\"storage\":{\"path\":\"/var/tempo/generator/wal\"},\"traces_storage\":{\"path\":\"/var/tempo/generator/traces\"}},\"overrides\":{\"defaults\":{\"metrics_generator\":{\"processors\":[\"service-graphs\",\"span-metrics\"]}}},\"receivers\":{\"otlp\":{\"protocols\":{\"grpc\":{\"endpoint\":\"0.0.0.0:4317\"},\"http\":{\"endpoint\":\"0.0.0.0:4318\"}}}},\"storage\":{\"trace\":{\"backend\":\"local\",\"local\":{\"path\":\"/var/tempo/traces\"},\"wal\":{\"path\":\"/var/tempo/wal\"}}}}},\"tsHost\":\"desktop-qv5aogf.tail60240b.ts.net\"}",
                "version": "0.1.0"
              }
            ],
            "name": "observability",
            "namespace": "observability",
            "pass_credentials": false,
            "postrender": [],
            "recreate_pods": false,
            "render_subchart_notes": true,
            "replace": false,
            "repository": null,
            "repository_ca_file": null,
            "repository_cert_file": null,
            "repository_key_file": null,
            "repository_password": null,
            "repository_username": null,
            "reset_values": false,
            "reuse_values": false,
            "set": [],
