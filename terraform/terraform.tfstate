            "values": [
              "authentik:\r\n  authentik:\r\n    secret_key: \"\"  # set via terraform variable\r\n    log_level: info\r\n    postgresql:\r\n      host: \"authentik-postgresql\"\r\n      password: \"\"  # set via terraform variable\r\n\r\n  postgresql:\r\n    enabled: true\r\n    # ponytail: bitnami moved old image tags to bitnamilegacy on docker.io, upgrade image.tag when bumping chart\r\n    image:\r\n      repository: bitnamilegacy/postgresql\r\n    auth:\r\n      password: \"\"  # set via terraform variable\r\n    primary:\r\n      resources:\r\n        requests:\r\n          cpu: 50m\r\n          memory: 256Mi\r\n        limits:\r\n          memory: 512Mi\r\n\r\n  redis:\r\n    enabled: true\r\n    image:\r\n      repository: bitnamilegacy/redis\r\n    master:\r\n      resources:\r\n        requests:\r\n          cpu: 25m\r\n          memory: 64Mi\r\n        limits:\r\n          memory: 128Mi\r\n\r\n  server:\r\n    replicas: 1\r\n    resources:\r\n      requests:\r\n        cpu: 100m\r\n        memory: 512Mi\r\n      limits:\r\n        memory: 1Gi\r\n    ingress:\r\n      enabled: true\r\n      ingressClassName: traefik\r\n      annotations:\r\n        cert-manager.io/cluster-issuer: homelab-ca-issuer\r\n      hosts:\r\n        - authentik.local\r\n      tls:\r\n        - secretName: authentik-tls\r\n          hosts:\r\n            - authentik.local\r\n\r\n  worker:\r\n    replicas: 1\r\n    resources:\r\n      requests:\r\n        cpu: 50m\r\n        memory: 512Mi\r\n      limits:\r\n        memory: 1Gi\r\n"
            ],
            "verify": false,
