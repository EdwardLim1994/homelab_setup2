            "keyring": null,
            "lint": false,
            "manifest": null,
            "max_history": 0,
            "metadata": [
              {
                "app_version": "",
                "chart": "litellm",
                "first_deployed": 1789017393,
                "last_deployed": 1789117056,
                "name": "litellm",
                "namespace": "litellm",
                "notes": "",
                "revision": 5,
                "values": "{\"env\":{\"AUTO_REDIRECT_UI_LOGIN_TO_SSO\":\"true\",\"DATABASE_URL\":\"postgresql://litellm:dev-shared-db-password-not-for-prod-use@postgres.postgres.svc.cluster.local:5432/litellm\",\"GENERIC_AUTHORIZATION_ENDPOINT\":\"https://authentik.tail60240b.ts.net/application/o/authorize/\",\"GENERIC_CLIENT_ID\":\"dev-litellm-oidc-client-id\",\"GENERIC_CLIENT_SECRET\":\"dev-litellm-oidc-client-secret-not-for-prod-use\",\"GENERIC_SCOPE\":\"openid profile email litellm_role\",\"GENERIC_TOKEN_ENDPOINT\":\"http://authentik-server.authentik.svc.cluster.local/application/o/token/\",\"GENERIC_USERINFO_ENDPOINT\":\"http://authentik-server.authentik.svc.cluster.local/application/o/userinfo/\",\"GENERIC_USER_ROLE_ATTRIBUTE\":\"litellm_role\",\"LITELLM_MASTER_KEY\":\"sk-dev-litellm-master-key-not-for-prod-use\",\"LITELLM_SALT_KEY\":\"sk-dev-litellm-salt-key-not-for-prod-use\",\"PROXY_BASE_URL\":\"https://litellm.tail60240b.ts.net\",\"PROXY_LOGOUT_URL\":\"https://authentik.tail60240b.ts.net/application/o/litellm/end-session/\",\"STORE_MODEL_IN_DB\":\"True\"},\"image\":{\"repository\":\"ghcr.io/berriai/litellm\",\"tag\":\"main-latest\"},\"mcpGitlabAuthToken\":\"dev-gitlab-mcp-auth-token\",\"mcpN8nAuthToken\":\"dev-n8n-mcp-auth-token-not-for-prod-use-000\",\"mcpSonarqubeAuthToken\":\"squ_2ea8c27ba77841e9c51c2171b6b73098b7e167a4\",\"ollamaBaseUrl\":\"http://host.docker.internal:11434\",\"ollamaModels\":[{\"inputCostPerToken\":0.000003,\"name\":\"qwen3.8:27b\",\"outputCostPerToken\":0.000015},{\"inputCostPerToken\":0.000001,\"name\":\"qwen3:1.7b\",\"outputCostPerToken\":0.000005}],\"resources\":{\"limits\":{\"memory\":\"2Gi\"},\"requests\":{\"cpu\":\"100m\",\"memory\":\"512Mi\"}}}",
                "version": "0.1.0"
              }
            ],
            "name": "litellm",
            "namespace": "litellm",
            "pass_credentials": false,
            "postrender": [],
            "recreate_pods": false,
            "render_subchart_notes": true,
            "replace": false,
            "repository": null,
            "repository_ca_file": null,
            "repository_cert_file": null,
            "repository_key_file": null,
            "repository_password": null,
            "repository_username": null,
            "reset_values": false,
            "reuse_values": false,
            "set": [],
            "set_list": [],
            "set_sensitive": [],
            "skip_crds": false,
            "status": "deployed",
            "timeout": 600,
            "upgrade_install": null,
            "values": [
              "image:\r\n  repository: ghcr.io/berriai/litellm\r\n  tag: main-latest\r\n\r\n# ponytail: per-caller bearer for the gitlab MCP server (its\r\n# STREAMABLE_HTTP_AUTH_TOKEN). Same value as TF_VAR_gitlab_mcp_auth_token.\r\nmcpGitlabAuthToken: \"dev-gitlab-mcp-auth-token\"\r\n\r\n# ponytail: SonarQube user token LiteLLM forwards to the sonarqube MCP server\r\n# as `Authorization: Bearer` (HTTP mode needs it per request). Same value as\r\n# TF_VAR_sonarqube_mcp_token.\r\nmcpSonarqubeAuthToken: \"squ_2ea8c27ba77841e9c51c2171b6b73098b7e167a4\"\r\n\r\n# ponytail: per-caller bearer for the n8n MCP server (its AUTH_TOKEN).\r\n# Same value as TF_VAR_n8n_mcp_auth_token.\r\nmcpN8nAuthToken: \"dev-n8n-mcp-auth-token-not-for-prod-use-000\"\r\n\r\n# ponytail: the host's Ollama, reached from the cluster via k3d's built-in\r\n# host alias. `ollama_chat/*` provider — no /v1 suffix. `ollamaModels` are the\r\n# tags listed by name; add/remove to match `ollama list`.\r\n# host.docker.internal resolves from k3d pods on Docker Desktop; host.k3d.internal\r\n# depends on k3d's flaky CoreDNS NodeHosts injection and was failing name lookup.\r\nollamaBaseUrl: \"http://host.docker.internal:11434\"\r\n# ponytail: the models run for free on local Ollama — these costPerToken\r\n# figures are reference-only (LiteLLM's usage/spend dashboard needs *some*\r\n# number to show $ cost), not real billing. Anthropic API list pricing\r\n# (USD/token) stood in per size tier: qwen3.8:27b ~ Sonnet-class,\r\n# qwen3:1.7b ~ Haiku-class. Update alongside shared/model-migration pricing\r\n# if Anthropic's list prices change.\r\nollamaModels:\r\n  # qwen3-coder-next (80B) OOMs on this host — omp default is qwen3.8:27b.\r\n  - name: \"qwen3.8:27b\"\r\n    inputCostPerToken: 0.000003\r\n    outputCostPerToken: 0.000015\r\n  - name: \"qwen3:1.7b\"\r\n    inputCostPerToken: 0.000001\r\n    outputCostPerToken: 0.000005\r\n\r\nenv:\r\n  DATABASE_URL: \"postgresql://litellm:dev-shared-db-password-not-for-prod-use@postgres.postgres.svc.cluster.local:5432/litellm\"\r\n  STORE_MODEL_IN_DB: \"True\"\r\n  LITELLM_MASTER_KEY: \"sk-dev-litellm-master-key-not-for-prod-use\"\r\n  LITELLM_SALT_KEY: \"sk-dev-litellm-salt-key-not-for-prod-use\"\r\n\r\n  # SSO via Authentik generic OIDC\r\n  GENERIC_CLIENT_ID: \"dev-litellm-oidc-client-id\"\r\n  GENERIC_CLIENT_SECRET: \"dev-litellm-oidc-client-secret-not-for-prod-use\"\r\n  # ponytail: browser-navigated endpoint must use Tailscale HTTPS (external).\r\n  # Token and userinfo are server-side calls — use in-cluster HTTP to avoid\r\n  # self-signed cert validation against homelab CA.\r\n  GENERIC_AUTHORIZATION_ENDPOINT: \"https://authentik.tail60240b.ts.net/application/o/authorize/\"\r\n  GENERIC_TOKEN_ENDPOINT: \"http://authentik-server.authentik.svc.cluster.local/application/o/token/\"\r\n  GENERIC_USERINFO_ENDPOINT: \"http://authentik-server.authentik.svc.cluster.local/application/o/userinfo/\"\r\n  GENERIC_SCOPE: \"openid profile email litellm_role\"\r\n  GENERIC_USER_ROLE_ATTRIBUTE: \"litellm_role\"\r\n  PROXY_BASE_URL: \"https://litellm.tail60240b.ts.net\"\r\n  PROXY_LOGOUT_URL: \"https://authentik.tail60240b.ts.net/application/o/litellm/end-session/\"\r\n  AUTO_REDIRECT_UI_LOGIN_TO_SSO: \"true\"\r\n\r\nresources:\r\n  requests:\r\n    cpu: 100m\r\n    memory: 512Mi\r\n  limits:\r\n    memory: 2Gi\r\n\r\n\r\n"
            ],
            "verify": false,
            "version": "0.1.0",
            "wait": true,
            "wait_for_jobs": false
          },
          "sensitive_attributes": [
            [
              {
                "type": "get_attr",
                "value": "repository_password"
              }
            ],
            [
              {
                "type": "get_attr",
                "value": "values"
              },
              {
                "type": "index",
                "value": {
                  "value": 0,
                  "type": "number"
                }
              }
            ]
          ],
          "private": "eyJzY2hlbWFfdmVyc2lvbiI6IjEifQ==",
          "dependencies": [
            "helm_release.postgres",
            "kubernetes_namespace.litellm",
            "kubernetes_namespace.postgres"
          ]
        }
      ]
    },
    {
      "mode": "managed",
      "type": "helm_release",
      "name": "mcp_servers",
      "provider": "provider[\"registry.opentofu.org/hashicorp/helm\"]",
      "instances": [
        {
          "schema_version": 1,
          "attributes": {
            "atomic": false,
            "chart": "./../helm/mcp-servers",
            "cleanup_on_fail": false,
            "create_namespace": false,
            "dependency_update": true,
            "description": null,
            "devel": null,
            "disable_crd_hooks": false,
            "disable_openapi_validation": false,
            "disable_webhooks": false,
            "force_update": false,
            "id": "mcp-servers",
            "keyring": null,
            "lint": false,
            "manifest": null,
            "max_history": 0,
            "metadata": [
              {
                "app_version": "",
                "chart": "mcp-servers",
                "first_deployed": 1789017132,
                "last_deployed": 1789117056,
                "name": "mcp-servers",
                "namespace": "mcp-servers",
                "notes": "",
                "revision": 3,
                "values": "{\"defaultResources\":{\"limits\":{\"memory\":\"256Mi\"},\"requests\":{\"cpu\":\"50m\",\"memory\":\"128Mi\"}},\"servers\":{\"gitlab\":{\"env\":{\"GITLAB_API_URL\":\"http://gitlab-webservice-default.gitlab.svc.cluster.local:8181/api/v4\",\"GITLAB_PERSONAL_ACCESS_TOKEN\":\"(sensitive value)\",\"HOST\":\"0.0.0.0\",\"MCP_SERVER_URL\":\"http://mcp-servers-gitlab.mcp-servers.svc.cluster.local:3002\",\"PORT\":\"3002\",\"STREAMABLE_HTTP\":\"true\",\"STREAMABLE_HTTP_AUTH_TOKEN\":\"(sensitive value)\"},\"image\":\"zereight050/gitlab-mcp:latest\",\"port\":3002},\"grafana\":{\"args\":[\"-transport\",\"streamable-http\",\"-address\",\"0.0.0.0:8000\",\"-allowed-hosts\",\"*\",\"-allowed-origins\",\"*\"],\"command\":[\"/app/mcp-grafana\"],\"env\":{\"GRAFANA_SERVICE_ACCOUNT_TOKEN\":\"(sensitive value)\",\"GRAFANA_URL\":\"http://observability-grafana.observability.svc.cluster.local\"},\"image\":\"grafana/mcp-grafana:latest\",\"port\":8000},\"n8n\":{\"env\":{\"AUTH_TOKEN\":\"(sensitive value)\",\"LOG_LEVEL\":\"warn\",\"MCP_MODE\":\"http\",\"N8N_API_KEY\":\"\",\"N8N_API_URL\":\"http://n8n.n8n.svc.cluster.local:5678\",\"PORT\":\"3000\"},\"image\":\"ghcr.io/czlonkowski/n8n-mcp:latest\",\"port\":3000},\"playwright\":{\"args\":[\"--headless\",\"--browser\",\"chromium\",\"--no-sandbox\",\"--port\",\"8931\",\"--host\",\"0.0.0.0\",\"--allowed-hosts\",\"*\"],\"command\":[\"node\",\"/app/cli.js\"],\"image\":\"mcr.microsoft.com/playwright/mcp:latest\",\"port\":8931,\"resources\":{\"limits\":{\"memory\":\"1Gi\"},\"requests\":{\"cpu\":\"250m\",\"memory\":\"512Mi\"}}},\"sonarqube\":{\"env\":{\"SONARQUBE_HTTP_HOST\":\"0.0.0.0\",\"SONARQUBE_HTTP_PORT\":\"8080\",\"SONARQUBE_MCP_IN_CONTAINER\":\"true\",\"SONARQUBE_TOKEN\":\"(sensitive value)\",\"SONARQUBE_TRANSPORT\":\"http\",\"SONARQUBE_URL\":\"http://sonarqube-sonarqube.sonarqube.svc.cluster.local:9000\"},\"image\":\"sonarsource/sonarqube-mcp:latest\",\"port\":8080,\"resources\":{\"limits\":{\"memory\":\"1Gi\"},\"requests\":{\"cpu\":\"100m\",\"memory\":\"512Mi\"}}}}}",
                "version": "0.1.0"
              }
            ],
            "name": "mcp-servers",
            "namespace": "mcp-servers",
            "pass_credentials": false,
            "postrender": [],
            "recreate_pods": false,
            "render_subchart_notes": true,
            "replace": false,
            "repository": null,
            "repository_ca_file": null,
            "repository_cert_file": null,
            "repository_key_file": null,
            "repository_password": null,
            "repository_username": null,
            "reset_values": false,
            "reuse_values": false,
            "set": [],
            "set_list": [],
            "set_sensitive": [
              {
                "name": "servers.gitlab.env.GITLAB_PERSONAL_ACCESS_TOKEN",
                "type": "",
                "value": "glpat-JAOYGoq92GKz2Fer15nFzG86MQp1OjIH.01.0w02vigh8"
              },
              {
                "name": "servers.gitlab.env.STREAMABLE_HTTP_AUTH_TOKEN",
                "type": "",
                "value": "dev-gitlab-mcp-auth-token"
              },
              {
                "name": "servers.grafana.env.GRAFANA_SERVICE_ACCOUNT_TOKEN",
                "type": "",
                "value": ""
              },
              {
                "name": "servers.n8n.env.AUTH_TOKEN",
                "type": "",
                "value": "dev-n8n-mcp-auth-token-not-for-prod-use-000"
              },
              {
                "name": "servers.sonarqube.env.SONARQUBE_TOKEN",
                "type": "",
                "value": "squ_2ea8c27ba77841e9c51c2171b6b73098b7e167a4"
              }
            ],
            "skip_crds": false,
            "status": "deployed",
            "timeout": 300,
            "upgrade_install": null,
            "values": [
              "# ponytail: one Deployment+Service template looped over this map instead of\n# 5 near-identical template files — every server here is the same shape\n# (image, optional command/args override, one HTTP port, env vars).\ndefaultResources:\n  requests:\n    cpu: 50m\n    memory: 128Mi\n  limits:\n    memory: 256Mi\n\nservers:\n  grafana:\n    image: grafana/mcp-grafana:latest\n    # ponytail: override the image's baked entrypoint flags\n    # (`--transport sse --address 0.0.0.0:8000`) so `args` is the whole set.\n    command: [\"/app/mcp-grafana\"]\n    # ponytail: -allowed-hosts \"*\" — LiteLLM's MCP client connects by Service\n    # DNS, so mcp-grafana's DNS-rebind Host-header check 403s it otherwise.\n    # \"*\" is safe here: only in-cluster traffic can reach :8000.\n    args: [\"-transport\", \"streamable-http\", \"-address\", \"0.0.0.0:8000\", \"-allowed-hosts\", \"*\", \"-allowed-origins\", \"*\"]\n    port: 8000\n    env:\n      GRAFANA_URL: http://observability-grafana.observability.svc.cluster.local\n      GRAFANA_SERVICE_ACCOUNT_TOKEN: \"\"  # set via Tiltfile/terraform\n\n  sonarqube:\n    image: sonarsource/sonarqube-mcp:latest\n    port: 8080\n    # ponytail: JVM server + downloads analyzer plugins on boot — OOMKills\n    # (exit 137, CrashLoopBackOff) at the 256Mi default. 1Gi limit gives the\n    # container-aware JVM enough headroom; drop it if analyzer set shrinks.\n    resources:\n      requests:\n        cpu: 100m\n        memory: 512Mi\n      limits:\n        memory: 1Gi\n    env:\n      SONARQUBE_TRANSPORT: \"http\"\n      SONARQUBE_HTTP_PORT: \"8080\"\n      SONARQUBE_HTTP_HOST: \"0.0.0.0\"\n      SONARQUBE_MCP_IN_CONTAINER: \"true\"\n      SONARQUBE_URL: http://sonarqube-sonarqube.sonarqube.svc.cluster.local:9000\n      # ponytail: used only for this server's background plugin sync. In HTTP\n      # mode the per-request token comes from the caller's `Authorization:\n      # Bearer` header (LiteLLM sends it — see helm/litellm mcpSonarqubeAuthToken).\n      # Must be a VALID SonarQube user token or bg init logs \"Not authorized\".\n      SONARQUBE_TOKEN: \"\"  # set via Tiltfile/terraform (TF_VAR_sonarqube_mcp_token)\n\n  gitlab:\n    # ponytail: NOT mcp/gitlab (Docker's own catalog wrapper, stdio-only) —\n    # this is the actual zereight/gitlab-mcp project, which supports HTTP\n    # transport via env vars.\n    image: zereight050/gitlab-mcp:latest\n    port: 3002\n    env:\n      STREAMABLE_HTTP: \"true\"\n      HOST: \"0.0.0.0\"\n      PORT: \"3002\"\n      # ponytail: without this the /mcp DNS-rebind guard 403s any request whose\n      # Host header isn't loopback — LiteLLM connects by this Service DNS name.\n      MCP_SERVER_URL: \"http://mcp-servers-gitlab.mcp-servers.svc.cluster.local:3002\"\n      GITLAB_API_URL: http://gitlab-webservice-default.gitlab.svc.cluster.local:8181/api/v4\n      GITLAB_PERSONAL_ACCESS_TOKEN: \"\"  # set via Tiltfile/terraform\n      # ponytail: server holds a static PAT (not per-client OAuth), so this\n      # is the \"who's allowed to call this server\" bearer token — required\n      # by the image whenever STREAMABLE_HTTP + a static PAT are combined.\n      STREAMABLE_HTTP_AUTH_TOKEN: \"\"  # set via Tiltfile/terraform\n\n  n8n:\n    # ponytail: czlonkowski/n8n-mcp — node docs + workflow validation always,\n    # plus workflow-management tools when N8N_API_KEY is set. The key is minted\n    # at runtime by playbooks/n8n.yml (this stack never stores one), which\n    # patches it into this Deployment's env — blank here = docs-only until then.\n    image: ghcr.io/czlonkowski/n8n-mcp:latest\n    port: 3000\n    env:\n      MCP_MODE: \"http\"\n      PORT: \"3000\"\n      # n8n-mcp refuses to start in http mode without this (per-request bearer).\n      AUTH_TOKEN: \"\"  # set via Tiltfile/terraform (TF_VAR_n8n_mcp_auth_token)\n      N8N_API_URL: http://n8n.n8n.svc.cluster.local:5678\n      N8N_API_KEY: \"\"  # patched in by playbooks/n8n.yml after it mints a key\n      LOG_LEVEL: warn\n\n  playwright:\n    image: mcr.microsoft.com/playwright/mcp:latest\n    command: [\"node\", \"/app/cli.js\"]\n    # ponytail: --allowed-hosts \"*\" — same DNS-rebind guard as the others; the\n    # server otherwise 403s anything not hitting it as localhost:8931.\n    args: [\"--headless\", \"--browser\", \"chromium\", \"--no-sandbox\", \"--port\", \"8931\", \"--host\", \"0.0.0.0\", \"--allowed-hosts\", \"*\"]\n    port: 8931\n    # ponytail: real chromium instance, not a thin API wrapper — needs more\n    # than the other servers' default resources.\n    resources:\n      requests:\n        cpu: 250m\n        memory: 512Mi\n      limits:\n        memory: 1Gi\n"
            ],
            "verify": false,
            "version": "0.1.0",
            "wait": false,
            "wait_for_jobs": false
          },
          "sensitive_attributes": [
            [
              {
                "type": "get_attr",
                "value": "repository_password"
              }
            ],
            [
              {
                "type": "get_attr",
                "value": "set_sensitive"
              }
            ]
          ],
          "private": "eyJzY2hlbWFfdmVyc2lvbiI6IjEifQ==",
          "dependencies": [
            "kubernetes_namespace.mcp_servers"
          ]
        }
      ]
    },
    {
      "mode": "managed",
      "type": "helm_release",
      "name": "minio",
      "provider": "provider[\"registry.opentofu.org/hashicorp/helm\"]",
      "instances": [
        {
          "schema_version": 1,
          "attributes": {
            "atomic": false,
            "chart": "./../helm/minio",
            "cleanup_on_fail": false,
            "create_namespace": false,
            "dependency_update": true,
            "description": null,
            "devel": null,
            "disable_crd_hooks": false,
            "disable_openapi_validation": false,
            "disable_webhooks": false,
            "force_update": false,
            "id": "minio",
            "keyring": null,
            "lint": false,
            "manifest": null,
            "max_history": 0,
            "metadata": [
              {
                "app_version": "",
                "chart": "minio",
                "first_deployed": 1789017132,
                "last_deployed": 1789115558,
                "name": "minio",
                "namespace": "minio",
                "notes": "\nMinIO can be accessed via port 9000 on the following DNS name from within your cluster:\nminio.minio.cluster.local\n\nTo access MinIO from localhost, run the below commands:\n\n  1. export POD_NAME=$(kubectl get pods --namespace minio -l \"release=minio\" -o jsonpath=\"{.items[0].metadata.name}\")\n\n  2. kubectl port-forward $POD_NAME 9000 --namespace minio\n\nRead more about port forwarding here: http://kubernetes.io/docs/user-guide/kubectl/kubectl_port-forward/\n\nYou can now access MinIO server on http://localhost:9000. Follow the below steps to connect to MinIO server with mc client:\n\n  1. Download the MinIO mc client - https://min.io/docs/minio/linux/reference/minio-mc.html#quickstart\n\n  2. export MC_HOST_minio-local=http://$(kubectl get secret --namespace minio minio -o jsonpath=\"{.data.rootUser}\" | base64 --decode):$(kubectl get secret --namespace minio minio -o jsonpath=\"{.data.rootPassword}\" | base64 --decode)@localhost:9000\n\n  3. mc ls minio-local\n\n\n",
                "revision": 4,
                "values": "{\"minio\":{\"buckets\":[{\"name\":\"gitlab-runner-cache\"},{\"name\":\"git-lfs\"},{\"name\":\"gitlab-artifacts\"},{\"name\":\"gitlab-uploads\"},{\"name\":\"gitlab-packages\"},{\"name\":\"gitlab-mr-diffs\"},{\"name\":\"gitlab-dependency-proxy\"},{\"name\":\"gitlab-terraform-state\"},{\"name\":\"gitlab-ci-secure-files\"},{\"name\":\"gitlab-backups\"}],\"consoleIngress\":{\"annotations\":{\"cert-manager.io/cluster-issuer\":\"homelab-ca-issuer\"},\"enabled\":true,\"hosts\":[\"minio-console.local\"],\"ingressClassName\":\"traefik\",\"tls\":[{\"hosts\":[\"minio-console.local\"],\"secretName\":\"minio-console.local-tls\"}]},\"drivesPerNode\":1,\"environment\":{\"MINIO_BROWSER\":\"on\",\"MINIO_IDENTITY_OPENID_CLAIM_NAME\":\"policy\",\"MINIO_IDENTITY_OPENID_CLIENT_ID\":\"(sensitive value)\",\"MINIO_IDENTITY_OPENID_CLIENT_SECRET\":\"(sensitive value)\",\"MINIO_IDENTITY_OPENID_CONFIG_URL\":\"https://authentik.tail60240b.ts.net/application/o/minio/.well-known/openid-configuration\",\"MINIO_IDENTITY_OPENID_DISPLAY_NAME\":\"Authentik\",\"MINIO_IDENTITY_OPENID_REDIRECT_URI\":\"https://minio-console.tail60240b.ts.net/oauth_callback\",\"MINIO_IDENTITY_OPENID_SCOPES\":\"openid,profile,email,policy\"},\"image\":{\"repository\":\"quay.io/minio/minio\",\"tag\":\"RELEASE.2024-11-07T00-52-20Z\"},\"ingress\":{\"annotations\":{\"cert-manager.io/cluster-issuer\":\"homelab-ca-issuer\"},\"enabled\":true,\"hosts\":[\"minio.local\"],\"ingressClassName\":\"traefik\",\"tls\":[{\"hosts\":[\"minio.local\"],\"secretName\":\"minio.local-tls\"}]},\"mode\":\"standalone\",\"persistence\":{\"size\":\"8Gi\"},\"pools\":1,\"replicas\":1,\"resources\":{\"limits\":{\"memory\":\"512Mi\"},\"requests\":{\"cpu\":\"50m\",\"memory\":\"256Mi\"}},\"rootPassword\":\"(sensitive value)\",\"rootUser\":\"admin\",\"trustedCertsSecret\":\"minio-homelab-ca\"}}",
                "version": "0.1.0"
              }
            ],
            "name": "minio",
            "namespace": "minio",
            "pass_credentials": false,
            "postrender": [],
            "recreate_pods": false,
            "render_subchart_notes": true,
            "replace": false,
            "repository": null,
            "repository_ca_file": null,
            "repository_cert_file": null,
            "repository_key_file": null,
            "repository_password": null,
            "repository_username": null,
            "reset_values": false,
            "reuse_values": false,
            "set": [],
            "set_list": [],
            "set_sensitive": [
              {
                "name": "minio.environment.MINIO_IDENTITY_OPENID_CLIENT_ID",
                "type": "",
                "value": "dev-minio-oidc-client-id"
              },
              {
                "name": "minio.environment.MINIO_IDENTITY_OPENID_CLIENT_SECRET",
                "type": "",
                "value": "dev-minio-oidc-client-secret-not-for-prod-use"
              },
              {
                "name": "minio.rootPassword",
                "type": "",
                "value": "dev-minio-root-password"
              }
            ],
            "skip_crds": false,
            "status": "deployed",
            "timeout": 600,
            "upgrade_install": null,
            "values": [
              "minio:\r\n  image:\r\n    repository: quay.io/minio/minio\r\n    # ponytail: pinned — newer builds (tried up through RELEASE.2025-09-07)\r\n    # have a regression where the WebUI never shows the SSO login button\r\n    # despite fully correct, live-verified server-side OIDC config. This tag\r\n    # matches a known-working reference project exactly. Re-test on chart/\r\n    # image bumps before moving off it.\r\n    tag: RELEASE.2024-11-07T00-52-20Z\r\n\r\n  mode: standalone\r\n  replicas: 1\r\n  drivesPerNode: 1\r\n  pools: 1\r\n\r\n  rootUser: admin\r\n  rootPassword: \"\"  # set via terraform variable\r\n\r\n  # ponytail: MinIO does OIDC discovery server-side against Authentik's tailnet\r\n  # HTTPS URL; terraform/coredns.tf points that name at traefik in-cluster with\r\n  # a homelab-CA cert, so MinIO must trust that CA. terraform swaps in the\r\n  # secret name; Tilt (no tailnet ingress) swaps in \"\" to skip the mount.\r\n  trustedCertsSecret: \"minio-homelab-ca\"\r\n\r\n  # ponytail: chart's post-install job (`mc mb`) creates these. GitLab's\r\n  # consolidated object storage + the CI runner cache all need their bucket\r\n  # to pre-exist — S3 doesn't auto-create. Names must match the buckets in\r\n  # helm/gitlab/values.yaml appConfig + the runner cache config.\r\n  buckets:\r\n    - name: gitlab-runner-cache\r\n    - name: git-lfs\r\n    - name: gitlab-artifacts\r\n    - name: gitlab-uploads\r\n    - name: gitlab-packages\r\n    - name: gitlab-mr-diffs\r\n    - name: gitlab-dependency-proxy\r\n    - name: gitlab-terraform-state\r\n    - name: gitlab-ci-secure-files\r\n    - name: gitlab-backups\r\n\r\n  persistence:\r\n    size: 8Gi\r\n\r\n  resources:\r\n    requests:\r\n      cpu: 50m\r\n      memory: 256Mi\r\n    limits:\r\n      memory: 512Mi\r\n\r\n  # ponytail: fixed dev client_id/secret matching the Authentik OAuth2\r\n  # provider created via the API (same one-time-setup pattern as GitLab's).\r\n  # If minio boots before Authentik/tailscale-serve is reachable (e.g. after\r\n  # a full cluster/host restart), the discovery fetch below 502s once and\r\n  # OIDC stays disabled for that pod's lifetime — no retry. Fix: `kubectl\r\n  # rollout restart deploy/minio -n minio` once Authentik is up. Chart has\r\n  # no initContainers hook to wait-for-it automatically (only extraContainers,\r\n  # which doesn't block startup), not worth patching the chart for a homelab.\r\n  environment:\r\n    MINIO_BROWSER: \"on\"\r\n    MINIO_IDENTITY_OPENID_CONFIG_URL: \"https://authentik.tail60240b.ts.net/application/o/minio/.well-known/openid-configuration\"\r\n    # MINIO_IDENTITY_OPENID_CLIENT_ID / _CLIENT_SECRET set via Tiltfile/terraform (.env)\r\n    MINIO_IDENTITY_OPENID_CLAIM_NAME: \"policy\"\r\n    MINIO_IDENTITY_OPENID_SCOPES: \"openid,profile,email,policy\"\r\n    MINIO_IDENTITY_OPENID_REDIRECT_URI: \"https://minio-console.tail60240b.ts.net/oauth_callback\"\r\n    MINIO_IDENTITY_OPENID_DISPLAY_NAME: \"Authentik\"\r\n\r\n  ingress:\r\n    enabled: true\r\n    ingressClassName: traefik\r\n    annotations:\r\n      cert-manager.io/cluster-issuer: homelab-ca-issuer\r\n    hosts:\r\n      - minio.local\r\n    tls:\r\n      - secretName: minio.local-tls\r\n        hosts:\r\n          - minio.local\r\n\r\n  consoleIngress:\r\n    enabled: true\r\n    ingressClassName: traefik\r\n    annotations:\r\n      cert-manager.io/cluster-issuer: homelab-ca-issuer\r\n    hosts:\r\n      - minio-console.local\r\n    tls:\r\n      - secretName: minio-console.local-tls\r\n        hosts:\r\n          - minio-console.local\r\n"
            ],
            "verify": false,
            "version": "0.1.0",
            "wait": true,
            "wait_for_jobs": false
          },
          "sensitive_attributes": [
            [
              {
                "type": "get_attr",
                "value": "repository_password"
              }
            ],
            [
              {
                "type": "get_attr",
                "value": "set_sensitive"
              }
            ]
          ],
          "private": "eyJzY2hlbWFfdmVyc2lvbiI6IjEifQ==",
          "dependencies": [
            "data.kubernetes_secret.homelab_ca_minio",
            "helm_release.cert_manager",
            "kubectl_manifest.homelab_ca",
            "kubectl_manifest.selfsigned_bootstrap",
            "kubernetes_namespace.cert_manager",
            "kubernetes_namespace.minio",
            "kubernetes_secret.minio_homelab_ca",
            "null_resource.homelab_ca_ready"
          ]
        }
      ]
    },
    {
      "mode": "managed",
      "type": "helm_release",
      "name": "n8n",
      "provider": "provider[\"registry.opentofu.org/hashicorp/helm\"]",
      "instances": [
        {
          "schema_version": 1,
          "attributes": {
            "atomic": false,
            "chart": "./../helm/n8n",
            "cleanup_on_fail": false,
            "create_namespace": false,
            "dependency_update": true,
            "description": null,
            "devel": null,
            "disable_crd_hooks": false,
            "disable_openapi_validation": false,
            "disable_webhooks": false,
            "force_update": false,
            "id": "n8n",
            "keyring": null,
            "lint": false,
            "manifest": null,
            "max_history": 0,
            "metadata": [
              {
                "app_version": "",
                "chart": "n8n",
                "first_deployed": 1789017394,
                "last_deployed": 1789115558,
                "name": "n8n",
                "namespace": "n8n",
                "notes": "1. Get the application URL by running these commands:\n  export POD_NAME=$(kubectl get pods --namespace n8n -l \"app.kubernetes.io/name=n8n,app.kubernetes.io/instance=n8n\" -o jsonpath=\"{.items[0].metadata.name}\")\n  export CONTAINER_PORT=$(kubectl get pod --namespace n8n $POD_NAME -o jsonpath=\"{.spec.containers[0].ports[0].containerPort}\")\n  echo \"Visit http://127.0.0.1:8080 to use your application\"\n  kubectl --namespace n8n port-forward $POD_NAME 8080:$CONTAINER_PORT\n",
                "revision": 3,
                "values": "{\"n8n\":{\"db\":{\"type\":\"postgresdb\"},\"encryptionKey\":\"(sensitive value)\",\"externalPostgresql\":{\"database\":\"n8n\",\"host\":\"postgres.postgres.svc.cluster.local\",\"password\":\"(sensitive value)\",\"port\":5432,\"username\":\"n8n\"},\"main\":{\"extraEnvVars\":{\"EXTERNAL_FRONTEND_HOOKS_URLS\":\"/assets/oidc-frontend-hook.js\",\"EXTERNAL_HOOK_FILES\":\"/hooks/hooks.js\",\"GITLAB_WEBHOOK_SECRET\":\"(sensitive value)\",\"LITELLM_BASE\":\"http://litellm.litellm.svc.cluster.local:4000\",\"LITELLM_MASTER_KEY\":\"(sensitive value)\",\"N8N_ADDITIONAL_NON_UI_ROUTES\":\"auth\",\"N8N_BLOCK_ENV_ACCESS_IN_NODE\":\"false\",\"N8N_EDITOR_BASE_URL\":\"https://n8n.tail60240b.ts.net/\",\"N8N_PROTOCOL\":\"https\",\"N8N_WEBHOOK_BASE\":\"http://localhost:5678/webhook\",\"NODES_EXCLUDE\":\"[]\",\"NODE_EXTRA_CA_CERTS\":\"/homelab-ca/ca.crt\",\"OIDC_CLIENT_ID\":\"(sensitive value)\",\"OIDC_CLIENT_SECRET\":\"(sensitive value)\",\"OIDC_ISSUER_URL\":\"https://authentik.tail60240b.ts.net/application/o/n8n/\",\"OIDC_REDIRECT_URI\":\"https://n8n.tail60240b.ts.net/auth/oidc/callback\",\"WEBHOOK_URL\":\"https://n8n.tail60240b.ts.net/\"},\"livenessProbe\":{\"timeoutSeconds\":10},\"persistence\":{\"annotations\":{},\"enabled\":true},\"readinessProbe\":{\"timeoutSeconds\":10},\"resources\":{\"limits\":{\"memory\":\"1Gi\"},\"requests\":{\"cpu\":\"50m\",\"memory\":\"512Mi\"}},\"volumeMounts\":[{\"mountPath\":\"/hooks\",\"name\":\"oidc-hooks\",\"readOnly\":true},{\"mountPath\":\"/homelab-ca\",\"name\":\"homelab-ca\",\"readOnly\":true}],\"volumes\":[{\"configMap\":{\"name\":\"n8n-oidc-hooks\"},\"name\":\"oidc-hooks\"},{\"name\":\"homelab-ca\",\"secret\":{\"optional\":true,\"secretName\":\"homelab-ca\"}}]}}}",
                "version": "0.1.1"
              }
            ],
            "name": "n8n",
            "namespace": "n8n",
            "pass_credentials": false,
            "postrender": [],
            "recreate_pods": false,
            "render_subchart_notes": true,
            "replace": false,
            "repository": null,
            "repository_ca_file": null,
            "repository_cert_file": null,
            "repository_key_file": null,
            "repository_password": null,
            "repository_username": null,
            "reset_values": false,
            "reuse_values": false,
            "set": [
              {
                "name": "n8n.main.extraEnvVars.NODE_EXTRA_CA_CERTS",
                "type": "",
                "value": "/homelab-ca/ca.crt"
              }
            ],
            "set_list": [],
            "set_sensitive": [
              {
                "name": "n8n.encryptionKey",
                "type": "",
                "value": "dev-n8n-encryption-key-not-for-prod-use"
              },
              {
                "name": "n8n.externalPostgresql.password",
                "type": "",
                "value": "dev-shared-db-password-not-for-prod-use"
              },
              {
                "name": "n8n.main.extraEnvVars.GITLAB_WEBHOOK_SECRET",
                "type": "",
                "value": "dev-gitlab-webhook-secret-not-for-prod-use"
              },
              {
                "name": "n8n.main.extraEnvVars.LITELLM_MASTER_KEY",
                "type": "",
                "value": "sk-dev-litellm-master-key-not-for-prod-use"
              },
              {
                "name": "n8n.main.extraEnvVars.OIDC_CLIENT_ID",
                "type": "",
                "value": "dev-n8n-oidc-client-id"
              },
              {
                "name": "n8n.main.extraEnvVars.OIDC_CLIENT_SECRET",
                "type": "",
                "value": "dev-n8n-oidc-client-secret-not-for-prod-use"
              }
            ],
            "skip_crds": false,
            "status": "deployed",
            "timeout": 600,
            "upgrade_install": null,
            "values": [
              "n8n:\r\n  # ponytail: postgres (external) instead of sqlite — sqlite's single-writer\r\n  # lock stalls under the SDLC flows' concurrent webhook fan-out. Connects to\r\n  # the shared postgres (helm/postgres), database + role `n8n`.\r\n  db:\r\n    type: postgresdb\r\n  externalPostgresql:\r\n    host: postgres.postgres.svc.cluster.local\r\n    port: 5432\r\n    username: n8n\r\n    database: n8n\r\n    password: \"\"  # set via Tiltfile/terraform (shared_db_password)\r\n\r\n  main:\r\n    persistence:\r\n      enabled: true\r\n      # ponytail: chart defaults this to \"helm.sh/resource-policy: keep\",\r\n      # which makes Tilt refuse to recreate the PVC after a manual delete\r\n      # (e.g. wiping it to reset the encryption key) — drop it so Tilt fully\r\n      # owns the PVC lifecycle like every other app's storage in this repo.\r\n      annotations: {}\r\n    resources:\r\n      requests:\r\n        cpu: 50m\r\n        memory: 512Mi\r\n      limits:\r\n        # ponytail: 512Mi wasn't enough headroom for Node's heap on top of\r\n        # n8n's own footprint — OOMKilled with \"JavaScript heap out of memory\"\r\n        memory: 1Gi\r\n\r\n    # ponytail: chart's 1s default probe timeout is too tight on this RPi\r\n    # under load (6 apps running concurrently) — caused a liveness-kill\r\n    # restart loop even though n8n was actually up. Same fix as sonarqube/\r\n    # seafile-mariadb's probe timeouts.\r\n    livenessProbe:\r\n      timeoutSeconds: 10\r\n    readinessProbe:\r\n      timeoutSeconds: 10\r\n\r\n    # ponytail: n8n gates native OIDC/SSO behind an Enterprise license.\r\n    # cweagans/n8n-oidc (MIT) bolts it on via n8n's external-hooks system\r\n    # instead — no license, no fork, just a JS file + env vars. hooks.js is\r\n    # mounted from a ConfigMap the Tiltfile builds from helm/n8n/hooks.js.\r\n    volumes:\r\n      - name: oidc-hooks\r\n        configMap:\r\n          name: n8n-oidc-hooks\r\n      # ponytail: homelab-ca Secret — optional so Tilt (no tailnet ingress,\r\n      # no coredns rewrite, OIDC_ISSUER_URL stays plain) still boots without\r\n      # it. See terraform/n8n.tf for the copy-in + NODE_EXTRA_CA_CERTS below.\r\n      - name: homelab-ca\r\n        secret:\r\n          secretName: homelab-ca\r\n          optional: true\r\n    volumeMounts:\r\n      - name: oidc-hooks\r\n        mountPath: /hooks\r\n        readOnly: true\r\n      - name: homelab-ca\r\n        mountPath: /homelab-ca\r\n        readOnly: true\r\n\r\n    # ponytail: fixed dev client_id/secret matching the Authentik OAuth2\r\n    # provider created via the API (same one-time-setup pattern as the\r\n    # other apps'). OIDC_ISSUER_URL uses the tailscale hostname so the\r\n    # server-side discovery fetch and the browser redirect agree on the\r\n    # same authority — same reasoning as minio/gitlab's OIDC wiring.\r\n    extraEnvVars:\r\n      # ponytail: n8n 2.0 disables executeCommand + localFileTrigger by default\r\n      # (NODES_EXCLUDE defaults to that pair). The SDLC flows are built on\r\n      # executeCommand — without this, seeded flows fail to activate and a\r\n      # manual run 502s. \"[]\" re-enables all. Revisit if these flows ever stop\r\n      # shelling out (GitLab REST node instead of glab, k8s API instead of kubectl).\r\n      NODES_EXCLUDE: \"[]\"\r\n      # ponytail: flows call sibling flows by webhook (…/spawn-role, …/dod-check).\r\n      # In-cluster self-call over localhost — no proxy round-trip, no tailnet.\r\n      N8N_WEBHOOK_BASE: \"http://localhost:5678/webhook\"\r\n      # F-28 mm-chat: LiteLLM base + key so the chat flow can POST\r\n      # /v1/chat/completions against the `omp` model (always-on omp pod via\r\n      # omp-adapter). LITELLM_MASTER_KEY injected by terraform set_sensitive.\r\n      LITELLM_BASE: \"http://litellm.litellm.svc.cluster.local:4000\"\r\n      # the SDLC flows + F-28 read config from $env in expressions; n8n blocks\r\n      # that by default.\r\n      N8N_BLOCK_ENV_ACCESS_IN_NODE: \"false\"\r\n      # F-00 verifies the GitLab webhook's X-GitLab-Token against this. Must\r\n      # match what playbooks/gitlab-webhook.yml registers the hook with.\r\n      # GITLAB_WEBHOOK_SECRET injected by terraform set_sensitive.\r\n      EXTERNAL_HOOK_FILES: \"/hooks/hooks.js\"\r\n      N8N_ADDITIONAL_NON_UI_ROUTES: \"auth\"\r\n      EXTERNAL_FRONTEND_HOOKS_URLS: \"/assets/oidc-frontend-hook.js\"\r\n      N8N_PROTOCOL: \"https\"\r\n      # https://n8n.tail60240b.ts.net / https://authentik.tail60240b.ts.net are string-replaced by terraform/Tiltfile\r\n      # with this app's and Authentik's tailscale-operator MagicDNS URLs\r\n      # (https://n8n.\u003ctailnet\u003e.ts.net etc).\r\n      N8N_EDITOR_BASE_URL: \"https://n8n.tail60240b.ts.net/\"\r\n      WEBHOOK_URL: \"https://n8n.tail60240b.ts.net/\"\r\n      OIDC_ISSUER_URL: \"https://authentik.tail60240b.ts.net/application/o/n8n/\"\r\n      # OIDC_CLIENT_ID / OIDC_CLIENT_SECRET set via Tiltfile/terraform (.env)\r\n      OIDC_REDIRECT_URI: \"https://n8n.tail60240b.ts.net/auth/oidc/callback\"\r\n\r\n# ponytail: flow seeding (and n8n owner setup + API-key minting) moved to the\r\n# ansible runner — helm/ansible/flows/ + playbooks/n8n.yml. Run it with\r\n# `scripts/ansible-run.sh n8n`.\r\n"
            ],
            "verify": false,
            "version": "0.1.1",
            "wait": true,
            "wait_for_jobs": false
          },
          "sensitive_attributes": [
            [
              {
                "type": "get_attr",
                "value": "repository_password"
              }
            ],
            [
              {
                "type": "get_attr",
                "value": "set_sensitive"
              }
            ]
          ],
          "private": "eyJzY2hlbWFfdmVyc2lvbiI6IjEifQ==",
          "dependencies": [
            "data.kubernetes_secret.homelab_ca_n8n",
            "helm_release.cert_manager",
            "helm_release.postgres",
            "kubectl_manifest.homelab_ca",
            "kubectl_manifest.selfsigned_bootstrap",
            "kubernetes_config_map.n8n_oidc_hooks",
            "kubernetes_namespace.cert_manager",
            "kubernetes_namespace.n8n",
            "kubernetes_namespace.postgres",
            "kubernetes_namespace.sdlc",
            "kubernetes_secret.n8n_homelab_ca",
            "null_resource.homelab_ca_ready"
          ]
        }
      ]
    },
    {
      "mode": "managed",
      "type": "helm_release",
      "name": "nextcloud",
      "provider": "provider[\"registry.opentofu.org/hashicorp/helm\"]",
      "instances": [
        {
          "schema_version": 1,
          "attributes": {
            "atomic": false,
            "chart": "./../helm/nextcloud",
            "cleanup_on_fail": false,
            "create_namespace": false,
            "dependency_update": true,
            "description": null,
            "devel": null,
            "disable_crd_hooks": false,
            "disable_openapi_validation": false,
            "disable_webhooks": false,
            "force_update": false,
            "id": "nextcloud",
            "keyring": null,
            "lint": false,
            "manifest": null,
            "max_history": 0,
            "metadata": [
              {
                "app_version": "",
                "chart": "nextcloud",
                "first_deployed": 1789017132,
                "last_deployed": 1789043534,
                "name": "nextcloud",
                "namespace": "nextcloud",
                "notes": "1. Get the nextcloud URL by running:\n\n  export POD_NAME=$(kubectl get pods --namespace nextcloud -l \"app.kubernetes.io/name=nextcloud\" -o jsonpath=\"{.items[0].metadata.name}\")\n  echo http://127.0.0.1:8080/\n  kubectl port-forward --namespace nextcloud $POD_NAME 8080:80\n\n2. Get your nextcloud login credentials by running:\n\n  echo User:     admin\n  echo Password: $(kubectl get secret --namespace nextcloud nextcloud -o jsonpath=\"{.data.nextcloud-password}\" | base64 --decode)\n",
                "revision": 2,
                "values": "{\"mariadb\":{\"database\":\"nextcloud\",\"image\":\"mariadb:11.4\",\"password\":\"(sensitive value)\",\"resources\":{\"limits\":{\"memory\":\"512Mi\"},\"requests\":{\"cpu\":\"50m\",\"memory\":\"256Mi\"}},\"rootPassword\":\"(sensitive value)\",\"storageSize\":\"4Gi\",\"username\":\"nextcloud\"},\"nextcloud\":{\"externalDatabase\":{\"database\":\"nextcloud\",\"enabled\":true,\"host\":\"nextcloud-mariadb\",\"password\":\"(sensitive value)\",\"type\":\"mysql\",\"user\":\"nextcloud\"},\"ingress\":{\"annotations\":{\"cert-manager.io/cluster-issuer\":\"homelab-ca-issuer\"},\"className\":\"traefik\",\"enabled\":true,\"tls\":[{\"hosts\":[\"nextcloud.local\"],\"secretName\":\"nextcloud.local-tls\"}]},\"internalDatabase\":{\"enabled\":false},\"lifecycle\":{\"postStartCommand\":[\"/bin/sh\",\"-c\",\"OCC=\\\"runuser -u www-data -- php /var/www/html/occ\\\"\\ni=0\\nuntil $OCC status 2\\u003e/dev/null | grep -q 'installed: true'; do\\n  i=$((i+1)); [ $i -ge 240 ] \\u0026\\u0026 exit 0; sleep 2\\ndone\\n# ponytail: the k3d node's egress to apps.nextcloud.com is flaky (same\\n# i/o timeouts that hit ACME) — a single app:install often stalls\\n# mid-download. Retry, and only wire up SSO once the app is actually\\n# enabled, so a failed download leaves nextcloud usable (local login)\\n# instead of half-configured. Runs every boot; no-ops once installed.\\nn=0\\nuntil $OCC app:list --output=json 2\\u003e/dev/null | grep -q '\\\"sociallogin\\\"'; do\\n  n=$((n+1)); [ $n -ge 15 ] \\u0026\\u0026 break\\n  $OCC app:install sociallogin 2\\u003e/dev/null || $OCC app:enable sociallogin 2\\u003e/dev/null || true\\n  sleep 6\\ndone\\nif $OCC app:list --output=json 2\\u003e/dev/null | grep -q '\\\"sociallogin\\\"'; then\\n  $OCC config:system:set allow_local_remote_servers --type=boolean --value=true\\n  $OCC config:app:set sociallogin custom_providers --value='{\\\"custom_oidc\\\":[{\\\"name\\\":\\\"authentik\\\",\\\"title\\\":\\\"Authentik\\\",\\\"authorizeUrl\\\":\\\"https://authentik.tail60240b.ts.net/application/o/authorize/\\\",\\\"tokenUrl\\\":\\\"http://authentik-server.authentik.svc.cluster.local/application/o/token/\\\",\\\"userInfoUrl\\\":\\\"http://authentik-server.authentik.svc.cluster.local/application/o/userinfo/\\\",\\\"logoutUrl\\\":\\\"\\\",\\\"clientId\\\":\\\"dev-nextcloud-oidc-client-id\\\",\\\"clientSecret\\\":\\\"dev-nextcloud-oidc-client-secret-not-for-prod-use\\\",\\\"scope\\\":\\\"openid profile email\\\",\\\"groupsClaim\\\":\\\"groups\\\",\\\"displayNameClaim\\\":\\\"name\\\",\\\"style\\\":\\\"\\\",\\\"defaultGroup\\\":\\\"\\\"}]}'\\n  $OCC config:app:set sociallogin update_profile_on_login --value=1\\n  $OCC config:app:set sociallogin disable_registration --value=0\\n  # ponytail: auto-redirect login page straight to Authentik. Reach the\\n  # local login form at /login?noredir=1 if you ever need it.\\n  $OCC config:system:set social_login_auto_redirect --type=boolean --value=true\\nfi\\n\"]},\"mariadb\":{\"enabled\":false},\"nextcloud\":{\"extraEnv\":[{\"name\":\"NEXTCLOUD_TRUSTED_DOMAINS\",\"value\":\"nextcloud.local nextcloud.tail60240b.ts.net\"},{\"name\":\"OVERWRITEHOST\",\"value\":\"nextcloud.tail60240b.ts.net\"},{\"name\":\"OVERWRITEPROTOCOL\",\"value\":\"https\"},{\"name\":\"OVERWRITECLIURL\",\"value\":\"https://nextcloud.tail60240b.ts.net\"},{\"name\":\"TRUSTED_PROXIES\",\"value\":\"10.0.0.0/8 100.64.0.0/10\"}],\"host\":\"nextcloud.local\",\"password\":\"(sensitive value)\",\"podSecurityContext\":{\"fsGroup\":33,\"fsGroupChangePolicy\":\"OnRootMismatch\"},\"username\":\"admin\"},\"persistence\":{\"accessMode\":\"ReadWriteOnce\",\"enabled\":true,\"size\":\"20Gi\"},\"redis\":{\"enabled\":false},\"resources\":{\"limits\":{\"memory\":\"1536Mi\"},\"requests\":{\"cpu\":\"100m\",\"memory\":\"512Mi\"}},\"startupProbe\":{\"enabled\":true,\"failureThreshold\":120,\"initialDelaySeconds\":30,\"periodSeconds\":10}}}",
                "version": "0.1.0"
              }
            ],
            "name": "nextcloud",
            "namespace": "nextcloud",
            "pass_credentials": false,
            "postrender": [],
            "recreate_pods": false,
            "render_subchart_notes": true,
            "replace": false,
            "repository": null,
            "repository_ca_file": null,
            "repository_cert_file": null,
            "repository_key_file": null,
            "repository_password": null,
            "repository_username": null,
            "reset_values": false,
            "reuse_values": false,
            "set": [],
            "set_list": [],
            "set_sensitive": [
              {
                "name": "mariadb.password",
                "type": "",
                "value": "dev-nextcloud-db-password"
              },
              {
                "name": "mariadb.rootPassword",
                "type": "",
                "value": "dev-nextcloud-db-root-password"
              },
              {
                "name": "nextcloud.externalDatabase.password",
                "type": "",
