              "F-04-task-mr-opened.json": "{\r\n  \"name\": \"F-04 Task MR Opened\",\r\n  \"nodes\": [\r\n    {\r\n      \"id\": \"f7b685ac-b6b3-48a9-abbe-40447f4381d4\",\r\n      \"name\": \"Webhook Trigger\",\r\n      \"type\": \"n8n-nodes-base.webhook\",\r\n      \"typeVersion\": 2,\r\n      \"position\": [\r\n        240,\r\n        300\r\n      ],\r\n      \"parameters\": {\r\n        \"path\": \"gitlab-task-mr-opened\",\r\n        \"httpMethod\": \"POST\",\r\n        \"responseMode\": \"onReceived\",\r\n        \"responseData\": \"allEntries\"\r\n      },\r\n      \"webhookId\": \"1bedb63f-c0bb-4844-8ac9-f02ab71fd289\"\r\n    },\r\n    {\r\n      \"id\": \"19f5aa68-7bca-452d-9ac0-eb0148fb49a7\",\r\n      \"name\": \"Respond OK\",\r\n      \"type\": \"n8n-nodes-base.respondToWebhook\",\r\n      \"typeVersion\": 1,\r\n      \"position\": [\r\n        460,\r\n        300\r\n      ],\r\n      \"parameters\": {\r\n        \"respondWith\": \"json\",\r\n        \"responseBody\": \"{\\\"status\\\":\\\"accepted\\\"}\"\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"2af57f60-e829-44b7-86c2-c0b297b48990\",\r\n      \"name\": \"Notify: Task MR opened\",\r\n      \"type\": \"n8n-nodes-base.httpRequest\",\r\n      \"typeVersion\": 4.2,\r\n      \"position\": [\r\n        680,\r\n        300\r\n      ],\r\n      \"parameters\": {\r\n        \"method\": \"POST\",\r\n        \"url\": \"={{ $env.OPENWEBUI_CALLBACK_URL }}\",\r\n        \"sendHeaders\": true,\r\n        \"headerParameters\": {\r\n          \"parameters\": [\r\n            {\r\n              \"name\": \"Content-Type\",\r\n              \"value\": \"application/json\"\r\n            }\r\n          ]\r\n        },\r\n        \"sendBody\": true,\r\n        \"bodyParameters\": {\r\n          \"parameters\": [\r\n            {\r\n              \"name\": \"flow_id\",\r\n              \"value\": \"={{ $json.flow_id ?? '' }}\"\r\n            },\r\n            {\r\n              \"name\": \"message\",\r\n              \"value\": \"\\ud83d\\udd0e Task MR opened \\u2014 TL review + CI parallel\"\r\n            },\r\n            {\r\n              \"name\": \"notes\",\r\n              \"value\": \"\"\r\n            }\r\n          ]\r\n        }\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"daddf81f-124d-4c3d-9762-6b66c98649cf\",\r\n      \"name\": \"TL: MR Review\",\r\n      \"type\": \"n8n-nodes-base.executeCommand\",\r\n      \"typeVersion\": 1,\r\n      \"position\": [\r\n        900,\r\n        200\r\n      ],\r\n      \"parameters\": {\r\n        \"command\": \"omp --role tech-lead --model slow --project {{ $env.REPO_DIR }} --prompt 'Review MR {{ $json.object_attributes.iid }} against pseudocode. Check correctness, style, test coverage. Output: APPROVE or REQUEST_CHANGES with notes.' --non-interactive\"\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"a0f3dfde-0892-429f-9fc9-96f2d31289d5\",\r\n      \"name\": \"Wait CI Result\",\r\n      \"type\": \"n8n-nodes-base.wait\",\r\n      \"typeVersion\": 1,\r\n      \"position\": [\r\n        900,\r\n        400\r\n      ],\r\n      \"parameters\": {\r\n        \"resume\": \"webhook\"\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"6d2aaa6d-9851-4042-afa4-ec3c7337ee11\",\r\n      \"name\": \"Merge TL+CI\",\r\n      \"type\": \"n8n-nodes-base.merge\",\r\n      \"typeVersion\": 3,\r\n      \"position\": [\r\n        1120,\r\n        300\r\n      ],\r\n      \"parameters\": {\r\n        \"mode\": \"waitForAll\"\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"e4024f3c-704d-498f-8ae0-e3a7c504191a\",\r\n      \"name\": \"All Passed?\",\r\n      \"type\": \"n8n-nodes-base.if\",\r\n      \"typeVersion\": 2,\r\n      \"position\": [\r\n        1340,\r\n        300\r\n      ],\r\n      \"parameters\": {\r\n        \"conditions\": {\r\n          \"options\": {\r\n            \"leftValue\": \"={{ $json.tl_result }}\",\r\n            \"operation\": \"equals\",\r\n            \"rightValue\": \"APPROVE\"\r\n          }\r\n        }\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"0005a06a-44ce-4e2e-a29f-72d5cf885594\",\r\n      \"name\": \"GitLab: Approve MR\",\r\n      \"type\": \"n8n-nodes-base.httpRequest\",\r\n      \"typeVersion\": 4.2,\r\n      \"position\": [\r\n        1560,\r\n        200\r\n      ],\r\n      \"parameters\": {\r\n        \"method\": \"POST\",\r\n        \"url\": \"={{ $env.GITLAB_URL }}/api/v4/projects/{{ $env.GITLAB_PROJECT_ID }}/merge_requests/{{ $json.mr_iid }}/approve\",\r\n        \"authentication\": \"genericCredentialType\",\r\n        \"genericAuthType\": \"httpHeaderAuth\",\r\n        \"sendHeaders\": true,\r\n        \"headerParameters\": {\r\n          \"parameters\": [\r\n            {\r\n              \"name\": \"PRIVATE-TOKEN\",\r\n              \"value\": \"={{ $env.GITLAB_TOKEN }}\"\r\n            },\r\n            {\r\n              \"name\": \"Content-Type\",\r\n              \"value\": \"application/json\"\r\n            }\r\n          ]\r\n        }\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"d0a7a36e-9e01-4236-8b03-c4f4505130d7\",\r\n      \"name\": \"Retry \u003c 3?\",\r\n      \"type\": \"n8n-nodes-base.if\",\r\n      \"typeVersion\": 2,\r\n      \"position\": [\r\n        1560,\r\n        400\r\n      ],\r\n      \"parameters\": {\r\n        \"conditions\": {\r\n          \"options\": {\r\n            \"leftValue\": \"={{ $json.retry_count ?? 0 }}\",\r\n            \"operation\": \"smallerEqual\",\r\n            \"rightValue\": \"2\"\r\n          }\r\n        }\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"026275d2-92c9-4a4f-a9a8-888bbe28b92d\",\r\n      \"name\": \"Notify: Review feedback\",\r\n      \"type\": \"n8n-nodes-base.httpRequest\",\r\n      \"typeVersion\": 4.2,\r\n      \"position\": [\r\n        1780,\r\n        480\r\n      ],\r\n      \"parameters\": {\r\n        \"method\": \"POST\",\r\n        \"url\": \"={{ $env.OPENWEBUI_CALLBACK_URL }}\",\r\n        \"sendHeaders\": true,\r\n        \"headerParameters\": {\r\n          \"parameters\": [\r\n            {\r\n              \"name\": \"Content-Type\",\r\n              \"value\": \"application/json\"\r\n            }\r\n          ]\r\n        },\r\n        \"sendBody\": true,\r\n        \"bodyParameters\": {\r\n          \"parameters\": [\r\n            {\r\n              \"name\": \"flow_id\",\r\n              \"value\": \"={{ $json.flow_id ?? '' }}\"\r\n            },\r\n            {\r\n              \"name\": \"message\",\r\n              \"value\": \"\\ud83d\\udd04 MR {{ $json.mr_iid }} needs changes \\u2014 retry {{ $json.retry_count }}/3\"\r\n            },\r\n            {\r\n              \"name\": \"notes\",\r\n              \"value\": \"\"\r\n            }\r\n          ]\r\n        }\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"bca280de-b215-4aaf-b10b-4fb7c032d3bb\",\r\n      \"name\": \"\\u2192 Escalate\",\r\n      \"type\": \"n8n-nodes-base.httpRequest\",\r\n      \"typeVersion\": 4.2,\r\n      \"position\": [\r\n        1780,\r\n        560\r\n      ],\r\n      \"parameters\": {\r\n        \"method\": \"POST\",\r\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/webhook/escalate\",\r\n        \"sendBody\": true,\r\n        \"bodyParameters\": {\r\n          \"parameters\": [\r\n            {\r\n              \"name\": \"reason\",\r\n              \"value\": \"MR {{ $json.mr_iid }} exceeded 3 review retries\"\r\n            }\r\n          ]\r\n        }\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"9f7b1556-3932-4a73-9cc3-c991ff062f64\",\r\n      \"name\": \"Notify: MR approved\",\r\n      \"type\": \"n8n-nodes-base.httpRequest\",\r\n      \"typeVersion\": 4.2,\r\n      \"position\": [\r\n        1780,\r\n        200\r\n      ],\r\n      \"parameters\": {\r\n        \"method\": \"POST\",\r\n        \"url\": \"={{ $env.OPENWEBUI_CALLBACK_URL }}\",\r\n        \"sendHeaders\": true,\r\n        \"headerParameters\": {\r\n          \"parameters\": [\r\n            {\r\n              \"name\": \"Content-Type\",\r\n              \"value\": \"application/json\"\r\n            }\r\n          ]\r\n        },\r\n        \"sendBody\": true,\r\n        \"bodyParameters\": {\r\n          \"parameters\": [\r\n            {\r\n              \"name\": \"flow_id\",\r\n              \"value\": \"={{ $json.flow_id ?? '' }}\"\r\n            },\r\n            {\r\n              \"name\": \"message\",\r\n              \"value\": \"\\u2705 Task MR {{ $json.mr_iid }} approved\"\r\n            },\r\n            {\r\n              \"name\": \"notes\",\r\n              \"value\": \"\"\r\n            }\r\n          ]\r\n        }\r\n      }\r\n    }\r\n  ],\r\n  \"connections\": {\r\n    \"f7b685ac-b6b3-48a9-abbe-40447f4381d4\": {\r\n      \"main\": [\r\n        [\r\n          {\r\n            \"node\": \"19f5aa68-7bca-452d-9ac0-eb0148fb49a7\",\r\n            \"type\": \"main\",\r\n            \"index\": 0\r\n          },\r\n          {\r\n            \"node\": \"2af57f60-e829-44b7-86c2-c0b297b48990\",\r\n            \"type\": \"main\",\r\n            \"index\": 0\r\n          }\r\n        ]\r\n      ]\r\n    },\r\n    \"2af57f60-e829-44b7-86c2-c0b297b48990\": {\r\n      \"main\": [\r\n        [\r\n          {\r\n            \"node\": \"daddf81f-124d-4c3d-9762-6b66c98649cf\",\r\n            \"type\": \"main\",\r\n            \"index\": 0\r\n          },\r\n          {\r\n            \"node\": \"a0f3dfde-0892-429f-9fc9-96f2d31289d5\",\r\n            \"type\": \"main\",\r\n            \"index\": 0\r\n          }\r\n        ]\r\n      ]\r\n    },\r\n    \"daddf81f-124d-4c3d-9762-6b66c98649cf\": {\r\n      \"main\": [\r\n        [\r\n          {\r\n            \"node\": \"6d2aaa6d-9851-4042-afa4-ec3c7337ee11\",\r\n            \"type\": \"main\",\r\n            \"index\": 0\r\n          }\r\n        ]\r\n      ]\r\n    },\r\n    \"a0f3dfde-0892-429f-9fc9-96f2d31289d5\": {\r\n      \"main\": [\r\n        [\r\n          {\r\n            \"node\": \"6d2aaa6d-9851-4042-afa4-ec3c7337ee11\",\r\n            \"type\": \"main\",\r\