              "F-11-uat-qa.json": "{\n  \"name\": \"F-11 UAT QA Stage\",\n  \"nodes\": [\n    {\n      \"id\": \"8975bd3f-7fd8-4900-acde-b52363f289aa\",\n      \"name\": \"Webhook Trigger\",\n      \"type\": \"n8n-nodes-base.webhook\",\n      \"typeVersion\": 2,\n      \"position\": [\n        240,\n        300\n      ],\n      \"parameters\": {\n        \"path\": \"uat-qa\",\n        \"httpMethod\": \"POST\",\n        \"responseMode\": \"onReceived\",\n        \"responseData\": \"allEntries\"\n      },\n      \"webhookId\": \"abea6881-749a-4a6c-b109-427679374864\"\n    },\n    {\n      \"id\": \"b178e8e5-e45f-4200-b826-38c2a36d7bf9\",\n      \"name\": \"Respond OK\",\n      \"type\": \"n8n-nodes-base.respondToWebhook\",\n      \"typeVersion\": 1,\n      \"position\": [\n        460,\n        300\n      ],\n      \"parameters\": {\n        \"respondWith\": \"json\",\n        \"responseBody\": \"{\\\"status\\\":\\\"accepted\\\"}\"\n      }\n    },\n    {\n      \"id\": \"2b46b876-4e1a-4d45-99f0-4f6504a77106\",\n      \"name\": \"Notify: UAT QA running\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4.2,\n      \"position\": [\n        680,\n        300\n      ],\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.OPENWEBUI_CALLBACK_URL }}\",\n        \"sendHeaders\": true,\n        \"headerParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"Content-Type\",\n              \"value\": \"application/json\"\n            }\n          ]\n        },\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"flow_id\",\n              \"value\": \"={{ $json.flow_id ?? '' }}\"\n            },\n            {\n              \"name\": \"message\",\n              \"value\": \"\\ud83e\\uddea UAT QA stage running\"\n            },\n            {\n              \"name\": \"notes\",\n              \"value\": \"\"\n            }\n          ]\n        }\n      }\n    },\n    {\n      \"id\": \"db07fada-4a52-4a73-837e-954b1ab5db37\",\n      \"name\": \"QA: UAT Test Suite\",\n      \"type\": \"n8n-nodes-base.executeCommand\",\n      \"typeVersion\": 1,\n      \"position\": [\n        900,\n        300\n      ],\n      \"parameters\": {\n        \"command\": \"omp --role qa-engineer --model smol --project {{ $env.REPO_DIR }} --prompt 'Run full UAT test suite against UAT environment for {{ $json.body.version }}. Output: pass/fail + coverage report.' --non-interactive\"\n      }\n    },\n    {\n      \"id\": \"c77b337c-e632-467b-8904-bac2f22bb6b7\",\n      \"name\": \"QA Pass?\",\n      \"type\": \"n8n-nodes-base.if\",\n      \"typeVersion\": 2,\n      \"position\": [\n        1120,\n        300\n      ],\n      \"parameters\": {\n        \"conditions\": {\n          \"options\": {\n            \"leftValue\": \"={{ JSON.parse($json.stdout).pass }}\",\n            \"operation\": \"equals\",\n            \"rightValue\": \"true\"\n          }\n        }\n      }\n    },\n    {\n      \"id\": \"de10fdda-5f2c-492e-9499-bbc2217ec54c\",\n      \"name\": \"Label: qa:uat-approved\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4.2,\n      \"position\": [\n        1340,\n        200\n      ],\n      \"parameters\": {\n        \"method\": \"PUT\",\n        \"url\": \"={{ $env.GITLAB_URL }}/api/v4/projects/{{ $env.GITLAB_PROJECT_ID }}/issues/{{ $env.RELEASE_TICKET_ID }}\",\n        \"authentication\": \"genericCredentialType\",\n        \"genericAuthType\": \"httpHeaderAuth\",\n        \"sendHeaders\": true,\n        \"headerParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"PRIVATE-TOKEN\",\n              \"value\": \"={{ $env.GITLAB_TOKEN }}\"\n            },\n            {\n              \"name\": \"Content-Type\",\n              \"value\": \"application/json\"\n            }\n          ]\n        },\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"__json\",\n              \"value\": \"{\\\"add_labels\\\":\\\"qa:uat-approved\\\"}\"\n            }\n          ]\n        }\n      }\n    },\n    {\n      \"id\": \"03d59e9f-a54f-462e-8baa-ef1d0002026b\",\n      \"name\": \"\\u2192 F-12 Security UAT\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4.2,\n      \"position\": [\n        1560,\n        200\n      ],\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/webhook/uat-security\",\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"version\",\n              \"value\": \"={{ $json.body.version }}\"\n            }\n          ]\n        }\n      }\n    },\n    {\n      \"id\": \"7e12f7b9-659c-423b-8590-61c4f1f9f7d7\",\n      \"name\": \"Notify: QA UAT failed\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4.2,\n      \"position\": [\n        1340,\n        400\n      ],\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.OPENWEBUI_CALLBACK_URL }}\",\n        \"sendHeaders\": true,\n        \"headerParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"Content-Type\",\n              \"value\": \"application/json\"\n            }\n          ]\n        },\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"flow_id\",\n              \"value\": \"={{ $json.flow_id ?? '' }}\"\n            },\n            {\n              \"name\": \"message\",\n              \"value\": \"\\u274c UAT QA failed \\u2014 review test report\"\n            },\n            {\n              \"name\": \"notes\",\n              \"value\": \"\"\n            }\n          ]\n        }\n      }\n    }\n  ],\n  \"connections\": {\n    \"8975bd3f-7fd8-4900-acde-b52363f289aa\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"b178e8e5-e45f-4200-b826-38c2a36d7bf9\",\n            \"type\": \"main\",\n            \"index\": 0\n          },\n          {\n            \"node\": \"2b46b876-4e1a-4d45-99f0-4f6504a77106\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"2b46b876-4e1a-4d45-99f0-4f6504a77106\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"db07fada-4a52-4a73-837e-954b1ab5db37\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"db07fada-4a52-4a73-837e-954b1ab5db37\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"c77b337c-e632-467b-8904-bac2f22bb6b7\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"c77b337c-e632-467b-8904-bac2f22bb6b7\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"de10fdda-5f2c-492e-9499-bbc2217ec54c\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ],\n        [\n          {\n            \"node\": \"7e12f7b9-659c-423b-8590-61c4f1f9f7d7\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"de10fdda-5f2c-492e-9499-bbc2217ec54c\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"03d59e9f-a54f-462e-8baa-ef1d0002026b\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    }\n  },\n  \"active\": true,\n  \"tags\": [],\n  \"settings\": {\n    \"executionOrder\": \"v1\"\n  }\n}",
