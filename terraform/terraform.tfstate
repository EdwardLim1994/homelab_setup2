              "F-05-task-mr-merged.json": "{\r\n  \"name\": \"F-05 Task MR Merged\",\r\n  \"nodes\": [\r\n    {\r\n      \"id\": \"f6d90ca8-33d9-4d9d-9dc9-85e3accbf919\",\r\n      \"name\": \"Webhook Trigger\",\r\n      \"type\": \"n8n-nodes-base.webhook\",\r\n      \"typeVersion\": 2,\r\n      \"position\": [\r\n        240,\r\n        300\r\n      ],\r\n      \"parameters\": {\r\n        \"path\": \"gitlab-task-mr-merged\",\r\n        \"httpMethod\": \"POST\",\r\n        \"responseMode\": \"onReceived\",\r\n        \"responseData\": \"allEntries\"\r\n      },\r\n      \"webhookId\": \"be0ec9eb-7225-4d1e-a824-eff2f4c1e226\"\r\n    },\r\n    {\r\n      \"id\": \"4d76d901-f096-468b-bedc-83354eeb0ab9\",\r\n      \"name\": \"Respond OK\",\r\n      \"type\": \"n8n-nodes-base.respondToWebhook\",\r\n      \"typeVersion\": 1,\r\n      \"position\": [\r\n        460,\r\n        300\r\n      ],\r\n      \"parameters\": {\r\n        \"respondWith\": \"json\",\r\n        \"responseBody\": \"{\\\"status\\\":\\\"accepted\\\"}\"\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"b453a6f3-c578-401c-a8cd-4bc72e4dc3c1\",\r\n      \"name\": \"Update DAG State\",\r\n      \"type\": \"n8n-nodes-base.set\",\r\n      \"typeVersion\": 3.4,\r\n      \"position\": [\r\n        680,\r\n        300\r\n      ],\r\n      \"parameters\": {\r\n        \"assignments\": {\r\n          \"assignments\": [\r\n            {\r\n              \"id\": \"f040fb47-aec2-4173-8509-e24468e0a34d\",\r\n              \"name\": \"event\",\r\n              \"value\": \"task_merged\",\r\n              \"type\": \"string\"\r\n            },\r\n            {\r\n              \"id\": \"1a559a8c-2f91-4920-bb69-64a9162496e2\",\r\n              \"name\": \"mr_iid\",\r\n              \"value\": \"={{ $json.object_attributes.iid }}\",\r\n              \"type\": \"string\"\r\n            },\r\n            {\r\n              \"id\": \"d2ea9e0d-c2de-4d30-a817-9b25facee345\",\r\n              \"name\": \"branch\",\r\n              \"value\": \"={{ $json.object_attributes.source_branch }}\",\r\n              \"type\": \"string\"\r\n            }\r\n          ]\r\n        }\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"2ba76ce2-cdb6-4d7b-92ba-a9a2b10d3726\",\r\n      \"name\": \"All Story Tasks Done?\",\r\n      \"type\": \"n8n-nodes-base.httpRequest\",\r\n      \"typeVersion\": 4.2,\r\n      \"position\": [\r\n        900,\r\n        300\r\n      ],\r\n      \"parameters\": {\r\n        \"method\": \"GET\",\r\n        \"url\": \"={{ $env.GITLAB_URL }}/api/v4/projects/{{ $env.GITLAB_PROJECT_ID }}/issues?labels=type:task,status:open\u0026milestone={{ $env.RELEASE_VERSION }}\",\r\n        \"authentication\": \"genericCredentialType\",\r\n        \"genericAuthType\": \"httpHeaderAuth\",\r\n        \"sendHeaders\": true,\r\n        \"headerParameters\": {\r\n          \"parameters\": [\r\n            {\r\n              \"name\": \"PRIVATE-TOKEN\",\r\n              \"value\": \"={{ $env.GITLAB_TOKEN }}\"\r\n            }\r\n          ]\r\n        }\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"9b62d1f1-9a5a-40ee-b9a0-859966ac85e5\",\r\n      \"name\": \"Tasks Remaining?\",\r\n      \"type\": \"n8n-nodes-base.if\",\r\n      \"typeVersion\": 2,\r\n      \"position\": [\r\n        1120,\r\n        300\r\n      ],\r\n      \"parameters\": {\r\n        \"conditions\": {\r\n          \"options\": {\r\n            \"leftValue\": \"={{ $json.length }}\",\r\n            \"operation\": \"equals\",\r\n            \"rightValue\": \"0\"\r\n          }\r\n        }\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"c16a2450-10cf-4cfa-8ff6-b0f3e72d09a9\",\r\n      \"name\": \"\\u2192 F-06 DoD Check\",\r\n      \"type\": \"n8n-nodes-base.httpRequest\",\r\n      \"typeVersion\": 4.2,\r\n      \"position\": [\r\n        1340,\r\n        200\r\n      ],\r\n      \"parameters\": {\r\n        \"method\": \"POST\",\r\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/webhook/dod-check\",\r\n        \"sendBody\": true,\r\n        \"bodyParameters\": {\r\n          \"parameters\": [\r\n            {\r\n              \"name\": \"version\",\r\n              \"value\": \"={{ $env.RELEASE_VERSION }}\"\r\n            }\r\n          ]\r\n        }\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"8894680b-c5a1-4500-ad0c-85ae9b1ed167\",\r\n      \"name\": \"Notify: Task merged\",\r\n      \"type\": \"n8n-nodes-base.httpRequest\",\r\n      \"typeVersion\": 4.2,\r\n      \"position\": [\r\n        1340,\r\n        400\r\n      ],\r\n      \"parameters\": {\r\n        \"method\": \"POST\",\r\n        \"url\": \"={{ $env.OPENWEBUI_CALLBACK_URL }}\",\r\n        \"sendHeaders\": true,\r\n        \"headerParameters\": {\r\n          \"parameters\": [\r\n            {\r\n              \"name\": \"Content-Type\",\r\n              \"value\": \"application/json\"\r\n            }\r\n          ]\r\n        },\r\n        \"sendBody\": true,\r\n        \"bodyParameters\": {\r\n          \"parameters\": [\r\n            {\r\n              \"name\": \"flow_id\",\r\n              \"value\": \"={{ $json.flow_id ?? '' }}\"\r\n            },\r\n            {\r\n              \"name\": \"message\",\r\n              \"value\": \"\\u2705 Task MR merged \\u2014 more tasks pending\"\r\n            },\r\n            {\r\n              \"name\": \"notes\",\r\n              \"value\": \"\"\r\n            }\r\n          ]\r\n        }\r\n      }\r\n    }\r\n  ],\r\n  \"connections\": {\r\n    \"f6d90ca8-33d9-4d9d-9dc9-85e3accbf919\": {\r\n      \"main\": [\r\n        [\r\n          {\r\n            \"node\": \"4d76d901-f096-468b-bedc-83354eeb0ab9\",\r\n            \"type\": \"main\",\r\n            \"index\": 0\r\n          },\r\n          {\r\n            \"node\": \"b453a6f3-c578-401c-a8cd-4bc72e4dc3c1\",\r\n            \"type\": \"main\",\r\n            \"index\": 0\r\n          }\r\n        ]\r\n      ]\r\n    },\r\n    \"b453a6f3-c578-401c-a8cd-4bc72e4dc3c1\": {\r\n      \"main\": [\r\n        [\r\n          {\r\n            \"node\": \"2ba76ce2-cdb6-4d7b-92ba-a9a2b10d3726\",\r\n            \"type\": \"main\",\r\n            \"index\": 0\r\n          }\r\n        ]\r\n      ]\r\n    },\r\n    \"2ba76ce2-cdb6-4d7b-92ba-a9a2b10d3726\": {\r\n      \"main\": [\r\n        [\r\n          {\r\n            \"node\": \"9b62d1f1-9a5a-40ee-b9a0-859966ac85e5\",\r\n            \"type\": \"main\",\r\n            \"index\": 0\r\n          }\r\n        ]\r\n      ]\r\n    },\r\n    \"9b62d1f1-9a5a-40ee-b9a0-859966ac85e5\": {\r\n      \"main\": [\r\n        [\r\n          {\r\n            \"node\": \"c16a2450-10cf-4cfa-8ff6-b0f3e72d09a9\",\r\n            \"type\": \"main\",\r\n            \"index\": 0\r\n          }\r\n        ],\r\n        [\r\n          {\r\n            \"node\": \"8894680b-c5a1-4500-ad0c-85ae9b1ed167\",\r\n            \"type\": \"main\",\r\n            \"index\": 0\r\n          }\r\n        ]\r\n      ]\r\n    }\r\n  },\r\n  \"active\": true,\r\n  \"tags\": [],\r\n  \"settings\": {\r\n    \"executionOrder\": \"v1\"\r\n  }\r\n}",
              "F-06-dod-check.json": "{\r\n  \"name\": \"F-06 DoD Check\",\r\n  \"nodes\": [\r\n    {\r\n      \"id\": \"eda43cdc-9e98-484e-83dd-ff7fc3d2f7ef\",\r\n      \"name\": \"Webhook Trigger\",\r\n      \"type\": \"n8n-nodes-base.webhook\",\r\n      \"typeVersion\": 2,\r\n      \"position\": [\r\n        240,\r\n        300\r\n      ],\r\n      \"parameters\": {\r\n        \"path\": \"dod-check\",\r\n        \"httpMethod\": \"POST\",\r\n        \"responseMode\": \"onReceived\",\r\n        \"responseData\": \"allEntries\"\r\n      },\r\n      \"webhookId\": \"89d8e361-ddcc-4216-b410-f969b0827ce2\"\r\n    },\r\n    {\r\n      \"id\": \"fcd2cdf3-42fa-43fc-98aa-089bc5a012b8\",\r\n      \"name\": \"Respond OK\",\r\n      \"type\": \"n8n-nodes-base.respondToWebhook\",\r\n      \"typeVersion\": 1,\r\n      \"position\": [\r\n        460,\r\n        300\r\n      ],\r\n      \"parameters\": {\r\n        \"respondWith\": \"json\",\r\n        \"responseBody\": \"{\\\"status\\\":\\\"accepted\\\"}\"\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"a590f7ba-c7e8-4d7e-b928-2e53ed38c051\",\r\n      \"name\": \"Notify: DoD check\",\r\n      \"type\": \"n8n-nodes-base.httpRequest\",\r\n      \"typeVersion\": 4.2,\r\n      \"position\": [\r\n        680,\r\n        300\r\n      ],\r\n      \"parameters\": {\r\n        \"method\": \"POST\",\r\n        \"url\": \"={{ $env.OPENWEBUI_CALLBACK_URL }}\",\r\n        \"sendHeaders\": true,\r\n        \"headerParameters\": {\r\n          \"parameters\": [\r\n            {\r\n              \"name\": \"Content-Type\",\r\n              \"value\": \"application/json\"\r\n            }\r\n          ]\r\n        },\r\n        \"sendBody\": true,\r\n        \"bodyParameters\": {\r\n          \"parameters\": [\r\n            {\r\n              \"name\": \"flow_id\",\r\n              \"value\": \"={{ $json.flow_id ?? '' }}\"\r\n            },\r\n            {\r\n              \"name\": \"message\",\r\n              \"value\": \"\\ud83d\\udd2c DoD check running for story\"\r\n            },\r\n            {\r\n              \"name\": \"notes\",\r\n              \"value\": \"\"\r\n            }\r\n          ]\r\n        }\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"1c5e32cb-eeda-4422-bd5b-80546a7143a3\",\r\n      \"name\": \"TL: DoD Evaluation\",\r\n      \"type\": \"n8n-nodes-base.executeCommand\",\r\n      \"typeVersion\": 1,\r\n      \"position\": [\r\n        900,\r\n        300\r\n      ],\r\n      \"parameters\": {\r\n        \"command\": \"omp --role tech-lead --model slow --project {{ $env.REPO_DIR }} --prompt 'Evaluate Definition of Done for story tasks in {{ $json.body.version }}. Check: all tests pass, coverage \\u226580%, no critical lint, pseudocode implemented fully. Output JSON: {pass: bool, notes: string}' --non-interactive\"\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"ac914dd1-65f2-4505-ba31-0f16a13feca7\",\r\n      \"name\": \"DoD Pass?\",\r\n      \"type\": \"n8n-nodes-base.if\",\r\n      \"typeVersion\": 2,\r\n      \"position\": [\r\n        1120,\r\n        300\r\n      ],\r\n      \"parameters\": {\r\n        \"conditions\": {\r\n          \"options\": {\r\n            \"leftValue\": \"={{ JSON.parse($json.stdout).pass }}\",\r\n            \"operation\": \"equals\",\r\n            \"rightValue\": \"true\"\r\n          }\r\n        }\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"14598c3c-4bcb-42da-a706-88e04456e5f3\",\r\n      \"name\": \"\\u2192 F-07 Story MR\",\r\n      \"type\": \"n8n-nodes-base.httpRequest\",\r\n      \"typeVersion\": 4.2,\r\n      \"position\": [\r\n        1340,\r\n        200\r\n      ],\r\n      \"parameters\": {\r\n        \"method\": \"POST\",\r\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/webhook/story-mr-open\",\r\n        \"sendBody\": true,\r\n        \"bodyParameters\": {\r\n          \"parameters\": [\r\n            {\r\n              \"name\": \"version\",\r\n              \"value\": \"={{ $json.body.version }}\"\r\n            }\r\n          ]\r\n        }\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"73274a11-99a5-4946-8a9b-fcf129e509e4\",\r\n      \"name\": \"Notify: DoD fail feedback\",\r\n      \"type\": \"n8n-nodes-base.httpRequest\",\r\n      \"typeVersion\": 4.2,\r\n      \"position\": [\r\n        1340,\r\n        400\r\n      ],\r\n      \"parameters\": {\r\n        \"method\": \"POST\",\r\n        \"url\": \"={{ $env.OPENWEBUI_CALLBACK_URL }}\",\r\n        \"sendHeaders\": true,\r\n        \"headerParameters\": {\r\n          \"parameters\": [\r\n            {\r\n              \"name\": \"Content-Type\",\r\n              \"value\": \"application/json\"\r\n            }\r\n          ]\r\n        },\r\n        \"sendBody\": true,\r\n        \"bodyParameters\": {\r\n          \"parameters\": [\r\n            {\r\n              \"name\": \"flow_id\",\r\n              \"value\": \"={{ $json.flow_id ?? '' }}\"\r\n            },\r\n            {\r\n              \"name\": \"message\",\r\n              \"value\": \"\\u274c DoD failed \\u2014 feedback posted to task branches, re-triggering F-04\"\r\n            },\r\n            {\r\n              \"name\": \"notes\",\r\n              \"value\": \"\"\r\n            }\r\n          ]\r\n        }\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"bb1a533a-181e-4bba-8c29-5fd0fad2d6e3\",\r\n      \"name\": \"Re-trigger F-04 pods\",\r\n      \"type\": \"n8n-nodes-base.httpRequest\",\r\n      \"typeVersion\": 4.2,\r\n      \"position\": [\r\n        1560,\r\n        400\r\n      ],\r\n      \"parameters\": {\r\n        \"method\": \"POST\",\r\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/webhook/gitlab-task-mr-opened\",\r\n        \"sendBody\": true,\r\n        \"bodyParameters\": {\r\n          \"parameters\": [\r\n            {\r\n              \"name\": \"retry\",\r\n              \"value\": \"true\"\r\n            },\r\n            {\r\n              \"name\": \"version\",\r\n              \"value\": \"={{ $json.body.version }}\"\r\n            }\r\n          ]\r\n        }\r\n      }\r\n    }\r\n  ],\r\n  \"connections\": {\r\n    \"eda43cdc-9e98-484e-83dd-ff7fc3d2f7ef\": {\r\n      \"main\": [\r\n        [\r\n          {\r\n            \"node\": \"fcd2cdf3-42fa-43fc-98aa-089bc5a012b8\",\r\n            \"type\": \"main\",\r\n            \"index\": 0\r\n          },\r\n          {\r\n            \"node\": \"a590f7ba-c7e8-4d7e-b928-2e53ed38c051\",\r\n            \"type\": \"main\",\r\n            \"index\": 0\r\n          }\r\n        ]\r\n      ]\r\n    },\r\n    \"a590f7ba-c7e8-4d7e-b928-2e53ed38c051\": {\r\n      \"main\": [\r\n        [\r\n          {\r\n            \"node\": \"1c5e32cb-eeda-4422-bd5b-80546a7143a3\",\r\n            \"type\": \"main\",\r\n            \"index\": 0\r\n          }\r\n        ]\r\n      ]\r\n    },\r\n    \"1c5e32cb-eeda-4422-bd5b-80546a7143a3\": {\r\n      \"main\": [\r\n        [\r\n          {\r\n            \"node\": \"ac914dd1-65f2-4505-ba31-0f16a13feca7\",\r\n            \"type\": \"main\",\r\n            \"index\": 0\r\n          }\r\n        ]\r\n      ]\r\n    },\r\n    \"ac914dd1-65f2-4505-ba31-0f16a13feca7\": {\r\n      \"main\": [\r\n        [\r\n          {\r\n            \"node\": \"14598c3c-4bcb-42da-a706-88e04456e5f3\",\r\n            \"type\": \"main\",\r\n            \"index\": 0\r\n          }\r\n        ],\r\n        [\r\n          {\r\n            \"node\": \"73274a11-99a5-4946-8a9b-fcf129e509e4\",\r\n            \"type\": \"main\",\r\n            \"index\": 0\r\n          }\r\n        ]\r\n      ]\r\n    },\r\n    \"73274a11-99a5-4946-8a9b-fcf129e509e4\": {\r\n      \"main\": [\r\n        [\r\n          {\r\n            \"node\": \"bb1a533a-181e-4bba-8c29-5fd0fad2d6e3\",\r\n            \"type\": \"main\",\r\n            \"index\": 0\r\n          }\r\n        ]\r\n      ]\r\n    }\r\n  },\r\n  \"active\": true,\r\n  \"tags\": [],\r\n  \"settings\": {\r\n    \"executionOrder\": \"v1\"\r\n  }\r\n}",
              "F-07-flow.json": "{\n  \"name\": \"F-07 Story MR Opened\",\n  \"nodes\": [\n    {\n      \"parameters\": {\n        \"httpMethod\": \"POST\",\n        \"path\": \"story-mr-open\",\n        \"responseMode\": \"lastNode\",\n        \"options\": {}\n      },\n      \"id\": \"wh-07\",\n      \"name\": \"Webhook: story-mr-open\",\n      \"type\": \"n8n-nodes-base.webhook\",\n      \"typeVersion\": 1,\n      \"position\": [\n        240,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"command\": \"=echo '{\\\"role\\\":\\\"tech-lead\\\",\\\"task\\\":\\\"open-story-mr\\\",\\\"story_id\\\":\\\"{{ $json.body.story_id }}\\\"}' \u003e /tmp/smr.json \u0026\u0026 opencode run --print \\\"$(cat /tmp/smr.json)\\\"\"\n      },\n      \"id\": \"tl-story-mr\",\n      \"name\": \"TL opens story MR (opencode+glab)\",\n      \"type\": \"n8n-nodes-base.executeCommand\",\n      \"typeVersion\": 1,\n      \"position\": [\n        480,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"command\": \"=sleep 30 \u0026\u0026 echo 'QA cluster deployment complete'\"\n      },\n      \"id\": \"wait-qa-deploy\",\n      \"name\": \"Wait: CI deploys rc to QA cluster\",\n      \"type\": \"n8n-nodes-base.executeCommand\",\n      \"typeVersion\": 1,\n      \"position\": [\n        720,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"command\": \"=echo '{\\\"role\\\":\\\"qa-engineer\\\",\\\"task\\\":\\\"story-testing\\\",\\\"story_id\\\":\\\"{{ $json.body.story_id }}\\\"}' \u003e /tmp/qa-s.json \u0026\u0026 omp run --mode json --role smol @/tmp/qa-s.json\"\n      },\n      \"id\": \"spawn-qa\",\n      \"name\": \"Spawn QA Pod: story-level testing\",\n      \"type\": \"n8n-nodes-base.executeCommand\",\n      \"typeVersion\": 1,\n      \"position\": [\n        960,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"channelId\": \"={{ $env.MM_SDLC_CHANNEL }}\",\n        \"message\": \":eyes: *Story MR ready for your review* — `{{ $json.body.story_id }}`\\nQA story-level tests running on QA cluster.\\n\\n*Your action:* review + approve + merge the story MR.\",\n        \"otherOptions\": {}\n      },\n      \"id\": \"slack-07\",\n      \"name\": \"Mattermost: story MR ready for review\",\n      \"type\": \"n8n-nodes-base.mattermost\",\n      \"typeVersion\": 1,\n      \"position\": [\n        1200,\n        300\n      ],\n      \"credentials\": {\n        \"mattermostApi\": {\n          \"id\": \"mm-creds\",\n          \"name\": \"Mattermost SDLC Bot\"\n        }\n      }\n    }\n  ],\n  \"connections\": {\n    \"Webhook: story-mr-open\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"TL opens story MR (opencode+glab)\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"TL opens story MR (opencode+glab)\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Wait: CI deploys rc to QA cluster\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Wait: CI deploys rc to QA cluster\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Spawn QA Pod: story-level testing\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Spawn QA Pod: story-level testing\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Mattermost: story MR ready for review\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    }\n  },\n  \"active\": true,\n  \"settings\": {\n    \"executionOrder\": \"v1\"\n  },\n  \"tags\": [\n    {\n      \"name\": \"development\"\n    },\n    {\n      \"name\": \"phase-2\"\n    },\n    {\n      \"name\": \"mattermost\"\n    }\n  ]\n}\n",
              "F-07-story-mr-open.json": "{\n  \"name\": \"F-07 Story MR Open\",\n  \"nodes\": [\n    {\n      \"id\": \"df96bafb-4aa1-4c90-9f46-5f7ba30126d3\",\n      \"name\": \"Webhook Trigger\",\n      \"type\": \"n8n-nodes-base.webhook\",\n      \"typeVersion\": 2,\n      \"position\": [\n        240,\n        300\n      ],\n      \"parameters\": {\n        \"path\": \"story-mr-open\",\n        \"httpMethod\": \"POST\",\n        \"responseMode\": \"onReceived\",\n        \"responseData\": \"allEntries\"\n      },\n      \"webhookId\": \"4e7e56cf-aa7d-4a0a-9c87-94ff20e0153f\"\n    },\n    {\n      \"id\": \"ba5062e9-336c-4106-a59e-d53c31cd68c6\",\n      \"name\": \"Respond OK\",\n      \"type\": \"n8n-nodes-base.respondToWebhook\",\n      \"typeVersion\": 1,\n      \"position\": [\n        460,\n        300\n      ],\n      \"parameters\": {\n        \"respondWith\": \"json\",\n        \"responseBody\": \"{\\\"status\\\":\\\"accepted\\\"}\"\n      }\n    },\n    {\n      \"id\": \"4482e1db-09f7-4db2-bab7-cfbf0d8e3ae6\",\n      \"name\": \"Notify: Story MR opening\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4.2,\n      \"position\": [\n        680,\n        300\n      ],\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.OPENWEBUI_CALLBACK_URL }}\",\n        \"sendHeaders\": true,\n        \"headerParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"Content-Type\",\n              \"value\": \"application/json\"\n            }\n          ]\n        },\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"flow_id\",\n              \"value\": \"={{ $json.flow_id ?? '' }}\"\n            },\n            {\n              \"name\": \"message\",\n              \"value\": \"\\ud83d\\udccb Story MR opening \\u2014 TL + QA parallel\"\n            },\n            {\n              \"name\": \"notes\",\n              \"value\": \"\"\n            }\n          ]\n        }\n      }\n    },\n    {\n      \"id\": \"15610405-e40d-45b1-bc0a-c5124fd42a9e\",\n      \"name\": \"TL: Open Story MR\",\n      \"type\": \"n8n-nodes-base.executeCommand\",\n      \"typeVersion\": 1,\n      \"position\": [\n        900,\n        200\n      ],\n      \"parameters\": {\n        \"command\": \"opencode --role tech-lead --model sonnet --prompt 'Open MR from us/{{ $json.body.story_id }} \\u2192 release/{{ $json.body.version }} via glab. Set reviewers.' --non-interactive\"\n      }\n    },\n    {\n      \"id\": \"d93ceb5e-24c0-466b-a4a4-102ad7f2b1d6\",\n      \"name\": \"QA: Story Integration Tests\",\n      \"type\": \"n8n-nodes-base.executeCommand\",\n      \"typeVersion\": 1,\n      \"position\": [\n        900,\n        400\n      ],\n      \"parameters\": {\n        \"command\": \"omp --role qa-engineer --model smol --project {{ $env.REPO_DIR }} --prompt 'Run integration test suite for story {{ $json.body.story_id }}. Report pass/fail with coverage.' --non-interactive\"\n      }\n    },\n    {\n      \"id\": \"f1eaf118-e763-4983-a61e-992b0a37376c\",\n      \"name\": \"Merge TL+QA\",\n      \"type\": \"n8n-nodes-base.merge\",\n      \"typeVersion\": 3,\n      \"position\": [\n        1120,\n        300\n      ],\n      \"parameters\": {\n        \"mode\": \"waitForAll\"\n      }\n    },\n    {\n      \"id\": \"b9e6b8aa-39d6-45fc-9ec0-b76c443c0415\",\n      \"name\": \"Notify: Story MR ready for Edward\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4.2,\n      \"position\": [\n        1340,\n        300\n      ],\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.OPENWEBUI_CALLBACK_URL }}\",\n        \"sendHeaders\": true,\n        \"headerParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"Content-Type\",\n              \"value\": \"application/json\"\n            }\n          ]\n        },\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"flow_id\",\n              \"value\": \"={{ $json.flow_id ?? '' }}\"\n            },\n            {\n              \"name\": \"message\",\n              \"value\": \"\\ud83d\\udc64 Story MR ready \\u2014 Edward please review and merge us/{{ $json.body.story_id }}\"\n            },\n            {\n              \"name\": \"notes\",\n              \"value\": \"\"\n            }\n          ]\n        }\n      }\n    }\n  ],\n  \"connections\": {\n    \"df96bafb-4aa1-4c90-9f46-5f7ba30126d3\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"ba5062e9-336c-4106-a59e-d53c31cd68c6\",\n            \"type\": \"main\",\n            \"index\": 0\n          },\n          {\n            \"node\": \"4482e1db-09f7-4db2-bab7-cfbf0d8e3ae6\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"4482e1db-09f7-4db2-bab7-cfbf0d8e3ae6\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"15610405-e40d-45b1-bc0a-c5124fd42a9e\",\n            \"type\": \"main\",\n            \"index\": 0\n          },\n          {\n            \"node\": \"d93ceb5e-24c0-466b-a4a4-102ad7f2b1d6\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"15610405-e40d-45b1-bc0a-c5124fd42a9e\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"f1eaf118-e763-4983-a61e-992b0a37376c\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"d93ceb5e-24c0-466b-a4a4-102ad7f2b1d6\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"f1eaf118-e763-4983-a61e-992b0a37376c\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"f1eaf118-e763-4983-a61e-992b0a37376c\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"b9e6b8aa-39d6-45fc-9ec0-b76c443c0415\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    }\n  },\n  \"active\": true,\n  \"tags\": [],\n  \"settings\": {\n    \"executionOrder\": \"v1\"\n  }\n}",
              "F-08-flow.json": "{\n  \"name\": \"F-08 Story MR Merged\",\n  \"nodes\": [\n    {\n      \"parameters\": {\n        \"httpMethod\": \"POST\",\n        \"path\": \"story-mr-merged\",\n        \"responseMode\": \"lastNode\",\n        \"options\": {}\n      },\n      \"id\": \"wh-08\",\n      \"name\": \"Webhook: story-mr-merged\",\n      \"type\": \"n8n-nodes-base.webhook\",\n      \"typeVersion\": 1,\n      \"position\": [\n        240,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"command\": \"=glab issue update {{ $json.body.story_id }} --label-add 'merged-to-release' \u0026\u0026 glab issue close {{ $json.body.story_id }}\"\n      },\n      \"id\": \"close-story\",\n      \"name\": \"Close story ticket + label merged-to-release\",\n      \"type\": \"n8n-nodes-base.executeCommand\",\n      \"typeVersion\": 1,\n      \"position\": [\n        480,\n        200\n      ]\n    },\n    {\n      \"parameters\": {\n        \"command\": \"=echo 'Closing child tasks for {{ $json.body.story_id }}'\"\n      },\n      \"id\": \"close-tasks\",\n      \"name\": \"Close all child task tickets\",\n      \"type\": \"n8n-nodes-base.executeCommand\",\n      \"typeVersion\": 1,\n      \"position\": [\n        480,\n        320\n      ]\n    },\n    {\n      \"parameters\": {\n        \"command\": \"=glab issue comment {{ $json.body.release_ticket_id }} --message 'Story GL-{{ $json.body.story_id }} merged to release. Time: {{ new Date().toISOString() }}'\"\n      },\n      \"id\": \"update-rel\",\n      \"name\": \"Update release ticket: deployment log\",\n      \"type\": \"n8n-nodes-base.executeCommand\",\n      \"typeVersion\": 1,\n      \"position\": [\n        480,\n        440\n      ]\n    },\n    {\n      \"parameters\": {\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/cluster-sleep\",\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"cluster\",\n              \"value\": \"qa\"\n            }\n          ]\n        }\n      },\n      \"id\": \"sleep-qa\",\n      \"name\": \"Sleep QA cluster (F-27)\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4,\n      \"position\": [\n        480,\n        560\n      ]\n    },\n    {\n      \"parameters\": {\n        \"jsCode\": \"const dag=$workflow.staticData.dagState||{};\\ndag.mergedStories=dag.mergedStories||[];\\ndag.mergedStories.push($json.body.story_id);\\n$workflow.staticData.dagState=dag;\\nconst all=(dag.mergedStories.length\u003e=(dag.totalStories||999));\\nreturn [{json:{allMerged:all,merged:dag.mergedStories.length,total:dag.totalStories||'?',version:dag.version}}];\"\n      },\n      \"id\": \"check-all-stories\",\n      \"name\": \"All stories merged?\",\n      \"type\": \"n8n-nodes-base.code\",\n      \"typeVersion\": 2,\n      \"position\": [\n        720,\n        380\n      ]\n    },\n    {\n      \"parameters\": {\n        \"channelId\": \"={{ $env.MM_SDLC_CHANNEL }}\",\n        \"message\": \":tada: *All stories merged* to `release/{{ $json.version }}`!\\n\\nRun `/uat {{ $json.version }}` when ready to start UAT.\",\n        \"otherOptions\": {}\n      },\n      \"id\": \"slack-all-done\",\n      \"name\": \"Mattermost: all stories merged — ready for UAT\",\n      \"type\": \"n8n-nodes-base.mattermost\",\n      \"typeVersion\": 1,\n      \"position\": [\n        1200,\n        260\n      ],\n      \"credentials\": {\n        \"mattermostApi\": {\n          \"id\": \"mm-creds\",\n          \"name\": \"Mattermost SDLC Bot\"\n        }\n      }\n    },\n    {\n      \"parameters\": {\n        \"channelId\": \"={{ $env.MM_SDLC_CHANNEL }}\",\n        \"message\": \"✅ Story `{{ $json.body.story_id }}` merged to release branch. Remaining: {{ (($json.total||0)-($json.merged||0)) }} stories.\",\n        \"otherOptions\": {}\n      },\n      \"id\": \"slack-one-merged\",\n      \"name\": \"Mattermost: story merged\",\n      \"type\": \"n8n-nodes-base.mattermost\",\n      \"typeVersion\": 1,\n      \"position\": [\n        1200,\n        500\n      ],\n      \"credentials\": {\n        \"mattermostApi\": {\n          \"id\": \"mm-creds\",\n          \"name\": \"Mattermost SDLC Bot\"\n        }\n      }\n    },\n    {\n      \"parameters\": {\n        \"conditions\": {\n          \"conditions\": [\n            {\n              \"leftValue\": \"={{ $json.allMerged }}\",\n              \"rightValue\": true,\n              \"operator\": {\n                \"type\": \"boolean\",\n                \"operation\": \"equals\"\n              }\n            }\n          ]\n        }\n      },\n      \"id\": \"all-merged-f08\",\n      \"name\": \"All stories merged? [if check]\",\n      \"type\": \"n8n-nodes-base.if\",\n      \"typeVersion\": 2,\n      \"position\": [\n        1200,\n        380\n      ]\n    }\n  ],\n  \"connections\": {\n    \"Webhook: story-mr-merged\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Close story ticket + label merged-to-release\",\n            \"type\": \"main\",\n            \"index\": 0\n          },\n          {\n            \"node\": \"Close all child task tickets\",\n            \"type\": \"main\",\n            \"index\": 0\n          },\n          {\n            \"node\": \"Update release ticket: deployment log\",\n            \"type\": \"main\",\n            \"index\": 0\n          },\n          {\n            \"node\": \"Sleep QA cluster (F-27)\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Close story ticket + label merged-to-release\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"All stories merged?\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"All stories merged?\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"All stories merged? [if check]\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"All stories merged? [if check]\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Mattermost: all stories merged — ready for UAT\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ],\n        [\n          {\n            \"node\": \"Mattermost: story merged\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    }\n  },\n  \"active\": true,\n  \"settings\": {\n    \"executionOrder\": \"v1\"\n  },\n  \"tags\": [\n    {\n      \"name\": \"development\"\n    },\n    {\n      \"name\": \"phase-2\"\n    },\n    {\n      \"name\": \"mattermost\"\n    }\n  ]\n}\n",
              "F-08-story-mr-merged.json": "{\n  \"name\": \"F-08 Story MR Merged\",\n  \"nodes\": [\n    {\n      \"id\": \"ee6c5ffd-4374-4ef1-90b0-4397637f65ad\",\n      \"name\": \"Webhook Trigger\",\n      \"type\": \"n8n-nodes-base.webhook\",\n      \"typeVersion\": 2,\n      \"position\": [\n        240,\n        300\n      ],\n      \"parameters\": {\n        \"path\": \"gitlab-story-mr-merged\",\n        \"httpMethod\": \"POST\",\n        \"responseMode\": \"onReceived\",\n        \"responseData\": \"allEntries\"\n      },\n      \"webhookId\": \"e1932c5d-0bc4-42c3-8723-236fccec563a\"\n    },\n    {\n      \"id\": \"4dec8f15-f4c5-4b25-8202-61ab91db2298\",\n      \"name\": \"Respond OK\",\n      \"type\": \"n8n-nodes-base.respondToWebhook\",\n      \"typeVersion\": 1,\n      \"position\": [\n        460,\n        300\n      ],\n      \"parameters\": {\n        \"respondWith\": \"json\",\n        \"responseBody\": \"{\\\"status\\\":\\\"accepted\\\"}\"\n      }\n    },\n    {\n      \"id\": \"e9c0b402-3e0c-4df5-873f-2b9760d50ef2\",\n      \"name\": \"Close Story Tickets\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4.2,\n      \"position\": [\n        680,\n        200\n      ],\n      \"parameters\": {\n        \"method\": \"PUT\",\n        \"url\": \"={{ $env.GITLAB_URL }}/api/v4/projects/{{ $env.GITLAB_PROJECT_ID }}/issues?labels=type:task,us={{ $json.object_attributes.source_branch }}\",\n        \"authentication\": \"genericCredentialType\",\n        \"genericAuthType\": \"httpHeaderAuth\",\n        \"sendHeaders\": true,\n        \"headerParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"PRIVATE-TOKEN\",\n              \"value\": \"={{ $env.GITLAB_TOKEN }}\"\n            },\n            {\n              \"name\": \"Content-Type\",\n              \"value\": \"application/json\"\n            }\n          ]\n        },\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"__json\",\n              \"value\": \"{\\\"state_event\\\":\\\"close\\\"}\"\n            }\n          ]\n        }\n      }\n    },\n    {\n      \"id\": \"e4d9cac1-ca92-4e65-9c41-011e42d5ea7a\",\n      \"name\": \"Sleep QA Cluster\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4.2,\n      \"position\": [\n        680,\n        400\n      ],\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/webhook/cluster-lifecycle\",\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"action\",\n              \"value\": \"sleep\"\n            },\n            {\n              \"name\": \"cluster\",\n              \"value\": \"qa\"\n            }\n          ]\n        }\n      }\n    },\n    {\n      \"id\": \"ced58661-afae-44e6-a50f-a463c1ffd36d\",\n      \"name\": \"All Stories Merged?\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4.2,\n      \"position\": [\n        900,\n        300\n      ],\n      \"parameters\": {\n        \"method\": \"GET\",\n        \"url\": \"={{ $env.GITLAB_URL }}/api/v4/projects/{{ $env.GITLAB_PROJECT_ID }}/issues?labels=type:user-story,milestone={{ $env.RELEASE_VERSION }}\u0026state=opened\",\n        \"authentication\": \"genericCredentialType\",\n        \"genericAuthType\": \"httpHeaderAuth\",\n        \"sendHeaders\": true,\n        \"headerParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"PRIVATE-TOKEN\",\n              \"value\": \"={{ $env.GITLAB_TOKEN }}\"\n            }\n          ]\n        }\n      }\n    },\n    {\n      \"id\": \"d6a68429-049f-41bd-ae3d-0e73d63f725f\",\n      \"name\": \"All Done?\",\n      \"type\": \"n8n-nodes-base.if\",\n      \"typeVersion\": 2,\n      \"position\": [\n        1120,\n        300\n      ],\n      \"parameters\": {\n        \"conditions\": {\n          \"options\": {\n            \"leftValue\": \"={{ $json.length }}\",\n            \"operation\": \"equals\",\n            \"rightValue\": \"0\"\n          }\n        }\n      }\n    },\n    {\n      \"id\": \"9d8cfb43-de7c-4cb9-b093-1568ada2507b\",\n      \"name\": \"Notify: All stories done\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4.2,\n      \"position\": [\n        1340,\n        200\n      ],\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.OPENWEBUI_CALLBACK_URL }}\",\n        \"sendHeaders\": true,\n        \"headerParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"Content-Type\",\n              \"value\": \"application/json\"\n            }\n          ]\n        },\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"flow_id\",\n              \"value\": \"={{ $json.flow_id ?? '' }}\"\n            },\n            {\n              \"name\": \"message\",\n              \"value\": \"\\ud83c\\udf89 All stories merged \\u2014 release ready for /uat\"\n            },\n            {\n              \"name\": \"notes\",\n              \"value\": \"\"\n            }\n          ]\n        }\n      }\n    },\n    {\n      \"id\": \"238b6c61-6e62-49b6-ae85-8bd3283a024a\",\n      \"name\": \"Notify: More stories pending\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4.2,\n      \"position\": [\n        1340,\n        400\n      ],\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.OPENWEBUI_CALLBACK_URL }}\",\n        \"sendHeaders\": true,\n        \"headerParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"Content-Type\",\n              \"value\": \"application/json\"\n            }\n          ]\n        },\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"flow_id\",\n              \"value\": \"={{ $json.flow_id ?? '' }}\"\n            },\n            {\n              \"name\": \"message\",\n              \"value\": \"\\u2705 Story merged \\u2014 {{ $json.length }} stories still open\"\n            },\n            {\n              \"name\": \"notes\",\n              \"value\": \"\"\n            }\n          ]\n        }\n      }\n    }\n  ],\n  \"connections\": {\n    \"ee6c5ffd-4374-4ef1-90b0-4397637f65ad\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"4dec8f15-f4c5-4b25-8202-61ab91db2298\",\n            \"type\": \"main\",\n            \"index\": 0\n          },\n          {\n            \"node\": \"e9c0b402-3e0c-4df5-873f-2b9760d50ef2\",\n            \"type\": \"main\",\n            \"index\": 0\n          },\n          {\n            \"node\": \"e4d9cac1-ca92-4e65-9c41-011e42d5ea7a\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"e9c0b402-3e0c-4df5-873f-2b9760d50ef2\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"ced58661-afae-44e6-a50f-a463c1ffd36d\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"e4d9cac1-ca92-4e65-9c41-011e42d5ea7a\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"ced58661-afae-44e6-a50f-a463c1ffd36d\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"ced58661-afae-44e6-a50f-a463c1ffd36d\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"d6a68429-049f-41bd-ae3d-0e73d63f725f\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"d6a68429-049f-41bd-ae3d-0e73d63f725f\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"9d8cfb43-de7c-4cb9-b093-1568ada2507b\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ],\n        [\n          {\n            \"node\": \"238b6c61-6e62-49b6-ae85-8bd3283a024a\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    }\n  },\n  \"active\": true,\n  \"tags\": [],\n  \"settings\": {\n    \"executionOrder\": \"v1\"\n  }\n}",
              "F-09-ci-pipeline.json": "{\n  \"name\": \"F-09 CI Pipeline / Version Built\",\n  \"nodes\": [\n    {\n      \"id\": \"12eed3a8-ee21-4de9-b223-84fa33900f25\",\n      \"name\": \"Webhook Trigger\",\n      \"type\": \"n8n-nodes-base.webhook\",\n      \"typeVersion\": 2,\n      \"position\": [\n        240,\n        300\n      ],\n      \"parameters\": {\n        \"path\": \"gitlab-pipeline\",\n        \"httpMethod\": \"POST\",\n        \"responseMode\": \"onReceived\",\n        \"responseData\": \"allEntries\"\n      },\n      \"webhookId\": \"9626f4e0-0a00-4f0a-a75c-2b2b3699f8ce\"\n    },\n    {\n      \"id\": \"6f85a167-06b0-4893-829e-3f6f452ad93e\",\n      \"name\": \"Respond OK\",\n      \"type\": \"n8n-nodes-base.respondToWebhook\",\n      \"typeVersion\": 1,\n      \"position\": [\n        460,\n        300\n      ],\n      \"parameters\": {\n        \"respondWith\": \"json\",\n        \"responseBody\": \"{\\\"status\\\":\\\"accepted\\\"}\"\n      }\n    },\n    {\n      \"id\": \"bf79587f-6d36-4fa9-b41d-8a2817be0b7f\",\n      \"name\": \"Update DAG: pipeline state\",\n      \"type\": \"n8n-nodes-base.set\",\n      \"typeVersion\": 3.4,\n      \"position\": [\n        680,\n        300\n      ],\n      \"parameters\": {\n        \"assignments\": {\n          \"assignments\": [\n            {\n              \"id\": \"11353859-5ea2-4a0a-bc95-a3f9a9108f7c\",\n              \"name\": \"pipeline_id\",\n              \"value\": \"={{ $json.object_attributes.id }}\",\n              \"type\": \"string\"\n            },\n            {\n              \"id\": \"647dc784-c163-4109-acb6-a9c672381976\",\n              \"name\": \"status\",\n              \"value\": \"={{ $json.object_attributes.status }}\",\n              \"type\": \"string\"\n            },\n            {\n              \"id\": \"977b7ed5-d19e-4914-af28-46b2f797689d\",\n              \"name\": \"ref\",\n              \"value\": \"={{ $json.object_attributes.ref }}\",\n              \"type\": \"string\"\n            }\n          ]\n        }\n      }\n    },\n    {\n      \"id\": \"34d645c4-73ac-46ca-9b87-42f98c958057\",\n      \"name\": \"Pipeline Success?\",\n      \"type\": \"n8n-nodes-base.if\",\n      \"typeVersion\": 2,\n      \"position\": [\n        900,\n        300\n      ],\n      \"parameters\": {\n        \"conditions\": {\n          \"options\": {\n            \"leftValue\": \"={{ $json.status }}\",\n            \"operation\": \"equals\",\n            \"rightValue\": \"success\"\n          }\n        }\n      }\n    },\n    {\n      \"id\": \"16400914-1c76-4cb9-b116-fab3b944625b\",\n      \"name\": \"Notify: CI success\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4.2,\n      \"position\": [\n        1120,\n        200\n      ],\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.OPENWEBUI_CALLBACK_URL }}\",\n        \"sendHeaders\": true,\n        \"headerParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"Content-Type\",\n              \"value\": \"application/json\"\n            }\n          ]\n        },\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"flow_id\",\n              \"value\": \"={{ $json.flow_id ?? '' }}\"\n            },\n            {\n              \"name\": \"message\",\n              \"value\": \"\\u2705 Pipeline {{ $json.pipeline_id }} succeeded on {{ $json.ref }}\"\n            },\n            {\n              \"name\": \"notes\",\n              \"value\": \"\"\n            }\n          ]\n        }\n      }\n    },\n    {\n      \"id\": \"413d167d-0b79-45cf-b6e5-f03f6f9bb101\",\n      \"name\": \"Notify: CI failed\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4.2,\n      \"position\": [\n        1120,\n        400\n      ],\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.OPENWEBUI_CALLBACK_URL }}\",\n        \"sendHeaders\": true,\n        \"headerParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"Content-Type\",\n              \"value\": \"application/json\"\n            }\n          ]\n        },\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"flow_id\",\n              \"value\": \"={{ $json.flow_id ?? '' }}\"\n            },\n            {\n              \"name\": \"message\",\n              \"value\": \"\\u274c Pipeline {{ $json.pipeline_id }} FAILED on {{ $json.ref }} \\u2014 check logs\"\n            },\n            {\n              \"name\": \"notes\",\n              \"value\": \"\"\n            }\n          ]\n        }\n      }\n    }\n  ],\n  \"connections\": {\n    \"12eed3a8-ee21-4de9-b223-84fa33900f25\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"6f85a167-06b0-4893-829e-3f6f452ad93e\",\n            \"type\": \"main\",\n            \"index\": 0\n          },\n          {\n            \"node\": \"bf79587f-6d36-4fa9-b41d-8a2817be0b7f\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"bf79587f-6d36-4fa9-b41d-8a2817be0b7f\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"34d645c4-73ac-46ca-9b87-42f98c958057\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"34d645c4-73ac-46ca-9b87-42f98c958057\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"16400914-1c76-4cb9-b116-fab3b944625b\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ],\n        [\n          {\n            \"node\": \"413d167d-0b79-45cf-b6e5-f03f6f9bb101\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    }\n  },\n  \"active\": true,\n  \"tags\": [],\n  \"settings\": {\n    \"executionOrder\": \"v1\"\n  }\n}",
              "F-09-flow.json": "{\n  \"name\": \"F-09 Version Built (CI Webhook)\",\n  \"nodes\": [\n    {\n      \"parameters\": {\n        \"httpMethod\": \"POST\",\n        \"path\": \"ci-version-built\",\n        \"responseMode\": \"lastNode\",\n        \"options\": {}\n      },\n      \"id\": \"wh-09\",\n      \"name\": \"Webhook: ci-version-built\",\n      \"type\": \"n8n-nodes-base.webhook\",\n      \"typeVersion\": 1,\n      \"position\": [\n        240,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"jsCode\": \"const dag=$workflow.staticData.dagState||{};\\ndag.builtImages=dag.builtImages||{};\\ndag.builtImages[$json.body.service]={rcTag:$json.body.rc_tag,image:$json.body.image,builtAt:new Date().toISOString()};\\n$workflow.staticData.dagState=dag;\\nreturn [{json:{service:$json.body.service,rcTag:$json.body.rc_tag}}];\"\n      },\n      \"id\": \"upd-img\",\n      \"name\": \"Update n8n state: rc image built\",\n      \"type\": \"n8n-nodes-base.code\",\n      \"typeVersion\": 2,\n      \"position\": [\n        480,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"channelId\": \"={{ $env.MM_SDLC_CHANNEL }}\",\n        \"message\": \":package: RC image built — `{{ $json.body.service }}:{{ $json.body.rc_tag }}`\\nArgoCD Image Updater deploying to SIT automatically.\",\n        \"otherOptions\": {}\n      },\n      \"id\": \"slack-09\",\n      \"name\": \"Mattermost: rc image built\",\n      \"type\": \"n8n-nodes-base.mattermost\",\n      \"typeVersion\": 1,\n      \"position\": [\n        720,\n        300\n      ],\n      \"credentials\": {\n        \"mattermostApi\": {\n          \"id\": \"mm-creds\",\n          \"name\": \"Mattermost SDLC Bot\"\n        }\n      }\n    }\n  ],\n  \"connections\": {\n    \"Webhook: ci-version-built\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Update n8n state: rc image built\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Update n8n state: rc image built\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Mattermost: rc image built\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    }\n  },\n  \"active\": true,\n  \"settings\": {\n    \"executionOrder\": \"v1\"\n  },\n  \"tags\": [\n    {\n      \"name\": \"development\"\n    },\n    {\n      \"name\": \"phase-2\"\n    },\n    {\n      \"name\": \"mattermost\"\n    }\n  ]\n}\n",
              "F-10-uat.json": "{\r\n  \"name\": \"F-10 /uat\",\r\n  \"nodes\": [\r\n    {\r\n      \"id\": \"4f688152-8908-4662-ba01-94fe7a4b59c3\",\r\n      \"name\": \"Webhook Trigger\",\r\n      \"type\": \"n8n-nodes-base.webhook\",\r\n      \"typeVersion\": 2,\r\n      \"position\": [\r\n        240,\r\n        300\r\n      ],\r\n      \"parameters\": {\r\n        \"path\": \"uat\",\r\n        \"httpMethod\": \"POST\",\r\n        \"responseMode\": \"onReceived\",\r\n        \"responseData\": \"allEntries\"\r\n      },\r\n      \"webhookId\": \"9d868882-f56c-4013-9e6c-aa09a62c9a2c\"\r\n    },\r\n    {\r\n      \"id\": \"ba849c78-367c-440c-a2b0-4ebe9402829b\",\r\n      \"name\": \"Respond OK\",\r\n      \"type\": \"n8n-nodes-base.respondToWebhook\",\r\n      \"typeVersion\": 1,\r\n      \"position\": [\r\n        460,\r\n        300\r\n      ],\r\n      \"parameters\": {\r\n        \"respondWith\": \"json\",\r\n        \"responseBody\": \"{\\\"status\\\":\\\"accepted\\\"}\"\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"bb687645-4875-4fbc-af27-97ea0a50318f\",\r\n      \"name\": \"UAT Safeguard: All Stories Merged?\",\r\n      \"type\": \"n8n-nodes-base.httpRequest\",\r\n      \"typeVersion\": 4.2,\r\n      \"position\": [\r\n        680,\r\n        300\r\n      ],\r\n      \"parameters\": {\r\n        \"method\": \"GET\",\r\n        \"url\": \"={{ $env.GITLAB_URL }}/api/v4/projects/{{ $env.GITLAB_PROJECT_ID }}/issues?milestone={{ $env.RELEASE_VERSION }}\u0026labels=type:user-story\u0026state=opened\",\r\n        \"authentication\": \"genericCredentialType\",\r\n        \"genericAuthType\": \"httpHeaderAuth\",\r\n        \"sendHeaders\": true,\r\n        \"headerParameters\": {\r\n          \"parameters\": [\r\n            {\r\n              \"name\": \"PRIVATE-TOKEN\",\r\n              \"value\": \"={{ $env.GITLAB_TOKEN }}\"\r\n            }\r\n          ]\r\n        }\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"f5ccd427-0605-4317-b184-20232eca15bc\",\r\n      \"name\": \"Safeguard pass?\",\r\n      \"type\": \"n8n-nodes-base.if\",\r\n      \"typeVersion\": 2,\r\n      \"position\": [\r\n        900,\r\n        300\r\n      ],\r\n      \"parameters\": {\r\n        \"conditions\": {\r\n          \"options\": {\r\n            \"leftValue\": \"={{ $json.length }}\",\r\n            \"operation\": \"equals\",\r\n            \"rightValue\": \"0\"\r\n          }\r\n        }\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"ee7fb018-1448-478a-b84a-e5c941d4c299\",\r\n      \"name\": \"Notify: UAT blocked\",\r\n      \"type\": \"n8n-nodes-base.httpRequest\",\r\n      \"typeVersion\": 4.2,\r\n      \"position\": [\r\n        1120,\r\n        400\r\n      ],\r\n      \"parameters\": {\r\n        \"method\": \"POST\",\r\n        \"url\": \"={{ $env.OPENWEBUI_CALLBACK_URL }}\",\r\n        \"sendHeaders\": true,\r\n        \"headerParameters\": {\r\n          \"parameters\": [\r\n            {\r\n              \"name\": \"Content-Type\",\r\n              \"value\": \"application/json\"\r\n            }\r\n          ]\r\n        },\r\n        \"sendBody\": true,\r\n        \"bodyParameters\": {\r\n          \"parameters\": [\r\n            {\r\n              \"name\": \"flow_id\",\r\n              \"value\": \"={{ $json.flow_id ?? '' }}\"\r\n            },\r\n            {\r\n              \"name\": \"message\",\r\n              \"value\": \"\\ud83d\\udeab /uat blocked \\u2014 {{ $json.length }} stories still open, not all merged to release\"\r\n            },\r\n            {\r\n              \"name\": \"notes\",\r\n              \"value\": \"\"\r\n            }\r\n          ]\r\n        }\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"9dda1bce-e5cc-4691-9d73-86e55e3aa0d8\",\r\n      \"name\": \"Wake UAT Cluster\",\r\n      \"type\": \"n8n-nodes-base.httpRequest\",\r\n      \"typeVersion\": 4.2,\r\n      \"position\": [\r\n        1120,\r\n        200\r\n      ],\r\n      \"parameters\": {\r\n        \"method\": \"POST\",\r\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/webhook/cluster-lifecycle\",\r\n        \"sendBody\": true,\r\n        \"bodyParameters\": {\r\n          \"parameters\": [\r\n            {\r\n              \"name\": \"action\",\r\n              \"value\": \"wake\"\r\n            },\r\n            {\r\n              \"name\": \"cluster\",\r\n              \"value\": \"uat\"\r\n            }\r\n          ]\r\n        }\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"dea28236-790c-4e23-9457-aa3686060a62\",\r\n      \"name\": \"ArgoCD: Sync UAT\",\r\n      \"type\": \"n8n-nodes-base.httpRequest\",\r\n      \"typeVersion\": 4.2,\r\n      \"position\": [\r\n        1340,\r\n        200\r\n      ],\r\n      \"parameters\": {\r\n        \"method\": \"POST\",\r\n        \"url\": \"={{ $env.ARGOCD_URL }}/api/v1/applications/{{ $env.ARGOCD_PROJECT }}-uat/sync\",\r\n        \"authentication\": \"genericCredentialType\",\r\n        \"genericAuthType\": \"httpHeaderAuth\",\r\n        \"sendHeaders\": true,\r\n        \"headerParameters\": {\r\n          \"parameters\": [\r\n            {\r\n              \"name\": \"Authorization\",\r\n              \"value\": \"Bearer {{ $env.ARGOCD_TOKEN }}\"\r\n            }\r\n          ]\r\n        }\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"bd6a2087-8ab3-43c3-b49d-addbf6929e31\",\r\n      \"name\": \"Notify: UAT deployed\",\r\n      \"type\": \"n8n-nodes-base.httpRequest\",\r\n      \"typeVersion\": 4.2,\r\n      \"position\": [\r\n        1560,\r\n        200\r\n      ],\r\n      \"parameters\": {\r\n        \"method\": \"POST\",\r\n        \"url\": \"={{ $env.OPENWEBUI_CALLBACK_URL }}\",\r\n        \"sendHeaders\": true,\r\n        \"headerParameters\": {\r\n          \"parameters\": [\r\n            {\r\n              \"name\": \"Content-Type\",\r\n              \"value\": \"application/json\"\r\n            }\r\n          ]\r\n        },\r\n        \"sendBody\": true,\r\n        \"bodyParameters\": {\r\n          \"parameters\": [\r\n            {\r\n              \"name\": \"flow_id\",\r\n              \"value\": \"={{ $json.flow_id ?? '' }}\"\r\n            },\r\n            {\r\n              \"name\": \"message\",\r\n              \"value\": \"\\ud83d\\ude80 UAT deployed \\u2014 triggering QA stage F-11\"\r\n            },\r\n            {\r\n              \"name\": \"notes\",\r\n              \"value\": \"\"\r\n            }\r\n          ]\r\n        }\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"eebeeb33-2386-4944-9bbf-2f6f57cfb60b\",\r\n      \"name\": \"\\u2192 F-11 QA UAT\",\r\n      \"type\": \"n8n-nodes-base.httpRequest\",\r\n      \"typeVersion\": 4.2,\r\n      \"position\": [\r\n        1780,\r\n        200\r\n      ],\r\n      \"parameters\": {\r\n        \"method\": \"POST\",\r\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/webhook/uat-qa\",\r\n        \"sendBody\": true,\r\n        \"bodyParameters\": {\r\n          \"parameters\": [\r\n            {\r\n              \"name\": \"version\",\r\n              \"value\": \"={{ $env.RELEASE_VERSION }}\"\r\n            }\r\n          ]\r\n        }\r\n      }\r\n    }\r\n  ],\r\n  \"connections\": {\r\n    \"4f688152-8908-4662-ba01-94fe7a4b59c3\": {\r\n      \"main\": [\r\n        [\r\n          {\r\n            \"node\": \"ba849c78-367c-440c-a2b0-4ebe9402829b\",\r\n            \"type\": \"main\",\r\n            \"index\": 0\r\n          },\r\n          {\r\n            \"node\": \"bb687645-4875-4fbc-af27-97ea0a50318f\",\r\n            \"type\": \"main\",\r\n            \"index\": 0\r\n          }\r\n        ]\r\n      ]\r\n    },\r\n    \"bb687645-4875-4fbc-af27-97ea0a50318f\": {\r\n      \"main\": [\r\n        [\r\n          {\r\n            \"node\": \"f5ccd427-0605-4317-b184-20232eca15bc\",\r\n            \"type\": \"main\",\r\n            \"index\": 0\r\n          }\r\n        ]\r\n      ]\r\n    },\r\n    \"f5ccd427-0605-4317-b184-20232eca15bc\": {\r\n      \"main\": [\r\n        [\r\n          {\r\n            \"node\": 