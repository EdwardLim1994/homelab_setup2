              "authentik:\n  authentik:\n    secret_key: \"\"  # set via terraform variable\n    log_level: info\n    # ponytail: shared postgres (helm/postgres, db+role `authentik`) and shared\n    # redis (helm/redis, logical DB 1 — GitLab keeps DB 0). The goauthentik\n    # chart's bundled bitnami subcharts stay off.\n    postgresql:\n      host: \"postgres.postgres.svc.cluster.local\"\n      name: \"authentik\"\n      user: \"authentik\"\n      password: \"\"  # set via terraform / Tiltfile (shared_db_password)\n    redis:\n      host: \"redis.redis.svc.cluster.local\"\n      db: 1\n\n  postgresql:\n    enabled: false\n  redis:\n    enabled: false\n\n  server:\n    replicas: 1\n    resources:\n      requests:\n        cpu: 100m\n        memory: 512Mi\n      limits:\n        memory: 1Gi\n    ingress:\n      enabled: true\n      ingressClassName: traefik\n      annotations:\n        cert-manager.io/cluster-issuer: homelab-ca-issuer\n      hosts:\n        - authentik.local\n      tls:\n        - secretName: authentik-tls\n          hosts:\n            - authentik.local\n\n  worker:\n    replicas: 1\n    resources:\n      requests:\n        cpu: 50m\n        memory: 512Mi\n      limits:\n        memory: 1Gi\n\n"
