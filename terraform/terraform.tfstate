    {
      "mode": "managed",
      "type": "helm_release",
      "name": "sonarqube",
      "provider": "provider[\"registry.opentofu.org/hashicorp/helm\"]",
      "instances": [
        {
          "schema_version": 1,
          "attributes": {
            "atomic": false,
            "chart": "./../helm/sonarqube",
            "cleanup_on_fail": false,
            "create_namespace": false,
            "dependency_update": true,
            "description": null,
            "devel": null,
            "disable_crd_hooks": false,
            "disable_openapi_validation": false,
            "disable_webhooks": false,
            "force_update": false,
            "id": "sonarqube",
            "keyring": null,
            "lint": false,
            "manifest": null,
            "max_history": 0,
            "metadata": [
              {
                "app_version": "",
                "chart": "sonarqube",
                "first_deployed": 1789017394,
                "last_deployed": 1789017394,
                "name": "sonarqube",
                "namespace": "sonarqube",
                "notes": "1. Get the application URL by running these commands:\n  http://sonarqube.local\nWARNING: \n         Please note that the SonarQube image runs with a non-root user (uid=1000) belonging to the root group (guid=0). In this way, the chart can support arbitrary user ids as recommended in OpenShift.\n         Please visit https://docs.openshift.com/container-platform/4.14/openshift_images/create-images.html#use-uid_create-images for more information.\n\n\nWARNING: Setting the deployment strategy type is deprecated and will be removed in a future release. It will be hard-coded to Recreate.\n\nWARNING: The deploymentType value is deprecated and won't be supported anymore. SonarQube will be deployed as a Deployment by default.\n",
                "revision": 1,
                "values": "{\"sonarqube\":{\"community\":{\"enabled\":true},\"ingress\":{\"annotations\":{\"cert-manager.io/cluster-issuer\":\"homelab-ca-issuer\"},\"enabled\":true,\"hosts\":[{\"name\":\"sonarqube.local\"}],\"ingressClassName\":\"traefik\",\"tls\":[{\"hosts\":[\"sonarqube.local\"],\"secretName\":\"sonarqube.local-tls\"}]},\"initSysctl\":{\"enabled\":false},\"jdbcOverwrite\":{\"enabled\":true,\"jdbcPassword\":\"(sensitive value)\",\"jdbcUrl\":\"jdbc:postgresql://postgres.postgres.svc.cluster.local:5432/sonarqube\",\"jdbcUsername\":\"sonarqube\"},\"livenessProbe\":{\"timeoutSeconds\":10},\"monitoringPasscode\":\"(sensitive value)\",\"persistence\":{\"enabled\":true,\"size\":\"5Gi\"},\"plugins\":{\"install\":[\"https://github.com/sonar-auth-oidc/sonar-auth-oidc/releases/download/v3.0.0/sonar-auth-oidc-plugin-3.0.0.jar\"]},\"postgresql\":{\"enabled\":false},\"readinessProbe\":{\"timeoutSeconds\":10},\"resources\":{\"limits\":{\"memory\":\"3072M\"},\"requests\":{\"cpu\":\"200m\",\"memory\":\"1536M\"}},\"sonarProperties\":{\"sonar.auth.oidc.enabled\":\"true\",\"sonar.auth.oidc.issuerUri\":\"https://authentik.tail60240b.ts.net/application/o/sonarqube/\",\"sonar.auth.oidc.loginButtonText\":\"Log in with Authentik\",\"sonar.core.serverBaseURL\":\"https://sonarqube.tail60240b.ts.net\"},\"sonarSecretProperties\":\"sonarqube-oidc-secret\",\"startupProbe\":{\"timeoutSeconds\":10}}}",
                "version": "0.1.0"
              }
            ],
            "name": "sonarqube",
            "namespace": "sonarqube",
            "pass_credentials": false,
            "postrender": [],
            "recreate_pods": false,
            "render_subchart_notes": true,
            "replace": false,
            "repository": null,
            "repository_ca_file": null,
            "repository_cert_file": null,
            "repository_key_file": null,
            "repository_password": null,
            "repository_username": null,
            "reset_values": false,
            "reuse_values": false,
            "set": [],
            "set_list": [],
            "set_sensitive": [
              {
                "name": "sonarqube.jdbcOverwrite.jdbcPassword",
                "type": "",
                "value": "dev-shared-db-password-not-for-prod-use"
              },
              {
                "name": "sonarqube.monitoringPasscode",
                "type": "",
                "value": "dev-sonarqube-monitoring-passcode"
              }
            ],
            "skip_crds": false,
            "status": "deployed",
            "timeout": 900,
            "upgrade_install": null,
            "values": [
              "sonarqube:\n  community:\n    enabled: true\n\n  # ponytail: vm.max_map_count for the bundled Elasticsearch needs raising\n  # host-side once (`sudo sysctl -w vm.max_map_count=262144` on the k3d\n  # node/host, persist in /etc/sysctl.d/ if you want it to survive reboots).\n  # Chart's own initSysctl needs a privileged initContainer; skipping that\n  # in favor of the one-time host command.\n  initSysctl:\n    enabled: false\n\n  # monitoringPasscode set via Tiltfile/terraform (.env)\n\n  # ponytail: chart's 1s probe timeout is too tight on this RPi under load\n  # (JVM GC pauses, concurrent image pulls) — caused a liveness-kill restart\n  # loop even though the server was actually up. Same fix as seafile's mariadb.\n  readinessProbe:\n    timeoutSeconds: 10\n  livenessProbe:\n    timeoutSeconds: 10\n  startupProbe:\n    timeoutSeconds: 10\n\n  resources:\n    requests:\n      cpu: 200m\n      memory: 1536M\n    limits:\n      memory: 3072M\n\n  persistence:\n    enabled: true\n    size: 5Gi\n\n  # ponytail: SonarQube Community has no native SSO — this OSS plugin\n  # (sonar-auth-oidc, MIT-ish/Apache) bolts on generic OpenID Connect via\n  # the marketplace-jar mechanism, same \"no license, no fork\" pattern as\n  # n8n's cweagans/n8n-oidc. Its own settings (sonar.auth.oidc.*) are\n  # regular SonarQube global settings, so they load from sonarProperties\n  # below — no manual admin-UI step needed after first boot.\n  plugins:\n    install:\n      - \"https://github.com/sonar-auth-oidc/sonar-auth-oidc/releases/download/v3.0.0/sonar-auth-oidc-plugin-3.0.0.jar\"\n\n  # ponytail: fixed dev client_id/secret matching the Authentik OAuth2\n  # provider created via the API (same one-time-setup pattern as the other\n  # apps). Server base URL uses the tailscale hostname so the browser\n  # redirect and the plugin's own redirect URI agree on the same authority.\n  sonarProperties:\n    sonar.core.serverBaseURL: \"https://sonarqube.tail60240b.ts.net\"\n    sonar.auth.oidc.enabled: \"true\"\n    sonar.auth.oidc.issuerUri: \"https://authentik.tail60240b.ts.net/application/o/sonarqube/\"\n    # sonar.auth.oidc.clientId.secured set via Tiltfile/terraform (.env)\n    sonar.auth.oidc.loginButtonText: \"Log in with Authentik\"\n\n  # ponytail: sonarSecretProperties is a *reference* to an existing Secret\n  # (key \"secret.properties\"), not inline content — the chart concatenates\n  # it after sonarProperties above, so it can override the same keys.\n  # Secret itself is created in the Tiltfile alongside the other apps'\n  # dev-fixed OIDC secrets.\n  sonarSecretProperties: sonarqube-oidc-secret\n\n  # ponytail: shared postgres (helm/postgres), database + role `sonarqube`.\n  postgresql:\n    enabled: false\n  jdbcOverwrite:\n    enabled: true\n    jdbcUrl: \"jdbc:postgresql://postgres.postgres.svc.cluster.local:5432/sonarqube\"\n    jdbcUsername: \"sonarqube\"\n\n  ingress:\n    enabled: true\n    ingressClassName: traefik\n    annotations:\n      cert-manager.io/cluster-issuer: homelab-ca-issuer\n    hosts:\n      - name: sonarqube.local\n    tls:\n      - secretName: sonarqube.local-tls\n        hosts:\n          - sonarqube.local\n\n"
            ],
            "verify": false,
            "version": "0.1.0",
            "wait": true,
            "wait_for_jobs": false
          },
          "sensitive_attributes": [
            [
              {
                "type": "get_attr",
                "value": "repository_password"
              }
            ],
            [
              {
                "type": "get_attr",
                "value": "set_sensitive"
              }
            ]
          ],
          "private": "eyJzY2hlbWFfdmVyc2lvbiI6IjEifQ==",
          "dependencies": [
            "helm_release.postgres",
            "kubernetes_namespace.postgres",
            "kubernetes_namespace.sonarqube",
            "kubernetes_secret.sonarqube_oidc"
          ]
        }
      ]
    },
    {
      "mode": "managed",
