            "status": "deployed",
            "timeout": 600,
            "upgrade_install": null,
            "values": [
              "tailscale-operator:\n  # ponytail: oauth.clientId / oauth.clientSecret come from Tiltfile/terraform\n  # (.env: TF_VAR_tailscale_oauth_client_id / _secret). Create the OAuth client\n  # once in the Tailscale admin console (Settings -\u003e OAuth clients) with write\n  # scope on Devices/Core and Keys/Auth Keys, and set tag:k8s-operator as a\n  # tagOwner of tag:k8s in the tailnet ACL. See helm/tailscale-operator/README\n  # note in terraform/tailscale.tf.\n  oauth:\n    clientId: \"\"\n    clientSecret: \"\"\n\n  # ponytail: chart default already creates the `tailscale` IngressClass and\n  # installs CRDs — nothing else to configure for L7 Ingress exposure. Each\n  # app opts in with `ingressClassName: tailscale` + `tls.hosts: [\u003cname\u003e]`.\n  operatorConfig:\n    hostname: \"homelab-operator\"\n"
            ],
            "verify": false,
            "version": "0.1.0",
            "wait": true,
            "wait_for_jobs": false
          },
          "sensitive_attributes": [
            [
              {
                "type": "get_attr",
                "value": "repository_password"
              }
            ],
            [
              {
                "type": "get_attr",
                "value": "set_sensitive"
              }
            ]
          ],
          "private": "eyJzY2hlbWFfdmVyc2lvbiI6IjEifQ==",
          "dependencies": [
            "kubernetes_namespace.tailscale"
          ]
        }
      ]
    },
