              "F-17-release-production.json": "{\r\n  \"name\": \"F-17 /release_production\",\r\n  \"nodes\": [\r\n    {\r\n      \"id\": \"487cf1ce-c9d6-47c3-b053-558ffc6efc20\",\r\n      \"name\": \"Webhook Trigger\",\r\n      \"type\": \"n8n-nodes-base.webhook\",\r\n      \"typeVersion\": 2,\r\n      \"position\": [\r\n        240,\r\n        300\r\n      ],\r\n      \"parameters\": {\r\n        \"path\": \"release-production\",\r\n        \"httpMethod\": \"POST\",\r\n        \"responseMode\": \"onReceived\",\r\n        \"responseData\": \"allEntries\"\r\n      },\r\n      \"webhookId\": \"3581e892-b9f9-4646-ac5a-c20a793c77f1\"\r\n    },\r\n    {\r\n      \"id\": \"f2693e1e-4c54-4993-a84d-ceac19fb6ebd\",\r\n      \"name\": \"Respond OK\",\r\n      \"type\": \"n8n-nodes-base.respondToWebhook\",\r\n      \"typeVersion\": 1,\r\n      \"position\": [\r\n        460,\r\n        300\r\n      ],\r\n      \"parameters\": {\r\n        \"respondWith\": \"json\",\r\n        \"responseBody\": \"{\\\"status\\\":\\\"accepted\\\"}\"\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"40bb0ef7-c057-436b-b123-c9de5c9d2271\",\r\n      \"name\": \"rm:go Safeguard\",\r\n      \"type\": \"n8n-nodes-base.httpRequest\",\r\n      \"typeVersion\": 4.2,\r\n      \"position\": [\r\n        680,\r\n        300\r\n      ],\r\n      \"parameters\": {\r\n        \"method\": \"GET\",\r\n        \"url\": \"={{ $env.GITLAB_URL }}/api/v4/projects/{{ $env.GITLAB_PROJECT_ID }}/issues/{{ $env.RELEASE_TICKET_ID }}\",\r\n        \"authentication\": \"genericCredentialType\",\r\n        \"genericAuthType\": \"httpHeaderAuth\",\r\n        \"sendHeaders\": true,\r\n        \"headerParameters\": {\r\n          \"parameters\": [\r\n            {\r\n              \"name\": \"PRIVATE-TOKEN\",\r\n              \"value\": \"={{ $env.GITLAB_TOKEN }}\"\r\n            }\r\n          ]\r\n        }\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"457bfee4-1b22-4ab0-b34a-b6f18184f771\",\r\n      \"name\": \"rm:go label present?\",\r\n      \"type\": \"n8n-nodes-base.if\",\r\n      \"typeVersion\": 2,\r\n      \"position\": [\r\n        900,\r\n        300\r\n      ],\r\n      \"parameters\": {\r\n        \"conditions\": {\r\n          \"options\": {\r\n            \"leftValue\": \"={{ $json.labels.includes('rm:go') }}\",\r\n            \"operation\": \"equals\",\r\n            \"rightValue\": \"true\"\r\n          }\r\n        }\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"3e5da2ec-23b6-4643-8d13-fa95a32f1c7f\",\r\n      \"name\": \"Notify: Production blocked\",\r\n      \"type\": \"n8n-nodes-base.httpRequest\",\r\n      \"typeVersion\": 4.2,\r\n      \"position\": [\r\n        1120,\r\n        400\r\n      ],\r\n      \"parameters\": {\r\n        \"method\": \"POST\",\r\n        \"url\": \"={{ $env.OPENWEBUI_CALLBACK_URL }}\",\r\n        \"sendHeaders\": true,\r\n        \"headerParameters\": {\r\n          \"parameters\": [\r\n            {\r\n              \"name\": \"Content-Type\",\r\n              \"value\": \"application/json\"\r\n            }\r\n          ]\r\n        },\r\n        \"sendBody\": true,\r\n        \"bodyParameters\": {\r\n          \"parameters\": [\r\n            {\r\n              \"name\": \"flow_id\",\r\n              \"value\": \"={{ $json.flow_id ?? '' }}\"\r\n            },\r\n            {\r\n              \"name\": \"message\",\r\n              \"value\": \"\\ud83d\\udeab /release_production blocked \\u2014 rm:go label missing\"\r\n            },\r\n            {\r\n              \"name\": \"notes\",\r\n              \"value\": \"\"\r\n            }\r\n          ]\r\n        }\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"0b27e754-868c-4d20-8a5a-147072921e7f\",\r\n      \"name\": \"Create promote\\u2192main MR\",\r\n      \"type\": \"n8n-nodes-base.httpRequest\",\r\n      \"typeVersion\": 4.2,\r\n      \"position\": [\r\n        1120,\r\n        200\r\n      ],\r\n      \"parameters\": {\r\n        \"method\": \"POST\",\r\n        \"url\": 