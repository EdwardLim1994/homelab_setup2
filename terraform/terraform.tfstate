              "F-14-release-staging.json": "{\r\n  \"name\": \"F-14 /release_staging\",\r\n  \"nodes\": [\r\n    {\r\n      \"id\": \"6be2386d-220c-416d-aa45-ff7597498aa3\",\r\n      \"name\": \"Webhook Trigger\",\r\n      \"type\": \"n8n-nodes-base.webhook\",\r\n      \"typeVersion\": 2,\r\n      \"position\": [\r\n        240,\r\n        300\r\n      ],\r\n      \"parameters\": {\r\n        \"path\": \"release-staging\",\r\n        \"httpMethod\": \"POST\",\r\n        \"responseMode\": \"onReceived\",\r\n        \"responseData\": \"allEntries\"\r\n      },\r\n      \"webhookId\": \"a4252b67-7ea8-4bfd-8894-e613a7b3c86c\"\r\n    },\r\n    {\r\n      \"id\": \"6d9be0a5-8fd1-4c8a-a586-30d43b4fc4e2\",\r\n      \"name\": \"Respond OK\",\r\n      \"type\": \"n8n-nodes-base.respondToWebhook\",\r\n      \"typeVersion\": 1,\r\n      \"position\": [\r\n        460,\r\n        300\r\n      ],\r\n      \"parameters\": {\r\n        \"respondWith\": \"json\",\r\n        \"responseBody\": \"{\\\"status\\\":\\\"accepted\\\"}\"\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"574de774-cf51-4be9-ad69-eedf5b6c17ce\",\r\n      \"name\": \"UAT Safeguard\",\r\n      \"type\": \"n8n-nodes-base.httpRequest\",\r\n      \"typeVersion\": 4.2,\r\n      \"position\": [\r\n        680,\r\n        300\r\n      ],\r\n      \"parameters\": {\r\n        \"method\": \"GET\",\r\n        \"url\": \"={{ $env.GITLAB_URL }}/api/v4/projects/{{ $env.GITLAB_PROJECT_ID }}/issues/{{ $env.RELEASE_TICKET_ID }}\",\r\n        \"authentication\": \"genericCredentialType\",\r\n        \"genericAuthType\": \"httpHeaderAuth\",\r\n        \"sendHeaders\": true,\r\n        \"headerParameters\": {\r\n          \"parameters\": [\r\n            {\r\n              \"name\": \"PRIVATE-TOKEN\",\r\n              \"value\": \"={{ $env.GITLAB_TOKEN }}\"\r\n            }\r\n          ]\r\n        }\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"94b7463d-558e-4d36-b9d0-4ebd90fda8a3\",\r\n      \"name\": \"All UAT Labels?\",\r\n