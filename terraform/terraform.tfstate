                "name": "gitlab",
                "namespace": "gitlab",
                "notes": "\n\n=== CRITICAL\nThe following charts are included for evaluation purposes only. They will not be supported by GitLab Support\nfor production workloads. Use Cloud Native Hybrid deployments for production. For more information visit\nhttps://docs.gitlab.com/charts/installation/index.html#use-the-reference-architectures.\n- Gitaly\n\n\n\n=== WARNING\nhelm:\n  GitLab chart now recommends Helm 4.0+. Please make sure to update your current Helm version v3.15.\n  Please check the release notes and test your configuration before upgrading, because Helm 3.17\n  changed how some values are being merged.\n\n=== WARNING\nThe minimum required version of PostgreSQL is now 16. See https://docs.gitlab.com/charts/installation/upgrade.html for more details.\nHelp us improve the installation experience, let us know how we did with a 1 minute survey:https://gitlab.fra1.qualtrics.com/jfe/form/SV_6kVqZANThUQ1bZb?installation=helm\u0026release=18-11\n\n\n\n\n\n\nMinio not enabled: `enabled: `. Please set to `true` to use Minio\n\n\nYour GitLab Runner should now be registered against the GitLab instance reachable at: http://gitlab-webservice-default.gitlab.svc.cluster.local:8181/\n\nRunner namespace \"gitlab\" was found in runners.config template.\n\n#############################################################################################\n## WARNING: You enabled `rbac` without specifying if a service account should be created.  ##\n## Please set `serviceAccount.create` to either `true` or `false`.                         ##\n## For backwards compatibility a service account will be created.                          ##\n#############################################################################################\n",
                "revision": 1,
                "values": "{\"gitlab\":{\"certmanager\":{\"installCRDs\":false},\"certmanager-issuer\":{\"email\":\"edwardlimkoksiong1994@gmail.com\"},\"gitlab\":{\"gitaly\":{\"resources\":{\"limits\":{\"memory\":\"512Mi\"},\"requests\":{\"cpu\":\"50m\",\"memory\":\"256Mi\"}}},\"gitlab-shell\":{\"maxReplicas\":1,\"minReplicas\":1},\"sidekiq\":{\"maxReplicas\":1,\"minReplicas\":1,\"resources\":{\"limits\":{\"memory\":\"1Gi\"},\"requests\":{\"cpu\":\"50m\",\"memory\":\"512Mi\"}}},\"toolbox\":{\"enabled\":false},\"webservice\":{\"maxReplicas\":1,\"minReplicas\":1,\"resources\":{\"limits\":{\"memory\":\"3Gi\"},\"requests\":{\"cpu\":\"100m\",\"memory\":\"1Gi\"}}}},\"gitlab-runner\":{\"gitlabUrl\":\"http://gitlab-webservice-default.gitlab.svc.cluster.local:8181/\",\"install\":true,\"rbac\":{\"create\":true},\"runners\":{\"cache\":{\"secretName\":\"gitlab-runner-cache-credentials\"},\"config\":\"[[runners]]\\n  # ponytail: CI_REPOSITORY_URL is derived from GitLab's external URL,\\n  # which job pods can't reach — force in-cluster clones.\\n  clone_url = \\\"http://gitlab-webservice-default.gitlab.svc.cluster.local:8181\\\"\\n  [runners.cache]\\n    Type = \\\"s3\\\"\\n    Shared = true\\n    [runners.cache.s3]\\n      ServerAddress = \\\"minio.minio.svc.cluster.local:9000\\\"\\n      BucketName = \\\"gitlab-runner-cache\\\"\\n      BucketLocation = \\\"us-east-1\\\"\\n      Insecure = true\\n  [runners.kubernetes]\\n    namespace = \\\"gitlab\\\"\\n    image = \\\"alpine:3.21\\\"\\n    privileged = true\\n    cpu_request = \\\"100m\\\"\\n    memory_request = \\\"256Mi\\\"\\n    cpu_limit = \\\"1\\\"\\n    memory_limit = \\\"2Gi\\\"\\n    # ponytail: shared /certs/client between build + docker:dind service\\n    [[runners.kubernetes.volumes.empty_dir]]\\n      name = \\\"docker-certs\\\"\\n      mount_path = \\\"/certs/client\\\"\\n      medium = \\\"Memory\\\"\\n  [runners.kubernetes.pod_labels]\\n    app = \\\"gitlab-ci-job\\\"\\n\",\"privileged\":true}},\"global\":{\"appConfig\":{\"artifacts\":{\"bucket\":\"gitlab-artifacts\",\"enabled\":true},\"backups\":{\"bucket\":\"gitlab-backups\"},\"ciSecureFiles\":{\"bucket\":\"gitlab-ci-secure-files\",\"enabled\":true},\"dependencyProxy\":{\"bucket\":\"gitlab-dependency-proxy\",\"enabled\":true},\"externalDiffs\":{\"bucket\":\"gitlab-mr-diffs\",\"enabled\":true},\"lfs\":{\"bucket\":\"git-lfs\",\"enabled\":true},\"object_store\":{\"connection\":{\"key\":\"connection\",\"secret\":\"gitlab-object-storage\"},\"enabled\":true},\"omniauth\":{\"allowSingleSignOn\":[\"openid_connect\"],\"autoSignInWithProvider\":\"openid_connect\",\"blockAutoCreatedUsers\":false,\"enabled\":true,\"providers\":[{\"key\":\"provider\",\"secret\":\"gitlab-omniauth-authentik\"}]},\"packages\":{\"bucket\":\"gitlab-packages\",\"enabled\":true},\"terraformState\":{\"bucket\":\"gitlab-terraform-state\",\"enabled\":true},\"uploads\":{\"bucket\":\"gitlab-uploads\",\"enabled\":true}},\"edition\":\"ce\",\"hosts\":{\"domain\":\"gitlab.local\",\"gitlab\":{\"https\":true,\"name\":\"gitlab.tail60240b.ts.net\"},\"https\":true},\"hpa\":{\"apiVersion\":\"autoscaling/v2\"},\"ingress\":{\"annotations\":{\"cert-manager.io/cluster-issuer\":\"homelab-ca-issuer\"},\"apiVersion\":\"networking.k8s.io/v1\",\"class\":\"traefik\",\"configureCertmanager\":false,\"enabled\":true,\"provider\":\"traefik\",\"tls\":{\"enabled\":true,\"secretName\":\"gitlab-tls\"}},\"initialRootPassword\":{\"secret\":\"gitlab-initial-root-password\"},\"kas\":{\"enabled\":false},\"minio\":{\"enabled\":false},\"pdb\":{\"apiVersion\":\"policy/v1\"},\"psql\":{\"database\":\"gitlabhq_production\",\"host\":\"postgres.postgres.svc.cluster.local\",\"password\":{\"key\":\"password\",\"secret\":\"gitlab-postgres-secret\"},\"port\":5432,\"username\":\"gitlab\"},\"redis\":{\"auth\":{\"enabled\":false},\"host\":\"redis.redis.svc.cluster.local\",\"port\":6379},\"traefik\":{\"apiVersion\":\"traefik.io/v1alpha1\"}},\"grafana\":{\"enabled\":false},\"installCertmanager\":false,\"nginx-ingress\":{\"enabled\":false},\"postgresql\":{\"install\":false},\"prometheus\":{\"install\":false},\"redis\":{\"install\":false},\"registry\":{\"enabled\":false}}}",
                "version": "0.1.0"
              }
            ],
            "name": "gitlab",
            "namespace": "gitlab",
            "pass_credentials": false,
            "postrender": [],
            "recreate_pods": false,
            "render_subchart_notes": true,
            "replace": false,
            "repository": null,
            "repository_ca_file": null,
            "repository_cert_file": null,
            "repository_key_file": null,
            "repository_password": null,
            "repository_username": null,
            "reset_values": false,
            "reuse_values": false,
            "set": [
              {
                "name": "gitlab.certmanager-issuer.email",
                "type": "",
                "value": "edwardlimkoksiong1994@gmail.com"
              },
              {
                "name": "gitlab.global.appConfig.object_store.connection.key",
                "type": "",
                "value": "connection"
              },
              {
                "name": "gitlab.global.appConfig.object_store.connection.secret",
                "type": "",
                "value": "gitlab-object-storage"
              },
              {
                "name": "gitlab.global.appConfig.omniauth.allowSingleSignOn[0]",
                "type": "",
                "value": "openid_connect"
              },
              {
                "name": "gitlab.global.appConfig.omniauth.autoSignInWithProvider",
                "type": "",
                "value": "openid_connect"
              },
              {
                "name": "gitlab.global.appConfig.omniauth.blockAutoCreatedUsers",
                "type": "",
                "value": "false"
              },
              {
                "name": "gitlab.global.appConfig.omniauth.enabled",
                "type": "",
                "value": "true"
              },
              {
                "name": "gitlab.global.appConfig.omniauth.providers[0].key",
                "type": "",
                "value": "provider"
              },
              {
                "name": "gitlab.global.appConfig.omniauth.providers[0].secret",
                "type": "",
                "value": "gitlab-omniauth-authentik"
              },
              {
                "name": "gitlab.global.hosts.gitlab.https",
                "type": "",
                "value": "true"
              },
              {
                "name": "gitlab.global.hosts.gitlab.name",
                "type": "",
                "value": "gitlab.tail60240b.ts.net"
              },
              {
                "name": "gitlab.global.hosts.https",
                "type": "",
                "value": "true"
              },
              {
                "name": "gitlab.global.initialRootPassword.secret",
                "type": "",
                "value": "gitlab-initial-root-password"
              }
            ],
            "set_list": [],
            "set_sensitive": [],
            "skip_crds": false,
            "status": "deployed",
            "timeout": 600,
            "upgrade_install": null,
            "values": [
              "gitlab:\r\n  global:\r\n    edition: ce\r\n    hosts:\r\n      domain: gitlab.local\r\n      # ponytail: without this, hostname defaults to \"gitlab.\u003cdomain\u003e\" i.e.\r\n      # gitlab.gitlab.local (domain already includes \"gitlab\")\r\n      gitlab:\r\n        name: gitlab.local\r\n    initialRootPassword:\r\n      secret: \"\"  # set via terraform\r\n\r\n    # ponytail: shared postgres + redis (helm/postgres, helm/redis). db + role\r\n    # `gitlab`/`gitlabhq_production` on the shared postgres (initdb also creates\r\n    # the pg_trgm / btree_gist extensions GitLab needs). Redis: GitLab keeps its\r\n    # default logical DB 0 (all its components agree on it); authentik is moved\r\n    # to DB 1 so the two apps don't share a keyspace.\r\n    # gitlab-postgres-secret is created in terraform/gitlab.tf.\r\n    psql:\r\n      host: postgres.postgres.svc.cluster.local\r\n      port: 5432\r\n      database: gitlabhq_production\r\n      username: gitlab\r\n      password:\r\n        secret: gitlab-postgres-secret\r\n        key: password\r\n    redis:\r\n      host: redis.redis.svc.cluster.local\r\n      port: 6379\r\n      auth:\r\n        enabled: false\r\n    ingress:\r\n      enabled: true\r\n      # ponytail: helm template has no live cluster to auto-detect API\r\n      # versions from; same class of issue as the pdb/hpa overrides above\r\n      apiVersion: networking.k8s.io/v1\r\n      provider: traefik\r\n      class: traefik\r\n      annotations:\r\n        cert-manager.io/cluster-issuer: homelab-ca-issuer\r\n      tls:\r\n        enabled: true\r\n        secretName: gitlab-tls\r\n      # ponytail: defaults true independent of ingress.enabled, keeps\r\n      # spawning a cert-manager issuer job; we manage our own ClusterIssuer\r\n      configureCertmanager: false\r\n    # ponytail: backed by the standalone minio app (helm/minio), not the\r\n    # gitlab chart's own bundled minio subchart (global.minio stays\r\n    # disabled below) — connection secret wired in gitlab/Tiltfile.\r\n    # Per-feature blocks below must leave `connection` empty and only set\r\n    # `bucket` for the chart to treat object_store.connection as the\r\n    # consolidated one they all inherit (see charts/gitlab/_objectStorage.tpl).\r\n    appConfig:\r\n      object_store:\r\n        enabled: true\r\n      lfs:\r\n        enabled: true\r\n        bucket: git-lfs\r\n      artifacts:\r\n        enabled: true\r\n        bucket: gitlab-artifacts\r\n      uploads:\r\n        enabled: true\r\n        bucket: gitlab-uploads\r\n      packages:\r\n        enabled: true\r\n        bucket: gitlab-packages\r\n      externalDiffs:\r\n        enabled: true\r\n        bucket: gitlab-mr-diffs\r\n      dependencyProxy:\r\n        enabled: true\r\n        bucket: gitlab-dependency-proxy\r\n      terraformState:\r\n        enabled: true\r\n        bucket: gitlab-terraform-state\r\n      ciSecureFiles:\r\n        enabled: true\r\n        bucket: gitlab-ci-secure-files\r\n      backups:\r\n        bucket: gitlab-backups\r\n    minio:\r\n      enabled: false\r\n    kas:\r\n      enabled: false\r\n    # ponytail: Tilt's helm() runs `helm template` with no cluster connection,\r\n    # so Capabilities-based API auto-detection can't run and falls back to the\r\n    # long-removed policy/v1beta1 PDB kind. Pin explicitly.\r\n    pdb:\r\n      apiVersion: policy/v1\r\n    hpa:\r\n      apiVersion: autoscaling/v2\r\n    # ponytail: gitlab-shell's SSH IngressRouteTCP only renders once\r\n    # ingress.provider is traefik; same live-cluster-detection gap as above,\r\n    # this cluster's Traefik (v3) only registers the newer traefik.io group\r\n    traefik:\r\n      apiVersion: traefik.io/v1alpha1\r\n\r\n  # disable non-essential components\r\n  registry:\r\n    enabled: false\r\n  # ponytail: chart 9.x renamed certmanager.install -\u003e top-level\r\n  # installCertmanager. We run our own ClusterIssuer\r\n  # (global.ingress.configureCertmanager: false above) — no bundled\r\n  # cert-manager, no CRDs.\r\n  installCertmanager: false\r\n  certmanager:\r\n    installCRDs: false\r\n  nginx-ingress:\r\n    enabled: false\r\n  # ponytail: runner registers + clones over the in-cluster Service, not the\r\n  # tailnet hostname — the job/runner pods aren't on the tailnet and\r\n  # `tailscale serve` is tailnet-only, so the external URL is unreachable\r\n  # from inside k3d.\r\n  # GitLab 18 removed registration tokens: the Tiltfile's\r\n  # gitlab-runner-auth-token step mints a glrt- auth token post-deploy and\r\n  # writes it into gitlab-gitlab-runner-secret (key: runner-token).\r\n  gitlab-runner:\r\n    install: true\r\n    gitlabUrl: http://gitlab-webservice-default.gitlab.svc.cluster.local:8181/\r\n    rbac:\r\n      create: true\r\n    runners:\r\n      # ponytail: privileged so `docker:dind` service containers work. k3d\r\n      # nodes already run privileged (k3s needs it), so this works on Docker\r\n      # Desktop. Prefer kaniko for image builds where you can — dind is the\r\n      # escape hatch for jobs that genuinely need the docker daemon.\r\n      privileged: true\r\n      # ponytail: distributed cache in MinIO so jobs on different runner pods\r\n      # share cache/. Secret carries the S3 creds (keys: accesskey/secretkey).\r\n      cache:\r\n        secretName: gitlab-runner-cache-credentials\r\n      config: |\r\n        [[runners]]\r\n          # ponytail: CI_REPOSITORY_URL is derived from GitLab's external URL,\r\n          # which job pods can't reach — force in-cluster clones.\r\n          clone_url = \"http://gitlab-webservice-default.gitlab.svc.cluster.local:8181\"\r\n          [runners.cache]\r\n            Type = \"s3\"\r\n            Shared = true\r\n            [runners.cache.s3]\r\n              ServerAddress = \"minio.minio.svc.cluster.local:9000\"\r\n              BucketName = \"gitlab-runner-cache\"\r\n              BucketLocation = \"us-east-1\"\r\n              Insecure = true\r\n          [runners.kubernetes]\r\n            namespace = \"gitlab\"\r\n            image = \"alpine:3.21\"\r\n            privileged = true\r\n            cpu_request = \"100m\"\r\n            memory_request = \"256Mi\"\r\n            cpu_limit = \"1\"\r\n            memory_limit = \"2Gi\"\r\n            # ponytail: shared /certs/client between build + docker:dind service\r\n            [[runners.kubernetes.volumes.empty_dir]]\r\n              name = \"docker-certs\"\r\n              mount_path = \"/certs/client\"\r\n              medium = \"Memory\"\r\n          [runners.kubernetes.pod_labels]\r\n            app = \"gitlab-ci-job\"\r\n  prometheus:\r\n    install: false\r\n  grafana:\r\n    enabled: false\r\n  gitlab:\r\n    toolbox:\r\n      enabled: false\r\n    webservice:\r\n      minReplicas: 1\r\n      maxReplicas: 1\r\n      resources:\r\n        requests:\r\n          cpu: 100m\r\n          memory: 1Gi\r\n        # ponytail: 2Gi leaves no headroom for a second Rails boot, so\r\n        # `rails runner` (gitlab-promote-admin) gets OOMKilled (exit 137) and\r\n        # the Web IDE OAuth redirect_uri realign silently never runs. 3Gi fits\r\n        # puma + one runner. Node has room; bump back down if it doesn't.\r\n        limits:\r\n          memory: 3Gi\r\n    sidekiq:\r\n      minReplicas: 1\r\n      maxReplicas: 1\r\n      resources:\r\n        requests:\r\n          cpu: 50m\r\n          memory: 512Mi\r\n        limits:\r\n          memory: 1Gi\r\n    gitaly:\r\n      resources:\r\n        requests:\r\n          cpu: 50m\r\n          memory: 256Mi\r\n        limits:\r\n          memory: 512Mi\r\n    gitlab-shell:\r\n      minReplicas: 1\r\n      maxReplicas: 1\r\n\r\n  # ponytail: bundled bitnami postgresql + redis subcharts off — GitLab uses the\r\n  # shared postgres / redis (global.psql / global.redis above).\r\n  postgresql:\r\n    install: false\r\n  redis:\r\n    install: false\r\n"
            ],
            "verify": false,
            "version": "0.1.0",
            "wait": false,
            "wait_for_jobs": false
          },
          "sensitive_attributes": [
            [
              {
                "type": "get_attr",
                "value": "repository_password"
              }
            ]
          ],
          "private": "eyJzY2hlbWFfdmVyc2lvbiI6IjEifQ==",
          "dependencies": [
            "helm_release.cert_manager",
            "helm_release.postgres",
            "helm_release.redis",
            "kubectl_manifest.homelab_ca",
            "kubectl_manifest.homelab_ca_issuer",
            "kubectl_manifest.selfsigned_bootstrap",
            "kubernetes_namespace.cert_manager",
            "kubernetes_namespace.gitlab",
            "kubernetes_namespace.postgres",
            "kubernetes_namespace.redis",
            "kubernetes_secret.gitlab_object_storage",
            "kubernetes_secret.gitlab_omniauth_authentik",
            "kubernetes_secret.gitlab_postgres",
            "kubernetes_secret.gitlab_root_password",
            "kubernetes_secret.gitlab_runner_cache_credentials"
          ]
        }
      ]
    },
    {
      "mode": "managed",
      "type": "helm_release",
      "name": "litellm",
      "provider": "provider[\"registry.opentofu.org/hashicorp/helm\"]",
      "instances": [
        {
          "schema_version": 1,
