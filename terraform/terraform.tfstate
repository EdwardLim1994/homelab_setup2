              "F-16-go-nogo.json": "{\r\n  \"name\": \"F-16 Go/No-Go\",\r\n  \"nodes\": [\r\n    {\r\n      \"id\": \"fef63188-40c7-4a14-a411-0aad71b25dce\",\r\n      \"name\": \"Webhook Trigger\",\r\n      \"type\": \"n8n-nodes-base.webhook\",\r\n      \"typeVersion\": 2,\r\n      \"position\": [\r\n        240,\r\n        300\r\n      ],\r\n      \"parameters\": {\r\n        \"path\": \"go-nogo\",\r\n        \"httpMethod\": \"POST\",\r\n        \"responseMode\": \"onReceived\",\r\n        \"responseData\": \"allEntries\"\r\n      },\r\n      \"webhookId\": \"29d43455-5a2c-487c-8985-91a20aa4edb3\"\r\n    },\r\n    {\r\n      \"id\": \"201d4074-bdbd-465b-a87a-2f600ef124b7\",\r\n      \"name\": \"Respond OK\",\r\n      \"type\": \"n8n-nodes-base.respondToWebhook\",\r\n      \"typeVersion\": 1,\r\n      \"position\": [\r\n        460,\r\n        300\r\n      ],\r\n      \"parameters\": {\r\n        \"respondWith\": \"json\",\r\n        \"responseBody\": \"{\\\"status\\\":\\\"accepted\\\"}\"\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"e1c93f14-a8c2-465a-975a-4387f7790798\",\r\n      \"name\": \"RM: Go/No-Go Decision\",\r\n      \"type\": \"n8n-nodes-base.executeCommand\",\r\n      \"typeVersion\": 1,\r\n      \"position\": [\r\n        680,\r\n        300\r\n      ],\r\n      \"parameters\": {\r\n        \"command\": \"omp --role release-manager --model default --project {{ $env.REPO_DIR }} --prompt 'Evaluate k6 and ZAP results for {{ $json.body.version }}. Apply release criteria thresholds. Output JSON: {decision: GO|NO-GO, reason: string, options: [...]}' --non-interactive\"\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"33f03cb9-dccf-499d-b346-6e6c074bbd1e\",\r\n      \"name\": \"GO?\",\r\n      \"type\": \"n8n-nodes-base.if\",\r\n      \"typeVersion\": 2,\r\n      \"position\": [\r\n        900,\r\n        300\r\n      ],\r\n      \"parameters\": {\r\n        \"conditions\": {\r\n          \"options\": {\r\n            \"leftValue\": \"={{ JSON.parse($json.stdout).decision }}\",\r\n            \"operation\": \"equals\",\r\n            \"rightValue\": \"GO\"\r\n          }\r\n        }\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"7a44622a-d6c8-4a4f-8b10-23a776c9a275\",\r\n      \"name\": \"Label: rm:go\",\r\n      \"type\": \"n8n-nodes-base.httpRequest\",\r\n      \"typeVersion\": 4.2,\r\n      \"position\": [\r\n        1120,\r\n        200\r\n      ],\r\n      \"parameters\": {\r\n        \"method\": \"PUT\",\r\n        \"url\": \"={{ $env.GITLAB_URL }}/api/v4/projects/{{ $env.GITLAB_PROJECT_ID }}/issues/{{ $env.RELEASE_TICKET_ID }}\",\r\n        \"authentication\": \"genericCredentialType\",\r\n        \"genericAuthType\": \"httpHeaderAuth\",\r\n        \"sendHeaders\": true,\r\n        \"headerParameters\": {\r\n          \"parameters\": [\r\n            {\r\n              \"name\": \"PRIVATE-TOKEN\",\r\n              \"value\": \"={{ $env.GITLAB_TOKEN }}\"\r\n            },\r\n            {\r\n              \"name\": \"Content-Type\",\r\n              \"value\": \"application/json\"\r\n            }\r\n          ]\r\n        },\r\n        \"sendBody\": true,\r\n        \"bodyParameters\": {\r\n          \"parameters\": [\r\n            {\r\n              \"name\": \"__json\",\r\n              \"value\": \"{\\\"add_labels\\\":\\\"rm:go\\\"}\"\r\n            }\r\n          ]\r\n        }\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"301ba7b5-f5f8-43fa-ac96-df8a4e380f5f\",\r\n      \"name\": \"Notify: GO\",\r\n      \"type\": \"n8n-nodes-base.httpRequest\",\r\n      \"typeVersion\": 4.2,\r\n      \"position\": [\r\n        1340,\r\n        200\r\n      ],\r\n      \"parameters\": {\r\n        \"method\": \"POST\",\r\n        \"url\": \"={{ $env.OPENWEBUI_CALLBACK_URL }}\",\r\n        \"sendHeaders\": true,\r\n        \"headerParameters\": {\r\n          \"parameters\": [\r\n            {\r\n              \"name\": \"Content-Type\",\r\n              \"value\": \"application/json\"\r\n            }\r\n          ]\r\n        },\r\n        \"sendBody\": true,\r\n        \"bodyParameters\": {\r\n          \"parameters\": [\r\n            {\r\n              \"name\": \"flow_id\",\r\n              \"value\": \"={{ $json.flow_id ?? '' }}\"\r\n            },\r\n            {\r\n              \"name\": \"message\",\r\n              \"value\": \"\\u2705 GO \\u2014 {{ $env.RELEASE_VERSION }} cleared for /release_production\"\r\n            },\r\n            {\r\n              \"name\": \"notes\",\r\n              \"value\": \"\"\r\n            }\r\n          ]\r\n        }\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"b9f6e564-bf48-4afd-baf6-2113f9d9445e\",\r\n      \"name\": \"Notify: NO-GO options\",\r\n      \"type\": \"n8n-nodes-base.httpRequest\",\r\n      \"typeVersion\": 4.2,\r\n      \"position\": [\r\n        1120,\r\n        400\r\n      ],\r\n      \"parameters\": {\r\n        \"method\": \"POST\",\r\n        \"url\": \"={{ $env.OPENWEBUI_CALLBACK_URL }}\",\r\n        \"sendHeaders\": true,\r\n        \"headerParameters\": {\r\n          \"parameters\": [\r\n            {\r\n              \"name\": \"Content-Type\",\r\n              \"value\": \"application/json\"\r\n            }\r\n          ]\r\n        },\r\n        \"sendBody\": true,\r\n        \"bodyParameters\": {\r\n          \"parameters\": [\r\n            {\r\n              \"name\": \"flow_id\",\r\n              \"value\": \"={{ $json.flow_id ?? '' }}\"\r\n            },\r\n            {\r\n              \"name\": \"message\",\r\n              \"value\": \"\\ud83d\\udea8 NO-GO \\u2014 {{ $env.RELEASE_VERSION }} blocked. Options: 1) fix \u0026 re-stage 2) rollback story 3) defer release. Details: {{ JSON.parse($json.stdout).reason }}\"\r\n            },\r\n            {\r\n              \"name\": \"notes\",\r\n              \"value\": \"\"\r\n            }\r\n          ]\r\n        }\r\n      }\r\n    }\r\n  ],\r\n  \"connections\": {\r\n    \"fef63188-40c7-4a14-a411-0aad71b25dce\": {\r\n      \"main\": [\r\