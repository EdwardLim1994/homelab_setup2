llback initiated for {{ $json.body.version }}\"\r\n            },\r\n            {\r\n              \"name\": \"notes\",\r\n              \"value\": \"\"\r\n            }\r\n          ]\r\n        }\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"d1277724-73cf-477c-bff4-a4ccfb2402a5\",\r\n      \"name\": \"ArgoCD: Rollback Production\",\r\n      \"type\": \"n8n-nodes-base.httpRequest\",\r\n      \"typeVersion\": 4.2,\r\n      \"position\": [\r\n        900,\r\n        300\r\n      ],\r\n      \"parameters\": {\r\n        \"method\": \"POST\",\r\n        \"url\": \"={{ $env.ARGOCD_URL }}/api/v1/applications/{{ $env.ARGOCD_PROJECT }}-production/sync\",\r\n        \"authentication\": \"genericCredentialType\",\r\n        \"genericAuthType\": \"httpHeaderAuth\",\r\n        \"sendHeaders\": true,\r\n        \"headerParameters\": {\r\n          \"parameters\": [\r\n            {\r\n              \"name\": \"Authorization\",\r\n              \"value\": \"Bearer {{ $env.ARGOCD_TOKEN }}\"\r\n            }\r\n          ]\r\n        }\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"988fb99a-f4e9-454c-84c6-8ae4f212101a\",\r\n      \"name\": \"Open Incident Ticket\",\r\n      \"type\": \"n8n-nodes-base.httpRequest\",\r\n      \"typeVersion\": 4.2,\r\n      \"position\": [\r\n        1120,\r\n        300\r\n      ],\r\n      \"parameters\": {\r\n        \"method\": \"POST\",\r\n        \"url\": \"={{ $env.GITLAB_URL }}/api/v4/projects/{{ $env.GITLAB_PROJECT_ID }}/issues\",\r\n        \"authentication\": \"genericCredentialType\",\r\n        \"genericAuthType\": \"httpHeaderAuth\",\r\n        \"sendHeaders\": true,\r\n        \"headerParameters\": {\r\n          \"parameters\": [\r\n            {\r\n              \"name\": \"PRIVATE-TOKEN\",\r\n              \"value\": \"={{ $env.GITLAB_TOKEN }}\"\r\n            },\r\n            {\r\n              \"name\": \"Content-Type\",\r\n              \"value\": \"application/json\"\r\n            }\r\n          ]\r\n        },\r\n        \"sendBody\": true,\r\n        \"bodyParameters\": {\r\n          \"parameters\": [\r\n            {\r\n              \"name\": \"__json\",\r\n              \"value\": \"{\\\"title\\\":\\\"[INCIDENT] Production rollback {{ $env.RELEASE_VERSION }}\\\",\\\"labels\\\":\\\"type:incident\\\",\\\"description\\\":\\\"Auto-created on /rollback\\\"}\"\r\n            }\r\n          ]\r\n        }\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"46478b12-9904-4aee-a771-78ac0cc68834\",\r\n      \"name\": \"Notify: Rollback complete\",\r\n      \"type\": \"n8n-nodes-base.httpRequest\",\r\n      \"typeVersion\": 4.2,\r\n      \"position\": [\r\n        1340,\r\n        300\r\n      ],\r\n      \"parameters\": {\r\n        \"method\": \"POST\",\r\n        \"url\": \"={{ $env.OPENWEBUI_CALLBACK_URL }}\",\r\n        \"sendHeaders\": true,\r\n        \"headerParameters\": {\r\n          \"parameters\": [\r\n            {\r\n              \"name\": \"Content-Type\",\r\n              \"value\": \"application/json\"\r\n            }\r\n          ]\r\n        },\r\n        \"sendBody\": true,\r\n        \"bodyParameters\": {\r\n          \"parameters\": [\r\n            {\r\n              \"name\": \"flow_id\",\r\n              \"value\": \"={{ $json.flow_id ?? '' }}\"\r\n            },\r\n            {\r\n              \"name\": \"message\",\r\n              \"value\": \"\\u2705 Rollback complete \\u2014 monitoring production, incident ticket opened\"\r\n            },\r\n            {\r\n              \"name\": \"notes\",\r\n              \"value\": \"\"\r\n            }\r\n          ]\r\n        }\r\n      }\r\n    }\r\n  ],\r\n  \"connections\": {\r\n    \"bfedf83a-74b1-4f36-95dc-8a1ff43b4fb7\": {\r\n      \"main\": [\r\n        [\r\n          {\r\n            \"node\": \"b1afe7a6-695c-46ad-8894-3248afa71cbb\",\r\n            \"type\": \"main\",\r\n            \"index\": 0\r\n          },\r\n          {\r\n            \"node\": \"cc450105-e0a3-424e-b284-2b9ad3648881\",\r\n         