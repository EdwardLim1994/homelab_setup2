": \"\\ud83d\\ude80 Staging deployed \\u2014 k6 + ZAP parallel\"\r\n            },\r\n            {\r\n              \"name\": \"notes\",\r\n              \"value\": \"\"\r\n            }\r\n          ]\r\n        }\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"c3a8c289-761d-467d-8990-5bff750ac79f\",\r\n      \"name\": \"QA: k6 Load Test\",\r\n      \"type\": \"n8n-nodes-base.executeCommand\",\r\n      \"typeVersion\": 1,\r\n      \"position\": [\r\n        900,\r\n        200\r\n      ],\r\n      \"parameters\": {\r\n        \"command\": \"omp --role qa-engineer --model smol --project {{ $env.REPO_DIR }} --prompt 'Run k6 load test suite against staging for {{ $json.body.version }}. Output: p95 latency, error rate, pass/fail.' --non-interactive\"\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"d1b2ff7f-47bb-4554-8e6c-dc4d7cede9c6\",\r\n      \"name\": \"Security: ZAP DAST\",\r\n      \"type\": \"n8n-nodes-base.executeCommand\",\r\n      \"typeVersion\": 1,\r\n      \"position\": [\r\n        900,\r\n        400\r\n      ],\r\n      \"parameters\": {\r\n        \"command\": \"omp --role security-engineer --model smol --project {{ $env.REPO_DIR }} --prompt 'Run OWASP ZAP DAST scan against staging for {{ $json.body.version }}. Output: critical/high findings list.' --non-interactive\"\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"3d3b1485-fae6-4ed9-a1c6-eebad98c4db1\",\r\n      \"name\": \"Merge QA+Sec\",\r\n      \"type\": \"n8n-nodes-base.merge\",\r\n      \"typeVersion\": 3,\r\n      \"position\": [\r\n        1120,\r\n        300\r\n      ],\r\n      \"parameters\": {\r\n        \"mode\": \"waitForAll\"\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"71dc2e21-be43-45b6-9d8f-482ab7074ee7\",\r\n      \"name\": \"Notify: Tests done, RM deciding\",\r\n      \"type\": \"n8n-nodes-base.httpRequest\",\r\n      \"typeVersion\": 4.2,\r\n      \"position\": [\r\n        1340,\r\n        300\r\n      ],\r\n      \"parameters\": {\r\n        \"method\": \"POST\",\r\n   