              },
              {
                "name": "gitlab.global.appConfig.omniauth.providers[0].key",
                "type": "",
                "value": "provider"
              },
              {
                "name": "gitlab.global.appConfig.omniauth.providers[0].secret",
                "type": "",
                "value": "gitlab-omniauth-authentik"
              },
              {
                "name": "gitlab.global.initialRootPassword.secret",
                "type": "",
                "value": "gitlab-initial-root-password"
              }
            ],
            "set_list": [],
            "set_sensitive": [
              {
                "name": "gitlab.postgresql.auth.password",
                "type": "",
                "value": "dev-gitlab-db-password"
              }
            ],
            "skip_crds": false,
            "status": "deployed",
            "timeout": 600,
            "upgrade_install": null,
            "values": [
              "gitlab:\r\n  global:\r\n    edition: ce\r\n    hosts:\r\n      domain: gitlab.local\r\n      # ponytail: without this, hostname defaults to \"gitlab.\u003cdomain\u003e\" i.e.\r\n      # gitlab.gitlab.local (domain already includes \"gitlab\")\r\n      gitlab:\r\n        name: gitlab.local\r\n    initialRootPassword:\r\n      secret: \"\"  # set via terraform\r\n    ingress:\r\n      enabled: true\r\n      # ponytail: helm template has no live cluster to auto-detect API\r\n      # versions from; same class of issue as the pdb/hpa overrides above\r\n      apiVersion: networking.k8s.io/v1\r\n      provider: traefik\r\n      class: traefik\r\n      annotations:\r\n        cert-manager.io/cluster-issuer: homelab-ca-issuer\r\n      tls:\r\n        enabled: true\r\n        secretName: gitlab-tls\r\n      # ponytail: defaults true independent of ingress.enabled, keeps\r\n      # spawning a cert-manager issuer job; we manage our own ClusterIssuer\r\n      configureCertmanager: false\r\n    # ponytail: backed by the standalone minio app (helm/minio), not the\r\n    # gitlab chart's own bundled minio subchart (global.minio stays\r\n    # disabled below) — connection secret wired in gitlab/Tiltfile.\r\n    # Per-feature blocks below must leave `connection` empty and only set\r\n    # `bucket` for the chart to treat object_store.connection as the\r\n    # consolidated one they all inherit (see charts/gitlab/_objectStorage.tpl).\r\n    appConfig:\r\n      object_store:\r\n        enabled: true\r\n      lfs:\r\n        enabled: true\r\n        bucket: git-lfs\r\n      artifacts:\r\n        enabled: true\r\n        bucket: gitlab-artifacts\r\n      uploads:\r\n        enabled: true\r\n        bucket: gitlab-uploads\r\n      packages:\r\n        enabled: true\r\n        bucket: gitlab-packages\r\n      externalDiffs:\r\n        enabled: true\r\n        bucket: gitlab-mr-diffs\r\n      dependencyProxy:\r\n        enabled: true\r\n        bucket: gitlab-dependency-proxy\r\n      terraformState:\r\n        enabled: true\r\n        bucket: gitlab-terraform-state\r\n      ciSecureFiles:\r\n        enabled: true\r\n        bucket: gitlab-ci-secure-files\r\n      backups:\r\n        bucket: gitlab-backups\r\n    minio:\r\n      enabled: false\r\n    kas:\r\n      enabled: false\r\n    # ponytail: Tilt's helm() runs `helm template` with no cluster connection,\r\n    # so Capabilities-based API auto-detection can't run and falls back to the\r\n    # long-removed policy/v1beta1 PDB kind. Pin explicitly.\r\n    pdb:\r\n      apiVersion: policy/v1\r\n    hpa:\r\n      apiVersion: autoscaling/v2\r\n    # ponytail: gitlab-shell's SSH IngressRouteTCP only renders once\r\n    # ingress.provider is traefik; same live-cluster-detection gap as above,\r\n    # this cluster's Traefik (v3) only registers the newer traefik.io group\r\n    traefik:\r\n      apiVersion: traefik.io/v1alpha1\r\n\r\n  # disable non-essential components\r\n  registry:\r\n    enabled: false\r\n  certmanager:\r\n    install: false\r\n  nginx-ingress:\r\n    enabled: false\r\n  # ponytail: no ingress means no external hostname for the runner to register\r\n  # against (dial fails on gitlab.gitlab.local); CI isn't needed for dev testing\r\n  gitlab-runner:\r\n    install: false\r\n  prometheus:\r\n    install: false\r\n  grafana:\r\n    enabled: false\r\n  gitlab:\r\n    toolbox:\r\n      enabled: false\r\n    webservice:\r\n      minReplicas: 1\r\n      maxReplicas: 1\r\n      resources:\r\n        requests:\r\n          cpu: 100m\r\n          memory: 1Gi\r\n        limits:\r\n          memory: 2Gi\r\n    sidekiq:\r\n      minReplicas: 1\r\n      maxReplicas: 1\r\n      resources:\r\n        requests:\r\n          cpu: 50m\r\n          memory: 512Mi\r\n        limits:\r\n          memory: 1Gi\r\n    gitaly:\r\n      resources:\r\n        requests:\r\n          cpu: 50m\r\n          memory: 256Mi\r\n        limits:\r\n          memory: 512Mi\r\n    gitlab-shell:\r\n      minReplicas: 1\r\n      maxReplicas: 1\r\n\r\n  postgresql:\r\n    install: true\r\n    # ponytail: bitnami moved old image tags to bitnamilegacy on docker.io, upgrade image.tag when bumping chart\r\n    image:\r\n      repository: bitnamilegacy/postgresql\r\n    metrics:\r\n      image:\r\n        repository: bitnamilegacy/postgres-exporter\r\n    primary:\r\n      resources:\r\n        requests:\r\n          cpu: 50m\r\n          memory: 256Mi\r\n        limits:\r\n          memory: 512Mi\r\n\r\n  redis:\r\n    install: true\r\n    # ponytail: chart's pinned 6.2.7 tag is amd64-only in bitnamilegacy; pinned to a same-minor tag with arm64 support\r\n    image:\r\n      repository: bitnamilegacy/redis\r\n      tag: 6.2.16-debian-12-r3\r\n    metrics:\r\n      image:\r\n        repository: bitnamilegacy/redis-exporter\r\n        tag: 1.76.0-debian-12-r0\r\n    master:\r\n      resources:\r\n        requests:\r\n          cpu: 25m\r\n          memory: 64Mi\r\n        limits:\r\n          memory: 128Mi\r\n"
            ],
            "verify": false,
            "version": "0.1.0",
            "wait": true,
            "wait_for_jobs": false
          },
          "sensitive_attributes": [
            [
              {
                "type": "get_attr",
                "value": "repository_password"
              }
            ],
            [
              {
                "type": "get_attr",
                "value": "set_sensitive"
              }
            ]
          ],
          "private": "eyJzY2hlbWFfdmVyc2lvbiI6IjEifQ==",
          "dependencies": [
            "helm_release.cert_manager",
            "kubectl_manifest.homelab_ca",
            "kubectl_manifest.homelab_ca_issuer",
            "kubectl_manifest.selfsigned_bootstrap",
            "kubernetes_namespace.cert_manager",
            "kubernetes_namespace.gitlab",
            "kubernetes_secret.gitlab_omniauth_authentik",
            "kubernetes_secret.gitlab_root_password"
          ]
        }
      ]
    },
    {
      "mode": "managed",
      "type": "helm_release",
      "name": "minio",
      "provider": "provider[\"registry.opentofu.org/hashicorp/helm\"]",
      "instances": [
        {
          "schema_version": 1,
          "attributes": {
            "atomic": false,
            "chart": "./../helm/minio",
            "cleanup_on_fail": false,
            "create_namespace": false,
            "dependency_update": true,
            "description": null,
            "devel": null,
            "disable_crd_hooks": false,
            "disable_openapi_validation": false,
            "disable_webhooks": false,
            "force_update": false,
            "id": "minio",
            "keyring": null,
            "lint": false,
            "manifest": null,
            "max_history": 0,
            "metadata": [
              {
                "app_version": "",
                "chart": "minio",
                "first_deployed": 1787656049,
                "last_deployed": 1787656049,
                "name": "minio",
                "namespace": "minio",
                "notes": "\nMinIO can be accessed via port 9000 on the following DNS name from within your cluster:\nminio.minio.cluster.local\n\nTo access MinIO from localhost, run the below commands:\n\n  1. export POD_NAME=$(kubectl get pods --namespace minio -l \"release=minio\" -o jsonpath=\"{.items[0].metadata.name}\")\n\n  2. kubectl port-forward $POD_NAME 9000 --namespace minio\n\nRead more about port forwarding here: http://kubernetes.io/docs/user-guide/kubectl/kubectl_port-forward/\n\nYou can now access MinIO server on http://localhost:9000. Follow the below steps to connect to MinIO server with mc client:\n\n  1. Download the MinIO mc client - https://min.io/docs/minio/linux/reference/minio-mc.html#quickstart\n\n  2. export MC_HOST_minio-local=http://$(kubectl get secret --namespace minio minio -o jsonpath=\"{.data.rootUser}\" | base64 --decode):$(kubectl get secret --namespace minio minio -o jsonpath=\"{.data.rootPassword}\" | base64 --decode)@localhost:9000\n\n  3. mc ls minio-local\n\n\n",
                "revision": 1,
                "values": "{\"minio\":{\"consoleIngress\":{\"annotations\":{\"cert-manager.io/cluster-issuer\":\"homelab-ca-issuer\"},\"enabled\":true,\"hosts\":[\"minio-console.local\"],\"ingressClassName\":\"traefik\",\"tls\":[{\"hosts\":[\"minio-console.local\"],\"secretName\":\"minio-console.local-tls\"}]},\"drivesPerNode\":1,\"environment\":{\"MINIO_BROWSER\":\"on\",\"MINIO_IDENTITY_OPENID_CLAIM_NAME\":\"policy\",\"MINIO_IDENTITY_OPENID_CLIENT_ID\":\"(sensitive value)\",\"MINIO_IDENTITY_OPENID_CLIENT_SECRET\":\"(sensitive value)\",\"MINIO_IDENTITY_OPENID_CONFIG_URL\":\"https://desktop-qv5aogf.tail60240b.ts.net:8443/application/o/minio/.well-known/openid-configuration\",\"MINIO_IDENTITY_OPENID_DISPLAY_NAME\":\"Authentik\",\"MINIO_IDENTITY_OPENID_REDIRECT_URI\":\"https://desktop-qv5aogf.tail60240b.ts.net:8445/oauth_callback\",\"MINIO_IDENTITY_OPENID_SCOPES\":\"openid,profile,email,policy\"},\"image\":{\"repository\":\"quay.io/minio/minio\",\"tag\":\"RELEASE.2024-11-07T00-52-20Z\"},\"ingress\":{\"annotations\":{\"cert-manager.io/cluster-issuer\":\"homelab-ca-issuer\"},\"enabled\":true,\"hosts\":[\"minio.local\"],\"ingressClassName\":\"traefik\",\"tls\":[{\"hosts\":[\"minio.local\"],\"secretName\":\"minio.local-tls\"}]},\"mode\":\"standalone\",\"persistence\":{\"size\":\"8Gi\"},\"pools\":1,\"replicas\":1,\"resources\":{\"limits\":{\"memory\":\"512Mi\"},\"requests\":{\"cpu\":\"50m\",\"memory\":\"256Mi\"}},\"rootPassword\":\"(sensitive value)\",\"rootUser\":\"admin\"}}",
                "version": "0.1.0"
              }
            ],
            "name": "minio",
            "namespace": "minio",
            "pass_credentials": false,
            "postrender": [],
            "recreate_pods": false,
            "render_subchart_notes": true,
            "replace": false,
            "repository": null,
            "repository_ca_file": null,
            "repository_cert_file": null,
            "repository_key_file": null,
            "repository_password": null,
            "repository_username": null,
            "reset_values": false,
            "reuse_values": false,
            "set": [],
            "set_list": [],
            "set_sensitive": [
              {
                "name": "minio.environment.MINIO_IDENTITY_OPENID_CLIENT_ID",
                "type": "",
                "value": "dev-minio-oidc-client-id"
              },
              {
                "name": "minio.environment.MINIO_IDENTITY_OPENID_CLIENT_SECRET",
                "type": "",
                "value": "dev-minio-oidc-client-secret-not-for-prod-use"
              },
              {
                "name": "minio.rootPassword",
                "type": "",
                "value": "dev-minio-root-password"
              }
            ],
            "skip_crds": false,
            "status": "deployed",
            "timeout": 600,
            "upgrade_install": null,
            "values": [
              "minio:\n  image:\n    repository: quay.io/minio/minio\n    # ponytail: pinned — newer builds (tried up through RELEASE.2025-09-07)\n    # have a regression where the WebUI never shows the SSO login button\n    # despite fully correct, live-verified server-side OIDC config. This tag\n    # matches a known-working reference project exactly. Re-test on chart/\n    # image bumps before moving off it.\n    tag: RELEASE.2024-11-07T00-52-20Z\n\n  mode: standalone\n  replicas: 1\n  drivesPerNode: 1\n  pools: 1\n\n  rootUser: admin\n  rootPassword: \"\"  # set via terraform variable\n\n  persistence:\n    size: 8Gi\n\n  resources:\n    requests:\n      cpu: 50m\n      memory: 256Mi\n    limits:\n      memory: 512Mi\n\n  # ponytail: fixed dev client_id/secret matching the Authentik OAuth2\n  # provider created via the API (same one-time-setup pattern as GitLab's).\n  # If minio boots before Authentik/tailscale-serve is reachable (e.g. after\n  # a full cluster/host restart), the discovery fetch below 502s once and\n  # OIDC stays disabled for that pod's lifetime — no retry. Fix: `kubectl\n  # rollout restart deploy/minio -n minio` once Authentik is up. Chart has\n  # no initContainers hook to wait-for-it automatically (only extraContainers,\n  # which doesn't block startup), not worth patching the chart for a homelab.\n  environment:\n    MINIO_BROWSER: \"on\"\n    MINIO_IDENTITY_OPENID_CONFIG_URL: \"https://desktop-qv5aogf.tail60240b.ts.net:8443/application/o/minio/.well-known/openid-configuration\"\n    # MINIO_IDENTITY_OPENID_CLIENT_ID / _CLIENT_SECRET set via Tiltfile/terraform (.env)\n    MINIO_IDENTITY_OPENID_CLAIM_NAME: \"policy\"\n    MINIO_IDENTITY_OPENID_SCOPES: \"openid,profile,email,policy\"\n    MINIO_IDENTITY_OPENID_REDIRECT_URI: \"https://desktop-qv5aogf.tail60240b.ts.net:8445/oauth_callback\"\n    MINIO_IDENTITY_OPENID_DISPLAY_NAME: \"Authentik\"\n\n  ingress:\n    enabled: true\n    ingressClassName: traefik\n    annotations:\n      cert-manager.io/cluster-issuer: homelab-ca-issuer\n    hosts:\n      - minio.local\n    tls:\n      - secretName: minio.local-tls\n        hosts:\n          - minio.local\n\n  consoleIngress:\n    enabled: true\n    ingressClassName: traefik\n    annotations:\n      cert-manager.io/cluster-issuer: homelab-ca-issuer\n    hosts:\n      - minio-console.local\n    tls:\n      - secretName: minio-console.local-tls\n        hosts:\n          - minio-console.local\n"
            ],
            "verify": false,
            "version": "0.1.0",
            "wait": true,
            "wait_for_jobs": false
          },
          "sensitive_attributes": [
            [
              {
                "type": "get_attr",
                "value": "repository_password"
              }
            ],
            [
              {
                "type": "get_attr",
                "value": "set_sensitive"
              }
            ]
          ],
          "private": "eyJzY2hlbWFfdmVyc2lvbiI6IjEifQ==",
          "dependencies": [
            "kubernetes_namespace.minio"
          ]
        }
      ]
    },
    {
      "mode": "managed",
      "type": "helm_release",
      "name": "n8n",
      "provider": "provider[\"registry.opentofu.org/hashicorp/helm\"]",
      "instances": [
        {
          "schema_version": 1,
          "attributes": {
            "atomic": false,
            "chart": "./../helm/n8n",
            "cleanup_on_fail": false,
            "create_namespace": false,
            "dependency_update": true,
            "description": null,
            "devel": null,
            "disable_crd_hooks": false,
            "disable_openapi_validation": false,
            "disable_webhooks": false,
            "force_update": false,
            "id": "n8n",
            "keyring": null,
            "lint": false,
            "manifest": null,
            "max_history": 0,
            "metadata": [
              {
                "app_version": "",
                "chart": "n8n",
                "first_deployed": 1787660913,
                "last_deployed": 1787660913,
                "name": "n8n",
                "namespace": "n8n",
                "notes": "1. Get the application URL by running these commands:\n  export POD_NAME=$(kubectl get pods --namespace n8n -l \"app.kubernetes.io/name=n8n,app.kubernetes.io/instance=n8n\" -o jsonpath=\"{.items[0].metadata.name}\")\n  export CONTAINER_PORT=$(kubectl get pod --namespace n8n $POD_NAME -o jsonpath=\"{.spec.containers[0].ports[0].containerPort}\")\n  echo \"Visit http://127.0.0.1:8080 to use your application\"\n  kubectl --namespace n8n port-forward $POD_NAME 8080:$CONTAINER_PORT\n",
                "revision": 1,
                "values": "{\"n8n\":{\"encryptionKey\":\"(sensitive value)\",\"main\":{\"extraEnvVars\":{\"EXTERNAL_FRONTEND_HOOKS_URLS\":\"/assets/oidc-frontend-hook.js\",\"EXTERNAL_HOOK_FILES\":\"/hooks/hooks.js\",\"N8N_ADDITIONAL_NON_UI_ROUTES\":\"auth\",\"N8N_PROTOCOL\":\"https\",\"OIDC_CLIENT_ID\":\"(sensitive value)\",\"OIDC_CLIENT_SECRET\":\"(sensitive value)\",\"OIDC_ISSUER_URL\":\"https://desktop-qv5aogf.tail60240b.ts.net:8443/application/o/n8n/\",\"OIDC_REDIRECT_URI\":\"https://desktop-qv5aogf.tail60240b.ts.net:8447/auth/oidc/callback\"},\"livenessProbe\":{\"timeoutSeconds\":10},\"persistence\":{\"annotations\":{},\"enabled\":true},\"readinessProbe\":{\"timeoutSeconds\":10},\"resources\":{\"limits\":{\"memory\":\"1Gi\"},\"requests\":{\"cpu\":\"50m\",\"memory\":\"512Mi\"}},\"volumeMounts\":[{\"mountPath\":\"/hooks\",\"name\":\"oidc-hooks\",\"readOnly\":true}],\"volumes\":[{\"configMap\":{\"name\":\"n8n-oidc-hooks\"},\"name\":\"oidc-hooks\"}]}}}",
                "version": "0.1.0"
              }
            ],
            "name": "n8n",
            "namespace": "n8n",
            "pass_credentials": false,
            "postrender": [],
            "recreate_pods": false,
            "render_subchart_notes": true,
            "replace": false,
            "repository": null,
            "repository_ca_file": null,
            "repository_cert_file": null,
            "repository_key_file": null,
            "repository_password": null,
            "repository_username": null,
            "reset_values": false,
            "reuse_values": false,
            "set": [],
            "set_list": [],
            "set_sensitive": [
              {
                "name": "n8n.encryptionKey",
                "type": "",
                "value": "dev-n8n-encryption-key-not-for-prod-use"
              },
              {
                "name": "n8n.main.extraEnvVars.OIDC_CLIENT_ID",
                "type": "",
                "value": "dev-n8n-oidc-client-id"
              },
              {
                "name": "n8n.main.extraEnvVars.OIDC_CLIENT_SECRET",
                "type": "",
                "value": "dev-n8n-oidc-client-secret-not-for-prod-use"
              }
            ],
            "skip_crds": false,
            "status": "deployed",
            "timeout": 600,
            "upgrade_install": null,
            "values": [
              "n8n:\n  # ponytail: sqlite (chart default) instead of the bundled postgres subchart\n  # — one more app, one more moving part isn't worth it for a homelab\n  main:\n    persistence:\n      enabled: true\n      # ponytail: chart defaults this to \"helm.sh/resource-policy: keep\",\n      # which makes Tilt refuse to recreate the PVC after a manual delete\n      # (e.g. wiping it to reset the encryption key) — drop it so Tilt fully\n      # owns the PVC lifecycle like every other app's storage in this repo.\n      annotations: {}\n    resources:\n      requests:\n        cpu: 50m\n        memory: 512Mi\n      limits:\n        # ponytail: 512Mi wasn't enough headroom for Node's heap on top of\n        # n8n's own footprint — OOMKilled with \"JavaScript heap out of memory\"\n        memory: 1Gi\n\n    # ponytail: chart's 1s default probe timeout is too tight on this RPi\n    # under load (6 apps running concurrently) — caused a liveness-kill\n    # restart loop even though n8n was actually up. Same fix as sonarqube/\n    # seafile-mariadb's probe timeouts.\n    livenessProbe:\n      timeoutSeconds: 10\n    readinessProbe:\n      timeoutSeconds: 10\n\n    # ponytail: n8n gates native OIDC/SSO behind an Enterprise license.\n    # cweagans/n8n-oidc (MIT) bolts it on via n8n's external-hooks system\n    # instead — no license, no fork, just a JS file + env vars. hooks.js is\n    # mounted from a ConfigMap the Tiltfile builds from helm/n8n/hooks.js.\n    volumes:\n      - name: oidc-hooks\n        configMap:\n          name: n8n-oidc-hooks\n    volumeMounts:\n      - name: oidc-hooks\n        mountPath: /hooks\n        readOnly: true\n\n    # ponytail: fixed dev client_id/secret matching the Authentik OAuth2\n    # provider created via the API (same one-time-setup pattern as the\n    # other apps'). OIDC_ISSUER_URL uses the tailscale hostname so the\n    # server-side discovery fetch and the browser redirect agree on the\n    # same authority — same reasoning as minio/gitlab's OIDC wiring.\n    extraEnvVars:\n      EXTERNAL_HOOK_FILES: \"/hooks/hooks.js\"\n      N8N_ADDITIONAL_NON_UI_ROUTES: \"auth\"\n      EXTERNAL_FRONTEND_HOOKS_URLS: \"/assets/oidc-frontend-hook.js\"\n      N8N_PROTOCOL: \"https\"\n      OIDC_ISSUER_URL: \"https://desktop-qv5aogf.tail60240b.ts.net:8443/application/o/n8n/\"\n      # OIDC_CLIENT_ID / OIDC_CLIENT_SECRET set via Tiltfile/terraform (.env)\n      OIDC_REDIRECT_URI: \"https://desktop-qv5aogf.tail60240b.ts.net:8447/auth/oidc/callback\"\n"
            ],
            "verify": false,
            "version": "0.1.0",
            "wait": true,
            "wait_for_jobs": false
          },
          "sensitive_attributes": [
            [
              {
                "type": "get_attr",
                "value": "repository_password"
              }
            ],
            [
              {
                "type": "get_attr",
                "value": "set_sensitive"
              }
            ]
          ],
          "private": "eyJzY2hlbWFfdmVyc2lvbiI6IjEifQ==",
          "dependencies": [
            "kubernetes_config_map.n8n_oidc_hooks",
            "kubernetes_namespace.n8n"
          ]
        }
      ]
    },
    {
      "mode": "managed",
      "type": "helm_release",
      "name": "seafile",
      "provider": "provider[\"registry.opentofu.org/hashicorp/helm\"]",
      "instances": [
        {
          "schema_version": 1,
          "attributes": {
            "atomic": false,
            "chart": "./../helm/seafile",
            "cleanup_on_fail": false,
            "create_namespace": false,
            "dependency_update": false,
            "description": null,
            "devel": null,
            "disable_crd_hooks": false,
            "disable_openapi_validation": false,
            "disable_webhooks": false,
            "force_update": false,
            "id": "seafile",
            "keyring": null,
            "lint": false,
            "manifest": null,
            "max_history": 0,
            "metadata": [
              {
                "app_version": "",
                "chart": "seafile",
                "first_deployed": 1787650458,
                "last_deployed": 1787650458,
                "name": "seafile",
                "namespace": "seafile",
                "notes": "CHART NAME: mariadb\nCHART VERSION: 11.4.2\nAPP VERSION: 10.6.11\n\n** Please be patient while the chart is being deployed **\n\nTip:\n\n  Watch the deployment status using the command: kubectl get pods -w --namespace seafile -l app.kubernetes.io/instance=seafile\n\nServices:\n\n  echo Primary: seafile-mariadb.seafile.svc.cluster.local:3306\n\nAdministrator credentials:\n\n  Username: root\n  Password : $(kubectl get secret --namespace seafile seafile-mariadb -o jsonpath=\"{.data.mariadb-root-password}\" | base64 -d)\n\nTo connect to your database:\n\n  1. Run a pod that you can use as a client:\n\n      kubectl run seafile-mariadb-client --rm --tty -i --restart='Never' --image  docker.io/bitnamilegacy/mariadb:11.8.3-debian-12-r0 --namespace seafile --command -- bash\n\n  2. To connect to primary service (read/write):\n\n      mysql -h seafile-mariadb.seafile.svc.cluster.local -uroot -p seafile\n\nTo upgrade this helm chart:\n\n  1. Obtain the password as described on the 'Administrator credentials' section and set the 'auth.rootPassword' parameter as shown below:\n\n      ROOT_PASSWORD=$(kubectl get secret --namespace seafile seafile-mariadb -o jsonpath=\"{.data.mariadb-root-password}\" | base64 -d)\n      helm upgrade --namespace seafile seafile my-repo/mariadb --set auth.rootPassword=$ROOT_PASSWORD\n\n\n1. Access the application by visiting one of these URL's:\n\n  - http://seafile.local/",
                "revision": 1,
                "values": "{\"seafile\":{\"env\":{\"DB_ROOT_PASSWD\":\"(sensitive value)\",\"INIT_SEAFILE_ADMIN_EMAIL\":\"admin@seafile.local\",\"INIT_SEAFILE_ADMIN_PASSWORD\":\"\",\"INIT_SEAFILE_MYSQL_ROOT_PASSWORD\":\"\",\"OAUTHLIB_INSECURE_TRANSPORT\":\"1\",\"REDIS_HOST\":\"seafile-redis\",\"REDIS_PORT\":\"6379\",\"SEAFILE_ADMIN_PASSWORD\":\"(sensitive value)\",\"SEAFILE_MYSQL_DB_CCNET_DB_NAME\":\"ccnet_db\",\"SEAFILE_MYSQL_DB_HOST\":\"seafile-mariadb\",\"SEAFILE_MYSQL_DB_PASSWORD\":\"\",\"SEAFILE_MYSQL_DB_SEAFILE_DB_NAME\":\"seafile_db\",\"SEAFILE_MYSQL_DB_SEAHUB_DB_NAME\":\"seahub_db\",\"SEAFILE_MYSQL_DB_USER\":\"seafile\",\"SEAFILE_SERVER_HOSTNAME\":\"seafile.local\",\"SEAFILE_SERVER_LETSENCRYPT\":false,\"SEAFILE_SERVER_PROTOCOL\":\"http\",\"TIME_ZONE\":\"Asia/Singapore\"},\"image\":{\"tag\":\"13.0.25\"},\"ingress\":{\"main\":{\"annotations\":{\"cert-manager.io/cluster-issuer\":\"homelab-ca-issuer\"},\"enabled\":true,\"hosts\":[{\"host\":\"seafile.local\",\"paths\":[{\"path\":\"/\",\"pathType\":\"Prefix\"}]}],\"ingressClassName\":\"traefik\",\"tls\":[{\"hosts\":[\"seafile.local\"],\"secretName\":\"seafile.local-tls\"}]}},\"lifecycle\":{\"postStart\":{\"exec\":{\"command\":[\"/bin/sh\",\"-c\",\"i=0; while [ ! -f /shared/seafile/conf/seahub_settings.py ] \\u0026\\u0026 [ $i -lt 240 ]; do sleep 1; i=$((i+1)); done; if [ -f /shared/seafile/conf/seahub_settings.py ] \\u0026\\u0026 ! grep -q 'Authentik OIDC login' /shared/seafile/conf/seahub_settings.py; then printf '%s\\\\n' '' '# Authentik OIDC login' 'CSRF_TRUSTED_ORIGINS = [\\\"https://desktop-qv5aogf.tail60240b.ts.net:8449\\\"]' 'ENABLE_OAUTH = True' 'OAUTH_CLIENT_ID = \\\"__SEAFILE_OIDC_CLIENT_ID__\\\"' 'OAUTH_CLIENT_SECRET = \\\"__SEAFILE_OIDC_CLIENT_SECRET__\\\"' 'OAUTH_REDIRECT_URL = \\\"https://desktop-qv5aogf.tail60240b.ts.net:8449/oauth/callback/\\\"' 'OAUTH_PROVIDER = \\\"authentik\\\"' 'OAUTH_PROVIDER_DOMAIN = \\\"authentik\\\"' 'OAUTH_AUTHORIZATION_URL = \\\"https://desktop-qv5aogf.tail60240b.ts.net:8443/application/o/authorize/\\\"' 'OAUTH_TOKEN_URL = \\\"http://authentik-server.authentik.svc.cluster.local/application/o/token/\\\"' 'OAUTH_USER_INFO_URL = \\\"http://authentik-server.authentik.svc.cluster.local/application/o/userinfo/\\\"' 'OAUTH_SCOPE = [\\\"openid\\\", \\\"profile\\\", \\\"email\\\"]' 'OAUTH_ATTRIBUTE_MAP = {\\\"sub\\\": (True, \\\"uid\\\"), \\\"name\\\": (False, \\\"name\\\"), \\\"email\\\": (False, \\\"contact_email\\\")}' 'LOGIN_URL = \\\"/oauth/login/\\\"' 'CLIENT_SSO_VIA_LOCAL_BROWSER = True' \\u003e\\u003e /shared/seafile/conf/seahub_settings.py; fi\\n\"]}}},\"mariadb\":{\"auth\":{\"database\":\"seafile\",\"password\":\"(sensitive value)\",\"rootPassword\":\"(sensitive value)\",\"username\":\"seafile\"},\"enabled\":true,\"image\":{\"repository\":\"bitnamilegacy/mariadb\",\"tag\":\"11.8.3-debian-12-r0\"},\"primary\":{\"livenessProbe\":{\"timeoutSeconds\":10},\"persistence\":{\"enabled\":true,\"size\":\"4Gi\"},\"readinessProbe\":{\"timeoutSeconds\":10},\"resources\":{\"limits\":{\"memory\":\"512Mi\"},\"requests\":{\"cpu\":\"50m\",\"memory\":\"256Mi\"}}}},\"persistence\":{\"data\":{\"accessMode\":\"ReadWriteOnce\",\"enabled\":true,\"mountPath\":\"/shared\",\"size\":\"20Gi\",\"type\":\"pvc\"}},\"resources\":{\"limits\":{\"memory\":\"1536Mi\"},\"requests\":{\"cpu\":\"100m\",\"memory\":\"512Mi\"}}}}",
                "version": "0.1.0"
              }
            ],
            "name": "seafile",
            "namespace": "seafile",
            "pass_credentials": false,
            "postrender": [],
            "recreate_pods": false,
            "render_subchart_notes": true,
            "replace": false,
            "repository": null,
            "repository_ca_file": null,
            "repository_cert_file": null,
            "repository_key_file": null,
            "repository_password": null,
            "repository_username": null,
            "reset_values": false,
            "reuse_values": false,
            "set": [],
            "set_list": [],
            "set_sensitive": [
              {
                "name": "seafile.env.DB_ROOT_PASSWD",
                "type": "",
                "value": "dev-seafile-db-root-password"
              },
              {
                "name": "seafile.env.SEAFILE_ADMIN_PASSWORD",
                "type": "",
                "value": "dev-seafile-admin-password"
              },
              {
                "name": "seafile.mariadb.auth.password",
                "type": "",
                "value": "dev-seafile-db-password"
              },
              {
                "name": "seafile.mariadb.auth.rootPassword",
                "type": "",
                "value": "dev-seafile-db-root-password"
              }
            ],
            "skip_crds": false,
            "status": "deployed",
            "timeout": 600,
            "upgrade_install": null,
            "values": [
              "seafile:\n  # ponytail: chart defaults to 8.0.7, which is amd64-only on this arm64\n  # (RPi) host — pinned to the newest tag that ships an arm64 manifest.\n  image:\n    tag: \"13.0.25\"\n\n  # ponytail: the chart's default env keys (DB_HOST, DB_ROOT_PASSWD,\n  # SEAFILE_ADMIN_EMAIL/PASSWORD) are for the old pre-9.x seafile-mc image\n  # (matches the chart's default 8.0.7 tag). Image 13.0.25 above renamed all\n  # of these (SEAFILE_MYSQL_DB_*, INIT_SEAFILE_*) — using the old names here\n  # silently no-ops and the bootstrap hangs forever in wait_for_mysql().\n  env:\n    OAUTHLIB_INSECURE_TRANSPORT: \"1\"\n    TIME_ZONE: Asia/Singapore\n    SEAFILE_MYSQL_DB_HOST: seafile-mariadb\n    SEAFILE_MYSQL_DB_USER: seafile\n    SEAFILE_MYSQL_DB_PASSWORD: \"\"  # set via Tiltfile/terraform, matches mariadb.auth.password\n    SEAFILE_MYSQL_DB_CCNET_DB_NAME: ccnet_db\n    SEAFILE_MYSQL_DB_SEAFILE_DB_NAME: seafile_db\n    SEAFILE_MYSQL_DB_SEAHUB_DB_NAME: seahub_db\n    INIT_SEAFILE_MYSQL_ROOT_PASSWORD: \"\"  # set via Tiltfile/terraform, matches mariadb.auth.rootPassword\n    INIT_SEAFILE_ADMIN_EMAIL: admin@seafile.local\n    INIT_SEAFILE_ADMIN_PASSWORD: \"\"  # set via Tiltfile/terraform\n    SEAFILE_SERVER_HOSTNAME: seafile.local\n    SEAFILE_SERVER_PROTOCOL: http\n    SEAFILE_SERVER_LETSENCRYPT: false\n    REDIS_HOST: seafile-redis\n    REDIS_PORT: \"6379\"\n    # ponytail: seafile 13.x added JWT-signed internal auth between\n    # seafile/seahub/fileserver. Without this, first boot's upgrade step\n    # (which always runs once, even on a fresh install) demands a\n    # docker-compose-style .env file that doesn't apply to this single-\n    # container deployment — setting the env var directly skips that check.\n    # JWT_PRIVATE_KEY set via Tiltfile/terraform (.env)\n\n  # ponytail: bitnami moved old image tags to bitnamilegacy on docker.io,\n  # same fix as gitlab/sonarqube's postgres/mariadb subcharts. Chart's\n  # pinned 10.6.11 tag is amd64-only in bitnamilegacy (exec format error\n  # on this arm64 host) — pinned to a tag with arm64 support, same fix as\n  # gitlab's redis image.\n  mariadb:\n    enabled: true\n    image:\n      repository: bitnamilegacy/mariadb\n      tag: 11.8.3-debian-12-r0\n    auth:\n      database: seafile\n      username: seafile\n      password: \"\"  # set via Tiltfile/terraform\n      rootPassword: \"\"  # set via Tiltfile/terraform\n    primary:\n      persistence:\n        enabled: true\n        size: 4Gi\n      # ponytail: chart's 1s probe timeout is too tight on this RPi under\n      # load (image pulls / other apps booting concurrently) — mysql client\n      # startup alone can exceed it, causing probe \"timed out\" false negatives.\n      livenessProbe:\n        timeoutSeconds: 10\n      readinessProbe:\n        timeoutSeconds: 10\n      resources:\n        requests:\n          cpu: 50m\n          memory: 256Mi\n        limits:\n          memory: 512Mi\n\n  persistence:\n    data:\n      enabled: true\n      type: pvc\n      mountPath: /shared\n      accessMode: ReadWriteOnce\n      size: 20Gi\n\n  # ponytail: seahub_settings.py is generated fresh by the main container's\n  # own bootstrap script on first boot (with computed DB creds/secret key),\n  # so there's no initContainer hook-point to inject static OAuth config\n  # before it exists. postStart runs concurrently with the main process\n  # instead — polls until the file appears (fresh install: ~1-3min schema\n  # setup) then appends once, guarded by a sentinel so restarts don't\n  # duplicate it. Matches https://integrations.goauthentik.io/media/seafile/\n  # except the login template only renders a button for SAML SSO, not\n  # generic OAuth — so LOGIN_URL auto-redirect is required too (same\n  # autoSignInWithProvider pattern as this repo's gitlab/Tiltfile).\n  # __SEAFILE_OIDC_CLIENT_ID__/__SEAFILE_OIDC_CLIENT_SECRET__ are replaced\n  # by the Tiltfile via string substitution on the rendered YAML (not\n  # --set — this script is one big multi-line string, and --set with a\n  # value that size is a shell-escaping nightmare). Values come from `.env`.\n  lifecycle:\n    postStart:\n      exec:\n        command:\n          - /bin/sh\n          - -c\n          - \u003e\n            i=0;\n            while [ ! -f /shared/seafile/conf/seahub_settings.py ] \u0026\u0026 [ $i -lt 240 ]; do sleep 1; i=$((i+1)); done;\n            if [ -f /shared/seafile/conf/seahub_settings.py ] \u0026\u0026 ! grep -q 'Authentik OIDC login' /shared/seafile/conf/seahub_settings.py; then\n            printf '%s\\n' '' '# Authentik OIDC login'\n            'CSRF_TRUSTED_ORIGINS = [\"https://desktop-qv5aogf.tail60240b.ts.net:8449\"]'\n            'ENABLE_OAUTH = True'\n            'OAUTH_CLIENT_ID = \"__SEAFILE_OIDC_CLIENT_ID__\"'\n            'OAUTH_CLIENT_SECRET = \"__SEAFILE_OIDC_CLIENT_SECRET__\"'\n            'OAUTH_REDIRECT_URL = \"https://desktop-qv5aogf.tail60240b.ts.net:8449/oauth/callback/\"'\n            'OAUTH_PROVIDER = \"authentik\"'\n            'OAUTH_PROVIDER_DOMAIN = \"authentik\"'\n            'OAUTH_AUTHORIZATION_URL = \"https://desktop-qv5aogf.tail60240b.ts.net:8443/application/o/authorize/\"'\n            'OAUTH_TOKEN_URL = \"http://authentik-server.authentik.svc.cluster.local/application/o/token/\"'\n            'OAUTH_USER_INFO_URL = \"http://authentik-server.authentik.svc.cluster.local/application/o/userinfo/\"'\n            'OAUTH_SCOPE = [\"openid\", \"profile\", \"email\"]'\n            'OAUTH_ATTRIBUTE_MAP = {\"sub\": (True, \"uid\"), \"name\": (False, \"name\"), \"email\": (False, \"contact_email\")}'\n            'LOGIN_URL = \"/oauth/login/\"'\n            'CLIENT_SSO_VIA_LOCAL_BROWSER = True'\n            \u003e\u003e /shared/seafile/conf/seahub_settings.py;\n            fi\n\n  resources:\n    requests:\n      cpu: 100m\n      memory: 512Mi\n    limits:\n      memory: 1536Mi\n\n  ingress:\n    main:\n      enabled: true\n      ingressClassName: traefik\n      annotations:\n        cert-manager.io/cluster-issuer: homelab-ca-issuer\n      hosts:\n        - host: seafile.local\n          paths:\n            - path: /\n              pathType: Prefix\n      tls:\n        - secretName: seafile.local-tls\n          hosts:\n            - seafile.local\n"
            ],
            "verify": false,
            "version": "0.1.0",
            "wait": true,
            "wait_for_jobs": false
          },
          "sensitive_attributes": [
            [
              {
                "type": "get_attr",
                "value": "repository_password"
              }
            ],
            [
              {
                "type": "get_attr",
                "value": "set_sensitive"
              }
            ]
          ],
          "private": "eyJzY2hlbWFfdmVyc2lvbiI6IjEifQ==",
          "dependencies": [
            "kubernetes_namespace.seafile"
          ]
        }
      ]
    },
    {
      "mode": "managed",
      "type": "helm_release",
      "name": "sonarqube",
      "provider": "provider[\"registry.opentofu.org/hashicorp/helm\"]",
      "instances": [
        {
          "schema_version": 1,
          "attributes": {
            "atomic": false,
            "chart": "./../helm/sonarqube",
            "cleanup_on_fail": false,
