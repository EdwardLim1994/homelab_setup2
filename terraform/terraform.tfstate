            "data": {
              "F-00-gitlab-event-router.json": "{\n  \"name\": \"F-00 GitLab Event Router\",\n  \"nodes\": [\n    {\n      \"id\": \"947c03cc-3079-4f4a-ac72-3275192a12b1\",\n      \"name\": \"GitLab Webhook\",\n      \"type\": \"n8n-nodes-base.webhook\",\n      \"typeVersion\": 2,\n      \"position\": [\n        240,\n        300\n      ],\n      \"parameters\": {\n        \"path\": \"gitlab-events\",\n        \"httpMethod\": \"POST\",\n        \"responseMode\": \"onReceived\",\n        \"responseData\": \"allEntries\"\n      },\n      \"webhookId\": \"02734fda-29c5-4225-89f3-7df481136716\"\n    },\n    {\n      \"id\": \"76381f6a-c728-47ad-b2f5-36cb589a34da\",\n      \"name\": \"Verify Token\",\n      \"type\": \"n8n-nodes-base.if\",\n      \"typeVersion\": 2,\n      \"position\": [\n        460,\n        300\n      ],\n      \"parameters\": {\n        \"conditions\": {\n          \"options\": {\n            \"leftValue\": \"={{ $request.headers['x-gitlab-token'] }}\",\n            \"operation\": \"equals\",\n            \"rightValue\": \"={{ $env.GITLAB_WEBHOOK_SECRET }}\"\n          }\n        }\n      }\n    },\n    {\n      \"id\": \"3ff27062-0971-4209-b2de-9956be6a0348\",\n      \"name\": \"Route by Event+Branch\",\n      \"type\": \"n8n-nodes-base.switch\",\n      \"typeVersion\": 3,\n      \"position\": [\n        680,\n        300\n      ],\n      \"parameters\": {\n        \"mode\": \"rules\",\n        \"rules\": {\n          \"values\": [\n            {\n              \"conditions\": {\n                \"options\": {\n                  \"leftValue\": \"={{ $json.object_kind }}\",\n                  \"operation\": \"equals\",\n                  \"rightValue\": \"merge_request\"\n                }\n              },\n              \"outputKey\": \"mr\"\n            },\n            {\n              \"conditions\": {\n                \"options\": {\n                  \"leftValue\": \"={{ $json.object_kind }}\",\n                  \"operation\": \"equals\",\n                  \"rightValue\": \"pipeline\"\n                }\n              },\n              \"outputKey\": \"pipeline\"\n            }\n          ]\n        }\n      }\n    },\n    {\n      \"id\": \"7b3ff4c6-eb66-4d45-8c62-5c175c3122ea\",\n      \"name\": \"MR Open Branch Prefix\",\n      \"type\": \"n8n-nodes-base.switch\",\n      \"typeVersion\": 3,\n      \"position\": [\n        900,\n        160\n      ],\n      \"parameters\": {\n        \"mode\": \"rules\",\n        \"rules\": {\n          \"values\": [\n            {\n              \"conditions\": {\n                \"options\": {\n                  \"leftValue\": \"={{ $json.object_attributes.source_branch }}\",\n                  \"operation\": \"startsWith\",\n                  \"rightValue\": \"task/\"\n                }\n              },\n              \"outputKey\": \"task\"\n            },\n            {\n              \"conditions\": {\n                \"options\": {\n                  \"leftValue\": \"={{ $json.object_attributes.source_branch }}\",\n                  \"operation\": \"startsWith\",\n                  \"rightValue\": \"us/\"\n                }\n              },\n              \"outputKey\": \"story\"\n            }\n          ]\n        }\n      }\n    },\n    {\n      \"id\": \"a0120684-478f-46ba-843f-859098b7d210\",\n      \"name\": \"MR Merge Branch Prefix\",\n      \"type\": \"n8n-nodes-base.switch\",\n      \"typeVersion\": 3,\n      \"position\": [\n        900,\n        360\n      ],\n      \"parameters\": {\n        \"mode\": \"rules\",\n        \"rules\": {\n          \"values\": [\n            {\n              \"conditions\": {\n                \"options\": {\n                  \"leftValue\": \"={{ $json.object_attributes.source_branch }}\",\n                  \"operation\": \"startsWith\",\n                  \"rightValue\": \"task/\"\n                }\n              },\n              \"outputKey\": \"task\"\n            },\n            {\n              \"conditions\": {\n                \"options\": {\n                  \"leftValue\": \"={{ $json.object_attributes.source_branch }}\",\n                  \"operation\": \"startsWith\",\n                  \"rightValue\": \"us/\"\n                }\n              },\n              \"outputKey\": \"story\"\n            },\n            {\n              \"conditions\": {\n                \"options\": {\n                  \"leftValue\": \"={{ $json.object_attributes.source_branch }}\",\n                  \"operation\": \"startsWith\",\n                  \"rightValue\": \"bugfix/\"\n                }\n              },\n              \"outputKey\": \"revert\"\n            },\n            {\n              \"conditions\": {\n                \"options\": {\n                  \"leftValue\": \"={{ $json.object_attributes.source_branch }}\",\n                  \"operation\": \"startsWith\",\n                  \"rightValue\": \"promote/\"\n                }\n              },\n              \"outputKey\": \"promote\"\n            }\n          ]\n        }\n      }\n    },\n    {\n      \"id\": \"a87bc4a2-87f4-4982-9594-d03eb4bb5f28\",\n      \"name\": \"\\u2192 F-04 Task MR Opened\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4.2,\n      \"position\": [\n        1120,\n        160\n      ],\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/webhook/gitlab-task-mr-opened\",\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"__passthrough\",\n              \"value\": \"={{ JSON.stringify($json) }}\"\n            }\n          ]\n        }\n      }\n    },\n    {\n      \"id\": \"fdd65090-3cbd-41ee-9f7d-7d5b54d135de\",\n      \"name\": \"\\u2192 F-07 Story MR Opened\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4.2,\n      \"position\": [\n        1120,\n        240\n      ],\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/webhook/gitlab-story-mr-opened\",\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"__passthrough\",\n              \"value\": \"={{ JSON.stringify($json) }}\"\n            }\n          ]\n        }\n      }\n    },\n    {\n      \"id\": \"5151b54a-8ec8-480e-b605-8dabe194f962\",\n      \"name\": \"\\u2192 F-05 Task MR Merged\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4.2,\n      \"position\": [\n        1120,\n        320\n      ],\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/webhook/gitlab-task-mr-merged\",\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"__passthrough\",\n              \"value\": \"={{ JSON.stringify($json) }}\"\n            }\n          ]\n        }\n      }\n    },\n    {\n      \"id\": \"4610489a-5bd5-4d0c-a1bd-11e6440d2e22\",\n      \"name\": \"\\u2192 F-08 Story MR Merged\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4.2,\n      \"position\": [\n        1120,\n        400\n      ],\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/webhook/gitlab-story-mr-merged\",\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"__passthrough\",\n              \"value\": \"={{ JSON.stringify($json) }}\"\n            }\n          ]\n        }\n      }\n    },\n    {\n      \"id\": \"12ea3777-57b4-49f8-b954-fc5bef46c8e1\",\n      \"name\": \"\\u2192 F-23 Revert Merged\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4.2,\n      \"position\": [\n        1120,\n        480\n      ],\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/webhook/gitlab-revert-merged\",\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"__passthrough\",\n              \"value\": \"={{ JSON.stringify($json) }}\"\n            }\n          ]\n        }\n      }\n    },\n    {\n      \"id\": \"50002362-72ec-45a0-899f-e1ab704f9954\",\n      \"name\": \"\\u2192 F-18 Release MR Merged\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4.2,\n      \"position\": [\n        1120,\n        560\n      ],\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/webhook/gitlab-release-mr-merged\",\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"__passthrough\",\n              \"value\": \"={{ JSON.stringify($json) }}\"\n            }\n          ]\n        }\n      }\n    },\n    {\n      \"id\": \"bf887a71-2a7c-4b8d-b8c0-8e348e2fc1d1\",\n      \"name\": \"\\u2192 F-09 CI Pipeline\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4.2,\n      \"position\": [\n        1120,\n        640\n      ],\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/webhook/gitlab-pipeline\",\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"__passthrough\",\n              \"value\": \"={{ JSON.stringify($json) }}\"\n            }\n          ]\n        }\n      }\n    },\n    {\n      \"id\": \"2ee0baa4-8845-4bc5-9bb9-15a2359cee3d\",\n      \"name\": \"Reject 401\",\n      \"type\": \"n8n-nodes-base.respondToWebhook\",\n      \"typeVersion\": 1,\n      \"position\": [\n        680,\n        440\n      ],\n      \"parameters\": {\n        \"respondWith\": \"json\",\n        \"responseBody\": \"{\\\"error\\\":\\\"unauthorized\\\"}\",\n        \"options\": {\n          \"responseCode\": 401\n        }\n      }\n    }\n  ],\n  \"connections\": {\n    \"947c03cc-3079-4f4a-ac72-3275192a12b1\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"76381f6a-c728-47ad-b2f5-36cb589a34da\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"76381f6a-c728-47ad-b2f5-36cb589a34da\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"3ff27062-0971-4209-b2de-9956be6a0348\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ],\n        [\n          {\n            \"node\": \"2ee0baa4-8845-4bc5-9bb9-15a2359cee3d\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"3ff27062-0971-4209-b2de-9956be6a0348\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"7b3ff4c6-eb66-4d45-8c62-5c175c3122ea\",\n            \"type\": \"main\",\n            \"index\": 0\n          },\n          {\n            \"node\": \"a0120684-478f-46ba-843f-859098b7d210\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ],\n        [\n          {\n            \"node\": \"bf887a71-2a7c-4b8d-b8c0-8e348e2fc1d1\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"7b3ff4c6-eb66-4d45-8c62-5c175c3122ea\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"a87bc4a2-87f4-4982-9594-d03eb4bb5f28\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ],\n        [\n          {\n            \"node\": \"fdd65090-3cbd-41ee-9f7d-7d5b54d135de\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"a0120684-478f-46ba-843f-859098b7d210\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"5151b54a-8ec8-480e-b605-8dabe194f962\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ],\n        [\n          {\n            \"node\": \"4610489a-5bd5-4d0c-a1bd-11e6440d2e22\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ],\n        [\n          {\n            \"node\": \"12ea3777-57b4-49f8-b954-fc5bef46c8e1\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ],\n        [\n          {\n            \"node\": \"50002362-72ec-45a0-899f-e1ab704f9954\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    }\n  },\n  \"active\": true,\n  \"tags\": [],\n  \"settings\": {\n    \"executionOrder\": \"v1\"\n  }\n}",
              "F-00-gitlab-router.json": "{\n  \"name\": \"F-00 GitLab Event Router\",\n  \"nodes\": [\n    {\n      \"parameters\": {\n        \"httpMethod\": \"POST\",\n        \"path\": \"gitlab-events\",\n        \"responseMode\": \"lastNode\",\n        \"options\": {}\n      },\n      \"id\": \"webhook-gitlab-events\",\n      \"name\": \"Webhook: gitlab-events\",\n      \"type\": \"n8n-nodes-base.webhook\",\n      \"typeVersion\": 1,\n      \"position\": [\n        240,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"jsCode\": \"const secret = $env.GITLAB_WEBHOOK_SECRET;\\nconst header = $json.headers['x-gitlab-token'];\\nif (header !== secret) throw new Error('Invalid webhook secret');\\nconst body = $json.body;\\nconst eventType = $json.headers['x-gitlab-event'];\\nconst obj = body.object_attributes || {};\\nconst src = obj.source_branch || '';\\nconst ref = body.ref || '';\\nconst action = obj.action || obj.state || '';\\nlet route = null;\\nconst taskPrefixes = ['task/','api/','qa/','security/','devops/','bugfix/'];\\nconst isTask = taskPrefixes.some(p =\u003e src.startsWith(p));\\nif (eventType === 'Merge Request Hook') {\\n  if (action === 'open' || action === 'reopen') { if (isTask) route='task-mr-opened'; }\\n  else if (action === 'merge') {\\n    if (isTask) route='task-mr-merged';\\n    else if (src.startsWith('us/')) route='story-mr-merged';\\n    else if (src.startsWith('promote/')) route='release-mr-merged';\\n    else if (src.startsWith('revert-')) route='revert-mr-merged';\\n  }\\n} else if (eventType === 'Pipeline Hook') {\\n  const status = body.object_attributes?.status;\\n  if (status === 'success') {\\n    if (ref.startsWith('promote/')) route='ci-staging-deployed';\\n    else if (ref === 'main') route='ci-production-deployed';\\n    else if (ref.startsWith('us/')) route='ci-version-built';\\n  }\\n}\\nreturn [{ json: { ...body, _route: route, _event: eventType, _src: src, _ref: ref } }];\"\n      },\n      \"id\": \"detect-route\",\n      \"name\": \"Verify token + detect route\",\n      \"type\": \"n8n-nodes-base.code\",\n      \"typeVersion\": 2,\n      \"position\": [\n        480,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"dataType\": \"string\",\n        \"value1\": \"={{ $json._route }}\",\n        \"rules\": {\n          \"rules\": [\n            {\n              \"value2\": \"task-mr-opened\"\n            },\n            {\n              \"value2\": \"task-mr-merged\"\n            },\n            {\n              \"value2\": \"story-mr-merged\"\n            },\n            {\n              \"value2\": \"release-mr-merged\"\n            },\n            {\n              \"value2\": \"revert-mr-merged\"\n            },\n            {\n              \"value2\": \"ci-version-built\"\n            },\n            {\n              \"value2\": \"ci-staging-deployed\"\n            },\n            {\n              \"value2\": \"ci-production-deployed\"\n            }\n          ]\n        },\n        \"fallbackOutput\": \"extra\"\n      },\n      \"id\": \"route-switch\",\n      \"name\": \"Route by event + branch\",\n      \"type\": \"n8n-nodes-base.switch\",\n      \"typeVersion\": 3,\n      \"position\": [\n        720,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/gitlab-mr-opened\",\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"payload\",\n              \"value\": \"={{ JSON.stringify($json) }}\"\n            }\n          ]\n        }\n      },\n      \"id\": \"forward-gitlab-mr-opened\",\n      \"name\": \"Forward \\u2192 gitlab-mr-opened\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4,\n      \"position\": [\n        960,\n        60\n      ]\n    },\n    {\n      \"parameters\": {\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/gitlab-mr-merged\",\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"payload\",\n              \"value\": \"={{ JSON.stringify($json) }}\"\n            }\n          ]\n        }\n      },\n      \"id\": \"forward-gitlab-mr-merged\",\n      \"name\": \"Forward \\u2192 gitlab-mr-merged\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4,\n      \"position\": [\n        960,\n        108\n      ]\n    },\n    {\n      \"parameters\": {\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/story-mr-merged\",\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"payload\",\n              \"value\": \"={{ JSON.stringify($json) }}\"\n            }\n          ]\n        }\n      },\n      \"id\": \"forward-story-mr-merged\",\n      \"name\": \"Forward \\u2192 story-mr-merged\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4,\n      \"position\": [\n        960,\n        156\n      ]\n    },\n    {\n      \"parameters\": {\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/release-mr-merged\",\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"payload\",\n              \"value\": \"={{ JSON.stringify($json) }}\"\n            }\n          ]\n        }\n      },\n      \"id\": \"forward-release-mr-merged\",\n      \"name\": \"Forward \\u2192 release-mr-merged\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4,\n      \"position\": [\n        960,\n        204\n      ]\n    },\n    {\n      \"parameters\": {\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/revert-mr-merged\",\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"payload\",\n              \"value\": \"={{ JSON.stringify($json) }}\"\n            }\n          ]\n        }\n      },\n      \"id\": \"forward-revert-mr-merged\",\n      \"name\": \"Forward \\u2192 revert-mr-merged\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4,\n      \"position\": [\n        960,\n        252\n      ]\n    },\n    {\n      \"parameters\": {\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/ci-version-built\",\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"payload\",\n              \"value\": \"={{ JSON.stringify($json) }}\"\n            }\n          ]\n        }\n      },\n      \"id\": \"forward-ci-version-built\",\n      \"name\": \"Forward \\u2192 ci-version-built\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4,\n      \"position\": [\n        960,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/ci-staging-deployed\",\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"payload\",\n              \"value\": \"={{ JSON.stringify($json) }}\"\n            }\n          ]\n        }\n      },\n      \"id\": \"forward-ci-staging-deployed\",\n      \"name\": \"Forward \\u2192 ci-staging-deployed\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4,\n      \"position\": [\n        960,\n        348\n      ]\n    },\n    {\n      \"parameters\": {\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/ci-production-deployed\",\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"payload\",\n              \"value\": \"={{ JSON.stringify($json) }}\"\n            }\n          ]\n        }\n      },\n      \"id\": \"forward-ci-production-deployed\",\n      \"name\": \"Forward \\u2192 ci-production-deployed\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4,\n      \"position\": [\n        960,\n        396\n      ]\n    }\n  ],\n  \"connections\": {\n    \"Webhook: gitlab-events\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Verify token + detect route\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Verify token + detect route\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Route by event + branch\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Route by event + branch\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Forward \\u2192 gitlab-mr-opened\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ],\n        [\n          {\n            \"node\": \"Forward \\u2192 gitlab-mr-merged\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ],\n        [\n          {\n            \"node\": \"Forward \\u2192 story-mr-merged\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ],\n        [\n          {\n            \"node\": \"Forward \\u2192 release-mr-merged\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ],\n        [\n          {\n            \"node\": \"Forward \\u2192 revert-mr-merged\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ],\n        [\n          {\n            \"node\": \"Forward \\u2192 ci-version-built\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ],\n        [\n          {\n            \"node\": \"Forward \\u2192 ci-staging-deployed\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ],\n        [\n          {\n            \"node\": \"Forward \\u2192 ci-production-deployed\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    }\n  },\n  \"active\": true,\n  \"settings\": {\n    \"executionOrder\": \"v1\"\n  },\n  \"tags\": [\n    {\n      \"name\": \"router\"\n    },\n    {\n      \"name\": \"cross-cutting\"\n    }\n  ]\n}",
              "F-01-plan-release.json": "{\r\n  \"name\": \"F-01 /plan_release\",\r\n  \"nodes\": [\r\n    {\r\n      \"id\": \"640b5fba-4d3c-4c1e-9ca3-34b4278d83ad\",\r\n      \"name\": \"Webhook Trigger\",\r\n      \"type\": \"n8n-nodes-base.webhook\",\r\n      \"typeVersion\": 2,\r\n      \"position\": [\r\n        240,\r\n        300\r\n      ],\r\n      \"parameters\": {\r\n        \"path\": \"plan-release\",\r\n        \"httpMethod\": \"POST\",\r\n        \"responseMode\": \"onReceived\",\r\n        \"responseData\": \"allEntries\"\r\n      },\r\n      \"webhookId\": \"aa24848e-da89-4e4d-b81c-6b167ad2b6d2\"\r\n    },\r\n    {\r\n      \"id\": \"bf072095-3a82-4456-bd45-01a2f53dafb4\",\r\n      \"name\": \"Respond OK\",\r\n      \"type\": \"n8n-nodes-base.respondToWebhook\",\r\n      \"typeVersion\": 1,\r\n      \"position\": [\r\n        460,\r\n        300\r\n      ],\r\n      \"parameters\": {\r\n        \"respondWith\": \"json\",\r\n        \"responseBody\": \"{\\\"status\\\":\\\"accepted\\\"}\"\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"3e881a0f-4cee-4076-806c-97c39841b19f\",\r\n      \"name\": \"Notify: Starting plan_release\",\r\n      \"type\": \"n8n-nodes-base.httpRequest\",\r\n      \"typeVersion\": 4.2,\r\n      \"position\": [\r\n        680,\r\n        300\r\n      ],\r\n      \"parameters\": {\r\n        \"method\": \"POST\",\r\n        \"url\": \"={{ $env.OPENWEBUI_CALLBACK_URL }}\",\r\n        \"sendHeaders\": true,\r\n        \"headerParameters\": {\r\n          \"parameters\": [\r\n            {\r\n              \"name\": \"Content-Type\",\r\n              \"value\": \"application/json\"\r\n            }\r\n          ]\r\n        },\r\n        \"sendBody\": true,\r\n        \"bodyParameters\": {\r\n          \"parameters\": [\r\n            {\r\n              \"name\": \"flow_id\",\r\n              \"value\": \"={{ $json.flow_id ?? '' }}\"\r\n            },\r\n            {\r\n              \"name\": \"message\",\r\n              \"value\