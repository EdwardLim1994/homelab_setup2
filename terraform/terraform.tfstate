    {
      "mode": "managed",
      "type": "helm_release",
      "name": "argocd",
      "provider": "provider[\"registry.opentofu.org/hashicorp/helm\"]",
      "instances": [
        {
          "schema_version": 1,
          "attributes": {
            "atomic": false,
            "chart": "./../helm/argocd",
            "cleanup_on_fail": false,
            "create_namespace": false,
            "dependency_update": true,
            "description": null,
            "devel": null,
            "disable_crd_hooks": false,
            "disable_openapi_validation": false,
            "disable_webhooks": false,
            "force_update": false,
            "id": "argocd",
            "keyring": null,
            "lint": false,
            "manifest": null,
            "max_history": 0,
            "metadata": [
              {
                "app_version": "",
                "chart": "argocd",
                "first_deployed": 1789017132,
                "last_deployed": 1789115558,
                "name": "argocd",
                "namespace": "argocd",
                "notes": "\nIn order to access the server UI you have the following options:\n\n1. kubectl port-forward service/argocd-server -n argocd 8080:443\n\n    and then open the browser on http://localhost:8080 and accept the certificate\n\n2. enable ingress in the values file `server.ingress.enabled` and either\n      - Add the annotation for ssl passthrough: https://argo-cd.readthedocs.io/en/stable/operator-manual/ingress/#option-1-ssl-passthrough\n      - Set the `configs.params.\"server.insecure\"` in the values file and terminate SSL at your ingress: https://argo-cd.readthedocs.io/en/stable/operator-manual/ingress/#option-2-multiple-ingress-objects-and-hosts\n\n\nAfter reaching the UI the first time you can login with username: admin and the random password generated during the installation. You can find the password by running:\n\nkubectl -n argocd get secret argocd-initial-admin-secret -o jsonpath=\"{.data.password}\" | base64 -d\n\n(You should delete the initial secret afterwards as suggested by the Getting Started Guide: https://argo-cd.readthedocs.io/en/stable/getting_started/#4-login-using-the-cli)\n",
                "revision": 3,
                "values": "{\"argo-cd\":{\"applicationSet\":{\"resources\":{\"limits\":{\"memory\":\"128Mi\"},\"requests\":{\"cpu\":\"10m\",\"memory\":\"64Mi\"}}},\"configs\":{\"cm\":{\"oidc.config\":\"name: Authentik\\nissuer: https://authentik.tail60240b.ts.net/application/o/argocd/\\nclientID: dev-argocd-oidc-client-id\\nclientSecret: dev-argocd-oidc-client-secret-not-for-prod-use\\nrequestedScopes:\\n  - openid\\n  - profile\\n  - email\\n\",\"url\":\"https://argocd.tail60240b.ts.net\"},\"params\":{\"server.insecure\":true},\"rbac\":{\"policy.csv\":\"g, edwardlimkoksiong1994@gmail.com, role:admin\\n\",\"policy.default\":\"role:readonly\",\"scopes\":\"[email]\"}},\"controller\":{\"resources\":{\"limits\":{\"memory\":\"512Mi\"},\"requests\":{\"cpu\":\"50m\",\"memory\":\"256Mi\"}}},\"dex\":{\"enabled\":false},\"notifications\":{\"enabled\":false},\"redis\":{\"resources\":{\"limits\":{\"memory\":\"128Mi\"},\"requests\":{\"cpu\":\"10m\",\"memory\":\"64Mi\"}}},\"repoServer\":{\"resources\":{\"limits\":{\"memory\":\"256Mi\"},\"requests\":{\"cpu\":\"50m\",\"memory\":\"128Mi\"}}},\"server\":{\"ingress\":{\"annotations\":{\"cert-manager.io/cluster-issuer\":\"homelab-ca-issuer\"},\"enabled\":true,\"hosts\":[\"argocd.local\"],\"ingressClassName\":\"traefik\",\"tls\":[{\"hosts\":[\"argocd.local\"],\"secretName\":\"argocd.local-tls\"}]},\"initContainers\":[{\"command\":[\"sh\",\"-c\",\"apk add --no-cache ca-certificates \\u003e/dev/null 2\\u003e\\u00261\\ncp /etc/ssl/certs/ca-certificates.crt /combined/ca-certificates.crt\\n[ -f /homelab-ca/ca.crt ] \\u0026\\u0026 cat /homelab-ca/ca.crt \\u003e\\u003e /combined/ca-certificates.crt\\nexit 0\\n\"],\"image\":\"alpine:3\",\"name\":\"combine-certs\",\"volumeMounts\":[{\"mountPath\":\"/homelab-ca\",\"name\":\"homelab-ca\",\"readOnly\":true},{\"mountPath\":\"/combined\",\"name\":\"combined-ca\"}]}],\"resources\":{\"limits\":{\"memory\":\"256Mi\"},\"requests\":{\"cpu\":\"50m\",\"memory\":\"128Mi\"}},\"volumeMounts\":[{\"mountPath\":\"/etc/ssl/certs/ca-certificates.crt\",\"name\":\"combined-ca\",\"subPath\":\"ca-certificates.crt\"}],\"volumes\":[{\"name\":\"homelab-ca\",\"secret\":{\"optional\":true,\"secretName\":\"homelab-ca\"}},{\"emptyDir\":{},\"name\":\"combined-ca\"}]}}}",
                "version": "0.1.0"
              }
            ],
            "name": "argocd",
            "namespace": "argocd",
            "pass_credentials": false,
            "postrender": [],
            "recreate_pods": false,
            "render_subchart_notes": true,
            "replace": false,
            "repository": null,
            "repository_ca_file": null,
            "repository_cert_file": null,
            "repository_key_file": null,
            "repository_password": null,
            "repository_username": null,
            "reset_values": false,
            "reuse_values": false,
            "set": [],
            "set_list": [],
            "set_sensitive": [],
            "skip_crds": false,
            "status": "deployed",
            "timeout": 600,
            "upgrade_install": null,
            "values": [
              "argo-cd:\r\n  # ponytail: Dex is an OIDC proxy that ArgoCD bundles for providers that\r\n  # don't support OIDC natively. Authentik speaks OIDC directly, so Dex is\r\n  # dead weight here.\r\n  dex:\r\n    enabled: false\r\n\r\n  # ponytail: notifications controller is off — no alerting infra in this\r\n  # homelab. Enable when you wire up Slack/email webhooks.\r\n  notifications:\r\n    enabled: false\r\n\r\n  server:\r\n    # ponytail: Traefik terminates TLS at the ingress; ArgoCD server runs\r\n    # plain HTTP internally. Without --insecure the server redirects to its\r\n    # own HTTPS port which Traefik never sends traffic to.\r\n    ingress:\r\n      enabled: true\r\n      ingressClassName: traefik\r\n      annotations:\r\n        cert-manager.io/cluster-issuer: homelab-ca-issuer\r\n      hosts:\r\n        - argocd.local\r\n      tls:\r\n        - secretName: argocd.local-tls\r\n          hosts:\r\n            - argocd.local\r\n    resources:\r\n      requests:\r\n        cpu: 50m\r\n        memory: 128Mi\r\n      limits:\r\n        memory: 256Mi\r\n    # ponytail: oidc.config's issuer must stay the external tailnet URL (it's\r\n    # what Authentik puts in the token's `iss` claim and what the browser\r\n    # redirects to) — ArgoCD's built-in OIDC client has no split\r\n    # discovery-vs-browser endpoint like gitlab/grafana/litellm use, so unlike\r\n    # them argocd-server must actually trust the homelab CA to fetch\r\n    # .well-known/openid-configuration over that tailnet HTTPS (coredns.tf\r\n    # rewrites it to in-cluster traefik, which serves a homelab-CA cert).\r\n    # Same combine-and-overwrite-the-system-bundle trick as openwebui's\r\n    # init container, targeted at the Debian path Go's x509 reads by default\r\n    # (so this doesn't clobber public-CA trust for git-over-HTTPS etc, unlike\r\n    # setting SSL_CERT_FILE, which replaces rather than appends on Go/Linux).\r\n    volumes:\r\n      - name: homelab-ca\r\n        secret:\r\n          secretName: homelab-ca\r\n          optional: true\r\n      - name: combined-ca\r\n        emptyDir: {}\r\n    initContainers:\r\n      - name: combine-certs\r\n        image: alpine:3\r\n        command:\r\n          - sh\r\n          - -c\r\n          - |\r\n            apk add --no-cache ca-certificates \u003e/dev/null 2\u003e\u00261\r\n            cp /etc/ssl/certs/ca-certificates.crt /combined/ca-certificates.crt\r\n            [ -f /homelab-ca/ca.crt ] \u0026\u0026 cat /homelab-ca/ca.crt \u003e\u003e /combined/ca-certificates.crt\r\n            exit 0\r\n        volumeMounts:\r\n          - name: homelab-ca\r\n            mountPath: /homelab-ca\r\n            readOnly: true\r\n          - name: combined-ca\r\n            mountPath: /combined\r\n    volumeMounts:\r\n      - name: combined-ca\r\n        mountPath: /etc/ssl/certs/ca-certificates.crt\r\n        subPath: ca-certificates.crt\r\n\r\n  controller:\r\n    resources:\r\n      requests:\r\n        cpu: 50m\r\n        memory: 256Mi\r\n      limits:\r\n        memory: 512Mi\r\n\r\n  repoServer:\r\n    resources:\r\n      requests:\r\n        cpu: 50m\r\n        memory: 128Mi\r\n      limits:\r\n        memory: 256Mi\r\n\r\n  applicationSet:\r\n    resources:\r\n      requests:\r\n        cpu: 10m\r\n        memory: 64Mi\r\n      limits:\r\n        memory: 128Mi\r\n\r\n  redis:\r\n    resources:\r\n      requests:\r\n        cpu: 10m\r\n        memory: 64Mi\r\n      limits:\r\n        memory: 128Mi\r\n\r\n  configs:\r\n    params:\r\n      # ponytail: run HTTP internally; Traefik ingress handles TLS termination\r\n      server.insecure: true\r\n\r\n    cm:\r\n      # ponytail: url must match the external Tailscale URL — ArgoCD embeds\r\n      # it in the OIDC redirect_uri sent to Authentik. Wrong url = callback\r\n      # mismatch error after login.\r\n      url: \"https://argocd.tail60240b.ts.net\"\r\n      # ponytail: oidc.config drives ArgoCD's built-in OIDC client (no Dex).\r\n      # clientSecret is plain text here (ConfigMap, not Secret) because helm\r\n      # template base64-encodes Secret values before rendered.replace() runs —\r\n      # the placeholder would never match. Homelab trade-off: acceptable.\r\n      oidc.config: |\r\n        name: Authentik\r\n        issuer: https://authentik.tail60240b.ts.net/application/o/argocd/\r\n        clientID: dev-argocd-oidc-client-id\r\n        clientSecret: dev-argocd-oidc-client-secret-not-for-prod-use\r\n        requestedScopes:\r\n          - openid\r\n          - profile\r\n          - email\r\n\r\n    rbac:\r\n      # ponytail: scopes tells ArgoCD which OIDC token claims to use as group\r\n      # subjects for RBAC matching. '[email]' means policy.csv entries like\r\n      # \"g, user@example.com, role:admin\" match against the email claim.\r\n      scopes: '[email]'\r\n      policy.default: role:readonly\r\n      policy.csv: |\r\n        g, edwardlimkoksiong1994@gmail.com, role:admin\r\n"
            ],
            "verify": false,
            "version": "0.1.0",
            "wait": true,
            "wait_for_jobs": false
          },
