              "F-02-kickoff.json": "{\r\n  \"name\": \"F-02 /kickoff\",\r\n  \"nodes\": [\r\n    {\r\n      \"id\": \"516ef61b-d041-49ae-824a-d528608d6980\",\r\n      \"name\": \"Webhook Trigger\",\r\n      \"type\": \"n8n-nodes-base.webhook\",\r\n      \"typeVersion\": 2,\r\n      \"position\": [\r\n        240,\r\n        300\r\n      ],\r\n      \"parameters\": {\r\n        \"path\": \"kickoff\",\r\n        \"httpMethod\": \"POST\",\r\n        \"responseMode\": \"onReceived\",\r\n        \"responseData\": \"allEntries\"\r\n      },\r\n      \"webhookId\": \"61ec943e-86b1-4118-b28b-fda8049c924d\"\r\n    },\r\n    {\r\n      \"id\": \"d277cfaa-f9ce-4419-852c-ad0eea13f7ca\",\r\n      \"name\": \"Respond OK\",\r\n      \"type\": \"n8n-nodes-base.respondToWebhook\",\r\n      \"typeVersion\": 1,\r\n      \"position\": [\r\n        460,\r\n        300\r\n      ],\r\n      \"parameters\": {\r\n        \"respondWith\": \"json\",\r\n        \"responseBody\": \"{\\\"status\\\":\\\"accepted\\\"}\"\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"90948b75-fde9-49d4-8339-dbf4dd3edd4a\",\r\n      \"name\": \"Notify: Kickoff started\",\r\n      \"type\": \"n8n-nodes-base.httpRequest\",\r\n      \"typeVersion\": 4.2,\r\n      \"position\": [\r\n        680,\r\n        300\r\n      ],\r\n      \"parameters\": {\r\n        \"method\": \"POST\",\r\n        \"url\": \"={{ $env.OPENWEBUI_CALLBACK_URL }}\",\r\n        \"sendHeaders\": true,\r\n        \"headerParameters\": {\r\n          \"parameters\": [\r\n            {\r\n              \"name\": \"Content-Type\",\r\n              \"value\": \"application/json\"\r\n            }\r\n          ]\r\n        },\r\n        \"sendBody\": true,\r\n        \"bodyParameters\": {\r\n          \"parameters\": [\r\n            {\r\n              \"name\": \"flow_id\",\r\n              \"value\": \"={{ $json.flow_id ?? '' }}\"\r\n            },\r\n            {\r\n              \"name\": \"message\",\r\n              \"value\": \"\\ud83d\\ude80 kickoff started \\u2014 3 parallel tracks\"\r\n            },\r\n            {\r\n              \"name\": \"notes\",\r\n              \"value\": \"\"\r\n            }\r\n          ]\r\n        }\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"b02da329-9a7e-45ca-a098-30860e5e762d\",\r\n      \"name\": \"TL: Branches + Pseudocode\",\r\n      \"type\": \"n8n-nodes-base.executeCommand\",\r\n      \"typeVersion\": 1,\r\n      \"position\": [\r\n        900,\r\n        160\r\n      ],\r\n      \"parameters\": {\r\n        \"command\": \"omp --role tech-lead --model slow --project {{ $env.REPO_DIR }} --prompt 'Kickoff for {{ $json.body.version }}. Create story branches from release/{{ $json.body.version }}, write openspec pseudocode per task, label openspec:ready.' --non-interactive\"\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"e1dc6899-3754-4706-ade7-ae3a5bc076ac\",\r\n      \"name\": \"PM: GitLab Artifacts\",\r\n      \"type\": \"n8n-nodes-base.executeCommand\",\r\n      \"typeVersion\": 1,\r\n      \"position\": [\r\n        900,\r\n        320\r\n      ],\r\n      \"parameters\": {\r\n        \"command\": \"opencode --role pm --model haiku --prompt 'Create GitLab user-story issues and task issues for {{ $json.body.version }} milestone.' --non-interactive\"\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"e80b2745-2d8d-4624-b99d-17eba1e6cddd\",\r\n      \"name\": \"DevOps: Infra + Webhook\",\r\n      \"type\": \"n8n-nodes-base.executeCommand\",\r\n      \"typeVersion\": 1,\r\n      \"position\": [\r\n        900,\r\n        480\r\n      ],\r\n      \"parameters\": {\r\n        \"command\": \"omp --role devops-engineer --model default --project {{ $env.REPO_DIR }} --prompt 'Register GitLab group webhook (idempotent), set CI env vars, verify SIT cluster healthy for {{ $json.body.version }}.' --non-interactive\"\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"190355fa-88b0-41e7-ba40-da302eecf355\",\r\n      \"name\": \"Merge 3 Tracks\",\r\n      \"type\": \"n8n-nodes