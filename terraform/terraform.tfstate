                "name": "authentik",
                "namespace": "authentik",
                "notes": "Run the commands below to get a kubeconfig file for authentik:\n\nKUBE_API=$(kubectl config view --minify --output jsonpath=\"{.clusters[*].cluster.server}\")\nNAMESPACE=authentik\nSECRET_NAME=$(kubectl get serviceaccount authentik -o jsonpath='{.secrets[0].name}' 2\u003e/dev/null || echo -n \"authentik\")\nKUBE_CA=$(kubectl -n $NAMESPACE get secret/$SECRET_NAME -o jsonpath='{.data.ca\\.crt}')\nKUBE_TOKEN=$(kubectl -n $NAMESPACE get secret/$SECRET_NAME -o jsonpath='{.data.token}' | base64 --decode)\n\necho \"apiVersion: v1\nkind: Config\nclusters:\n- name: default-cluster\n  cluster:\n    certificate-authority-data: ${KUBE_CA}\n    server: ${KUBE_API}\ncontexts:\n- name: default-context\n  context:\n    cluster: default-cluster\n    namespace: $NAMESPACE\n    user: authentik-user\ncurrent-context: default-context\nusers:\n- name: authentik-user\n  user:\n    token: ${KUBE_TOKEN}\"\n",
                "revision": 1,
                "values": "{\"authentik\":{\"authentik\":{\"log_level\":\"info\",\"postgresql\":{\"host\":\"postgres.postgres.svc.cluster.local\",\"name\":\"authentik\",\"password\":\"(sensitive value)\",\"user\":\"authentik\"},\"redis\":{\"db\":1,\"host\":\"redis.redis.svc.cluster.local\"},\"secret_key\":\"(sensitive value)\"},\"global\":{\"env\":[{\"name\":\"AUTHENTIK_BOOTSTRAP_TOKEN\",\"value\":\"dev-authentik-bootstrap-token-not-for-prod-use\"},{\"name\":\"AUTHENTIK_BOOTSTRAP_PASSWORD\",\"value\":\"Admin1234!\"},{\"name\":\"AUTHENTIK_BOOTSTRAP_EMAIL\",\"value\":\"akadmin@authentik.local\"},{\"name\":\"GITHUB_OAUTH_CLIENT_ID\",\"value\":\"Ov23li7sHVJbV4ziaPII\"},{\"name\":\"GITHUB_OAUTH_CLIENT_SECRET\",\"value\":\"af73a65d4f17db2a356b47dd2faee77dbcabcaf1\"}]},\"postgresql\":{\"enabled\":false},\"redis\":{\"enabled\":false},\"server\":{\"ingress\":{\"annotations\":{\"cert-manager.io/cluster-issuer\":\"homelab-ca-issuer\"},\"enabled\":true,\"hosts\":[\"authentik.local\"],\"ingressClassName\":\"traefik\",\"tls\":[{\"hosts\":[\"authentik.local\"],\"secretName\":\"authentik-tls\"}]},\"replicas\":1,\"resources\":{\"limits\":{\"memory\":\"1Gi\"},\"requests\":{\"cpu\":\"100m\",\"memory\":\"512Mi\"}}},\"worker\":{\"replicas\":1,\"resources\":{\"limits\":{\"memory\":\"1Gi\"},\"requests\":{\"cpu\":\"50m\",\"memory\":\"512Mi\"}}}}}",
