              "F-23-revert-merged.json": "{\n  \"name\": \"F-23 Revert MR Merged\",\n  \"nodes\": [\n    {\n      \"id\": \"100e299c-6e9b-4521-82b8-7c5c00b2b416\",\n      \"name\": \"Webhook Trigger\",\n      \"type\": \"n8n-nodes-base.webhook\",\n      \"typeVersion\": 2,\n      \"position\": [\n        240,\n        300\n      ],\n      \"parameters\": {\n        \"path\": \"gitlab-revert-merged\",\n        \"httpMethod\": \"POST\",\n        \"responseMode\": \"onReceived\",\n        \"responseData\": \"allEntries\"\n      },\n      \"webhookId\": \"d554a772-19ed-4e7e-a1c4-5c3bef8c787f\"\n    },\n    {\n      \"id\": \"1a5245a6-9095-4e2a-928a-a37b934a2548\",\n      \"name\": \"Respond OK\",\n      \"type\": \"n8n-nodes-base.respondToWebhook\",\n      \"typeVersion\": 1,\n      \"position\": [\n        460,\n        300\n      ],\n      \"parameters\": {\n        \"respondWith\": \"json\",\n        \"responseBody\": \"{\\\"status\\\":\\\"accepted\\\"}\"\n      }\n    },\n    {\n      \"id\": \"ded48d7b-dcbf-48a5-9967-98fd7004248d\",\n      \"name\": \"Label story: Deferred\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4.2,\n      \"position\": [\n        680,\n        300\n      ],\n      \"parameters\": {\n        \"method\": \"PUT\",\n        \"url\": \"={{ $env.GITLAB_URL }}/api/v4/projects/{{ $env.GITLAB_PROJECT_ID }}/issues/{{ $json.object_attributes.source_branch.split('/')[1] }}\",\n        \"authentication\": \"genericCredentialType\",\n        \"genericAuthType\": \"httpHeaderAuth\",\n        \"sendHeaders\": true,\n        \"headerParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"PRIVATE-TOKEN\",\n              \"value\": \"={{ $env.GITLAB_TOKEN }}\"\n            },\n            {\n              \"name\": \"Content-Type\",\n              \"value\": \"application/json\"\n            }\n          ]\n        },\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"__json\",\n              \"value\": \"{\\\"add_labels\\\":\\\"status:deferred\\\",\\\"remove_labels\\\":\\\"status:in-progress\\\"}\"\n            }\n          ]\n        }\n      }\n    },\n    {\n      \"id\": \"65cdfa49-870a-40b9-800a-b689e6340f00\",\n      \"name\": \"Notify: Story deferred\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4.2,\n      \"position\": [\n        900,\n        300\n      ],\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.OPENWEBUI_CALLBACK_URL }}\",\n        \"sendHeaders\": true,\n        \"headerParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"Content-Type\",\n              \"value\": \"application/json\"\n            }\n          ]\n        },\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"flow_id\",\n              \"value\": \"={{ $json.flow_id ?? '' }}\"\n            },\n            {\n              \"name\": \"message\",\n              \"value\": \"\\ud83d\\udce6 Story deferred \\u2014 re-triggering /uat\"\n            },\n            {\n              \"name\": \"notes\",\n              \"value\": \"\"\n            }\n          ]\n        }\n      }\n    },\n    {\n      \"id\": \"adf03156-16e4-45ad-9da1-fc042b79dcb6\",\n      \"name\": \"\\u2192 F-10 /uat\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4.2,\n      \"position\": [\n        1120,\n        300\n      ],\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/webhook/uat\",\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"version\",\n              \"value\": \"={{ $env.RELEASE_VERSION }}\"\n            }\n          ]\n        }\n      }\n    }\n  ],\n  \"connections\": {\n    \"100e299c-6e9b-4521-82b8-7c5c00b2b416\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"1a5245a6-9095-4e2a-928a-a37b934a2548\",\n            \"type\": \"main\",\n            \"index\": 0\n          },\n          {\n            \"node\": \"ded48d7b-dcbf-48a5-9967-98fd7004248d\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"ded48d7b-dcbf-48a5-9967-98fd7004248d\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"65cdfa49-870a-40b9-800a-b689e6340f00\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"65cdfa49-870a-40b9-800a-b689e6340f00\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"adf03156-16e4-45ad-9da1-fc042b79dcb6\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    }\n  },\n  \"active\": true,\n  \"tags\": [],\n  \"settings\": {\n    \"executionOrder\": \"v1\"\n  }\n}",
              "F-23-revert-mr-merged.json": "{\n  \"name\": \"F-23 Revert MR Merged\",\n  \"nodes\": [\n    {\n      \"parameters\": {\n        \"httpMethod\": \"POST\",\n        \"path\": \"revert-mr-merged\",\n        \"responseMode\": \"lastNode\",\n        \"options\": {}\n      },\n      \"id\": \"wh-23\",\n      \"name\": \"Webhook: revert-mr-merged\",\n      \"type\": \"n8n-nodes-base.webhook\",\n      \"typeVersion\": 1,\n      \"position\": [\n        240,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"command\": \"=glab issue update {{ $json.body.story_id }} --label-add 'deferred:{{ $json.body.version }}' \u0026\u0026 glab issue comment {{ $json.body.story_id }} --message 'Deferred from {{ $json.body.version }}. Child tasks preserved.'\"\n      },\n      \"id\": \"defer-story\",\n      \"name\": \"Story ticket: Deferred + label\",\n      \"type\": \"n8n-nodes-base.executeCommand\",\n      \"typeVersion\": 1,\n      \"position\": [\n        480,\n        200\n      ]\n    },\n    {\n      \"parameters\": {\n        \"command\": \"=echo 'Labelling child tasks as deferred for GL-{{ $json.body.story_id }}'\"\n      },\n      \"id\": \"update-tasks\",\n      \"name\": \"Child tasks: label deferred, stay open\",\n      \"type\": \"n8n-nodes-base.executeCommand\",\n      \"typeVersion\": 1,\n      \"position\": [\n        480,\n        340\n      ]\n    },\n    {\n      \"parameters\": {\n        \"command\": \"=glab issue comment {{ $json.body.release_ticket_id }} --message 'GL-{{ $json.body.story_id }} deferred from {{ $json.body.version }}. Reduced scope.'\"\n      },\n      \"id\": \"update-rel\",\n      \"name\": \"Release ticket: update scope\",\n      \"type\": \"n8n-nodes-base.executeCommand\",\n      \"typeVersion\": 1,\n      \"position\": [\n        480,\n        480\n      ]\n    },\n    {\n      \"parameters\": {\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/uat\",\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"version\",\n              \"value\": \"={{ $json.body.version }}\"\n            },\n            {\n              \"name\": \"project\",\n              \"value\": \"={{ $json.body.project }}\"\n            },\n            {\n              \"name\": \"note\",\n              \"value\": \"Re-triggered after story deferral\"\n            }\n          ]\n        }\n      },\n      \"id\": \"retrigger-uat\",\n      \"name\": \"Re-trigger /uat with reduced scope\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4,\n      \"position\": [\n        720,\n        340\n      ]\n    },\n    {\n      \"parameters\": {\n        \"channelId\": \"={{ $env.MM_SDLC_CHANNEL }}\",\n        \"message\": \":arrows_counterclockwise: Story GL-`{{ $json.body.story_id }}` *deferred* from `{{ $json.body.version }}`.\\nChild tasks preserved · Release scope reduced · UAT re-triggered with reduced scope.\",\n        \"otherOptions\": {}\n      },\n      \"id\": \"slack-23\",\n      \"name\": \"Mattermost: story deferred — /uat re-triggered\",\n      \"type\": \"n8n-nodes-base.mattermost\",\n      \"typeVersion\": 1,\n      \"position\": [\n        960,\n        340\n      ],\n      \"credentials\": {\n        \"mattermostApi\": {\n          \"id\": \"mm-creds\",\n          \"name\": \"Mattermost SDLC Bot\"\n        }\n      }\n    }\n  ],\n  \"connections\": {\n    \"Webhook: revert-mr-merged\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Story ticket: Deferred + label\",\n            \"type\": \"main\",\n            \"index\": 0\n          },\n          {\n            \"node\": \"Child tasks: label deferred, stay open\",\n            \"type\": \"main\",\n            \"index\": 0\n          },\n          {\n            \"node\": \"Release ticket: update scope\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Story ticket: Deferred + label\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Re-trigger /uat with reduced scope\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Child tasks: label deferred, stay open\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Re-trigger /uat with reduced scope\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Release ticket: update scope\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Re-trigger /uat with reduced scope\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Re-trigger /uat with reduced scope\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Mattermost: story deferred — /uat re-triggered\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    }\n  },\n  \"active\": true,\n  \"settings\": {\n    \"executionOrder\": \"v1\"\n  },\n  \"tags\": [\n    {\n      \"name\": \"production\"\n    },\n    {\n      \"name\": \"phase-5\"\n    },\n    {\n      \"name\": \"mattermost\"\n    }\n  ]\n}\n",
              "F-24-retro.json": "{\r\n  \"name\": \"F-24 /retro\",\r\n  \"nodes\": [\r\n    {\r\n      \"id\": \"01128661-b98e-41e0-8695-c091872ecb72\",\r\n      \"name\": \"Webhook Trigger\",\r\n      \"type\": \"n8n-nodes-base.webhook\",\r\n      \"typeVersion\": 2,\r\n      \"position\": [\r\n        240,\r\n        300\r\n      ],\r\n      \"parameters\": {\r\n        \"path\": \"retro\",\r\n        \"httpMethod\": \"POST\",\r\n        \"responseMode\": \"onReceived\",\r\n        \"responseData\": \"allEntries\"\r\n      },\r\n      \"webhookId\": \"24ebe495-943d-482b-9d32-c57d92cb11ca\"\r\n    },\r\n    {\r\n      \"id\": \"42754aeb-fe7c-44e5-ba70-6bc0314df99c\",\r\n      \"name\": \"Respond OK\",\r\n      \"type\": \"n8n-nodes-base.respondToWebhook\",\r\n      \"typeVersion\": 1,\r\n      \"position\": [\r\n        460,\r\n        300\r\n      ],\r\n      \"parameters\": {\r\n        \"respondWith\": \"json\",\r\n        \"responseBody\": \"{\\\"status\\\":\\\"accepted\\\"}\"\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"9bd2dfa9-1743-4d85-ad08-83329e3dc5cd\",\r\n      \"name\": \"Notify: Retro started\",\r\n      \"type\": \"n8n-nodes-base.httpRequest\",\r\n      \"typeVersion\": 4.2,\r\n      \"position\": [\r\n        680,\r\n        300\r\n      ],\r\n      \"parameters\": {\r\n        \"method\": \"POST\",\r\n        \"url\": \"={{ $env.OPENWEBUI_CALLBACK_URL }}\",\r\n        \"sendHeaders\": true,\r\n        \"headerParameters\": {\r\n          \"parameters\": [\r\n            {\r\n              \"name\": \"Content-Type\",\r\n              \"value\": \"application/json\"\r\n            }\r\n          ]\r\n        },\r\n        \"sendBody\": true,\r\n        \"bodyParameters\": {\r\n          \"parameters\": [\r\n            {\r\n              \"name\": \"flow_id\",\r\n              \"value\": \"={{ $json.flow_id ?? '' }}\"\r\n            },\r\n            {\r\n              \"name\": \"message\",\r\n              \"value\": \"\\ud83d\\udd04 Retro started \\u2014 4 pods compiling in parallel\"\r\n            },\r\n            {\r\n              \"name\": \"notes\",\r\n              \"value\": \"\"\r\n            }\r\n          ]\r\n        }\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"0c7322e9-f26b-4356-a4f6-76e9ccc579a3\",\r\n      \"name\": \"TL: Tech Retro\",\r\n      \"type\": \"n8n-nodes-base.executeCommand\",\r\n      \"typeVersion\": 1,\r\n      \"position\": [\r\n        900,\r\n        160\r\n      ],\r\n      \"parameters\": {\r\n        \"command\": \"omp --role tech-lead --model slow --project {{ $env.REPO_DIR }} --prompt 'Compile technical retrospective for {{ $json.body.version }}: code quality, architecture decisions, technical debt incurred, pseudocode accuracy.' --non-interactive\"\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"298c9e5c-59ae-4481-9264-a11cc043a469\",\r\n      \"name\": \"QA: Quality Retro\",\r\n      \"type\": \"n8n-nodes-base.executeCommand\",\r\n      \"typeVersion\": 1,\r\n      \"position\": [\r\n        900,\r\n        300\r\n      ],\r\n      \"parameters\": {\r\n        \"command\": \"omp --role qa-engineer --model smol --project {{ $env.REPO_DIR }} --prompt 'Compile QA retrospective for {{ $json.body.version }}: test coverage, defect escape rate, UAT findings.' --non-interactive\"\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"4587422c-f0a2-4819-81e8-aa34af664a0a\",\r\n      \"name\": \"Sec: Security Retro\",\r\n      \"type\": \"n8n-nodes-base.executeCommand\",\r\n      \"typeVersion\": 1,\r\n      \"position\": [\r\n        900,\r\n        440\r\n      ],\r\n      \"parameters\": {\r\n        \"command\": \"omp --role security-engineer --model smol --project {{ $env.REPO_DIR }} --prompt 'Compile security retrospective for {{ $json.body.version }}: vulnerabilities found, SAST/DAST findings, remediation time.' --non-interactive\"\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"dca7ebc4-641e-4a8f-86d5-c93c6c7ae414\",\r\n      \"name\": \"RM: Process Retro\",\r\n      \"type\": \"n8n-nodes-base.executeCommand\",\r\n      \"typeVersion\": 1,\r\n      \"position\": [\r\n        900,\r\n        580\r\n      ],\r\n      \"parameters\": {\r\n        \"command\": \"omp --role release-manager --model default --project {{ $env.REPO_DIR }} --prompt 'Compile release process retrospective for {{ $json.body.version }}: timeline, gate durations, go/no-go history.' --non-interactive\"\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"1ebfe007-62ed-4fa7-bd56-a1262b89fc35\",\r\n      \"name\": \"Merge 4 Retros\",\r\n      \"type\": \"n8n-nodes-base.merge\",\r\n      \"typeVersion\": 3,\r\n      \"position\": [\r\n        1120,\r\n        360\r\n      ],\r\n      \"parameters\": {\r\n        \"mode\": \"waitForAll\"\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"9c4eda4e-da49-464d-b76c-64a4a310f4e9\",\r\n      \"name\": \"Notify: Synthesising\",\r\n      \"type\": \"n8n-nodes-base.httpRequest\",\r\n      \"typeVersion\": 4.2,\r\n      \"position\": [\r\n        1340,\r\n        360\r\n      ],\r\n      \"parameters\": {\r\n        \"method\": \"POST\",\r\n        \"url\": \"={{ $env.OPENWEBUI_CALLBACK_URL }}\",\r\n        \"sendHeaders\": true,\r\n        \"headerParameters\": {\r\n          \"parameters\": [\r\n            {\r\n              \"name\": \"Content-Type\",\r\n              \"value\": \"application/json\"\r\n            }\r\n          ]\r\n        },\r\n        \"sendBody\": true,\r\n        \"bodyParameters\": {\r\n          \"parameters\": [\r\n            {\r\n              \"name\": \"flow_id\",\r\n              \"value\": \"={{ $json.flow_id ?? '' }}\"\r\n            },\r\n            {\r\n              \"name\": \"message\",\r\n              \"value\": \"\\ud83d\\udcdd All retro inputs gathered \\u2014 PM synthesising 11-section report\"\r\n            },\r\n            {\r\n              \"name\": \"notes\",\r\n              \"value\": \"\"\r\n            }\r\n          ]\r\n        }\r\n      }\r\n    },\r\n    {\r\n  