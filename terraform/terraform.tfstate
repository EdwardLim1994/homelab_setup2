      "instances": [
        {
          "schema_version": 1,
          "attributes": {
            "atomic": false,
            "chart": "./../helm/openwebui",
            "cleanup_on_fail": false,
            "create_namespace": false,
            "dependency_update": true,
            "description": null,
            "devel": null,
            "disable_crd_hooks": false,
            "disable_openapi_validation": false,
            "disable_webhooks": false,
            "force_update": false,
            "id": "openwebui",
            "keyring": null,
            "lint": false,
            "manifest": null,
            "max_history": 0,
            "metadata": [
              {
                "app_version": "",
                "chart": "openwebui",
                "first_deployed": 1789110536,
                "last_deployed": 1789110754,
                "name": "openwebui",
                "namespace": "openwebui",
                "notes": "",
                "revision": 2,
                "values": "{\"env\":{\"ENABLE_LOGIN_FORM\":\"False\",\"ENABLE_OAUTH_ROLE_MANAGEMENT\":\"true\",\"ENABLE_OAUTH_SIGNUP\":\"true\",\"ENABLE_OLLAMA_API\":\"False\",\"ENABLE_PERSISTENT_CONFIG\":\"False\",\"OAUTH_ADMIN_ROLES\":\"admin\",\"OAUTH_CLIENT_ID\":\"dev-openwebui-oidc-client-id\",\"OAUTH_CLIENT_SECRET\":\"dev-openwebui-oidc-client-secret-not-for-prod-use\",\"OAUTH_PROVIDER_NAME\":\"Authentik\",\"OAUTH_ROLES_CLAIM\":\"roles\",\"OAUTH_SCOPES\":\"openid profile email openwebui_roles\",\"OLLAMA_BASE_URL\":\"\",\"OPENAI_API_BASE_URL\":\"http://litellm.litellm.svc.cluster.local:4000\",\"OPENAI_API_KEY\":\"sk-dev-litellm-master-key-not-for-prod-use\",\"OPENID_PROVIDER_URL\":\"https://authentik.tail60240b.ts.net/application/o/openwebui/.well-known/openid-configuration\",\"RESET_CONFIG_ON_START\":\"True\",\"SSL_CERT_FILE\":\"/certs/ca.crt\",\"WEBUI_URL\":\"https://openwebui.tail60240b.ts.net\"},\"image\":{\"repository\":\"ghcr.io/open-webui/open-webui\",\"tag\":\"main\"},\"resources\":{\"limits\":{\"memory\":\"2Gi\"},\"requests\":{\"cpu\":\"100m\",\"memory\":\"512Mi\"}},\"storageSize\":\"5Gi\"}",
                "version": "0.1.1"
              }
            ],
            "name": "openwebui",
            "namespace": "openwebui",
            "pass_credentials": false,
            "postrender": [],
            "recreate_pods": false,
            "render_subchart_notes": true,
            "replace": false,
            "repository": null,
            "repository_ca_file": null,
            "repository_cert_file": null,
            "repository_key_file": null,
            "repository_password": null,
            "repository_username": null,
            "reset_values": false,
            "reuse_values": false,
            "set": [],
            "set_list": [],
            "set_sensitive": [],
            "skip_crds": false,
            "status": "deployed",
            "timeout": 1200,
            "upgrade_install": null,
            "values": [
              "image:\n  repository: ghcr.io/open-webui/open-webui\n  tag: main\n\nstorageSize: 5Gi\n\nenv:\n  # ponytail: everything goes through LiteLLM (OpenAI-compatible) — chat models,\n  # the omp agents, and the host Ollama. Direct Ollama is off so there's\n  # one gateway to auth and log.\n  OPENAI_API_BASE_URL: \"http://litellm.litellm.svc.cluster.local:4000\"\n  # ponytail: LiteLLM master key — fine here, single-user trusted cluster.\n  # Swap for a virtual key (LiteLLM UI -\u003e Keys) if this ever gets more users.\n  OPENAI_API_KEY: \"sk-dev-litellm-master-key-not-for-prod-use\"\n  OLLAMA_BASE_URL: \"\"\n  ENABLE_OLLAMA_API: \"False\"\n\n  # OIDC / Authentik\n  ENABLE_OAUTH_SIGNUP: \"true\"\n  OAUTH_PROVIDER_NAME: \"Authentik\"\n  OPENID_PROVIDER_URL: \"https://authentik.tail60240b.ts.net/application/o/openwebui/.well-known/openid-configuration\"\n  OAUTH_CLIENT_ID: \"dev-openwebui-oidc-client-id\"\n  OAUTH_CLIENT_SECRET: \"dev-openwebui-oidc-client-secret-not-for-prod-use\"\n  OAUTH_SCOPES: \"openid profile email openwebui_roles\"\n  ENABLE_OAUTH_ROLE_MANAGEMENT: \"true\"\n  OAUTH_ROLES_CLAIM: \"roles\"\n  OAUTH_ADMIN_ROLES: \"admin\"\n  WEBUI_URL: \"https://openwebui.tail60240b.ts.net\"\n\n  # ponytail: ENABLE_LOGIN_FORM=False — SSO only. First SSO login by admin\n  # gets Admin role via openwebui_roles claim from Authentik.\n  ENABLE_LOGIN_FORM: \"False\"\n  ENABLE_PERSISTENT_CONFIG: \"False\"\n  RESET_CONFIG_ON_START: \"True\"\n\n  # ponytail: server-side OIDC calls go to Tailscale HTTPS; SSL_CERT_FILE\n  # trusts the homelab self-signed CA mounted from the homelab-ca Secret.\n  SSL_CERT_FILE: \"/certs/ca.crt\"\n\nresources:\n  requests:\n    cpu: 100m\n    memory: 512Mi\n  limits:\n    memory: 2Gi\n"
            ],
            "verify": false,
            "version": "0.1.1",
            "wait": true,
            "wait_for_jobs": false
          },
          "sensitive_attributes": [
