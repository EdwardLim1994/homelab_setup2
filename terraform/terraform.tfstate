sition\": [\r\n        1560,\r\n        200\r\n      ],\r\n      \"parameters\": {\r\n        \"method\": \"POST\",\r\n        \"url\": \"={{ $env.OPENWEBUI_CALLBACK_URL }}\",\r\n        \"sendHeaders\": true,\r\n        \"headerParameters\": {\r\n          \"parameters\": [\r\n            {\r\n              \"name\": \"Content-Type\",\r\n              \"value\": \"application/json\"\r\n            }\r\n          ]\r\n        },\r\n        \"sendBody\": true,\r\n        \"bodyParameters\": {\r\n          \"parameters\": [\r\n            {\r\n              \"name\": \"flow_id\",\r\n              \"value\": \"={{ $json.flow_id ?? '' }}\"\r\n            },\r\n            {\r\n              \"name\": \"message\",\r\n              \"value\": \"\\ud83c\\udf89 {{ $env.RELEASE_VERSION }} production confirmed clean \\u2014 release complete\"\r\n            },\r\n            {\r\n              \"name\": \"notes\",\r\n              \"value\": \"\"\r\n            }\r\n          ]\r\n        }\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"79aa36f9-d463-4b94-9e2b-cc58d4064815\",\r\n      \"name\": \"PM: Release Comms\",\r\n      \"type\": \"n8n-nodes-base.executeCommand\",\r\n      \"typeVersion\": 1,\r\n      \"position\": [\r\n        1780,\r\n        200\r\n      ],\r\n      \"parameters\": {\r\n        \"command\": \"opencode --role pm --model haiku --prompt 'Post release comms for {{ $json.body.version }}: changelog summary, what changed, who to contact.' --non-interactive\"\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"92d4e149-dcac-4fd2-8901-6200e8a17f2e\",\r\n      \"name\": \"Sleep Staging Cluster\",\r\n      \"type\": \"n8n-nodes-base.httpRequest\",\r\n      \"typeVersion\": 4.2,\r\n      \"position\": [\r\n        2000,\r\n        200\r\n      ],\r\n      \"parameters\": {\r\n        \"method\": \"POST\",\r\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/webhook/cluster-lifecycle\",\r\n        \"sendBody\": true,\r\n        \"bodyParameters\": {\r\n          \"p