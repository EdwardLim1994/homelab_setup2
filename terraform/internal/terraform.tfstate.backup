message\",\r\n              \"value\": \"✅ Gate B done — PM PRD gate C running\"\r\n            },\r\n            {\r\n              \"name\": \"notes\",\r\n              \"value\": \"\"\r\n            }\r\n          ]\r\n        }\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"b1000001-0000-0000-0000-000000000006\",\r\n      \"name\": \"PM Input\",\r\n      \"type\": \"n8n-nodes-base.set\",\r\n      \"typeVersion\": 3.4,\r\n      \"position\": [\r\n        2220,\r\n        260\r\n      ],\r\n      \"parameters\": {\r\n        \"mode\": \"manual\",\r\n        \"assignments\": {\r\n          \"assignments\": [\r\n            {\r\n              \"id\": \"1\",\r\n              \"name\": \"role\",\r\n              \"value\": \"pm\",\r\n              \"type\": \"string\"\r\n            },\r\n            {\r\n              \"id\": \"2\",\r\n              \"name\": \"prompt\",\r\n              \"value\": \"=Requirements discussion (from chat, before this command was run): {{ $node['Webhook Trigger'].json.body.body.context ?? 'none — no prior discussion' }}\\n\\nThis is a PLANNING report only — do NOT touch GitLab or Kaneo (no wiki page, no milestone) here; kickoff publishes the PRD to GitLab's wiki and creates the GitLab milestone once the plan is approved. Generate a PRD for {{ $node['Webhook Trigger'].json.body.body.version }} using all gate outputs. Write the PRD to a local markdown file, then upload it to MinIO: `mc alias set local $MINIO_ENDPOINT $MINIO_ROOT_USER $MINIO_ROOT_PASSWORD \u003e/dev/null \u0026\u0026 mc cp \u003cyour-file\u003e.md local/release-reports/{{ $node['Webhook Trigger'].json.body.body.version }}/prd.md`. Report the exact object path once the upload succeeds.\",\r\n              \"type\": \"string\"\r\n            },\r\n            {\r\n              \"id\": \"3\",\r\n              \"name\": \"story\",\r\n              \"value\": \"={{ $node['Webhook Trigger'].json.body.body.version }}\",\r\n              \"type\": \"string\"\r\n            }\r\n          ]\r\n        }\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"0fd57ab2-eb21-44b6-9ee1-813a61209de9\",\r\n      \"name\": \"PM PRD\",\r\n      \"type\": \"n8n-nodes-base.executeWorkflow\",\r\n      \"typeVersion\": 1.1,\r\n      \"position\": [\r\n        2400,\r\n        320\r\n      ],\r\n      \"parameters\": {\r\n        \"source\": \"database\",\r\n        \"workflowId\": {\r\n          \"mode\": \"id\",\r\n          \"value\": \"jAv16SAzGy9fA5G4\"\r\n        },\r\n        \"mode\": \"once\"\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"c3f5a891-2b6d-4e7a-9c1f-5a8d3e6b9c02\",\r\n      \"name\": \"TL Input (Estimate)\",\r\n      \"type\": \"n8n-nodes-base.set\",\r\n      \"typeVersion\": 3.4,\r\n      \"position\": [\r\n        2600,\r\n        320\r\n      ],\r\n      \"parameters\": {\r\n        \"mode\": \"manual\",\r\n        \"assignments\": {\r\n          \"assignments\": [\r\n            {\r\n              \"id\": \"1\",\r\n              \"name\": \"role\",\r\n              \"value\": \"tech-lead\",\r\n              \"type\": \"string\"\r\n            },\r\n            {\r\n              \"id\": \"2\",\r\n              \"name\": \"prompt\",\r\n              \"value\": \"=Reporting only — do NOT create any Kaneo tickets or GitLab branches here, this is a planning-stage estimate, kickoff (which does create the real tickets/branches) hasn't run yet, and do NOT touch GitLab or Kaneo at all (no wiki reads/writes) — fetch the PRD and Architecture sections from MinIO instead of GitLab: `mc alias set local $MINIO_ENDPOINT $MINIO_ROOT_USER $MINIO_ROOT_PASSWORD \u003e/dev/null \u0026\u0026 mc cat local/release-reports/{{ $node['Webhook Trigger'].json.body.body.version }}/prd.md` and `mc cat local/release-reports/{{ $node['Webhook Trigger'].json.body.body.version }}/architecture.md` for the story list and technical scope. For EACH story, break it into task-level items by role x feature — NOT one generic task per story — the same decomposition a Tech Lead would use at kickoff: identify the distinct backend/frontend/api features the story touches (e.g. a login story might be 'frontend: login page' + 'backend: login mechanism' + 'api: login endpoint contract'). For each task, estimate development time in hours, accounting for the risk/complexity surfaced in the Architecture section and QA/Security gate outputs above (a task touching a flagged risk area should carry a wider/higher estimate, say so). Skip any role a story genuinely doesn't touch. Produce a markdown table per story: columns Task (role-prefixed, e.g. '[backend] login mechanism'), Estimated Hours, Notes (assumptions/risk driving the number) — plus a per-story subtotal row and a grand total at the end for the whole release. Write this to a local markdown file, then upload it to MinIO: `mc cp \u003cyour-file\u003e.md local/release-reports/{{ $node['Webhook Trigger'].json.body.body.version }}/estimate.md`. Report the exact object path once the upload succeeds.\",\r\n              \"type\": \"string\"\r\n            },\r\n            {\r\n              \"id\": \"3\",\r\n              \"name\": \"story\",\r\n              \"value\": \"={{ $node['Webhook Trigger'].json.body.body.version }}\",\r\n              \"type\": \"string\"\r\n            }\r\n          ]\r\n        }\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"d4a6b9c2-3e7f-4a8b-9d2e-6b9c4f7a1e03\",\r\n      \"name\": \"TL Estimate\",\r\n      \"type\": \"n8n-nodes-base.executeWorkflow\",\r\n      \"typeVersion\": 1.1,\r\n      \"position\": [\r\n        2780,\r\n        320\r\n      ],\r\n      \"parameters\": {\r\n        \"source\": \"database\",\r\n        \"workflowId\": {\r\n          \"mode\": \"id\",\r\n          \"value\": \"jAv16SAzGy9fA5G4\"\r\n        },\r\n        \"mode\": \"once\"\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"e5b7c103-4a92-4f6e-8c1a-9d3f2b6e8a41\",\r\n      \"name\": \"PM Input (Compile)\",\r\n      \"type\": \"n8n-nodes-base.set\",\r\n      \"typeVersion\": 3.4,\r\n      \"position\": [\r\n        2620,\r\n        320\r\n      ],\r\n      \"parameters\": {\r\n        \"mode\": \"manual\",\r\n        \"assignments\": {\r\n          \"assignments\": [\r\n            {\r\n              \"id\": \"1\",\r\n              \"name\": \"role\",\r\n              \"value\": \"pm\",\r\n              \"type\": \"string\"\r\n            },\r\n            {\r\n              \"id\": \"2\",\r\n              \"name\": \"prompt\",\r\n              \"value\": \"=Report compiler — planning stage only, do NOT touch GitLab or Kaneo. `mc alias set local $MINIO_ENDPOINT $MINIO_ROOT_USER $MINIO_ROOT_PASSWORD \u003e/dev/null`, then download EVERYTHING uploaded for {{ $node['Webhook Trigger'].json.body.body.version }} in one shot (markdown sections AND every diagram SVG they reference): `mc cp --recursive local/release-reports/{{ $node['Webhook Trigger'].json.body.body.version }}/ .` — architecture.md/schema-impact.md/qa-risk.md/security-threat.md/ux-review.md/prd.md/estimate.md and their SVGs land in the current directory together, so the markdown's `![](\u003cname\u003e.svg)` references resolve as relative paths once you assemble combined.md here. Some sections may be missing if an earlier step failed; skip missing ones and note the gap, don't fail the whole compile over it.\\n\\nAssemble combined.md as a fixed proposal template — these 20 sections, in this exact order, each its own `# \u003cN\u003e. \u003cSection\u003e` markdown heading (source material in brackets; where no generated section maps to it, write the standard short paragraph given, don't leave it blank or invent unsupported specifics):\\n1. Cover Page — project name, version, revision, today's date (from the webhook vars, no source file needed).\\n2. Table of Contents — omit the content, `publish-pdf.sh`'s pandoc call renders this automatically from headings via --toc.\\n3. Executive Summary — 2-3 sentences synthesized from prd.md's own opening/goal, not copied verbatim.\\n4. Project Objectives — extract the measurable goals/KPIs from prd.md.\\n5. Scope of Work — extract in-scope features by user type and any explicit out-of-scope items from prd.md.\\n6. Technical Approach / Solution Architecture — architecture.md in full, including its diagram image references as-is (these are real rendered vector SVGs, not Mermaid source — see `publish-pdf.sh` invocation below for how they get bundled into the PDF).\\n7. Technology Stack — pull the stack choices already stated in architecture.md into a short table (frontend/backend/database/hosting/CI-CD); if architecture.md doesn't break it out this cleanly, say so and give the best table extractable from it rather than fabricating entries.\\n8. Non-Functional Requirements — performance/scalability/security/availability points pulled from architecture.md and security-threat.md.\\n9. Team Composition \u0026 Roles — static: list the SDLC roles this pipeline runs (Architect, Data Engineer, PM, Tech Lead, Backend/Frontend Developer, QA, Security, DevOps, UX, Product Owner, Release Manager) with a one-line responsibility each; this is a fixed pipeline roster, not a staffing plan.\\n10. Project Timeline/Milestones — the phase breakdown and durations from estimate.md.\\n11. Deliverables — the concrete outputs listed in estimate.md and prd.md (source code, docs, deployed services).\\n12. Assumptions \u0026 Dependencies — any cross-story/external dependency noted in prd.md; if none, write \\\"No external dependencies identified at planning time.\\\"\\n13. Risk Analysis \u0026 Mitigation Plan — qa-risk.md and security-threat.md combined, each risk with impact/likelihood/mitigation as those reports already structure it.\\n14. Change Management Process — static boilerplate: \\\"Scope changes are raised as new Kaneo tasks against this release's epic and re-estimated by Tech Lead; they do not retroactively alter this proposal.\\\"\\n15. Communication \u0026 Reporting Plan — static boilerplate: \\\"This is an automated SDLC pipeline (n8n-orchestrated agent pods) — there are no standing meetings; progress is tracked live in Kaneo, and sign-off gates notify via the project's configured channel.\\\"\\n16. Testing \u0026 Quality Assurance — qa-risk.md's testing approach and acceptance criteria.\\n17. Deployment \u0026 Release Strategy — derived from architecture.md's deployment section plus the pipeline's own SIT -\u003e UAT -\u003e staging -\u003e production flow (ArgoCD-managed, ArgoCD Image Updater promotes tags).\\n18. Maintenance \u0026 Support Plan — static boilerplate: \\\"Post-release monitoring runs through the shared Grafana/Loki/Tempo stack; see F-21/F-22's rollback flow for incident response.\\\"\\n19. Cost Estimate/Pricing — estimate.md's effort breakdown (this homelab pipeline has no $ pricing — present it as effort/time, not currency).\\n20. Appendices — ux-review.md in full, plus schema-impact.md if it wasn't already folded into section 8.\\n\\nThen run: `publish-pdf.sh {{ $node['Webhook Trigger'].json.body.body.project }} {{ $node['Webhook Trigger'].json.body.body.version }} {{ $node['Webhook Trigger'].json.body.body.revision ?? '1' }} combined.md *.svg` — this is a pre-built script already on this image, it converts combined.md to PDF in a throwaway Kubernetes Job (pandoc lives there, not on this always-resident pod), bundling every trailing SVG argument alongside it so pandoc can resolve combined.md's image references, and uploads the PDF to Nextcloud, then cleans the Job up itself. It prints the uploaded path on success, or a Job failure/timeout message plus the pandoc/upload container logs on stderr on failure — do not try to reimplement any of this yourself, just run the script (with every downloaded `.svg` passed after combined.md) and report exactly what it printed.\",\r\n              \"type\": \"string\"\r\n            },\r\n            {\r\n              \"id\": \"3\",\r\n              \"name\": \"story\",\r\n              \"value\": \"={{ $node['Webhook Trigger'].json.body.body.version }}\",\r\n              \"type\": \"string\"\r\n            }\r\n          ]\r\n        }\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"f1a9d284-6b3e-4c7a-9f5d-2e8b1a4c6d92\",\r\n      \"name\": \"PM: Compile Development Plan\",\r\n      \"type\": \"n8n-nodes-base.executeWorkflow\",\r\n      \"typeVersion\": 1.1,\r\n      \"position\": [\r\n        2800,\r\n        320\r\n      ],\r\n      \"parameters\": {\r\n        \"source\": \"database\",\r\n        \"workflowId\": {\r\n          \"mode\": \"id\",\r\n          \"value\": \"jAv16SAzGy9fA5G4\"\r\n        },\r\n        \"mode\": \"once\"\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"f72e1772-9cba-4f16-be6e-dc7311443563\",\r\n      \"name\": \"Notify: plan_release complete\",\r\n      \"type\": \"n8n-nodes-base.httpRequest\",\r\n      \"typeVersion\": 4.2,\r\n      \"position\": [\r\n        2440,\r\n        320\r\n      ],\r\n      \"parameters\": {\r\n        \"method\": \"POST\",\r\n        \"url\": \"={{ $env.OPENWEBUI_CALLBACK_URL }}\",\r\n        \"sendHeaders\": true,\r\n        \"headerParameters\": {\r\n          \"parameters\": [\r\n            {\r\n              \"name\": \"Content-Type\",\r\n              \"value\": \"application/json\"\r\n            }\r\n          ]\r\n        },\r\n        \"sendBody\": true,\r\n        \"bodyParameters\": {\r\n          \"parameters\": [\r\n            {\r\n              \"name\": \"flow_id\",\r\n              \"value\": \"={{ $json.body?.flow_id ?? $json.flow_id ?? '' }}\"\r\n            },\r\n            {\r\n              \"name\": \"message\",\r\n              \"value\": \"={{ '✅ plan_release complete — development plan ready in Nextcloud: /projects/' + $node['Webhook Trigger'].json.body.body.project + '-' + $node['Webhook Trigger'].json.body.body.version + '-' + ($node['Webhook Trigger'].json.body.body.revision ?? '1') + '.pdf' }}\"\r\n            },\r\n            {\r\n              \"name\": \"notes\",\r\n              \"value\": \"\"\r\n            }\r\n          ]\r\n        }\r\n      }\r\n    }\r\n  ],\r\n  \"connections\": {\r\n    \"Webhook Trigger\": {\r\n      \"main\": [\r\n        [\r\n          {\r\n            \"node\": \"Notify: Starting plan_release\",\r\n            \"type\": \"main\",\r\n            \"index\": 0\r\n          }\r\n        ]\r\n      ]\r\n    },\r\n    \"Notify: Starting plan_release\": {\r\n      \"main\": [\r\n        [\r\n          {\r\n            \"node\": \"Architect Input\",\r\n            \"type\": \"main\",\r\n            \"index\": 0\r\n          },\r\n          {\r\n            \"node\": \"DE Input\",\r\n            \"type\": \"main\",\r\n            \"index\": 0\r\n          }\r\n        ]\r\n      ]\r\n    },\r\n    \"Architect Input\": {\r\n      \"main\": [\r\n        [\r\n          {\r\n            \"node\": \"Architect Analysis\",\r\n            \"type\": \"main\",\r\n            \"index\": 0\r\n          }\r\n        ]\r\n      ]\r\n    },\r\n    \"DE Input\": {\r\n      \"main\": [\r\n        [\r\n          {\r\n            \"node\": \"DE Schema Impact\",\r\n            \"type\": \"main\",\r\n            \"index\": 0\r\n          }\r\n        ]\r\n      ]\r\n    },\r\n    \"Architect Analysis\": {\r\n      \"main\": [\r\n        [\r\n          {\r\n            \"node\": \"Merge Gate A\",\r\n            \"type\": \"main\",\r\n            \"index\": 0\r\n          }\r\n        ]\r\n      ]\r\n    },\r\n    \"DE Schema Impact\": {\r\n      \"main\": [\r\n        [\r\n          {\r\n            \"node\": \"Merge Gate A\",\r\n            \"type\": \"main\",\r\n            \"index\": 1\r\n          }\r\n        ]\r\n      ]\r\n    },\r\n    \"Merge Gate A\": {\r\n      \"main\": [\r\n        [\r\n          {\r\n            \"node\": \"Notify: Gate A done\",\r\n            \"type\": \"main\",\r\n            \"index\": 0\r\n          }\r\n        ]\r\n      ]\r\n    },\r\n    \"Notify: Gate A done\": {\r\n      \"main\": [\r\n        [\r\n          {\r\n            \"node\": \"QA Input\",\r\n            \"type\": \"main\",\r\n            \"index\": 0\r\n          },\r\n          {\r\n            \"node\": \"Security Input\",\r\n            \"type\": \"main\",\r\n            \"index\": 0\r\n          },\r\n          {\r\n            \"node\": \"UX Input\",\r\n            \"type\": \"main\",\r\n            \"index\": 0\r\n          }\r\n        ]\r\n      ]\r\n    },\r\n    \"QA Input\": {\r\n      \"main\": [\r\n        [\r\n          {\r\n            \"node\": \"QA Risk Assessment\",\r\n            \"type\": \"main\",\r\n            \"index\": 0\r\n          }\r\n        ]\r\n      ]\r\n    },\r\n    \"Security Input\": {\r\n      \"main\": [\r\n        [\r\n          {\r\n            \"node\": \"Security Threat Model\",\r\n            \"type\": \"main\",\r\n            \"index\": 0\r\n          }\r\n        ]\r\n      ]\r\n    },\r\n    \"UX Input\": {\r\n      \"main\": [\r\n        [\r\n          {\r\n            \"node\": \"UX Review\",\r\n            \"type\": \"main\",\r\n            \"index\": 0\r\n          }\r\n        ]\r\n      ]\r\n    },\r\n    \"QA Risk Assessment\": {\r\n      \"main\": [\r\n        [\r\n          {\r\n            \"node\": \"Merge Gate B\",\r\n            \"type\": \"main\",\r\n            \"index\": 0\r\n          }\r\n        ]\r\n      ]\r\n    },\r\n    \"Security Threat Model\": {\r\n      \"main\": [\r\n        [\r\n          {\r\n            \"node\": \"Merge Gate B\",\r\n            \"type\": \"main\",\r\n            \"index\": 1\r\n          }\r\n        ]\r\n      ]\r\n    },\r\n    \"UX Review\": {\r\n      \"main\": [\r\n        [\r\n          {\r\n            \"node\": \"Merge Gate B\",\r\n            \"type\": \"main\",\r\n            \"index\": 2\r\n          }\r\n        ]\r\n      ]\r\n    },\r\n    \"Merge Gate B\": {\r\n      \"main\": [\r\n        [\r\n          {\r\n            \"node\": \"Notify: Gate B done\",\r\n            \"type\": \"main\",\r\n            \"index\": 0\r\n          }\r\n        ]\r\n      ]\r\n    },\r\n    \"Notify: Gate B done\": {\r\n      \"main\": [\r\n        [\r\n          {\r\n            \"node\": \"PM Input\",\r\n            \"type\": \"main\",\r\n            \"index\": 0\r\n          }\r\n        ]\r\n      ]\r\n    },\r\n    \"PM Input\": {\r\n      \"main\": [\r\n        [\r\n          {\r\n            \"node\": \"PM PRD\",\r\n            \"type\": \"main\",\r\n            \"index\": 0\r\n          }\r\n        ]\r\n      ]\r\n    },\r\n    \"PM PRD\": {\r\n      \"main\": [\r\n        [\r\n          {\r\n            \"node\": \"TL Input (Estimate)\",\r\n            \"type\": \"main\",\r\n            \"index\": 0\r\n          }\r\n        ]\r\n      ]\r\n    },\r\n    \"TL Input (Estimate)\": {\r\n      \"main\": [\r\n        [\r\n          {\r\n            \"node\": \"TL Estimate\",\r\n            \"type\": \"main\",\r\n            \"index\": 0\r\n          }\r\n        ]\r\n      ]\r\n    },\r\n    \"TL Estimate\": {\r\n      \"main\": [\r\n        [\r\n          {\r\n            \"node\": \"PM Input (Compile)\",\r\n            \"type\": \"main\",\r\n            \"index\": 0\r\n          }\r\n        ]\r\n      ]\r\n    },\r\n    \"PM Input (Compile)\": {\r\n      \"main\": [\r\n        [\r\n          {\r\n            \"node\": \"PM: Compile Development Plan\",\r\n            \"type\": \"main\",\r\n            \"index\": 0\r\n          }\r\n        ]\r\n      ]\r\n    },\r\n    \"PM: Compile Development Plan\": {\r\n      \"main\": [\r\n        [\r\n          {\r\n            \"node\": \"Notify: plan_release complete\",\r\n            \"type\": \"main\",\r\n            \"index\": 0\r\n          }\r\n        ]\r\n      ]\r\n    }\r\n  },\r\n  \"active\": true,\r\n  \"tags\": [],\r\n  \"settings\": {\r\n    \"executionOrder\": \"v1\"\r\n  }\r\n}\r\n","F-02-kickoff.json":"{\r\n  \"name\": \"F-02 /kickoff\",\r\n  \"nodes\": [\r\n    {\r\n      \"id\": \"516ef61b-d041-49ae-824a-d528608d6980\",\r\n      \"name\": \"Webhook Trigger\",\r\n      \"type\": \"n8n-nodes-base.webhook\",\r\n      \"typeVersion\": 2,\r\n      \"position\": [\r\n        240,\r\n        300\r\n      ],\r\n      \"parameters\": {\r\n        \"path\": \"kickoff\",\r\n        \"httpMethod\": \"POST\",\r\n        \"responseMode\": \"onReceived\",\r\n        \"responseData\": \"allEntries\"\r\n      },\r\n      \"webhookId\": \"61ec943e-86b1-4118-b28b-fda8049c924d\"\r\n    },\r\n    {\r\n      \"id\": \"90948b75-fde9-49d4-8339-dbf4dd3edd4a\",\r\n      \"name\": \"Notify: Kickoff started\",\r\n      \"type\": \"n8n-nodes-base.httpRequest\",\r\n      \"typeVersion\": 4.2,\r\n      \"position\": [\r\n        680,\r\n        300\r\n      ],\r\n      \"parameters\": {\r\n        \"method\": \"POST\",\r\n        \"url\": \"={{ $env.OPENWEBUI_CALLBACK_URL }}\",\r\n        \"sendHeaders\": true,\r\n        \"headerParameters\": {\r\n          \"parameters\": [\r\n            {\r\n              \"name\": \"Content-Type\",\r\n              \"value\": \"application/json\"\r\n            }\r\n          ]\r\n        },\r\n        \"sendBody\": true,\r\n        \"bodyParameters\": {\r\n          \"parameters\": [\r\n            {\r\n              \"name\": \"flow_id\",\r\n              \"value\": \"={{ $json.body?.flow_id ?? $json.flow_id ?? '' }}\"\r\n            },\r\n            {\r\n              \"name\": \"message\",\r\n              \"value\": \"🚀 kickoff started — repo+project create -\u003e scaffold+wiki -\u003e PM stories -\u003e TL tasks -\u003e release branch -\u003e TL story/task branches, DevOps in parallel\"\r\n            },\r\n            {\r\n              \"name\": \"notes\",\r\n              \"value\": \"\"\r\n            }\r\n          ]\r\n        }\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"c1000001-0000-0000-0000-000000000001\",\r\n      \"name\": \"PM Project Input\",\r\n      \"type\": \"n8n-nodes-base.set\",\r\n      \"typeVersion\": 3.4,\r\n      \"position\": [\r\n        900,\r\n        60\r\n      ],\r\n      \"parameters\": {\r\n        \"mode\": \"manual\",\r\n        \"assignments\": {\r\n          \"assignments\": [\r\n            {\r\n              \"id\": \"1\",\r\n              \"name\": \"role\",\r\n              \"value\": \"pm\",\r\n              \"type\": \"string\"\r\n            },\r\n            {\r\n              \"id\": \"2\",\r\n              \"name\": \"prompt\",\r\n              \"value\": \"=Using glab (hostname gitlab-webservice-default.gitlab.svc.cluster.local), the GitLab group to use is {{ $node['Webhook Trigger'].json.body.body.group ?? 'sdlc' }} and the project to use is {{ $node['Webhook Trigger'].json.body.body.project ?? 'hr-portal' }} — if the chat command that triggered this specified a group/project name, use those exact names; otherwise default to 'sdlc'/'hr-portal' (the dry-run fixture — every real project should name both explicitly). Never hardcode 'sdlc' or 'hr-portal' below, always use these same two values. Ensure that GitLab group exists (create it if missing) and that project exists inside that group (create it if missing — do not treat an already-existing group or project as an error). Whether or not the group was just created, ensure the user with email edwardlimkoksiong1994@gmail.com is a member of that group with Owner access (look up their user id via `glab api users?search=edwardlimkoksiong1994@gmail.com`, then add/update membership via `glab api groups/\u003cgroup\u003e/members --method POST -f user_id=\u003cid\u003e -f access_level=50`, ignoring a 409/already-a-member response as success) — a group recreated after deletion has no members but root, so this must run every time, not just on first creation. Report the group and project names used, the project's full path, whether the group/project were newly created or already existed, and whether the membership add succeeded — and flag explicitly if this run is defaulting to sdlc/hr-portal so it's obvious a real project name was never given. Do NOT delete or rename the group or project for any reason, even if a prior run's project seems stale or misconfigured -- every step after this one in this SAME kickoff run computes the group/project path directly from this chat command's group/project fields (not from any static env var), so treat an existing group/project as success and move on; other flows (develop, uat, etc) also prefer their own chat/event input over the static env var fallback now, with the env var kept only as a last-resort default when no chat value is given.\",\r\n              \"type\": \"string\"\r\n            },\r\n            {\r\n              \"id\": \"3\",\r\n              \"name\": \"story\",\r\n              \"value\": \"={{ $node['Webhook Trigger'].json.body.body.project ?? 'hr-portal' }}\",\r\n              \"type\": \"string\"\r\n            }\r\n          ]\r\n        }\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"c1000001-0000-0000-0000-000000000002\",\r\n      \"name\": \"PM: Ensure Project Exists\",\r\n      \"type\": \"n8n-nodes-base.executeWorkflow\",\r\n      \"typeVersion\": 1.1,\r\n      \"position\": [\r\n        1080,\r\n        60\r\n      ],\r\n      \"parameters\": {\r\n        \"source\": \"database\",\r\n        \"workflowId\": {\r\n          \"mode\": \"id\",\r\n          \"value\": \"jAv16SAzGy9fA5G4\"\r\n        },\r\n        \"mode\": \"once\"\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"c1000001-0000-0000-0000-000000000003\",\r\n      \"name\": \"Ensure Kaneo Project\",\r\n      \"type\": \"n8n-nodes-base.code\",\r\n      \"typeVersion\": 2,\r\n      \"position\": [\r\n        1170,\r\n        60\r\n      ],\r\n      \"parameters\": {\r\n        \"jsCode\": \"// ponytail: mirrors the old Taiga project-creation step, adapted to\\n// Kaneo's workspace -\u003e project -\u003e task hierarchy (no epic/userstory/issue\\n// resources -- see AGENT.md's \\\"Kaneo\\\" section). One shared 'sdlc' workspace\\n// holds every generated project, same role the single Taiga instance played.\\nconst auth = { Authorization: `Bearer ${$env.KANEO_TOKEN}` };\\nconst projectName = $node['Webhook Trigger'].json.body.body.project ?? 'hr-portal';\\nconst slug = projectName.toString().toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');\\n\\n// ponytail: verify this exact path against the deployed Kaneo version --\\n// GET /api/workspace (list) is inferred from the confirmed GET /api/project\\n// naming convention, not confirmed from docs.\\nconst workspaces = await this.helpers.httpRequest({ method: 'GET', url: `${$env.KANEO_URL}/api/workspace`, headers: auth, json: true, ignoreHttpStatusErrors: true });\\nlet workspace = (Array.isArray(workspaces) ? workspaces : workspaces?.workspaces || []).find(w =\u003e w.slug === 'sdlc' || w.name === 'sdlc');\\nif (!workspace) {\\n  // ponytail: verify this exact path/body against the deployed Kaneo version.\\n  workspace = await this.helpers.httpRequest({ method: 'POST', url: `${$env.KANEO_URL}/api/workspace`, headers: auth, json: true, body: { name: 'sdlc', slug: 'sdlc' } });\\n}\\nconst workspaceId = workspace.id;\\n\\n// GET /api/project -- confirmed endpoint, lists projects in a workspace.\\nconst projects = await this.helpers.httpRequest({ method: 'GET', url: `${$env.KANEO_URL}/api/project`, headers: auth, json: true, qs: { workspaceId }, ignoreHttpStatusErrors: true });\\nconst existing = (Array.isArray(projects) ? projects : projects?.projects || []).find(p =\u003e p.slug === slug || p.name === projectName);\\nif (existing) {\\n  return [{ json: { kaneo_workspace_id: workspaceId, kaneo_project_id: existing.id, kaneo_project_slug: existing.slug, kaneo_project_created: false } }];\\n}\\n\\n// ponytail: verify this exact path/body against the deployed Kaneo version\\n// -- POST /api/project is inferred from the confirmed GET /api/project\\n// naming convention, not confirmed from docs.\\nconst created = await this.helpers.httpRequest({ method: 'POST', url: `${$env.KANEO_URL}/api/project`, headers: auth, json: true, body: { name: projectName, slug, workspaceId, description: `${projectName} \\\\u2014 created by /kickoff` } });\\nreturn [{ json: { kaneo_workspace_id: workspaceId, kaneo_project_id: created.id, kaneo_project_slug: created.slug, kaneo_project_created: true } }];\"\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"c1000001-0000-0000-0000-000000000004\",\r\n      \"name\": \"Add Role Members to Kaneo Project\",\r\n      \"type\": \"n8n-nodes-base.code\",\r\n      \"typeVersion\": 2,\r\n      \"position\": [\r\n        1220,\r\n        60\r\n      ],\r\n      \"parameters\": {\r\n        \"jsCode\": \"// ponytail: one dedicated Kaneo user per SDLC role (created once by\\n// helm/ansible/playbooks/role-accounts.yml, email sdlc-\u003crole\u003e@homelab.local)\\n// so tickets can be assigned to the role that did the work instead of the\\n// single shared admin identity. Kaneo membership is per-project -- same\\n// per-project-at-kickoff-time call the old Taiga membership step made.\\nconst auth = { Authorization: `Bearer ${$env.KANEO_TOKEN}` };\\nconst projectId = $json.kaneo_project_id;\\nconst sdlcRoles = ['backend-developer','data-engineer','devops-engineer','frontend-developer','product-owner','project-manager','qa-engineer','release-manager','security-engineer','solution-architect','tech-lead','uiux-designer'];\\n\\n// ponytail: verify this exact path against the deployed Kaneo version -- a\\n// plain user-listing endpoint isn't confirmed from docs, inferred from the\\n// same /api/\u003cresource\u003e convention as the confirmed project/task ones.\\nconst allUsers = await this.helpers.httpRequest({ method: 'GET', url: `${$env.KANEO_URL}/api/user`, headers: auth, json: true });\\nconst userList = Array.isArray(allUsers) ? allUsers : (allUsers?.users || []);\\n\\nconst added = [];\\nconst skipped = [];\\nfor (const roleName of sdlcRoles) {\\n  const email = `sdlc-${roleName}@homelab.local`;\\n  const user = userList.find(u =\u003e u.email === email);\\n  if (!user) { skipped.push(roleName); continue; }\\n  try {\\n    // ponytail: verify this exact path against the deployed Kaneo version\\n    // -- POST /api/project/\u003cid\u003e/members inferred from the confirmed\\n    // /api/project naming convention.\\n    await this.helpers.httpRequest({ method: 'POST', url: `${$env.KANEO_URL}/api/project/${projectId}/members`, headers: auth, json: true, body: { userId: user.id, role: 'member' } });\\n    added.push(roleName);\\n  } catch (e) {\\n    // already a member -- tolerate like the old Taiga 400-on-duplicate path\\n    added.push(roleName);\\n  }\\n}\\nif (skipped.length) {\\n  console.log(`Role accounts not found in Kaneo (run role-accounts.yml first): ${skipped.join(', ')}`);\\n}\\nreturn [{ json: { ...$json, role_members_added: added, role_members_skipped: skipped } }];\"\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"c1000002-0000-0000-0000-000000000001\",\r\n      \"name\": \"Architect Input (Scaffold)\",\r\n      \"type\": \"n8n-nodes-base.set\",\r\n      \"typeVersion\": 3.4,\r\n      \"position\": [\r\n        1260,\r\n        60\r\n      ],\r\n      \"parameters\": {\r\n        \"mode\": \"manual\",\r\n        \"assignments\": {\r\n          \"assignments\": [\r\n            {\r\n              \"id\": \"1\",\r\n              \"name\": \"role\",\r\n              \"value\": \"architect\",\r\n              \"type\": \"string\"\r\n            },\r\n            {\r\n              \"id\": \"2\",\r\n              \"name\": \"prompt\",\r\n              \"value\": \"=Fetch the architecture report plan_release already produced: `mc alias set local $MINIO_ENDPOINT $MINIO_ROOT_USER $MINIO_ROOT_PASSWORD \u003e/dev/null \u0026\u0026 mc cat local/release-reports/{{ $node['Webhook Trigger'].json.body.body.version }}/architecture.md`. The stack was already decided there during planning — use it exactly, do not re-decide it now. Check whether the workspace is already scaffolded: `glab api projects/{{ ($node['Webhook Trigger'].json.body.body.group ?? 'sdlc') + '%2F' + ($node['Webhook Trigger'].json.body.body.project ?? 'hr-portal') }}/repository/files/nx.json?ref=main` (a 404 means not scaffolded — GitLab auto-inits every new project with a README commit, so do not use commit count as the signal). If not scaffolded, scaffold that stack now and commit straight to `main` before anything else below, since release/story/task branches fork from `main` next. When the stack says NestJS, use the @nx/nest generator for the backend app (e.g. `nx g @nx/nest:app \u003cname\u003e`) — never @nx/express or raw Express, even though nx's own starter preset defaults there; use @nx/react for the frontend app. This GitLab instance runs GitLab CI, not GitHub Actions — add a .gitlab-ci.yml at the repo root (an nx-affected lint/test/typecheck/build pipeline is enough) and delete .github/workflows. create-nx-workspace also writes agent-skill/config directories for several coding tools we do not use — delete .codex, .cursor, .gemini, .github/agents, .github/prompts, .github/skills, .opencode, .vscode, keeping ONLY .agents and .claude. Use bun, not npm/npx, for every install and script-run step everywhere below (bun install, bunx nx, bun publish — never npm ci, npx nx, or npm publish). Add CI docker-build + npm-registry wiring: (1) a Dockerfile per deployable app (apps/api, apps/shop, etc — multi-stage build: build stage FROM oven/bun:1 running bun install --frozen-lockfile + bunx nx build/prune, runtime stage also FROM oven/bun:1 running bun install --production against the pruned package.json since `nx prune` does not emit an npm-shaped lockfile bun's `npm ci` equivalent needs) so .gitlab-ci.yml can build+push images; (2) a root .npmrc pointing the workspace scope at this GitLab instance's npm registry (in-cluster API host http://gitlab-webservice-default.gitlab.svc.cluster.local:8181/api/v4/projects/${CI_PROJECT_ID}/packages/npm/, auth via ${CI_JOB_TOKEN} — do NOT use $CI_API_V4_URL/$CI_SERVER_HOST, they resolve to the external tailnet hostname which pods cannot reach); (3) extend .gitlab-ci.yml with a build stage running docker build (this GitLab runner is privileged with docker:dind already wired, kaniko is deprecated — do not use it) against the in-cluster registry host harbor.harbor.svc.cluster.local:80 (the :80 must be explicit — docker's registry client assumes https/443 for a bare hostname and this is plain http; a separate Harbor instance, not GitLab's own registry — no $CI_REGISTRY_* auto-vars apply here). The docker:24-dind SERVICE also needs telling it is plain-http, independent of the :80 port -- give it its own daemon flag: `services: - name: docker:24-dind` with `command: [\\\"--insecure-registry=harbor.harbor.svc.cluster.local:80\\\"]`, or dockerd inside that service still assumes TLS and `docker login`/`push` fail with \\\"server gave HTTP response to HTTPS client\\\" even though the port is explicit. Use `docker login ... --password-stdin` (echo the password into it), never `-p $VAR` (insecure-CLI-arg warning), authenticating with $HARBOR_USER/$HARBOR_PASSWORD (group-level CI/CD variables set on the sdlc group, inherited automatically by every project — not GitLab-provided), tagging images harbor.harbor.svc.cluster.local:80/library/{{ ($node['Webhook Trigger'].json.body.body.group ?? 'sdlc') + '/' + ($node['Webhook Trigger'].json.body.body.project ?? 'hr-portal') }}/\u003capp\u003e:${CI_COMMIT_SHORT_SHA}, only on main/release branches; and a publish stage that runs bun publish for packages under packages/* using the .npmrc above, only on main/release branches. The install job should rely on the pipeline cache (keyed on bun.lock) to hand node_modules to later jobs, NOT an `artifacts:` upload of node_modules/ -- a full node_modules tree as a job artifact is large enough to trip GitLab's request-size limit (413) on upload. Once scaffolding is confirmed (new or pre-existing), publish the fetched architecture report as a GitLab wiki page for this release (wiki now lives on GitLab's own per-project wiki module, not Taiga -- Taiga has been fully removed, see AGENT.md's \\\"Kaneo\\\" section): check whether the page {{ $node['Webhook Trigger'].json.body.body.version }}/Architecture already exists via `glab api projects/{{ ($node['Webhook Trigger'].json.body.body.group ?? 'sdlc') + '%2F' + ($node['Webhook Trigger'].json.body.body.project ?? 'hr-portal') }}/wikis/{{ $node['Webhook Trigger'].json.body.body.version }}%2FArchitecture --hostname gitlab-webservice-default.gitlab.svc.cluster.local` (a 404 means it doesn't exist yet); if it doesn't exist, create it via `glab api projects/{{ ($node['Webhook Trigger'].json.body.body.group ?? 'sdlc') + '%2F' + ($node['Webhook Trigger'].json.body.body.project ?? 'hr-portal') }}/wikis --method POST -f title=\\\"{{ $node['Webhook Trigger'].json.body.body.version }}/Architecture\\\" -f format=markdown -F content=@\u003cfile\u003e --hostname gitlab-webservice-default.gitlab.svc.cluster.local` (note -F, not -f, for content -- it substitutes the file's actual content, not a literal string); if it exists, update it instead via `glab api projects/{{ ($node['Webhook Trigger'].json.body.body.group ?? 'sdlc') + '%2F' + ($node['Webhook Trigger'].json.body.body.project ?? 'hr-portal') }}/wikis/{{ $node['Webhook Trigger'].json.body.body.version }}%2FArchitecture --method PUT -f format=markdown -F content=@\u003cfile\u003e --hostname gitlab-webservice-default.gitlab.svc.cluster.local`. Then list every per-service architecture file plan_release uploaded (`mc ls local/release-reports/{{ $node['Webhook Trigger'].json.body.body.version }}/ | grep -oE \\\"architecture-[a-z0-9-]+\\\\.md\\\"`) — for EACH one found, fetch it (`mc cat local/release-reports/{{ $node['Webhook Trigger'].json.body.body.version }}/architecture-\u003cslug\u003e.md`) and publish it as its OWN wiki page, one page per service, never combined into the overall Architecture page, using the slug {{ $node['Webhook Trigger'].json.body.body.version }}/Architecture/\u003cservice name\u003e (GitLab wiki slugs keep '/' as a literal hierarchy separator -- percent-encode every '/' as %2F in the URL path, e.g. `{{ $node['Webhook Trigger'].json.body.body.version }}%2FArchitecture%2F\u003cservice name\u003e`), same check-then-create-or-update shape as above. Derive \u003cservice name\u003e from the filename slug (hyphens back to spaces, title case) unless the file's own H1 heading already names the service -- prefer that. Report whether the workspace was newly scaffolded or already existed, and confirm the overall Architecture wiki page plus every per-service wiki page was created/updated.\",\r\n              \"type\": \"string\"\r\n            },\r\n            {\r\n              \"id\": \"3\",\r\n              \"name\": \"story\",\r\n              \"value\": \"={{ $node['Webhook Trigger'].json.body.body.version }}\",\r\n              \"type\": \"string\"\r\n            },\r\n            {\r\n              \"id\": \"4\",\r\n              \"name\": \"kaneo_project_id\",\r\n              \"value\": \"={{ $node['Ensure Kaneo Project'].json.kaneo_project_id }}\",\r\n              \"type\": \"string\"\r\n            }\r\n          ]\r\n        }\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"c1000002-0000-0000-0000-000000000002\",\r\n      \"name\": \"Architect: Scaffold Repo\",\r\n      \"type\": \"n8n-nodes-base.executeWorkflow\",\r\n      \"typeVersion\": 1.1,\r\n      \"position\": [\r\n        1260,\r\n        200\r\n      ],\r\n      \"parameters\": {\r\n        \"source\": \"database\",\r\n        \"workflowId\": {\r\n          \"mode\": \"id\",\r\n          \"value\": \"jAv16SAzGy9fA5G4\"\r\n        },\r\n        \"mode\": \"once\"\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"b2000001-0000-0000-0000-000000000002\",\r\n      \"name\": \"PM Input\",\r\n      \"type\": \"n8n-nodes-base.set\",\r\n      \"typeVersion\": 3.4,\r\n      \"position\": [\r\n        900,\r\n        200\r\n      ],\r\n      \"parameters\": {\r\n        \"mode\": \"manual\",\r\n        \"assignments\": {\r\n          \"assignments\": [\r\n            {\r\n              \"id\": \"1\",\r\n              \"name\": \"role\",\r\n              \"value\": \"pm\",\r\n              \"type\": \"string\"\r\n            },\r\n            {\r\n              \"id\": \"2\",\r\n              \"name\": \"prompt\",\r\n              \"value\": \"=First publish the PRD plan_release produced: `mc alias set local $MINIO_ENDPOINT $MINIO_ROOT_USER $MINIO_ROOT_PASSWORD \u003e/dev/null \u0026\u0026 mc cat local/release-reports/{{ $node['Webhook Trigger'].json.body.body.version }}/prd.md`, then publish it as a GitLab wiki page for this release (wiki lives on GitLab's own per-project wiki module now, not Taiga -- Taiga has been fully removed, see AGENT.md's \\\"Kaneo\\\" section): check whether the page {{ $node['Webhook Trigger'].json.body.body.version }}/PRD already exists via `glab api projects/{{ ($node['Webhook Trigger'].json.body.body.group ?? 'sdlc') + '%2F' + ($node['Webhook Trigger'].json.body.body.project ?? 'hr-portal') }}/wikis/{{ $node['Webhook Trigger'].json.body.body.version }}%2FPRD --hostname gitlab-webservice-default.gitlab.svc.cluster.local` (a 404 means it doesn't exist yet); if it doesn't exist, create it via `glab api projects/{{ ($node['Webhook Trigger'].json.body.body.group ?? 'sdlc') + '%2F' + ($node['Webhook Trigger'].json.body.body.project ?? 'hr-portal') }}/wikis --method POST -f title=\\\"{{ $node['Webhook Trigger'].json.body.body.version }}/PRD\\\" -f format=markdown -F content=@\u003cfile\u003e --hostname gitlab-webservice-default.gitlab.svc.cluster.local` (note -F, not -f, for content); if it exists, update it instead via `glab api projects/{{ ($node['Webhook Trigger'].json.body.body.group ?? 'sdlc') + '%2F' + ($node['Webhook Trigger'].json.body.body.project ?? 'hr-portal') }}/wikis/{{ $node['Webhook Trigger'].json.body.body.version }}%2FPRD --method PUT -f format=markdown -F content=@\u003cfile\u003e --hostname gitlab-webservice-default.gitlab.svc.cluster.local`. Also create a GitLab milestone for this release via glab (this GitLab is Community Edition -- it has no Epics, do not attempt to create one; Kaneo, the ticket tracker, has no epic resource either -- see AGENT.md's \\\"Kaneo\\\" section -- so this milestone plus each story/task's own release-version label below is the only release-wide grouping needed). Then fetch the PRD back from the GitLab wiki page just published (`glab api projects/{{ ($node['Webhook Trigger'].json.body.body.group ?? 'sdlc') + '%2F' + ($node['Webhook Trigger'].json.body.body.project ?? 'hr-portal') }}/wikis/{{ $node['Webhook Trigger'].json.body.body.version }}%2FPRD --hostname gitlab-webservice-default.gitlab.svc.cluster.local`) and take its executive summary as context. Resolve the project-manager role account's Kaneo user id once (`GET $KANEO_URL/api/user` with bearer `$KANEO_TOKEN`, filter for email \\\"sdlc-project-manager@homelab.local\\\" -- // ponytail: verify this exact user-listing path against the deployed Kaneo version -- stories are owned by the project-manager role account, not whichever identity's token happens to be making the API call). Then create ONE Kaneo task per user story derived from the PRD, directly under the project -- Kaneo has no separate epic/userstory resource (see AGENT.md's \\\"Kaneo\\\" section: workspace -\u003e project -\u003e task only), so every PRD-derived story is simply a top-level Kaneo task, tagged with a label so later steps can tell it apart from the role-feature tasks Tech Lead attaches underneath it. Create each via `POST $KANEO_URL/api/task` (// ponytail: verify this exact path/body against the deployed Kaneo version -- inferred from the confirmed `GET /api/task/tasks/\u003cprojectId\u003e` naming) with `{\\\"projectId\\\": \\\"$KANEO_PROJECT_ID\\\", \\\"title\\\": \\\"...\\\", \\\"assigneeId\\\": \u003cpm user id\u003e, \\\"status\\\": \\\"Pending\\\", \\\"description\\\": \\\"## Goal\\\\n{goal derived from the PRD}\\\\n\\\\n## Acceptance Criteria\\\\n- [ ] ...\\\\n\\\\n## Dependencies\\\\n{any cross-story dependency, or \\\\\\\"None\\\\\\\"}\\\"}` (bearer `$KANEO_TOKEN`) -- every story task MUST have a real `description` (not a placeholder), never orphaned. Kaneo's `status` is a plain string, not an id to resolve (confirmed from other flows' use of literal values like \\\"in-progress\\\") -- just set it directly. Report every created story task's id, title, and assignee -- the next step needs these ids to attach child tasks, and Release Manager needs them later to reference in the release notes.\",\r\n              \"type\": \"string\"\r\n            },\r\n            {\r\n              \"id\": \"3\",\r\n              \"name\": \"story\",\r\n              \"value\": \"={{ $node['Webhook Trigger'].json.body.body.version }}\",\r\n              \"type\": \"string\"\r\n            },\r\n            {\r\n              \"id\": \"4\",\r\n              \"name\": \"kaneo_project_id\",\r\n              \"value\": \"={{ $node['Ensure Kaneo Project'].json.kaneo_project_id }}\",\r\n              \"type\": \"string\"\r\n            },\r\n            {\r\n              \"id\": \"5\",\r\n              \"name\": \"kaneo_workspace_id\",\r\n              \"value\": \"={{ $node['Ensure Kaneo Project'].json.kaneo_workspace_id }}\",\r\n              \"type\": \"string\"\r\n            }\r\n          ]\r\n        }\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"e1dc6899-3754-4706-ade7-ae3a5bc076ac\",\r\n      \"name\": \"PM: Create Story Work Items\",\r\n      \"type\": \"n8n-nodes-base.executeWorkflow\",\r\n      \"typeVersion\": 1.1,\r\n      \"position\": [\r\n        1120,\r\n        200\r\n      ],\r\n      \"parameters\": {\r\n        \"source\": \"database\",\r\n        \"workflowId\": {\r\n          \"mode\": \"id\",\r\n          \"value\": \"jAv16SAzGy9fA5G4\"\r\n        },\r\n        \"mode\": \"once\"\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"b2000002-0000-0000-0000-000000000001\",\r\n      \"name\": \"QA Tickets Input\",\r\n      \"type\": \"n8n-nodes-base.set\",\r\n      \"typeVersion\": 3.4,\r\n      \"position\": [\r\n        1320,\r\n        40\r\n      ],\r\n      \"parameters\": {\r\n        \"mode\": \"manual\",\r\n        \"assignments\": {\r\n          \"assignments\": [\r\n            {\r\n              \"id\": \"1\",\r\n              \"name\": \"role\",\r\n              \"value\": \"qa-engineer\",\r\n              \"type\": \"string\"\r\n            },\r\n            {\r\n              \"id\": \"2\",\r\n              \"name\": \"prompt\",\r\n              \"value\": \"=Query the Kaneo tasks tagged `story` for {{ $node['Webhook Trigger'].json.body.body.version }} (from the previous step's output, or re-query via `GET $KANEO_URL/api/task/tasks/$KANEO_PROJECT_ID` with bearer `$KANEO_TOKEN` and filter client-side for a `{{ $node['Webhook Trigger'].json.body.body.version }}` label and a `story` label if needed -- Kaneo has no server-side label-filter query param confirmed). Resolve the qa-engineer role account's Kaneo user id once (`GET $KANEO_URL/api/user` with bearer `$KANEO_TOKEN`, filter for email \\\"sdlc-qa-engineer@homelab.local\\\" -- // ponytail: verify this exact user-listing path against the deployed Kaneo version). For each story, if a QA ticket doesn't exist yet (check its `qa` label), create one via `POST $KANEO_URL/api/task`: `{\\\"projectId\\\": \\\"$KANEO_PROJECT_ID\\\", \\\"title\\\": \\\"[qa] {story short description} — test plan\\\", \\\"description\\\": \\\"{the concrete test scenarios this plan covers, 2-4 sentences}\\\", \\\"assigneeId\\\": \\\"\u003cqa-engineer id\u003e\\\", \\\"status\\\": \\\"Pending\\\"}` (bearer `$KANEO_TOKEN`), then attach the \\\"{{ $node['Webhook Trigger'].json.body.body.version }}\\\" and \\\"qa\\\" labels to it. Kaneo has no \\\"labels\\\" field on task creation at all (confirmed) -- labels are a separate resource: resolve-or-create each one via `GET $KANEO_URL/api/label/workspace/$KANEO_WORKSPACE_ID` (filter by name) then `POST $KANEO_URL/api/label` with `{\\\"name\\\": \\\"\u003clabel\u003e\\\", \\\"color\\\": \\\"#888888\\\", \\\"workspaceId\\\": \\\"$KANEO_WORKSPACE_ID\\\", \\\"taskId\\\": \\\"\u003cnew task id\u003e\\\"}` if it does not exist yet (creating with taskId attaches it in the same call), or `PUT $KANEO_URL/api/label/\u003cid\u003e/task` with `{\\\"taskId\\\": \\\"\u003cnew task id\u003e\\\"}` if it already does -- never blind-POST a label that might already exist. -- every ticket MUST have a real description, never title-only. Then immediately link it to its story with `POST $KANEO_URL/api/task-relation`: `{\\\"sourceTaskId\\\": \\\"\u003cnew ticket id\u003e\\\", \\\"targetTaskId\\\": \\\"\u003cstory id\u003e\\\", \\\"relationType\\\": \\\"subtask\\\"}` (bearer `$KANEO_TOKEN` -- Kaneo confirmed parent-link mechanism). Report every QA ticket created and its parent story.\",\r\n              \"type\": \"string\"\r\n            },\r\n            {\r\n              \"id\": \"3\",\r\n              \"name\": \"story\",\r\n              \"value\": \"={{ $node['Webhook Trigger'].json.body.body.version }}\",\r\n              \"type\": \"string\"\r\n            },\r\n            {\r\n              \"id\": \"4\",\r\n              \"name\": \"kaneo_project_id\",\r\n              \"value\": \"={{ $node['Ensure Kaneo Project'].json.kaneo_project_id }}\",\r\n              \"type\": \"string\"\r\n            },\r\n            {\r\n              \"id\": \"5\",\r\n              \"name\": \"kaneo_workspace_id\",\r\n              \"value\": \"={{ $node['Ensure Kaneo Project'].json.kaneo_workspace_id }}\",\r\n              \"type\": \"string\"\r\n            }\r\n          ]\r\n        }\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"b2000002-0000-0000-0000-000000000002\",\r\n      \"name\": \"QA: Create QA Tickets\",\r\n      \"type\": \"n8n-nodes-base.executeWorkflow\",\r\n      \"typeVersion\": 1.1,\r\n      \"position\": [\r\n        1500,\r\n        40\r\n      ],\r\n      \"parameters\": {\r\n        \"source\": \"database\",\r\n        \"workflowId\": {\r\n          \"mode\": \"id\",\r\n          \"value\": \"jAv16SAzGy9fA5G4\"\r\n        },\r\n        \"mode\": \"once\"\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"b2000003-0000-0000-0000-000000000001\",\r\n      \"name\": \"Security Tickets Input\",\r\n      \"type\": \"n8n-nodes-base.set\",\r\n      \"typeVersion\": 3.4,\r\n      \"position\": [\r\n        1320,\r\n        120\r\n      ],\r\n      \"parameters\": {\r\n        \"mode\": \"manual\",\r\n        \"assignments\": {\r\n          \"assignments\": [\r\n            {\r\n              \"id\": \"1\",\r\n              \"name\": \"role\",\r\n              \"value\": \"security-engineer\",\r\n              \"type\": \"string\"\r\n            },\r\n            {\r\n              \"id\": \"2\",\r\n              \"name\": \"prompt\",\r\n              \"value\": \"=Query the Kaneo tasks tagged `story` for {{ $node['Webhook Trigger'].json.body.body.version }} (from the previous step's output, or re-query via `GET $KANEO_URL/api/task/tasks/$KANEO_PROJECT_ID` with bearer `$KANEO_TOKEN` and filter client-side for a `{{ $node['Webhook Trigger'].json.body.body.version }}` label and a `story` label if needed -- Kaneo has no server-side label-filter query param confirmed). Resolve the security-engineer role account's Kaneo user id once (`GET $KANEO_URL/api/user` with bearer `$KANEO_TOKEN`, filter for email \\\"sdlc-security-engineer@homelab.local\\\" -- // ponytail: verify this exact user-listing path against the deployed Kaneo version). For each story, if a Security ticket doesn't exist yet (check its `security` label), create one via `POST $KANEO_URL/api/task`: `{\\\"projectId\\\": \\\"$KANEO_PROJECT_ID\\\", \\\"title\\\": \\\"[security] {story short description} — threat model\\\", \\\"description\\\": \\\"{the concrete threats/attack surface this model covers, 2-4 sentences}\\\", \\\"assigneeId\\\": \\\"\u003csecurity-engineer id\u003e\\\", \\\"status\\\": \\\"Pending\\\"}` (bearer `$KANEO_TOKEN`), then attach the \\\"{{ $node['Webhook Trigger'].json.body.body.version }}\\\" and \\\"security\\\" labels to it. Kaneo has no \\\"labels\\\" field on task creation at all (confirmed) -- labels are a separate resource: resolve-or-create each one via `GET $KANEO_URL/api/label/workspace/$KANEO_WORKSPACE_ID` (filter by name) then `POST $KANEO_URL/api/label` with `{\\\"name\\\": \\\"\u003clabel\u003e\\\", \\\"color\\\": \\\"#888888\\\", \\\"workspaceId\\\": \\\"$KANEO_WORKSPACE_ID\\\", \\\"taskId\\\": \\\"\u003cnew task id\u003e\\\"}` if it does not exist yet (creating with taskId attaches it in the same call), or `PUT $KANEO_URL/api/label/\u003cid\u003e/task` with `{\\\"taskId\\\": \\\"\u003cnew task id\u003e\\\"}` if it already does -- never blind-POST a label that might already exist. -- every ticket MUST have a real description, never title-only. Then immediately link it to its story with `POST $KANEO_URL/api/task-relation`: `{\\\"sourceTaskId\\\": \\\"\u003cnew ticket id\u003e\\\", \\\"targetTaskId\\\": \\\"\u003cstory id\u003e\\\", \\\"relationType\\\": \\\"subtask\\\"}` (bearer `$KANEO_TOKEN` -- Kaneo confirmed parent-link mechanism). Report every security ticket created and its parent story.\",\r\n              \"type\": \"string\"\r\n            },\r\n            {\r\n              \"id\": \"3\",\r\n              \"name\": \"story\",\r\n              \"value\": \"={{ $node['Webhook Trigger'].json.body.body.version }}\",\r\n              \"type\": \"string\"\r\n            },\r\n            {\r\n              \"id\": \"4\",\r\n              \"name\": \"kaneo_project_id\",\r\n              \"value\": \"={{ $node['Ensure Kaneo Project'].json.kaneo_project_id }}\",\r\n              \"type\": \"string\"\r\n            },\r\n            {\r\n              \"id\": \"5\",\r\n              \"name\": \"kaneo_workspace_id\",\r\n              \"value\": \"={{ $node['Ensure Kaneo Project'].json.kaneo_workspace_id }}\",\r\n              \"type\": \"string\"\r\n            }\r\n          ]\r\n        }\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"b2000003-0000-0000-0000-000000000002\",\r\n      \"name\": \"Security: Create Security Tickets\",\r\n      \"type\": \"n8n-nodes-base.executeWorkflow\",\r\n      \"typeVersion\": 1.1,\r\n      \"position\": [\r\n        1500,\r\n        120\r\n      ],\r\n      \"parameters\": {\r\n        \"source\": \"database\",\r\n        \"workflowId\": {\r\n          \"mode\": \"id\",\r\n          \"value\": \"jAv16SAzGy9fA5G4\"\r\n        },\r\n        \"mode\": \"once\"\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"b2000004-0000-0000-0000-000000000001\",\r\n      \"name\": \"DevOps Tickets Input\",\r\n      \"type\": \"n8n-nodes-base.set\",\r\n      \"typeVersion\": 3.4,\r\n      \"position\": [\r\n        1320,\r\n        280\r\n      ],\r\n      \"parameters\": {\r\n        \"mode\": \"manual\",\r\n        \"assignments\": {\r\n          \"assignments\": [\r\n            {\r\n              \"id\": \"1\",\r\n              \"name\": \"role\",\r\n              \"value\": \"devops-engineer\",\r\n              \"type\": \"string\"\r\n            },\r\n            {\r\n              \"id\": \"2\",\r\n              \"name\": \"prompt\",\r\n              \"value\": \"=Query the Kaneo tasks tagged `story` for {{ $node['Webhook Trigger'].json.body.body.version }} (from the previous step's output, or re-query via `GET $KANEO_URL/api/task/tasks/$KANEO_PROJECT_ID` with bearer `$KANEO_TOKEN` and filter client-side for a `{{ $node['Webhook Trigger'].json.body.body.version }}` label and a `story` label if needed -- Kaneo has no server-side label-filter query param confirmed). Resolve the devops-engineer role account's Kaneo user id once (`GET $KANEO_URL/api/user` with bearer `$KANEO_TOKEN`, filter for email \\\"sdlc-devops-engineer@homelab.local\\\" -- // ponytail: verify this exact user-listing path against the deployed Kaneo version). For each story, if a DevOps ticket doesn't exist yet (check its `devops` label), create one via `POST $KANEO_URL/api/task`: `{\\\"projectId\\\": \\\"$KANEO_PROJECT_ID\\\", \\\"title\\\": \\\"[devops] {story short description} — infra checklist\\\", \\\"description\\\": \\\"{the concrete infra items this story needs beyond what kickoff already provisioned, or \\\\\\\"None beyond standard provisioning\\\\\\\"}\\\", \\\"assigneeId\\\": \\\"\u003cdevops-engineer id\u003e\\\", \\\"status\\\": \\\"Pending\\\"}` (bearer `$KANEO_TOKEN`), then attach the \\\"{{ $node['Webhook Trigger'].json.body.body.version }}\\\" and \\\"devops\\\" labels to it. Kaneo has no \\\"labels\\\" field on task creation at all (confirmed) -- labels are a separate resource: resolve-or-create each one via `GET $KANEO_URL/api/label/workspace/$KANEO_WORKSPACE_ID` (filter by name) then `POST $KANEO_URL/api/label` with `{\\\"name\\\": \\\"\u003clabel\u003e\\\", \\\"color\\\": \\\"#888888\\\", \\\"workspaceId\\\": \\\"$KANEO_WORKSPACE_ID\\\", \\\"taskId\\\": \\\"\u003cnew task id\u003e\\\"}` if it does not exist yet (creating with taskId attaches it in the same call), or `PUT $KANEO_URL/api/label/\u003cid\u003e/task` with `{\\\"taskId\\\": \\\"\u003cnew task id\u003e\\\"}` if it already does -- never blind-POST a label that might already exist. -- every ticket MUST have a real description, never title-only. Then immediately link it to its story with `POST $KANEO_URL/api/task-relation`: `{\\\"sourceTaskId\\\": \\\"\u003cnew ticket id\u003e\\\", \\\"targetTaskId\\\": \\\"\u003cstory id\u003e\\\", \\\"relationType\\\": \\\"subtask\\\"}` (bearer `$KANEO_TOKEN` -- Kaneo confirmed parent-link mechanism). Report every DevOps ticket created and its parent story.\",\r\n              \"type\": \"string\"\r\n            },\r\n            {\r\n              \"id\": \"3\",\r\n              \"name\": \"story\",\r\n              \"value\": \"={{ $node['Webhook Trigger'].json.body.body.version }}\",\r\n              \"type\": \"string\"\r\n            },\r\n            {\r\n              \"id\": \"4\",\r\n              \"name\": \"kaneo_project_id\",\r\n              \"value\": \"={{ $node['Ensure Kaneo Project'].json.kaneo_project_id }}\",\r\n              \"type\": \"string\"\r\n            },\r\n            {\r\n              \"id\": \"5\",\r\n              \"name\": \"kaneo_workspace_id\",\r\n              \"value\": \"={{ $node['Ensure Kaneo Project'].json.kaneo_workspace_id }}\",\r\n              \"type\": \"string\"\r\n            }\r\n          ]\r\n        }\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"b2000004-0000-0000-0000-000000000002\",\r\n      \"name\": \"DevOps: Create DevOps Tickets\",\r\n      \"type\": \"n8n-nodes-base.executeWorkflow\",\r\n      \"typeVersion\": 1.1,\r\n      \"position\": [\r\n        1500,\r\n        280\r\n      ],\r\n      \"parameters\": {\r\n        \"source\": \"database\",\r\n        \"workflowId\": {\r\n          \"mode\": \"id\",\r\n          \"value\": \"jAv16SAzGy9fA5G4\"\r\n        },\r\n        \"mode\": \"once\"\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"b2000001-0000-0000-0000-000000000001\",\r\n      \"name\": \"TL Input (Tasks)\",\r\n      \"type\": \"n8n-nodes-base.set\",\r\n      \"typeVersion\": 3.4,\r\n      \"position\": [\r\n        1340,\r\n        200\r\n      ],\r\n      \"parameters\": {\r\n        \"mode\": \"manual\",\r\n        \"assignments\": {\r\n          \"assignments\": [\r\n            {\r\n              \"id\": \"1\",\r\n              \"name\": \"role\",\r\n              \"value\": \"tech-lead\",\r\n              \"type\": \"string\"\r\n            },\r\n            {\r\n              \"id\": \"2\",\r\n              \"name\": \"prompt\",\r\n              \"value\": \"First publish the effort estimate plan_release produced: `mc alias set local $MINIO_ENDPOINT $MINIO_ROOT_USER $MINIO_ROOT_PASSWORD \u003e/dev/null \u0026\u0026 mc cat local/release-reports/{{ $node['Webhook Trigger'].json.body.body.version }}/estimate.md`, then publish it as a GitLab wiki page for this release (wiki lives on GitLab's own per-project wiki module now, not Taiga -- Taiga has been fully removed, see AGENT.md's \\\"Kaneo\\\" section): check whether the page {{ $node['Webhook Trigger'].json.body.body.version }}/Estimate already exists via `glab api projects/{{ ($node['Webhook Trigger'].json.body.body.group ?? 'sdlc') + '%2F' + ($node['Webhook Trigger'].json.body.body.project ?? 'hr-portal') }}/wikis/{{ $node['Webhook Trigger'].json.body.body.version }}%2FEstimate --hostname gitlab-webservice-default.gitlab.svc.cluster.local` (a 404 means it doesn't exist yet); if it doesn't exist, create it via `glab api projects/{{ ($node['Webhook Trigger'].json.body.body.group ?? 'sdlc') + '%2F' + ($node['Webhook Trigger'].json.body.body.project ?? 'hr-portal') }}/wikis --method POST -f title=\\\"{{ $node['Webhook Trigger'].json.body.body.version }}/Estimate\\\" -f format=markdown -F content=@\u003cfile\u003e --hostname gitlab-webservice-default.gitlab.svc.cluster.local` (note -F, not -f, for content); if it exists, update it instead via `glab api projects/{{ ($node['Webhook Trigger'].json.body.body.group ?? 'sdlc') + '%2F' + ($node['Webhook Trigger'].json.body.body.project ?? 'hr-portal') }}/wikis/{{ $node['Webhook Trigger'].json.body.body.version }}%2FEstimate --method PUT -f format=markdown -F content=@\u003cfile\u003e --hostname gitlab-webservice-default.gitlab.svc.cluster.local`. Then confirm the story tasks from the previous step actually exist by querying `GET $KANEO_URL/api/task/tasks/$KANEO_PROJECT_ID` (bearer `$KANEO_TOKEN`) and filtering client-side for a `{{ $node['Webhook Trigger'].json.body.body.version }}` label and a `story` label (do not assume the previous step's report was accurate -- verify against Kaneo directly). If no story tasks exist yet, create them yourself first the same way PM's step does (`POST $KANEO_URL/api/task` with `{\\\"projectId\\\": \\\"$KANEO_PROJECT_ID\\\", ...}`, then attach the \\\"{{ $node['Webhook Trigger'].json.body.body.version }}\\\" and \\\"story\\\" labels the same way PM's step does) before proceeding. Resolve the backend-developer and frontend-developer role accounts' Kaneo user ids once (`GET $KANEO_URL/api/user` with bearer `$KANEO_TOKEN`, filter for email \\\"sdlc-backend-developer@homelab.local\\\" and \\\"sdlc-frontend-developer@homelab.local\\\" -- each role has its own dedicated Kaneo account, created by `helm/ansible/playbooks/role-accounts.yml`; // ponytail: verify this exact user-listing path against the deployed Kaneo version). Then, for EACH story task, break it into role-feature task tickets -- NOT one generic task per story. Identify the distinct backend/frontend/api features the story touches (e.g. a login story might be 'frontend: login page' + 'backend: login mechanism' + 'api: login endpoint contract'); create one Kaneo task per role-feature pair via `POST $KANEO_URL/api/task` with `{\\\"projectId\\\": \\\"$KANEO_PROJECT_ID\\\", \\\"title\\\": \\\"[{role}] {feature — short description}\\\", \\\"description\\\": \\\"{what this task covers and its concrete done-condition, 2-4 sentences — not a restatement of the title}\\\", \\\"assigneeId\\\": \u003cbackend-developer's id for [backend]/[api] tasks, frontend-developer's id for [frontend] tasks — api tasks fall under backend-developer, there is no separate api role account\u003e, \\\"status\\\": \\\"Pending\\\", \\\"labels\\\": [\\\"{{ $node['Webhook Trigger'].json.body.body.version }}\\\", }` (bearer `$KANEO_TOKEN`) -- every task MUST have a real `description` and the correct role's `assigneeId` set, never orphaned and never defaulted to your own identity; then immediately link each new task to its story with `POST $KANEO_URL/api/task-relation`: `{\\\"sourceTaskId\\\": \\\"\u003cnew task id\u003e\\\", \\\"targetTaskId\\\": \\\"\u003cstory task id\u003e\\\", \\\"relationType\\\": \\\"subtask\\\"}` (bearer `$KANEO_TOKEN` -- Kaneo confirmed parent-link mechanism, see AGENT.md's \\\"Kaneo\\\" section). Skip any role the story genuinely doesn't touch (a pure backend migration gets no frontend task). Role lives in the title prefix ('[backend]'/'[frontend]'/'[api]') only -- there is no separate role field or label. Do not create qa/security/devops task tickets -- those roles self-create their own tickets from the story directly (see qa-engineer/security-engineer/devops-engineer SKILL.md), not Tech Lead's job. Report every created task's id, title, role, and its parent story task's id -- the branch-creation step later needs these.\",\r\n              \"type\": \"string\"\r\n            },\r\n            {\r\n              \"id\": \"3\",\r\n              \"name\": \"story\",\r\n              \"value\": \"={{ $node['Webhook Trigger'].json.body.body.version }}\",\r\n              \"type\": \"string\"\r\n            },\r\n            {\r\n              \"id\": \"4\",\r\n              \"name\": \"kaneo_project_id\",\r\n              \"value\": \"={{ $node['Ensure Kaneo Project'].json.kaneo_project_id }}\",\r\n              \"type\": \"string\"\r\n            },\r\n            {\r\n              \"id\": \"5\",\r\n              \"name\": \"kaneo_workspace_id\",\r\n              \"value\": \"={{ $node['Ensure Kaneo Project'].json.kaneo_workspace_id }}\",\r\n              \"type\": \"string\"\r\n            }\r\n          ]\r\n        }\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"b02da329-9a7e-45ca-a098-30860e5e762d\",\r\n      \"name\": \"TL: Create Task Work Items\",\r\n      \"type\": \"n8n-nodes-base.executeWorkflow\",\r\n      \"typeVersion\": 1.1,\r\n      \"position\": [\r\n        1560,\r\n        200\r\n      ],\r\n      \"parameters\": {\r\n        \"source\": \"database\",\r\n        \"workflowId\": {\r\n          \"mode\": \"id\",\r\n          \"value\": \"jAv16SAzGy9fA5G4\"\r\n        },\r\n        \"mode\": \"once\"\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"b2000001-0000-0000-0000-000000000005\",\r\n      \"name\": \"Release Manager Input\",\r\n      \"type\": \"n8n-nodes-base.set\",\r\n      \"typeVersion\": 3.4,\r\n      \"position\": [\r\n        1780,\r\n        200\r\n      ],\r\n      \"parameters\": {\r\n        \"mode\": \"manual\",\r\n        \"assignments\": {\r\n          \"assignments\": [\r\n            {\r\n              \"id\": \"1\",\r\n              \"name\": \"role\",\r\n              \"value\": \"release-manager\",\r\n              \"type\": \"string\"\r\n            },\r\n            {\r\n              \"id\": \"2\",\r\n              \"name\": \"prompt\",\r\n              \"value\": \"=Using glab (hostname gitlab-webservice-default.gitlab.svc.cluster.local), determine the next release version number for project {{ ($node['Webhook Trigger'].json.body.body.group ?? 'sdlc') + '/' + ($node['Webhook Trigger'].json.body.body.project ?? 'hr-portal') }}: list existing branches via `glab api projects/{{ ($node['Webhook Trigger'].json.body.body.group ?? 'sdlc') + '%2F' + ($node['Webhook Trigger'].json.body.body.project ?? 'hr-portal') }}/repository/branches --hostname gitlab-webservice-default.gitlab.svc.cluster.local` and find the highest semantic version among any matching 'release/vMAJOR.MINOR.PATCH'; if none exist, start at v0.0.1, otherwise bump the patch number by 1. Create a branch named 'release/\u003cversion\u003e' (e.g. 'release/v0.0.1') from the 'main' branch via `glab api projects/{{ ($node['Webhook Trigger'].json.body.body.group ?? 'sdlc') + '%2F' + ($node['Webhook Trigger'].json.body.body.project ?? 'hr-portal') }}/repository/branches --method POST -f branch=release/\u003cversion\u003e -f ref=main`. If that exact branch name already exists (400/409 conflict), treat it as success. Report the exact version number and exact branch name you created — the next step must reuse this exact name, not derive its own.\",\r\n              \"type\": \"string\"\r\n            },\r\n            {\r\n              \"id\": \"3\",\r\n              \"name\": \"story\",\r\n              \"value\": \"={{ $node['Webhook Trigger'].json.body.body.version }}\",\r\n              \"type\": \"string\"\r\n            },\r\n            {\r\n              \"id\": \"4\",\r\n              \"name\": \"kaneo_project_id\",\r\n              \"value\": \"={{ $node['Ensure Kaneo Project'].json.kaneo_project_id }}\",\r\n              \"type\": \"string\"\r\n            }\r\n          ]\r\n        }\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"b2000001-0000-0000-0000-000000000006\",\r\n      \"name\": \"RM: Create Release Branch\",\r\n      \"type\": \"n8n-nodes-base.executeWorkflow\",\r\n      \"typeVersion\": 1.1,\r\n      \"position\": [\r\n        2000,\r\n        200\r\n      ],\r\n      \"parameters\": {\r\n        \"source\": \"database\",\r\n        \"workflowId\": {\r\n          \"mode\": \"id\",\r\n          \"value\": \"jAv16SAzGy9fA5G4\"\r\n        },\r\n        \"mode\": \"once\"\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"b2000001-0000-0000-0000-000000000007\",\r\n      \"name\": \"TL Input (Branches)\",\r\n      \"type\": \"n8n-nodes-base.set\",\r\n      \"typeVersion\": 3.4,\r\n      \"position\": [\r\n        2220,\r\n        200\r\n      ],\r\n      \"parameters\": {\r\n        \"mode\": \"manual\",\r\n        \"assignments\": {\r\n          \"assignments\": [\r\n            {\r\n              \"id\": \"1\",\r\n              \"name\": \"role\",\r\n              \"value\": \"tech-lead\",\r\n              \"type\": \"string\"\r\n            },\r\n            {\r\n              \"id\": \"2\",\r\n              \"name\": \"prompt\",\r\n              \"value\": \"=First find the exact release branch name the previous step created (it reported it, formatted like 'release/v0.0.1' — a semantic version number, NOT the literal text 'release/{{ $node['Webhook Trigger'].json.body.body.version }}'; if you need to rediscover it, list branches via `glab api projects/{{ ($node['Webhook Trigger'].json.body.body.group ?? 'sdlc') + '%2F' + ($node['Webhook Trigger'].json.body.body.project ?? 'hr-portal') }}/repository/branches --hostname gitlab-webservice-default.gitlab.svc.cluster.local` and pick the branch matching 'release/vMAJOR.MINOR.PATCH' with the highest version). Using glab, create one branch per story ticket off of that release branch (not main) named 'us/GL-\u003cstory-id\u003e' (the story task's Kaneo id, NOT a title slug — every other role's SKILL.md already assumes this exact branch name as the task MRs' target branch; 'GL-' is kept as branch-naming vocabulary only, per AGENTS.md's Ticket \u0026 MR Conventions — the id itself is a Kaneo task id, not a GitLab issue IID) via `glab api projects/{{ ($node['Webhook Trigger'].json.body.body.group ?? 'sdlc') + '%2F' + ($node['Webhook Trigger'].json.body.body.project ?? 'hr-portal') }}/repository/branches --method POST -f branch=us/GL-\u003cstory-id\u003e -f ref=\u003crelease-branch-name\u003e`, then one branch per task ticket off of its parent story's branch named 'task/GL-\u003ctask-id\u003e' (the task's own Kaneo id) via the same call with ref=us/GL-\u003cstory-id\u003e (use the story/task ids from the earlier steps — re-query Kaneo if you need them again). Embedding the id in the branch name (not a slug) is required — backend/frontend-developer read it straight out of their branch name to put 'Closes #\u003ctask-id\u003e' in their task MR description; that's prose only now (the ticket lives in Kaneo, so a GitLab merge can't auto-close it on its own — Kaneo's own native GitLab integration, configured earlier in this same flow, still attaches the merge commit as a comment for the compliance trail), but the id is still how the developer pod finds which task to PATCH to Done after merge — a slug can't be reverse-parsed back to an id reliably. Immediately after creating each branch, append a clickable link to it onto its ticket's own description (not a comment -- the branch link belongs with the ticket's permanent content, see AGENTS.md's \\\"Ticket ↔ branch linkage\\\") -- not just the bare branch name, the link must resolve from a browser, so build it against the external tailnet host, never the in-cluster service address: `https://gitlab.tail60240b.ts.net/{{ ($node['Webhook Trigger'].json.body.body.group ?? 'sdlc') + '/' + ($node['Webhook Trigger'].json.body.body.project ?? 'hr-portal') }}/-/tree/us/GL-\u003cstory-id\u003e`: GET the story ticket's current description (`GET $KANEO_URL/api/task/\u003cstory task id\u003e` with bearer `$KANEO_TOKEN`), then `PATCH $KANEO_URL/api/task/\u003cstory task id\u003e` with bearer `$KANEO_TOKEN` and body `{\\\"description\\\": \\\"\u003ccurrent description\u003e\\n\\n**Branch:** \u003cthat full URL\u003e\\\"}` (PATCH replaces description wholesale -- always append to the GET result, never clobber it); same GET-then-PATCH against each task ticket's own id with its own branch's URL -- this is the ticket-to-branch linkage. For each task branch, commit openspec pseudocode under openspec/\u003ctask-slug\u003e.md (slug is fine for the file name, this is just a path), and PATCH the task's status to \\\"OpenSpec Ready\\\" (`PATCH $KANEO_URL/api/task/\u003ctask id\u003e` with bearer `$KANEO_TOKEN` and body `{\\\"status\\\": \\\"OpenSpec Ready\\\"}` -- Kaneo's `status` is a plain string, not an id to resolve; F-03/F-04 already read this exact value back). Report every branch created.\",\r\n              \"type\": \"string\"\r\n            },\r\n            {\r\n              \"id\": \"3\",\r\n              \"name\": \"story\",\r\n              \"value\": \"={{ $node['Webhook Trigger'].json.body.body.version }}\",\r\n              \"type\": \"string\"\r\n            },\r\n            {\r\n              \"id\": \"4\",\r\n              \"name\": \"kaneo_project_id\",\r\n              \"value\": \"={{ $node['Ensure Kaneo Project'].json.kaneo_project_id }}\",\r\n              \"type\": \"string\"\r\n            }\r\n          ]\r\n        }\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"b2000001-0000-0000-0000-000000000008\",\r\n      \"name\": \"TL: Create Story/Task Branches\",\r\n      \"type\": \"n8n-nodes-base.executeWorkflow\",\r\n      \"typeVersion\": 1.1,\r\n      \"position\": [\r\n        2440,\r\n        200\r\n      ],\r\n      \"parameters\": {\r\n        \"source\": \"database\",\r\n        \"workflowId\": {\r\n          \"mode\": \"id\",\r\n          \"value\": \"jAv16SAzGy9fA5G4\"\r\n        },\r\n        \"mode\": \"once\"\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"b2000001-0000-0000-0000-000000000003\",\r\n      \"name\": \"DevOps Input\",\r\n      \"type\": \"n8n-nodes-base.set\",\r\n      \"typeVersion\": 3.4,\r\n      \"position\": [\r\n        900,\r\n        480\r\n      ],\r\n      \"parameters\": {\r\n        \"mode\": \"manual\",\r\n        \"assignments\": {\r\n          \"assignments\": [\r\n            {\r\n              \"id\": \"1\",\r\n              \"name\": \"role\",\r\n              \"value\": \"devops-engineer\",\r\n              \"type\": \"string\"\r\n            },\r\n            {\r\n              \"id\": \"2\",\r\n              \"name\": \"prompt\",\r\n              \"value\": \"=Register the GitLab group webhook (idempotent), set CI env vars, and verify the SIT cluster is healthy for {{ $node['Webhook Trigger'].json.body.body.version }}. Then, idempotently ensure GitOps wiring exists for this project (skip any step already done — check before creating): (1) for each deployable app under apps/, if no helm/\u003capp\u003e chart exists on main yet, scaffold one (Chart.yaml, templates/deployment.yaml + service.yaml — templates only, no environment-specific values in helm/\u003capp\u003e/values.yaml, that file holds chart defaults only) and commit to main; (2) for each app x each environment this project deploys to (sit/uat/production at minimum), if env/\u003cenvironment\u003e/\u003capp\u003e/values.yaml doesn't exist yet, create it (image harbor.harbor.svc.cluster.local:80/library/{{ ($node['Webhook Trigger'].json.body.body.group ?? 'sdlc') + '/' + ($node['Webhook Trigger'].json.body.body.project ?? 'hr-portal') }}/\u003capp\u003e:v\u003ccurrent main package.json version\u003e — do not use :latest, ArgoCD Image Updater below owns the tag on SIT from here on) and commit to main — this is the ONLY place values live, per repo convention (`env/{environment-name}/{application-name}/values.yaml`, never inline in the ArgoCD Application, never environment-specific data inside helm/\u003capp\u003e/values.yaml); (3) check `kubectl get application -n argocd {{ ($node['Webhook Trigger'].json.body.body.group ?? 'sdlc') + '-' + ($node['Webhook Trigger'].json.body.body.project ?? 'hr-portal') }}-\u003capp\u003e-\u003cenvironment\u003e` for each app x environment — if missing, `kubectl apply` an ArgoCD Application (repoURL http://gitlab-webservice-default.gitlab.svc.cluster.local:8181/{{ ($node['Webhook Trigger'].json.body.body.group ?? 'sdlc') + '/' + ($node['Webhook Trigger'].json.body.body.project ?? 'hr-portal') }}.git, targetRevision main, source.path helm/\u003capp\u003e, source.helm.valueFiles [../../env/\u003cenvironment\u003e/\u003capp\u003e/values.yaml], destination this same in-cluster namespace, automated syncPolicy) — on SIT only, carry these annotations so ArgoCD Image Updater (already deployed in the argocd namespace) picks it up: `argocd-image-updater.argoproj.io/image-list: \u003capp\u003e=harbor.harbor.svc.cluster.local:80/library/{{ ($node['Webhook Trigger'].json.body.body.group ?? 'sdlc') + '/' + ($node['Webhook Trigger'].json.body.body.project ?? 'hr-portal') }}/\u003capp\u003e`, `argocd-image-updater.argoproj.io/\u003capp\u003e.update-strategy: latest`, `argocd-image-updater.argoproj.io/\u003capp\u003e.allow-tags: regexp:^v[0-9]+\\\\.[0-9]+\\\\.[0-9]+-rc[0-9]+$` (matches the CI build stage's `v{package.json version}` rc tags), `argocd-image-updater.argoproj.io/\u003capp\u003e.pull-secret: secret:argocd/argocd-image-updater-registry`, `argocd-image-updater.argoproj.io/write-back-method: argocd` (the CI docker-build stage tagging images `v{X}.{Y}.{Z}-rc{N}` on every us/* or release/* merge is what image-updater then polls and auto-bumps on SIT — no manual tag edits, no re-running this flow per release; UAT/staging/production use explicit ArgoCD sync instead, no image-updater annotations there — UAT's tag comes from `/uat`'s pre-deploy step reading QA's tested-tag record on each story MR, never from image-updater). If an existing Application already exists but is missing these annotations or still points at a deploy/ path from before this convention, patch it to the helm/\u003capp\u003e + valueFiles form rather than skipping. This is one-time infra registration per project x environment, not per release — always check existence first so repeat kickoffs don't duplicate or fight ArgoCD's own reconciliation.\",\r\n              \"type\": \"string\"\r\n            },\r\n            {\r\n              \"id\": \"3\",\r\n              \"name\": \"story\",\r\n              \"value\": \"={{ $node['Webhook Trigger'].json.body.body.version }}\",\r\n              \"type\": \"string\"\r\n            },\r\n            {\r\n              \"id\": \"4\",\r\n              \"name\": \"kaneo_project_id\",\r\n              \"value\": \"={{ $node['Ensure Kaneo Project'].json.kaneo_project_id }}\",\r\n              \"type\": \"string\"\r\n            }\r\n          ]\r\n        }\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"e80b2745-2d8d-4624-b99d-17eba1e6cddd\",\r\n      \"name\": \"DevOps: Infra + Webhook\",\r\n      \"type\": \"n8n-nodes-base.executeWorkflow\",\r\n      \"typeVersion\": 1.1,\r\n      \"position\": [\r\n        1120,\r\n        480\r\n      ],\r\n      \"parameters\": {\r\n        \"source\": \"database\",\r\n        \"workflowId\": {\r\n          \"mode\": \"id\",\r\n          \"value\": \"jAv16SAzGy9fA5G4\"\r\n        },\r\n        \"mode\": \"once\"\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"190355fa-88b0-41e7-ba40-da302eecf355\",\r\n      \"name\": \"Merge 2 Tracks\",\r\n      \"type\": \"n8n-nodes-base.merge\",\r\n      \"typeVersion\": 3,\r\n      \"position\": [\r\n        2660,\r\n        340\r\n      ],\r\n      \"parameters\": {\r\n        \"mode\": \"combine\",\r\n        \"combineBy\": \"combineByPosition\",\r\n        \"numberInputs\": 2\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"c6510faf-ce27-45a1-a886-63f8d1e8e394\",\r\n      \"name\": \"Notify: Kickoff complete\",\r\n      \"type\": \"n8n-nodes-base.httpRequest\",\r\n      \"typeVersion\": 4.2,\r\n      \"position\": [\r\n        2880,\r\n        340\r\n      ],\r\n      \"parameters\": {\r\n        \"method\": \"POST\",\r\n        \"url\": \"={{ $env.OPENWEBUI_CALLBACK_URL }}\",\r\n        \"sendHeaders\": true,\r\n        \"headerParameters\": {\r\n          \"parameters\": [\r\n            {\r\n              \"name\": \"Content-Type\",\r\n              \"value\": \"application/json\"\r\n            }\r\n          ]\r\n        },\r\n        \"sendBody\": true,\r\n        \"bodyParameters\": {\r\n          \"parameters\": [\r\n            {\r\n              \"name\": \"flow_id\",\r\n              \"value\": \"={{ $json.body?.flow_id ?? $json.flow_id ?? '' }}\"\r\n            },\r\n            {\r\n              \"name\": \"message\",\r\n              \"value\": \"✅ kickoff complete — story/task work items, release+story+task branches, infra ready\"\r\n            },\r\n            {\r\n              \"name\": \"notes\",\r\n              \"value\": \"\"\r\n            }\r\n          ]\r\n        }\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"c1a00001-0000-0000-0000-000000000001\",\r\n      \"name\": \"Configure Kaneo GitLab Integration\",\r\n      \"type\": \"n8n-nodes-base.code\",\r\n      \"typeVersion\": 2,\r\n      \"position\": [\r\n        1195,\r\n        60\r\n      ],\r\n      \"parameters\": {\r\n        \"jsCode\": \"// ponytail: wires Kaneo's own native GitLab integration (real\\n// bidirectional sync, merged upstream 2026-09-26 -- see AGENT.md's \\\"Kaneo\\\"\\n// section) onto the project just ensured above, so Kaneo's board stays in\\n// sync with this project's GitLab activity without a separate webhook\\n// playbook (unlike Taiga's old one-way compliance webhook).\\nconst auth = { Authorization: `Bearer ${$env.KANEO_TOKEN}` };\\nconst projectId = $json.kaneo_project_id;\\nconst group = $node['Webhook Trigger'].json.body.body.group ?? 'sdlc';\\nconst project = $node['Webhook Trigger'].json.body.body.project ?? 'hr-portal';\\nconst gitlabProjectPath = `${group}/${project}`;\\n\\n// ponytail: verify this exact Kaneo integration-config endpoint path\\n// against the deployed version -- inferred from the confirmed\\n// /api/project/\u003cid\u003e/... nesting convention, not confirmed from docs. Best\\n// effort / fire-and-forget: a failure here shouldn't block the rest of\\n// kickoff, Kaneo tickets still work fine without GitLab sync wired up.\\ntry {\\n  await this.helpers.httpRequest({\\n    method: 'POST',\\n    url: `${$env.KANEO_URL}/api/project/${projectId}/integrations/gitlab`,\\n    headers: auth,\\n    json: true,\\n    body: {\\n      gitlabUrl: 'http://gitlab-webservice-default.gitlab.svc.cluster.local:8181',\\n      gitlabToken: $env.GITLAB_TOKEN,\\n      projectPath: gitlabProjectPath,\\n    },\\n    ignoreHttpStatusErrors: true,\\n  });\\n} catch (e) {\\n  console.log(`Kaneo GitLab integration config failed (non-fatal): ${e.message}`);\\n}\\n\\nreturn [{ json: { ...$json, kaneo_gitlab_integration_configured: true } }];\"\r\n      }\r\n    }\r\n  ],\r\n  \"connections\": {\r\n    \"Webhook Trigger\": {\r\n      \"main\": [\r\n        [\r\n          {\r\n            \"node\": \"Notify: Kickoff started\",\r\n            \"type\": \"main\",\r\n            \"index\": 0\r\n          }\r\n        ]\r\n      ]\r\n    },\r\n    \"Notify: Kickoff started\": {\r\n      \"main\": [\r\n        [\r\n          {\r\n            \"node\": \"PM Project Input\",\r\n            \"type\": \"main\",\r\n            \"index\": 0\r\n          }\r\n        ]\r\n      ]\r\n    },\r\n    \"PM Project Input\": {\r\n      \"main\": [\r\n        [\r\n          {\r\n            \"node\": \"PM: Ensure Project Exists\",\r\n            \"type\": \"main\",\r\n            \"index\": 0\r\n          }\r\n        ]\r\n      ]\r\n    },\r\n    \"PM: Ensure Project Exists\": {\r\n      \"main\": [\r\n        [\r\n          {\r\n            \"node\": \"Ensure Kaneo Project\",\r\n            \"type\": \"main\",\r\n            \"index\": 0\r\n          }\r\n        ]\r\n      ]\r\n    },\r\n    \"Architect Input (Scaffold)\": {\r\n      \"main\": [\r\n        [\r\n          {\r\n            \"node\": \"Architect: Scaffold Repo\",\r\n            \"type\": \"main\",\r\n            \"index\": 0\r\n          }\r\n        ]\r\n      ]\r\n    },\r\n    \"Architect: Scaffold Repo\": {\r\n      \"main\": [\r\n        [\r\n          {\r\n            \"node\": \"PM Input\",\r\n            \"type\": \"main\",\r\n            \"index\": 0\r\n          },\r\n          {\r\n            \"node\": \"DevOps Input\",\r\n            \"type\": \"main\",\r\n            \"index\": 0\r\n          }\r\n        ]\r\n      ]\r\n    },\r\n    \"PM Input\": {\r\n      \"main\": [\r\n        [\r\n          {\r\n            \"node\": \"PM: Create Story Work Items\",\r\n            \"type\": \"main\",\r\n            \"index\": 0\r\n          }\r\n        ]\r\n      ]\r\n    },\r\n    \"PM: Create Story Work Items\": {\r\n      \"main\": [\r\n        [\r\n          {\r\n            \"node\": \"TL Input (Tasks)\",\r\n            \"type\": \"main\",\r\n            \"index\": 0\r\n          },\r\n          {\r\n            \"node\": \"QA Tickets Input\",\r\n            \"type\": \"main\",\r\n            \"index\": 0\r\n          },\r\n          {\r\n            \"node\": \"Security Tickets Input\",\r\n            \"type\": \"main\",\r\n            \"index\": 0\r\n          },\r\n          {\r\n            \"node\": \"DevOps Tickets Input\",\r\n            \"type\": \"main\",\r\n            \"index\": 0\r\n          }\r\n        ]\r\n      ]\r\n    },\r\n    \"QA Tickets Input\": {\r\n      \"main\": [\r\n        [\r\n          {\r\n            \"node\": \"QA: Create QA Tickets\",\r\n            \"type\": \"main\",\r\n            \"index\": 0\r\n          }\r\n        ]\r\n      ]\r\n    },\r\n    \"Security Tickets Input\": {\r\n      \"main\": [\r\n        [\r\n          {\r\n            \"node\": \"Security: Create Security Tickets\",\r\n            \"type\": \"main\",\r\n            \"index\": 0\r\n          }\r\n        ]\r\n      ]\r\n    },\r\n    \"DevOps Tickets Input\": {\r\n      \"main\": [\r\n        [\r\n          {\r\n            \"node\": \"DevOps: Create DevOps Tickets\",\r\n            \"type\": \"main\",\r\n            \"index\": 0\r\n          }\r\n        ]\r\n      ]\r\n    },\r\n    \"TL Input (Tasks)\": {\r\n      \"main\": [\r\n        [\r\n          {\r\n            \"node\": \"TL: Create Task Work Items\",\r\n            \"type\": \"main\",\r\n            \"index\": 0\r\n          }\r\n        ]\r\n      ]\r\n    },\r\n    \"TL: Create Task Work Items\": {\r\n      \"main\": [\r\n        [\r\n          {\r\n            \"node\": \"Release Manager Input\",\r\n            \"type\": \"main\",\r\n            \"index\": 0\r\n          }\r\n        ]\r\n      ]\r\n    },\r\n    \"Release Manager Input\": {\r\n      \"main\": [\r\n        [\r\n          {\r\n            \"node\": \"RM: Create Release Branch\",\r\n            \"type\": \"main\",\r\n            \"index\": 0\r\n          }\r\n        ]\r\n      ]\r\n    },\r\n    \"RM: Create Release Branch\": {\r\n      \"main\": [\r\n        [\r\n          {\r\n            \"node\": \"TL Input (Branches)\",\r\n            \"type\": \"main\",\r\n            \"index\": 0\r\n          }\r\n        ]\r\n      ]\r\n    },\r\n    \"TL Input (Branches)\": {\r\n      \"main\": [\r\n        [\r\n          {\r\n            \"node\": \"TL: Create Story/Task Branches\",\r\n            \"type\": \"main\",\r\n            \"index\": 0\r\n          }\r\n        ]\r\n      ]\r\n    },\r\n    \"TL: Create Story/Task Branches\": {\r\n      \"main\": [\r\n        [\r\n          {\r\n            \"node\": \"Merge 2 Tracks\",\r\n            \"type\": \"main\",\r\n            \"index\": 0\r\n          }\r\n        ]\r\n      ]\r\n    },\r\n    \"DevOps Input\": {\r\n      \"main\": [\r\n        [\r\n          {\r\n            \"node\": \"DevOps: Infra + Webhook\",\r\n            \"type\": \"main\",\r\n            \"index\": 0\r\n          }\r\n        ]\r\n      ]\r\n    },\r\n    \"DevOps: Infra + Webhook\": {\r\n      \"main\": [\r\n        [\r\n          {\r\n            \"node\": \"Merge 2 Tracks\",\r\n            \"type\": \"main\",\r\n            \"index\": 1\r\n          }\r\n        ]\r\n      ]\r\n    },\r\n    \"Merge 2 Tracks\": {\r\n      \"main\": [\r\n        [\r\n          {\r\n            \"node\": \"Notify: Kickoff complete\",\r\n            \"type\": \"main\",\r\n            \"index\": 0\r\n          }\r\n        ]\r\n      ]\r\n    },\r\n    \"Add Role Members to Kaneo Project\": {\r\n      \"main\": [\r\n        [\r\n          {\r\n            \"node\": \"Configure Kaneo GitLab Integration\",\r\n            \"type\": \"main\",\r\n            \"index\": 0\r\n          }\r\n        ]\r\n      ]\r\n    },\r\n    \"Configure Kaneo GitLab Integration\": {\r\n      \"main\": [\r\n        [\r\n          {\r\n            \"node\": \"Architect Input (Scaffold)\",\r\n            \"type\": \"main\",\r\n            \"index\": 0\r\n          }\r\n        ]\r\n      ]\r\n    },\r\n    \"Ensure Kaneo Project\": {\r\n      \"main\": [\r\n        [\r\n          {\r\n            \"node\": \"Add Role Members to Kaneo Project\",\r\n            \"type\": \"main\",\r\n            \"index\": 0\r\n          }\r\n        ]\r\n      ]\r\n    }\r\n  },\r\n  \"active\": true,\r\n  \"tags\": [],\r\n  \"settings\": {\r\n    \"executionOrder\": \"v1\"\r\n  }\r\n}","F-03-develop.json":"{\n  \"name\": \"F-03 /develop\",\n  \"nodes\": [\n    {\n      \"id\": \"7c170cce-8d64-45c1-a94a-801cdf2da165\",\n      \"name\": \"Webhook Trigger\",\n      \"type\": \"n8n-nodes-base.webhook\",\n      \"typeVersion\": 2,\n      \"position\": [\n        240,\n        300\n      ],\n      \"parameters\": {\n        \"path\": \"develop\",\n        \"httpMethod\": \"POST\",\n        \"responseMode\": \"onReceived\",\n        \"responseData\": \"allEntries\"\n      },\n      \"webhookId\": \"3f19b4ff-d160-418a-b7ff-8abf858c47ae\"\n    },\n    {\n      \"id\": \"dc53460c-f74e-44a3-b874-beab93430f8e\",\n      \"name\": \"Notify: Develop started\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4.2,\n      \"position\": [\n        680,\n        300\n      ],\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.OPENWEBUI_CALLBACK_URL }}\",\n        \"sendHeaders\": true,\n        \"headerParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"Content-Type\",\n              \"value\": \"application/json\"\n            }\n          ]\n        },\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"flow_id\",\n              \"value\": \"={{ $json.body?.flow_id ?? $json.flow_id ?? '' }}\"\n            },\n            {\n              \"name\": \"message\",\n              \"value\": \"🛠️ develop started — Gate A DevOps\"\n            },\n            {\n              \"name\": \"notes\",\n              \"value\": \"\"\n            }\n          ]\n        }\n      }\n    },\n    {\n      \"id\": \"b5169753-b180-42c7-ab43-cd5b82ce59a7\",\n      \"name\": \"DevOps Input\",\n      \"type\": \"n8n-nodes-base.set\",\n      \"typeVersion\": 3.4,\n      \"position\": [\n        900,\n        220\n      ],\n      \"parameters\": {\n        \"mode\": \"manual\",\n        \"assignments\": {\n          \"assignments\": [\n            {\n              \"id\": \"1\",\n              \"name\": \"role\",\n              \"value\": \"devops-engineer\",\n              \"type\": \"string\"\n            },\n            {\n              \"id\": \"2\",\n              \"name\": \"prompt\",\n              \"value\": \"=Using glab against the in-cluster GitLab (`--hostname gitlab-webservice-default.gitlab.svc.cluster.local`, project {{ $node['Webhook Trigger'].json.body.gitlab_project_path ?? $env.GITLAB_PROJECT_PATH.replace('%2F', '/') }}), first find the release branch for this version (formatted 'release/vMAJOR.MINOR.PATCH', matching {{ $node['Webhook Trigger'].json.body.body.version }} — list via `glab api projects/{{ $node['Webhook Trigger'].json.body.gitlab_project_path?.replaceAll('/','%2F') ?? $env.GITLAB_PROJECT_PATH }}/repository/branches` if you need to confirm the exact name). Verify the release branch's CI pipeline is green (`glab api projects/{{ $node['Webhook Trigger'].json.body.gitlab_project_path?.replaceAll('/','%2F') ?? $env.GITLAB_PROJECT_PATH }}/pipelines?ref=\u003crelease-branch\u003e`), confirm the SIT k3d cluster's core pods are healthy, and confirm secrets referenced by the deployment are current. Report pass/fail and any blocking issue.\",\n              \"type\": \"string\"\n            },\n            {\n              \"id\": \"3\",\n              \"name\": \"story\",\n              \"value\": \"={{ $node['Webhook Trigger'].json.body.body.version }}\",\n              \"type\": \"string\"\n            }\n          ]\n        }\n      }\n    },\n    {\n      \"id\": \"f4796745-ea8f-4bcf-afb3-b6b26203c0ee\",\n      \"name\": \"Gate A: DevOps preflight\",\n      \"type\": \"n8n-nodes-base.executeWorkflow\",\n      \"typeVersion\": 1.2,\n      \"position\": [\n        900,\n        300\n      ],\n      \"parameters\": {\n        \"source\": \"database\",\n        \"workflowId\": {\n          \"mode\": \"id\",\n          \"value\": \"jAv16SAzGy9fA5G4\"\n        },\n        \"mode\": \"once\"\n      }\n    },\n    {\n      \"id\": \"efa3b262-8e0a-4670-bfc5-1738207a7cf1\",\n      \"name\": \"Notify: Gate A done\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4.2,\n      \"position\": [\n        1120,\n        300\n      ],\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.OPENWEBUI_CALLBACK_URL }}\",\n        \"sendHeaders\": true,\n        \"headerParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"Content-Type\",\n              \"value\": \"application/json\"\n            }\n          ]\n        },\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"flow_id\",\n              \"value\": \"={{ $json.body?.flow_id ?? $json.flow_id ?? '' }}\"\n            },\n            {\n              \"name\": \"message\",\n              \"value\": \"✅ Gate A done — Gate B Data Engineer\"\n            },\n            {\n              \"name\": \"notes\",\n              \"value\": \"\"\n            }\n          ]\n        }\n      }\n    },\n    {\n      \"id\": \"199e9318-09b3-4ec8-bf48-2a2d78fa7d51\",\n      \"name\": \"Data Engineer Input\",\n      \"type\": \"n8n-nodes-base.set\",\n      \"typeVersion\": 3.4,\n      \"position\": [\n        1340,\n        220\n      ],\n      \"parameters\": {\n        \"mode\": \"manual\",\n        \"assignments\": {\n          \"assignments\": [\n            {\n              \"id\": \"1\",\n              \"name\": \"role\",\n              \"value\": \"data-engineer\",\n              \"type\": \"string\"\n            },\n            {\n              \"id\": \"2\",\n              \"name\": \"prompt\",\n              \"value\": \"=Using glab against the in-cluster GitLab (`--hostname gitlab-webservice-default.gitlab.svc.cluster.local`, project {{ $node['Webhook Trigger'].json.body.gitlab_project_path ?? $env.GITLAB_PROJECT_PATH.replace('%2F', '/') }}), first find the release branch for this version (formatted 'release/vMAJOR.MINOR.PATCH', matching {{ $node['Webhook Trigger'].json.body.body.version }} — list via `glab api projects/{{ $node['Webhook Trigger'].json.body.gitlab_project_path?.replaceAll('/','%2F') ?? $env.GITLAB_PROJECT_PATH }}/repository/branches` if you need to confirm the exact name). Apply any pending schema migrations for this release's task branches, push updated schemas to Apicurio if configured, and verify Debezium connectors are healthy. Report what was applied.\",\n              \"type\": \"string\"\n            },\n            {\n              \"id\": \"3\",\n              \"name\": \"story\",\n              \"value\": \"={{ $node['Webhook Trigger'].json.body.body.version }}\",\n              \"type\": \"string\"\n            }\n          ]\n        }\n      }\n    },\n    {\n      \"id\": \"01a58b71-3d98-4cb8-a90e-1463a51be44c\",\n      \"name\": \"Gate B: Data Engineer\",\n      \"type\": \"n8n-nodes-base.executeWorkflow\",\n      \"typeVersion\": 1.2,\n      \"position\": [\n        1340,\n        300\n      ],\n      \"parameters\": {\n        \"source\": \"database\",\n        \"workflowId\": {\n          \"mode\": \"id\",\n          \"value\": \"jAv16SAzGy9fA5G4\"\n        },\n        \"mode\": \"once\"\n      }\n    },\n    {\n      \"id\": \"1cabde1d-6cf7-479d-bda4-f8d95f8f3e12\",\n      \"name\": \"Notify: Gate B done\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4.2,\n      \"position\": [\n        1560,\n        300\n      ],\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.OPENWEBUI_CALLBACK_URL }}\",\n        \"sendHeaders\": true,\n        \"headerParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"Content-Type\",\n              \"value\": \"application/json\"\n            }\n          ]\n        },\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"flow_id\",\n              \"value\": \"={{ $json.body?.flow_id ?? $json.flow_id ?? '' }}\"\n            },\n            {\n              \"name\": \"message\",\n              \"value\": \"✅ Gate B done — Gate C TL pseudocode review\"\n            },\n            {\n              \"name\": \"notes\",\n              \"value\": \"\"\n            }\n          ]\n        }\n      }\n    },\n    {\n      \"id\": \"8f65bb27-a325-4a97-86f1-7a8bfd9dc809\",\n      \"name\": \"TL Pseudocode Input\",\n      \"type\": \"n8n-nodes-base.set\",\n      \"typeVersion\": 3.4,\n      \"position\": [\n        1780,\n        220\n      ],\n      \"parameters\": {\n        \"mode\": \"manual\",\n        \"assignments\": {\n          \"assignments\": [\n            {\n              \"id\": \"1\",\n              \"name\": \"role\",\n              \"value\": \"tech-lead\",\n              \"type\": \"string\"\n            },\n            {\n              \"id\": \"2\",\n              \"name\": \"prompt\",\n              \"value\": \"=Using glab against the in-cluster GitLab (`--hostname gitlab-webservice-default.gitlab.svc.cluster.local`, project {{ $node['Webhook Trigger'].json.body.gitlab_project_path ?? $env.GITLAB_PROJECT_PATH.replace('%2F', '/') }}), first find the release branch for this version (formatted 'release/vMAJOR.MINOR.PATCH', matching {{ $node['Webhook Trigger'].json.body.body.version }} — list via `glab api projects/{{ $node['Webhook Trigger'].json.body.gitlab_project_path?.replaceAll('/','%2F') ?? $env.GITLAB_PROJECT_PATH }}/repository/branches` if you need to confirm the exact name). For every task branch off this release (branch name `task/GL-{N}`, {N} is the Kaneo task id), review the openspec/\u003ctask-slug\u003e.md pseudocode, confirm the task still carries the \\\"OpenSpec Ready\\\" status (`curl -sH \\\"Authorization: Bearer {{ $env.KANEO_TOKEN }}\\\" \\\"{{ $env.KANEO_URL }}/api/task/{N}\\\"` and check `.status`), and flag any cross-task dependency the developer pods need to know about before implementing. Report per-task status.\",\n              \"type\": \"string\"\n            },\n            {\n              \"id\": \"3\",\n              \"name\": \"story\",\n              \"value\": \"={{ $node['Webhook Trigger'].json.body.body.version }}\",\n              \"type\": \"string\"\n            }\n          ]\n        }\n      }\n    },\n    {\n      \"id\": \"a06cf52f-cd84-4f20-bdec-7b28eafd0e47\",\n      \"name\": \"Gate C: TL Pseudocode\",\n      \"type\": \"n8n-nodes-base.executeWorkflow\",\n      \"typeVersion\": 1.2,\n      \"position\": [\n        1780,\n        300\n      ],\n      \"parameters\": {\n        \"source\": \"database\",\n        \"workflowId\": {\n          \"mode\": \"id\",\n          \"value\": \"jAv16SAzGy9fA5G4\"\n        },\n        \"mode\": \"once\"\n      }\n    },\n    {\n      \"id\": \"324c08a1-b841-4e0f-b22f-0173df9d5b8b\",\n      \"name\": \"Notify: Fanning out dev pods\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4.2,\n      \"position\": [\n        2000,\n        300\n      ],\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.OPENWEBUI_CALLBACK_URL }}\",\n        \"sendHeaders\": true,\n        \"headerParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"Content-Type\",\n              \"value\": \"application/json\"\n            }\n          ]\n        },\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"flow_id\",\n              \"value\": \"={{ $json.body?.flow_id ?? $json.flow_id ?? '' }}\"\n            },\n            {\n              \"name\": \"message\",\n              \"value\": \"✅ Gate C done — dev pods fanning out\"\n            },\n            {\n              \"name\": \"notes\",\n              \"value\": \"\"\n            }\n          ]\n        }\n      }\n    },\n    {\n      \"id\": \"08027a0f-9007-4762-bdfc-1ff424fa2a40\",\n      \"name\": \"Backend Developer Input\",\n      \"type\": \"n8n-nodes-base.set\",\n      \"typeVersion\": 3.4,\n      \"position\": [\n        2220,\n        60\n      ],\n      \"parameters\": {\n        \"mode\": \"manual\",\n        \"assignments\": {\n          \"assignments\": [\n            {\n              \"id\": \"1\",\n              \"name\": \"role\",\n              \"value\": \"backend-developer\",\n              \"type\": \"string\"\n            },\n            {\n              \"id\": \"2\",\n              \"name\": \"prompt\",\n              \"value\": \"=Using glab against the in-cluster GitLab (`--hostname gitlab-webservice-default.gitlab.svc.cluster.local`, project {{ $node['Webhook Trigger'].json.body.gitlab_project_path ?? $env.GITLAB_PROJECT_PATH.replace('%2F', '/') }}), first find the release branch for this version (formatted 'release/vMAJOR.MINOR.PATCH', matching {{ $node['Webhook Trigger'].json.body.body.version }} — list via `glab api projects/{{ $node['Webhook Trigger'].json.body.gitlab_project_path?.replaceAll('/','%2F') ?? $env.GITLAB_PROJECT_PATH }}/repository/branches` if you need to confirm the exact name). Clone the repo, and for each task branch under this release whose Kaneo task (id {N} parsed from its `task/GL-{N}` branch name, `GET {{ $env.KANEO_URL }}/api/task/{N}` and check `.status`) carries status \\\"OpenSpec Ready\\\", checkout that task branch. Step 1, before implementing anything: mark the task \\\"In progress\\\" — `PATCH {{ $env.KANEO_URL }}/api/task/{N}` with `{\\\"status\\\": \\\"in-progress\\\"}` (bearer `{{ $env.KANEO_TOKEN }}`; // ponytail: verify this exact field/path against the deployed Kaneo version). Then implement backend (NestJS) tasks per the SKILL.md workflow — translate the openspec pseudocode, do not redesign it. Run `nx affected -t test,lint,typecheck --base=main` before committing. Commit to the task branch and open a merge request from the task branch into its parent story branch, in the same {{ $node['Webhook Trigger'].json.body.gitlab_project_path ?? $env.GITLAB_PROJECT_PATH.replace('%2F', '/') }} repository. Report every MR opened.\",\n              \"type\": \"string\"\n            },\n            {\n              \"id\": \"3\",\n              \"name\": \"story\",\n              \"value\": \"={{ $node['Webhook Trigger'].json.body.body.version }}\",\n              \"type\": \"string\"\n            }\n          ]\n        }\n      }\n    },\n    {\n      \"id\": \"96361545-9bbb-454a-a424-a59e2c85221a\",\n      \"name\": \"Backend Developer\",\n      \"type\": \"n8n-nodes-base.executeWorkflow\",\n      \"typeVersion\": 1.2,\n      \"position\": [\n        2220,\n        160\n      ],\n      \"parameters\": {\n        \"source\": \"database\",\n        \"workflowId\": {\n          \"mode\": \"id\",\n          \"value\": \"jAv16SAzGy9fA5G4\"\n        },\n        \"mode\": \"once\"\n      }\n    },\n    {\n      \"id\": \"82141c65-c5af-4e9b-8e3a-5b3b5e450d75\",\n      \"name\": \"Frontend Developer Input\",\n      \"type\": \"n8n-nodes-base.set\",\n      \"typeVersion\": 3.4,\n      \"position\": [\n        2220,\n        220\n      ],\n      \"parameters\": {\n        \"mode\": \"manual\",\n        \"assignments\": {\n          \"assignments\": [\n            {\n              \"id\": \"1\",\n              \"name\": \"role\",\n              \"value\": \"frontend-developer\",\n              \"type\": \"string\"\n            },\n            {\n              \"id\": \"2\",\n              \"name\": \"prompt\",\n              \"value\": \"=Using glab against the in-cluster GitLab (`--hostname gitlab-webservice-default.gitlab.svc.cluster.local`, project {{ $node['Webhook Trigger'].json.body.gitlab_project_path ?? $env.GITLAB_PROJECT_PATH.replace('%2F', '/') }}), first find the release branch for this version (formatted 'release/vMAJOR.MINOR.PATCH', matching {{ $node['Webhook Trigger'].json.body.body.version }} — list via `glab api projects/{{ $node['Webhook Trigger'].json.body.gitlab_project_path?.replaceAll('/','%2F') ?? $env.GITLAB_PROJECT_PATH }}/repository/branches` if you need to confirm the exact name). Clone the repo, and for each task branch under this release whose Kaneo task (id {N} parsed from its `task/GL-{N}` branch name, `GET {{ $env.KANEO_URL }}/api/task/{N}` and check `.status`) carries status \\\"OpenSpec Ready\\\", checkout that task branch. Step 1, before implementing anything: mark the task \\\"In progress\\\" — `PATCH {{ $env.KANEO_URL }}/api/task/{N}` with `{\\\"status\\\": \\\"in-progress\\\"}` (bearer `{{ $env.KANEO_TOKEN }}`; // ponytail: verify this exact field/path against the deployed Kaneo version). Then implement frontend (React) tasks per the SKILL.md workflow — translate the openspec pseudocode, do not redesign it. Run `nx affected -t test,lint,typecheck --base=main` before committing. Commit to the task branch and open a merge request from the task branch into its parent story branch, in the same {{ $node['Webhook Trigger'].json.body.gitlab_project_path ?? $env.GITLAB_PROJECT_PATH.replace('%2F', '/') }} repository. Report every MR opened.\",\n              \"type\": \"string\"\n            },\n            {\n              \"id\": \"3\",\n              \"name\": \"story\",\n              \"value\": \"={{ $node['Webhook Trigger'].json.body.body.version }}\",\n              \"type\": \"string\"\n            }\n          ]\n        }\n      }\n    },\n    {\n      \"id\": \"72f2b8fb-7241-4840-a415-f53566de006b\",\n      \"name\": \"Frontend Developer\",\n      \"type\": \"n8n-nodes-base.executeWorkflow\",\n      \"typeVersion\": 1.2,\n      \"position\": [\n        2220,\n        300\n      ],\n      \"parameters\": {\n        \"source\": \"database\",\n        \"workflowId\": {\n          \"mode\": \"id\",\n          \"value\": \"jAv16SAzGy9fA5G4\"\n        },\n        \"mode\": \"once\"\n      }\n    },\n    {\n      \"id\": \"5c891012-80b2-4304-ace6-67fb5ea2ec2f\",\n      \"name\": \"QA Write Tests Input\",\n      \"type\": \"n8n-nodes-base.set\",\n      \"typeVersion\": 3.4,\n      \"position\": [\n        2220,\n        380\n      ],\n      \"parameters\": {\n        \"mode\": \"manual\",\n        \"assignments\": {\n          \"assignments\": [\n            {\n              \"id\": \"1\",\n              \"name\": \"role\",\n              \"value\": \"qa-engineer\",\n              \"type\": \"string\"\n            },\n            {\n              \"id\": \"2\",\n              \"name\": \"prompt\",\n              \"value\": \"=Using glab against the in-cluster GitLab (`--hostname gitlab-webservice-default.gitlab.svc.cluster.local`, project {{ $node['Webhook Trigger'].json.body.gitlab_project_path ?? $env.GITLAB_PROJECT_PATH.replace('%2F', '/') }}), first find the release branch for this version (formatted 'release/vMAJOR.MINOR.PATCH', matching {{ $node['Webhook Trigger'].json.body.body.version }} — list via `glab api projects/{{ $node['Webhook Trigger'].json.body.gitlab_project_path?.replaceAll('/','%2F') ?? $env.GITLAB_PROJECT_PATH }}/repository/branches` if you need to confirm the exact name). For each task branch under this release, write test suites from its tests.pseudo.ts (nx test runner), commit to the task branch, and comment coverage results on the task (`curl -sH \\\"Authorization: Bearer {{ $env.KANEO_TOKEN }}\\\" -X POST \\\"{{ $env.KANEO_URL }}/api/task/{N}/comment\\\" -H \\\"Content-Type: application/json\\\" -d '{\\\"content\\\": \\\"...\\\"}'` — // ponytail: verify exact comment path/field against the deployed Kaneo version; {N} is the Kaneo task id parsed from the `task/GL-{N}` branch name).\",\n              \"type\": \"string\"\n            },\n            {\n              \"id\": \"3\",\n              \"name\": \"story\",\n              \"value\": \"={{ $node['Webhook Trigger'].json.body.body.version }}\",\n              \"type\": \"string\"\n            }\n          ]\n        }\n      }\n    },\n    {\n      \"id\": \"b12f7fca-73a7-4aeb-bbf0-1f05c2beba6d\",\n      \"name\": \"QA: Write Tests\",\n      \"type\": \"n8n-nodes-base.executeWorkflow\",\n      \"typeVersion\": 1.2,\n      \"position\": [\n        2220,\n        440\n      ],\n      \"parameters\": {\n        \"source\": \"database\",\n        \"workflowId\": {\n          \"mode\": \"id\",\n          \"value\": \"jAv16SAzGy9fA5G4\"\n        },\n        \"mode\": \"once\"\n      }\n    },\n    {\n      \"id\": \"53af3bfe-0987-4203-a7dd-c41d47dfb0a9\",\n      \"name\": \"Security SAST Input\",\n      \"type\": \"n8n-nodes-base.set\",\n      \"typeVersion\": 3.4,\n      \"position\": [\n        2220,\n        540\n      ],\n      \"parameters\": {\n        \"mode\": \"manual\",\n        \"assignments\": {\n          \"assignments\": [\n            {\n              \"id\": \"1\",\n              \"name\": \"role\",\n              \"value\": \"security-engineer\",\n              \"type\": \"string\"\n            },\n            {\n              \"id\": \"2\",\n              \"name\": \"prompt\",\n              \"value\": \"=Using glab against the in-cluster GitLab (`--hostname gitlab-webservice-default.gitlab.svc.cluster.local`, project {{ $node['Webhook Trigger'].json.body.gitlab_project_path ?? $env.GITLAB_PROJECT_PATH.replace('%2F', '/') }}), first find the release branch for this version (formatted 'release/vMAJOR.MINOR.PATCH', matching {{ $node['Webhook Trigger'].json.body.body.version }} — list via `glab api projects/{{ $node['Webhook Trigger'].json.body.gitlab_project_path?.replaceAll('/','%2F') ?? $env.GITLAB_PROJECT_PATH }}/repository/branches` if you need to confirm the exact name). Run SAST and secrets scanning across every task branch under this release, verify no new CVEs were introduced by dependency changes, and comment any finding on the relevant task via `POST {{ $env.KANEO_URL }}/api/task/{N}/comment` with a `content` field (bearer `{{ $env.KANEO_TOKEN }}`; // ponytail: verify exact comment path against the deployed Kaneo version; {N} parsed from the `task/GL-{N}` branch name).\",\n              \"type\": \"string\"\n            },\n            {\n              \"id\": \"3\",\n              \"name\": \"story\",\n              \"value\": \"={{ $node['Webhook Trigger'].json.body.body.version }}\",\n              \"type\": \"string\"\n            }\n          ]\n        }\n      }\n    },\n    {\n      \"id\": \"04706c86-fd3b-4275-86e4-05251a8ac8e7\",\n      \"name\": \"Security: SAST\",\n      \"type\": \"n8n-nodes-base.executeWorkflow\",\n      \"typeVersion\": 1.2,\n      \"position\": [\n        2220,\n        580\n      ],\n      \"parameters\": {\n        \"source\": \"database\",\n        \"workflowId\": {\n          \"mode\": \"id\",\n          \"value\": \"jAv16SAzGy9fA5G4\"\n        },\n        \"mode\": \"once\"\n      }\n    },\n    {\n      \"id\": \"e575fa2d-4e42-41a3-86f9-eea4accfe52b\",\n      \"name\": \"Merge Dev Pods\",\n      \"type\": \"n8n-nodes-base.merge\",\n      \"typeVersion\": 3,\n      \"position\": [\n        2440,\n        360\n      ],\n      \"parameters\": {\n        \"mode\": \"combine\",\n        \"combineBy\": \"combineByPosition\",\n        \"numberInputs\": 4\n      }\n    },\n    {\n      \"id\": \"ed0bd710-9731-4377-b7a1-c4225424ce01\",\n      \"name\": \"Notify: Develop complete\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4.2,\n      \"position\": [\n        2660,\n        360\n      ],\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.OPENWEBUI_CALLBACK_URL }}\",\n        \"sendHeaders\": true,\n        \"headerParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"Content-Type\",\n              \"value\": \"application/json\"\n            }\n          ]\n        },\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"flow_id\",\n              \"value\": \"={{ $json.body?.flow_id ?? $json.flow_id ?? '' }}\"\n            },\n            {\n              \"name\": \"message\",\n              \"value\": \"✅ develop complete — all pods done, MRs opened\"\n            },\n            {\n              \"name\": \"notes\",\n              \"value\": \"\"\n            }\n          ]\n        }\n      }\n    }\n  ],\n  \"connections\": {\n    \"Webhook Trigger\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Notify: Develop started\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Notify: Develop started\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"DevOps Input\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"DevOps Input\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Gate A: DevOps preflight\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Gate A: DevOps preflight\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Notify: Gate A done\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Notify: Gate A done\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Data Engineer Input\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Data Engineer Input\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Gate B: Data Engineer\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Gate B: Data Engineer\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Notify: Gate B done\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Notify: Gate B done\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"TL Pseudocode Input\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"TL Pseudocode Input\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Gate C: TL Pseudocode\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Gate C: TL Pseudocode\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Notify: Fanning out dev pods\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Notify: Fanning out dev pods\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Backend Developer Input\",\n            \"type\": \"main\",\n            \"index\": 0\n          },\n          {\n            \"node\": \"Frontend Developer Input\",\n            \"type\": \"main\",\n            \"index\": 0\n          },\n          {\n            \"node\": \"QA Write Tests Input\",\n            \"type\": \"main\",\n            \"index\": 0\n          },\n          {\n            \"node\": \"Security SAST Input\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Backend Developer Input\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Backend Developer\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Frontend Developer Input\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Frontend Developer\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"QA Write Tests Input\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"QA: Write Tests\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Security SAST Input\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Security: SAST\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Backend Developer\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Merge Dev Pods\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Frontend Developer\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Merge Dev Pods\",\n            \"type\": \"main\",\n            \"index\": 1\n          }\n        ]\n      ]\n    },\n    \"QA: Write Tests\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Merge Dev Pods\",\n            \"type\": \"main\",\n            \"index\": 2\n          }\n        ]\n      ]\n    },\n    \"Security: SAST\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Merge Dev Pods\",\n            \"type\": \"main\",\n            \"index\": 3\n          }\n        ]\n      ]\n    },\n    \"Merge Dev Pods\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Notify: Develop complete\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    }\n  },\n  \"active\": true,\n  \"tags\": [],\n  \"settings\": {\n    \"executionOrder\": \"v1\"\n  }\n}\n","F-04-task-mr-opened.json":"{\r\n  \"name\": \"F-04 Task MR Opened\",\r\n  \"nodes\": [\r\n    {\r\n      \"id\": \"f7b685ac-b6b3-48a9-abbe-40447f4381d4\",\r\n      \"name\": \"Webhook Trigger\",\r\n      \"type\": \"n8n-nodes-base.webhook\",\r\n      \"typeVersion\": 2,\r\n      \"position\": [\r\n        240,\r\n        300\r\n      ],\r\n      \"parameters\": {\r\n        \"path\": \"gitlab-task-mr-opened\",\r\n        \"httpMethod\": \"POST\",\r\n        \"responseMode\": \"onReceived\",\r\n        \"responseData\": \"allEntries\"\r\n      },\r\n      \"webhookId\": \"1bedb63f-c0bb-4844-8ac9-f02ab71fd289\"\r\n    },\r\n    {\r\n      \"id\": \"d4000001-0000-0000-0000-000000000001\",\r\n      \"name\": \"Extract MR Info\",\r\n      \"type\": \"n8n-nodes-base.code\",\r\n      \"typeVersion\": 2,\r\n      \"position\": [\r\n        460,\r\n        300\r\n      ],\r\n      \"parameters\": {\r\n        \"jsCode\": \"const attrs = $json.body.object_attributes;\\nconst branch = attrs.source_branch || '';\\nconst m = branch.match(/^task\\\\/GL-(\\\\d+)$/);\\nreturn [{ json: { mr_iid: attrs.iid, task_iid: m ? m[1] : null, source_branch: branch, flow_id: $json.body.flow_id ?? '', retry_count: $json.body.retry_count ?? 0 } }];\"\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"2af57f60-e829-44b7-86c2-c0b297b48990\",\r\n      \"name\": \"Notify: Task MR opened\",\r\n      \"type\": \"n8n-nodes-base.httpRequest\",\r\n      \"typeVersion\": 4.2,\r\n      \"position\": [\r\n        680,\r\n        300\r\n      ],\r\n      \"parameters\": {\r\n        \"method\": \"POST\",\r\n        \"url\": \"={{ $env.OPENWEBUI_CALLBACK_URL }}\",\r\n        \"sendHeaders\": true,\r\n        \"headerParameters\": {\r\n          \"parameters\": [\r\n            {\r\n              \"name\": \"Content-Type\",\r\n              \"value\": \"application/json\"\r\n            }\r\n          ]\r\n        },\r\n        \"sendBody\": true,\r\n        \"bodyParameters\": {\r\n          \"parameters\": [\r\n            {\r\n              \"name\": \"flow_id\",\r\n              \"value\": \"={{ $node[\\\"Extract MR Info\\\"].json.flow_id ?? '' }}\"\r\n            },\r\n            {\r\n              \"name\": \"message\",\r\n              \"value\": \"🔎 Task MR opened — TL review + CI parallel\"\r\n            },\r\n            {\r\n              \"name\": \"notes\",\r\n              \"value\": \"\"\r\n            }\r\n          ]\r\n        }\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"d4000003-0000-0000-0000-000000000001\",\r\n      \"name\": \"TL Review Input\",\r\n      \"type\": \"n8n-nodes-base.set\",\r\n      \"typeVersion\": 3.4,\r\n      \"position\": [\r\n        900,\r\n        140\r\n      ],\r\n      \"parameters\": {\r\n        \"mode\": \"manual\",\r\n        \"assignments\": {\r\n          \"assignments\": [\r\n            {\r\n              \"id\": \"1\",\r\n              \"name\": \"role\",\r\n              \"value\": \"tech-lead\",\r\n              \"type\": \"string\"\r\n            },\r\n            {\r\n              \"id\": \"1b\",\r\n              \"name\": \"skipWikiVerify\",\r\n              \"value\": true,\r\n              \"type\": \"boolean\"\r\n            },\r\n            {\r\n              \"id\": \"2\",\r\n              \"name\": \"prompt\",\r\n              \"value\": \"=Review merge request !{{ $node[\\\"Extract MR Info\\\"].json.mr_iid }} (`glab mr view {{ $node[\\\"Extract MR Info\\\"].json.mr_iid }} --hostname gitlab-webservice-default.gitlab.svc.cluster.local`, diff via `glab mr diff {{ $node[\\\"Extract MR Info\\\"].json.mr_iid }} --hostname gitlab-webservice-default.gitlab.svc.cluster.local`) against the pseudocode spec the developer was given — fetch `openspec/\u003ctask-slug\u003e.md` from the MR's source branch (`glab api projects/{{ $env.GITLAB_PROJECT_PATH }}/repository/files/openspec%2F\u003ctask-slug\u003e.md/raw?ref={{ $node[\\\"Extract MR Info\\\"].json.source_branch }} --hostname gitlab-webservice-default.gitlab.svc.cluster.local`, URL-encode the slug; list `openspec/` on that branch first if you don't know the exact filename). Check: does the diff actually implement what the spec describes (not just something plausible-looking), is there test coverage for the changed logic, does it follow this repo's existing conventions (see AGENTS.md), and does it avoid obvious correctness bugs. Do NOT check CI/pipeline status yourself — that is handled separately in parallel, your review is code-against-spec only.\\n\\nOutput your verdict as the FIRST line of your response, exactly `APPROVE` or `REQUEST_CHANGES` (nothing else on that line), followed by your notes. If REQUEST_CHANGES, the notes MUST name the specific file(s)/function(s) and what's wrong or missing — \\\"needs improvement\\\" alone is not acceptable feedback, the developer re-reading this has no other context. Then, regardless of verdict, leave that same verdict + notes as a comment on Kaneo task {{ $node[\\\"Extract MR Info\\\"].json.task_iid }} so the developer sees it where they already work: `POST $KANEO_URL/api/task/{{ $node[\\\"Extract MR Info\\\"].json.task_iid }}/comment` with `{\\\"content\\\": \\\"TL review: \u003cverdict\u003e\\\\n\\\\n\u003cnotes\u003e\\\"}` (bearer `$KANEO_TOKEN`; // ponytail: verify exact comment path against the deployed Kaneo version).\",\r\n              \"type\": \"string\"\r\n            },\r\n            {\r\n              \"id\": \"3\",\r\n              \"name\": \"story\",\r\n              \"value\": \"={{ $node[\\\"Extract MR Info\\\"].json.mr_iid }}\",\r\n              \"type\": \"string\"\r\n            }\r\n          ]\r\n        }\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"daddf81f-124d-4c3d-9762-6b66c98649cf\",\r\n      \"name\": \"TL: MR Review\",\r\n      \"type\": \"n8n-nodes-base.executeWorkflow\",\r\n      \"typeVersion\": 1.1,\r\n      \"position\": [\r\n        1080,\r\n        140\r\n      ],\r\n      \"parameters\": {\r\n        \"source\": \"database\",\r\n        \"workflowId\": {\r\n          \"mode\": \"id\",\r\n          \"value\": \"jAv16SAzGy9fA5G4\"\r\n        },\r\n        \"mode\": \"once\"\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"d4000002-0000-0000-0000-000000000001\",\r\n      \"name\": \"Parse TL Review\",\r\n      \"type\": \"n8n-nodes-base.code\",\r\n      \"typeVersion\": 2,\r\n      \"position\": [\r\n        1000,\r\n        200\r\n      ],\r\n      \"parameters\": {\r\n        \"jsCode\": \"// ponytail: agent sometimes narrates (\\\"Comment posted successfully...\\\")\\n// before the verdict instead of leading with it despite the prompt asking\\n// for verdict-first -- scan every line for an exact verdict token instead\\n// of trusting output.startsWith().\\nconst out = ($json.output || '').trim();\\nconst lines = out.split('\\\\n').map(l =\u003e l.trim());\\nlet tl_result = 'UNKNOWN';\\nif (!$json.succeeded) tl_result = 'JOB_FAILED';\\nelse if (lines.includes('REQUEST_CHANGES')) tl_result = 'REQUEST_CHANGES';\\nelse if (lines.includes('APPROVE')) tl_result = 'APPROVE';\\nreturn [{ json: { tl_result, tl_notes: out || '(tech-lead review job produced no output — check the Job logs in the sdlc namespace)' } }];\"\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"a0f3dfde-0892-429f-9fc9-96f2d31289d6\",\r\n      \"name\": \"Set CI Deadline\",\r\n      \"type\": \"n8n-nodes-base.code\",\r\n      \"typeVersion\": 1,\r\n      \"position\": [\r\n        900,\r\n        400\r\n      ],\r\n      \"parameters\": {\r\n        \"mode\": \"runOnceForAllItems\",\r\n        \"jsCode\": \"// ponytail: GitLab's pipeline webhook never gets routed back to this\\n// execution's dynamic wait-resume URL (nothing in F-00/F-09 does that) --\\n// a resume:webhook Wait node here would just hang forever. Poll instead,\\n// same deadline+Wait+IF-loop shape F-31 already uses for Job status.\\nreturn [{ json: { deadline: Date.now() + 15 * 60 * 1000 } }];\"\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"a0f3dfde-0892-429f-9fc9-96f2d31289d5\",\r\n      \"name\": \"Wait CI Result\",\r\n      \"type\": \"n8n-nodes-base.wait\",\r\n      \"typeVersion\": 1.1,\r\n      \"position\": [\r\n        1020,\r\n        400\r\n      ],\r\n      \"parameters\": {\r\n        \"resume\": \"timeInterval\",\r\n        \"amount\": 15,\r\n        \"unit\": \"seconds\"\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"a0f3dfde-0892-429f-9fc9-96f2d31289d7\",\r\n      \"name\": \"Check CI Status\",\r\n      \"type\": \"n8n-nodes-base.code\",\r\n      \"typeVersion\": 2,\r\n      \"position\": [\r\n        1140,\r\n        400\r\n      ],\r\n      \"parameters\": {\r\n        \"jsCode\": \"const deadline = $node[\\\"Set CI Deadline\\\"].json.deadline;\\nconst mrIid = $node[\\\"Extract MR Info\\\"].json.mr_iid;\\nconst projectId = $node['Webhook Trigger'].json.body.project?.id ?? $env.GITLAB_PROJECT_ID;\\nconst pipelines = await this.helpers.httpRequest({\\n  method: 'GET',\\n  url: `${$env.GITLAB_URL}/api/v4/projects/${projectId}/merge_requests/${mrIid}/pipelines`,\\n  headers: { 'PRIVATE-TOKEN': $env.GITLAB_TOKEN },\\n  json: true,\\n});\\nconst latest = Array.isArray(pipelines) \u0026\u0026 pipelines.length ? pipelines[0] : null;\\nconst rawStatus = latest ? latest.status : 'none';\\nconst stillRunning = ['running', 'pending', 'created', 'waiting_for_resource', 'preparing'].includes(rawStatus);\\nconst timedOut = Date.now() \u003e deadline;\\nconst done = !stillRunning || timedOut;\\nconst status = (timedOut \u0026\u0026 stillRunning) ? 'timeout' : rawStatus;\\nreturn [{ json: { done, status, pipeline_url: latest?.web_url ?? '' } }];\"\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"a0f3dfde-0892-429f-9fc9-96f2d31289d8\",\r\n      \"name\": \"CI Done?\",\r\n      \"type\": \"n8n-nodes-base.if\",\r\n      \"typeVersion\": 2.2,\r\n      \"position\": [\r\n        1260,\r\n        400\r\n      ],\r\n      \"parameters\": {\r\n        \"conditions\": {\r\n          \"options\": {\r\n            \"caseSensitive\": true,\r\n            \"leftValue\": \"\",\r\n            \"typeValidation\": \"loose\"\r\n          },\r\n          \"combinator\": \"and\",\r\n          \"conditions\": [\r\n            {\r\n              \"leftValue\": \"={{ $json.done }}\",\r\n              \"rightValue\": \"\",\r\n              \"operator\": {\r\n                \"type\": \"boolean\",\r\n                \"operation\": \"true\",\r\n                \"singleValue\": true\r\n              }\r\n            }\r\n          ]\r\n        }\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"6d2aaa6d-9851-4042-afa4-ec3c7337ee11\",\r\n      \"name\": \"Merge TL+CI\",\r\n      \"type\": \"n8n-nodes-base.merge\",\r\n      \"typeVersion\": 3,\r\n      \"position\": [\r\n        1120,\r\n        300\r\n      ],\r\n      \"parameters\": {\r\n        \"mode\": \"combine\",\r\n        \"combineBy\": \"combineByPosition\",\r\n        \"numberInputs\": 2\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"e4024f3c-704d-498f-8ae0-e3a7c504191a\",\r\n      \"name\": \"All Passed?\",\r\n      \"type\": \"n8n-nodes-base.if\",\r\n      \"typeVersion\": 2.2,\r\n      \"position\": [\r\n        1340,\r\n        300\r\n      ],\r\n      \"parameters\": {\r\n        \"conditions\": {\r\n          \"options\": {\r\n            \"caseSensitive\": true,\r\n            \"leftValue\": \"\",\r\n            \"typeValidation\": \"loose\"\r\n          },\r\n          \"combinator\": \"and\",\r\n          \"conditions\": [\r\n            {\r\n              \"leftValue\": \"={{ $json.tl_result }}\",\r\n              \"rightValue\": \"APPROVE\",\r\n              \"operator\": {\r\n                \"type\": \"string\",\r\n                \"operation\": \"equals\"\r\n              }\r\n            },\r\n            {\r\n              \"leftValue\": \"={{ $json.status }}\",\r\n              \"rightValue\": \"success\",\r\n              \"operator\": {\r\n                \"type\": \"string\",\r\n                \"operation\": \"equals\"\r\n              }\r\n            }\r\n          ]\r\n        }\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"0005a06a-44ce-4e2e-a29f-72d5cf885594\",\r\n      \"name\": \"GitLab: Approve MR\",\r\n      \"type\": \"n8n-nodes-base.httpRequest\",\r\n      \"typeVersion\": 4.2,\r\n      \"position\": [\r\n        1560,\r\n        200\r\n      ],\r\n      \"parameters\": {\r\n        \"method\": \"POST\",\r\n        \"url\": \"={{ $env.GITLAB_URL }}/api/v4/projects/{{ $node['Webhook Trigger'].json.body.project?.id ?? $env.GITLAB_PROJECT_ID }}/merge_requests/{{ $node[\\\"Extract MR Info\\\"].json.mr_iid }}/approve\",\r\n        \"authentication\": \"none\",\r\n        \"sendHeaders\": true,\r\n        \"headerParameters\": {\r\n          \"parameters\": [\r\n            {\r\n              \"name\": \"PRIVATE-TOKEN\",\r\n              \"value\": \"={{ $env.GITLAB_TOKEN_TECH_LEAD || $env.GITLAB_TOKEN }}\"\r\n            },\r\n            {\r\n              \"name\": \"Content-Type\",\r\n              \"value\": \"application/json\"\r\n            }\r\n          ]\r\n        }\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"d1000001-0000-0000-0000-000000000001\",\r\n      \"name\": \"GitLab: Merge MR\",\r\n      \"type\": \"n8n-nodes-base.httpRequest\",\r\n      \"typeVersion\": 4.2,\r\n      \"position\": [\r\n        1780,\r\n        120\r\n      ],\r\n      \"parameters\": {\r\n        \"method\": \"PUT\",\r\n        \"url\": \"={{ $env.GITLAB_URL }}/api/v4/projects/{{ $node['Webhook Trigger'].json.body.project?.id ?? $env.GITLAB_PROJECT_ID }}/merge_requests/{{ $node[\\\"Extract MR Info\\\"].json.mr_iid }}/merge\",\r\n        \"authentication\": \"none\",\r\n        \"sendHeaders\": true,\r\n        \"headerParameters\": {\r\n          \"parameters\": [\r\n            {\r\n              \"name\": \"PRIVATE-TOKEN\",\r\n              \"value\": \"={{ $env.GITLAB_TOKEN_TECH_LEAD || $env.GITLAB_TOKEN }}\"\r\n            },\r\n            {\r\n              \"name\": \"Content-Type\",\r\n              \"value\": \"application/json\"\r\n            }\r\n          ]\r\n        },\r\n        \"sendBody\": true,\r\n        \"bodyParameters\": {\r\n          \"parameters\": [\r\n            {\r\n              \"name\": \"should_remove_source_branch\",\r\n              \"value\": \"true\"\r\n            },\r\n            {\r\n              \"name\": \"merge_when_pipeline_succeeds\",\r\n              \"value\": \"false\"\r\n            }\r\n          ]\r\n        },\r\n        \"options\": {\r\n          \"response\": {\r\n            \"response\": {\r\n              \"neverError\": true\r\n            }\r\n          }\r\n        }\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"d1000002-0000-0000-0000-000000000001\",\r\n      \"name\": \"Kaneo: Task status Closed\",\r\n      \"type\": \"n8n-nodes-base.code\",\r\n      \"typeVersion\": 2,\r\n      \"position\": [\r\n        1780,\r\n        60\r\n      ],\r\n      \"parameters\": {\r\n        \"jsCode\": \"// ponytail: Kaneo has one task resource with a plain status field, no\\n// separate per-project status-id lookup like Taiga's task-statuses -- verify\\n// 'done' is this deployment's actual closed-status value.\\nconst kaneoAuth = { Authorization: `Bearer ${$env.KANEO_TOKEN}` };\\nconst id = $node[\\\"Extract MR Info\\\"].json.task_iid;\\nawait this.helpers.httpRequest({ method: 'PATCH', url: `${$env.KANEO_URL}/api/task/${id}`, headers: { ...kaneoAuth, 'Content-Type': 'application/json' }, body: { status: 'done' }, json: true });\\nreturn [{ json: $json }];\"\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"c7a1a001-0000-0000-0000-000000000001\",\r\n      \"name\": \"Count TL Attempts\",\r\n      \"type\": \"n8n-nodes-base.code\",\r\n      \"typeVersion\": 2,\r\n      \"position\": [\r\n        1500,\r\n        400\r\n      ],\r\n      \"parameters\": {\r\n        \"jsCode\": \"// ponytail: retry_count was read from the inbound webhook body, but\\n// nothing anywhere ever sets/increments it -- every real GitLab webhook\\n// call is stateless and arrives with no such field, so the escalate\\n// branch below was permanently unreachable. Count actual \\\"TL review:\\\"\\n// comments already posted on the Kaneo task instead (TL Review Input's\\n// own prompt always posts one with that exact prefix) -- self-contained,\\n// no external counter needed.\\n// ponytail: verify this comment-list path/shape against the deployed Kaneo version.\\nconst kaneoAuth = { Authorization: `Bearer ${$env.KANEO_TOKEN}` };\\nconst taskId = $node[\\\"Extract MR Info\\\"].json.task_iid;\\nconst comments = await this.helpers.httpRequest({ method: 'GET', url: `${$env.KANEO_URL}/api/task/${taskId}/comment`, headers: kaneoAuth, json: true });\\nconst attempt_count = (Array.isArray(comments) ? comments : []).filter(h =\u003e typeof h.content === 'string' \u0026\u0026 h.content.startsWith('TL review:')).length;\\nreturn [{ json: { ...$json, attempt_count } }];\"\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"d0a7a36e-9e01-4236-8b03-c4f4505130d7\",\r\n      \"name\": \"Retry \u003c 3?\",\r\n      \"type\": \"n8n-nodes-base.if\",\r\n      \"typeVersion\": 2.2,\r\n      \"position\": [\r\n        1620,\r\n        400\r\n      ],\r\n      \"parameters\": {\r\n        \"conditions\": {\r\n          \"options\": {\r\n            \"caseSensitive\": true,\r\n            \"leftValue\": \"\",\r\n            \"typeValidation\": \"loose\"\r\n          },\r\n          \"combinator\": \"and\",\r\n          \"conditions\": [\r\n            {\r\n              \"leftValue\": \"={{ $json.attempt_count ?? 1 }}\",\r\n              \"rightValue\": 2,\r\n              \"operator\": {\r\n                \"type\": \"number\",\r\n                \"operation\": \"lte\"\r\n              }\r\n            }\r\n          ]\r\n        }\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"026275d2-92c9-4a4f-a9a8-888bbe28b92e\",\r\n      \"name\": \"Comment CI Status if Failed\",\r\n      \"type\": \"n8n-nodes-base.code\",\r\n      \"typeVersion\": 2,\r\n      \"position\": [\r\n        1780,\r\n        400\r\n      ],\r\n      \"parameters\": {\r\n        \"jsCode\": \"// ponytail: TL's own review (and its Kaneo comment) only covers code vs\\n// spec -- it never checks CI, so a CI-only failure needs its own comment\\n// or the developer only sees \\\"TL review: APPROVE\\\" and no clue why the MR\\n// is still blocked.\\nif ($json.status === 'success') return [{ json: $json }];\\nconst kaneoAuth = { Authorization: `Bearer ${$env.KANEO_TOKEN}` };\\nconst id = $node[\\\"Extract MR Info\\\"].json.task_iid;\\nconst content = `CI pipeline ${$json.status}${$json.pipeline_url ? ' — ' + $json.pipeline_url : ''}. Fix the pipeline and push again; this MR cannot be merged until it's green.`;\\n// ponytail: verify this comment path against the deployed Kaneo version.\\nawait this.helpers.httpRequest({ method: 'POST', url: `${$env.KANEO_URL}/api/task/${id}/comment`, headers: { ...kaneoAuth, 'Content-Type': 'application/json' }, body: { content }, json: true });\\nreturn [{ json: $json }];\"\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"026275d2-92c9-4a4f-a9a8-888bbe28b92d\",\r\n      \"name\": \"Notify: Review feedback\",\r\n      \"type\": \"n8n-nodes-base.httpRequest\",\r\n      \"typeVersion\": 4.2,\r\n      \"position\": [\r\n        1780,\r\n        480\r\n      ],\r\n      \"parameters\": {\r\n        \"method\": \"POST\",\r\n        \"url\": \"={{ $env.OPENWEBUI_CALLBACK_URL }}\",\r\n        \"sendHeaders\": true,\r\n        \"headerParameters\": {\r\n          \"parameters\": [\r\n            {\r\n              \"name\": \"Content-Type\",\r\n              \"value\": \"application/json\"\r\n            }\r\n          ]\r\n        },\r\n        \"sendBody\": true,\r\n        \"bodyParameters\": {\r\n          \"parameters\": [\r\n            {\r\n              \"name\": \"flow_id\",\r\n              \"value\": \"={{ $node[\\\"Extract MR Info\\\"].json.flow_id ?? '' }}\"\r\n            },\r\n            {\r\n              \"name\": \"message\",\r\n              \"value\": \"=🔄 MR {{ $node[\\\"Extract MR Info\\\"].json.mr_iid }} needs changes — attempt {{ $json.attempt_count }}/3{{ $json.status !== 'success' ? ' — CI pipeline ' + $json.status + ($json.pipeline_url ? ' (' + $json.pipeline_url + ')' : '') : '' }}{{ $json.tl_result === 'APPROVE' \u0026\u0026 $json.status !== 'success' ? ' — TL approved the code, this is blocked on CI only' : '' }}\"\r\n            },\r\n            {\r\n              \"name\": \"notes\",\r\n              \"value\": \"={{ $json.tl_notes || '' }}\"\r\n            }\r\n          ]\r\n        }\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"bca280de-b215-4aaf-b10b-4fb7c032d3bb\",\r\n      \"name\": \"→ Escalate\",\r\n      \"type\": \"n8n-nodes-base.httpRequest\",\r\n      \"typeVersion\": 4.2,\r\n      \"position\": [\r\n        1780,\r\n        560\r\n      ],\r\n      \"parameters\": {\r\n        \"method\": \"POST\",\r\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/escalate\",\r\n        \"sendBody\": true,\r\n        \"bodyParameters\": {\r\n          \"parameters\": [\r\n            {\r\n              \"name\": \"reason\",\r\n              \"value\": \"=MR {{ $node[\\\"Extract MR Info\\\"].json.mr_iid }} (Kaneo task {{ $node[\\\"Extract MR Info\\\"].json.task_iid }}) exceeded 3 review attempts\"\r\n            }\r\n          ]\r\n        }\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"c7a1a001-0000-0000-0000-000000000002\",\r\n      \"name\": \"Comment MR: Handover\",\r\n      \"type\": \"n8n-nodes-base.httpRequest\",\r\n      \"typeVersion\": 4.2,\r\n      \"position\": [\r\n        1780,\r\n        640\r\n      ],\r\n      \"parameters\": {\r\n        \"method\": \"POST\",\r\n        \"url\": \"={{ $env.GITLAB_URL }}/api/v4/projects/{{ $node['Webhook Trigger'].json.body.project?.id ?? $env.GITLAB_PROJECT_ID }}/merge_requests/{{ $node[\\\"Extract MR Info\\\"].json.mr_iid }}/notes\",\r\n        \"authentication\": \"none\",\r\n        \"sendHeaders\": true,\r\n        \"headerParameters\": {\r\n          \"parameters\": [\r\n            {\r\n              \"name\": \"PRIVATE-TOKEN\",\r\n              \"value\": \"={{ $env.GITLAB_TOKEN_TECH_LEAD || $env.GITLAB_TOKEN }}\"\r\n            },\r\n            {\r\n              \"name\": \"Content-Type\",\r\n              \"value\": \"application/json\"\r\n            }\r\n          ]\r\n        },\r\n        \"sendBody\": true,\r\n        \"bodyParameters\": {\r\n          \"parameters\": [\r\n            {\r\n              \"name\": \"body\",\r\n              \"value\": \"=⚠️ TL review has gone through 3 attempts without reaching APPROVE+green-CI — handing this MR over to a human reviewer. Last TL verdict: `{{ $json.tl_result }}`{{ $json.status !== 'success' ? ' — CI pipeline ' + $json.status + ($json.pipeline_url ? ' (' + $json.pipeline_url + ')' : '') : '' }}. See Kaneo task {{ $node[\\\"Extract MR Info\\\"].json.task_iid }} for the full review history.\"\r\n            }\r\n          ]\r\n        }\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"c7a1a001-0000-0000-0000-000000000003\",\r\n      \"name\": \"Comment Kaneo: Handover\",\r\n      \"type\": \"n8n-nodes-base.code\",\r\n      \"typeVersion\": 2,\r\n      \"position\": [\r\n        1780,\r\n        720\r\n      ],\r\n      \"parameters\": {\r\n        \"jsCode\": \"const kaneoAuth = { Authorization: `Bearer ${$env.KANEO_TOKEN}` };\\nconst id = $node[\\\"Extract MR Info\\\"].json.task_iid;\\nconst mrIid = $node[\\\"Extract MR Info\\\"].json.mr_iid;\\nconst content = `⚠️ TL review failed 3 times on MR !${mrIid} — handing over to a human reviewer for manual review and merge decision. Last TL verdict: ${$json.tl_result}${$json.status !== 'success' ? ' — CI pipeline ' + $json.status : ''}.`;\\n// ponytail: verify this comment path against the deployed Kaneo version.\\nawait this.helpers.httpRequest({ method: 'POST', url: `${$env.KANEO_URL}/api/task/${id}/comment`, headers: { ...kaneoAuth, 'Content-Type': 'application/json' }, body: { content }, json: true });\\nreturn [{ json: $json }];\"\r\n      }\r\n    },\r\n    {\r\n      \"id\": \"9f7b1556-3932-4a73-9cc3-c991ff062f64\",\r\n      \"name\": \"Notify: MR approved\",\r\n      \"type\": \"n8n-nodes-base.httpRequest\",\r\n      \"typeVersion\": 4.2,\r\n      \"position\": [\r\n        1780,\r\n        200\r\n      ],\r\n      \"parameters\": {\r\n        \"method\": \"POST\",\r\n        \"url\": \"={{ $env.OPENWEBUI_CALLBACK_URL }}\",\r\n        \"sendHeaders\": true,\r\n        \"headerParameters\": {\r\n          \"parameters\": [\r\n            {\r\n              \"name\": \"Content-Type\",\r\n              \"value\": \"application/json\"\r\n            }\r\n          ]\r\n        },\r\n        \"sendBody\": true,\r\n        \"bodyParameters\": {\r\n          \"parameters\": [\r\n            {\r\n              \"name\": \"flow_id\",\r\n              \"value\": \"={{ $node[\\\"Extract MR Info\\\"].json.flow_id ?? '' }}\"\r\n            },\r\n            {\r\n              \"name\": \"message\",\r\n              \"value\": \"✅ Task MR {{ $node[\\\"Extract MR Info\\\"].json.mr_iid }} approved and merged — TL review + unit tests + static analysis (biome/tsc) + SonarQube all passed\"\r\n            },\r\n            {\r\n              \"name\": \"notes\",\r\n              \"value\": \"\"\r\n            }\r\n          ]\r\n        }\r\n      }\r\n    }\r\n  ],\r\n  \"connections\": {\r\n    \"Webhook Trigger\": {\r\n      \"main\": [\r\n        [\r\n          {\r\n            \"node\": \"Extract MR Info\",\r\n            \"type\": \"main\",\r\n            \"index\": 0\r\n          }\r\n        ]\r\n      ]\r\n    },\r\n    \"Extract MR Info\": {\r\n      \"main\": [\r\n        [\r\n          {\r\n            \"node\": \"Notify: Task MR opened\",\r\n            \"type\": \"main\",\r\n            \"index\": 0\r\n          }\r\n        ]\r\n      ]\r\n    },\r\n    \"Notify: Task MR opened\": {\r\n      \"main\": [\r\n        [\r\n          {\r\n            \"node\": \"TL Review Input\",\r\n            \"type\": \"main\",\r\n            \"index\": 0\r\n          },\r\n          {\r\n            \"node\": \"Set CI Deadline\",\r\n            \"type\": \"main\",\r\n            \"index\": 0\r\n          }\r\n        ]\r\n      ]\r\n    },\r\n    \"Set CI Deadline\": {\r\n      \"main\": [\r\n        [\r\n          {\r\n            \"node\": \"Wait CI Result\",\r\n            \"type\": \"main\",\r\n            \"index\": 0\r\n          }\r\n        ]\r\n      ]\r\n    },\r\n    \"Wait CI Result\": {\r\n      \"main\": [\r\n        [\r\n          {\r\n            \"node\": \"Check CI Status\",\r\n            \"type\": \"main\",\r\n            \"index\": 0\r\n          }\r\n        ]\r\n      ]\r\n    },\r\n    \"Check CI Status\": {\r\n      \"main\": [\r\n        [\r\n          {\r\n            \"node\": \"CI Done?\",\r\n            \"type\": \"main\",\r\n            \"index\": 0\r\n          }\r\n        ]\r\n      ]\r\n    },\r\n    \"CI Done?\": {\r\n      \"main\": [\r\n        [\r\n          {\r\n            \"node\": \"Merge TL+CI\",\r\n            \"type\": \"main\",\r\n            \"index\": 1\r\n          }\r\n        ],\r\n        [\r\n          {\r\n            \"node\": \"Wait CI Result\",\r\n            \"type\": \"main\",\r\n            \"index\": 0\r\n          }\r\n        ]\r\n      ]\r\n    },\r\n    \"TL Review Input\": {\r\n      \"main\": [\r\n        [\r\n          {\r\n            \"node\": \"TL: MR Review\",\r\n            \"type\": \"main\",\r\n            \"index\": 0\r\n          }\r\n        ]\r\n      ]\r\n    },\r\n    \"TL: MR Review\": {\r\n      \"main\": [\r\n        [\r\n          {\r\n            \"node\": \"Parse TL Review\",\r\n            \"type\": \"main\",\r\n            \"index\": 0\r\n          }\r\n        ]\r\n      ]\r\n    },\r\n    \"Parse TL Review\": {\r\n      \"main\": [\r\n        [\r\n          {\r\n            \"node\": \"Merge TL+CI\",\r\n            \"type\": \"main\",\r\n            \"index\": 0\r\n          }\r\n        ]\r\n      ]\r\n    },\r\n    \"Merge TL+CI\": {\r\n      \"main\": [\r\n        [\r\n          {\r\n            \"node\": \"All Passed?\",\r\n            \"type\": \"main\",\r\n       