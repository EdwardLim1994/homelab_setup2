ta"}],[{"type":"get_attr","value":"data"}]]}]},{"mode":"managed","type":"helm_release","name":"ansible","provider":"provider[\"registry.opentofu.org/hashicorp/helm\"]","instances":[{"schema_version":1,"attributes":{"atomic":false,"chart":"./../../helm/ansible","cleanup_on_fail":false,"create_namespace":false,"dependency_update":false,"description":null,"devel":null,"disable_crd_hooks":false,"disable_openapi_validation":false,"disable_webhooks":false,"force_update":false,"id":"ansible","keyring":null,"lint":false,"manifest":null,"max_history":0,"metadata":[{"app_version":"","chart":"ansible","first_deployed":1789017134,"last_deployed":1791430090,"name":"ansible","namespace":"ansible","notes":"","revision":44,"values":"{\"chartHash\":\"af4b3ffd377de60ea8a45257bc8055f2e2753912\"}","version":"0.1.0"}],"name":"ansible","namespace":"ansible","pass_credentials":false,"postrender":[],"recreate_pods":false,"render_subchart_notes":true,"replace":false,"repository":null,"repository_ca_file":null,"repository_cert_file":null,"repository_key_file":null,"repository_password":null,"repository_username":null,"reset_values":false,"reuse_values":false,"set":[{"name":"chartHash","type":"","value":"af4b3ffd377de60ea8a45257bc8055f2e2753912"}],"set_list":[],"set_sensitive":[],"skip_crds":false,"status":"deployed","timeout":300,"upgrade_install":null,"values":null,"verify":false,"version":"0.1.0","wait":false,"wait_for_jobs":false},"sensitive_attributes":[[{"type":"get_attr","value":"repository_password"}]],"private":"eyJzY2hlbWFfdmVyc2lvbiI6IjEifQ==","dependencies":["kubernetes_config_map.ansible_n8n_flows","kubernetes_config_map.ansible_pipe","kubernetes_namespace.ansible","kubernetes_secret.ansible_secrets"]}]},{"mode":"managed","type":"helm_release","name":"argocd","provider":"provider[\"registry.opentofu.org/hashicorp/helm\"]","instances":[{"schema_version":1,"attributes":{"atomic":false,"chart":"./../../helm/argocd","cleanup_on_fail":false,"create_namespace":false,"dependency_update":true,"description":null,"devel":null,"disable_crd_hooks":false,"disable_openapi_validation":false,"disable_webhooks":false,"force_update":false,"id":"argocd","keyring":null,"lint":false,"manifest":null,"max_history":0,"metadata":[{"app_version":"","chart":"argocd","first_deployed":1789017132,"last_deployed":1790512811,"name":"argocd","namespace":"argocd","notes":"\nIn order to access the server UI you have the following options:\n\n1. kubectl port-forward service/argocd-server -n argocd 8080:443\n\n    and then open the browser on http://localhost:8080 and accept the certificate\n\n2. enable ingress in the values file `server.ingress.enabled` and either\n      - Add the annotation for ssl passthrough: https://argo-cd.readthedocs.io/en/stable/operator-manual/ingress/#option-1-ssl-passthrough\n      - Set the `configs.params.\"server.insecure\"` in the values file and terminate SSL at your ingress: https://argo-cd.readthedocs.io/en/stable/operator-manual/ingress/#option-2-multiple-ingress-objects-and-hosts\n\n\nAfter reaching the UI the first time you can login with username: admin and the random password generated during the installation. You can find the password by running:\n\nkubectl -n argocd get secret argocd-initial-admin-secret -o jsonpath=\"{.data.password}\" | base64 -d\n\n(You should delete the initial secret afterwards as suggested by the Getting Started Guide: https://argo-cd.readthedocs.io/en/stable/getting_started/#4-login-using-the-cli)\n","revision":8,"values":"{\"argo-cd\":{\"applicationSet\":{\"resources\":{\"limits\":{\"memory\":\"128Mi\"},\"requests\":{\"cpu\":\"10m\",\"memory\":\"64Mi\"}}},\"configs\":{\"cm\":{\"accounts.admin\":\"apiKey, login\",\"oidc.config\":\"name: Authentik\\nissuer: https://authentik.tail60240b.ts.net/application/o/argocd/\\nclientID: dev-argocd-oidc-client-id\\nclientSecret: dev-argocd-oidc-client-secret-not-for-prod-use\\nrequestedScopes:\\n  - openid\\n  - profile\\n  - email\\n\",\"url\":\"https://argocd.tail60240b.ts.net\"},\"params\":{\"server.insecure\":true},\"rbac\":{\"policy.csv\":\"g, edwardlimkoksiong1994@gmail.com, role:admin\\n\",\"policy.default\":\"role:readonly\",\"scopes\":\"[email]\"}},\"controller\":{\"resources\":{\"limits\":{\"memory\":\"512Mi\"},\"requests\":{\"cpu\":\"50m\",\"memory\":\"256Mi\"}}},\"dex\":{\"enabled\":false},\"notifications\":{\"enabled\":false},\"redis\":{\"resources\":{\"limits\":{\"memory\":\"128Mi\"},\"requests\":{\"cpu\":\"10m\",\"memory\":\"64Mi\"}}},\"repoServer\":{\"resources\":{\"limits\":{\"memory\":\"256Mi\"},\"requests\":{\"cpu\":\"50m\",\"memory\":\"128Mi\"}}},\"server\":{\"ingress\":{\"annotations\":{\"cert-manager.io/cluster-issuer\":\"homelab-ca-issuer\"},\"enabled\":true,\"hosts\":[\"argocd.local\"],\"ingressClassName\":\"traefik\",\"tls\":[{\"hosts\":[\"argocd.local\"],\"secretName\":\"argocd.local-tls\"}]},\"initContainers\":[{\"command\":[\"sh\",\"-c\",\"apk add --no-cache ca-certificates \\u003e/dev/null 2\\u003e\\u00261\\ncp /etc/ssl/certs/ca-certificates.crt /combined/ca-certificates.crt\\n[ -f /homelab-ca/ca.crt ] \\u0026\\u0026 cat /homelab-ca/ca.crt \\u003e\\u003e /combined/ca-certificates.crt\\nexit 0\\n\"],\"image\":\"alpine:3\",\"name\":\"combine-certs\",\"volumeMounts\":[{\"mountPath\":\"/homelab-ca\",\"name\":\"homelab-ca\",\"readOnly\":true},{\"mountPath\":\"/combined\",\"name\":\"combined-ca\"}]}],\"resources\":{\"limits\":{\"memory\":\"256Mi\"},\"requests\":{\"cpu\":\"50m\",\"memory\":\"128Mi\"}},\"volumeMounts\":[{\"mountPath\":\"/etc/ssl/certs/ca-certificates.crt\",\"name\":\"combined-ca\",\"subPath\":\"ca-certificates.crt\"}],\"volumes\":[{\"name\":\"homelab-ca\",\"secret\":{\"optional\":true,\"secretName\":\"homelab-ca\"}},{\"emptyDir\":{},\"name\":\"combined-ca\"}]}},\"argocd-image-updater\":{\"config\":{\"argocd\":{\"grpcWeb\":true,\"insecure\":true,\"serverAddress\":\"argocd-server.argocd.svc.cluster.local:80\",\"token\":\"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJhcmdvY2QiLCJzdWIiOiJhZG1pbjphcGlLZXkiLCJuYmYiOjE3ODk5NzE2ODMsImlhdCI6MTc4OTk3MTY4MywianRpIjoiNzJmMDc4MDItYWE3MC00ZTEzLThhNzQtM2ZmY2YyNzBkZTAwIn0.xkz3Jje70AUIDstoBdHPNzAFm4Z0_VawviIbiGvhF8Q\"},\"registries\":[{\"api_url\":\"http://harbor.harbor.svc.cluster.local:80\",\"credentials\":\"secret:argocd/argocd-image-updater-registry#creds\",\"insecure\":true,\"name\":\"in-cluster-harbor\",\"prefix\":\"harbor.harbor.svc.cluster.local:80\"}]},\"resources\":{\"limits\":{\"memory\":\"128Mi\"},\"requests\":{\"cpu\":\"10m\",\"memory\":\"64Mi\"}}}}","version":"0.1.0"}],"name":"argocd","namespace":"argocd","pass_credentials":false,"postrender":[],"recreate_pods":false,"render_subchart_notes":true,"replace":false,"repository":null,"repository_ca_file":null,"repository_cert_file":null,"repository_key_file":null,"repository_password":null,"repository_username":null,"reset_values":false,"reuse_values":false,"set":[],"set_list":[],"set_sensitive":[],"skip_crds":false,"status":"deployed","timeout":600,"upgrade_install":null,"values":["argo-cd:\n  # ponytail: Dex is an OIDC proxy that ArgoCD bundles for providers that\n  # don't support OIDC natively. Authentik speaks OIDC directly, so Dex is\n  # dead weight here.\n  dex:\n    enabled: false\n\n  # ponytail: notifications controller is off — no alerting infra in this\n  # homelab. Enable when you wire up Slack/email webhooks.\n  notifications:\n    enabled: false\n\n  server:\n    # ponytail: Traefik terminates TLS at the ingress; ArgoCD server runs\n    # plain HTTP internally. Without --insecure the server redirects to its\n    # own HTTPS port which Traefik never sends traffic to.\n    ingress:\n      enabled: true\n      ingressClassName: traefik\n      annotations:\n        cert-manager.io/cluster-issuer: homelab-ca-issuer\n      hosts:\n        - argocd.local\n      tls:\n        - secretName: argocd.local-tls\n          hosts:\n            - argocd.local\n    resources:\n      requests:\n        cpu: 50m\n        memory: 128Mi\n      limits:\n        memory: 256Mi\n    # ponytail: oidc.config's issuer must stay the external tailnet URL (it's\n    # what Authentik puts in the token's `iss` claim and what the browser\n    # redirects to) — ArgoCD's built-in OIDC client has no split\n    # discovery-vs-browser endpoint like gitlab/grafana/litellm use, so unlike\n    # them argocd-server must actually trust the homelab CA to fetch\n    # .well-known/openid-configuration over that tailnet HTTPS (coredns.tf\n    # rewrites it to in-cluster traefik, which serves a homelab-CA cert).\n    # Same combine-and-overwrite-the-system-bundle trick as openwebui's\n    # init container, targeted at the Debian path Go's x509 reads by default\n    # (so this doesn't clobber public-CA trust for git-over-HTTPS etc, unlike\n    # setting SSL_CERT_FILE, which replaces rather than appends on Go/Linux).\n    volumes:\n      - name: homelab-ca\n        secret:\n          secretName: homelab-ca\n          optional: true\n      - name: combined-ca\n        emptyDir: {}\n    initContainers:\n      - name: combine-certs\n        image: alpine:3\n        command:\n          - sh\n          - -c\n          - |\n            apk add --no-cache ca-certificates \u003e/dev/null 2\u003e\u00261\n            cp /etc/ssl/certs/ca-certificates.crt /combined/ca-certificates.crt\n            [ -f /homelab-ca/ca.crt ] \u0026\u0026 cat /homelab-ca/ca.crt \u003e\u003e /combined/ca-certificates.crt\n            exit 0\n        volumeMounts:\n          - name: homelab-ca\n            mountPath: /homelab-ca\n            readOnly: true\n          - name: combined-ca\n            mountPath: /combined\n    volumeMounts:\n      - name: combined-ca\n        mountPath: /etc/ssl/certs/ca-certificates.crt\n        subPath: ca-certificates.crt\n\n  controller:\n    resources:\n      requests:\n        cpu: 50m\n        memory: 256Mi\n      limits:\n        memory: 512Mi\n\n  repoServer:\n    resources:\n      requests:\n        cpu: 50m\n        memory: 128Mi\n      limits:\n        memory: 256Mi\n\n  applicationSet:\n    resources:\n      requests:\n        cpu: 10m\n        memory: 64Mi\n      limits:\n        memory: 128Mi\n\n  redis:\n    resources:\n      requests:\n        cpu: 10m\n        memory: 64Mi\n      limits:\n        memory: 128Mi\n\n  configs:\n    params:\n      # ponytail: run HTTP internally; Traefik ingress handles TLS termination\n      server.insecure: true\n\n    cm:\n      # ponytail: n8n's F-10/F-21/F-27 flows call the ArgoCD API directly\n      # (sync triggers, cluster-lifecycle) — apiKey capability lets `admin`\n      # mint a non-expiring token via `/api/v1/account/admin/token` for that,\n      # separate from interactive OIDC login.\n      accounts.admin: \"apiKey, login\"\n      # ponytail: url must match the external Tailscale URL — ArgoCD embeds\n      # it in the OIDC redirect_uri sent to Authentik. Wrong url = callback\n      # mismatch error after login.\n      url: \"https://argocd.tail60240b.ts.net\"\n      # ponytail: oidc.config drives ArgoCD's built-in OIDC client (no Dex).\n      # clientSecret is plain text here (ConfigMap, not Secret) because helm\n      # template base64-encodes Secret values before rendered.replace() runs —\n      # the placeholder would never match. Homelab trade-off: acceptable.\n      oidc.config: |\n        name: Authentik\n        issuer: https://authentik.tail60240b.ts.net/application/o/argocd/\n        clientID: dev-argocd-oidc-client-id\n        clientSecret: dev-argocd-oidc-client-secret-not-for-prod-use\n        requestedScopes:\n          - openid\n          - profile\n          - email\n\n    rbac:\n      # ponytail: scopes tells ArgoCD which OIDC token claims to use as group\n      # subjects for RBAC matching. '[email]' means policy.csv entries like\n      # \"g, user@example.com, role:admin\" match against the email claim.\n      scopes: '[email]'\n      policy.default: role:readonly\n      policy.csv: |\n        g, edwardlimkoksiong1994@gmail.com, role:admin\n\n# ponytail: image-updater polls the registries on each app's\n# argocd-image-updater.argoproj.io/image-list annotation and patches the\n# running Application's image tag directly via the ArgoCD API\n# (writeBackMethod defaults to \"argocd\", not git) — no git commit, no\n# separate CI step, no kickoff-flow re-run needed per release.\nargocd-image-updater:\n  config:\n    argocd:\n      serverAddress: argocd-server.argocd.svc.cluster.local:80\n      # ponytail: server.insecure=true above means plain HTTP + grpc-web\n      insecure: true\n      grpcWeb: true\n      # ponytail: reuse the same long-lived admin token n8n already uses\n      # (F-10/F-21/F-27 ARGOCD_TOKEN) instead of minting a second one.\n      token: \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJhcmdvY2QiLCJzdWIiOiJhZG1pbjphcGlLZXkiLCJuYmYiOjE3ODk5NzE2ODMsImlhdCI6MTc4OTk3MTY4MywianRpIjoiNzJmMDc4MDItYWE3MC00ZTEzLThhNzQtM2ZmY2YyNzBkZTAwIn0.xkz3Jje70AUIDstoBdHPNzAFm4Z0_VawviIbiGvhF8Q\"\n    registries:\n      - name: in-cluster-harbor\n        api_url: http://harbor.harbor.svc.cluster.local:80\n        prefix: harbor.harbor.svc.cluster.local:80\n        insecure: true\n        credentials: secret:argocd/argocd-image-updater-registry#creds\n  resources:\n    requests:\n      cpu: 10m\n      memory: 64Mi\n    limits:\n      memory: 128Mi\n"],"verify":false,"version":"0.1.0","wait":true,"wait_for_jobs":false},"sensitive_attributes":[[{"type":"get_attr","value":"repository_password"}],[{"type":"get_attr","value":"values"},{"type":"index","value":{"value":0,"type":"number"}}]],"private":"eyJzY2hlbWFfdmVyc2lvbiI6IjEifQ==","dependencies":["data.kubernetes_secret.homelab_ca_argocd","helm_release.cert_manager","kubectl_manifest.homelab_ca","kubectl_manifest.selfsigned_bootstrap","kubernetes_namespace.argocd","kubernetes_namespace.cert_manager","kubernetes_secret.argocd_homelab_ca","null_resource.homelab_ca_ready"]}]},{"mode":"managed","type":"helm_release","name":"authentik","provider":"provider[\"registry.opentofu.org/hashicorp/helm\"]","instances":[{"schema_version":1,"attributes":{"atomic":false,"chart":"./../../helm/authentik","cleanup_on_fail":false,"create_namespace":false,"dependency_update":true,"description":null,"devel":null,"disable_crd_hooks":false,"disable_openapi_validation":false,"disable_webhooks":false,"force_update":false,"id":"authentik","keyring":null,"lint":false,"manifest":null,"max_history":0,"metadata":[{"app_version":"","chart":"authentik","first_deployed":1789018628,"last_deployed":1790595020,"name":"authentik","namespace":"authentik","notes":"Run the commands below to get a kubeconfig file for authentik:\n\nKUBE_API=$(kubectl config view --minify --output jsonpath=\"{.clusters[*].cluster.server}\")\nNAMESPACE=authentik\nSECRET_NAME=$(kubectl get serviceaccount authentik -o jsonpath='{.secrets[0].name}' 2\u003e/dev/null || echo -n \"authentik\")\nKUBE_CA=$(kubectl -n $NAMESPACE get secret/$SECRET_NAME -o jsonpath='{.data.ca\\.crt}')\nKUBE_TOKEN=$(kubectl -n $NAMESPACE get secret/$SECRET_NAME -o jsonpath='{.data.token}' | base64 --decode)\n\necho \"apiVersion: v1\nkind: Config\nclusters:\n- name: default-cluster\n  cluster:\n    certificate-authority-data: ${KUBE_CA}\n    server: ${KUBE_API}\ncontexts:\n- name: default-context\n  context:\n    cluster: default-cluster\n    namespace: $NAMESPACE\n    user: authentik-user\ncurrent-context: default-context\nusers:\n- name: authentik-user\n  user:\n    token: ${KUBE_TOKEN}\"\n","revision":3,"values":"{\"authentik\":{\"authentik\":{\"log_level\":\"info\",\"postgresql\":{\"host\":\"postgres.postgres.svc.cluster.local\",\"name\":\"authentik\",\"password\":\"(sensitive value)\",\"user\":\"authentik\"},\"redis\":{\"db\":1,\"host\":\"redis.redis.svc.cluster.local\"},\"secret_key\":\"(sensitive value)\"},\"global\":{\"env\":[{\"name\":\"AUTHENTIK_BOOTSTRAP_TOKEN\",\"value\":\"dev-authentik-bootstrap-token-not-for-prod-use\"},{\"name\":\"AUTHENTIK_BOOTSTRAP_PASSWORD\",\"value\":\"Admin1234!\"},{\"name\":\"AUTHENTIK_BOOTSTRAP_EMAIL\",\"value\":\"akadmin@authentik.local\"},{\"name\":\"GITHUB_OAUTH_CLIENT_ID\",\"value\":\"Ov23li7sHVJbV4ziaPII\"},{\"name\":\"GITHUB_OAUTH_CLIENT_SECRET\",\"value\":\"af73a65d4f17db2a356b47dd2faee77dbcabcaf1\"}]},\"postgresql\":{\"enabled\":false},\"redis\":{\"enabled\":false},\"server\":{\"ingress\":{\"annotations\":{\"cert-manager.io/cluster-issuer\":\"homelab-ca-issuer\"},\"enabled\":true,\"hosts\":[\"authentik.local\"],\"ingressClassName\":\"traefik\",\"tls\":[{\"hosts\":[\"authentik.local\"],\"secretName\":\"authentik-tls\"}]},\"replicas\":1,\"resources\":{\"limits\":{\"memory\":\"1Gi\"},\"requests\":{\"cpu\":\"100m\",\"memory\":\"512Mi\"}}},\"worker\":{\"replicas\":1,\"resources\":{\"limits\":{\"memory\":\"1Gi\"},\"requests\":{\"cpu\":\"50m\",\"memory\":\"512Mi\"}}}}}","version":"0.1.0"}],"name":"authentik","namespace":"authentik","pass_credentials":false,"postrender":[],"recreate_pods":false,"render_subchart_notes":true,"replace":false,"repository":null,"repository_ca_file":null,"repository_cert_file":null,"repository_key_file":null,"repository_password":null,"repository_username":null,"reset_values":false,"reuse_values":false,"set":[{"name":"authentik.global.env[0].name","type":"","value":"AUTHENTIK_BOOTSTRAP_TOKEN"},{"name":"authentik.global.env[1].name","type":"","value":"AUTHENTIK_BOOTSTRAP_PASSWORD"},{"name":"authentik.global.env[2].name","type":"","value":"AUTHENTIK_BOOTSTRAP_EMAIL"},{"name":"authentik.global.env[2].value","type":"","value":"akadmin@authentik.local"},{"name":"authentik.global.env[3].name","type":"","value":"GITHUB_OAUTH_CLIENT_ID"},{"name":"authentik.global.env[4].name","type":"","value":"GITHUB_OAUTH_CLIENT_SECRET"}],"set_list":[],"set_sensitive":[{"name":"authentik.authentik.postgresql.password","type":"","value":"dev-shared-db-password-not-for-prod-use"},{"name":"authentik.authentik.secret_key","type":"","value":"dev-authentik-secret-key-not-for-prod-use"},{"name":"authentik.global.env[0].value","type":"","value":"dev-authentik-bootstrap-token-not-for-prod-use"},{"name":"authentik.global.env[1].value","type":"","value":"Admin1234!"},{"name":"authentik.global.env[3].value","type":"","value":"Ov23li7sHVJbV4ziaPII"},{"name":"authentik.global.env[4].value","type":"","value":"af73a65d4f17db2a356b47dd2faee77dbcabcaf1"}],"skip_crds":false,"status":"deployed","timeout":900,"upgrade_install":null,"values":["authentik:\n  authentik:\n    secret_key: \"\"  # set via terraform variable\n    log_level: info\n    # ponytail: shared postgres (helm/postgres, db+role `authentik`) and shared\n    # redis (helm/redis, logical DB 1 — GitLab keeps DB 0). The goauthentik\n    # chart's bundled bitnami subcharts stay off.\n    postgresql:\n      host: \"postgres.postgres.svc.cluster.local\"\n      name: \"authentik\"\n      user: \"authentik\"\n      password: \"\"  # set via terraform (shared_db_password)\n    redis:\n      host: \"redis.redis.svc.cluster.local\"\n      db: 1\n\n  postgresql:\n    enabled: false\n  redis:\n    enabled: false\n\n  server:\n    replicas: 1\n    resources:\n      requests:\n        cpu: 100m\n        memory: 512Mi\n      limits:\n        memory: 1Gi\n    ingress:\n      enabled: true\n      ingressClassName: traefik\n      annotations:\n        cert-manager.io/cluster-issuer: homelab-ca-issuer\n      hosts:\n        - authentik.local\n      tls:\n        - secretName: authentik-tls\n          hosts:\n            - authentik.local\n\n  worker:\n    replicas: 1\n    resources:\n      requests:\n        cpu: 50m\n        memory: 512Mi\n      limits:\n        memory: 1Gi\n\n"],"verify":false,"version":"0.1.0","wait":true,"wait_for_jobs":false},"sensitive_attributes":[[{"type":"get_attr","value":"repository_password"}],[{"type":"get_attr","value":"set_sensitive"}]],"private":"eyJzY2hlbWFfdmVyc2lvbiI6IjEifQ==","dependencies":["helm_release.cert_manager","helm_release.postgres","helm_release.redis","kubectl_manifest.homelab_ca","kubectl_manifest.homelab_ca_issuer","kubectl_manifest.selfsigned_bootstrap","kubernetes_namespace.authentik","kubernetes_namespace.cert_manager","kubernetes_namespace.postgres","kubernetes_namespace.redis"]}]},{"mode":"managed","type":"helm_release","name":"cert_manager","provider":"provider[\"registry.opentofu.org/hashicorp/helm\"]","instances":[{"schema_version":1,"attributes":{"atomic":false,"chart":"./../../helm/cert-manager","cleanup_on_fail":false,"create_namespace":false,"dependency_update":true,"description":null,"devel":null,"disable_crd_hooks":false,"disable_openapi_validation":false,"disable_webhooks":false,"force_update":false,"id":"cert-manager","keyring":null,"lint":false,"manifest":null,"max_history":0,"metadata":[{"app_version":"","chart":"cert-manager","first_deployed":1789017132,"last_deployed":1790069321,"name":"cert-manager","namespace":"cert-manager","notes":"\ncert-manager v1.21.1 has been deployed successfully!\n\nIn order to begin issuing certificates, you will need to set up a ClusterIssuer\nor Issuer resource (for example, by creating a 'letsencrypt-staging' issuer).\n\nMore information on the different types of issuers and how to configure them\ncan be found in our documentation:\n\nhttps://cert-manager.io/docs/configuration/\n\nFor information on how to configure cert-manager to automatically provision\nCertificates for Ingress resources, take a look at the `ingress-shim`\ndocumentation:\n\nhttps://cert-manager.io/docs/usage/ingress/\n\nFor information on how to configure cert-manager to automatically provision\nCertificates for Gateway API resources, take a look at the `gateway resource`\ndocumentation:\n\nhttps://cert-manager.io/docs/usage/gateway/\n","revision":2,"values":"{\"cert-manager\":{\"cainjector\":{\"resources\":{\"limits\":{\"memory\":\"128Mi\"},\"requests\":{\"cpu\":\"25m\",\"memory\":\"64Mi\"}}},\"crds\":{\"enabled\":true},\"resources\":{\"limits\":{\"memory\":\"128Mi\"},\"requests\":{\"cpu\":\"25m\",\"memory\":\"64Mi\"}},\"webhook\":{\"resources\":{\"limits\":{\"memory\":\"64Mi\"},\"requests\":{\"cpu\":\"25m\",\"memory\":\"32Mi\"}}}}}","version":"0.1.0"}],"name":"cert-manager","namespace":"cert-manager","pass_credentials":false,"postrender":[],"recreate_pods":false,"render_subchart_notes":true,"replace":false,"repository":null,"repository_ca_file":null,"repository_cert_file":null,"repository_key_file":null,"repository_password":null,"repository_username":null,"reset_values":false,"reuse_values":false,"set":[],"set_list":[],"set_sensitive":[],"skip_crds":false,"status":"deployed","timeout":300,"upgrade_install":null,"values":["cert-manager:\r\n  crds:\r\n    enabled: true\r\n  resources:\r\n    requests:\r\n      cpu: 25m\r\n      memory: 64Mi\r\n    limits:\r\n      memory: 128Mi\r\n  webhook:\r\n    resources:\r\n      requests:\r\n        cpu: 25m\r\n        memory: 32Mi\r\n      limits:\r\n        memory: 64Mi\r\n  cainjector:\r\n    resources:\r\n      requests:\r\n        cpu: 25m\r\n        memory: 64Mi\r\n      limits:\r\n        memory: 128Mi\r\n"],"verify":false,"version":"0.1.0","wait":true,"wait_for_jobs":false},"sensitive_attributes":[[{"type":"get_attr","value":"repository_password"}]],"private":"eyJzY2hlbWFfdmVyc2lvbiI6IjEifQ==","dependencies":["kubernetes_namespace.cert_manager"]}]},{"mode":"managed","type":"helm_release","name":"gitlab","provider":"provider[\"registry.opentofu.org/hashicorp/helm\"]","instances":[{"schema_version":1,"attributes":{"atomic":false,"chart":"./../../helm/gitlab","cleanup_on_fail":false,"create_namespace":false,"dependency_update":true,"description":null,"devel":null,"disable_crd_hooks":false,"disable_openapi_validation":false,"disable_webhooks":false,"force_update":false,"id":"gitlab","keyring":null,"lint":false,"manifest":null,"max_history":0,"metadata":[{"app_version":"","chart":"gitlab","first_deployed":1789017394,"last_deployed":1790662623,"name":"gitlab","namespace":"gitlab","notes":"\nYour GitLab Runner should now be registered against the GitLab instance reachable at: http://gitlab-webservice-default.gitlab.svc.cluster.local:8181/\n\nRunner namespace \"gitlab\" was found in runners.config template.\n\n#############################################################################################\n## WARNING: You enabled `rbac` without specifying if a service account should be created.  ##\n## Please set `serviceAccount.create` to either `true` or `false`.                         ##\n## For backwards compatibility a service account will be created.                          ##\n#############################################################################################\n\n**************************************************************************\n*** PLEASE BE PATIENT: Envoy Gateway may take a few minutes to install ***\n**************************************************************************\n\nEnvoy Gateway is an open source project for managing Envoy Proxy as a standalone or Kubernetes-based application gateway.\n\nThank you for installing Envoy Gateway! 🎉\n\nYour release is named: gitlab. 🎉\n\nYour release is in namespace: gitlab. 🎉\n\nTo learn more about the release, try:\n\n  $ helm status gitlab -n gitlab\n  $ helm get all gitlab -n gitlab\n\nTo have a quickstart of Envoy Gateway, please refer to https://gateway.envoyproxy.io/latest/tasks/quickstart.\n\nTo get more details, please visit https://gateway.envoyproxy.io and https://github.com/envoyproxy/gateway.\n\n\n\n\n\n=== WARNING\nhelm:\n  GitLab chart now recommends Helm 4.0+. Please make sure to update your current Helm version v3.15.\n  Please check the release notes and test your configuration before upgrading, because Helm 3.17\n  changed how some values are being merged.\n\n=== WARNING\nThe minimum required version of PostgreSQL is now 17. See https://docs.gitlab.com/charts/installation/upgrade.html for more details.\n\n\n\n\n","revision":12,"values":"{\"gitlab\":{\"certmanager\":{\"installCRDs\":false},\"certmanager-issuer\":{\"email\":\"edwardlimkoksiong1994@gmail.com\"},\"gitlab\":{\"gitaly\":{\"resources\":{\"limits\":{\"memory\":\"512Mi\"},\"requests\":{\"cpu\":\"50m\",\"memory\":\"256Mi\"}}},\"gitlab-shell\":{\"maxReplicas\":1,\"minReplicas\":1},\"sidekiq\":{\"maxReplicas\":1,\"minReplicas\":1,\"resources\":{\"limits\":{\"memory\":\"2Gi\"},\"requests\":{\"cpu\":\"50m\",\"memory\":\"768Mi\"}}},\"toolbox\":{\"enabled\":false},\"webservice\":{\"maxReplicas\":1,\"minReplicas\":1,\"resources\":{\"limits\":{\"memory\":\"4Gi\"},\"requests\":{\"cpu\":\"100m\",\"memory\":\"1Gi\"}}}},\"gitlab-runner\":{\"gitlabUrl\":\"http://gitlab-webservice-default.gitlab.svc.cluster.local:8181/\",\"install\":true,\"rbac\":{\"create\":true},\"runners\":{\"cache\":{\"secretName\":\"gitlab-runner-cache-credentials\"},\"config\":\"[[runners]]\\n  # ponytail: CI_REPOSITORY_URL is derived from GitLab's external URL,\\n  # which job pods can't reach — force in-cluster clones.\\n  clone_url = \\\"http://gitlab-webservice-default.gitlab.svc.cluster.local:8181\\\"\\n  [runners.cache]\\n    Type = \\\"s3\\\"\\n    Shared = true\\n    [runners.cache.s3]\\n      ServerAddress = \\\"minio.minio.svc.cluster.local:9000\\\"\\n      BucketName = \\\"gitlab-runner-cache\\\"\\n      BucketLocation = \\\"us-east-1\\\"\\n      Insecure = true\\n  [runners.kubernetes]\\n    namespace = \\\"gitlab\\\"\\n    image = \\\"alpine:3.21\\\"\\n    privileged = true\\n    cpu_request = \\\"100m\\\"\\n    memory_request = \\\"256Mi\\\"\\n    cpu_limit = \\\"1\\\"\\n    memory_limit = \\\"2Gi\\\"\\n    # ponytail: shared /certs/client between build + docker:dind service\\n    [[runners.kubernetes.volumes.empty_dir]]\\n      name = \\\"docker-certs\\\"\\n      mount_path = \\\"/certs/client\\\"\\n      medium = \\\"Memory\\\"\\n  [runners.kubernetes.pod_labels]\\n    app = \\\"gitlab-ci-job\\\"\\n\",\"privileged\":true}},\"global\":{\"appConfig\":{\"artifacts\":{\"bucket\":\"gitlab-artifacts\",\"enabled\":true},\"backups\":{\"bucket\":\"gitlab-backups\"},\"ciSecureFiles\":{\"bucket\":\"gitlab-ci-secure-files\",\"enabled\":true},\"dependencyProxy\":{\"bucket\":\"gitlab-dependency-proxy\",\"enabled\":true},\"externalDiffs\":{\"bucket\":\"gitlab-mr-diffs\",\"enabled\":true},\"lfs\":{\"bucket\":\"git-lfs\",\"enabled\":true},\"object_store\":{\"connection\":{\"key\":\"connection\",\"secret\":\"gitlab-object-storage\"},\"enabled\":true},\"omniauth\":{\"allowSingleSignOn\":[\"openid_connect\"],\"autoSignInWithProvider\":\"openid_connect\",\"blockAutoCreatedUsers\":false,\"enabled\":true,\"providers\":[{\"key\":\"provider\",\"secret\":\"gitlab-omniauth-authentik\"}]},\"packages\":{\"bucket\":\"gitlab-packages\",\"enabled\":true},\"terraformState\":{\"bucket\":\"gitlab-terraform-state\",\"enabled\":true},\"uploads\":{\"bucket\":\"gitlab-uploads\",\"enabled\":true}},\"edition\":\"ce\",\"gatewayApi\":{\"enabled\":false,\"installEnvoy\":false},\"hosts\":{\"domain\":\"gitlab.local\",\"gitlab\":{\"https\":true,\"name\":\"gitlab.tail60240b.ts.net\"},\"https\":true},\"hpa\":{\"apiVersion\":\"autoscaling/v2\"},\"ingress\":{\"annotations\":{\"cert-manager.io/cluster-issuer\":\"homelab-ca-issuer\"},\"apiVersion\":\"networking.k8s.io/v1\",\"class\":\"traefik\",\"configureCertmanager\":false,\"enabled\":true,\"provider\":\"traefik\",\"tls\":{\"enabled\":true,\"secretName\":\"gitlab-tls\"}},\"initialRootPassword\":{\"secret\":\"gitlab-initial-root-password\"},\"kas\":{\"enabled\":false},\"minio\":{\"enabled\":false},\"pdb\":{\"apiVersion\":\"policy/v1\"},\"psql\":{\"database\":\"gitlabhq_production\",\"host\":\"postgres.postgres.svc.cluster.local\",\"password\":{\"key\":\"password\",\"secret\":\"gitlab-postgres-secret\"},\"port\":5432,\"username\":\"gitlab\"},\"redis\":{\"auth\":{\"enabled\":false},\"host\":\"redis.redis.svc.cluster.local\",\"port\":6379},\"registry\":{\"enabled\":true},\"traefik\":{\"apiVersion\":\"traefik.io/v1alpha1\"}},\"grafana\":{\"enabled\":false},\"installCertmanager\":false,\"nginx-ingress\":{\"enabled\":false},\"postgresql\":{\"install\":false},\"prometheus\":{\"install\":false},\"redis\":{\"install\":false},\"registry\":{\"enabled\":true,\"storage\":{\"key\":\"config\",\"secret\":\"gitlab-registry-storage\"}}}}","version":"0.2.1"}],"name":"gitlab","namespace":"gitlab","pass_credentials":false,"postrender":[],"recreate_pods":false,"render_subchart_notes":true,"replace":false,"repository":null,"repository_ca_file":null,"repository_cert_file":null,"repository_key_file":null,"repository_password":null,"repository_username":null,"reset_values":false,"reuse_values":false,"set":[{"name":"gitlab.certmanager-issuer.email","type":"","value":"edwardlimkoksiong1994@gmail.com"},{"name":"gitlab.global.appConfig.object_store.connection.key","type":"","value":"connection"},{"name":"gitlab.global.appConfig.object_store.connection.secret","type":"","value":"gitlab-object-storage"},{"name":"gitlab.global.appConfig.omniauth.allowSingleSignOn[0]","type":"","value":"openid_connect"},{"name":"gitlab.global.appConfig.omniauth.autoSignInWithProvider","type":"","value":"openid_connect"},{"name":"gitlab.global.appConfig.omniauth.blockAutoCreatedUsers","type":"","value":"false"},{"name":"gitlab.global.appConfig.omniauth.enabled","type":"","value":"true"},{"name":"gitlab.global.appConfig.omniauth.providers[0].key","type":"","value":"provider"},{"name":"gitlab.global.appConfig.omniauth.providers[0].secret","type":"","value":"gitlab-omniauth-authentik"},{"name":"gitlab.global.hosts.gitlab.https","type":"","value":"true"},{"name":"gitlab.global.hosts.gitlab.name","type":"","value":"gitlab.tail60240b.ts.net"},{"name":"gitlab.global.hosts.https","type":"","value":"true"},{"name":"gitlab.global.initialRootPassword.secret","type":"","value":"gitlab-initial-root-password"}],"set_list":[],"set_sensitive":[],"skip_crds":false,"status":"deployed","timeout":600,"upgrade_install":null,"values":["gitlab:\r\n  global:\r\n    edition: ce\r\n    hosts:\r\n      domain: gitlab.local\r\n      # ponytail: without this, hostname defaults to \"gitlab.\u003cdomain\u003e\" i.e.\r\n      # gitlab.gitlab.local (domain already includes \"gitlab\")\r\n      gitlab:\r\n        name: gitlab.local\r\n    initialRootPassword:\r\n      secret: \"\"  # set via terraform\r\n\r\n    # ponytail: re-enabled for CI docker-build/push (F-09/.gitlab-ci.yml need\r\n    # a real registry). Known ceiling: deleting a project that ever had images\r\n    # pushed still 500s on purge (Faraday::ConnectionFailed talking to the\r\n    # registry) if the registry pod is down/removed later — don't disable this\r\n    # again without also cleaning up pushed images first, or just don't delete\r\n    # projects with images.\r\n    registry:\r\n      enabled: true\r\n\r\n    # ponytail: shared postgres + redis (helm/postgres, helm/redis). db + role\r\n    # `gitlab`/`gitlabhq_production` on the shared postgres (initdb also creates\r\n    # the pg_trgm / btree_gist extensions GitLab needs). Redis: GitLab keeps its\r\n    # default logical DB 0 (all its components agree on it); authentik is moved\r\n    # to DB 1 so the two apps don't share a keyspace.\r\n    # gitlab-postgres-secret is created in terraform/gitlab.tf.\r\n    psql:\r\n      host: postgres.postgres.svc.cluster.local\r\n      port: 5432\r\n      database: gitlabhq_production\r\n      username: gitlab\r\n      password:\r\n        secret: gitlab-postgres-secret\r\n        key: password\r\n    redis:\r\n      host: redis.redis.svc.cluster.local\r\n      port: 6379\r\n      auth:\r\n        enabled: false\r\n    # ponytail: chart 10.x defaults to Gateway API (envoy-gateway subchart +\r\n    # gatewayapi.io CRDs) instead of plain Ingress -\u003e hard-fails with \"no\r\n    # matches for kind ... ensure CRDs are installed first\" since this\r\n    # cluster has neither. We stay on classic Traefik Ingress below.\r\n    gatewayApi:\r\n      enabled: false\r\n      installEnvoy: false\r\n    ingress:\r\n      enabled: true\r\n      # ponytail: helm template has no live cluster to auto-detect API\r\n      # versions from; same class of issue as the pdb/hpa overrides above\r\n      apiVersion: networking.k8s.io/v1\r\n      provider: traefik\r\n      class: traefik\r\n      annotations:\r\n        cert-manager.io/cluster-issuer: homelab-ca-issuer\r\n      tls:\r\n        enabled: true\r\n        secretName: gitlab-tls\r\n      # ponytail: defaults true independent of ingress.enabled, keeps\r\n      # spawning a cert-manager issuer job; we manage our own ClusterIssuer\r\n      configureCertmanager: false\r\n    # ponytail: backed by the standalone minio app (helm/minio), not the\r\n    # gitlab chart's own bundled minio subchart (global.minio stays\r\n    # disabled below) — connection secret wired in terraform/internal/gitlab.tf.\r\n    # Per-feature blocks below must leave `connection` empty and only set\r\n    # `bucket` for the chart to treat object_store.connection as the\r\n    # consolidated one they all inherit (see charts/gitlab/_objectStorage.tpl).\r\n    appConfig:\r\n      object_store:\r\n        enabled: true\r\n      lfs:\r\n        enabled: true\r\n        bucket: git-lfs\r\n      artifacts:\r\n        enabled: true\r\n        bucket: gitlab-artifacts\r\n      uploads:\r\n        enabled: true\r\n        bucket: gitlab-uploads\r\n      packages:\r\n        enabled: true\r\n        bucket: gitlab-packages\r\n      externalDiffs:\r\n        enabled: true\r\n        bucket: gitlab-mr-diffs\r\n      dependencyProxy:\r\n        enabled: true\r\n        bucket: gitlab-dependency-proxy\r\n      terraformState:\r\n        enabled: true\r\n        bucket: gitlab-terraform-state\r\n      ciSecureFiles:\r\n        enabled: true\r\n        bucket: gitlab-ci-secure-files\r\n      backups:\r\n        bucket: gitlab-backups\r\n    minio:\r\n      enabled: false\r\n    kas:\r\n      enabled: false\r\n    # ponytail: pin explicitly rather than rely on the chart's\r\n    # Capabilities-based API auto-detection, which can fall back to the\r\n    # long-removed policy/v1beta1 PDB kind depending on how/when it runs.\r\n    pdb:\r\n      apiVersion: policy/v1\r\n    hpa:\r\n      apiVersion: autoscaling/v2\r\n    # ponytail: gitlab-shell's SSH IngressRouteTCP only renders once\r\n    # ingress.provider is traefik; same auto-detection gap as above,\r\n    # this cluster's Traefik (v3) only registers the newer traefik.io group\r\n    traefik:\r\n      apiVersion: traefik.io/v1alpha1\r\n\r\n  registry:\r\n    enabled: true\r\n    # ponytail: chart 10.x dropped its bundled object-storage default for the\r\n    # registry (was local filesystem PVC before) -\u003e must point it at MinIO\r\n    # explicitly or the chart hard-fails at render with \"no object storage\r\n    # solution\". Secret (key: config) wired in terraform/internal/gitlab.tf,\r\n    # same MinIO backend every other gitlab feature (artifacts/lfs/uploads)\r\n    # already uses via appConfig.object_store above.\r\n    storage:\r\n      secret: gitlab-registry-storage\r\n      key: config\r\n  # ponytail: chart 9.x renamed certmanager.install -\u003e top-level\r\n  # installCertmanager. We run our own ClusterIssuer\r\n  # (global.ingress.configureCertmanager: false above) — no bundled\r\n  # cert-manager, no CRDs.\r\n  installCertmanager: false\r\n  certmanager:\r\n    installCRDs: false\r\n  nginx-ingress:\r\n    enabled: false\r\n  # ponytail: runner registers + clones over the in-cluster Service, not the\r\n  # tailnet hostname — the job/runner pods aren't on the tailnet and\r\n  # `tailscale serve` is tailnet-only, so the external URL is unreachable\r\n  # from inside k3d.\r\n  # GitLab 18 removed registration tokens: terraform/internal/gitlab.tf's\r\n  # gitlab_runner_auth_token step mints a glrt- auth token post-deploy and\r\n  # writes it into gitlab-gitlab-runner-secret (key: runner-token).\r\n  gitlab-runner:\r\n    install: true\r\n    gitlabUrl: http://gitlab-webservice-default.gitlab.svc.cluster.local:8181/\r\n    rbac:\r\n      create: true\r\n    runners:\r\n      # ponytail: privileged so `docker:dind` service containers work. k3d\r\n      # nodes already run privileged (k3s needs it), so this works on Docker\r\n      # Desktop. Prefer kaniko for image builds where you can — dind is the\r\n      # escape hatch for jobs that genuinely need the docker daemon.\r\n      privileged: true\r\n      # ponytail: distributed cache in MinIO so jobs on different runner pods\r\n      # share cache/. Secret carries the S3 creds (keys: accesskey/secretkey).\r\n      cache:\r\n        secretName: gitlab-runner-cache-credentials\r\n      config: |\r\n        [[runners]]\r\n          # ponytail: CI_REPOSITORY_URL is derived from GitLab's external URL,\r\n          # which job pods can't reach — force in-cluster clones.\r\n          clone_url = \"http://gitlab-webservice-default.gitlab.svc.cluster.local:8181\"\r\n          [runners.cache]\r\n            Type = \"s3\"\r\n            Shared = true\r\n            [runners.cache.s3]\r\n              ServerAddress = \"minio.minio.svc.cluster.local:9000\"\r\n              BucketName = \"gitlab-runner-cache\"\r\n              BucketLocation = \"us-east-1\"\r\n              Insecure = true\r\n          [runners.kubernetes]\r\n            namespace = \"gitlab\"\r\n            image = \"alpine:3.21\"\r\n            privileged = true\r\n            cpu_request = \"100m\"\r\n            memory_request = \"256Mi\"\r\n            cpu_limit = \"1\"\r\n            memory_limit = \"2Gi\"\r\n            # ponytail: shared /certs/client between build + docker:dind service\r\n            [[runners.kubernetes.volumes.empty_dir]]\r\n              name = \"docker-certs\"\r\n              mount_path = \"/certs/client\"\r\n              medium = \"Memory\"\r\n          [runners.kubernetes.pod_labels]\r\n            app = \"gitlab-ci-job\"\r\n  prometheus:\r\n    install: false\r\n  grafana:\r\n    enabled: false\r\n  gitlab:\r\n    toolbox:\r\n      enabled: false\r\n    webservice:\r\n      minReplicas: 1\r\n      maxReplicas: 1\r\n      resources:\r\n        requests:\r\n          cpu: 100m\r\n          memory: 1Gi\r\n        # ponytail: 2Gi leaves no headroom for a second Rails boot, so\r\n        # `rails runner` (gitlab-promote-admin) gets OOMKilled (exit 137) and\r\n        # the Web IDE OAuth redirect_uri realign silently never runs. 3Gi\r\n        # still wasn't enough (puma alone sits ~1.6Gi resident, a concurrent\r\n        # rails runner exec pushed it over) — bumped to 4Gi. Node has room\r\n        # (22Gi capacity, no MemoryPressure); bump back down if it doesn't.\r\n        limits:\r\n          memory: 4Gi\r\n    sidekiq:\r\n      minReplicas: 1\r\n      maxReplicas: 1\r\n      resources:\r\n        requests:\r\n          cpu: 50m\r\n          memory: 768Mi\r\n        # ponytail: 1Gi OOMKilled sidekiq mid-job (exit 137) processing a\r\n        # real CI pipeline event, leaving MergeRequests::UpdateHeadPipelineWorker\r\n        # unfinished and MR merge_status stuck at \"preparing\" forever. 2Gi fits.\r\n        limits:\r\n          memory: 2Gi\r\n    gitaly:\r\n      resources:\r\n        requests:\r\n          cpu: 50m\r\n          memory: 256Mi\r\n        limits:\r\n          memory: 512Mi\r\n    gitlab-shell:\r\n      minReplicas: 1\r\n      maxReplicas: 1\r\n\r\n  # ponytail: bundled bitnami postgresql + redis subcharts off — GitLab uses the\r\n  # shared postgres / redis (global.psql / global.redis above).\r\n  postgresql:\r\n    install: false\r\n  redis:\r\n    install: false\r\n"],"verify":false,"version":"0.2.1","wait":false,"wait_for_jobs":false},"sensitive_attributes":[[{"type":"get_attr","value":"repository_password"}]],"private":"eyJzY2hlbWFfdmVyc2lvbiI6IjEifQ==","dependencies":["helm_release.cert_manager","helm_release.postgres","helm_release.redis","kubectl_manifest.homelab_ca","kubectl_manifest.homelab_ca_issuer","kubectl_manifest.selfsigned_bootstrap","kubernetes_namespace.cert_manager","kubernetes_namespace.gitlab","kubernetes_namespace.postgres","kubernetes_namespace.redis","kubernetes_secret.gitlab_object_storage","kubernetes_secret.gitlab_omniauth_authentik","kubernetes_secret.gitlab_postgres","kubernetes_secret.gitlab_registry_storage","kubernetes_secret.gitlab_root_password","kubernetes_secret.gitlab_runner_cache_credentials"]}]},{"mode":"managed","type":"helm_release","name":"harbor","provider":"provider[\"registry.opentofu.org/hashicorp/helm\"]","instances":[{"schema_version":1,"attributes":{"atomic":false,"chart":"./../../helm/harbor","cleanup_on_fail":false,"create_namespace":false,"dependency_update":true,"description":null,"devel":null,"disable_crd_hooks":false,"disable_openapi_validation":false,"disable_webhooks":false,"force_update":false,"id":"harbor","keyring":null,"lint":false,"manifest":null,"max_history":0,"metadata":[{"app_version":"","chart":"harbor","first_deployed":1790511821,"last_deployed":1790514751,"name":"harbor","namespace":"harbor","notes":"Please wait for several minutes for Harbor deployment to complete.\nThen you should be able to visit the Harbor portal at https://harbor.tail60240b.ts.net\nFor more details, please visit https://github.com/goharbor/harbor\n","revision":2,"values":"{\"harbor\":{\"database\":{\"external\":{\"coreDatabase\":\"harbor\",\"host\":\"postgres.postgres.svc.cluster.local\",\"password\":\"dev-shared-db-password-not-for-prod-use\",\"port\":\"5432\",\"sslmode\":\"disable\",\"username\":\"harbor\"},\"type\":\"external\"},\"expose\":{\"tls\":{\"enabled\":false},\"type\":\"clusterIP\"},\"externalURL\":\"https://harbor.tail60240b.ts.net\",\"fullnameOverride\":\"harbor\",\"harborAdminPassword\":\"dev-harbor-admin-password-not-for-prod-use\",\"notary\":{\"enabled\":false},\"redis\":{\"external\":{\"addr\":\"redis.redis.svc.cluster.local:6379\",\"db\":\"2\"},\"type\":\"external\"},\"trivy\":{\"enabled\":false}}}","version":"0.1.0"}],"name":"harbor","namespace":"harbor","pass_credentials":false,"postrender":[],"recreate_pods":false,"render_subchart_notes":true,"replace":false,"repository":null,"repository_ca_file":null,"repository_cert_file":null,"repository_key_file":null,"repository_password":null,"repository_username":null,"reset_values":false,"reuse_values":false,"set":[],"set_list":[],"set_sensitive":[],"skip_crds":false,"status":"deployed","timeout":600,"upgrade_install":null,"values":["harbor:\n  fullnameOverride: \"harbor\"\n\n  # ponytail: must be the external browser-facing URL, not the in-cluster\n  # one — Harbor computes its OIDC redirect_uri FROM this value, and that\n  # redirect has to (a) be reachable by the browser and (b) match what's\n  # registered in Authentik (STRICT redirect-uri matching). This does NOT\n  # affect in-cluster CI push / image-updater / phase-cluster pulls — those\n  # connect directly to harbor.harbor.svc.cluster.local:80 regardless of\n  # what Harbor thinks its own external URL is.\n  externalURL: \"https://harbor.tail60240b.ts.net\"\n\n  harborAdminPassword: \"dev-harbor-admin-password-not-for-prod-use\"\n\n  # ponytail: no chart-owned Ingress — clusterIP only. Both the tailnet and\n  # `.local` LAN ingresses are created directly in terraform/internal/harbor.tf\n  # (same kubectl_manifest shape as tailscale-ingress.tf) pointing at the\n  # chart's own unified `harbor` Service, sidestepping this chart's own\n  # ingress value schema entirely.\n  expose:\n    type: clusterIP\n    tls:\n      enabled: false\n\n  # shared postgres (helm/postgres) — not the chart's bundled database,\n  # matching every other internal-cluster app's convention.\n  database:\n    type: external\n    external:\n      host: postgres.postgres.svc.cluster.local\n      port: \"5432\"\n      username: harbor\n      password: \"dev-shared-db-password-not-for-prod-use\"\n      coreDatabase: harbor\n      sslmode: disable\n\n  # shared redis (helm/redis) — DB 2 (gitlab=0, authentik=1, see\n  # helm/redis/values.yaml's comment).\n  redis:\n    type: external\n    external:\n      addr: \"redis.redis.svc.cluster.local:6379\"\n      db: \"2\"\n\n  # ponytail: vulnerability scanning is real extra weight (its own DB of CVEs\n  # to sync/store) a homelab registry doesn't need.\n  trivy:\n    enabled: false\n  notary:\n    enabled: false\n"],"verify":false,"version":"0.1.0","wait":true,"wait_for_jobs":false},"sensitive_attributes":[[{"type":"get_attr","value":"repository_password"}],[{"type":"get_attr","value":"values"},{"type":"index","value":{"value":0,"type":"number"}}]],"private":"eyJzY2hlbWFfdmVyc2lvbiI6IjEifQ==","dependencies":["helm_release.postgres","helm_release.redis","kubernetes_namespace.harbor","kubernetes_namespace.postgres","kubernetes_namespace.redis"]}]},{"mode":"managed","type":"helm_release","name":"kafka_ui","provider":"provider[\"registry.opentofu.org/hashicorp/helm\"]","instances":[{"schema_version":1,"attributes":{"atomic":false,"chart":"./../../helm/kafka-ui","cleanup_on_fail":false,"create_namespace":false,"dependency_update":true,"description":null,"devel":null,"disable_crd_hooks":false,"disable_openapi_validation":false,"disable_webhooks":false,"force_update":false,"id":"kafka-ui","keyring":null,"lint":false,"manifest":null,"max_history":0,"metadata":[{"app_version":"","chart":"kafka-ui","first_deployed":1790335376,"last_deployed":1790934033,"name":"kafka-ui","namespace":"kafka-ui","notes":"1. Get the application URL by running these commands:\n  export POD_NAME=$(kubectl get pods --namespace kafka-ui -l \"app.kubernetes.io/name=kafka-ui,app.kubernetes.io/instance=kafka-ui\" -o jsonpath=\"{.items[0].metadata.name}\")\n  echo \"Visit http://127.0.0.1:8080 to use your application\"\n  kubectl --namespace kafka-ui port-forward $POD_NAME 8080:8080\n","revision":3,"values":"{\"kafka-ui\":{\"fullnameOverride\":\"kafka-ui\",\"resources\":{\"limits\":{\"memory\":\"512Mi\"},\"requests\":{\"cpu\":\"50m\",\"memory\":\"256Mi\"}},\"yamlApplicationConfig\":{\"auth\":{\"oauth2\":{\"client\":{\"authentik\":{\"authorization-grant-type\":\"authorization_code\",\"authorization-uri\":\"https://authentik.tail60240b.ts.net/application/o/authorize/\",\"client-id\":\"dev-kafka-ui-oidc-client-id\",\"client-name\":\"authentik\",\"client-secret\":\"dev-kafka-ui-oidc-client-secret-not-for-prod-use\",\"jwk-set-uri\":\"http://authentik-server.authentik.svc.cluster.local/application/o/kafka-ui/jwks/\",\"provider\":\"authentik\",\"redirect-uri\":\"https://kafka-ui.tail60240b.ts.net/login/oauth2/code/authentik\",\"scope\":[\"openid\",\"profile\",\"email\"],\"token-uri\":\"http://authentik-server.authentik.svc.cluster.local/application/o/token/\",\"user-info-uri\":\"http://authentik-server.authentik.svc.cluster.local/application/o/userinfo/\",\"user-name-attribute\":\"preferred_username\"}}},\"type\":\"OAUTH2\"},\"kafka\":{\"clusters\":[{\"bootstrapServers\":\"host.docker.internal:30901\",\"name\":\"sit\"},{\"bootstrapServers\":\"host.docker.internal:30902\",\"name\":\"uat\",\"properties\":{\"default.api.timeout.ms\":10000,\"reconnect.backoff.max.ms\":60000,\"reconnect.backoff.ms\":10000,\"request.timeout.ms\":10000,\"retry.backoff.ms\":10000}},{\"bootstrapServers\":\"host.docker.internal:30903\",\"name\":\"production\",\"properties\":{\"default.api.timeout.ms\":10000,\"reconnect.backoff.max.ms\":60000,\"reconnect.backoff.ms\":10000,\"request.timeout.ms\":10000,\"retry.backoff.ms\":10000}}]}}}}","version":"0.1.0"}],"name":"kafka-ui","namespace":"kafka-ui","pass_credentials":false,"postrender":[],"recreate_pods":false,"render_subchart_notes":true,"replace":false,"repository":null,"repository_ca_file":null,"repository_cert_file":null,"repository_key_file":null,"repository_password":null,"repository_username":null,"reset_values":false,"reuse_values":false,"set":[],"set_list":[],"set_sensitive":[],"skip_crds":false,"status":"deployed","timeout":300,"upgrade_install":null,"values":["# ponytail: sit/uat/production's kafka lives on separate Docker networks —\n# same host.docker.internal NodePort bridge as the gitlab-registry mirror /\n# opencost-\u003eMimir push (see scripts/*/create-cluster.sh), just in the other\n# direction: each phase cluster exposes its kafka via a NodePort on ITS OWN\n# k3d loadbalancer (terraform/modules/platform-apps/kafka.tf), and this pod\n# dials out to host.docker.internal:\u003cthat port\u003e.\nkafka-ui:\n  fullnameOverride: \"kafka-ui\"\n\n  yamlApplicationConfig:\n    kafka:\n      clusters:\n        - name: sit\n          bootstrapServers: host.docker.internal:30901\n        # ponytail: uat/production's k3d clusters are stopped more often than\n        # not (not every session needs the phase pipeline) -- kafbat-ui has\n        # no health-aware backoff of its own, so a down cluster's AdminClient\n        # gets recreated and reconnected on every scheduled poll using Kafka's\n        # DEFAULT backoff (fast, sub-second), burning real CPU on the shared\n        # Docker Desktop VM for nothing. These properties pass straight\n        # through to the underlying Kafka client config -- raises the floor\n        # so a dead cluster is retried every 10-60s instead of continuously.\n        # Harmless when the cluster IS up: just a slightly slower first\n        # discovery, no effect on steady-state polling once connected.\n        - name: uat\n          bootstrapServers: host.docker.internal:30902\n          properties:\n            reconnect.backoff.ms: 10000\n            reconnect.backoff.max.ms: 60000\n            retry.backoff.ms: 10000\n            request.timeout.ms: 10000\n            default.api.timeout.ms: 10000\n        - name: production\n          bootstrapServers: host.docker.internal:30903\n          properties:\n            reconnect.backoff.ms: 10000\n            reconnect.backoff.max.ms: 60000\n            retry.backoff.ms: 10000\n            request.timeout.ms: 10000\n            default.api.timeout.ms: 10000\n    # ponytail: kafbat-ui does NOT use Spring Boot's standard\n    # spring.security.oauth2.client.* — it binds its own flat OAuthProperties\n    # class at auth.oauth2.client.\u003cname\u003e (see OAuthSecurityConfig.java /\n    # OAuthProperties.java upstream). The standard-looking schema fails with\n    # \"OAuth2 authentication is enabled but no providers specified\" since\n    # Spring never sees it as a provider at all.\n    auth:\n      type: OAUTH2\n      oauth2:\n        client:\n          authentik:\n            provider: authentik\n            client-id: \"dev-kafka-ui-oidc-client-id\"\n            client-secret: \"dev-kafka-ui-oidc-client-secret-not-for-prod-use\"\n            client-name: authentik\n            authorization-grant-type: authorization_code\n            redirect-uri: \"https://kafka-ui.tail60240b.ts.net/login/oauth2/code/authentik\"\n            scope: [openid, profile, email]\n            # ponytail: authorization is browser-navigated (Tailscale HTTPS\n            # external); token/user-info/jwks are server-side calls — use\n            # in-cluster HTTP so kafka-ui never has to trust the homelab CA\n            # (same split as litellm/grafana/gitlab).\n            authorization-uri: \"https://authentik.tail60240b.ts.net/application/o/authorize/\"\n            token-uri: \"http://authentik-server.authentik.svc.cluster.local/application/o/token/\"\n            user-info-uri: \"http://authentik-server.authentik.svc.cluster.local/application/o/userinfo/\"\n            jwk-set-uri: \"http://authentik-server.authentik.svc.cluster.local/application/o/kafka-ui/jwks/\"\n            user-name-attribute: preferred_username\n\n  resources:\n    requests:\n      cpu: 50m\n      memory: 256Mi\n    limits:\n      memory: 512Mi\n"],"verify":false,"version":"0.1.0","wait":true,"wait_for_jobs":false},"sensitive_attributes":[[{"type":"get_attr","value":"repository_password"}],[{"type":"get_attr","value":"values"},{"type":"index","value":{"value":0,"type":"number"}}]],"private":"eyJzY2hlbWFfdmVyc2lvbiI6IjEifQ==","dependencies":["kubernetes_namespace.kafka_ui"]}]},{"mode":"managed","type":"helm_release","name":"kaneo","provider":"provider[\"registry.opentofu.org/hashicorp/helm\"]","instances":[{"schema_version":1,"attributes":{"atomic":false,"chart":"./../../helm/kaneo","cleanup_on_fail":false,"create_namespace":false,"dependency_update":true,"description":null,"devel":null,"disable_crd_hooks":false,"disable_openapi_validation":false,"disable_webhooks":false,"force_update":false,"id":"kaneo","keyring":null,"lint":false,"manifest":null,"max_history":0,"metadata":[{"app_version":"latest","chart":"kaneo","first_deployed":1791373691,"last_deployed":1791373691,"name":"kaneo","namespace":"kaneo","notes":"","revision":1,"values":"{\"auth\":{\"secret\":\"dev-kaneo-auth-secret-not-for-prod-use-needs-32-chars\"},\"chartHash\":\"705c2b49ec560182ccbd4797a481efb7944f3b07\",\"clientUrl\":\"https://kaneo.tail60240b.ts.net\",\"disableLoginForm\":true,\"disablePasswordRegistration\":true,\"image\":\"ghcr.io/usekaneo/kaneo:latest\",\"ingress\":{\"enabled\":false},\"oidc\":{\"authorizationUrl\":\"https://authentik.tail60240b.ts.net/application/o/authorize/\",\"autoLogin\":true,\"clientId\":\"dev-kaneo-oidc-client-id\",\"clientSecret\":\"dev-kaneo-oidc-client-secret-not-for-prod-use\",\"tokenUrl\":\"http://authentik-server.authentik.svc.cluster.local/application/o/token/\",\"userInfoUrl\":\"http://authentik-server.authentik.svc.cluster.local/application/o/userinfo/\"},\"postgresql\":{\"database\":\"kaneo\",\"host\":\"postgres.postgres.svc.cluster.local\",\"password\":\"dev-shared-db-password-not-for-prod-use\",\"port\":5432,\"user\":\"kaneo\"},\"replicas\":1,\"resources\":{\"limits\":{\"memory\":\"1Gi\"},\"requests\":{\"cpu\":\"100m\",\"memory\":\"256Mi\"}},\"s3\":{\"accessKeyId\":\"admin\",\"bucket\":\"kaneo\",\"endpoint\":\"http://minio.minio.svc.cluster.local:9000\",\"forcePathStyle\":true,\"secretAccessKey\":\"dev-minio-root-password\"},\"service\":{\"port\":5173}}","version":"0.1.0"}],"name":"kaneo","namespace":"kaneo","pass_credentials":false,"postrender":[],"recreate_pods":false,"render_subchart_notes":true,"replace":false,"repository":null,"repository_ca_file":null,"repository_cert_file":null,"repository_key_file":null,"repository_password":null,"repository_username":null,"reset_values":false,"reuse_values":false,"set":[{"name":"chartHash","type":"","value":"705c2b49ec560182ccbd4797a481efb7944f3b07"}],"set_list":[],"set_sensitive":[],"skip_crds":false,"status":"deployed","timeout":300,"upgrade_install":null,"values":["# ponytail: single-container app (ghcr.io/usekaneo/kaneo, Better Auth +\n# Hono backend + React frontend all in one image) — shared postgres (helm/\n# postgres) for its DB, shared MinIO for S3 attachment storage, no bundled\n# Redis (optional pub/sub only at this scale, add REDIS_URL later if Kaneo\n# ever refuses to boot without one). No official chart published to a repo/\n# OCI registry (lives inside Kaneo's own monorepo) — hand-rolled, same\n# convention as helm/taiga was. No chart-owned Ingress: tailscale + .local\n# ingresses are plain kubectl_manifest resources in\n# terraform/internal/kaneo.tf, same as harbor/taiga.\n\nimage: \"ghcr.io/usekaneo/kaneo:latest\"\n\nreplicas: 1\n\nservice:\n  port: 5173\n\npostgresql:\n  host: \"postgres.postgres.svc.cluster.local\"\n  port: 5432\n  user: \"kaneo\"\n  database: \"kaneo\"\n  password: \"dev-shared-db-password-not-for-prod-use\"\n\nauth:\n  # Better Auth secret, 32+ chars.\n  secret: \"dev-kaneo-auth-secret-not-for-prod-use-needs-32-chars\"\n\nclientUrl: \"https://kaneo.tail60240b.ts.net\"\n\n# ponytail: explicit split endpoints (not CUSTOM_OAUTH_DISCOVERY_URL) — same\n# convention GitLab/Grafana/LiteLLM already use: the browser needs the\n# external tailnet URL, but pods can't route to the Tailscale Service VIP\n# (see AGENT.md's \"in-cluster can't reach the tailnet hostname\"), so\n# server-side calls go straight to authentik-server.authentik.svc instead.\n# Avoids depending on terraform/coredns.tf's split-horizon rewrite entirely.\noidc:\n  authorizationUrl: \"https://authentik.tail60240b.ts.net/application/o/authorize/\"\n  tokenUrl: \"http://authentik-server.authentik.svc.cluster.local/application/o/token/\"\n  userInfoUrl: \"http://authentik-server.authentik.svc.cluster.local/application/o/userinfo/\"\n  clientId: \"dev-kaneo-oidc-client-id\"\n  clientSecret: \"dev-kaneo-oidc-client-secret-not-for-prod-use\"\n  autoLogin: true\n\n# ponytail: SSO-only — same shape OpenWebUI already uses\n# (ENABLE_LOGIN_FORM=False). No local password accounts for humans; the\n# bootstrap admin account (first signup, per Kaneo's hasUsers flag) is the\n# one exception, created once before this flips on (see kaneo.tf's\n# admin_password var / README bootstrap note).\ndisableLoginForm: true\ndisablePasswordRegistration: true\n\ns3:\n  endpoint: \"http://minio.minio.svc.cluster.local:9000\"\n  bucket: \"kaneo\"\n  accessKeyId: \"admin\"\n  secretAccessKey: \"dev-minio-root-password\"\n  forcePathStyle: true\n\nresources:\n  requests:\n    cpu: 100m\n    memory: 256Mi\n  limits:\n    memory: 1Gi\n\ningress:\n  enabled: false\n"],"verify":false,"version":"0.1.0","wait":true,"wait_for_jobs":false},"sensitive_attributes":[[{"type":"get_attr","value":"repository_password"}],[{"type":"get_attr","value":"values"},{"type":"index","value":{"value":0,"type":"number"}}]],"private":"eyJzY2hlbWFfdmVyc2lvbiI6IjEifQ==","dependencies":["data.kubernetes_secret.homelab_ca_minio","helm_release.cert_manager","helm_release.minio","helm_release.postgres","kubectl_manifest.homelab_ca","kubectl_manifest.selfsigned_bootstrap","kubernetes_namespace.cert_manager","kubernetes_namespace.kaneo","kubernetes_namespace.minio","kubernetes_namespace.postgres","kubernetes_secret.minio_homelab_ca","null_resource.homelab_ca_ready"]}]},{"mode":"managed","type":"helm_release","name":"litellm","provider":"provider[\"registry.opentofu.org/hashicorp/helm\"]","instances":[{"schema_version":1,"attributes":{"atomic":false,"chart":"./../../helm/litellm","cleanup_on_fail":false,"create_namespace":false,"dependency_update":true,"description":null,"devel":null,"disable_crd_hooks":false,"disable_openapi_validation":false,"disable_webhooks":false,"force_update":false,"id":"litellm","keyring":null,"lint":false,"manifest":null,"max_history":0,"metadata":[{"app_version":"","chart":"litellm","first_deployed":1789017393,"last_deployed":1791373657,"name":"litellm","namespace":"litellm","notes":"","revision":9,"values":"{\"env\":{\"AUTO_REDIRECT_UI_LOGIN_TO_SSO\":\"true\",\"DATABASE_URL\":\"postgresql://litellm:dev-shared-db-password-not-for-prod-use@postgres.postgres.svc.cluster.local:5432/litellm\",\"GENERIC_AUTHORIZATION_ENDPOINT\":\"https://authentik.tail60240b.ts.net/application/o/authorize/\",\"GENERIC_CLIENT_ID\":\"dev-litellm-oidc-client-id\",\"GENERIC_CLIENT_SECRET\":\"dev-litellm-oidc-client-secret-not-for-prod-use\",\"GENERIC_SCOPE\":\"openid profile email litellm_role\",\"GENERIC_TOKEN_ENDPOINT\":\"http://authentik-server.authentik.svc.cluster.local/application/o/token/\",\"GENERIC_USERINFO_ENDPOINT\":\"http://authentik-server.authentik.svc.cluster.local/application/o/userinfo/\",\"GENERIC_USER_ROLE_ATTRIBUTE\":\"litellm_role\",\"LITELLM_MASTER_KEY\":\"sk-dev-litellm-master-key-not-for-prod-use\",\"LITELLM_SALT_KEY\":\"sk-dev-litellm-salt-key-not-for-prod-use\",\"PROXY_BASE_URL\":\"https://litellm.tail60240b.ts.net\",\"PROXY_LOGOUT_URL\":\"https://authentik.tail60240b.ts.net/application/o/litellm/end-session/\",\"STORE_MODEL_IN_DB\":\"True\"},\"image\":{\"repository\":\"ghcr.io/berriai/litellm\",\"tag\":\"main-latest\"},\"mcpGitlabAuthToken\":\"dev-gitlab-mcp-auth-token\",\"mcpKaneoAuthValue\":\"\",\"mcpN8nAuthToken\":\"dev-n8n-mcp-auth-token-not-for-prod-use-000\",\"mcpSonarqubeAuthToken\":\"squ_16257b8b7b9189bd01b20a695e02c8e71e4969d4\",\"ollamaBaseUrl\":\"http://host.docker.internal:11434\",\"ollamaModels\":[{\"inputCostPerToken\":0.000003,\"name\":\"qwen3.8:27b\",\"outputCostPerToken\":0.000015},{\"inputCostPerToken\":0.000001,\"name\":\"qwen3:1.7b\",\"outputCostPerToken\":0.000005}],\"resources\":{\"limits\":{\"memory\":\"2Gi\"},\"requests\":{\"cpu\":\"100m\",\"memory\":\"512Mi\"}}}","version":"0.1.0"}],"name":"litellm","namespace":"litellm","pass_credentials":false,"postrender":[],"recreate_pods":false,"render_subchart_notes":true,"replace":false,"repository":null,"repository_ca_file":null,"repository_cert_file":null,"repository_key_file":null,"repository_password":null,"repository_username":null,"reset_values":false,"reuse_values":false,"set":[],"set_list":[],"set_sensitive":[],"skip_crds":false,"status":"deployed","timeout":600,"upgrade_install":null,"values":["image:\r\n  repository: ghcr.io/berriai/litellm\r\n  tag: main-latest\r\n\r\n# ponytail: per-caller bearer for the gitlab MCP server (its\r\n# STREAMABLE_HTTP_AUTH_TOKEN). Same value as TF_VAR_gitlab_mcp_auth_token.\r\nmcpGitlabAuthToken: \"dev-gitlab-mcp-auth-token\"\r\n\r\n# ponytail: SonarQube user token LiteLLM forwards to the sonarqube MCP server\r\n# as `Authorization: Bearer` (HTTP mode needs it per request). Same value as\r\n# TF_VAR_sonarqube_mcp_token.\r\nmcpSonarqubeAuthToken: \"squ_16257b8b7b9189bd01b20a695e02c8e71e4969d4\"\r\n\r\n# ponytail: per-caller bearer for the n8n MCP server (its AUTH_TOKEN).\r\n# Same value as TF_VAR_n8n_mcp_auth_token.\r\nmcpN8nAuthToken: \"dev-n8n-mcp-auth-token-not-for-prod-use-000\"\r\n\r\n# ponytail: the Kaneo credential OpenWebUI chat sessions use when calling\r\n# kaneo-mcp (which has no auth of its own — see its ponytail comment).\r\n# Same value as TF_VAR_kaneo_api_token.\r\nmcpKaneoAuthValue: \"\"\r\n\r\n# ponytail: the host's Ollama, reached from the cluster via k3d's built-in\r\n# host alias. `ollama_chat/*` provider — no /v1 suffix. `ollamaModels` are the\r\n# tags listed by name; add/remove to match `ollama list`.\r\n# host.docker.internal resolves from k3d pods on Docker Desktop; host.k3d.internal\r\n# depends on k3d's flaky CoreDNS NodeHosts injection and was failing name lookup.\r\nollamaBaseUrl: \"http://host.docker.internal:11434\"\r\n# ponytail: the models run for free on local Ollama — these costPerToken\r\n# figures are reference-only (LiteLLM's usage/spend dashboard needs *some*\r\n# number to show $ cost), not real billing. Anthropic API list pricing\r\n# (USD/token) stood in per size tier: qwen3.8:27b ~ Sonnet-class,\r\n# qwen3:1.7b ~ Haiku-class. Update alongside shared/model-migration pricing\r\n# if Anthropic's list prices change.\r\nollamaModels:\r\n  # qwen3-coder-next (80B) OOMs on this host — omp default is qwen3.8:27b.\r\n  - name: \"qwen3.8:27b\"\r\n    inputCostPerToken: 0.000003\r\n    outputCostPerToken: 0.000015\r\n  - name: \"qwen3:1.7b\"\r\n    inputCostPerToken: 0.000001\r\n    outputCostPerToken: 0.000005\r\n\r\nenv:\r\n  DATABASE_URL: \"postgresql://litellm:dev-shared-db-password-not-for-prod-use@postgres.postgres.svc.cluster.local:5432/litellm\"\r\n  STORE_MODEL_IN_DB: \"True\"\r\n  LITELLM_MASTER_KEY: \"sk-dev-litellm-master-key-not-for-prod-use\"\r\n  LITELLM_SALT_KEY: \"sk-dev-litellm-salt-key-not-for-prod-use\"\r\n\r\n  # SSO via Authentik generic OIDC\r\n  GENERIC_CLIENT_ID: \"dev-litellm-oidc-client-id\"\r\n  GENERIC_CLIENT_SECRET: \"dev-litellm-oidc-client-secret-not-for-prod-use\"\r\n  # ponytail: browser-navigated endpoint must use Tailscale HTTPS (external).\r\n  # Token and userinfo are server-side calls — use in-cluster HTTP to avoid\r\n  # self-signed cert validation against homelab CA.\r\n  GENERIC_AUTHORIZATION_ENDPOINT: \"https://authentik.tail60240b.ts.net/application/o/authorize/\"\r\n  GENERIC_TOKEN_ENDPOINT: \"http://authentik-server.authentik.svc.cluster.local/application/o/token/\"\r\n  GENERIC_USERINFO_ENDPOINT: \"http://authentik-server.authentik.svc.cluster.local/application/o/userinfo/\"\r\n  GENERIC_SCOPE: \"openid profile email litellm_role\"\r\n  GENERIC_USER_ROLE_ATTRIBUTE: \"litellm_role\"\r\n  PROXY_BASE_URL: \"https://litellm.tail60240b.ts.net\"\r\n  PROXY_LOGOUT_URL: \"https://authentik.tail60240b.ts.net/application/o/litellm/end-session/\"\r\n  AUTO_REDIRECT_UI_LOGIN_TO_SSO: \"true\"\r\n\r\nresources:\r\n  requests:\r\n    cpu: 100m\r\n    memory: 512Mi\r\n  limits:\r\n    memory: 2Gi\r\n\r\n\r\n"],"verify":false,"version":"0.1.0","wait":true,"wait_for_jobs":false},"sensitive_attributes":[[{"type":"get_attr","value":"repository_password"}],[{"type":"get_attr","value":"values"},{"type":"index","value":{"value":0,"type":"number"}}]],"private":"eyJzY2hlbWFfdmVyc2lvbiI6IjEifQ==","dependencies":["helm_release.postgres","kubernetes_namespace.litellm","kubernetes_namespace.postgres"]}]},{"mode":"managed","type":"helm_release","name":"mcp_servers","provider":"provider[\"registry.opentofu.org/hashicorp/helm\"]","instances":[{"schema_version":1,"attributes":{"atomic":false,"chart":"./../../helm/mcp-servers","cleanup_on_fail":false,"create_namespace":false,"dependency_update":true,"description":null,"devel":null,"disable_crd_hooks":false,"disable_openapi_validation":false,"disable_webhooks":false,"force_update":false,"id":"mcp-servers","keyring":null,"lint":false,"manifest":null,"max_history":0,"metadata":[{"app_version":"","chart":"mcp-servers","first_deployed":1789017132,"last_deployed":1791373678,"name":"mcp-servers","namespace":"mcp-servers","notes":"","revision":12,"values":"{\"defaultResources\":{\"limits\":{\"memory\":\"256Mi\"},\"requests\":{\"cpu\":\"50m\",\"memory\":\"128Mi\"}},\"servers\":{\"gitlab\":{\"env\":{\"GITLAB_API_URL\":\"http://gitlab-webservice-default.gitlab.svc.cluster.local:8181/api/v4\",\"GITLAB_PERSONAL_ACCESS_TOKEN\":\"(sensitive value)\",\"HOST\":\"0.0.0.0\",\"MCP_SERVER_URL\":\"http://mcp-servers-gitlab.mcp-servers.svc.cluster.local:3002\",\"PORT\":\"3002\",\"STREAMABLE_HTTP\":\"true\",\"STREAMABLE_HTTP_AUTH_TOKEN\":\"(sensitive value)\"},\"image\":\"zereight050/gitlab-mcp:latest\",\"port\":3002},\"grafana\":{\"args\":[\"-transport\",\"streamable-http\",\"-address\",\"0.0.0.0:8000\",\"-allowed-hosts\",\"*\",\"-allowed-origins\",\"*\"],\"command\":[\"/app/mcp-grafana\"],\"env\":{\"GRAFANA_SERVICE_ACCOUNT_TOKEN\":\"(sensitive value)\",\"GRAFANA_URL\":\"http://observability-grafana.observability.svc.cluster.local\"},\"image\":\"grafana/mcp-grafana:latest\",\"port\":8000},\"kaneo\":{\"env\":{\"KANEO_URL\":\"http://kaneo.kaneo.svc.cluster.local:5173\",\"PORT\":\"8300\"},\"image\":\"k3d-registry:5111/kaneo-mcp:dev\",\"port\":8300},\"n8n\":{\"env\":{\"AUTH_TOKEN\":\"(sensitive value)\",\"LOG_LEVEL\":\"warn\",\"MCP_MODE\":\"http\",\"N8N_API_KEY\":\"\",\"N8N_API_URL\":\"http://n8n.n8n.svc.cluster.local:5678\",\"PORT\":\"3000\"},\"image\":\"ghcr.io/czlonkowski/n8n-mcp:latest\",\"port\":3000},\"playwright\":{\"args\":[\"--headless\",\"--browser\",\"chromium\",\"--no-sandbox\",\"--port\",\"8931\",\"--host\",\"0.0.0.0\",\"--allowed-hosts\",\"*\"],\"command\":[\"node\",\"/app/cli.js\"],\"image\":\"mcr.microsoft.com/playwright/mcp:latest\",\"port\":8931,\"resources\":{\"limits\":{\"memory\":\"1Gi\"},\"requests\":{\"cpu\":\"250m\",\"memory\":\"512Mi\"}}},\"sonarqube\":{\"env\":{\"SONARQUBE_HTTP_HOST\":\"0.0.0.0\",\"SONARQUBE_HTTP_PORT\":\"8080\",\"SONARQUBE_MCP_IN_CONTAINER\":\"true\",\"SONARQUBE_TOKEN\":\"(sensitive value)\",\"SONARQUBE_TRANSPORT\":\"http\",\"SONARQUBE_URL\":\"http://sonarqube-sonarqube.sonarqube.svc.cluster.local:9000\"},\"image\":\"sonarsource/sonarqube-mcp:latest\",\"port\":8080,\"resources\":{\"limits\":{\"memory\":\"1Gi\"},\"requests\":{\"cpu\":\"100m\",\"memory\":\"512Mi\"}},\"waitFor\":\"sonarqube-sonarqube.sonarqube.svc.cluster.local:9000\"}}}","version":"0.1.0"}],"name":"mcp-servers","namespace":"mcp-servers","pass_credentials":false,"postrender":[],"recreate_pods":false,"render_subchart_notes":true,"replace":false,"repository":null,"repository_ca_file":null,"repository_cert_file":null,"repository_key_file":null,"repository_password":null,"repository_username":null,"reset_values":false,"reuse_values":false,"set":[{"name":"servers.kaneo.env.KANEO_URL","type":"","value":"http://kaneo.kaneo.svc.cluster.local:5173"}],"set_list":[],"set_sensitive":[{"name":"servers.gitlab.env.GITLAB_PERSONAL_ACCESS_TOKEN","type":"","value":"glpat-FJcl33yN1Z8J79hHsCWK-m86MQp1OjIH.01.0w0t1zpk8"},{"name":"servers.gitlab.env.STREAMABLE_HTTP_AUTH_TOKEN","type":"","value":"dev-gitlab-mcp-auth-token"},{"name":"servers.grafana.env.GRAFANA_SERVICE_ACCOUNT_TOKEN","type":"","value":""},{"name":"servers.n8n.env.AUTH_TOKEN","type":"","value":"dev-n8n-mcp-auth-token-not-for-prod-use-000"},{"name":"servers.sonarqube.env.SONARQUBE_TOKEN","type":"","value":"squ_16257b8b7b9189bd01b20a695e02c8e71e4969d4"}],"skip_crds":false,"status":"deployed","timeout":300,"upgrade_install":null,"values":["# ponytail: one Deployment+Service template looped over this map instead of\n# 5 near-identical template files — every server here is the same shape\n# (image, optional command/args override, one HTTP port, env vars).\ndefaultResources:\n  requests:\n    cpu: 50m\n    memory: 128Mi\n  limits:\n    memory: 256Mi\n\nservers:\n  grafana:\n    image: grafana/mcp-grafana:latest\n    # ponytail: override the image's baked entrypoint flags\n    # (`--transport sse --address 0.0.0.0:8000`) so `args` is the whole set.\n    command: [\"/app/mcp-grafana\"]\n    # ponytail: -allowed-hosts \"*\" — LiteLLM's MCP client connects by Service\n    # DNS, so mcp-grafana's DNS-rebind Host-header check 403s it otherwise.\n    # \"*\" is safe here: only in-cluster traffic can reach :8000.\n    args: [\"-transport\", \"streamable-http\", \"-address\", \"0.0.0.0:8000\", \"-allowed-hosts\", \"*\", \"-allowed-origins\", \"*\"]\n    port: 8000\n    env:\n      GRAFANA_URL: http://observability-grafana.observability.svc.cluster.local\n      GRAFANA_SERVICE_ACCOUNT_TOKEN: \"\"  # set via terraform\n\n  sonarqube:\n    image: sonarsource/sonarqube-mcp:latest\n    port: 8080\n    # ponytail: after a full cluster/host reboot this pod starts before the\n    # sonarqube-sonarqube JVM (slow boot) is listening — crashes hard\n    # (version-check connect refused) instead of retrying. Block on it.\n    waitFor: \"sonarqube-sonarqube.sonarqube.svc.cluster.local:9000\"\n    # ponytail: JVM server + downloads analyzer plugins on boot — OOMKills\n    # (exit 137, CrashLoopBackOff) at the 256Mi default. 1Gi limit gives the\n    # container-aware JVM enough headroom; drop it if analyzer set shrinks.\n    resources:\n      requests:\n        cpu: 100m\n        memory: 512Mi\n      limits:\n        memory: 1Gi\n    env:\n      SONARQUBE_TRANSPORT: \"http\"\n      SONARQUBE_HTTP_PORT: \"8080\"\n      SONARQUBE_HTTP_HOST: \"0.0.0.0\"\n      SONARQUBE_MCP_IN_CONTAINER: \"true\"\n      SONARQUBE_URL: http://sonarqube-sonarqube.sonarqube.svc.cluster.local:9000\n      # ponytail: used only for this server's background plugin sync. In HTTP\n      # mode the per-request token comes from the caller's `Authorization:\n      # Bearer` header (LiteLLM sends it — see helm/litellm mcpSonarqubeAuthToken).\n      # Must be a VALID SonarQube user token or bg init logs \"Not authorized\".\n      SONARQUBE_TOKEN: \"\"  # set via terraform (TF_VAR_sonarqube_mcp_token)\n\n  gitlab:\n    # ponytail: NOT mcp/gitlab (Docker's own catalog wrapper, stdio-only) —\n    # this is the actual zereight/gitlab-mcp project, which supports HTTP\n    # transport via env vars.\n    image: zereight050/gitlab-mcp:latest\n    port: 3002\n    env:\n      STREAMABLE_HTTP: \"true\"\n      HOST: \"0.0.0.0\"\n      PORT: \"3002\"\n      # ponytail: without this the /mcp DNS-rebind guard 403s any request whose\n      # Host header isn't loopback — LiteLLM connects by this Service DNS name.\n      MCP_SERVER_URL: \"http://mcp-servers-gitlab.mcp-servers.svc.cluster.local:3002\"\n      GITLAB_API_URL: http://gitlab-webservice-default.gitlab.svc.cluster.local:8181/api/v4\n      GITLAB_PERSONAL_ACCESS_TOKEN: \"\"  # set via terraform\n      # ponytail: server holds a static PAT (not per-client OAuth), so this\n      # is the \"who's allowed to call this server\" bearer token — required\n      # by the image whenever STREAMABLE_HTTP + a static PAT are combined.\n      STREAMABLE_HTTP_AUTH_TOKEN: \"\"  # set via terraform\n\n  n8n:\n    # ponytail: czlonkowski/n8n-mcp — node docs + workflow validation always,\n    # plus workflow-management tools when N8N_API_KEY is set. The key is minted\n    # at runtime by playbooks/n8n.yml (this stack never stores one), which\n    # patches it into this Deployment's env — blank here = docs-only until then.\n    image: ghcr.io/czlonkowski/n8n-mcp:latest\n    port: 3000\n    env:\n      MCP_MODE: \"http\"\n      PORT: \"3000\"\n      # n8n-mcp refuses to start in http mode without this (per-request bearer).\n      AUTH_TOKEN: \"\"  # set via terraform (TF_VAR_n8n_mcp_auth_token)\n      N8N_API_URL: http://n8n.n8n.svc.cluster.local:5678\n      N8N_API_KEY: \"\"  # patched in by playbooks/n8n.yml after it mints a key\n      LOG_LEVEL: warn\n\n  kaneo:\n    # ponytail: custom image (Kaneo's own native MCP wants an OAuth-resolvable\n    # bearer, awkward for a static per-role token in a batch Job) — built\n    # by terraform/internal/mcp-servers.tf's null_resource. See\n    # helm/mcp-servers/kaneo-mcp/ for source. No static credential here —\n    # the server forwards whatever bearer the caller sends straight to\n    # Kaneo's API, so each role's own real API key is the auth, end to end.\n    image: k3d-registry:5111/kaneo-mcp:dev\n    port: 8300\n    env:\n      PORT: \"8300\"\n      KANEO_URL: \"\"  # set via terraform\n\n  playwright:\n    image: mcr.microsoft.com/playwright/mcp:latest\n    command: [\"node\", \"/app/cli.js\"]\n    # ponytail: --allowed-hosts \"*\" — same DNS-rebind guard as the others; the\n    # server otherwise 403s anything not hitting it as localhost:8931.\n    args: [\"--headless\", \"--browser\", \"chromium\", \"--no-sandbox\", \"--port\", \"8931\", \"--host\", \"0.0.0.0\", \"--allowed-hosts\", \"*\"]\n    port: 8931\n    # ponytail: real chromium instance, not a thin API wrapper — needs more\n    # than the other servers' default resources.\n    resources:\n      requests:\n        cpu: 250m\n        memory: 512Mi\n      limits:\n        memory: 1Gi\n"],"verify":false,"version":"0.1.0","wait":false,"wait_for_jobs":false},"sensitive_attributes":[[{"type":"get_attr","value":"repository_password"}],[{"type":"get_attr","value":"set_sensitive"}]],"private":"eyJzY2hlbWFfdmVyc2lvbiI6IjEifQ==","dependencies":["kubernetes_namespace.mcp_servers","null_resource.kaneo_mcp_image"]}]},{"mode":"managed","type":"helm_release","name":"mermaid_render","provider":"provider[\"registry.opentofu.org/hashicorp/helm\"]","instances":[{"schema_version":1,"attributes":{"atomic":false,"chart":"./../../helm/mermaid-render","cleanup_on_fail":false,"create_namespace":false,"dependency_update":true,"description":null,"devel":null,"disable_crd_hooks":false,"disable_openapi_validation":false,"disable_webhooks":false,"force_update":false,"id":"mermaid-render","keyring":null,"lint":false,"manifest":null,"max_history":0,"metadata":[{"app_version":"","chart":"mermaid-render","first_deployed":1791075786,"last_deployed":1791094817,"name":"mermaid-render","namespace":"sdlc","notes":"","revision":3,"values":"{\"chartHash\":\"577779a3fce44797225c0f8ea6a6a30cd87aa967\"}","version":"0.1.0"}],"name":"mermaid-render","namespace":"sdlc","pass_credentials":false,"postrender":[],"recreate_pods":false,"render_subchart_notes":true,"replace":false,"repository":null,"repository_ca_file":null,"repository_cert_file":null,"repository_key_file":null,"repository_password":null,"repository_username":null,"reset_values":false,"reuse_values":false,"set":[{"name":"chartHash","type":"","value":"577779a3fce44797225c0f8ea6a6a30cd87aa967"}],"set_list":[],"set_sensitive":[],"skip_crds":false,"status":"deployed","timeout":300,"upgrade_install":null,"values":null,"verify":false,"version":"0.1.0","wait":true,"wait_for_jobs":false},"sensitive_attributes":[[{"type":"get_attr","value":"repository_password"}]],"private":"eyJzY2hlbWFfdmVyc2lvbiI6IjEifQ==","dependencies":["kubernetes_namespace.sdlc"]}]},{"mode":"managed","type":"helm_release","name":"minio","provider":"provider[\"registry.opentofu.org/hashicorp/helm\"]","instances":[{"schema_version":1,"attributes":{"atomic":false,"chart":"./../../helm/minio","cleanup_on_fail":false,"create_namespace":false,"dependency_update":true,"description":null,"devel":null,"disable_crd_hooks":false,"disable_openapi_validation":false,"disable_webhooks":false,"force_update":false,"id":"minio","keyring":null,"lint":false,"manifest":null,"max_history":0,"metadata":[{"app_version":"","chart":"minio","first_deployed":1789017132,"last_deployed":1791373657,"name":"minio","namespace":"minio","notes":"\nMinIO can be accessed via port 9000 on the following DNS name from within your cluster:\nminio.minio.cluster.local\n\nTo access MinIO from localhost, run the below commands:\n\n  1. export POD_NAME=$(kubectl get pods --namespace minio -l \"release=minio\" -o jsonpath=\"{.items[0].metadata.name}\")\n\n  2. kubectl port-forward $POD_NAME 9000 --namespace minio\n\nRead more about port forwarding here: http://kubernetes.io/docs/user-guide/kubectl/kubectl_port-forward/\n\nYou can now access MinIO server on http://localhost:9000. Follow the below steps to connect to MinIO server with mc client:\n\n  1. Download the MinIO mc client - https://min.io/docs/minio/linux/reference/minio-mc.html#quickstart\n\n  2. export MC_HOST_minio-local=http://$(kubectl get secret --namespace minio minio -o jsonpath=\"{.data.rootUser}\" | base64 --decode):$(kubectl get secret --namespace minio minio -o jsonpath=\"{.data.rootPassword}\" | base64 --decode)@localhost:9000\n\n  3. mc ls minio-local\n\n\n","revision":11,"values":"{\"minio\":{\"buckets\":[{\"name\":\"gitlab-runner-cache\"},{\"name\":\"git-lfs\"},{\"name\":\"gitlab-registry\"},{\"name\":\"gitlab-artifacts\"},{\"name\":\"gitlab-uploads\"},{\"name\":\"gitlab-packages\"},{\"name\":\"gitlab-mr-diffs\"},{\"name\":\"gitlab-dependency-proxy\"},{\"name\":\"gitlab-terraform-state\"},{\"name\":\"gitlab-ci-secure-files\"},{\"name\":\"gitlab-backups\"},{\"name\":\"release-reports\"},{\"name\":\"postgres-backups\"},{\"name\":\"kaneo\"}],\"consoleIngress\":{\"annotations\":{\"cert-manager.io/cluster-issuer\":\"homelab-ca-issuer\"},\"enabled\":true,\"hosts\":[\"minio-console.local\"],\"ingressClassName\":\"traefik\",\"tls\":[{\"hosts\":[\"minio-console.local\"],\"secretName\":\"minio-console.local-tls\"}]},\"drivesPerNode\":1,\"environment\":{\"MINIO_BROWSER\":\"on\",\"MINIO_BROWSER_REDIRECT_URL\":\"https://minio-console.tail60240b.ts.net\",\"MINIO_IDENTITY_OPENID_CLAIM_NAME\":\"policy\",\"MINIO_IDENTITY_OPENID_CLIENT_ID\":\"(sensitive value)\",\"MINIO_IDENTITY_OPENID_CLIENT_SECRET\":\"(sensitive value)\",\"MINIO_IDENTITY_OPENID_CONFIG_URL\":\"https://authentik.tail60240b.ts.net/application/o/minio/.well-known/openid-configuration\",\"MINIO_IDENTITY_OPENID_DISPLAY_NAME\":\"Authentik\",\"MINIO_IDENTITY_OPENID_REDIRECT_URI\":\"https://minio-console.tail60240b.ts.net/oauth_callback\",\"MINIO_IDENTITY_OPENID_SCOPES\":\"openid,profile,email,policy\"},\"image\":{\"repository\":\"quay.io/minio/minio\",\"tag\":\"RELEASE.2024-11-07T00-52-20Z\"},\"ingress\":{\"annotations\":{\"cert-manager.io/cluster-issuer\":\"homelab-ca-issuer\"},\"enabled\":true,\"hosts\":[\"minio.local\"],\"ingressClassName\":\"traefik\",\"tls\":[{\"hosts\":[\"minio.local\"],\"secretName\":\"minio.local-tls\"}]},\"mode\":\"standalone\",\"persistence\":{\"size\":\"8Gi\"},\"pools\":1,\"replicas\":1,\"resources\":{\"limits\":{\"memory\":\"512Mi\"},\"requests\":{\"cpu\":\"50m\",\"memory\":\"256Mi\"}},\"rootPassword\":\"(sensitive value)\",\"rootUser\":\"admin\",\"trustedCertsSecret\":\"minio-homelab-ca\"}}","version":"0.1.0"}],"name":"minio","namespace":"minio","pass_credentials":false,"postrender":[],"recreate_pods":false,"render_subchart_notes":true,"replace":false,"repository":null,"repository_ca_file":null,"repository_cert_file":null,"repository_key_file":null,"repository_password":null,"repository_username":null,"reset_values":false,"reuse_values":false,"set":[],"set_list":[],"set_sensitive":[{"name":"minio.environment.MINIO_IDENTITY_OPENID_CLIENT_ID","type":"","value":"dev-minio-oidc-client-id"},{"name":"minio.environment.MINIO_IDENTITY_OPENID_CLIENT_SECRET","type":"","value":"dev-minio-oidc-client-secret-not-for-prod-use"},{"name":"minio.rootPassword","type":"","value":"dev-minio-root-password"}],"skip_crds":false,"status":"deployed","timeout":600,"upgrade_install":null,"values":["minio:\r\n  image:\r\n    repository: quay.io/minio/minio\r\n    # ponytail: pinned — newer builds (tried up through RELEASE.2025-09-07)\r\n    # have a regression where the WebUI never shows the SSO login button\r\n    # despite fully correct, live-verified server-side OIDC config. This tag\r\n    # matches a known-working reference project exactly. Re-test on chart/\r\n    # image bumps before moving off it.\r\n    tag: RELEASE.2024-11-07T00-52-20Z\r\n\r\n  mode: standalone\r\n  replicas: 1\r\n  drivesPerNode: 1\r\n  pools: 1\r\n\r\n  rootUser: admin\r\n  rootPassword: \"\"  # set via terraform variable\r\n\r\n  # ponytail: MinIO does OIDC discovery server-side against Authentik's tailnet\r\n  # HTTPS URL; terraform/coredns.tf points that name at traefik in-cluster with\r\n  # a homelab-CA cert, so MinIO must trust that CA. terraform swaps in the\r\n  # secret name.\r\n  trustedCertsSecret: \"minio-homelab-ca\"\r\n\r\n  # ponytail: chart's post-install job (`mc mb`) creates these. GitLab's\r\n  # consolidated object storage + the CI runner cache all need their bucket\r\n  # to pre-exist — S3 doesn't auto-create. Names must match the buckets in\r\n  # helm/gitlab/values.yaml appConfig + the runner cache config.\r\n  buckets:\r\n    - name: gitlab-runner-cache\r\n    - name: git-lfs\r\n    - name: gitlab-registry\r\n    - name: gitlab-artifacts\r\n    - name: gitlab-uploads\r\n    - name: gitlab-packages\r\n    - name: gitlab-mr-diffs\r\n    - name: gitlab-dependency-proxy\r\n    - name: gitlab-terraform-state\r\n    - name: gitlab-ci-secure-files\r\n    - name: gitlab-backups\r\n    # plan_release/kickoff hand-off: per-role markdown sections + the\r\n    # compiled development-plan.docx, keyed release-reports/\u003cversion\u003e/...\r\n    - name: release-reports\r\n    - name: postgres-backups\r\n    # kaneo's S3-compatible attachment storage (replaces taiga's own PVC).\r\n    - name: kaneo\r\n\r\n  persistence:\r\n    size: 8Gi\r\n\r\n  resources:\r\n    requests:\r\n      cpu: 50m\r\n      memory: 256Mi\r\n    limits:\r\n      memory: 512Mi\r\n\r\n  # ponytail: fixed dev client_id/secret matching the Authentik OAuth2\r\n  # provider created via the API (same one-time-setup pattern as GitLab's).\r\n  # If minio boots before Authentik/tailscale-serve is reachable (e.g. after\r\n  # a full cluster/host restart), the discovery fetch below 502s once and\r\n  # OIDC stays disabled for that pod's lifetime — no retry. Fix: `kubectl\r\n  # rollout restart deploy/minio -n minio` once Authentik is up. Chart has\r\n  # no initContainers hook to wait-for-it automatically (only extraContainers,\r\n  # which doesn't block startup), not worth patching the chart for a homelab.\r\n  environment:\r\n    MINIO_BROWSER: \"on\"\r\n    MINIO_BROWSER_REDIRECT_URL: \"https://minio-console.tail60240b.ts.net\"\r\n    MINIO_IDENTITY_OPENID_CONFIG_URL: \"https://authentik.tail60240b.ts.net/application/o/minio/.well-known/openid-configuration\"\r\n    # MINIO_IDENTITY_OPENID_CLIENT_ID / _CLIENT_SECRET set via terraform (.env)\r\n    MINIO_IDENTITY_OPENID_CLAIM_NAME: \"policy\"\r\n    MINIO_IDENTITY_OPENID_SCOPES: \"openid,profile,email,policy\"\r\n    MINIO_IDENTITY_OPENID_REDIRECT_URI: \"https://minio-console.tail60240b.ts.net/oauth_callback\"\r\n    MINIO_IDENTITY_OPENID_DISPLAY_NAME: \"Authentik\"\r\n\r\n  ingress:\r\n    enabled: true\r\n    ingressClassName: traefik\r\n    annotations:\r\n      cert-manager.io/cluster-issuer: homelab-ca-issuer\r\n    hosts:\r\n      - minio.local\r\n    tls:\r\n      - secretName: minio.local-tls\r\n        hosts:\r\n          - minio.local\r\n\r\n  consoleIngress:\r\n    enabled: true\r\n    ingressClassName: traefik\r\n    annotations:\r\n      cert-manager.io/cluster-issuer: homelab-ca-issuer\r\n    hosts:\r\n      - minio-console.local\r\n    tls:\r\n      - secretName: minio-console.local-tls\r\n        hosts:\r\n          - minio-console.local\r\n"],"verify":false,"version":"0.1.0","wait":true,"wait_for_jobs":false},"sensitive_attributes":[[{"type":"get_attr","value":"repository_password"}],[{"type":"get_attr","value":"set_sensitive"}]],"private":"eyJzY2hlbWFfdmVyc2lvbiI6IjEifQ==","dependencies":["data.kubernetes_secret.homelab_ca_minio","helm_release.cert_manager","kubectl_manifest.homelab_ca","kubectl_manifest.selfsigned_bootstrap","kubernetes_namespace.cert_manager","kubernetes_namespace.minio","kubernetes_secret.minio_homelab_ca","null_resource.homelab_ca_ready"]}]},{"mode":"managed","type":"helm_release","name":"n8n","provider":"provider[\"registry.opentofu.org/hashicorp/helm\"]","instances":[{"schema_version":1,"attributes":{"atomic":false,"chart":"./../../helm/n8n","cleanup_on_fail":false,"create_namespace":false,"dependency_update":true,"description":null,"devel":null,"disable_crd_hooks":false,"disable_openapi_validation":false,"disable_webhooks":false,"force_update":false,"id":"n8n","keyring":null,"lint":false,"manifest":null,"max_history":0,"metadata":[{"app_version":"","chart":"n8n","first_deployed":1789017394,"last_deployed":1791430090,"name":"n8n","namespace":"n8n","notes":"1. Get the application URL by running these commands:\n  export POD_NAME=$(kubectl get pods --namespace n8n -l \"app.kubernetes.io/name=n8n,app.kubernetes.io/instance=n8n\" -o jsonpath=\"{.items[0].metadata.name}\")\n  export CONTAINER_PORT=$(kubectl get pod --namespace n8n $POD_NAME -o jsonpath=\"{.spec.containers[0].ports[0].containerPort}\")\n  echo \"Visit http://127.0.0.1:8080 to use your application\"\n  kubectl --namespace n8n port-forward $POD_NAME 8080:$CONTAINER_PORT\n","revision":23,"values":"{\"chartHash\":\"473623373c5820a9e73dbd643976e3eb01732a95\",\"n8n\":{\"db\":{\"type\":\"postgresdb\"},\"encryptionKey\":\"(sensitive value)\",\"externalPostgresql\":{\"database\":\"n8n\",\"host\":\"postgres.postgres.svc.cluster.local\",\"password\":\"(sensitive value)\",\"port\":5432,\"username\":\"n8n\"},\"main\":{\"extraEnv\":[{\"name\":\"GITLAB_TOKEN_TECH_LEAD\",\"valueFrom\":{\"secretKeyRef\":{\"key\":\"tech-lead\",\"name\":\"omp-role-gitlab-tokens\",\"optional\":true}}}],\"extraEnvVars\":{\"ARGOCD_PROJECT\":\"sdlc-hr-portal\",\"ARGOCD_TOKEN\":\"(sensitive value)\",\"ARGOCD_URL\":\"http://argocd-server.argocd.svc.cluster.local\",\"DEPLOY_NAMESPACE\":\"hr-portal\",\"EXECUTIONS_DATA_MAX_AGE\":\"168\",\"EXECUTIONS_DATA_PRUNE\":\"true\",\"EXECUTIONS_DATA_PRUNE_MAX_COUNT\":\"10000\",\"EXTERNAL_FRONTEND_HOOKS_URLS\":\"/assets/oidc-frontend-hook.js\",\"EXTERNAL_HOOK_FILES\":\"/hooks/hooks.js\",\"GITLAB_PROJECT_ID\":\"4\",\"GITLAB_PROJECT_PATH\":\"sdlc-gI5Dt%2Fhr-portal-dryrun\",\"GITLAB_TOKEN\":\"(sensitive value)\",\"GITLAB_URL\":\"http://gitlab-webservice-default.gitlab.svc.cluster.local:8181\",\"GITLAB_WEBHOOK_SECRET\":\"(sensitive value)\",\"KANEO_PROJECT_ID\":\"1\",\"KANEO_TOKEN\":\"(sensitive value)\",\"KANEO_URL\":\"http://kaneo.kaneo.svc.cluster.local:5173\",\"LITELLM_BASE\":\"http://litellm.litellm.svc.cluster.local:4000\",\"LITELLM_MASTER_KEY\":\"(sensitive value)\",\"MINIO_ENDPOINT\":\"http://minio.minio.svc.cluster.local:9000\",\"MINIO_ROOT_PASSWORD\":\"(sensitive value)\",\"MINIO_ROOT_USER\":\"admin\",\"N8N_ADDITIONAL_NON_UI_ROUTES\":\"auth\",\"N8N_BLOCK_ENV_ACCESS_IN_NODE\":\"false\",\"N8N_EDITOR_BASE_URL\":\"https://n8n.tail60240b.ts.net/\",\"N8N_PROTOCOL\":\"https\",\"N8N_WEBHOOK_BASE\":\"http://localhost:5678/webhook\",\"NODES_EXCLUDE\":\"[]\",\"NODE_EXTRA_CA_CERTS\":\"/homelab-ca/ca.crt\",\"OIDC_CLIENT_ID\":\"(sensitive value)\",\"OIDC_CLIENT_SECRET\":\"(sensitive value)\",\"OIDC_ISSUER_URL\":\"https://authentik.tail60240b.ts.net/application/o/n8n/\",\"OIDC_REDIRECT_URI\":\"https://n8n.tail60240b.ts.net/auth/oidc/callback\",\"OPENWEBUI_CALLBACK_URL\":\"http://localhost:5678/webhook/flow-progress\",\"PRODUCTION_CLUSTER_CONTEXT\":\"k3d-production\",\"RELEASE_VERSION\":\"v0.1.0\",\"SIT_CLUSTER_CONTEXT\":\"k3d-sit\",\"UAT_CLUSTER_CONTEXT\":\"k3d-uat\",\"WEBHOOK_URL\":\"https://n8n.tail60240b.ts.net/\"},\"initContainers\":[{\"command\":[\"sh\",\"-c\",\"until nc -z postgres.postgres.svc.cluster.local 5432; do echo waiting for postgres; sleep 2; done\"],\"image\":\"busybox:1.36\",\"name\":\"wait-for-postgres\"}],\"livenessProbe\":{\"timeoutSeconds\":10},\"persistence\":{\"annotations\":{},\"enabled\":true},\"readinessProbe\":{\"timeoutSeconds\":10},\"resources\":{\"limits\":{\"memory\":\"1Gi\"},\"requests\":{\"cpu\":\"50m\",\"memory\":\"512Mi\"}},\"volumeMounts\":[{\"mountPath\":\"/hooks\",\"name\":\"oidc-hooks\",\"readOnly\":true},{\"mountPath\":\"/homelab-ca\",\"name\":\"homelab-ca\",\"readOnly\":true}],\"volumes\":[{\"configMap\":{\"name\":\"n8n-oidc-hooks\"},\"name\":\"oidc-hooks\"},{\"name\":\"homelab-ca\",\"secret\":{\"optional\":true,\"secretName\":\"homelab-ca\"}}]}}}","version":"0.1.1"}],"name":"n8n","namespace":"n8n","pass_credentials":false,"postrender":[],"recreate_pods":false,"render_subchart_notes":true,"replace":false,"repository":null,"repository_ca_file":null,"repository_cert_file":null,"repository_key_file":null,"repository_password":null,"repository_username":null,"reset_values":false,"reuse_values":false,"set":[{"name":"chartHash","type":"","value":"473623373c5820a9e73dbd643976e3eb01732a95"},{"name":"n8n.main.extraEnvVars.NODE_EXTRA_CA_CERTS","type":"","value":"/homelab-ca/ca.crt"}],"set_list":[],"set_sensitive":[{"name":"n8n.encryptionKey","type":"","value":"dev-n8n-encryption-key-not-for-prod-use"},{"name":"n8n.externalPostgresql.password","type":"","value":"dev-shared-db-password-not-for-prod-use"},{"name":"n8n.main.extraEnvVars.ARGOCD_TOKEN","type":"","value":"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJhcmdvY2QiLCJzdWIiOiJhZG1pbjphcGlLZXkiLCJuYmYiOjE3ODk5NzE2ODMsImlhdCI6MTc4OTk3MTY4MywianRpIjoiNzJmMDc4MDItYWE3MC00ZTEzLThhNzQtM2ZmY2YyNzBkZTAwIn0.xkz3Jje70AUIDstoBdHPNzAFm4Z0_VawviIbiGvhF8Q"},{"name":"n8n.main.extraEnvVars.GITLAB_TOKEN","type":"","value":"glpat-FJcl33yN1Z8J79hHsCWK-m86MQp1OjIH.01.0w0t1zpk8"},{"name":"n8n.main.extraEnvVars.GITLAB_WEBHOOK_SECRET","type":"","value":"dev-gitlab-webhook-secret-not-for-prod-use"},{"name":"n8n.main.extraEnvVars.KANEO_TOKEN","type":"","value":""},{"name":"n8n.main.extraEnvVars.LITELLM_MASTER_KEY","type":"","value":"sk-dev-litellm-master-key-not-for-prod-use"},{"name":"n8n.main.extraEnvVars.MINIO_ROOT_PASSWORD","type":"","value":"dev-minio-root-password"},{"name":"n8n.main.extraEnvVars.OIDC_CLIENT_ID","type":"","value":"dev-n8n-oidc-client-id"},{"name":"n8n.main.extraEnvVars.OIDC_CLIENT_SECRET","type":"","value":"dev-n8n-oidc-client-secret-not-for-prod-use"}],"skip_crds":false,"status":"deployed","timeout":600,"upgrade_install":null,"values":["n8n:\r\n  # ponytail: postgres (external) instead of sqlite — sqlite's single-writer\r\n  # lock stalls under the SDLC flows' concurrent webhook fan-out. Connects to\r\n  # the shared postgres (helm/postgres), database + role `n8n`.\r\n  db:\r\n    type: postgresdb\r\n  externalPostgresql:\r\n    host: postgres.postgres.svc.cluster.local\r\n    port: 5432\r\n    username: n8n\r\n    database: n8n\r\n    password: \"\"  # set via terraform (shared_db_password)\r\n\r\n  main:\r\n    # ponytail: after a full cluster/host reboot postgres isn't always up\r\n    # before n8n starts — n8n's own SIGTERM-during-DNS-retry path throws\r\n    # (\"Cannot read properties of undefined (reading\r\n    # 'removeAllQueuedWorkflowActivations')\") and it crash-loops instead of\r\n    # cleanly retrying. Block startup until postgres actually accepts TCP.\r\n    initContainers:\r\n      - name: wait-for-postgres\r\n        image: busybox:1.36\r\n        command: [\"sh\", \"-c\", \"until nc -z postgres.postgres.svc.cluster.local 5432; do echo waiting for postgres; sleep 2; done\"]\r\n    persistence:\r\n      enabled: true\r\n      # ponytail: chart defaults this to \"helm.sh/resource-policy: keep\",\r\n      # which blocks recreating the PVC after a manual delete (e.g. wiping it\r\n      # to reset the encryption key) — drop it so Helm fully owns the PVC\r\n      # lifecycle like every other app's storage in this repo.\r\n      annotations: {}\r\n    resources:\r\n      requests:\r\n        cpu: 50m\r\n        memory: 512Mi\r\n      limits:\r\n        # ponytail: 512Mi wasn't enough headroom for Node's heap on top of\r\n        # n8n's own footprint — OOMKilled with \"JavaScript heap out of memory\"\r\n        memory: 1Gi\r\n\r\n    # ponytail: chart's 1s default probe timeout is too tight on this RPi\r\n    # under load (6 apps running concurrently) — caused a liveness-kill\r\n    # restart loop even though n8n was actually up. Same fix as sonarqube/\r\n    # seafile-mariadb's probe timeouts.\r\n    livenessProbe:\r\n      timeoutSeconds: 10\r\n    readinessProbe:\r\n      timeoutSeconds: 10\r\n\r\n    # ponytail: n8n gates native OIDC/SSO behind an Enterprise license.\r\n    # cweagans/n8n-oidc (MIT) bolts it on via n8n's external-hooks system\r\n    # instead — no license, no fork, just a JS file + env vars. hooks.js is\r\n    # mounted from a ConfigMap terraform/internal/n8n.tf builds from\r\n    # helm/n8n/hooks.js.\r\n    volumes:\r\n      - name: oidc-hooks\r\n        configMap:\r\n          name: n8n-oidc-hooks\r\n      # ponytail: homelab-ca Secret — always provided by\r\n      # terraform/internal/n8n.tf, `optional: true` is just defensive. See\r\n      # that file for the copy-in + NODE_EXTRA_CA_CERTS below.\r\n      - name: homelab-ca\r\n        secret:\r\n          secretName: homelab-ca\r\n          optional: true\r\n    volumeMounts:\r\n      - name: oidc-hooks\r\n        mountPath: /hooks\r\n        readOnly: true\r\n      - name: homelab-ca\r\n        mountPath: /homelab-ca\r\n        readOnly: true\r\n\r\n    # ponytail: fixed dev client_id/secret matching the Authentik OAuth2\r\n    # provider created via the API (same one-time-setup pattern as the\r\n    # other apps'). OIDC_ISSUER_URL uses the tailscale hostname so the\r\n    # server-side discovery fetch and the browser redirect agree on the\r\n    # same authority — same reasoning as minio/gitlab's OIDC wiring.\r\n    extraEnvVars:\r\n      # ponytail: unbounded execution history was piling up (191 rows found\r\n      # manually cleaned once) — prune anything finished older than 7 days,\r\n      # capped at 10k rows regardless of age.\r\n      EXECUTIONS_DATA_PRUNE: \"true\"\r\n      EXECUTIONS_DATA_MAX_AGE: \"168\"\r\n      EXECUTIONS_DATA_PRUNE_MAX_COUNT: \"10000\"\r\n      # ponytail: n8n 2.0 disables executeCommand + localFileTrigger by default\r\n      # (NODES_EXCLUDE defaults to that pair). The SDLC flows are built on\r\n      # executeCommand — without this, seeded flows fail to activate and a\r\n      # manual run 502s. \"[]\" re-enables all. Revisit if these flows ever stop\r\n      # shelling out (GitLab REST node instead of glab, k8s API instead of kubectl).\r\n      NODES_EXCLUDE: \"[]\"\r\n      # ponytail: flows call sibling flows by webhook (…/spawn-role, …/dod-check).\r\n      # In-cluster self-call over localhost — no proxy round-trip, no tailnet.\r\n      N8N_WEBHOOK_BASE: \"http://localhost:5678/webhook\"\r\n      # F-28 mm-chat: LiteLLM base + key so the chat flow can POST\r\n      # /v1/chat/completions against the `omp` model (always-on omp pod via\r\n      # omp-adapter). LITELLM_MASTER_KEY injected by terraform set_sensitive.\r\n      LITELLM_BASE: \"http://litellm.litellm.svc.cluster.local:4000\"\r\n      # ponytail: every SDLC flow's \"Notify: ...\" nodes POST progress here.\r\n      # NOT OpenWebUI directly — OpenWebUI Functions can't register custom\r\n      # FastAPI routes (confirmed against its function loader source), so\r\n      # sdlc_pipe.py's old push-callback design (/api/v1/pipe/callback) was\r\n      # dead code and never worked. Instead this posts to n8n's own F-29 sink\r\n      # flow (self-call, matching N8N_WEBHOOK_BASE below), which inserts into\r\n      # the sdlc_flow_progress Postgres table; sdlc_pipe.py polls F-30 to read\r\n      # it back. Var name kept as-is — every flow's Notify node reads it, a\r\n      # rename would mean touching all of them for no benefit.\r\n      OPENWEBUI_CALLBACK_URL: \"http://localhost:5678/webhook/flow-progress\"\r\n      # the SDLC flows + F-28 read config from $env in expressions; n8n blocks\r\n      # that by default.\r\n      N8N_BLOCK_ENV_ACCESS_IN_NODE: \"false\"\r\n      # F-00 verifies the GitLab webhook's X-GitLab-Token against this. Must\r\n      # match what playbooks/gitlab-webhook.yml registers the hook with.\r\n      # GITLAB_WEBHOOK_SECRET injected by terraform set_sensitive.\r\n      EXTERNAL_HOOK_FILES: \"/hooks/hooks.js\"\r\n      # F-05/F-08 call the in-cluster GitLab API directly (Code nodes) instead\r\n      # of spawning an agent pod for a simple read. GITLAB_TOKEN is\r\n      # var.omp_gitlab_token (terraform set_sensitive) — same token the agent\r\n      # pods use, reused here since it's already scoped to this project.\r\n      GITLAB_URL: \"http://gitlab-webservice-default.gitlab.svc.cluster.local:8181\"\r\n      # ponytail: these 4 vars (+ ARGOCD_PROJECT/DEPLOY_NAMESPACE below) are\r\n      # only the FALLBACK now — F-03/04/05/06/07/10/14/17/24/27 each check\r\n      # gitlab_project_path/id, argocd_project, deploy_namespace from the\r\n      # triggering call first (chat body for chat-invoked flows, the GitLab\r\n      # webhook payload itself for F-04/05/07, forwarded flow-to-flow where\r\n      # one flow calls another — e.g. F-05 -\u003e F-06). Only falls back to these\r\n      # static values when a caller omits them, so \"one project in flight\"\r\n      # still works with zero chat args for the dry-run fixture below. A new\r\n      # flow reading $env.GITLAB_PROJECT_PATH/_ID/ARGOCD_PROJECT/\r\n      # DEPLOY_NAMESPACE directly needs the same $node['Webhook\r\n      # Trigger'].json.body.\u003cfield\u003e ?? $env.\u003cVAR\u003e pattern, not a bare $env read.\r\n      GITLAB_PROJECT_PATH: \"sdlc-gI5Dt%2Fhr-portal-dryrun\"\r\n      GITLAB_PROJECT_ID: \"4\"\r\n      RELEASE_VERSION: \"v0.1.0\"\r\n      # Ticket calls moved off GitLab issues onto Kaneo (wiki moved to\r\n      # GitLab's own wiki module instead — see AGENTS.md's \"GitLab\r\n      # compliance history\"). In-cluster address, same reason ARGOCD_URL\r\n      # below is in-cluster: pods can't route to the Tailscale Service VIP,\r\n      # so the external tailnet URL just times out (see AGENT.md's\r\n      # \"in-cluster can't reach the tailnet hostname\"). Plain default, no\r\n      # __PLACEHOLDER__ needed. KANEO_PROJECT_ID below is only the fallback\r\n      # (same role as GITLAB_PROJECT_PATH/_ID above) — F-02's \"Ensure Kaneo\r\n      # Project\" step get-or-creates a real Kaneo project per kickoff and\r\n      # threads its id as kaneo_project_id through every role spawn from\r\n      # there; F-31 prefers that over this env var. Only a kickoff run with\r\n      # no Kaneo project step (an old workflow version still loaded) falls\r\n      # back to this id. F-03 (/develop) never threads kaneo_project_id\r\n      # through at all -- its role prompts read `{{ $env.KANEO_PROJECT_ID }}`\r\n      # directly, so this value IS the real project for every /develop run,\r\n      # not just a last-resort fallback -- bump it by hand whenever the\r\n      # dry-run project changes. KANEO_TOKEN is terraform set_sensitive\r\n      # (var.kaneo_api_token) — see n8n.tf.\r\n      KANEO_URL: \"http://kaneo.kaneo.svc.cluster.local:5173\"\r\n      KANEO_PROJECT_ID: \"1\"\r\n      # plan_release/kickoff report hand-off bucket (release-reports, see\r\n      # helm/minio/values.yaml) — same in-cluster-address, plain-default\r\n      # convention as TAIGA_URL above. MINIO_ROOT_PASSWORD is terraform\r\n      # set_sensitive (var.minio_root_password) — see n8n.tf.\r\n      MINIO_ENDPOINT: \"http://minio.minio.svc.cluster.local:9000\"\r\n      MINIO_ROOT_USER: \"admin\"\r\n      # sit/uat/qa/staging/production are now separate k3d clusters (k3d-sit,\r\n      # k3d-uat, ...), each on its own docker network — NOT reachable from\r\n      # n8n/argocd (running in k3d-internal) via in-cluster service DNS. Argo\r\n      # itself lives in k3d-internal alongside n8n, so ARGOCD_URL stays\r\n      # in-cluster; ARGOCD_TOKEN is a per-account API token (mint by hand:\r\n      # `argocd account generate-token --account n8n`, see README env-var\r\n      # table), var.argocd_token (terraform set_sensitive).\r\n      ARGOCD_URL: \"http://argocd-server.argocd.svc.cluster.local\"\r\n      ARGOCD_PROJECT: \"sdlc-hr-portal\"\r\n      # F-27 cluster-lifecycle's kubectl step and any devops-engineer pod CLI\r\n      # work need real context names, not the old single-cluster \"{cluster}-ctx\"\r\n      # guess. Each context's API server resolves via host.docker.internal —\r\n      # Docker Desktop injects that hostname on every container regardless of\r\n      # which docker network it's on, so k3d-internal pods can reach these.\r\n      # ponytail: ports are whatever k3d assigned this run — `k3d cluster list`\r\n      # / `kubectl config view` to reconfirm after any cluster recreate.\r\n      # Only 4 clusters exist — no separate QA or staging cluster.\r\n      # QA-related tasks (story-level testing) target SIT_CLUSTER_CONTEXT;\r\n      # staging-related tasks (promotion retag, perf/security confirmation)\r\n      # target UAT_CLUSTER_CONTEXT.\r\n      SIT_CLUSTER_CONTEXT: \"k3d-sit\"\r\n      UAT_CLUSTER_CONTEXT: \"k3d-uat\"\r\n      PRODUCTION_CLUSTER_CONTEXT: \"k3d-production\"\r\n      # deploy namespace inside each of the 3 target clusters (each cluster is\r\n      # single-purpose for its phase, so one fixed namespace per cluster is\r\n      # enough — no per-phase name collision to worry about).\r\n      DEPLOY_NAMESPACE: \"hr-portal\"\r\n      N8N_ADDITIONAL_NON_UI_ROUTES: \"auth\"\r\n      EXTERNAL_FRONTEND_HOOKS_URLS: \"/assets/oidc-frontend-hook.js\"\r\n      N8N_PROTOCOL: \"https\"\r\n      # https://n8n.tail60240b.ts.net / https://authentik.tail60240b.ts.net are string-replaced by terraform with\r\n      # this app's and Authentik's tailscale-operator MagicDNS URLs\r\n      # (https://n8n.\u003ctailnet\u003e.ts.net etc).\r\n      N8N_EDITOR_BASE_URL: \"https://n8n.tail60240b.ts.net/\"\r\n      WEBHOOK_URL: \"https://n8n.tail60240b.ts.net/\"\r\n      OIDC_ISSUER_URL: \"https://authentik.tail60240b.ts.net/application/o/n8n/\"\r\n      # OIDC_CLIENT_ID / OIDC_CLIENT_SECRET set via terraform (.env)\r\n      OIDC_REDIRECT_URI: \"https://n8n.tail60240b.ts.net/auth/oidc/callback\"\r\n\r\n    # ponytail: F-04's native MR-review flow (approve/merge/comment) needs\r\n    # to act as tech-lead, not n8n's own shared GITLAB_TOKEN admin identity\r\n    # — found live: a \"handing this MR over to a human reviewer\" comment\r\n    # showed up as the human operator's own account. secretKeyRef only\r\n    # resolves within this pod's own namespace, so role-accounts.yml\r\n    # mirrors omp-role-gitlab-tokens into `n8n` too (RBAC:\r\n    # terraform/internal/ansible.tf's ansible_n8n_secrets). optional: true\r\n    # — blank until that playbook has run at least once; F-04 falls back to\r\n    # $env.GITLAB_TOKEN when this is empty.\r\n    extraEnv:\r\n      - name: GITLAB_TOKEN_TECH_LEAD\r\n        valueFrom:\r\n          secretKeyRef:\r\n            name: omp-role-gitlab-tokens\r\n            key: tech-lead\r\n            optional: true\r\n\r\n# ponytail: flow seeding (and n8n owner setup + API-key minting) moved to the\r\n# ansible runner — helm/ansible/flows/ + playbooks/n8n.yml. Run it with\r\n# `scripts/ansible-run.sh n8n`.\r\n"],"verify":false,"version":"0.1.1","wait":true,"wait_for_jobs":false},"sensitive_attributes":[[{"type":"get_attr","value":"repository_password"}],[{"type":"get_attr","value":"set_sensitive"}]],"private":"eyJzY2hlbWFfdmVyc2lvbiI6IjEifQ==","dependencies":["data.kubernetes_secret.homelab_ca_n8n","helm_release.cert_manager","helm_release.postgres","kubectl_manifest.homelab_ca","kubectl_manifest.selfsigned_bootstrap","kubernetes_config_map.n8n_oidc_hooks","kubernetes_namespace.cert_manager","kubernetes_namespace.n8n","kubernetes_namespace.postgres","kubernetes_namespace.sdlc","kubernetes_secret.n8n_homelab_ca","null_resource.homelab_ca_ready"]}]},{"mode":"managed","type":"helm_release","name":"nextcloud","provider":"provider[\"registry.opentofu.org/hashicorp/helm\"]","instances":[{"schema_version":1,"attributes":{"atomic":false,"chart":"./../../helm/nextcloud","cleanup_on_fail":false,"create_namespace":false,"dependency_update":true,"description":null,"devel":null,"disable_crd_hooks":false,"disable_openapi_validation":false,"disable_webhooks":false,"force_update":false,"id":"nextcloud","keyring":null,"lint":false,"manifest":null,"max_history":0,"metadata":[{"app_version":"","chart":"nextcloud","first_deployed":1789017132,"last_deployed":1790595020,"name":"nextcloud","namespace":"nextcloud","notes":"1. Get the nextcloud URL by running:\n\n  export POD_NAME=$(kubectl get pods --namespace nextcloud -l \"app.kubernetes.io/name=nextcloud\" -o jsonpath=\"{.items[0].metadata.name}\")\n  echo http://127.0.0.1:8080/\n  kubectl port-forward --namespace nextcloud $POD_NAME 8080:80\n\n2. Get your nextcloud login credentials by running:\n\n  echo User:     admin\n  echo Password: $(kubectl get secret --namespace nextcloud nextcloud -o jsonpath=\"{.data.nextcloud-password}\" | base64 --decode)\n","revision":4,"values":"{\"mariadb\":{\"database\":\"nextcloud\",\"image\":\"mariadb:11.4\",\"password\":\"(sensitive value)\",\"resources\":{\"limits\":{\"memory\":\"512Mi\"},\"requests\":{\"cpu\":\"50m\",\"memory\":\"256Mi\"}},\"rootPassword\":\"(sensitive value)\",\"storageSize\":\"4Gi\",\"username\":\"nextcloud\"},\"nextcloud\":{\"externalDatabase\":{\"database\":\"nextcloud\",\"enabled\":true,\"host\":\"nextcloud-mariadb\",\"password\":\"(sensitive value)\",\"type\":\"mysql\",\"user\":\"nextcloud\"},\"ingress\":{\"annotations\":{\"cert-manager.io/cluster-issuer\":\"homelab-ca-issuer\"},\"className\":\"traefik\",\"enabled\":true,\"tls\":[{\"hosts\":[\"nextcloud.local\"],\"secretName\":\"nextcloud.local-tls\"}]},\"internalDatabase\":{\"enabled\":false},\"lifecycle\":{\"postStartCommand\":[\"/bin/sh\",\"-c\",\"OCC=\\\"runuser -u www-data -- php /var/www/html/occ\\\"\\ni=0\\nuntil $OCC status 2\\u003e/dev/null | grep -q 'installed: true'; do\\n  i=$((i+1)); [ $i -ge 240 ] \\u0026\\u0026 exit 0; sleep 2\\ndone\\n# ponytail: the k3d node's egress to apps.nextcloud.com is flaky (same\\n# i/o timeouts that hit ACME) — a single app:install often stalls\\n# mid-download. Retry, and only wire up SSO once the app is actually\\n# enabled, so a failed download leaves nextcloud usable (local login)\\n# instead of half-configured. Runs every boot; no-ops once installed.\\nn=0\\nuntil $OCC app:list --output=json 2\\u003e/dev/null | grep -q '\\\"sociallogin\\\"'; do\\n  n=$((n+1)); [ $n -ge 15 ] \\u0026\\u0026 break\\n  $OCC app:install sociallogin 2\\u003e/dev/null || $OCC app:enable sociallogin 2\\u003e/dev/null || true\\n  sleep 6\\ndone\\nif $OCC app:list --output=json 2\\u003e/dev/null | grep -q '\\\"sociallogin\\\"'; then\\n  $OCC config:system:set allow_local_remote_servers --type=boolean --value=true\\n  $OCC config:app:set sociallogin custom_providers --value='{\\\"custom_oidc\\\":[{\\\"name\\\":\\\"authentik\\\",\\\"title\\\":\\\"Authentik\\\",\\\"authorizeUrl\\\":\\\"https://authentik.tail60240b.ts.net/application/o/authorize/\\\",\\\"tokenUrl\\\":\\\"http://authentik-server.authentik.svc.cluster.local/application/o/token/\\\",\\\"userInfoUrl\\\":\\\"http://authentik-server.authentik.svc.cluster.local/application/o/userinfo/\\\",\\\"logoutUrl\\\":\\\"\\\",\\\"clientId\\\":\\\"dev-nextcloud-oidc-client-id\\\",\\\"clientSecret\\\":\\\"dev-nextcloud-oidc-client-secret-not-for-prod-use\\\",\\\"scope\\\":\\\"openid profile email\\\",\\\"groupsClaim\\\":\\\"groups\\\",\\\"displayNameClaim\\\":\\\"name\\\",\\\"style\\\":\\\"\\\",\\\"defaultGroup\\\":\\\"\\\"}]}'\\n  $OCC config:app:set sociallogin update_profile_on_login --value=1\\n  $OCC config:app:set sociallogin disable_registration --value=0\\n  # ponytail: auto-redirect login page straight to Authentik. Reach the\\n  # local login form at /login?noredir=1 if you ever need it.\\n  $OCC config:system:set social_login_auto_redirect --type=boolean --value=true\\nfi\\n\"]},\"mariadb\":{\"enabled\":false},\"nextcloud\":{\"extraEnv\":[{\"name\":\"NEXTCLOUD_TRUSTED_DOMAINS\",\"value\":\"nextcloud.local nextcloud.tail60240b.ts.net\"},{\"name\":\"OVERWRITEHOST\",\"value\":\"nextcloud.tail60240b.ts.net\"},{\"name\":\"OVERWRITEPROTOCOL\",\"value\":\"https\"},{\"name\":\"OVERWRITECLIURL\",\"value\":\"https://nextcloud.tail60240b.ts.net\"},{\"name\":\"TRUSTED_PROXIES\",\"value\":\"10.0.0.0/8 100.64.0.0/10\"}],\"host\":\"nextcloud.local\",\"password\":\"(sensitive value)\",\"podSecurityContext\":{\"fsGroup\":33,\"fsGroupChangePolicy\":\"OnRootMismatch\"},\"username\":\"admin\"},\"persistence\":{\"accessMode\":\"ReadWriteOnce\",\"enabled\":true,\"size\":\"20Gi\"},\"redis\":{\"enabled\":false},\"resources\":{\"limits\":{\"memory\":\"1536Mi\"},\"requests\":{\"cpu\":\"100m\",\"memory\":\"512Mi\"}},\"startupProbe\":{\"enabled\":true,\"failureThreshold\":120,\"initialDelaySeconds\":30,\"periodSeconds\":10}}}","version":"0.1.0"}],"name":"nextcloud","namespace":"nextcloud","pass_credentials":false,"postrender":[],"recreate_pods":false,"render_subchart_notes":true,"replace":false,"repository":null,"repository_ca_file":null,"repository_cert_file":null,"repository_key_file":null,"repository_password":null,"repository_username":null,"reset_values":false,"reuse_values":false,"set":[],"set_list":[],"set_sensitive":[{"name":"mariadb.password","type":"","value":"dev-nextcloud-db-password"},{"name":"mariadb.rootPassword","type":"","value":"dev-nextcloud-db-root-password"},{"name":"nextcloud.externalDatabase.password","type":"","value":"dev-nextcloud-db-password"},{"name":"nextcloud.nextcloud.password","type":"","value":"dev-nextcloud-admin-password"}],"skip_crds":false,"status":"deployed","timeout":1500,"upgrade_install":null,"values":["nextcloud:\n  nextcloud:\n    # ponytail: ingress rule host stays the LAN name; the tailnet name is the\n    # \"real\" external URL Nextcloud bakes into generated links, injected via\n    # OVERWRITEHOST/CLIURL below. nextcloud.tail60240b.ts.net (no scheme) / https://nextcloud.tail60240b.ts.net (with\n    # https) are string-replaced by terraform with the tailscale\n    # operator MagicDNS name (nextcloud.\u003ctailnet\u003e.ts.net).\n    host: nextcloud.local\n    username: admin\n    password: \"\"  # set via terraform\n    extraEnv:\n      # ponytail: both names must be trusted or Nextcloud 400s the request whose\n      # Host header it doesn't recognise (tailnet host arrives via the operator).\n      - name: NEXTCLOUD_TRUSTED_DOMAINS\n        value: \"nextcloud.local nextcloud.tail60240b.ts.net\"\n      - name: OVERWRITEHOST\n        value: nextcloud.tail60240b.ts.net\n      - name: OVERWRITEPROTOCOL\n        value: https\n      - name: OVERWRITECLIURL\n        value: https://nextcloud.tail60240b.ts.net\n      # ponytail: traefik pod (cluster CIDR) + tailscale operator proxy\n      # (100.64/10 CGNAT) sit in front — without this, X-Forwarded-* is\n      # ignored and every generated link points at the in-pod address.\n      - name: TRUSTED_PROXIES\n        value: \"10.0.0.0/8 100.64.0.0/10\"\n    # ponytail: single pod, so APCu local cache is enough — no redis subchart,\n    # no \"don't name the Service 'redis'\" dance seafile needed. apcu.config.php\n    # is on by default via defaultConfigs.\n\n    # ponytail: chart default fsGroupChangePolicy is Always, so the kubelet\n    # recursively chowns all ~15k files of the data PVC on every pod start —\n    # minutes of stall on local-path storage, and it made helm --wait time out\n    # (\"Setting volume ownership ... is taking longer than expected\"). This\n    # replaces the chart's default block, so fsGroup: 33 must stay. OnRootMismatch\n    # only chowns when the volume root's gid is wrong (i.e. first boot only).\n    podSecurityContext:\n      fsGroup: 33\n      fsGroupChangePolicy: OnRootMismatch\n\n  # ponytail: OAuth wiring via `occ` in postStart — the chart has no init\n  # hook-point after the entrypoint's first-boot install. Polls until installed,\n  # then every boot re-applies the Social Login provider so URL changes take\n  # effect. Key is nextcloud.lifecycle (chart root), NOT nextcloud.nextcloud.*.\n  # https://authentik.tail60240b.ts.net / dev-nextcloud-oidc-client-id / _SECRET__ are string-\n  # replaced on the rendered YAML by terraform (not --set — this is\n  # one multi-line shell string). authorizeUrl is the external tailnet URL (the\n  # browser hits it); token + userinfo are in-cluster http (the pod hits them).\n  lifecycle:\n    postStartCommand:\n      - /bin/sh\n      - -c\n      - |\n        OCC=\"runuser -u www-data -- php /var/www/html/occ\"\n        i=0\n        until $OCC status 2\u003e/dev/null | grep -q 'installed: true'; do\n          i=$((i+1)); [ $i -ge 240 ] \u0026\u0026 exit 0; sleep 2\n        done\n        # ponytail: the k3d node's egress to apps.nextcloud.com is flaky (same\n        # i/o timeouts that hit ACME) — a single app:install often stalls\n        # mid-download. Retry, and only wire up SSO once the app is actually\n        # enabled, so a failed download leaves nextcloud usable (local login)\n        # instead of half-configured. Runs every boot; no-ops once installed.\n        n=0\n        until $OCC app:list --output=json 2\u003e/dev/null | grep -q '\"sociallogin\"'; do\n          n=$((n+1)); [ $n -ge 15 ] \u0026\u0026 break\n          $OCC app:install sociallogin 2\u003e/dev/null || $OCC app:enable sociallogin 2\u003e/dev/null || true\n          sleep 6\n        done\n        if $OCC app:list --output=json 2\u003e/dev/null | grep -q '\"sociallogin\"'; then\n          $OCC config:system:set allow_local_remote_servers --type=boolean --value=true\n          $OCC config:app:set sociallogin custom_providers --value='{\"custom_oidc\":[{\"name\":\"authentik\",\"title\":\"Authentik\",\"authorizeUrl\":\"https://authentik.tail60240b.ts.net/application/o/authorize/\",\"tokenUrl\":\"http://authentik-server.authentik.svc.cluster.local/application/o/token/\",\"userInfoUrl\":\"http://authentik-server.authentik.svc.cluster.local/application/o/userinfo/\",\"logoutUrl\":\"\",\"clientId\":\"dev-nextcloud-oidc-client-id\",\"clientSecret\":\"dev-nextcloud-oidc-client-secret-not-for-prod-use\",\"scope\":\"openid profile email\",\"groupsClaim\":\"groups\",\"displayNameClaim\":\"name\",\"style\":\"\",\"defaultGroup\":\"\"}]}'\n          $OCC config:app:set sociallogin update_profile_on_login --value=1\n          $OCC config:app:set sociallogin disable_registration --value=0\n          # ponytail: auto-redirect login page straight to Authentik. Reach the\n          # local login form at /login?noredir=1 if you ever need it.\n          $OCC config:system:set social_login_auto_redirect --type=boolean --value=true\n        fi\n\n  # ponytail: first boot rsyncs ~10k files of /var/www/html onto local-path\n  # storage (slow on a Docker-Desktop bind mount) - the default liveness probe\n  # SIGKILLs the container mid-init (exit 137) and it never finishes. startupProbe\n  # suspends liveness until install completes; 120 x 10s = 20 min ceiling. Raise\n  # failureThreshold if a fresh PVC still gets killed.\n  startupProbe:\n    enabled: true\n    initialDelaySeconds: 30\n    periodSeconds: 10\n    failureThreshold: 120\n\n  internalDatabase:\n    enabled: false\n\n  # ponytail: bundled bitnami mariadb off — replaced by templates/mariadb.yaml\n  # (plain official mariadb:11 image, same pattern as helm/n8n's postgres).\n  mariadb:\n    enabled: false\n  externalDatabase:\n    enabled: true\n    type: mysql\n    host: nextcloud-mariadb\n    database: nextcloud\n    user: nextcloud\n    password: \"\"  # set via terraform\n\n  redis:\n    enabled: false\n\n  persistence:\n    enabled: true\n    accessMode: ReadWriteOnce\n    size: 20Gi\n\n  resources:\n    requests:\n      cpu: 100m\n      memory: 512Mi\n    limits:\n      memory: 1536Mi\n\n  ingress:\n    enabled: true\n    className: traefik\n    annotations:\n      cert-manager.io/cluster-issuer: homelab-ca-issuer\n    tls:\n      - secretName: nextcloud.local-tls\n        hosts:\n          - nextcloud.local\n\n# ponytail: consumed by templates/mariadb.yaml (this wrapper chart's own\n# template). Keep database/user/password in sync with nextcloud.externalDatabase.\nmariadb:\n  image: mariadb:11.4\n  database: nextcloud\n  username: nextcloud\n  password: \"\"       # set via terraform\n  rootPassword: \"\"   # set via terraform\n  storageSize: 4Gi\n  resources:\n    requests:\n      cpu: 50m\n      memory: 256Mi\n    limits:\n      memory: 512Mi\n"],"verify":false,"version":"0.1.0","wait":true,"wait_for_jobs":false},"sensitive_attributes":[[{"type":"get_attr","value":"repository_password"}],[{"type":"get_attr","value":"set_sensitive"}],[{"type":"get_attr","value":"values"},{"type":"index","value":{"value":0,"type":"number"}}]],"private":"eyJzY2hlbWFfdmVyc2lvbiI6IjEifQ==","dependencies":["kubernetes_namespace.nextcloud"]}]},{"mode":"managed","type":"helm_release","name":"observability","provider":"provider[\"registry.opentofu.org/hashicorp/helm\"]","instances":[{"schema_version":1,"attributes":{"atomic":false,"chart":"./../../helm/observability","cleanup_on_fail":false,"create_namespace":false,"dependency_update":true,"description":null,"devel":null,"disable_crd_hooks":false,"disable_openapi_validation":false,"disable_webhooks":false,"force_update":false,"id":"observability","keyring":null,"lint":false,"manifest":null,"max_history":0,"metadata":[{"app_version":"","chart":"observability","first_deployed":1789017135,"last_deployed":1791441017,"name":"observability","namespace":"observability","notes":"Welcome to Grafana Mimir!\nRemote write endpoints for Prometheus or Grafana Agent:\nIngress is not enabled, see the gateway.ingress values.\nFrom inside the cluster:\n  http://observability-mimir-gateway.observability.svc:80/api/v1/push\n\nRead address, Grafana data source (Prometheus) URL:\nIngress is not enabled, see the gateway.ingress values.\nFrom inside the cluster:\n  http://observability-mimir-gateway.observability.svc:80/prometheus\n\n**IMPORTANT**: Always consult CHANGELOG.md file at https://github.com/grafana/mimir/blob/main/operations/helm/charts/mimir-distributed/CHANGELOG.md and the deprecation list there to learn about breaking changes that require action during upgrade.\n\nThe Prometheus server can be accessed via port 80 on the following DNS name from within your cluster:\nobservability-prometheus-server.observability.svc.cluster.local\n\n\nGet the Prometheus server URL by running these commands in the same shell:\n  export POD_NAME=$(kubectl get pods --namespace observability -l \"app.kubernetes.io/name=prometheus,app.kubernetes.io/instance=observability\" -o jsonpath=\"{.items[0].metadata.name}\")\n  kubectl --namespace observability port-forward $POD_NAME 9090\n\n\n\n\n\nFor more information on running Prometheus, visit:\nhttps://prometheus.io/\n\nWelcome to Grafana Alloy!\n\n1. Get the application URL by running these commands:\n  export POD_NAME=$(kubectl get pods --namespace observability -l \"app.kubernetes.io/name=prometheus-node-exporter,app.kubernetes.io/instance=observability\" -o jsonpath=\"{.items[0].metadata.name}\")\n  echo \"Visit http://127.0.0.1:9100 to use your application\"\n  kubectl port-forward --namespace observability $POD_NAME 9100\nkube-state-metrics is a simple service that listens to the Kubernetes API server and generates metrics about the state of the objects.\nThe exposed metrics can be found here:\nhttps://github.com/kubernetes/kube-state-metrics/blob/master/docs/README.md#exposed-metrics\n\nThe metrics are exported on the HTTP endpoint /metrics on the listening port.\nIn your case, observability-kube-state-metrics.observability.svc.cluster.local:8080/metrics\n\nThey are served either as plaintext or protobuf depending on the Accept header.\nThey are designed to be consumed either by Prometheus itself or by a scraper that is compatible with scraping a Prometheus client endpoint.\n\n1. Get your 'admin' user password by running:\n\n   kubectl get secret --namespace observability observability-grafana -o jsonpath=\"{.data.admin-password}\" | base64 --decode ; echo\n\n\n2. The Grafana server can be accessed via port 80 on the following DNS name from within your cluster:\n\n   observability-grafana.observability.svc.cluster.local\n\n   If you bind grafana to 80, please update values in values.yaml and reinstall:\n   ```\n   securityContext:\n     runAsUser: 0\n     runAsGroup: 0\n     fsGroup: 0\n\n   command:\n   - \"setcap\"\n   - \"'cap_net_bind_service=+ep'\"\n   - \"/usr/sbin/grafana-server \u0026\u0026\"\n   - \"sh\"\n   - \"/run.sh\"\n   ```\n   Details refer to https://grafana.com/docs/installation/configuration/#http-port.\n   Or grafana would always crash.\n\n   From outside the cluster, the server URL(s) are:\n     http://grafana.local\n\n3. Login with the password from step 1 and the username: admin\n\n***********************************************************************\n Welcome to Grafana Loki\n Chart version: 7.3.0\n Chart Name: loki\n Loki version: 3.6.12\n***********************************************************************\n\n** Please be patient while the chart is being deployed **\n\nTip:\n\n  Watch the deployment status using the command: kubectl get pods -w --namespace observability\n\nIf pods are taking too long to schedule make sure pod affinity can be fulfilled in the current cluster.\n\n***********************************************************************\nInstalled components:\n***********************************************************************\n* loki\n\nLoki has been deployed as a single binary.\nThis means a single pod is handling reads and writes. You can scale that pod vertically by adding more CPU and memory resources.\n\n\n***********************************************************************\nSending logs to Loki\n***********************************************************************\n\nYou can send logs from inside the cluster using the cluster DNS:\n\nhttp://observability-loki.observability.svc.cluster.local:3100/loki/api/v1/push\n\nYou can test to send data from outside the cluster by port-forwarding the gateway to your local machine:\n\n  kubectl port-forward --namespace observability svc/observability-loki 3100:3100 \u0026\n\nAnd then using http://127.0.0.1:3100/loki/api/v1/push URL as shown below:\n\n```\ncurl -H \"Content-Type: application/json\" -XPOST -s \"http://127.0.0.1:3100/loki/api/v1/push\"  \\\n--data-raw \"{\\\"streams\\\": [{\\\"stream\\\": {\\\"job\\\": \\\"test\\\"}, \\\"values\\\": [[\\\"$(date +%s)000000000\\\", \\\"fizzbuzz\\\"]]}]}\"\n```\n\nThen verify that Loki did receive the data using the following command:\n\n```\ncurl \"http://127.0.0.1:3100/loki/api/v1/query_range\" --data-urlencode 'query={job=\"test\"}' | jq .data.result\n```\n\n***********************************************************************\nConnecting Grafana to Loki\n***********************************************************************\n\nIf Grafana operates within the cluster, you'll set up a new Loki datasource by utilizing the following URL:\n\nhttp://observability-loki.observability.svc.cluster.local:3100/\n","revision":20,"values":"{\"alloy\":{\"alloy\":{\"configMap\":{\"content\":\"// ── K8s pod logs → Loki ──────────────────────────────────────────────\\ndiscovery.kubernetes \\\"pods\\\" {\\n  role = \\\"pod\\\"\\n}\\n\\ndiscovery.relabel \\\"pod_logs\\\" {\\n  targets = discovery.kubernetes.pods.targets\\n  rule {\\n    source_labels = [\\\"__meta_kubernetes_pod_node_name\\\"]\\n    target_label  = \\\"node\\\"\\n  }\\n  rule {\\n    source_labels = [\\\"__meta_kubernetes_namespace\\\"]\\n    target_label  = \\\"namespace\\\"\\n  }\\n  rule {\\n    source_labels = [\\\"__meta_kubernetes_pod_name\\\"]\\n    target_label  = \\\"pod\\\"\\n  }\\n  rule {\\n    source_labels = [\\\"__meta_kubernetes_pod_container_name\\\"]\\n    target_label  = \\\"container\\\"\\n  }\\n  rule {\\n    source_labels = [\\\"__meta_kubernetes_pod_label_app_kubernetes_io_name\\\"]\\n    target_label  = \\\"app\\\"\\n  }\\n}\\n\\nloki.source.kubernetes \\\"pods\\\" {\\n  targets    = discovery.relabel.pod_logs.output\\n  forward_to = [loki.write.default.receiver]\\n}\\n\\nloki.write \\\"default\\\" {\\n  endpoint {\\n    url = \\\"http://observability-loki.observability.svc.cluster.local:3100/loki/api/v1/push\\\"\\n  }\\n}\\n\\n// ── OTLP receiver (apps → Alloy) ─────────────────────────────────────\\notelcol.receiver.otlp \\\"default\\\" {\\n  http { endpoint = \\\"0.0.0.0:4318\\\" }\\n  grpc { endpoint = \\\"0.0.0.0:4317\\\" }\\n  output {\\n    metrics = [otelcol.exporter.prometheus.mimir.input]\\n    logs    = [otelcol.exporter.loki.default.input]\\n    traces  = [otelcol.exporter.otlp.tempo.input]\\n  }\\n}\\n\\n// ── OTLP metrics → Mimir ─────────────────────────────────────────────\\notelcol.exporter.prometheus \\\"mimir\\\" {\\n  forward_to = [prometheus.remote_write.mimir.receiver]\\n}\\n\\nprometheus.remote_write \\\"mimir\\\" {\\n  endpoint {\\n    url = \\\"http://observability-mimir-distributor.observability.svc.cluster.local:8080/api/v1/push\\\"\\n  }\\n}\\n\\n// ── OTLP logs → Loki ─────────────────────────────────────────────────\\notelcol.exporter.loki \\\"default\\\" {\\n  forward_to = [loki.write.default.receiver]\\n}\\n\\n// ── OTLP traces → Tempo ──────────────────────────────────────────────\\notelcol.exporter.otlp \\\"tempo\\\" {\\n  client {\\n    endpoint = \\\"observability-tempo.observability.svc.cluster.local:4317\\\"\\n    tls { insecure = true }\\n  }\\n}\\n\"},\"extraPorts\":[{\"name\":\"otlp-grpc\",\"port\":4317,\"protocol\":\"TCP\",\"targetPort\":4317},{\"name\":\"otlp-http\",\"port\":4318,\"protocol\":\"TCP\",\"targetPort\":4318}]},\"clustering\":{\"enabled\":false},\"rbac\":{\"create\":true},\"serviceAccount\":{\"create\":true}},\"grafana\":{\"adminPassword\":\"dev-grafana-admin-password\",\"assertNoLeakedSecrets\":false,\"datasources\":{\"datasources.yaml\":{\"apiVersion\":1,\"datasources\":[{\"isDefault\":true,\"jsonData\":{\"timeInterval\":\"15s\"},\"name\":\"Mimir\",\"type\":\"prometheus\",\"uid\":\"mimir\",\"url\":\"http://observability-mimir-query-frontend.observability.svc.cluster.local:8080/prometheus\"},{\"jsonData\":{\"timeInterval\":\"15s\"},\"name\":\"Prometheus\",\"type\":\"prometheus\",\"uid\":\"prometheus\",\"url\":\"http://observability-prometheus-server.observability.svc.cluster.local\"},{\"name\":\"Loki\",\"type\":\"loki\",\"uid\":\"loki\",\"url\":\"http://observability-loki.observability.svc.cluster.local:3100\"},{\"jsonData\":{\"serviceMap\":{\"datasourceUid\":\"mimir\"},\"tracesToLogsV2\":{\"datasourceUid\":\"loki\"}},\"name\":\"Tempo\",\"type\":\"tempo\",\"uid\":\"tempo\",\"url\":\"http://observability-tempo.observability.svc.cluster.local:3100\"}]}},\"grafana.ini\":{\"auth\":{\"disable_login_form\":\"false\",\"oauth_allow_insecure_email_lookup\":\"true\"},\"auth.generic_oauth\":{\"allow_sign_up\":\"true\",\"api_url\":\"http://authentik-server.authentik.svc.cluster.local/application/o/userinfo/\",\"auth_url\":\"https://authentik.tail60240b.ts.net/application/o/authorize/\",\"client_id\":\"dev-grafana-oidc-client-id\",\"client_secret\":\"dev-grafana-oidc-client-secret-not-for-prod-use\",\"enabled\":\"true\",\"name\":\"Authentik\",\"role_attribute_path\":\"email == 'edwardlimkoksiong1994@gmail.com' \\u0026\\u0026 'Admin' || 'Viewer'\",\"scopes\":\"openid profile email\",\"token_url\":\"http://authentik-server.authentik.svc.cluster.local/application/o/token/\"},\"server\":{\"root_url\":\"https://grafana.tail60240b.ts.net\"}},\"ingress\":{\"annotations\":{\"cert-manager.io/cluster-issuer\":\"homelab-ca-issuer\"},\"enabled\":true,\"hosts\":[\"grafana.local\"],\"ingressClassName\":\"traefik\",\"tls\":[{\"hosts\":[\"grafana.local\"],\"secretName\":\"grafana.local-tls\"}]},\"persistence\":{\"enabled\":true,\"size\":\"2Gi\"},\"resources\":{\"limits\":{\"memory\":\"256Mi\"},\"requests\":{\"cpu\":\"50m\",\"memory\":\"128Mi\"}},\"sidecar\":{\"dashboards\":{\"enabled\":true,\"folder\":\"/tmp/dashboards\",\"label\":\"grafana_dashboard\",\"provider\":{\"foldersFromFilesStructure\":false},\"searchNamespace\":\"observability\"}}},\"loki\":{\"backend\":{\"replicas\":0},\"chunksCache\":{\"enabled\":false},\"deploymentMode\":\"SingleBinary\",\"gateway\":{\"enabled\":false},\"loki\":{\"auth_enabled\":false,\"commonConfig\":{\"replication_factor\":1},\"schemaConfig\":{\"configs\":[{\"from\":\"2024-01-01\",\"index\":{\"period\":\"24h\",\"prefix\":\"index_\"},\"object_store\":\"filesystem\",\"schema\":\"v13\",\"store\":\"tsdb\"}]},\"storage\":{\"type\":\"filesystem\"}},\"lokiCanary\":{\"enabled\":false},\"read\":{\"replicas\":0},\"resultsCache\":{\"enabled\":false},\"singleBinary\":{\"persistence\":{\"enabled\":true,\"size\":\"10Gi\"},\"replicas\":1,\"resources\":{\"limits\":{\"memory\":\"512Mi\"},\"requests\":{\"cpu\":\"50m\",\"memory\":\"256Mi\"}}},\"test\":{\"enabled\":false},\"write\":{\"replicas\":0}},\"mimir-distributed\":{\"alertmanager\":{\"enabled\":false},\"compactor\":{\"persistentVolume\":{\"enabled\":true,\"size\":\"10Gi\"},\"replicas\":1,\"resources\":{\"limits\":{\"memory\":\"256Mi\"},\"requests\":{\"cpu\":\"50m\",\"memory\":\"128Mi\"}}},\"distributor\":{\"replicas\":1,\"resources\":{\"limits\":{\"memory\":\"256Mi\"},\"requests\":{\"cpu\":\"50m\",\"memory\":\"128Mi\"}}},\"ingester\":{\"persistentVolume\":{\"enabled\":true,\"size\":\"10Gi\"},\"replicas\":1,\"resources\":{\"limits\":{\"memory\":\"1536Mi\"},\"requests\":{\"cpu\":\"100m\",\"memory\":\"512Mi\"}},\"zoneAwareReplication\":{\"enabled\":false}},\"kafka\":{\"enabled\":false},\"mimir\":{\"structuredConfig\":{\"blocks_storage\":{\"backend\":\"filesystem\",\"filesystem\":{\"dir\":\"/data/blocks\"}},\"common\":{\"storage\":{\"backend\":\"filesystem\",\"filesystem\":{\"dir\":\"/data\"}}},\"compactor\":{\"data_dir\":\"/data/compactor\"},\"ingest_storage\":{\"enabled\":false},\"ingester\":{\"push_grpc_method_enabled\":true,\"ring\":{\"replication_factor\":1}},\"limits\":{\"max_global_series_per_user\":500000},\"multitenancy_enabled\":false,\"store_gateway\":{\"sharding_ring\":{\"replication_factor\":1}},\"usage_stats\":{\"enabled\":false}}},\"minio\":{\"enabled\":false},\"overrides_exporter\":{\"enabled\":false},\"querier\":{\"replicas\":1,\"resources\":{\"limits\":{\"memory\":\"256Mi\"},\"requests\":{\"cpu\":\"50m\",\"memory\":\"128Mi\"}}},\"query_frontend\":{\"replicas\":1,\"resources\":{\"limits\":{\"memory\":\"256Mi\"},\"requests\":{\"cpu\":\"50m\",\"memory\":\"128Mi\"}}},\"query_scheduler\":{\"replicas\":1,\"resources\":{\"limits\":{\"memory\":\"128Mi\"},\"requests\":{\"cpu\":\"50m\",\"memory\":\"64Mi\"}}},\"rollout_operator\":{\"enabled\":false},\"ruler\":{\"enabled\":false},\"store_gateway\":{\"persistentVolume\":{\"enabled\":true,\"size\":\"10Gi\"},\"replicas\":1,\"resources\":{\"limits\":{\"memory\":\"256Mi\"},\"requests\":{\"cpu\":\"50m\",\"memory\":\"128Mi\"}},\"zoneAwareReplication\":{\"enabled\":false}}},\"prometheus\":{\"alertmanager\":{\"enabled\":false},\"kube-state-metrics\":{\"enabled\":true},\"prometheus-node-exporter\":{\"enabled\":true},\"prometheus-pushgateway\":{\"enabled\":false},\"server\":{\"global\":{\"evaluation_interval\":\"15s\",\"external_labels\":{\"cluster_id\":\"internal\"},\"scrape_interval\":\"15s\"},\"persistentVolume\":{\"enabled\":true,\"size\":\"10Gi\"},\"remoteWrite\":[{\"url\":\"http://observability-mimir-distributor.observability.svc.cluster.local:8080/api/v1/push\"}],\"resources\":{\"limits\":{\"memory\":\"2Gi\"},\"requests\":{\"cpu\":\"50m\",\"memory\":\"512Mi\"}},\"retention\":\"3d\"}},\"tailnetDomain\":\"tail60240b.ts.net\",\"tempo\":{\"persistence\":{\"enabled\":true,\"size\":\"10Gi\"},\"resources\":{\"limits\":{\"memory\":\"512Mi\"},\"requests\":{\"cpu\":\"50m\",\"memory\":\"256Mi\"}},\"tempo\":{\"metricsGenerator\":{\"enabled\":true,\"processor\":{\"service_graphs\":{},\"span_metrics\":{\"enable_target_info\":true}},\"remoteWriteUrl\":\"http://observability-mimir-distributor.observability.svc.cluster.local:8080/api/v1/push\",\"storage\":{\"path\":\"/var/tempo/generator/wal\"},\"traces_storage\":{\"path\":\"/var/tempo/generator/traces\"}},\"overrides\":{\"defaults\":{\"metrics_generator\":{\"processors\":[\"service-graphs\",\"span-metrics\"]}}},\"receivers\":{\"otlp\":{\"protocols\":{\"grpc\":{\"endpoint\":\"0.0.0.0:4317\"},\"http\":{\"endpoint\":\"0.0.0.0:4318\"}}}},\"storage\":{\"trace\":{\"backend\":\"local\",\"local\":{\"path\":\"/var/tempo/traces\"},\"wal\":{\"path\":\"/var/tempo/wal\"}}}}},\"tsHost\":\"desktop-qv5aogf.tail60240b.ts.net\"}","version":"0.1.0"}],"name":"observability","namespace":"observability","pass_credentials":false,"postrender":[],"recreate_pods":false,"render_subchart_notes":true,"replace":false,"repository":null,"repository_ca_file":null,"repository_cert_file":null,"repository_key_file":null,"repository_password":null,"repository_username":null,"reset_values":false,"reuse_values":false,"set":[],"set_list":[],"set_sensitive":[],"skip_crds":false,"status":"deployed","timeout":900,"upgrade_install":null,"values":["# ponytail: terraform does a plain string-replace of desktop-qv5aogf.tail60240b.ts.net across\n# this file, so exposing it as a value lets templates/dashboards.yaml reuse the\n# substituted host without a second injection path.\ntsHost: \"desktop-qv5aogf.tail60240b.ts.net\"\n# ponytail: tailnet MagicDNS suffix — dashboards/*.json use https://\u003capp\u003e.tail60240b.ts.net\n# for their nav links now that each app has its own tailscale-operator host.\ntailnetDomain: \"tail60240b.ts.net\"\n\ngrafana:\n  # ponytail: chart refuses to render any sensitive key (client_secret,\n  # adminPassword, etc.) in plain values as a guard against accidental\n  # secret commits. Our placeholder-replacement approach substitutes these\n  # before helm ever renders — disable the guard so helm template succeeds.\n  assertNoLeakedSecrets: false\n\n  adminPassword: \"dev-grafana-admin-password\"\n\n  grafana.ini:\n    server:\n      root_url: \"https://grafana.tail60240b.ts.net\"\n    auth:\n      # ponytail: keep login form so local admin still works as fallback\n      disable_login_form: \"false\"\n      # ponytail: Grafana 11+ defaults this false and stops matching an OAuth\n      # login to an existing user by email — so when Authentik's `sub` changes\n      # (provider re-provisioned on a cluster rebuild), the old user row is\n      # orphaned and login dies with \"user.sync: unable to create user: user\n      # not found\". Authentik verifies the email, so matching on it is safe here.\n      oauth_allow_insecure_email_lookup: \"true\"\n    auth.generic_oauth:\n      enabled: \"true\"\n      name: \"Authentik\"\n      client_id: \"dev-grafana-oidc-client-id\"\n      client_secret: \"dev-grafana-oidc-client-secret-not-for-prod-use\"\n      scopes: \"openid profile email\"\n      auth_url: \"https://authentik.tail60240b.ts.net/application/o/authorize/\"\n      # ponytail: token/userinfo use in-cluster DNS — browser never touches\n      # these endpoints so no need for the Tailscale HTTPS port here.\n      token_url: \"http://authentik-server.authentik.svc.cluster.local/application/o/token/\"\n      api_url: \"http://authentik-server.authentik.svc.cluster.local/application/o/userinfo/\"\n      role_attribute_path: \"email == 'edwardlimkoksiong1994@gmail.com' \u0026\u0026 'Admin' || 'Viewer'\"\n      allow_sign_up: \"true\"\n\n  datasources:\n    datasources.yaml:\n      apiVersion: 1\n      datasources:\n        - name: Mimir\n          uid: mimir\n          type: prometheus\n          url: http://observability-mimir-query-frontend.observability.svc.cluster.local:8080/prometheus\n          isDefault: true\n          jsonData:\n            timeInterval: 15s\n        - name: Prometheus\n          uid: prometheus\n          type: prometheus\n          url: http://observability-prometheus-server.observability.svc.cluster.local\n          jsonData:\n            timeInterval: 15s\n        - name: Loki\n          uid: loki\n          type: loki\n          url: http://observability-loki.observability.svc.cluster.local:3100\n        - name: Tempo\n          uid: tempo\n          type: tempo\n          url: http://observability-tempo.observability.svc.cluster.local:3100\n          jsonData:\n            tracesToLogsV2:\n              datasourceUid: loki\n            serviceMap:\n              datasourceUid: mimir\n\n  ingress:\n    enabled: true\n    ingressClassName: traefik\n    annotations:\n      cert-manager.io/cluster-issuer: homelab-ca-issuer\n    hosts:\n      - grafana.local\n    tls:\n      - secretName: grafana.local-tls\n        hosts:\n          - grafana.local\n\n  persistence:\n    enabled: true\n    size: 2Gi\n\n  # ponytail: sidecar auto-loads any ConfigMap in this namespace labelled\n  # grafana_dashboard. templates/dashboards.yaml emits one per dashboards/*.json.\n  sidecar:\n    dashboards:\n      enabled: true\n      label: grafana_dashboard\n      searchNamespace: observability\n      folder: /tmp/dashboards\n      provider:\n        foldersFromFilesStructure: false\n\n  resources:\n    requests:\n      cpu: 50m\n      memory: 128Mi\n    limits:\n      memory: 256Mi\n\n# ── Loki ──────────────────────────────────────────────────────────────────────\nloki:\n  # ponytail: SingleBinary = one pod, no object storage, no kafka, no cache.\n  # SimpleScalable (chart default) needs 3 write + 3 read + 3 backend pods —\n  # far too heavy for a single-node homelab.\n  deploymentMode: SingleBinary\n\n  loki:\n    auth_enabled: false\n    commonConfig:\n      replication_factor: 1\n    storage:\n      type: filesystem\n    schemaConfig:\n      configs:\n        - from: \"2024-01-01\"\n          store: tsdb\n          object_store: filesystem\n          schema: v13\n          index:\n            prefix: index_\n            period: 24h\n\n  singleBinary:\n    replicas: 1\n    persistence:\n      enabled: true\n      size: 10Gi\n    resources:\n      requests:\n        cpu: 50m\n        memory: 256Mi\n      limits:\n        memory: 512Mi\n\n  # ponytail: zero out the scalable-mode components that SingleBinary doesn't use\n  read:\n    replicas: 0\n  write:\n    replicas: 0\n  backend:\n    replicas: 0\n\n  gateway:\n    enabled: false\n  lokiCanary:\n    enabled: false\n  test:\n    enabled: false\n  # ponytail: caches need memcached sub-charts — overkill for homelab\n  chunksCache:\n    enabled: false\n  resultsCache:\n    enabled: false\n\n# ── Tempo ─────────────────────────────────────────────────────────────────────\ntempo:\n  tempo:\n    # ponytail: metrics-generator turns spans into RED metrics (rate/errors/\n    # duration) and remote-writes them to Mimir — that's the latency + traffic\n    # panels. Needs traces flowing in via OTLP (already wired through Alloy).\n    metricsGenerator:\n      enabled: true\n      remoteWriteUrl: \"http://observability-mimir-distributor.observability.svc.cluster.local:8080/api/v1/push\"\n      processor:\n        span_metrics:\n          enable_target_info: true\n        service_graphs: {}\n      storage:\n        path: /var/tempo/generator/wal\n      traces_storage:\n        path: /var/tempo/generator/traces\n    overrides:\n      defaults:\n        metrics_generator:\n          processors:\n            - service-graphs\n            - span-metrics\n    storage:\n      trace:\n        backend: local\n        local:\n          path: /var/tempo/traces\n        wal:\n          path: /var/tempo/wal\n    receivers:\n      otlp:\n        protocols:\n          grpc:\n            endpoint: 0.0.0.0:4317\n          http:\n            endpoint: 0.0.0.0:4318\n\n  persistence:\n    enabled: true\n    size: 10Gi\n\n  resources:\n    requests:\n      cpu: 50m\n      memory: 256Mi\n    limits:\n      memory: 512Mi\n\n# ── Mimir ─────────────────────────────────────────────────────────────────────\nmimir-distributed:\n  # ponytail: chart defaults to ingest-storage architecture (Kafka between\n  # distributor and ingester) — one more stateful thing to babysit for no\n  # benefit on a single-node homelab. Classic push-based ingesters instead.\n  kafka:\n    enabled: false\n\n  mimir:\n    structuredConfig:\n      multitenancy_enabled: false\n      # ponytail: usage-stats reporter defaults to its own S3 bucket client\n      # regardless of common.storage.backend — fails hard with no S3 endpoint\n      # configured. No need for anonymous telemetry on a homelab anyway.\n      usage_stats:\n        enabled: false\n      common:\n        storage:\n          backend: filesystem\n          filesystem:\n            dir: /data\n      # ponytail: chart's base config hardcodes blocks_storage.backend: s3\n      # (for its bundled minio demo) — component-specific config always wins\n      # over `common`, so filesystem must be set here explicitly too.\n      blocks_storage:\n        backend: filesystem\n        # ponytail: must differ from tsdb.dir (chart default /data/tsdb) —\n        # filesystem.dir is the simulated \"bucket\", tsdb.dir is local WAL/head.\n        filesystem:\n          dir: /data/blocks\n      # ponytail: chart default compactor.data_dir is \"/data\", which is a\n      # parent of blocks_storage.filesystem.dir above — must be a sibling.\n      compactor:\n        data_dir: /data/compactor\n      ingest_storage:\n        enabled: false\n      # ponytail: Mimir defaults both rings' replication_factor to 3 (no\n      # override anywhere in the chart's own base config) - with 1 ingester\n      # and 1 store-gateway pod total, every read needs quorum from replicas\n      # that don't exist, failing instantly with \"too many unhealthy\n      # instances in the ring\" before any real network call. Single-node\n      # homelab, so 1 is correct everywhere reads/writes need quorum.\n      ingester:\n        push_grpc_method_enabled: true\n        ring:\n          replication_factor: 1\n      store_gateway:\n        sharding_ring:\n          replication_factor: 1\n      # ponytail: chart default max_global_series_per_user (150000) is a\n      # single-cluster-sized guess — 4 clusters' worth of node-exporter/\n      # cadvisor/kubecost/kube-state-metrics is pushing past it, rejecting\n      # writes (\"per-user series limit ... exceeded\"). Raise the ceiling;\n      # ingester's memory limit above is the real backstop against runaway\n      # cardinality, not this.\n      limits:\n        max_global_series_per_user: 500000\n\n  # ponytail: single replicas throughout — no HA, no zone awareness.\n  # The rollout_operator and zone-aware replication exist for production\n  # multi-zone clusters, not a one-node homelab.\n  rollout_operator:\n    enabled: false\n\n  ingester:\n    replicas: 1\n    zoneAwareReplication:\n      enabled: false\n    persistentVolume:\n      enabled: true\n      size: 10Gi\n    # ponytail: 512Mi was sized for internal alone; sit/uat/production's\n    # kubecost + node-exporter + cadvisor now all remote_write in too and\n    # OOMKilled it (exitCode 137) well before the series-limit override below\n    # even kicked in. Bump if it OOMs again as more gets onboarded.\n    resources:\n      requests:\n        cpu: 100m\n        memory: 512Mi\n      limits:\n        memory: 1536Mi\n\n  distributor:\n    replicas: 1\n    resources:\n      requests:\n        cpu: 50m\n        memory: 128Mi\n      limits:\n        memory: 256Mi\n\n  querier:\n    replicas: 1\n    resources:\n      requests:\n        cpu: 50m\n        memory: 128Mi\n      limits:\n        memory: 256Mi\n\n  query_frontend:\n    replicas: 1\n    resources:\n      requests:\n        cpu: 50m\n        memory: 128Mi\n      limits:\n        memory: 256Mi\n\n  compactor:\n    replicas: 1\n    persistentVolume:\n      enabled: true\n      size: 10Gi\n    resources:\n      requests:\n        cpu: 50m\n        memory: 128Mi\n      limits:\n        memory: 256Mi\n\n  store_gateway:\n    replicas: 1\n    zoneAwareReplication:\n      enabled: false\n    persistentVolume:\n      enabled: true\n      size: 10Gi\n    resources:\n      requests:\n        cpu: 50m\n        memory: 128Mi\n      limits:\n        memory: 256Mi\n\n  # ponytail: disable optional components not needed for basic metrics ingestion\n  alertmanager:\n    enabled: false\n  ruler:\n    enabled: false\n  overrides_exporter:\n    enabled: false\n\n  # ponytail: this chart's base mimir.config hardcodes frontend/frontend_worker\n  # scheduler_address at the query-scheduler regardless of any override, and\n  # this Mimir version's frontend_worker has no direct-poll-the-frontend mode\n  # to fall back to (worker.Config has no frontend_address field at all) — so\n  # disabling this and clearing scheduler_address (tried first) just leaves\n  # the querier endlessly failing DNS lookups and every query timing out.\n  # Scheduler has to stay on.\n  query_scheduler:\n    replicas: 1\n    resources:\n      requests:\n        cpu: 50m\n        memory: 64Mi\n      limits:\n        memory: 128Mi\n\n  # ponytail: mimir-distributed bundles its own minio subchart for demos;\n  # we use the already-deployed MinIO in the minio namespace instead.\n  minio:\n    enabled: false\n\n# ── Alloy ─────────────────────────────────────────────────────────────────────\nalloy:\n  alloy:\n    # ponytail: extraPorts needed so the Service exposes OTLP endpoints\n    # for apps to send traces/metrics/logs to. Without this, only Alloy's\n    # own UI port (12345) is in the Service spec.\n    extraPorts:\n      - name: otlp-grpc\n        port: 4317\n        targetPort: 4317\n        protocol: TCP\n      - name: otlp-http\n        port: 4318\n        targetPort: 4318\n        protocol: TCP\n\n    configMap:\n      content: |\n        // ── K8s pod logs → Loki ──────────────────────────────────────────────\n        discovery.kubernetes \"pods\" {\n          role = \"pod\"\n        }\n\n        discovery.relabel \"pod_logs\" {\n          targets = discovery.kubernetes.pods.targets\n          rule {\n            source_labels = [\"__meta_kubernetes_pod_node_name\"]\n            target_label  = \"node\"\n          }\n          rule {\n            source_labels = [\"__meta_kubernetes_namespace\"]\n            target_label  = \"namespace\"\n          }\n          rule {\n            source_labels = [\"__meta_kubernetes_pod_name\"]\n            target_label  = \"pod\"\n          }\n          rule {\n            source_labels = [\"__meta_kubernetes_pod_container_name\"]\n            target_label  = \"container\"\n          }\n          rule {\n            source_labels = [\"__meta_kubernetes_pod_label_app_kubernetes_io_name\"]\n            target_label  = \"app\"\n          }\n        }\n\n        loki.source.kubernetes \"pods\" {\n          targets    = discovery.relabel.pod_logs.output\n          forward_to = [loki.write.default.receiver]\n        }\n\n        loki.write \"default\" {\n          endpoint {\n            url = \"http://observability-loki.observability.svc.cluster.local:3100/loki/api/v1/push\"\n          }\n        }\n\n        // ── OTLP receiver (apps → Alloy) ─────────────────────────────────────\n        otelcol.receiver.otlp \"default\" {\n          http { endpoint = \"0.0.0.0:4318\" }\n          grpc { endpoint = \"0.0.0.0:4317\" }\n          output {\n            metrics = [otelcol.exporter.prometheus.mimir.input]\n            logs    = [otelcol.exporter.loki.default.input]\n            traces  = [otelcol.exporter.otlp.tempo.input]\n          }\n        }\n\n        // ── OTLP metrics → Mimir ─────────────────────────────────────────────\n        otelcol.exporter.prometheus \"mimir\" {\n          forward_to = [prometheus.remote_write.mimir.receiver]\n        }\n\n        prometheus.remote_write \"mimir\" {\n          endpoint {\n            url = \"http://observability-mimir-distributor.observability.svc.cluster.local:8080/api/v1/push\"\n          }\n        }\n\n        // ── OTLP logs → Loki ─────────────────────────────────────────────────\n        otelcol.exporter.loki \"default\" {\n          forward_to = [loki.write.default.receiver]\n        }\n\n        // ── OTLP traces → Tempo ──────────────────────────────────────────────\n        otelcol.exporter.otlp \"tempo\" {\n          client {\n            endpoint = \"observability-tempo.observability.svc.cluster.local:4317\"\n            tls { insecure = true }\n          }\n        }\n\n  clustering:\n    enabled: false\n\n  rbac:\n    create: true\n\n  serviceAccount:\n    create: true\n\n# ── Prometheus ────────────────────────────────────────────────────────────────\nprometheus:\n  server:\n    global:\n      scrape_interval: 15s\n      evaluation_interval: 15s\n      # matches the cluster_id external label sit/uat/production's own\n      # opencost-prometheus stamps on (terraform/modules/platform-apps/\n      # opencost.tf) — lets the opencost Grafana dashboard's cluster picker\n      # tell all 4 clusters' series apart, internal included.\n      external_labels:\n        cluster_id: internal\n    # ponytail: remote_write to Mimir so metrics survive beyond Prometheus's\n    # own retention window and are queryable from Grafana's Mimir datasource.\n    remoteWrite:\n      - url: \"http://observability-mimir-distributor.observability.svc.cluster.local:8080/api/v1/push\"\n    persistentVolume:\n      enabled: true\n      size: 10Gi\n    # ponytail: 3d not 7d — one node, cadvisor + kube-state + node-exporter +\n    # traefik is a lot of series; longer history lives in Mimir via remoteWrite.\n    retention: \"3d\"\n    resources:\n      requests:\n        cpu: 50m\n        # ponytail: 512Mi OOMKills mid-WAL-replay -\u003e 503 on every query -\u003e\n        # crashloop. WAL replay is the memory peak; 2Gi clears it. Drop back\n        # toward 1Gi if the node gets tight.\n        memory: 512Mi\n      limits:\n        memory: 2Gi\n\n  alertmanager:\n    enabled: false\n  prometheus-pushgateway:\n    enabled: false\n  kube-state-metrics:\n    enabled: true\n  prometheus-node-exporter:\n    enabled: true\n\n# dashboards-hash: 89e066a9e6b4e01ec64f2dcec6acb78eec9b99ce"],"verify":false,"version":"0.1.0","wait":false,"wait_for_jobs":false},"sensitive_attributes":[[{"type":"get_attr","value":"repository_password"}],[{"type":"get_attr","value":"values"},{"type":"index","value":{"value":0,"type":"number"}}]],"private":"eyJzY2hlbWFfdmVyc2lvbiI6IjEifQ==","dependencies":["kubernetes_namespace.observability"]}]},{"mode":"managed","type":"helm_release","name":"omp_agent","provider":"provider[\"registry.opentofu.org/hashicorp/helm\"]","instances":[{"schema_version":1,"attributes":{"atomic":false,"chart":"./../../helm/omp-agent","cleanup_on_fail":false,"create_namespace":false,"dependency_update":true,"description":null,"devel":null,"disable_crd_hooks":false,"disable_openapi_validation":false,"disable_webhooks":false,"force_update":false,"id":"omp-agent","keyring":null,"lint":false,"manifest":null,"max_history":0,"metadata":[{"app_version":"","chart":"omp-agent","first_deployed":1789102993,"last_deployed":1791373988,"name":"omp-agent","namespace":"sdlc","notes":"","revision":16,"values":"{\"backoffLimit\":1,\"chartHash\":\"f663c0c05fa8518a755952d9593bbb01fb98be43\",\"image\":{\"pullPolicy\":\"IfNotPresent\",\"repository\":\"k3d-registry:5111/omp-box\",\"tag\":\"dev\"},\"namespace\":\"sdlc\",\"secrets\":{\"claudeCodeToken\":\"(sensitive value)\",\"gitlabRepoUrl\":\"(sensitive value)\",\"gitlabToken\":\"(sensitive value)\",\"grafanaUrl\":\"https://grafana.tail60240b.ts.net\",\"kaneoToken\":\"(sensitive value)\",\"kaneoUrl\":\"http://kaneo.kaneo.svc.cluster.local:5173\",\"minioEndpoint\":\"http://minio.minio.svc.cluster.local:9000\",\"minioRootPassword\":\"(sensitive value)\",\"minioRootUser\":\"admin\",\"nextcloudPassword\":\"(sensitive value)\",\"nextcloudUrl\":\"http://nextcloud.nextcloud.svc.cluster.local:8080\",\"nextcloudUser\":\"admin\",\"sonarqubeMcpAuthToken\":\"(sensitive value)\"},\"ttlSecondsAfterFinished\":300}","version":"0.1.1"}],"name":"omp-agent","namespace":"sdlc","pass_credentials":false,"postrender":[],"recreate_pods":false,"render_subchart_notes":true,"replace":false,"repository":null,"repository_ca_file":null,"repository_cert_file":null,"repository_key_file":null,"repository_password":null,"repository_username":null,"reset_values":false,"reuse_values":false,"set":[{"name":"chartHash","type":"","value":"f663c0c05fa8518a755952d9593bbb01fb98be43"},{"name":"namespace","type":"","value":"sdlc"},{"name":"secrets.grafanaUrl","type":"","value":"https://grafana.tail60240b.ts.net"},{"name":"secrets.kaneoUrl","type":"","value":"http://kaneo.kaneo.svc.cluster.local:5173"},{"name":"secrets.minioEndpoint","type":"","value":"http://minio.minio.svc.cluster.local:9000"},{"name":"secrets.minioRootUser","type":"","value":"admin"},{"name":"secrets.nextcloudUrl","type":"","value":"http://nextcloud.nextcloud.svc.cluster.local:8080"},{"name":"secrets.nextcloudUser","type":"","value":"admin"}],"set_list":[],"set_sensitive":[{"name":"secrets.claudeCodeToken","type":"","value":"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"},{"name":"secrets.gitlabRepoUrl","type":"","value":""},{"name":"secrets.gitlabToken","type":"","value":"glpat-FJcl33yN1Z8J79hHsCWK-m86MQp1OjIH.01.0w0t1zpk8"},{"name":"secrets.kaneoToken","type":"","value":""},{"name":"secrets.minioRootPassword","type":"","value":"dev-minio-root-password"},{"name":"secrets.nextcloudPassword","type":"","value":"dev-nextcloud-admin-password"},{"name":"secrets.sonarqubeMcpAuthToken","type":"","value":"squ_16257b8b7b9189bd01b20a695e02c8e71e4969d4"}],"skip_crds":false,"status":"deployed","timeout":300,"upgrade_install":null,"values":["namespace: sdlc\n\nimage:\n  # ponytail: reuses the image built for helm/omp's (now-decommissioned) standing\n  # chat pod — it already bakes in omp + opencode + claude CLIs and every role's\n  # skill dir (helm/omp/Dockerfile). registry.homelab/omp:latest was never built\n  # anywhere (no Dockerfile in this chart, no build step in terraform/omp-agent.tf)\n  # — any Job using it would ImagePullBackOff.\n  repository: k3d-registry:5111/omp-box\n  tag: dev\n  pullPolicy: IfNotPresent\n\nttlSecondsAfterFinished: 300\nbackoffLimit: 1\n\n# Populated from .env / terraform at deploy time\nsecrets:\n  gitlabToken: \"\"\n  claudeCodeToken: \"\"\n  gitlabRepoUrl: \"\"\n  kaneoToken: \"\"\n  kaneoUrl: \"\"\n  grafanaUrl: \"\"\n  # per-caller bearer into the sonarqube MCP server — same token value as\n  # the server's own SONARQUBE_TOKEN (var.sonarqube_mcp_token), SonarQube's\n  # HTTP-mode MCP reads auth from the caller's own header, not a separate\n  # per-client secret.\n  sonarqubeMcpAuthToken: \"\"\n  nextcloudUrl: \"\"\n  nextcloudUser: \"\"\n  nextcloudPassword: \"\"\n  minioEndpoint: \"\"\n  minioRootUser: \"\"\n  minioRootPassword: \"\"\n"],"verify":false,"version":"0.1.1","wait":true,"wait_for_jobs":false},"sensitive_attributes":[[{"type":"get_attr","value":"repository_password"}],[{"type":"get_attr","value":"set_sensitive"}]],"private":"eyJzY2hlbWFfdmVyc2lvbiI6IjEifQ==","dependencies":["kubernetes_namespace.sdlc","null_resource.kaneo_mcp_image","null_resource.omp_agent_image"]}]},{"mode":"managed","type":"helm_release","name":"opencost","provider":"provider[\"registry.opentofu.org/hashicorp/helm\"]","instances":[{"schema_version":1,"attributes":{"atomic":false,"chart":"./../../helm/opencost","cleanup_on_fail":false,"create_namespace":false,"dependency_update":true,"description":null,"devel":null,"disable_crd_hooks":false,"disable_openapi_validation":false,"disable_webhooks":false,"force_update":false,"id":"opencost","keyring":null,"lint":false,"manifest":null,"max_history":0,"metadata":[{"app_version":"","chart":"opencost","first_deployed":1790480785,"last_deployed":1790480785,"name":"opencost","namespace":"opencost","notes":"Thank you for installing the OpenCost Helm Chart!\n\nYour release is named: opencost\n\nTo verify that OpenCost is running, execute the following commands:\n\n1. Check the status of the pods:\n   kubectl get pods -l app.kubernetes.io/instance=opencost -n opencost\n\n2. Access the OpenCost UI:\n\n   If the service is only accessible within the cluster, you can use port-forwarding:\n   export SVC_NAME=opencost\n   kubectl port-forward svc/$SVC_NAME 9090 -n opencost\n\n   Alternatively, you can port-forward directly to the OpenCost pod:\n   export POD_NAME=$(kubectl get pod -l app.kubernetes.io/instance=opencost -n opencost -o jsonpath=\"{.items[0].metadata.name}\")\n   kubectl -n opencost port-forward $POD_NAME 9090\n\nFor more information, visit the OpenCost documentation:\nhttps://www.opencost.io/docs/","revision":1,"values":"{\"oc\":{\"fullnameOverride\":\"opencost\",\"opencost\":{\"prometheus\":{\"external\":{\"enabled\":true,\"url\":\"http://observability-mimir-query-frontend.observability.svc.cluster.local:8080/prometheus\"},\"internal\":{\"enabled\":false}},\"ui\":{\"enabled\":false}},\"podAnnotations\":{\"prometheus.io/path\":\"/metrics\",\"prometheus.io/port\":\"9003\",\"prometheus.io/scrape\":\"true\"}},\"prometheus\":{\"alertmanager\":{\"enabled\":false},\"enabled\":false,\"kube-state-metrics\":{\"enabled\":true},\"prometheus-node-exporter\":{\"enabled\":true},\"prometheus-pushgateway\":{\"enabled\":false},\"server\":{\"global\":{\"evaluation_interval\":\"15s\",\"scrape_interval\":\"15s\"},\"persistentVolume\":{\"enabled\":true,\"size\":\"2Gi\"},\"resources\":{\"limits\":{\"memory\":\"1536Mi\"},\"requests\":{\"cpu\":\"50m\",\"memory\":\"512Mi\"}},\"retention\":\"3d\"}}}","version":"0.1.0"}],"name":"opencost","namespace":"opencost","pass_credentials":false,"postrender":[],"recreate_pods":false,"render_subchart_notes":true,"replace":false,"repository":null,"repository_ca_file":null,"repository_cert_file":null,"repository_key_file":null,"repository_password":null,"repository_username":null,"reset_values":false,"reuse_values":false,"set":[{"name":"oc.opencost.prometheus.external.url","type":"","value":"http://observability-mimir-query-frontend.observability.svc.cluster.local:8080/prometheus"}],"set_list":[],"set_sensitive":[],"skip_crds":false,"status":"deployed","timeout":600,"upgrade_install":null,"values":["# ponytail: shared across all 4 clusters. oc.opencost.prometheus.external.url\n# and the prometheus.* block differ per cluster (internal -\u003e observability's\n# Mimir, prometheus.enabled stays false; sit/uat/production -\u003e the bundled\n# prometheus dependency below, prometheus.enabled=true) - set via terraform\n# `set{}` in each cluster's opencost.tf, not in this file. No bundled UI -\n# cost data surfaces through the Grafana dashboard\n# (helm/observability/dashboards/opencost.json) instead, so there's nothing\n# here needing tailscale/authentik exposure the way kubecost's native UI did.\n#\n# ponytail: the \"oc\" alias (Chart.yaml) + the double \"opencost.opencost.*\"\n# nesting below aren't decorative — the upstream chart's own values.yaml\n# nests almost everything under an internal \"opencost:\" key, and our\n# dependency is *also* named \"opencost\", so without the alias every path here\n# would collide and silently not apply (verified: --set opencost.ui.enabled\n# through an unaliased dependency is a no-op; --set oc.opencost.ui.enabled\n# through the alias is not).\noc:\n  # deterministic service/deployment name regardless of the alias/release-name\n  # substring quirk above (fullname helper would otherwise emit \"opencost-oc\").\n  fullnameOverride: opencost\n\n  # scraped by whichever Prometheus opencost.prometheus.external.url points\n  # back at (community `prometheus` chart's default scrape config picks up\n  # any pod carrying these annotations). Root-level in the subchart's own\n  # values schema, not nested under the inner opencost: block.\n  podAnnotations:\n    prometheus.io/scrape: \"true\"\n    prometheus.io/port: \"9003\"\n    prometheus.io/path: \"/metrics\"\n\n  opencost:\n    prometheus:\n      internal:\n        enabled: false\n      external:\n        enabled: true\n        # placeholder - every cluster's opencost.tf overrides this with the\n        # real endpoint.\n        url: \"http://REPLACED-BY-TERRAFORM\"\n\n    ui:\n      enabled: false\n\n# bundled Prometheus for sit/uat/production only (see Chart.yaml condition) -\n# internal reuses helm/observability's existing one instead.\nprometheus:\n  enabled: false\n  server:\n    global:\n      scrape_interval: 15s\n      evaluation_interval: 15s\n    persistentVolume:\n      enabled: true\n      size: 2Gi\n    # ponytail: short - this cluster's own cost history isn't queried far\n    # back; longer retention lives in internal's Mimir via remoteWrite.\n    retention: \"3d\"\n    resources:\n      requests:\n        cpu: 50m\n        memory: 512Mi\n      limits:\n        memory: 1536Mi\n  alertmanager:\n    enabled: false\n  prometheus-pushgateway:\n    enabled: false\n  kube-state-metrics:\n    enabled: true\n  prometheus-node-exporter:\n    enabled: true\n"],"verify":false,"version":"0.1.0","wait":true,"wait_for_jobs":false},"sensitive_attributes":[[{"type":"get_attr","value":"repository_password"}]],"private":"eyJzY2hlbWFfdmVyc2lvbiI6IjEifQ==","dependencies":["helm_release.observability","kubernetes_namespace.observability","kubernetes_namespace.opencost"]}]},{"mode":"managed","type":"helm_release","name":"openwebui","provider":"provider[\"registry.opentofu.org/hashicorp/helm\"]","instances":[{"schema_version":1,"attributes":{"atomic":false,"chart":"./../../helm/openwebui","cleanup_on_fail":false,"create_namespace":false,"dependency_update":true,"description":null,"devel":null,"disable_crd_hooks":false,"disable_openapi_validation":false,"disable_webhooks":false,"force_update":false,"id":"openwebui","keyring":null,"lint":false,"manifest":null,"max_history":0,"metadata":[{"app_version":"","chart":"openwebui","first_deployed":1789110536,"last_deployed":1790069334,"name":"openwebui","namespace":"openwebui","notes":"","revision":5,"values":"{\"env\":{\"ENABLE_API_KEYS\":\"True\",\"ENABLE_LOGIN_FORM\":\"False\",\"ENABLE_OAUTH_ROLE_MANAGEMENT\":\"true\",\"ENABLE_OAUTH_SIGNUP\":\"true\",\"ENABLE_OLLAMA_API\":\"False\",\"ENABLE_PERSISTENT_CONFIG\":\"False\",\"OAUTH_ADMIN_ROLES\":\"admin\",\"OAUTH_CLIENT_ID\":\"dev-openwebui-oidc-client-id\",\"OAUTH_CLIENT_SECRET\":\"dev-openwebui-oidc-client-secret-not-for-prod-use\",\"OAUTH_PROVIDER_NAME\":\"Authentik\",\"OAUTH_ROLES_CLAIM\":\"roles\",\"OAUTH_SCOPES\":\"openid profile email openwebui_roles\",\"OLLAMA_BASE_URL\":\"\",\"OPENAI_API_BASE_URL\":\"http://litellm.litellm.svc.cluster.local:4000\",\"OPENAI_API_KEY\":\"sk-dev-litellm-master-key-not-for-prod-use\",\"OPENID_PROVIDER_URL\":\"https://authentik.tail60240b.ts.net/application/o/openwebui/.well-known/openid-configuration\",\"RESET_CONFIG_ON_START\":\"True\",\"SSL_CERT_FILE\":\"/certs/ca.crt\",\"WEBUI_URL\":\"https://openwebui.tail60240b.ts.net\"},\"image\":{\"repository\":\"ghcr.io/open-webui/open-webui\",\"tag\":\"main\"},\"resources\":{\"limits\":{\"memory\":\"2Gi\"},\"requests\":{\"cpu\":\"100m\",\"memory\":\"512Mi\"}},\"storageSize\":\"5Gi\"}","version":"0.1.1"}],"name":"openwebui","namespace":"openwebui","pass_credentials":false,"postrender":[],"recreate_pods":false,"render_subchart_notes":true,"replace":false,"repository":null,"repository_ca_file":null,"repository_cert_file":null,"repository_key_file":null,"repository_password":null,"repository_username":null,"reset_values":false,"reuse_values":false,"set":[],"set_list":[],"set_sensitive":[],"skip_crds":false,"status":"deployed","timeout":1200,"upgrade_install":null,"values":["image:\n  repository: ghcr.io/open-webui/open-webui\n  tag: main\n\nstorageSize: 5Gi\n\nenv:\n  # ponytail: everything goes through LiteLLM (OpenAI-compatible) — chat models,\n  # the omp agents, and the host Ollama. Direct Ollama is off so there's\n  # one gateway to auth and log.\n  OPENAI_API_BASE_URL: \"http://litellm.litellm.svc.cluster.local:4000\"\n  # ponytail: LiteLLM master key — fine here, single-user trusted cluster.\n  # Swap for a virtual key (LiteLLM UI -\u003e Keys) if this ever gets more users.\n  OPENAI_API_KEY: \"sk-dev-litellm-master-key-not-for-prod-use\"\n  OLLAMA_BASE_URL: \"\"\n  ENABLE_OLLAMA_API: \"False\"\n\n  # OIDC / Authentik\n  ENABLE_OAUTH_SIGNUP: \"true\"\n  OAUTH_PROVIDER_NAME: \"Authentik\"\n  OPENID_PROVIDER_URL: \"https://authentik.tail60240b.ts.net/application/o/openwebui/.well-known/openid-configuration\"\n  OAUTH_CLIENT_ID: \"dev-openwebui-oidc-client-id\"\n  OAUTH_CLIENT_SECRET: \"dev-openwebui-oidc-client-secret-not-for-prod-use\"\n  OAUTH_SCOPES: \"openid profile email openwebui_roles\"\n  ENABLE_OAUTH_ROLE_MANAGEMENT: \"true\"\n  OAUTH_ROLES_CLAIM: \"roles\"\n  OAUTH_ADMIN_ROLES: \"admin\"\n  WEBUI_URL: \"https://openwebui.tail60240b.ts.net\"\n\n  # ponytail: ENABLE_LOGIN_FORM=False — SSO only. First SSO login by admin\n  # gets Admin role via openwebui_roles claim from Authentik.\n  ENABLE_LOGIN_FORM: \"False\"\n  ENABLE_PERSISTENT_CONFIG: \"False\"\n  RESET_CONFIG_ON_START: \"True\"\n  # ponytail: RESET_CONFIG_ON_START wipes any DB-stored config (incl. the\n  # Admin Settings \"Enable API Key\" toggle) back to OpenWebUI's own default\n  # (off) on every pod restart — silently breaking the admin-API-key auth\n  # that ansible/playbooks/openwebui.yml (and any Function install) depends\n  # on. Pin it here so the reset lands on \"on\" instead.\n  ENABLE_API_KEYS: \"True\"\n\n  # ponytail: server-side OIDC calls go to Tailscale HTTPS; SSL_CERT_FILE\n  # trusts the homelab self-signed CA mounted from the homelab-ca Secret.\n  SSL_CERT_FILE: \"/certs/ca.crt\"\n\nresources:\n  requests:\n    cpu: 100m\n    memory: 512Mi\n  limits:\n    memory: 2Gi\n"],"verify":false,"version":"0.1.1","wait":true,"wait_for_jobs":false},"sensitive_attributes":[[{"type":"get_attr","value":"repository_password"}],[{"type":"get_attr","value":"values"},{"type":"index","value":{"value":0,"type":"number"}}]],"private":"eyJzY2hlbWFfdmVyc2lvbiI6IjEifQ==","dependencies":["data.kubernetes_secret.homelab_ca_openwebui","helm_release.cert_manager","kubectl_manifest.homelab_ca","kubectl_manifest.selfsigned_bootstrap","kubernetes_namespace.cert_manager","kubernetes_namespace.openwebui","kubernetes_secret.openwebui_homelab_ca","null_resource.homelab_ca_ready"]}]},{"mode":"managed","type":"helm_release","name":"postgres","provider":"provider[\"registry.opentofu.org/hashicorp/helm\"]","instances":[{"schema_version":1,"attributes":{"atomic":false,"chart":"./../../helm/postgres","cleanup_on_fail":false,"create_namespace":false,"dependency_update":true,"description":null,"devel":null,"disable_crd_hooks":false,"disable_openapi_validation":false,"disable_webhooks":false,"force_update":false,"id":"postgres","keyring":null,"lint":false,"manifest":null,"max_history":0,"metadata":[{"app_version":"","chart":"postgres","first_deployed":1789017132,"last_deployed":1790737645,"name":"postgres","namespace":"postgres","notes":"","revision":7,"values":"{\"backup\":{\"minioRootPassword\":\"(sensitive value)\"},\"password\":\"(sensitive value)\"}","version":"0.1.0"}],"name":"postgres","namespace":"postgres","pass_credentials":false,"postrender":[],"recreate_pods":false,"render_subchart_notes":true,"replace":false,"repository":null,"repository_ca_file":null,"repository_cert_file":null,"repository_key_file":null,"repository_password":null,"repository_username":null,"reset_values":false,"reuse_values":false,"set":[],"set_list":[],"set_sensitive":[{"name":"backup.minioRootPassword","type":"","value":"dev-minio-root-password"},{"name":"password","type":"","value":"dev-shared-db-password-not-for-prod-use"}],"skip_crds":false,"status":"deployed","timeout":600,"upgrade_install":null,"values":null,"verify":false,"version":"0.1.0","wait":true,"wait_for_jobs":false},"sensitive_attributes":[[{"type":"get_attr","value":"repository_password"}],[{"type":"get_attr","value":"set_sensitive"}]],"private":"eyJzY2hlbWFfdmVyc2lvbiI6IjEifQ==","dependencies":["kubernetes_namespace.postgres"]}]},{"mode":"managed","type":"helm_release","name":"redis","provider":"provider[\"registry.opentofu.org/hashicorp/helm\"]","instances":[{"schema_version":1,"attributes":{"atomic":false,"chart":"./../../helm/redis","cleanup_on_fail":false,"create_namespace":false,"dependency_update":true,"description":null,"devel":null,"disable_crd_hooks":false,"disable_openapi_validation":false,"disable_webhooks":false,"force_update":false,"id":"redis","keyring":null,"lint":false,"manifest":null,"max_history":0,"metadata":[{"app_version":"","chart":"redis","first_deployed":1789017132,"last_deployed":1790069321,"name":"redis","namespace":"redis","notes":"","revision":2,"values":"{}","version":"0.1.0"}],"name":"redis","namespace":"redis","pass_credentials":false,"postrender":[],"recreate_pods":false,"render_subchart_notes":true,"replace":false,"repository":null,"repository_ca_file":null,"repository_cert_file":null,"repository_key_file":null,"repository_password":null,"repository_username":null,"reset_values":false,"reuse_values":false,"set":[],"set_list":[],"set_sensitive":[],"skip_crds":false,"status":"deployed","timeout":300,"upgrade_install":null,"values":null,"verify":false,"version":"0.1.0","wait":true,"wait_for_jobs":false},"sensitive_attributes":[[{"type":"get_attr","value":"repository_password"}]],"private":"eyJzY2hlbWFfdmVyc2lvbiI6IjEifQ==","dependencies":["kubernetes_namespace.redis"]}]},{"mode":"managed","type":"helm_release","name":"sonarqube","provider":"provider[\"registry.opentofu.org/hashicorp/helm\"]","instances":[{"schema_version":1,"attributes":{"atomic":false,"chart":"./../../helm/sonarqube","cleanup_on_fail":false,"create_namespace":false,"dependency_update":true,"description":null,"devel":null,"disable_crd_hooks":false,"disable_openapi_validation":false,"disable_webhooks":false,"force_update":false,"id":"sonarqube","keyring":null,"lint":false,"manifest":null,"max_history":0,"metadata":[{"app_version":"","chart":"sonarqube","first_deployed":1789017394,"last_deployed":1790595020,"name":"sonarqube","namespace":"sonarqube","notes":"1. Get the application URL by running these commands:\n  http://sonarqube.local\nWARNING: \n         Please note that the SonarQube image runs with a non-root user (uid=1000) belonging to the root group (guid=0). In this way, the chart can support arbitrary user ids as recommended in OpenShift.\n         Please visit https://docs.openshift.com/container-platform/4.14/openshift_images/create-images.html#use-uid_create-images for more information.\n\n\nWARNING: Setting the deployment strategy type is deprecated and will be removed in a future release. It will be hard-coded to Recreate.\n\nWARNING: The deploymentType value is deprecated and won't be supported anymore. SonarQube will be deployed as a Deployment by default.\n","revision":6,"values":"{\"sonarqube\":{\"caCerts\":{\"enabled\":true,\"secret\":\"sonarqube-homelab-ca\"},\"community\":{\"enabled\":true},\"ingress\":{\"annotations\":{\"cert-manager.io/cluster-issuer\":\"homelab-ca-issuer\"},\"enabled\":true,\"hosts\":[{\"name\":\"sonarqube.local\"}],\"ingressClassName\":\"traefik\",\"tls\":[{\"hosts\":[\"sonarqube.local\"],\"secretName\":\"sonarqube.local-tls\"}]},\"initSysctl\":{\"enabled\":false},\"jdbcOverwrite\":{\"enabled\":true,\"jdbcPassword\":\"(sensitive value)\",\"jdbcUrl\":\"jdbc:postgresql://postgres.postgres.svc.cluster.local:5432/sonarqube\",\"jdbcUsername\":\"sonarqube\"},\"livenessProbe\":{\"timeoutSeconds\":10},\"monitoringPasscode\":\"(sensitive value)\",\"persistence\":{\"enabled\":true,\"size\":\"5Gi\"},\"plugins\":{\"install\":[\"https://github.com/sonar-auth-oidc/sonar-auth-oidc/releases/download/v3.0.0/sonar-auth-oidc-plugin-3.0.0.jar\"]},\"postgresql\":{\"enabled\":false},\"readinessProbe\":{\"timeoutSeconds\":10},\"resources\":{\"limits\":{\"memory\":\"3072M\"},\"requests\":{\"cpu\":\"200m\",\"memory\":\"1536M\"}},\"sonarProperties\":{\"sonar.auth.oidc.enabled\":\"true\",\"sonar.auth.oidc.groupsSync\":\"true\",\"sonar.auth.oidc.issuerUri\":\"https://authentik.tail60240b.ts.net/application/o/sonarqube/\",\"sonar.auth.oidc.loginButtonText\":\"Log in with Authentik\",\"sonar.auth.oidc.scopes\":\"openid email profile groups\",\"sonar.core.serverBaseURL\":\"https://sonarqube.tail60240b.ts.net\"},\"sonarSecretProperties\":\"sonarqube-oidc-secret\",\"startupProbe\":{\"timeoutSeconds\":10}}}","version":"0.1.0"}],"name":"sonarqube","namespace":"sonarqube","pass_credentials":false,"postrender":[],"recreate_pods":false,"render_subchart_notes":true,"replace":false,"repository":null,"repository_ca_file":null,"repository_cert_file":null,"repository_key_file":null,"repository_password":null,"repository_username":null,"reset_values":false,"reuse_values":false,"set":[],"set_list":[],"set_sensitive":[{"name":"sonarqube.jdbcOverwrite.jdbcPassword","type":"","value":"dev-shared-db-password-not-for-prod-use"},{"name":"sonarqube.monitoringPasscode","type":"","value":"dev-sonarqube-monitoring-passcode"}],"skip_crds":false,"status":"deployed","timeout":900,"upgrade_install":null,"values":["sonarqube:\n  community:\n    enabled: true\n\n  # ponytail: vm.max_map_count for the bundled Elasticsearch needs raising\n  # host-side once (`sudo sysctl -w vm.max_map_count=262144` on the k3d\n  # node/host, persist in /etc/sysctl.d/ if you want it to survive reboots).\n  # Chart's own initSysctl needs a privileged initContainer; skipping that\n  # in favor of the one-time host command.\n  initSysctl:\n    enabled: false\n\n  # monitoringPasscode set via terraform (.env)\n\n  # ponytail: chart's 1s probe timeout is too tight on this RPi under load\n  # (JVM GC pauses, concurrent image pulls) — caused a liveness-kill restart\n  # loop even though the server was actually up. Same fix as seafile's mariadb.\n  readinessProbe:\n    timeoutSeconds: 10\n  livenessProbe:\n    timeoutSeconds: 10\n  startupProbe:\n    timeoutSeconds: 10\n\n  resources:\n    requests:\n      cpu: 200m\n      memory: 1536M\n    limits:\n      memory: 3072M\n\n  persistence:\n    enabled: true\n    size: 5Gi\n\n  # ponytail: SonarQube Community has no native SSO — this OSS plugin\n  # (sonar-auth-oidc, MIT-ish/Apache) bolts on generic OpenID Connect via\n  # the marketplace-jar mechanism, same \"no license, no fork\" pattern as\n  # n8n's cweagans/n8n-oidc. Its own settings (sonar.auth.oidc.*) are\n  # regular SonarQube global settings, so they load from sonarProperties\n  # below — no manual admin-UI step needed after first boot.\n  plugins:\n    install:\n      - \"https://github.com/sonar-auth-oidc/sonar-auth-oidc/releases/download/v3.0.0/sonar-auth-oidc-plugin-3.0.0.jar\"\n\n  # ponytail: fixed dev client_id/secret matching the Authentik OAuth2\n  # provider created via the API (same one-time-setup pattern as the other\n  # apps). Server base URL uses the tailscale hostname so the browser\n  # redirect and the plugin's own redirect URI agree on the same authority.\n  sonarProperties:\n    sonar.core.serverBaseURL: \"https://sonarqube.tail60240b.ts.net\"\n    sonar.auth.oidc.enabled: \"true\"\n    sonar.auth.oidc.issuerUri: \"https://authentik.tail60240b.ts.net/application/o/sonarqube/\"\n    # sonar.auth.oidc.clientId.secured set via terraform (.env)\n    sonar.auth.oidc.loginButtonText: \"Log in with Authentik\"\n    # ponytail: Authentik's \"groups\" scope claim (provision-app-providers.py)\n    # returns [\"sonar-administrators\"] for admin_email, [\"sonar-users\"] for\n    # everyone else — plugin syncs the user into the matching built-in\n    # SonarQube group on every login, no manual add_user step needed.\n    sonar.auth.oidc.groupsSync: \"true\"\n    # ponytail: plugin only requests \"openid email profile\" by default —\n    # groupsSync above is a no-op unless \"groups\" is also in the requested\n    # scope list.\n    sonar.auth.oidc.scopes: \"openid email profile groups\"\n\n  # ponytail: OIDC discovery/token calls happen server-side from this pod\n  # against authentik.\u003ctailnet\u003e — coredns.tf rewrites that name to traefik\n  # in-cluster, which serves it with a homelab-CA cert the JVM doesn't trust\n  # by default (PKIX path building failed). Chart's caCerts mechanism adds it\n  # to cacerts via SONARQUBE_WEB_JVM_OPTS/SONAR_CE_JAVAOPTS automatically.\n  caCerts:\n    enabled: true\n    secret: sonarqube-homelab-ca\n\n  # ponytail: sonarSecretProperties is a *reference* to an existing Secret\n  # (key \"secret.properties\"), not inline content — the chart concatenates\n  # it after sonarProperties above, so it can override the same keys.\n  # Secret itself is created by terraform/internal/sonarqube.tf.\n  sonarSecretProperties: sonarqube-oidc-secret\n\n  # ponytail: shared postgres (helm/postgres), database + role `sonarqube`.\n  postgresql:\n    enabled: false\n  jdbcOverwrite:\n    enabled: true\n    jdbcUrl: \"jdbc:postgresql://postgres.postgres.svc.cluster.local:5432/sonarqube\"\n    jdbcUsername: \"sonarqube\"\n\n  ingress:\n    enabled: true\n    ingressClassName: traefik\n    annotations:\n      cert-manager.io/cluster-issuer: homelab-ca-issuer\n    hosts:\n      - name: sonarqube.local\n    tls:\n      - secretName: sonarqube.local-tls\n        hosts:\n          - sonarqube.local\n\n"],"verify":false,"version":"0.1.0","wait":true,"wait_for_jobs":false},"sensitive_attributes":[[{"type":"get_attr","value":"repository_password"}],[{"type":"get_attr","value":"set_sensitive"}]],"private":"eyJzY2hlbWFfdmVyc2lvbiI6IjEifQ==","dependencies":["data.kubernetes_secret.homelab_ca_sonarqube","helm_release.cert_manager","helm_release.postgres","kubectl_manifest.homelab_ca","kubectl_manifest.selfsigned_bootstrap","kubernetes_namespace.cert_manager","kubernetes_namespace.postgres","kubernetes_namespace.sonarqube","kubernetes_secret.sonarqube_homelab_ca","kubernetes_secret.sonarqube_oidc","null_resource.homelab_ca_ready"]}]},{"mode":"managed","type":"helm_release","name":"tailscale_operator","provider":"provider[\"registry.opentofu.org/hashicorp/helm\"]","instances":[{"schema_version":1,"attributes":{"atomic":false,"chart":"./../../helm/tailscale-operator","cleanup_on_fail":false,"create_namespace":false,"dependency_update":true,"description":null,"devel":null,"disable_crd_hooks":false,"disable_openapi_validation":false,"disable_webhooks":false,"force_update":false,"id":"tailscale-operator","keyring":null,"lint":false,"manifest":null,"max_history":0,"metadata":[{"app_version":"","chart":"tailscale-operator","first_deployed":1789038133,"last_deployed":1790595020,"name":"tailscale-operator","namespace":"tailscale","notes":"You have successfully installed the Tailscale Kubernetes Operator!\n\nOnce connected, the operator should appear as a device within the Tailscale admin console:\nhttps://login.tailscale.com/admin/machines\n\nIf you have not used the Tailscale operator before, here are some examples to try out:\n\n* Private Kubernetes API access and authorization using the API server proxy\n  https://tailscale.com/kb/1437/kubernetes-operator-api-server-proxy\n\n* Private access to cluster Services using an ingress proxy\n  https://tailscale.com/kb/1439/kubernetes-operator-cluster-ingress\n\n* Private access to the cluster's available subnets using a subnet router\n  https://tailscale.com/kb/1441/kubernetes-operator-connector\n\nYou can also explore the CRDs, operator, and associated resources within the tailscale namespace:\n\n$ kubectl explain connector\n$ kubectl explain proxygroup\n$ kubectl explain proxyclass\n$ kubectl explain recorder\n$ kubectl explain dnsconfig\n\nIf you're interested to explore what resources were created:\n\n$ kubectl --namespace=tailscale get all -l app.kubernetes.io/managed-by=Helm\n","revision":3,"values":"{\"tailscale-operator\":{\"oauth\":{\"clientId\":\"(sensitive value)\",\"clientSecret\":\"(sensitive value)\"},\"operatorConfig\":{\"hostname\":\"homelab-operator\"}}}","version":"0.1.0"}],"name":"tailscale-operator","namespace":"tailscale","pass_credentials":false,"postrender":[],"recreate_pods":false,"render_subchart_notes":true,"replace":false,"repository":null,"repository_ca_file":null,"repository_cert_file":null,"repository_key_file":null,"repository_password":null,"repository_username":null,"reset_values":false,"reuse_values":false,"set":[],"set_list":[],"set_sensitive":[{"name":"tailscale-operator.oauth.clientId","type":"","value":"kSpeNLBD9C21CNTRL"},{"name":"tailscale-operator.oauth.clientSecret","type":"","value":"tskey-client-kSpeNLBD9C21CNTRL-AmY8DCzVCSdLnYZVDhRMSdNfu3as2RV3"}],"skip_crds":false,"status":"deployed","timeout":600,"upgrade_install":null,"values":["tailscale-operator:\n  # ponytail: oauth.clientId / oauth.clientSecret come from terraform\n  # (.env: TF_VAR_tailscale_oauth_client_id / _secret). Create the OAuth client\n  # once in the Tailscale admin console (Settings -\u003e OAuth clients) with write\n  # scope on Devices/Core and Keys/Auth Keys, and set tag:k8s-operator as a\n  # tagOwner of tag:k8s in the tailnet ACL. See helm/tailscale-operator/README\n  # note in terraform/tailscale.tf.\n  oauth:\n    clientId: \"\"\n    clientSecret: \"\"\n\n  # ponytail: chart default already creates the `tailscale` IngressClass and\n  # installs CRDs — nothing else to configure for L7 Ingress exposure. Each\n  # app opts in with `ingressClassName: tailscale` + `tls.hosts: [\u003cname\u003e]`.\n  operatorConfig:\n    hostname: \"homelab-operator\"\n"],"verify":false,"version":"0.1.0","wait":true,"wait_for_jobs":false},"sensitive_attributes":[[{"type":"get_attr","value":"repository_password"}],[{"type":"get_attr","value":"set_sensitive"}]],"private":"eyJzY2hlbWFfdmVyc2lvbiI6IjEifQ==","dependencies":["kubernetes_namespace.tailscale"]}]},{"mode":"managed","type":"kubectl_manifest","name":"authentik_internal_ingress","provider":"provider[\"registry.opentofu.org/gavinbunney/kubectl\"]","instances":[{"schema_version":1,"attributes":{"api_version":"networking.k8s.io/v1","apply_only":false,"force_conflicts":false,"force_new":false,"id":"/apis/networking.k8s.io/v1/namespaces/authentik/ingresses/authentik-tailnet-internal","ignore_fields":null,"kind":"Ingress","live_manifest_incluster":"8c18c29cc0c2b5ceef317e75ee17107a6a167ae4be2644209850ee7b7f1afd66","live_uid":"b0438201-ae85-4d00-813b-8c8b075e0a73","name":"authentik-tailnet-internal","namespace":"authentik","override_namespace":null,"sensitive_fields":null,"server_side_apply":false,"timeouts":null,"uid":"b0438201-ae85-4d00-813b-8c8b075e0a73","validate_schema":true,"wait":null,"wait_for_rollout":true,"yaml_body":"\"apiVersion\": \"networking.k8s.io/v1\"\n\"kind\": \"Ingress\"\n\"metadata\":\n  \"annotations\":\n    \"cert-manager.io/cluster-issuer\": \"homelab-ca-issuer\"\n  \"name\": \"authentik-tailnet-internal\"\n  \"namespace\": \"authentik\"\n\"spec\":\n  \"ingressClassName\": \"traefik\"\n  \"rules\":\n  - \"host\": \"authentik.tail60240b.ts.net\"\n    \"http\":\n      \"paths\":\n      - \"backend\":\n          \"service\":\n            \"name\": \"authentik-server\"\n            \"port\":\n              \"number\": 80\n        \"path\": \"/\"\n        \"pathType\": \"Prefix\"\n  \"tls\":\n  - \"hosts\":\n    - \"authentik.tail60240b.ts.net\"\n    \"secretName\": \"authentik-tailnet-tls\"\n","yaml_body_parsed":"apiVersion: networking.k8s.io/v1\nkind: Ingress\nmetadata:\n  annotations:\n    cert-manager.io/cluster-issuer: homelab-ca-issuer\n  name: authentik-tailnet-internal\n  namespace: authentik\nspec:\n  ingressClassName: traefik\n  rules:\n  - host: authentik.tail60240b.ts.net\n    http:\n      paths:\n      - backend:\n          service:\n            name: authentik-server\n            port:\n              number: 80\n        path: /\n        pathType: Prefix\n  tls:\n  - hosts:\n    - authentik.tail60240b.ts.net\n    secretName: authentik-tailnet-tls\n","yaml_incluster":"8c18c29cc0c2b5ceef317e75ee17107a6a167ae4be2644209850ee7b7f1afd66"},"sensitive_attributes":[[{"type":"get_attr","value":"live_manifest_incluster"}],[{"type":"get_attr","value":"yaml_body"}],[{"type":"get_attr","value":"yaml_incluster"}]],"private":"eyJlMmJmYjczMC1lY2FhLTExZTYtOGY4OC0zNDM2M2JjN2M0YzAiOnsiY3JlYXRlIjo2MDAwMDAwMDAwMDB9LCJzY2hlbWFfdmVyc2lvbiI6IjEifQ==","dependencies":["helm_release.authentik","helm_release.cert_manager","helm_release.postgres","helm_release.redis","kubectl_manifest.homelab_ca","kubectl_manifest.homelab_ca_issuer","kubectl_manifest.selfsigned_bootstrap","kubernetes_namespace.authentik","kubernetes_namespace.cert_manager","kubernetes_namespace.postgres","kubernetes_namespace.redis"]}]},{"mode":"managed","type":"kubectl_manifest","name":"harbor_ingress_local","provider":"provider[\"registry.opentofu.org/gavinbunney/kubectl\"]","instances":[{"schema_version":1,"attributes":{"api_version":"networking.k8s.io/v1","apply_only":false,"force_conflicts":false,"force_new":false,"id":"/apis/networking.k8s.io/v1/namespaces/harbor/ingresses/harbor-local","ignore_fields":null,"kind":"Ingress","live_manifest_incluster":"64b290adbe5b8d1580d467cfd6d337e62d9fc02b8271c25c0bdf18802446e97e","live_uid":"2082cffb-096f-408a-9db7-cabe1e7aa261","name":"harbor-local","namespace":"harbor","override_namespace":null,"sensitive_fields":null,"server_side_apply":false,"timeouts":null,"uid":"2082cffb-096f-408a-9db7-cabe1e7aa261","validate_schema":true,"wait":null,"wait_for_rollout":true,"yaml_body":"\"apiVersion\": \"networking.k8s.io/v1\"\n\"kind\": \"Ingress\"\n\"metadata\":\n  \"annotations\":\n    \"cert-manager.io/cluster-issuer\": \"homelab-ca-issuer\"\n  \"name\": \"harbor-local\"\n  \"namespace\": \"harbor\"\n\"spec\":\n  \"ingressClassName\": \"traefik\"\n  \"rules\":\n  - \"host\": \"harbor.local\"\n    \"http\":\n      \"paths\":\n      - \"backend\":\n          \"service\":\n            \"name\": \"harbor\"\n            \"port\":\n              \"number\": 80\n        \"path\": \"/\"\n        \"pathType\": \"Prefix\"\n  \"tls\":\n  - \"hosts\":\n    - \"harbor.local\"\n    \"secretName\": \"harbor.local-tls\"\n","yaml_body_parsed":"apiVersion: networking.k8s.io/v1\nkind: Ingress\nmetadata:\n  annotations:\n    cert-manager.io/cluster-issuer: homelab-ca-issuer\n  name: harbor-local\n  namespace: harbor\nspec:\n  ingressClassName: traefik\n  rules:\n  - host: harbor.local\n    http:\n      paths:\n      - backend:\n          service:\n            name: harbor\n            port:\n              number: 80\n        path: /\n        pathType: Prefix\n  tls:\n  - hosts:\n    - harbor.local\n    secretName: harbor.local-tls\n","yaml_incluster":"64b290adbe5b8d1580d467cfd6d337e62d9fc02b8271c25c0bdf18802446e97e"},"sensitive_attributes":[[{"type":"get_attr","value":"live_manifest_incluster"}],[{"type":"get_attr","value":"yaml_body"}],[{"type":"get_attr","value":"yaml_incluster"}]],"private":"eyJlMmJmYjczMC1lY2FhLTExZTYtOGY4OC0zNDM2M2JjN2M0YzAiOnsiY3JlYXRl