      [\n          {\n            \"node\": \"Update DAG State\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Update DAG State\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"All Story Tasks Done?\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"All Story Tasks Done?\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Tasks Remaining?\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Tasks Remaining?\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"→ F-06 DoD Check\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ],\n        [\n          {\n            \"node\": \"Notify: Task merged\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    }\n  },\n  \"active\": true,\n  \"tags\": [],\n  \"settings\": {\n    \"executionOrder\": \"v1\"\n  }\n}\n","F-06-dod-check.json":"{\n  \"name\": \"F-06 DoD Check\",\n  \"nodes\": [\n    {\n      \"id\": \"eda43cdc-9e98-484e-83dd-ff7fc3d2f7ef\",\n      \"name\": \"Webhook Trigger\",\n      \"type\": \"n8n-nodes-base.webhook\",\n      \"typeVersion\": 2,\n      \"position\": [\n        240,\n        300\n      ],\n      \"parameters\": {\n        \"path\": \"dod-check\",\n        \"httpMethod\": \"POST\",\n        \"responseMode\": \"onReceived\",\n        \"responseData\": \"allEntries\"\n      },\n      \"webhookId\": \"89d8e361-ddcc-4216-b410-f969b0827ce2\"\n    },\n    {\n      \"id\": \"a590f7ba-c7e8-4d7e-b928-2e53ed38c051\",\n      \"name\": \"Notify: DoD check\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4.2,\n      \"position\": [\n        680,\n        300\n      ],\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.OPENWEBUI_CALLBACK_URL }}\",\n        \"sendHeaders\": true,\n        \"headerParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"Content-Type\",\n              \"value\": \"application/json\"\n            }\n          ]\n        },\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"flow_id\",\n              \"value\": \"={{ $json.body?.flow_id ?? $json.flow_id ?? '' }}\"\n            },\n            {\n              \"name\": \"message\",\n              \"value\": \"=🔬 DoD check running for story {{ $json.body.story_id }}\"\n            },\n            {\n              \"name\": \"notes\",\n              \"value\": \"\"\n            }\n          ]\n        }\n      }\n    },\n    {\n      \"id\": \"b6000001-0000-0000-0000-000000000001\",\n      \"name\": \"TL DoD Input\",\n      \"type\": \"n8n-nodes-base.set\",\n      \"typeVersion\": 3.4,\n      \"position\": [\n        900,\n        300\n      ],\n      \"parameters\": {\n        \"mode\": \"manual\",\n        \"assignments\": {\n          \"assignments\": [\n            {\n              \"id\": \"1\",\n              \"name\": \"role\",\n              \"value\": \"tech-lead\",\n              \"type\": \"string\"\n            },\n            {\n              \"id\": \"2\",\n              \"name\": \"prompt\",\n              \"value\": \"=Evaluate Definition of Done for story {{ $json.body.story_id }} (branch {{ $json.body.story_branch }}) in project {{ $json.body.gitlab_project_path ?? $env.GITLAB_PROJECT_PATH.replace('%2F', '/') }} via glab: review its task branches for tests passing, no critical lint issues, and openspec pseudocode fully implemented. This is advisory only, not a merge gate — post your findings as a Kaneo comment on the story's task (id {{ $json.body.story_id }}, same id embedded in its `us/GL-{{ $json.body.story_id }}` branch name): `curl -sH \\\"Authorization: Bearer {{ $env.KANEO_TOKEN }}\\\" -X POST \\\"{{ $env.KANEO_URL }}/api/task/{{ $json.body.story_id }}/comment\\\" -H \\\"Content-Type: application/json\\\" -d '{\\\"content\\\": \\\"...\\\"}'` (// ponytail: verify exact comment path against the deployed Kaneo version) if the task exists, otherwise just report the findings in your own output.\",\n              \"type\": \"string\"\n            },\n            {\n              \"id\": \"3\",\n              \"name\": \"story\",\n              \"value\": \"={{ $json.body.story_id }}\",\n              \"type\": \"string\"\n            }\n          ]\n        }\n      }\n    },\n    {\n      \"id\": \"1c5e32cb-eeda-4422-bd5b-80546a7143a3\",\n      \"name\": \"TL: DoD Evaluation\",\n      \"type\": \"n8n-nodes-base.executeWorkflow\",\n      \"typeVersion\": 1.1,\n      \"position\": [\n        1120,\n        300\n      ],\n      \"parameters\": {\n        \"source\": \"database\",\n        \"workflowId\": {\n          \"mode\": \"id\",\n          \"value\": \"jAv16SAzGy9fA5G4\"\n        },\n        \"mode\": \"once\"\n      }\n    },\n    {\n      \"id\": \"14598c3c-4bcb-42da-a706-88e04456e5f3\",\n      \"name\": \"→ F-07 Story MR\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4.2,\n      \"position\": [\n        1340,\n        300\n      ],\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/story-mr-open\",\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"story_id\",\n              \"value\": \"={{ $('Notify: DoD check').item.json.body.story_id }}\"\n            },\n            {\n              \"name\": \"story_branch\",\n              \"value\": \"={{ $('Notify: DoD check').item.json.body.story_branch }}\"\n            }\n          ]\n        }\n      }\n    }\n  ],\n  \"connections\": {\n    \"Webhook Trigger\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Notify: DoD check\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Notify: DoD check\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"TL DoD Input\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"TL DoD Input\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"TL: DoD Evaluation\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"TL: DoD Evaluation\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"→ F-07 Story MR\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    }\n  },\n  \"active\": true,\n  \"tags\": [],\n  \"settings\": {\n    \"executionOrder\": \"v1\"\n  }\n}\n","F-07-story-mr-open.json":"{\n  \"name\": \"F-07 Story MR Open\",\n  \"nodes\": [\n    {\n      \"id\": \"df96bafb-4aa1-4c90-9f46-5f7ba30126d3\",\n      \"name\": \"Webhook Trigger\",\n      \"type\": \"n8n-nodes-base.webhook\",\n      \"typeVersion\": 2,\n      \"position\": [\n        240,\n        300\n      ],\n      \"parameters\": {\n        \"path\": \"story-mr-open\",\n        \"httpMethod\": \"POST\",\n        \"responseMode\": \"onReceived\",\n        \"responseData\": \"allEntries\"\n      },\n      \"webhookId\": \"4e7e56cf-aa7d-4a0a-9c87-94ff20e0153f\"\n    },\n    {\n      \"id\": \"4482e1db-09f7-4db2-bab7-cfbf0d8e3ae6\",\n      \"name\": \"Notify: Story MR opening\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4.2,\n      \"position\": [\n        680,\n        300\n      ],\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.OPENWEBUI_CALLBACK_URL }}\",\n        \"sendHeaders\": true,\n        \"headerParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"Content-Type\",\n              \"value\": \"application/json\"\n            }\n          ]\n        },\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"flow_id\",\n              \"value\": \"={{ $json.body?.flow_id ?? $json.flow_id ?? '' }}\"\n            },\n            {\n              \"name\": \"message\",\n              \"value\": \"📋 Story MR opening — TL + QA parallel\"\n            },\n            {\n              \"name\": \"notes\",\n              \"value\": \"\"\n            }\n          ]\n        }\n      }\n    },\n    {\n      \"id\": \"b7000001-0000-0000-0000-000000000001\",\n      \"name\": \"TL Input\",\n      \"type\": \"n8n-nodes-base.set\",\n      \"typeVersion\": 3.4,\n      \"position\": [\n        900,\n        200\n      ],\n      \"parameters\": {\n        \"mode\": \"manual\",\n        \"assignments\": {\n          \"assignments\": [\n            {\n              \"id\": \"1\",\n              \"name\": \"role\",\n              \"value\": \"tech-lead\",\n              \"type\": \"string\"\n            },\n            {\n              \"id\": \"2\",\n              \"name\": \"prompt\",\n              \"value\": \"=Using glab against the in-cluster GitLab (`--hostname gitlab-webservice-default.gitlab.svc.cluster.local`, project {{ $node['Webhook Trigger'].json.body.project?.path_with_namespace ?? $env.GITLAB_PROJECT_PATH.replace('%2F', '/') }}), find the release branch this story forked from: list branches via `glab api projects/{{ $node['Webhook Trigger'].json.body.project?.path_with_namespace?.replaceAll('/','%2F') ?? $env.GITLAB_PROJECT_PATH }}/repository/branches` and pick the one matching 'release/vMAJOR.MINOR.PATCH' with the highest version. Open an MR from story/{{ $node['Webhook Trigger'].json.body.story_id }} into that release branch. Set reviewers.\",\n              \"type\": \"string\"\n            },\n            {\n              \"id\": \"3\",\n              \"name\": \"story\",\n              \"value\": \"={{ $node['Webhook Trigger'].json.body.story_id }}\",\n              \"type\": \"string\"\n            }\n          ]\n        }\n      }\n    },\n    {\n      \"id\": \"15610405-e40d-45b1-bc0a-c5124fd42a9e\",\n      \"name\": \"TL: Open Story MR\",\n      \"type\": \"n8n-nodes-base.executeWorkflow\",\n      \"typeVersion\": 1.1,\n      \"position\": [\n        1080,\n        200\n      ],\n      \"parameters\": {\n        \"source\": \"database\",\n        \"workflowId\": {\n          \"mode\": \"id\",\n          \"value\": \"jAv16SAzGy9fA5G4\"\n        },\n        \"mode\": \"once\"\n      }\n    },\n    {\n      \"id\": \"b7000001-0000-0000-0000-000000000002\",\n      \"name\": \"QA Input\",\n      \"type\": \"n8n-nodes-base.set\",\n      \"typeVersion\": 3.4,\n      \"position\": [\n        900,\n        400\n      ],\n      \"parameters\": {\n        \"mode\": \"manual\",\n        \"assignments\": {\n          \"assignments\": [\n            {\n              \"id\": \"1\",\n              \"name\": \"role\",\n              \"value\": \"qa-engineer\",\n              \"type\": \"string\"\n            },\n            {\n              \"id\": \"2\",\n              \"name\": \"prompt\",\n              \"value\": \"=Run the integration test suite for story {{ $node['Webhook Trigger'].json.body.story_id }} against the SIT cluster (story/task-level QA testing runs here, not a dedicated QA cluster). Report pass/fail with coverage.\",\n              \"type\": \"string\"\n            },\n            {\n              \"id\": \"3\",\n              \"name\": \"story\",\n              \"value\": \"={{ $node['Webhook Trigger'].json.body.story_id }}\",\n              \"type\": \"string\"\n            }\n          ]\n        }\n      }\n    },\n    {\n      \"id\": \"d93ceb5e-24c0-466b-a4a4-102ad7f2b1d6\",\n      \"name\": \"QA: Story Integration Tests\",\n      \"type\": \"n8n-nodes-base.executeWorkflow\",\n      \"typeVersion\": 1.1,\n      \"position\": [\n        1080,\n        400\n      ],\n      \"parameters\": {\n        \"source\": \"database\",\n        \"workflowId\": {\n          \"mode\": \"id\",\n          \"value\": \"jAv16SAzGy9fA5G4\"\n        },\n        \"mode\": \"once\"\n      }\n    },\n    {\n      \"id\": \"f1eaf118-e763-4983-a61e-992b0a37376c\",\n      \"name\": \"Merge TL+QA\",\n      \"type\": \"n8n-nodes-base.merge\",\n      \"typeVersion\": 3,\n      \"position\": [\n        1300,\n        300\n      ],\n      \"parameters\": {\n        \"mode\": \"combine\",\n        \"combineBy\": \"combineByPosition\",\n        \"numberInputs\": 2\n      }\n    },\n    {\n      \"id\": \"b9e6b8aa-39d6-45fc-9ec0-b76c443c0415\",\n      \"name\": \"Notify: Story MR ready for Edward\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4.2,\n      \"position\": [\n        1520,\n        300\n      ],\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.OPENWEBUI_CALLBACK_URL }}\",\n        \"sendHeaders\": true,\n        \"headerParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"Content-Type\",\n              \"value\": \"application/json\"\n            }\n          ]\n        },\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"flow_id\",\n              \"value\": \"={{ $node['Webhook Trigger'].json.body.flow_id ?? '' }}\"\n            },\n            {\n              \"name\": \"message\",\n              \"value\": \"=👤 Story MR ready — Edward please review and merge story/{{ $node['Webhook Trigger'].json.body.story_id }}\"\n            },\n            {\n              \"name\": \"notes\",\n              \"value\": \"\"\n            }\n          ]\n        }\n      }\n    }\n  ],\n  \"connections\": {\n    \"Webhook Trigger\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Notify: Story MR opening\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Notify: Story MR opening\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"TL Input\",\n            \"type\": \"main\",\n            \"index\": 0\n          },\n          {\n            \"node\": \"QA Input\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"TL Input\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"TL: Open Story MR\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"QA Input\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"QA: Story Integration Tests\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"TL: Open Story MR\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Merge TL+QA\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"QA: Story Integration Tests\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Merge TL+QA\",\n            \"type\": \"main\",\n            \"index\": 1\n          }\n        ]\n      ]\n    },\n    \"Merge TL+QA\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Notify: Story MR ready for Edward\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    }\n  },\n  \"active\": true,\n  \"tags\": [],\n  \"settings\": {\n    \"executionOrder\": \"v1\"\n  }\n}\n","F-08-story-mr-merged.json":"{\n  \"name\": \"F-08 Story MR Merged\",\n  \"nodes\": [\n    {\n      \"id\": \"ee6c5ffd-4374-4ef1-90b0-4397637f65ad\",\n      \"name\": \"Webhook Trigger\",\n      \"type\": \"n8n-nodes-base.webhook\",\n      \"typeVersion\": 2,\n      \"position\": [\n        240,\n        300\n      ],\n      \"parameters\": {\n        \"path\": \"gitlab-story-mr-merged\",\n        \"httpMethod\": \"POST\",\n        \"responseMode\": \"onReceived\",\n        \"responseData\": \"allEntries\"\n      },\n      \"webhookId\": \"e1932c5d-0bc4-42c3-8723-236fccec563a\"\n    },\n    {\n      \"id\": \"f08000001-0000-0000-0000-000000000001\",\n      \"name\": \"Extract Story IID\",\n      \"type\": \"n8n-nodes-base.code\",\n      \"typeVersion\": 2,\n      \"position\": [\n        460,\n        300\n      ],\n      \"parameters\": {\n        \"jsCode\": \"const branch = ($json.body?.object_attributes?.source_branch) || ($json.object_attributes?.source_branch) || '';\\nconst m = branch.match(/^us\\\\/GL-(\\\\d+)$/);\\nreturn [{ json: { ...$json, story_work_package_id: m ? m[1] : null, source_branch: branch } }];\"\n      }\n    },\n    {\n      \"id\": \"e9c0b402-3e0c-4df5-873f-2b9760d50ef2\",\n      \"name\": \"Close Story Ticket\",\n      \"type\": \"n8n-nodes-base.code\",\n      \"typeVersion\": 2,\n      \"position\": [\n        680,\n        200\n      ],\n      \"parameters\": {\n        \"jsCode\": \"// ponytail: Kaneo collapses Taiga's epic/userstory/task/issue into one\\n// task resource -- the story's ticket is just a Kaneo task, plain status\\n// field, no separate status-id lookup. Verify 'done' against the deployed\\n// Kaneo version.\\nconst auth = { Authorization: `Bearer ${$env.KANEO_TOKEN}` };\\nconst id = $node['Extract Story IID'].json.story_work_package_id;\\nif (!id) return [{ json: $json }];\\nawait this.helpers.httpRequest({ method: 'PATCH', url: `${$env.KANEO_URL}/api/task/${id}`, headers: { ...auth, 'Content-Type': 'application/json' }, body: { status: 'done' }, json: true });\\nreturn [{ json: $json }];\"\n      }\n    },\n    {\n      \"id\": \"ced58661-afae-44e6-a50f-a463c1ffd36d\",\n      \"name\": \"All Stories Merged?\",\n      \"type\": \"n8n-nodes-base.code\",\n      \"typeVersion\": 2,\n      \"position\": [\n        900,\n        300\n      ],\n      \"parameters\": {\n        \"jsCode\": \"// ponytail: Taiga's tags-based release grouping has no direct Kaneo\\n// equivalent confirmed from docs -- using a 'label' query filter on the\\n// project's task list, closest available field; verify against the\\n// deployed Kaneo version.\\nconst auth = { Authorization: `Bearer ${$env.KANEO_TOKEN}` };\\nconst res = await this.helpers.httpRequest({ method: 'GET', url: `${$env.KANEO_URL}/api/task/tasks/${$env.KANEO_PROJECT_ID}?label=${$env.RELEASE_VERSION}`, headers: auth, json: true });\\nconst openStories = (res || []).filter(s =\u003e s.status !== 'done');\\nreturn [{ json: { ...$json, length: openStories.length } }];\"\n      }\n    },\n    {\n      \"id\": \"d6a68429-049f-41bd-ae3d-0e73d63f725f\",\n      \"name\": \"All Done?\",\n      \"type\": \"n8n-nodes-base.if\",\n      \"typeVersion\": 2,\n      \"position\": [\n        1120,\n        300\n      ],\n      \"parameters\": {\n        \"conditions\": {\n          \"options\": {\n            \"leftValue\": \"={{ $json.length }}\",\n            \"operation\": \"equals\",\n            \"rightValue\": \"0\"\n          }\n        }\n      }\n    },\n    {\n      \"id\": \"9d8cfb43-de7c-4cb9-b093-1568ada2507b\",\n      \"name\": \"Notify: All stories done\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4.2,\n      \"position\": [\n        1340,\n        200\n      ],\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.OPENWEBUI_CALLBACK_URL }}\",\n        \"sendHeaders\": true,\n        \"headerParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"Content-Type\",\n              \"value\": \"application/json\"\n            }\n          ]\n        },\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"flow_id\",\n              \"value\": \"={{ $json.body?.flow_id ?? $json.flow_id ?? '' }}\"\n            },\n            {\n              \"name\": \"message\",\n              \"value\": \"🎉 All stories merged — release ready for /uat\"\n            },\n            {\n              \"name\": \"notes\",\n              \"value\": \"\"\n            }\n          ]\n        }\n      }\n    },\n    {\n      \"id\": \"238b6c61-6e62-49b6-ae85-8bd3283a024a\",\n      \"name\": \"Notify: More stories pending\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4.2,\n      \"position\": [\n        1340,\n        400\n      ],\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.OPENWEBUI_CALLBACK_URL }}\",\n        \"sendHeaders\": true,\n        \"headerParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"Content-Type\",\n              \"value\": \"application/json\"\n            }\n          ]\n        },\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"flow_id\",\n              \"value\": \"={{ $json.body?.flow_id ?? $json.flow_id ?? '' }}\"\n            },\n            {\n              \"name\": \"message\",\n              \"value\": \"=✅ Story merged — {{ $json.length }} stories still open\"\n            },\n            {\n              \"name\": \"notes\",\n              \"value\": \"\"\n            }\n          ]\n        }\n      }\n    }\n  ],\n  \"connections\": {\n    \"Webhook Trigger\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Extract Story IID\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Extract Story IID\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Close Story Ticket\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Close Story Ticket\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"All Stories Merged?\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"All Stories Merged?\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"All Done?\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"All Done?\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Notify: All stories done\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ],\n        [\n          {\n            \"node\": \"Notify: More stories pending\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    }\n  },\n  \"active\": true,\n  \"tags\": [],\n  \"settings\": {\n    \"executionOrder\": \"v1\"\n  }\n}\n","F-09-ci-pipeline.json":"{\n  \"name\": \"F-09 CI Pipeline / Version Built\",\n  \"nodes\": [\n    {\n      \"id\": \"12eed3a8-ee21-4de9-b223-84fa33900f25\",\n      \"name\": \"Webhook Trigger\",\n      \"type\": \"n8n-nodes-base.webhook\",\n      \"typeVersion\": 2,\n      \"position\": [\n        240,\n        300\n      ],\n      \"parameters\": {\n        \"path\": \"gitlab-pipeline\",\n        \"httpMethod\": \"POST\",\n        \"responseMode\": \"onReceived\",\n        \"responseData\": \"allEntries\"\n      },\n      \"webhookId\": \"9626f4e0-0a00-4f0a-a75c-2b2b3699f8ce\"\n    },\n    {\n      \"id\": \"bf79587f-6d36-4fa9-b41d-8a2817be0b7f\",\n      \"name\": \"Update DAG: pipeline state\",\n      \"type\": \"n8n-nodes-base.set\",\n      \"typeVersion\": 3.4,\n      \"position\": [\n        680,\n        300\n      ],\n      \"parameters\": {\n        \"assignments\": {\n          \"assignments\": [\n            {\n              \"id\": \"11353859-5ea2-4a0a-bc95-a3f9a9108f7c\",\n              \"name\": \"pipeline_id\",\n              \"value\": \"={{ $json.body.object_attributes.id }}\",\n              \"type\": \"string\"\n            },\n            {\n              \"id\": \"647dc784-c163-4109-acb6-a9c672381976\",\n              \"name\": \"status\",\n              \"value\": \"={{ $json.body.object_attributes.status }}\",\n              \"type\": \"string\"\n            },\n            {\n              \"id\": \"977b7ed5-d19e-4914-af28-46b2f797689d\",\n              \"name\": \"ref\",\n              \"value\": \"={{ $json.body.object_attributes.ref }}\",\n              \"type\": \"string\"\n            }\n          ]\n        }\n      }\n    },\n    {\n      \"id\": \"34d645c4-73ac-46ca-9b87-42f98c958057\",\n      \"name\": \"Pipeline Success?\",\n      \"type\": \"n8n-nodes-base.if\",\n      \"typeVersion\": 2,\n      \"position\": [\n        900,\n        300\n      ],\n      \"parameters\": {\n        \"conditions\": {\n          \"options\": {\n            \"leftValue\": \"={{ $json.status }}\",\n            \"operation\": \"equals\",\n            \"rightValue\": \"success\"\n          }\n        }\n      }\n    },\n    {\n      \"id\": \"16400914-1c76-4cb9-b116-fab3b944625b\",\n      \"name\": \"Notify: CI success\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4.2,\n      \"position\": [\n        1120,\n        200\n      ],\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.OPENWEBUI_CALLBACK_URL }}\",\n        \"sendHeaders\": true,\n        \"headerParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"Content-Type\",\n              \"value\": \"application/json\"\n            }\n          ]\n        },\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"flow_id\",\n              \"value\": \"={{ $json.body?.flow_id ?? $json.flow_id ?? '' }}\"\n            },\n            {\n              \"name\": \"message\",\n              \"value\": \"=✅ Pipeline {{ $json.pipeline_id }} succeeded on {{ $json.ref }}\"\n            },\n            {\n              \"name\": \"notes\",\n              \"value\": \"\"\n            }\n          ]\n        }\n      }\n    },\n    {\n      \"id\": \"413d167d-0b79-45cf-b6e5-f03f6f9bb101\",\n      \"name\": \"Notify: CI failed\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4.2,\n      \"position\": [\n        1120,\n        400\n      ],\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.OPENWEBUI_CALLBACK_URL }}\",\n        \"sendHeaders\": true,\n        \"headerParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"Content-Type\",\n              \"value\": \"application/json\"\n            }\n          ]\n        },\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"flow_id\",\n              \"value\": \"={{ $json.body?.flow_id ?? $json.flow_id ?? '' }}\"\n            },\n            {\n              \"name\": \"message\",\n              \"value\": \"=❌ Pipeline {{ $json.pipeline_id }} FAILED on {{ $json.ref }} — check logs\"\n            },\n            {\n              \"name\": \"notes\",\n              \"value\": \"\"\n            }\n          ]\n        }\n      }\n    }\n  ],\n  \"connections\": {\n    \"Webhook Trigger\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Update DAG: pipeline state\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Update DAG: pipeline state\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Pipeline Success?\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Pipeline Success?\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Notify: CI success\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ],\n        [\n          {\n            \"node\": \"Notify: CI failed\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    }\n  },\n  \"active\": true,\n  \"tags\": [],\n  \"settings\": {\n    \"executionOrder\": \"v1\"\n  }\n}\n","F-10-uat.json":"{\n  \"name\": \"F-10 /uat\",\n  \"nodes\": [\n    {\n      \"id\": \"4f688152-8908-4662-ba01-94fe7a4b59c3\",\n      \"name\": \"Webhook Trigger\",\n      \"type\": \"n8n-nodes-base.webhook\",\n      \"typeVersion\": 2,\n      \"position\": [\n        240,\n        300\n      ],\n      \"parameters\": {\n        \"path\": \"uat\",\n        \"httpMethod\": \"POST\",\n        \"responseMode\": \"onReceived\",\n        \"responseData\": \"allEntries\"\n      },\n      \"webhookId\": \"9d868882-f56c-4013-9e6c-aa09a62c9a2c\"\n    },\n    {\n      \"id\": \"bb687645-4875-4fbc-af27-97ea0a50318f\",\n      \"name\": \"UAT Safeguard: All Stories Merged?\",\n      \"type\": \"n8n-nodes-base.code\",\n      \"typeVersion\": 2,\n      \"position\": [\n        680,\n        300\n      ],\n      \"parameters\": {\n        \"jsCode\": \"// ponytail: Kaneo has one task resource (no separate userstory type) --\\n// list the project's tasks and check status.\\nconst auth = { Authorization: `Bearer ${$env.KANEO_TOKEN}` };\\nconst res = await this.helpers.httpRequest({ method: 'GET', url: `${$env.KANEO_URL}/api/task/tasks/${$env.KANEO_PROJECT_ID}`, headers: auth, json: true });\\nconst openStories = (res || []).filter(s =\u003e s.status !== 'done');\\nreturn [{ json: { ...$json, length: openStories.length } }];\"\n      }\n    },\n    {\n      \"id\": \"f5ccd427-0605-4317-b184-20232eca15bc\",\n      \"name\": \"Safeguard pass?\",\n      \"type\": \"n8n-nodes-base.if\",\n      \"typeVersion\": 2,\n      \"position\": [\n        900,\n        300\n      ],\n      \"parameters\": {\n        \"conditions\": {\n          \"options\": {\n            \"leftValue\": \"={{ $json.length }}\",\n            \"operation\": \"equals\",\n            \"rightValue\": \"0\"\n          }\n        }\n      }\n    },\n    {\n      \"id\": \"ee7fb018-1448-478a-b84a-e5c941d4c299\",\n      \"name\": \"Notify: UAT blocked\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4.2,\n      \"position\": [\n        1120,\n        400\n      ],\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.OPENWEBUI_CALLBACK_URL }}\",\n        \"sendHeaders\": true,\n        \"headerParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"Content-Type\",\n              \"value\": \"application/json\"\n            }\n          ]\n        },\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"flow_id\",\n              \"value\": \"={{ $json.body?.flow_id ?? $json.flow_id ?? '' }}\"\n            },\n            {\n              \"name\": \"message\",\n              \"value\": \"🚫 /uat blocked — {{ $json.length }} stories still open, not all merged to release\"\n            },\n            {\n              \"name\": \"notes\",\n              \"value\": \"\"\n            }\n          ]\n        }\n      }\n    },\n    {\n      \"id\": \"c1000001-0000-0000-0000-000000000001\",\n      \"name\": \"Pre-UAT Deploy Input\",\n      \"type\": \"n8n-nodes-base.set\",\n      \"typeVersion\": 3.4,\n      \"position\": [\n        1120,\n        60\n      ],\n      \"parameters\": {\n        \"mode\": \"manual\",\n        \"assignments\": {\n          \"assignments\": [\n            {\n              \"id\": \"1\",\n              \"name\": \"role\",\n              \"value\": \"devops-engineer\",\n              \"type\": \"string\"\n            },\n            {\n              \"id\": \"2\",\n              \"name\": \"prompt\",\n              \"value\": \"=Promote the exact tested images for release {{ $env.RELEASE_VERSION }} to UAT — using glab against gitlab-webservice-default.gitlab.svc.cluster.local (project {{ $node['Webhook Trigger'].json.body.gitlab_project_path ?? $env.GITLAB_PROJECT_PATH.replace('%2F', '/') }}). Step 1: list merged story MRs targeting `release/{{ $env.RELEASE_VERSION }}` (`glab api \\\"projects/{{ $node['Webhook Trigger'].json.body.gitlab_project_path?.replaceAll('/','%2F') ?? $env.GITLAB_PROJECT_PATH }}/merge_requests?target_branch=release/{{ $env.RELEASE_VERSION }}\u0026state=merged\u0026labels=type:story\\\"`). Step 2: for each, fetch its notes (`glab api projects/{{ $node['Webhook Trigger'].json.body.gitlab_project_path?.replaceAll('/','%2F') ?? $env.GITLAB_PROJECT_PATH }}/merge_requests/\u003ciid\u003e/notes`) and find QA's comment containing a 'Tested image tags:' block (format `- {service}: v{X}.{Y}.{Z}-rc{N}` per line, one per changed service — see qa-engineer SKILL.md). If a merged story MR has no such comment, STOP and signal n8n blocked with `{\\\"status\\\": \\\"blocked\\\", \\\"reason\\\": \\\"no tested image tags recorded\\\", \\\"mr_iid\\\": \\\"\u003ciid\u003e\\\"}` — never fall back to whatever is currently on SIT, never guess a tag. Step 3: for every {service}:{tag} pair collected across all story MRs, edit `env/uat/{service}/values.yaml` on `main` (create the file if this is the service's first UAT deploy — copy the shape of an existing `env/uat/*/values.yaml` in the repo) setting the image tag field to the exact tag from the comment. Step 4: commit all edited files in one commit (`chore: promote tested images to UAT for {{ $env.RELEASE_VERSION }}`) and push to main — ArgoCD's automated syncPolicy on each `{{ $node['Webhook Trigger'].json.body.argocd_project ?? $env.ARGOCD_PROJECT }}-\u003cservice\u003e-uat` Application picks up the change from there, no image-updater involved (UAT is explicit-sync only). Report which services were updated and to which tags.\",\n              \"type\": \"string\"\n            },\n            {\n              \"id\": \"3\",\n              \"name\": \"story\",\n              \"value\": \"={{ $env.RELEASE_VERSION }}\",\n              \"type\": \"string\"\n            }\n          ]\n        }\n      }\n    },\n    {\n      \"id\": \"c1000001-0000-0000-0000-000000000002\",\n      \"name\": \"Deploy Tested Images to UAT\",\n      \"type\": \"n8n-nodes-base.executeWorkflow\",\n      \"typeVersion\": 1.1,\n      \"position\": [\n        1120,\n        200\n      ],\n      \"parameters\": {\n        \"source\": \"database\",\n        \"workflowId\": {\n          \"mode\": \"id\",\n          \"value\": \"jAv16SAzGy9fA5G4\"\n        },\n        \"mode\": \"once\"\n      }\n    },\n    {\n      \"id\": \"9dda1bce-e5cc-4691-9d73-86e55e3aa0d8\",\n      \"name\": \"Wake UAT Cluster\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4.2,\n      \"position\": [\n        1120,\n        200\n      ],\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/cluster-lifecycle\",\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"action\",\n              \"value\": \"wake\"\n            },\n            {\n              \"name\": \"cluster\",\n              \"value\": \"uat\"\n            }\n          ]\n        }\n      }\n    },\n    {\n      \"id\": \"dea28236-790c-4e23-9457-aa3686060a62\",\n      \"name\": \"ArgoCD: Sync UAT\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4.2,\n      \"position\": [\n        1340,\n        200\n      ],\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.ARGOCD_URL }}/api/v1/applications/{{ $node['Webhook Trigger'].json.body.argocd_project ?? $env.ARGOCD_PROJECT }}-uat/sync\",\n        \"sendHeaders\": true,\n        \"headerParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"Authorization\",\n              \"value\": \"Bearer {{ $env.ARGOCD_TOKEN }}\"\n            }\n          ]\n        }\n      }\n    },\n    {\n      \"id\": \"bd6a2087-8ab3-43c3-b49d-addbf6929e31\",\n      \"name\": \"Notify: UAT deployed\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4.2,\n      \"position\": [\n        1560,\n        200\n      ],\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.OPENWEBUI_CALLBACK_URL }}\",\n        \"sendHeaders\": true,\n        \"headerParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"Content-Type\",\n              \"value\": \"application/json\"\n            }\n          ]\n        },\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"flow_id\",\n              \"value\": \"={{ $json.body?.flow_id ?? $json.flow_id ?? '' }}\"\n            },\n            {\n              \"name\": \"message\",\n              \"value\": \"🚀 UAT deployed — triggering QA stage F-11\"\n            },\n            {\n              \"name\": \"notes\",\n              \"value\": \"\"\n            }\n          ]\n        }\n      }\n    },\n    {\n      \"id\": \"eebeeb33-2386-4944-9bbf-2f6f57cfb60b\",\n      \"name\": \"→ F-11 QA UAT\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4.2,\n      \"position\": [\n        1780,\n        200\n      ],\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/uat-qa\",\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"version\",\n              \"value\": \"={{ $env.RELEASE_VERSION }}\"\n            }\n          ]\n        }\n      }\n    }\n  ],\n  \"connections\": {\n    \"Webhook Trigger\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"UAT Safeguard: All Stories Merged?\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"UAT Safeguard: All Stories Merged?\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Safeguard pass?\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Safeguard pass?\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Pre-UAT Deploy Input\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ],\n        [\n          {\n            \"node\": \"Notify: UAT blocked\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Pre-UAT Deploy Input\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Deploy Tested Images to UAT\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Deploy Tested Images to UAT\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Wake UAT Cluster\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Wake UAT Cluster\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"ArgoCD: Sync UAT\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"ArgoCD: Sync UAT\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Notify: UAT deployed\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Notify: UAT deployed\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"→ F-11 QA UAT\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    }\n  },\n  \"active\": true,\n  \"tags\": [],\n  \"settings\": {\n    \"executionOrder\": \"v1\"\n  }\n}\n","F-11-uat-qa.json":"{\n  \"name\": \"F-11 UAT QA Stage\",\n  \"nodes\": [\n    {\n      \"id\": \"8975bd3f-7fd8-4900-acde-b52363f289aa\",\n      \"name\": \"Webhook Trigger\",\n      \"type\": \"n8n-nodes-base.webhook\",\n      \"typeVersion\": 2,\n      \"position\": [240, 300],\n      \"parameters\": {\n        \"path\": \"uat-qa\",\n        \"httpMethod\": \"POST\",\n        \"responseMode\": \"onReceived\",\n        \"responseData\": \"allEntries\"\n      },\n      \"webhookId\": \"abea6881-749a-4a6c-b109-427679374864\"\n    },\n    {\n      \"id\": \"2b46b876-4e1a-4d45-99f0-4f6504a77106\",\n      \"name\": \"Notify: UAT QA running\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4.2,\n      \"position\": [680, 300],\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.OPENWEBUI_CALLBACK_URL }}\",\n        \"sendHeaders\": true,\n        \"headerParameters\": {\n          \"parameters\": [{ \"name\": \"Content-Type\", \"value\": \"application/json\" }]\n        },\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            { \"name\": \"flow_id\", \"value\": \"={{ $json.body?.flow_id ?? $json.flow_id ?? '' }}\" },\n            { \"name\": \"message\", \"value\": \"🧪 UAT QA stage running\" },\n            { \"name\": \"notes\", \"value\": \"\" }\n          ]\n        }\n      }\n    },\n    {\n      \"id\": \"b11000001-0000-0000-0000-000000000001\",\n      \"name\": \"QA Input\",\n      \"type\": \"n8n-nodes-base.set\",\n      \"typeVersion\": 3.4,\n      \"position\": [900, 300],\n      \"parameters\": {\n        \"mode\": \"manual\",\n        \"assignments\": {\n          \"assignments\": [\n            { \"id\": \"1\", \"name\": \"role\", \"value\": \"qa-engineer\", \"type\": \"string\" },\n            { \"id\": \"2\", \"name\": \"prompt\", \"value\": \"=Run the full UAT test suite against the UAT environment for {{ $node['Webhook Trigger'].json.body.version }} — functional pass/fail plus a load/performance test (response times under representative concurrent load, error rate under load). UAT is now the only environment performance testing runs against (no separate QA/staging cluster). Output JSON only: {\\\"pass\\\": true|false, \\\"coverage\\\": \\\"string\\\", \\\"performance\\\": {\\\"p95_ms\\\": number, \\\"error_rate\\\": number, \\\"notes\\\": \\\"string\\\"}}\", \"type\": \"string\" },\n            { \"id\": \"3\", \"name\": \"story\", \"value\": \"={{ $node['Webhook Trigger'].json.body.version }}\", \"type\": \"string\" }\n          ]\n        }\n      }\n    },\n    {\n      \"id\": \"db07fada-4a52-4a73-837e-954b1ab5db37\",\n      \"name\": \"QA: UAT Test Suite\",\n      \"type\": \"n8n-nodes-base.executeWorkflow\",\n      \"typeVersion\": 1.1,\n      \"position\": [1080, 300],\n      \"parameters\": {\n        \"source\": \"database\",\n        \"workflowId\": { \"mode\": \"id\", \"value\": \"jAv16SAzGy9fA5G4\" },\n        \"mode\": \"once\"\n      }\n    },\n    {\n      \"id\": \"c77b337c-e632-467b-8904-bac2f22bb6b7\",\n      \"name\": \"QA Pass?\",\n      \"type\": \"n8n-nodes-base.if\",\n      \"typeVersion\": 2,\n      \"position\": [1300, 300],\n      \"parameters\": {\n        \"conditions\": {\n          \"options\": {\n            \"leftValue\": \"={{ $json.output.includes('\\\"pass\\\"') \u0026\u0026 $json.output.includes('true') }}\",\n            \"operation\": \"equals\",\n            \"rightValue\": \"true\"\n          }\n        }\n      }\n    },\n    {\n      \"id\": \"03d59e9f-a54f-462e-8baa-ef1d0002026b\",\n      \"name\": \"→ F-12 Security UAT\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4.2,\n      \"position\": [1740, 200],\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/uat-security\",\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            { \"name\": \"version\", \"value\": \"={{ $node['Webhook Trigger'].json.body.version }}\" }\n          ]\n        }\n      }\n    },\n    {\n      \"id\": \"7e12f7b9-659c-423b-8590-61c4f1f9f7d7\",\n      \"name\": \"Notify: QA UAT failed\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4.2,\n      \"position\": [1520, 400],\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.OPENWEBUI_CALLBACK_URL }}\",\n        \"sendHeaders\": true,\n        \"headerParameters\": {\n          \"parameters\": [{ \"name\": \"Content-Type\", \"value\": \"application/json\" }]\n        },\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            { \"name\": \"flow_id\", \"value\": \"={{ $node['Webhook Trigger'].json.body.flow_id ?? '' }}\" },\n            { \"name\": \"message\", \"value\": \"=❌ UAT QA failed — {{ $node['QA: UAT Test Suite'].json.output }}\" },\n            { \"name\": \"notes\", \"value\": \"\" }\n          ]\n        }\n      }\n    }\n  ],\n  \"connections\": {\n    \"Webhook Trigger\": {\n      \"main\": [[{ \"node\": \"Notify: UAT QA running\", \"type\": \"main\", \"index\": 0 }]]\n    },\n    \"Notify: UAT QA running\": {\n      \"main\": [[{ \"node\": \"QA Input\", \"type\": \"main\", \"index\": 0 }]]\n    },\n    \"QA Input\": {\n      \"main\": [[{ \"node\": \"QA: UAT Test Suite\", \"type\": \"main\", \"index\": 0 }]]\n    },\n    \"QA: UAT Test Suite\": {\n      \"main\": [[{ \"node\": \"QA Pass?\", \"type\": \"main\", \"index\": 0 }]]\n    },\n    \"QA Pass?\": {\n      \"main\": [\n        [{ \"node\": \"→ F-12 Security UAT\", \"type\": \"main\", \"index\": 0 }],\n        [{ \"node\": \"Notify: QA UAT failed\", \"type\": \"main\", \"index\": 0 }]\n      ]\n    }\n  },\n  \"active\": true,\n  \"tags\": [],\n  \"settings\": {\n    \"executionOrder\": \"v1\"\n  }\n}\n","F-12-uat-security.json":"{\n  \"name\": \"F-12 UAT Security Stage\",\n  \"nodes\": [\n    {\n      \"id\": \"85430670-4c10-42a6-9ef6-57f18f7683a1\",\n      \"name\": \"Webhook Trigger\",\n      \"type\": \"n8n-nodes-base.webhook\",\n      \"typeVersion\": 2,\n      \"position\": [240, 300],\n      \"parameters\": {\n        \"path\": \"uat-security\",\n        \"httpMethod\": \"POST\",\n        \"responseMode\": \"onReceived\",\n        \"responseData\": \"allEntries\"\n      },\n      \"webhookId\": \"a46cc09a-cd08-436e-9c07-c6adf5ee6e6f\"\n    },\n    {\n      \"id\": \"cbc26af0-47a0-4816-a868-f8041b76c916\",\n      \"name\": \"Notify: UAT Security running\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4.2,\n      \"position\": [680, 300],\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.OPENWEBUI_CALLBACK_URL }}\",\n        \"sendHeaders\": true,\n        \"headerParameters\": {\n          \"parameters\": [{ \"name\": \"Content-Type\", \"value\": \"application/json\" }]\n        },\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            { \"name\": \"flow_id\", \"value\": \"={{ $json.body?.flow_id ?? $json.flow_id ?? '' }}\" },\n            { \"name\": \"message\", \"value\": \"🔐 UAT Security stage running\" },\n            { \"name\": \"notes\", \"value\": \"\" }\n          ]\n        }\n      }\n    },\n    {\n      \"id\": \"b12000001-0000-0000-0000-000000000001\",\n      \"name\": \"Security Input\",\n      \"type\": \"n8n-nodes-base.set\",\n      \"typeVersion\": 3.4,\n      \"position\": [900, 300],\n      \"parameters\": {\n        \"mode\": \"manual\",\n        \"assignments\": {\n          \"assignments\": [\n            { \"id\": \"1\", \"name\": \"role\", \"value\": \"security-engineer\", \"type\": \"string\" },\n            { \"id\": \"2\", \"name\": \"prompt\", \"value\": \"=Run DAST and a dependency audit against the UAT environment for {{ $node['Webhook Trigger'].json.body.version }}. Output JSON only: {\\\"status\\\": \\\"cleared\\\"|\\\"blocked\\\", \\\"findings\\\": \\\"string\\\"}\", \"type\": \"string\" },\n            { \"id\": \"3\", \"name\": \"story\", \"value\": \"={{ $node['Webhook Trigger'].json.body.version }}\", \"type\": \"string\" }\n          ]\n        }\n      }\n    },\n    {\n      \"id\": \"c597df3c-75f5-4741-b92f-596f81d49fa2\",\n      \"name\": \"Security: UAT Scan\",\n      \"type\": \"n8n-nodes-base.executeWorkflow\",\n      \"typeVersion\": 1.1,\n      \"position\": [1080, 300],\n      \"parameters\": {\n        \"source\": \"database\",\n        \"workflowId\": { \"mode\": \"id\", \"value\": \"jAv16SAzGy9fA5G4\" },\n        \"mode\": \"once\"\n      }\n    },\n    {\n      \"id\": \"67e07137-eaf7-46a6-9824-09911972c3c4\",\n      \"name\": \"Security Cleared?\",\n      \"type\": \"n8n-nodes-base.if\",\n      \"typeVersion\": 2,\n      \"position\": [1300, 300],\n      \"parameters\": {\n        \"conditions\": {\n          \"options\": {\n            \"leftValue\": \"={{ $json.output.includes('\\\"status\\\"') \u0026\u0026 $json.output.includes('\\\"cleared\\\"') }}\",\n            \"operation\": \"equals\",\n            \"rightValue\": \"true\"\n          }\n        }\n      }\n    },\n    {\n      \"id\": \"e62ade73-9f21-46d1-983e-6e7ed652fe43\",\n      \"name\": \"→ F-13 PO UAT\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4.2,\n      \"position\": [1740, 200],\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/uat-po\",\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            { \"name\": \"version\", \"value\": \"={{ $node['Webhook Trigger'].json.body.version }}\" }\n          ]\n        }\n      }\n    },\n    {\n      \"id\": \"eba2e308-8ffe-40e6-8289-22dc2abeea27\",\n      \"name\": \"Notify: Security UAT blocked\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4.2,\n      \"position\": [1520, 400],\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.OPENWEBUI_CALLBACK_URL }}\",\n        \"sendHeaders\": true,\n        \"headerParameters\": {\n          \"parameters\": [{ \"name\": \"Content-Type\", \"value\": \"application/json\" }]\n        },\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            { \"name\": \"flow_id\", \"value\": \"={{ $node['Webhook Trigger'].json.body.flow_id ?? '' }}\" },\n            { \"name\": \"message\", \"value\": \"=🚨 UAT Security blocked — {{ $node['Security: UAT Scan'].json.output }}\" },\n            { \"name\": \"notes\", \"value\": \"\" }\n          ]\n        }\n      }\n    }\n  ],\n  \"connections\": {\n    \"Webhook Trigger\": {\n      \"main\": [[{ \"node\": \"Notify: UAT Security running\", \"type\": \"main\", \"index\": 0 }]]\n    },\n    \"Notify: UAT Security running\": {\n      \"main\": [[{ \"node\": \"Security Input\", \"type\": \"main\", \"index\": 0 }]]\n    },\n    \"Security Input\": {\n      \"main\": [[{ \"node\": \"Security: UAT Scan\", \"type\": \"main\", \"index\": 0 }]]\n    },\n    \"Security: UAT Scan\": {\n      \"main\": [[{ \"node\": \"Security Cleared?\", \"type\": \"main\", \"index\": 0 }]]\n    },\n    \"Security Cleared?\": {\n      \"main\": [\n        [{ \"node\": \"→ F-13 PO UAT\", \"type\": \"main\", \"index\": 0 }],\n        [{ \"node\": \"Notify: Security UAT blocked\", \"type\": \"main\", \"index\": 0 }]\n      ]\n    }\n  },\n  \"active\": true,\n  \"tags\": [],\n  \"settings\": {\n    \"executionOrder\": \"v1\"\n  }\n}\n","F-13-uat-po.json":"{\n  \"name\": \"F-13 UAT PO Stage\",\n  \"nodes\": [\n    {\n      \"id\": \"1d8a6901-e45b-4cb1-b75b-ee1001277fd0\",\n      \"name\": \"Webhook Trigger\",\n      \"type\": \"n8n-nodes-base.webhook\",\n      \"typeVersion\": 2,\n      \"position\": [240, 300],\n      \"parameters\": {\n        \"path\": \"uat-po\",\n        \"httpMethod\": \"POST\",\n        \"responseMode\": \"onReceived\",\n        \"responseData\": \"allEntries\"\n      },\n      \"webhookId\": \"40bc3ed3-4f21-4728-9a24-0a35f3156c7f\"\n    },\n    {\n      \"id\": \"62bdc645-e1d2-428a-9b39-2b1221c85a84\",\n      \"name\": \"Notify: UAT PO review\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4.2,\n      \"position\": [680, 300],\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.OPENWEBUI_CALLBACK_URL }}\",\n        \"sendHeaders\": true,\n        \"headerParameters\": {\n          \"parameters\": [{ \"name\": \"Content-Type\", \"value\": \"application/json\" }]\n        },\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            { \"name\": \"flow_id\", \"value\": \"={{ $json.body?.flow_id ?? $json.flow_id ?? '' }}\" },\n            { \"name\": \"message\", \"value\": \"📦 UAT PO sign-off stage\" },\n            { \"name\": \"notes\", \"value\": \"\" }\n          ]\n        }\n      }\n    },\n    {\n      \"id\": \"b13000001-0000-0000-0000-000000000001\",\n      \"name\": \"PO Input\",\n      \"type\": \"n8n-nodes-base.set\",\n      \"typeVersion\": 3.4,\n      \"position\": [900, 300],\n      \"parameters\": {\n        \"mode\": \"manual\",\n        \"assignments\": {\n          \"assignments\": [\n            { \"id\": \"1\", \"name\": \"role\", \"value\": \"product-owner\", \"type\": \"string\" },\n            { \"id\": \"2\", \"name\": \"prompt\", \"value\": \"=Review the UAT results for {{ $node['Webhook Trigger'].json.body.version }}. Verify all acceptance criteria are met. Output JSON only: {\\\"status\\\": \\\"approved\\\"|\\\"rejected\\\", \\\"notes\\\": \\\"string\\\"}\", \"type\": \"string\" },\n            { \"id\": \"3\", \"name\": \"story\", \"value\": \"={{ $node['Webhook Trigger'].json.body.version }}\", \"type\": \"string\" }\n          ]\n        }\n      }\n    },\n    {\n      \"id\": \"44a34d9c-38a8-4db9-b1da-4548dec02614\",\n      \"name\": \"PO: UAT Acceptance\",\n      \"type\": \"n8n-nodes-base.executeWorkflow\",\n      \"typeVersion\": 1.1,\n      \"position\": [1080, 300],\n      \"parameters\": {\n        \"source\": \"database\",\n        \"workflowId\": { \"mode\": \"id\", \"value\": \"jAv16SAzGy9fA5G4\" },\n        \"mode\": \"once\"\n      }\n    },\n    {\n      \"id\": \"0b98ca9f-5b6c-4acc-aef8-3af92dc4171d\",\n      \"name\": \"PO Approved?\",\n      \"type\": \"n8n-nodes-base.if\",\n      \"typeVersion\": 2,\n      \"position\": [1300, 300],\n      \"parameters\": {\n        \"conditions\": {\n          \"options\": {\n            \"leftValue\": \"={{ $json.output.includes('\\\"status\\\"') \u0026\u0026 $json.output.includes('\\\"approved\\\"') }}\",\n            \"operation\": \"equals\",\n            \"rightValue\": \"true\"\n          }\n        }\n      }\n    },\n    {\n      \"id\": \"b13000002-0000-0000-0000-000000000001\",\n      \"name\": \"RM Input\",\n      \"type\": \"n8n-nodes-base.set\",\n      \"typeVersion\": 3.4,\n      \"position\": [1520, 120],\n      \"parameters\": {\n        \"mode\": \"manual\",\n        \"assignments\": {\n          \"assignments\": [\n            { \"id\": \"1\", \"name\": \"role\", \"value\": \"release-manager\", \"type\": \"string\" },\n            { \"id\": \"2\", \"name\": \"prompt\", \"value\": \"=All 3 UAT sign-offs are now confirmed for {{ $node['Webhook Trigger'].json.body.version }} (QA passed, Security cleared, PO just approved — this chain only reaches here if all three passed in order). Create the release ticket now in Kaneo (`$KANEO_URL`/`$KANEO_TOKEN`/`$KANEO_PROJECT_ID`, `Authorization: Bearer $KANEO_TOKEN` — see AGENTS.md's Ticket \u0026 MR Conventions and release-manager/SKILL.md's Release Ticket Creation section for the exact curl/jq shape, mirror it exactly). Kaneo has one ticket resource (task) — no separate epic/userstory/issue types, so every step below operates on the project's task list directly. Steps: 1) list the stories-in-scope for this release via `GET /api/task/tasks/$KANEO_PROJECT_ID?label={{ $node['Webhook Trigger'].json.body.version }}` (// ponytail: verify the label query param against the deployed Kaneo version). 2) Kaneo tasks carry a plain `status` field, no separate per-type status-id lookup — use whatever this deployment's board calls the 'PO UAT Approved' column (e.g. `po-uat-approved`); this one status now carries all 3 sign-offs at once, replacing GitLab's old three-labels-together convention (the release ticket itself is just a Kaneo task like every other ticket — see release-manager/SKILL.md). 3) `POST /api/task` with title '[release] {{ $node['Webhook Trigger'].json.body.version }}', `projectId` set to $KANEO_PROJECT_ID, `status` set to the PO-UAT-approved value, and a label '{{ $node['Webhook Trigger'].json.body.version }}' for release grouping (// ponytail: verify exact create-task field names against the deployed Kaneo version — Kaneo's label is the closest equivalent to Taiga's release-grouping tags). Description per release-manager/SKILL.md's Release Ticket Creation template (scope/services/rollback/deployment window/staging sign-offs pending/monitoring thresholds/observation window/comms/dependencies) — pull the stories-in-scope list from step 1. If a release ticket for this version already exists (re-run — find it via the same label-filtered task list, filtered client-side by title starting with '[release]'), skip creation and just report its id. Report the release ticket's id.\", \"type\": \"string\" },\n            { \"id\": \"3\", \"name\": \"story\", \"value\": \"={{ $node['Webhook Trigger'].json.body.version }}\", \"type\": \"string\" }\n          ]\n        }\n      }\n    },\n    {\n      \"id\": \"b13000002-0000-0000-0000-000000000002\",\n      \"name\": \"RM: Create Release Ticket\",\n      \"type\": \"n8n-nodes-base.executeWorkflow\",\n      \"typeVersion\": 1.1,\n      \"position\": [1700, 120],\n      \"parameters\": {\n        \"source\": \"database\",\n        \"workflowId\": { \"mode\": \"id\", \"value\": \"jAv16SAzGy9fA5G4\" },\n        \"mode\": \"once\"\n      }\n    },\n    {\n      \"id\": \"e377a389-6e7f-4146-9d8d-170c4522bee7\",\n      \"name\": \"Notify: UAT complete\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4.2,\n      \"position\": [1740, 200],\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.OPENWEBUI_CALLBACK_URL }}\",\n        \"sendHeaders\": true,\n        \"headerParameters\": {\n          \"parameters\": [{ \"name\": \"Content-Type\", \"value\": \"application/json\" }]\n        },\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            { \"name\": \"flow_id\", \"value\": \"={{ $node['Webhook Trigger'].json.body.flow_id ?? '' }}\" },\n            { \"name\": \"message\", \"value\": \"✅ UAT complete — all stages approved. Ready for /release_staging\" },\n            { \"name\": \"notes\", \"value\": \"\" }\n          ]\n        }\n      }\n    },\n    {\n      \"id\": \"d1cac5de-4fed-4046-b992-21e9dce8171b\",\n      \"name\": \"Notify: PO rejected UAT\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4.2,\n      \"position\": [1520, 400],\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.OPENWEBUI_CALLBACK_URL }}\",\n        \"sendHeaders\": true,\n        \"headerParameters\": {\n          \"parameters\": [{ \"name\": \"Content-Type\", \"value\": \"application/json\" }]\n        },\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            { \"name\": \"flow_id\", \"value\": \"={{ $node['Webhook Trigger'].json.body.flow_id ?? '' }}\" },\n            { \"name\": \"message\", \"value\": \"=❌ PO rejected UAT — {{ $node['PO: UAT Acceptance'].json.output }}\" },\n            { \"name\": \"notes\", \"value\": \"\" }\n          ]\n        }\n      }\n    }\n  ],\n  \"connections\": {\n    \"Webhook Trigger\": {\n      \"main\": [[{ \"node\": \"Notify: UAT PO review\", \"type\": \"main\", \"index\": 0 }]]\n    },\n    \"Notify: UAT PO review\": {\n      \"main\": [[{ \"node\": \"PO Input\", \"type\": \"main\", \"index\": 0 }]]\n    },\n    \"PO Input\": {\n      \"main\": [[{ \"node\": \"PO: UAT Acceptance\", \"type\": \"main\", \"index\": 0 }]]\n    },\n    \"PO: UAT Acceptance\": {\n      \"main\": [[{ \"node\": \"PO Approved?\", \"type\": \"main\", \"index\": 0 }]]\n    },\n    \"PO Approved?\": {\n      \"main\": [\n        [{ \"node\": \"RM Input\", \"type\": \"main\", \"index\": 0 }],\n        [{ \"node\": \"Notify: PO rejected UAT\", \"type\": \"main\", \"index\": 0 }]\n      ]\n    },\n    \"RM Input\": {\n      \"main\": [[{ \"node\": \"RM: Create Release Ticket\", \"type\": \"main\", \"index\": 0 }]]\n    },\n    \"RM: Create Release Ticket\": {\n      \"main\": [[{ \"node\": \"Notify: UAT complete\", \"type\": \"main\", \"index\": 0 }]]\n    }\n  },\n  \"active\": true,\n  \"tags\": [],\n  \"settings\": {\n    \"executionOrder\": \"v1\"\n  }\n}\n","F-14-release-staging.json":"{\n  \"name\": \"F-14 /release_staging\",\n  \"nodes\": [\n    {\n      \"id\": \"6be2386d-220c-416d-aa45-ff7597498aa3\",\n      \"name\": \"Webhook Trigger\",\n      \"type\": \"n8n-nodes-base.webhook\",\n      \"typeVersion\": 2,\n      \"position\": [\n        240,\n        300\n      ],\n      \"parameters\": {\n        \"path\": \"release-staging\",\n        \"httpMethod\": \"POST\",\n        \"responseMode\": \"onReceived\",\n        \"responseData\": \"allEntries\"\n      },\n      \"webhookId\": \"a4252b67-7ea8-4bfd-8894-e613a7b3c86c\"\n    },\n    {\n      \"id\": \"574de774-cf51-4be9-ad69-eedf5b6c17ce\",\n      \"name\": \"Find Release Ticket\",\n      \"type\": \"n8n-nodes-base.code\",\n      \"typeVersion\": 2,\n      \"position\": [\n        680,\n        300\n      ],\n      \"parameters\": {\n        \"jsCode\": \"// ponytail: label query param is the closest Kaneo equivalent to Taiga's\\n// release-grouping tags -- verify against the deployed Kaneo version.\\nconst kaneoAuth = { Authorization: `Bearer ${$env.KANEO_TOKEN}` };\\nconst tasks = await this.helpers.httpRequest({ method: 'GET', url: `${$env.KANEO_URL}/api/task/tasks/${$env.KANEO_PROJECT_ID}`, qs: { label: $env.RELEASE_VERSION }, headers: kaneoAuth, json: true });\\nconst ticket = tasks.find(t =\u003e t.title.startsWith('[release]')) || null;\\n// Ticket only exists once all 3 UAT sign-offs landed (F-13 creates it with\\n// status \\\"PO UAT Approved\\\" at creation) — existence alone is the safeguard,\\n// no need to re-check the status.\\nreturn [{ json: { ...$json, found: !!ticket, release_ticket_id: ticket ? ticket.id : null } }];\"\n      }\n    },\n    {\n      \"id\": \"94b7463d-558e-4d36-b9d0-4ebd90fda8a3\",\n      \"name\": \"Found?\",\n      \"type\": \"n8n-nodes-base.if\",\n      \"typeVersion\": 2,\n      \"position\": [\n        900,\n        300\n      ],\n      \"parameters\": {\n        \"conditions\": {\n          \"options\": {\n            \"leftValue\": \"={{ $json.found }}\",\n            \"operation\": \"equals\",\n            \"rightValue\": \"true\"\n          }\n        }\n      }\n    },\n    {\n      \"id\": \"2759c45d-c7cc-4400-86b1-b888794704b3\",\n      \"name\": \"Notify: Staging blocked\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4.2,\n      \"position\": [\n        1120,\n        400\n      ],\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.OPENWEBUI_CALLBACK_URL }}\",\n        \"sendHeaders\": true,\n        \"headerParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"Content-Type\",\n              \"value\": \"application/json\"\n            }\n          ]\n        },\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"flow_id\",\n              \"value\": \"={{ $json.body?.flow_id ?? $json.flow_id ?? '' }}\"\n            },\n            {\n              \"name\": \"message\",\n              \"value\": \"🚫 /release_staging blocked — UAT labels missing on release ticket\"\n            },\n            {\n              \"name\": \"notes\",\n              \"value\": \"\"\n            }\n          ]\n        }\n      }\n    },\n    {\n      \"id\": \"ff579f3b-661a-417b-9ffe-bb6608d5d5cb\",\n      \"name\": \"Create promote/ branch\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4.2,\n      \"position\": [\n        1340,\n        200\n      ],\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.GITLAB_URL }}/api/v4/projects/{{ $node['Webhook Trigger'].json.body.gitlab_project_id ?? $env.GITLAB_PROJECT_ID }}/repository/branches\",\n        \"authentication\": \"genericCredentialType\",\n        \"genericAuthType\": \"httpHeaderAuth\",\n        \"sendHeaders\": true,\n        \"headerParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"PRIVATE-TOKEN\",\n              \"value\": \"={{ $env.GITLAB_TOKEN }}\"\n            },\n            {\n              \"name\": \"Content-Type\",\n              \"value\": \"application/json\"\n            }\n          ]\n        },\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"__json\",\n              \"value\": \"={\\\"branch\\\":\\\"promote/{{ $env.RELEASE_VERSION }}\\\",\\\"ref\\\":\\\"release/{{ $env.RELEASE_VERSION }}\\\"}\"\n            }\n          ]\n        }\n      }\n    },\n    {\n      \"id\": \"5ffa83c3-ccf7-4d5f-b669-012b5aac7f72\",\n      \"name\": \"Notify: Staging CI triggered\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4.2,\n      \"position\": [\n        1560,\n        200\n      ],\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.OPENWEBUI_CALLBACK_URL }}\",\n        \"sendHeaders\": true,\n        \"headerParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"Content-Type\",\n              \"value\": \"application/json\"\n            }\n          ]\n        },\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"flow_id\",\n              \"value\": \"={{ $json.body?.flow_id ?? $json.flow_id ?? '' }}\"\n            },\n            {\n              \"name\": \"message\",\n              \"value\": \"🚀 promote/ branch created — promotion CI triggered\"\n            },\n            {\n              \"name\": \"notes\",\n              \"value\": \"\"\n            }\n          ]\n        }\n      }\n    }\n  ],\n  \"connections\": {\n    \"Webhook Trigger\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Find Release Ticket\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Find Release Ticket\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Found?\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Found?\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Create promote/ branch\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ],\n        [\n          {\n            \"node\": \"Notify: Staging blocked\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Create promote/ branch\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Notify: Staging CI triggered\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    }\n  },\n  \"active\": true,\n  \"tags\": [],\n  \"settings\": {\n    \"executionOrder\": \"v1\"\n  }\n}\n","F-15-staging-deployed.json":"{\n  \"name\": \"F-15 Staging Deployed\",\n  \"nodes\": [\n    {\n      \"id\": \"554ea05d-2cf1-494d-a971-be89d557c8e9\",\n      \"name\": \"Webhook Trigger\",\n      \"type\": \"n8n-nodes-base.webhook\",\n      \"typeVersion\": 2,\n      \"position\": [\n        240,\n        300\n      ],\n      \"parameters\": {\n        \"path\": \"staging-deployed\",\n        \"httpMethod\": \"POST\",\n        \"responseMode\": \"onReceived\",\n        \"responseData\": \"allEntries\"\n      },\n      \"webhookId\": \"0551be02-7279-4189-b7d2-adb2392094d9\"\n    },\n    {\n      \"id\": \"0227f7d2-760f-4aba-84df-cd0fda58f870\",\n      \"name\": \"Notify: Staging up\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4.2,\n      \"position\": [\n        680,\n        300\n      ],\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.OPENWEBUI_CALLBACK_URL }}\",\n        \"sendHeaders\": true,\n        \"headerParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"Content-Type\",\n              \"value\": \"application/json\"\n            }\n          ]\n        },\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"flow_id\",\n              \"value\": \"={{ $json.body?.flow_id ?? $json.flow_id ?? '' }}\"\n            },\n            {\n              \"name\": \"message\",\n              \"value\": \"🚀 Staging deployed — k6 + ZAP parallel\"\n            },\n            {\n              \"name\": \"notes\",\n              \"value\": \"\"\n            }\n          ]\n        }\n      }\n    },\n    {\n      \"id\": \"c3a8c289-761d-467d-8990-5bff750ac79f\",\n      \"name\": \"QA: k6 Load Test\",\n      \"type\": \"n8n-nodes-base.executeCommand\",\n      \"typeVersion\": 1,\n      \"position\": [\n        900,\n        200\n      ],\n      \"parameters\": {\n        \"command\": \"omp --role qa-engineer --model smol --project {{ $env.REPO_DIR }} --prompt 'Run k6 load test suite against UAT for {{ $json.body.version }} — the full-version image just promoted there (no separate staging cluster). Output: p95 latency, error rate, pass/fail.' --non-interactive\"\n      }\n    },\n    {\n      \"id\": \"d1b2ff7f-47bb-4554-8e6c-dc4d7cede9c6\",\n      \"name\": \"Security: ZAP DAST\",\n      \"type\": \"n8n-nodes-base.executeCommand\",\n      \"typeVersion\": 1,\n      \"position\": [\n        900,\n        400\n      ],\n      \"parameters\": {\n        \"command\": \"omp --role security-engineer --model smol --project {{ $env.REPO_DIR }} --prompt 'Run OWASP ZAP DAST scan against UAT for {{ $json.body.version }} — the full-version image just promoted there (no separate staging cluster). Output: critical/high findings list.' --non-interactive\"\n      }\n    },\n    {\n      \"id\": \"3d3b1485-fae6-4ed9-a1c6-eebad98c4db1\",\n      \"name\": \"Merge QA+Sec\",\n      \"type\": \"n8n-nodes-base.merge\",\n      \"typeVersion\": 3,\n      \"position\": [\n        1120,\n        300\n      ],\n      \"parameters\": {\n        \"mode\": \"combine\",\n        \"combineBy\": \"combineByPosition\",\n        \"numberInputs\": 2\n      }\n    },\n    {\n      \"id\": \"71dc2e21-be43-45b6-9d8f-482ab7074ee7\",\n      \"name\": \"Notify: Tests done, RM deciding\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4.2,\n      \"position\": [\n        1340,\n        300\n      ],\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.OPENWEBUI_CALLBACK_URL }}\",\n        \"sendHeaders\": true,\n        \"headerParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"Content-Type\",\n              \"value\": \"application/json\"\n            }\n          ]\n        },\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"flow_id\",\n              \"value\": \"={{ $json.body?.flow_id ?? $json.flow_id ?? '' }}\"\n            },\n            {\n              \"name\": \"message\",\n              \"value\": \"📊 Load + DAST done — RM evaluating go/no-go\"\n            },\n            {\n              \"name\": \"notes\",\n              \"value\": \"\"\n            }\n          ]\n        }\n      }\n    },\n    {\n      \"id\": \"87b68cc1-0f96-4b80-86b5-8ed7f3acf01f\",\n      \"name\": \"→ F-16 Go/No-Go\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4.2,\n      \"position\": [\n        1560,\n        300\n      ],\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/go-nogo\",\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"version\",\n              \"value\": \"={{ $json.body.version }}\"\n            },\n            {\n              \"name\": \"k6_result\",\n              \"value\": \"={{ $node['QA: k6 Load Test'].json.stdout }}\"\n            },\n            {\n              \"name\": \"zap_result\",\n              \"value\": \"={{ $node['Security: ZAP DAST'].json.stdout }}\"\n            }\n          ]\n        }\n      }\n    }\n  ],\n  \"connections\": {\n    \"Webhook Trigger\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Notify: Staging up\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Notify: Staging up\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"QA: k6 Load Test\",\n            \"type\": \"main\",\n            \"index\": 0\n          },\n          {\n            \"node\": \"Security: ZAP DAST\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"QA: k6 Load Test\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Merge QA+Sec\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Security: ZAP DAST\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Merge QA+Sec\",\n            \"type\": \"main\",\n            \"index\": 1\n          }\n        ]\n      ]\n    },\n    \"Merge QA+Sec\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Notify: Tests done, RM deciding\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Notify: Tests done, RM deciding\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"→ F-16 Go/No-Go\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    }\n  },\n  \"active\": true,\n  \"tags\": [],\n  \"settings\": {\n    \"executionOrder\": \"v1\"\n  }\n}","F-16-go-nogo.json":"{\n  \"name\": \"F-16 Go/No-Go\",\n  \"nodes\": [\n    {\n      \"id\": \"fef63188-40c7-4a14-a411-0aad71b25dce\",\n      \"name\": \"Webhook Trigger\",\n      \"type\": \"n8n-nodes-base.webhook\",\n      \"typeVersion\": 2,\n      \"position\": [\n        240,\n        300\n      ],\n      \"parameters\": {\n        \"path\": \"go-nogo\",\n        \"httpMethod\": \"POST\",\n        \"responseMode\": \"onReceived\",\n        \"responseData\": \"allEntries\"\n      },\n      \"webhookId\": \"29d43455-5a2c-487c-8985-91a20aa4edb3\"\n    },\n    {\n      \"id\": \"b16000001-0000-0000-0000-000000000001\",\n      \"name\": \"Find Release Ticket\",\n      \"type\": \"n8n-nodes-base.code\",\n      \"typeVersion\": 2,\n      \"position\": [\n        460,\n        300\n      ],\n      \"parameters\": {\n        \"jsCode\": \"// ponytail: label query param is the closest Kaneo equivalent to Taiga's\\n// release-grouping tags -- verify against the deployed Kaneo version.\\nconst auth = { Authorization: `Bearer ${$env.KANEO_TOKEN}` };\\nconst res = await this.helpers.httpRequest({ method: 'GET', url: `${$env.KANEO_URL}/api/task/tasks/${$env.KANEO_PROJECT_ID}`, qs: { label: $env.RELEASE_VERSION }, headers: auth, json: true });\\nconst ticket = (res || []).find(t =\u003e (t.title || '').startsWith('[release]'));\\nif (!ticket) throw new Error(`No release ticket found for ${$env.RELEASE_VERSION} — UAT sign-off must complete before go/no-go runs`);\\nreturn [{ json: { ...$json, release_ticket_id: ticket.id } }];\"\n      }\n    },\n    {\n      \"id\": \"e1c93f14-a8c2-465a-975a-4387f7790798\",\n      \"name\": \"RM: Go/No-Go Decision\",\n      \"type\": \"n8n-nodes-base.executeCommand\",\n      \"typeVersion\": 1,\n      \"position\": [\n        680,\n        300\n      ],\n      \"parameters\": {\n        \"command\": \"omp --role release-manager --model default --project {{ $env.REPO_DIR }} --prompt 'Evaluate k6 and ZAP results for {{ $json.body.version }}. Apply release criteria thresholds. Output JSON: {decision: GO|NO-GO, reason: string, options: [...]}' --non-interactive\"\n      }\n    },\n    {\n      \"id\": \"33f03cb9-dccf-499d-b346-6e6c074bbd1e\",\n      \"name\": \"GO?\",\n      \"type\": \"n8n-nodes-base.if\",\n      \"typeVersion\": 2,\n      \"position\": [\n        900,\n        300\n      ],\n      \"parameters\": {\n        \"conditions\": {\n          \"options\": {\n            \"leftValue\": \"={{ JSON.parse($json.stdout).decision }}\",\n            \"operation\": \"equals\",\n            \"rightValue\": \"GO\"\n          }\n        }\n      }\n    },\n    {\n      \"id\": \"7a44622a-d6c8-4a4f-8b10-23a776c9a275\",\n      \"name\": \"Set RM Go Status\",\n      \"type\": \"n8n-nodes-base.code\",\n      \"typeVersion\": 2,\n      \"position\": [\n        1120,\n        200\n      ],\n      \"parameters\": {\n        \"jsCode\": \"// ponytail: Kaneo task has a plain status field, no separate status-id\\n// lookup, and no combined status+comment PATCH -- two calls instead of one.\\n// Verify both the status value and comment path against the deployed Kaneo version.\\nconst auth = { Authorization: `Bearer ${$env.KANEO_TOKEN}` };\\nconst id = $node['Find Release Ticket'].json.release_ticket_id;\\nawait this.helpers.httpRequest({ method: 'PATCH', url: `${$env.KANEO_URL}/api/task/${id}`, headers: { ...auth, 'Content-Type': 'application/json' }, body: { status: 'rm-go' }, json: true });\\nawait this.helpers.httpRequest({ method: 'POST', url: `${$env.KANEO_URL}/api/task/${id}/comment`, headers: { ...auth, 'Content-Type': 'application/json' }, body: { content: 'GO decision — cleared for /release_production.' }, json: true });\\nreturn [{ json: $json }];\"\n      }\n    },\n    {\n      \"id\": \"301ba7b5-f5f8-43fa-ac96-df8a4e380f5f\",\n      \"name\": \"Notify: GO\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4.2,\n      \"position\": [\n        1340,\n        200\n      ],\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.OPENWEBUI_CALLBACK_URL }}\",\n        \"sendHeaders\": true,\n        \"headerParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"Content-Type\",\n              \"value\": \"application/json\"\n            }\n          ]\n        },\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"flow_id\",\n              \"value\": \"={{ $json.body?.flow_id ?? $json.flow_id ?? '' }}\"\n            },\n            {\n              \"name\": \"message\",\n              \"value\": \"✅ GO — {{ $env.RELEASE_VERSION }} cleared for /release_production\"\n            },\n            {\n              \"name\": \"notes\",\n              \"value\": \"\"\n            }\n          ]\n        }\n      }\n    },\n    {\n      \"id\": \"b9f6e564-bf48-4afd-baf6-2113f9d9445e\",\n      \"name\": \"Notify: NO-GO options\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4.2,\n      \"position\": [\n        1120,\n        400\n      ],\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.OPENWEBUI_CALLBACK_URL }}\",\n        \"sendHeaders\": true,\n        \"headerParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"Content-Type\",\n              \"value\": \"application/json\"\n            }\n          ]\n        },\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"flow_id\",\n              \"value\": \"={{ $json.body?.flow_id ?? $json.flow_id ?? '' }}\"\n            },\n            {\n              \"name\": \"message\",\n              \"value\": \"🚨 NO-GO — {{ $env.RELEASE_VERSION }} blocked. Options: 1) fix \u0026 re-stage 2) rollback story 3) defer release. Details: {{ JSON.parse($json.stdout).reason }}\"\n            },\n            {\n              \"name\": \"notes\",\n              \"value\": \"\"\n            }\n          ]\n        }\n      }\n    }\n  ],\n  \"connections\": {\n    \"Webhook Trigger\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Find Release Ticket\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Find Release Ticket\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"RM: Go/No-Go Decision\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"RM: Go/No-Go Decision\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"GO?\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"GO?\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Set RM Go Status\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ],\n        [\n          {\n            \"node\": \"Notify: NO-GO options\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Set RM Go Status\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Notify: GO\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    }\n  },\n  \"active\": true,\n  \"tags\": [],\n  \"settings\": {\n    \"executionOrder\": \"v1\"\n  }\n}\n","F-17-release-production.json":"{\n  \"name\": \"F-17 /release_production\",\n  \"nodes\": [\n    {\n      \"id\": \"487cf1ce-c9d6-47c3-b053-558ffc6efc20\",\n      \"name\": \"Webhook Trigger\",\n      \"type\": \"n8n-nodes-base.webhook\",\n      \"typeVersion\": 2,\n      \"position\": [\n        240,\n        300\n      ],\n      \"parameters\": {\n        \"path\": \"release-production\",\n        \"httpMethod\": \"POST\",\n        \"responseMode\": \"onReceived\",\n        \"responseData\": \"allEntries\"\n      },\n      \"webhookId\": \"3581e892-b9f9-4646-ac5a-c20a793c77f1\"\n    },\n    {\n      \"id\": \"40bb0ef7-c057-436b-b123-c9de5c9d2271\",\n      \"name\": \"Find Release Ticket\",\n      \"type\": \"n8n-nodes-base.code\",\n      \"typeVersion\": 2,\n      \"position\": [\n        680,\n        300\n      ],\n      \"parameters\": {\n        \"jsCode\": \"// ponytail: label query param is the closest Kaneo equivalent to Taiga's\\n// release-grouping tags, and Kaneo's task.status is a plain string (no\\n// status_extra_info indirection) -- verify both against the deployed Kaneo version.\\nconst kaneoAuth = { Authorization: `Bearer ${$env.KANEO_TOKEN}` };\\nconst tasks = await this.helpers.httpRequest({ method: 'GET', url: `${$env.KANEO_URL}/api/task/tasks/${$env.KANEO_PROJECT_ID}`, qs: { label: $env.RELEASE_VERSION }, headers: kaneoAuth, json: true });\\nconst ticket = tasks.find(t =\u003e t.title.startsWith('[release]')) || null;\\nreturn [{ json: { ...$json, rm_go: !!ticket \u0026\u0026 ticket.status === 'rm-go', release_ticket_id: ticket ? ticket.id : null } }];\"\n      }\n    },\n    {\n      \"id\": \"457bfee4-1b22-4ab0-b34a-b6f18184f771\",\n      \"name\": \"rm:go label present?\",\n      \"type\": \"n8n-nodes-base.if\",\n      \"typeVersion\": 2,\n      \"position\": [\n        900,\n        300\n      ],\n      \"parameters\": {\n        \"conditions\": {\n          \"options\": {\n            \"leftValue\": \"={{ $json.rm_go }}\",\n            \"operation\": \"equals\",\n            \"rightValue\": \"true\"\n          }\n        }\n      }\n    },\n    {\n      \"id\": \"3e5da2ec-23b6-4643-8d13-fa95a32f1c7f\",\n      \"name\": \"Notify: Production blocked\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4.2,\n      \"position\": [\n        1120,\n        400\n      ],\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.OPENWEBUI_CALLBACK_URL }}\",\n        \"sendHeaders\": true,\n        \"headerParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"Content-Type\",\n              \"value\": \"application/json\"\n            }\n          ]\n        },\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"flow_id\",\n              \"value\": \"={{ $json.body?.flow_id ?? $json.flow_id ?? '' }}\"\n            },\n            {\n              \"name\": \"message\",\n              \"value\": \"🚫 /release_production blocked — release ticket not at RM Go status\"\n            },\n            {\n              \"name\": \"notes\",\n              \"value\": \"\"\n            }\n          ]\n        }\n      }\n    },\n    {\n      \"id\": \"f17000001-0000-0000-0000-000000000001\",\n      \"name\": \"Find Edward's User ID\",\n      \"type\": \"n8n-nodes-base.code\",\n      \"typeVersion\": 2,\n      \"position\": [\n        980,\n        200\n      ],\n      \"parameters\": {\n        \"jsCode\": \"const res = await this.helpers.httpRequest({ method: 'GET', url: `${$env.GITLAB_URL}/api/v4/users?search=edwardlimkoksiong1994@gmail.com`, headers: { 'PRIVATE-TOKEN': $env.GITLAB_TOKEN }, json: true });\\nconst user = Array.isArray(res) ? res[0] : null;\\nreturn [{ json: { ...$json, edward_user_id: user ? user.id : null } }];\"\n      }\n    },\n    {\n      \"id\": \"0b27e754-868c-4d20-8a5a-147072921e7f\",\n      \"name\": \"Create promote→main MR\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4.2,\n      \"position\": [\n        1120,\n        200\n      ],\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.GITLAB_URL }}/api/v4/projects/{{ $node['Webhook Trigger'].json.body.gitlab_project_id ?? $env.GITLAB_PROJECT_ID }}/merge_requests\",\n        \"authentication\": \"genericCredentialType\",\n        \"genericAuthType\": \"httpHeaderAuth\",\n        \"sendHeaders\": true,\n        \"headerParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"PRIVATE-TOKEN\",\n              \"value\": \"={{ $env.GITLAB_TOKEN }}\"\n            },\n            {\n              \"name\": \"Content-Type\",\n              \"value\": \"application/json\"\n            }\n          ]\n        },\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"__json\",\n              \"value\": \"={\\\"source_branch\\\":\\\"promote/{{ $env.RELEASE_VERSION }}\\\",\\\"target_branch\\\":\\\"main\\\",\\\"title\\\":\\\"[release] {{ $env.RELEASE_VERSION }}\\\",\\\"description\\\":\\\"## Ticket\\\\n{{ $env.KANEO_URL }}/task/{{ $node[\\\"Find Release Ticket\\\"].json.release_ticket_id }}\\\\n\\\\n## What's done\\\\nAll UAT + staging sign-offs passed (QA UAT Approved, Security Cleared, PO UAT Approved, Staging QA Passed, Staging Security Passed, RM Go — tracked as the release ticket's Kaneo status, not GitLab labels). Promotes rc images to full version v{{ $env.RELEASE_VERSION }} by retag, no rebuild.\\\\n\\\\n## Proof of success\\\\nSee release ticket for k6/ZAP staging confirmation reports and go/no-go assessment.\\\\n\\\\n## Potential risk\\\\nSee release ticket's rollback target and monitoring thresholds.\\\",\\\"labels\\\":\\\"type:release\\\",\\\"assignee_id\\\":{{ $node[\\\"Find Edward's User ID\\\"].json.edward_user_id }},\\\"reviewer_ids\\\":[{{ $node[\\\"Find Edward's User ID\\\"].json.edward_user_id }}]}\"\n            }\n          ]\n        }\n      }\n    },\n    {\n      \"id\": \"ba4b70d7-09f3-40cc-bc27-a788cfc5ea07\",\n      \"name\": \"Notify: Production MR ready\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4.2,\n      \"position\": [\n        1340,\n        200\n      ],\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.OPENWEBUI_CALLBACK_URL }}\",\n        \"sendHeaders\": true,\n        \"headerParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"Content-Type\",\n              \"value\": \"application/json\"\n            }\n          ]\n        },\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"flow_id\",\n              \"value\": \"={{ $json.body?.flow_id ?? $json.flow_id ?? '' }}\"\n            },\n            {\n              \"name\": \"message\",\n              \"value\": \"👤 Release MR ready — Edward please review and merge promote/{{ $env.RELEASE_VERSION }} → main\"\n            },\n            {\n              \"name\": \"notes\",\n              \"value\": \"\"\n            }\n          ]\n        }\n      }\n    }\n  ],\n  \"connections\": {\n    \"Webhook Trigger\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Find Release Ticket\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Find Release Ticket\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"rm:go label present?\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"rm:go label present?\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Find Edward's User ID\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ],\n        [\n          {\n            \"node\": \"Notify: Production blocked\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Find Edward's User ID\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Create promote→main MR\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Create promote→main MR\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Notify: Production MR ready\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    }\n  },\n  \"active\": true,\n  \"tags\": [],\n  \"settings\": {\n    \"executionOrder\": \"v1\"\n  }\n}\n","F-18-release-mr-merged.json":"{\n  \"name\": \"F-18 Release MR Merged\",\n  \"nodes\": [\n    {\n      \"id\": \"e7dc2439-1c80-454e-9db2-eabb17349a26\",\n      \"name\": \"Webhook Trigger\",\n      \"type\": \"n8n-nodes-base.webhook\",\n      \"typeVersion\": 2,\n      \"position\": [\n        240,\n        300\n      ],\n      \"parameters\": {\n        \"path\": \"gitlab-release-mr-merged\",\n        \"httpMethod\": \"POST\",\n        \"responseMode\": \"onReceived\",\n        \"responseData\": \"allEntries\"\n      },\n      \"webhookId\": \"7db0f826-0f31-4fec-8227-f03aebf9f7fb\"\n    },\n    {\n      \"id\": \"11e4784a-ee4d-4c7e-873f-0a0ba9b37443\",\n      \"name\": \"Notify: Release MR merged\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4.2,\n      \"position\": [\n        680,\n        300\n      ],\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.OPENWEBUI_CALLBACK_URL }}\",\n        \"sendHeaders\": true,\n        \"headerParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"Content-Type\",\n              \"value\": \"application/json\"\n            }\n          ]\n        },\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"flow_id\",\n              \"value\": \"={{ $json.body?.flow_id ?? $json.flow_id ?? '' }}\"\n            },\n            {\n              \"name\": \"message\",\n              \"value\": \"🎯 Release MR merged — deploying full-version images to production (no rebuild, retagged image already in the registry)\"\n            },\n            {\n              \"name\": \"notes\",\n              \"value\": \"\"\n            }\n          ]\n        }\n      }\n    },\n    {\n      \"id\": \"f18000001-0000-0000-0000-000000000001\",\n      \"name\": \"DevOps Input\",\n      \"type\": \"n8n-nodes-base.set\",\n      \"typeVersion\": 3.4,\n      \"position\": [\n        900,\n        300\n      ],\n      \"parameters\": {\n        \"mode\": \"manual\",\n        \"assignments\": {\n          \"assignments\": [\n            {\n              \"id\": \"1\",\n              \"name\": \"role\",\n              \"value\": \"devops-engineer\",\n              \"type\": \"string\"\n            },\n            {\n              \"id\": \"2\",\n              \"name\": \"prompt\",\n              \"value\": \"=Deploy release {{ $env.RELEASE_VERSION }} to production — no rebuild, the full-version image was already retagged and pushed during promotion, and already redeployed to UAT for staging checks. For every service under env/uat/*, read its current image tag from env/uat/{service}/values.yaml, and write that same tag into env/production/{service}/values.yaml on main (create the file if this is the service's first production deploy — copy the shape of an existing env/production/*/values.yaml, or env/uat/*/values.yaml if none exists yet). Commit all edited files in one commit ('chore: deploy {{ $env.RELEASE_VERSION }} to production') and push to main — ArgoCD's automated syncPolicy on each production Application picks it up from there (no image-updater on production, explicit sync only, same as UAT). Then wait for each service's production Deployment rollout to complete (kubectl --context $PRODUCTION_CLUSTER_CONTEXT rollout status deployment/\u003cservice\u003e -n hr-portal --timeout=120s) before reporting done — do not report success until rollout is actually confirmed, not just committed.\",\n              \"type\": \"string\"\n            },\n            {\n              \"id\": \"3\",\n              \"name\": \"story\",\n              \"value\": \"={{ $env.RELEASE_VERSION }}\",\n              \"type\": \"string\"\n            }\n          ]\n        }\n      }\n    },\n    {\n      \"id\": \"f18000001-0000-0000-0000-000000000002\",\n      \"name\": \"DevOps: Deploy Production\",\n      \"type\": \"n8n-nodes-base.executeWorkflow\",\n      \"typeVersion\": 1.1,\n      \"position\": [\n        1120,\n        300\n      ],\n      \"parameters\": {\n        \"source\": \"database\",\n        \"workflowId\": {\n          \"mode\": \"id\",\n          \"value\": \"jAv16SAzGy9fA5G4\"\n        },\n        \"mode\": \"once\"\n      }\n    },\n    {\n      \"id\": \"f18000001-0000-0000-0000-000000000003\",\n      \"name\": \"→ F-19 Production Deployed\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4.2,\n      \"position\": [\n        1340,\n        300\n      ],\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/production-deployed\",\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"version\",\n              \"value\": \"={{ $env.RELEASE_VERSION }}\"\n            }\n          ]\n        }\n      }\n    }\n  ],\n  \"connections\": {\n    \"Webhook Trigger\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Notify: Release MR merged\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Notify: Release MR merged\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"DevOps Input\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"DevOps Input\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"DevOps: Deploy Production\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"DevOps: Deploy Production\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"→ F-19 Production Deployed\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    }\n  },\n  \"active\": true,\n  \"tags\": [],\n  \"settings\": {\n    \"executionOrder\": \"v1\"\n  }\n}\n","F-19-production-deployed.json":"{\n  \"name\": \"F-19 Production Deployed\",\n  \"nodes\": [\n    {\n      \"id\": \"f732978e-2db5-4b01-9094-cad52864492e\",\n      \"name\": \"Webhook Trigger\",\n      \"type\": \"n8n-nodes-base.webhook\",\n      \"typeVersion\": 2,\n      \"position\": [\n        240,\n        300\n      ],\n      \"parameters\": {\n        \"path\": \"production-deployed\",\n        \"httpMethod\": \"POST\",\n        \"responseMode\": \"onReceived\",\n        \"responseData\": \"allEntries\"\n      },\n      \"webhookId\": \"f2d74deb-a248-48d0-97b8-f93be9a5ade4\"\n    },\n    {\n      \"id\": \"cff4c956-5c06-4912-82ba-b8f42ee1eddf\",\n      \"name\": \"Notify: Production deployed\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4.2,\n      \"position\": [\n        680,\n        300\n      ],\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.OPENWEBUI_CALLBACK_URL }}\",\n        \"sendHeaders\": true,\n        \"headerParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"Content-Type\",\n              \"value\": \"application/json\"\n            }\n          ]\n        },\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"flow_id\",\n              \"value\": \"={{ $json.body?.flow_id ?? $json.flow_id ?? '' }}\"\n            },\n            {\n              \"name\": \"message\",\n              \"value\": \"🚀 Production deployed — running smoke tests\"\n            },\n            {\n              \"name\": \"notes\",\n              \"value\": \"\"\n            }\n          ]\n        }\n      }\n    },\n    {\n      \"id\": \"3f72ac1b-b047-4e0e-8fd7-d8fb5a316ce4\",\n      \"name\": \"RM: Smoke Tests\",\n      \"type\": \"n8n-nodes-base.executeCommand\",\n      \"typeVersion\": 1,\n      \"position\": [\n        900,\n        300\n      ],\n      \"parameters\": {\n        \"command\": \"omp --role release-manager --model default --project {{ $env.REPO_DIR }} --prompt 'Run smoke test suite against production for {{ $json.body.version }}. Output: pass/fail + key metrics.' --non-interactive\"\n      }\n    },\n    {\n      \"id\": \"b9d92087-de88-4598-9823-93d378b07284\",\n      \"name\": \"Smoke Pass?\",\n      \"type\": \"n8n-nodes-base.if\",\n      \"typeVersion\": 2,\n      \"position\": [\n        1120,\n        300\n      ],\n      \"parameters\": {\n        \"conditions\": {\n          \"options\": {\n            \"leftValue\": \"={{ JSON.parse($json.stdout).pass }}\",\n            \"operation\": \"equals\",\n            \"rightValue\": \"true\"\n          }\n        }\n      }\n    },\n    {\n      \"id\": \"ab88ce6a-cb54-4cc5-b95f-7d90685804fe\",\n      \"name\": \"→ F-20 Monitoring\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4.2,\n      \"position\": [\n        1340,\n        200\n      ],\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/monitoring-window\",\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"version\",\n              \"value\": \"={{ $json.body.version }}\"\n            }\n          ]\n        }\n      }\n    },\n    {\n      \"id\": \"33dff7c1-a45e-4baf-a08d-389062ef0b5d\",\n      \"name\": \"Notify: Smoke failed — escalating\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4.2,\n      \"position\": [\n        1340,\n        400\n      ],\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.OPENWEBUI_CALLBACK_URL }}\",\n        \"sendHeaders\": true,\n        \"headerParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"Content-Type\",\n              \"value\": \"application/json\"\n            }\n          ]\n        },\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"flow_id\",\n              \"value\": \"={{ $json.body?.flow_id ?? $json.flow_id ?? '' }}\"\n            },\n            {\n              \"name\": \"message\",\n              \"value\": \"🚨 Smoke tests FAILED on production — escalating immediately\"\n            },\n            {\n              \"name\": \"notes\",\n              \"value\": \"\"\n            }\n          ]\n        }\n      }\n    },\n    {\n      \"id\": \"968aac0b-40f9-4ae6-adaf-b47ec455be75\",\n      \"name\": \"→ Escalate\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4.2,\n      \"position\": [\n        1560,\n        400\n      ],\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/escalate\",\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"reason\",\n              \"value\": \"Production smoke tests failed for {{ $json.body.version }}\"\n            }\n          ]\n        }\n      }\n    }\n  ],\n  \"connections\": {\n    \"Webhook Trigger\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Notify: Production deployed\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Notify: Production deployed\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"RM: Smoke Tests\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"RM: Smoke Tests\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Smoke Pass?\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Smoke Pass?\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"→ F-20 Monitoring\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ],\n        [\n          {\n            \"node\": \"Notify: Smoke failed — escalating\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Notify: Smoke failed — escalating\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"→ Escalate\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    }\n  },\n  \"active\": true,\n  \"tags\": [],\n  \"settings\": {\n    \"executionOrder\": \"v1\"\n  }\n}\n","F-20-monitoring-window.json":"{\n  \"name\": \"F-20 Monitoring Window\",\n  \"nodes\": [\n    {\n      \"id\": \"db6dd6c8-77ef-44e2-95d5-50b767b747c2\",\n      \"name\": \"Webhook Trigger\",\n      \"type\": \"n8n-nodes-base.webhook\",\n      \"typeVersion\": 2,\n      \"position\": [\n        240,\n        300\n      ],\n      \"parameters\": {\n        \"path\": \"monitoring-window\",\n        \"httpMethod\": \"POST\",\n        \"responseMode\": \"onReceived\",\n        \"responseData\": \"allEntries\"\n      },\n      \"webhookId\": \"cf9059c5-1dae-409b-b3e0-650168406fce\"\n    },\n    {\n      \"id\": \"a35ccb4d-33f5-476c-ae0a-874ee366d5ba\",\n      \"name\": \"Notify: Monitoring window open\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4.2,\n      \"position\": [\n        680,\n        300\n      ],\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.OPENWEBUI_CALLBACK_URL }}\",\n        \"sendHeaders\": true,\n        \"headerParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"Content-Type\",\n              \"value\": \"application/json\"\n            }\n          ]\n        },\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"flow_id\",\n              \"value\": \"={{ $json.body?.flow_id ?? $json.flow_id ?? '' }}\"\n            },\n            {\n              \"name\": \"message\",\n              \"value\": \"=🔭 Monitoring window open for {{ $json.body.version }} — 30 min\"\n            },\n            {\n              \"name\": \"notes\",\n              \"value\": \"\"\n            }\n          ]\n        }\n      }\n    },\n    {\n      \"id\": \"8704c10e-889a-433d-a3aa-d81992f0ac4e\",\n      \"name\": \"Wait 30 min\",\n      \"type\": \"n8n-nodes-base.wait\",\n      \"typeVersion\": 1,\n      \"position\": [\n        900,\n        300\n      ],\n      \"parameters\": {\n        \"resume\": \"timeInterval\",\n        \"unit\": \"minutes\",\n        \"value\": 30\n      }\n    },\n    {\n      \"id\": \"b20000001-0000-0000-0000-000000000001\",\n      \"name\": \"RM Input\",\n      \"type\": \"n8n-nodes-base.set\",\n      \"typeVersion\": 3.4,\n      \"position\": [\n        900,\n        300\n      ],\n      \"parameters\": {\n        \"mode\": \"manual\",\n        \"assignments\": {\n          \"assignments\": [\n            { \"id\": \"1\", \"name\": \"role\", \"value\": \"release-manager\", \"type\": \"string\" },\n            { \"id\": \"2\", \"name\": \"prompt\", \"value\": \"=Check Grafana/Prometheus for {{ $node['Webhook Trigger'].json.body.body.version }}: error rate, latency p95, pod restarts. Output JSON only: {\\\"status\\\": \\\"clean\\\"|\\\"incident\\\", \\\"findings\\\": \\\"string\\\"}\", \"type\": \"string\" },\n            { \"id\": \"3\", \"name\": \"story\", \"value\": \"={{ $node['Webhook Trigger'].json.body.body.version }}\", \"type\": \"string\" }\n          ]\n        }\n      }\n    },\n    {\n      \"id\": \"98993320-da0e-4a00-bcdd-f52cb3d9a37c\",\n      \"name\": \"RM: Health Check\",\n      \"type\": \"n8n-nodes-base.executeWorkflow\",\n      \"typeVersion\": 1.1,\n      \"position\": [\n        1120,\n        300\n      ],\n      \"parameters\": {\n        \"source\": \"database\",\n        \"workflowId\": { \"mode\": \"id\", \"value\": \"jAv16SAzGy9fA5G4\" },\n        \"mode\": \"once\"\n      }\n    },\n    {\n      \"id\": \"4518fc25-58b0-4850-b0aa-9d76359a1eb5\",\n      \"name\": \"Clean?\",\n      \"type\": \"n8n-nodes-base.if\",\n      \"typeVersion\": 2,\n      \"position\": [\n        1340,\n        300\n      ],\n      \"parameters\": {\n        \"conditions\": {\n          \"options\": {\n            \"leftValue\": \"={{ $json.output.includes('\\\"status\\\"') \u0026\u0026 $json.output.includes('\\\"clean\\\"') }}\",\n            \"operation\": \"equals\",\n            \"rightValue\": \"true\"\n          }\n        }\n      }\n    },\n    {\n      \"id\": \"efd21463-12b5-4e0e-bbcd-26cd50c3f334\",\n      \"name\": \"Notify: Release confirmed\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4.2,\n      \"position\": [\n        1560,\n        200\n      ],\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.OPENWEBUI_CALLBACK_URL }}\",\n        \"sendHeaders\": true,\n        \"headerParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"Content-Type\",\n              \"value\": \"application/json\"\n            }\n          ]\n        },\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"flow_id\",\n              \"value\": \"={{ $json.body?.flow_id ?? $json.flow_id ?? '' }}\"\n            },\n            {\n              \"name\": \"message\",\n              \"value\": \"=🎉 {{ $env.RELEASE_VERSION }} production confirmed clean — release complete\"\n            },\n            {\n              \"name\": \"notes\",\n              \"value\": \"\"\n            }\n          ]\n        }\n      }\n    },\n    {\n      \"id\": \"b20000001-0000-0000-0000-000000000002\",\n      \"name\": \"PM Input\",\n      \"type\": \"n8n-nodes-base.set\",\n      \"typeVersion\": 3.4,\n      \"position\": [\n        1780,\n        140\n      ],\n      \"parameters\": {\n        \"mode\": \"manual\",\n        \"assignments\": {\n          \"assignments\": [\n            { \"id\": \"1\", \"name\": \"role\", \"value\": \"pm\", \"type\": \"string\" },\n            { \"id\": \"2\", \"name\": \"prompt\", \"value\": \"=Post release comms for {{ $node['Webhook Trigger'].json.body.body.version }}: changelog summary, what changed, who to contact.\", \"type\": \"string\" },\n            { \"id\": \"3\", \"name\": \"story\", \"value\": \"={{ $node['Webhook Trigger'].json.body.body.version }}\", \"type\": \"string\" }\n          ]\n        }\n      }\n    },\n    {\n      \"id\": \"79aa36f9-d463-4b94-9e2b-cc58d4064815\",\n      \"name\": \"PM: Release Comms\",\n      \"type\": \"n8n-nodes-base.executeWorkflow\",\n      \"typeVersion\": 1.1,\n      \"position\": [\n        1960,\n        200\n      ],\n      \"parameters\": {\n        \"source\": \"database\",\n        \"workflowId\": { \"mode\": \"id\", \"value\": \"jAv16SAzGy9fA5G4\" },\n        \"mode\": \"once\"\n      }\n    },\n    {\n      \"id\": \"2a2e3751-6b2e-42b1-96dd-3ae59acc461d\",\n      \"name\": \"Notify: Incident detected\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4.2,\n      \"position\": [\n        1560,\n        400\n      ],\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.OPENWEBUI_CALLBACK_URL }}\",\n        \"sendHeaders\": true,\n        \"headerParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"Content-Type\",\n              \"value\": \"application/json\"\n            }\n          ]\n        },\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"flow_id\",\n              \"value\": \"={{ $json.body?.flow_id ?? $json.flow_id ?? '' }}\"\n            },\n            {\n              \"name\": \"message\",\n              \"value\": \"=🚨 Incident detected post-deploy for {{ $env.RELEASE_VERSION }} — escalating\"\n            },\n            {\n              \"name\": \"notes\",\n              \"value\": \"\"\n            }\n          ]\n        }\n      }\n    },\n    {\n      \"id\": \"c11d69d0-24b7-4449-a6b8-d6387ed60585\",\n      \"name\": \"→ Escalate Incident\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4.2,\n      \"position\": [\n        1780,\n        400\n      ],\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/escalate\",\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"reason\",\n              \"value\": \"=Post-deploy incident: {{ $node['RM: Health Check'].json.output }}\"\n            }\n          ]\n        }\n      }\n    }\n  ],\n  \"connections\": {\n    \"Webhook Trigger\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Notify: Monitoring window open\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Notify: Monitoring window open\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Wait 30 min\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Wait 30 min\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"RM Input\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"RM Input\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"RM: Health Check\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"RM: Health Check\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Clean?\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Clean?\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Notify: Release confirmed\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ],\n        [\n          {\n            \"node\": \"Notify: Incident detected\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Notify: Release confirmed\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"PM Input\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"PM Input\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"PM: Release Comms\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Notify: Incident detected\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"→ Escalate Incident\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    }\n  },\n  \"active\": true,\n  \"tags\": [],\n  \"settings\": {\n    \"executionOrder\": \"v1\"\n  }\n}\n","F-21-rollback.json":"{\n  \"name\": \"F-21 /rollback\",\n  \"nodes\": [\n    {\n      \"id\": \"bfedf83a-74b1-4f36-95dc-8a1ff43b4fb7\",\n      \"name\": \"Webhook Trigger\",\n      \"type\": \"n8n-nodes-base.webhook\",\n      \"typeVersion\": 2,\n      \"position\": [\n        240,\n        300\n      ],\n      \"parameters\": {\n        \"path\": \"rollback\",\n        \"httpMethod\": \"POST\",\n        \"responseMode\": \"onReceived\",\n        \"responseData\": \"allEntries\"\n      },\n      \"webhookId\": \"bcb610f9-e1a2-4c87-a03e-4bf5c21acdf1\"\n    },\n    {\n      \"id\": \"cc450105-e0a3-424e-b284-2b9ad3648881\",\n      \"name\": \"Notify: Rollback initiated\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4.2,\n      \"position\": [\n        680,\n        300\n      ],\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.OPENWEBUI_CALLBACK_URL }}\",\n        \"sendHeaders\": true,\n        \"headerParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"Content-Type\",\n              \"value\": \"application/json\"\n            }\n          ]\n        },\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"flow_id\",\n              \"value\": \"={{ $json.body?.flow_id ?? $json.flow_id ?? '' }}\"\n            },\n            {\n              \"name\": \"message\",\n              \"value\": \"⏪ Rollback initiated for {{ $json.body.version }}\"\n            },\n            {\n              \"name\": \"notes\",\n              \"value\": \"\"\n            }\n          ]\n        }\n      }\n    },\n    {\n      \"id\": \"f21000001-0000-0000-0000-000000000001\",\n      \"name\": \"DevOps Input\",\n      \"type\": \"n8n-nodes-base.set\",\n      \"typeVersion\": 3.4,\n      \"position\": [\n        900,\n        300\n      ],\n      \"parameters\": {\n        \"mode\": \"manual\",\n        \"assignments\": {\n          \"assignments\": [\n            {\n              \"id\": \"1\",\n              \"name\": \"role\",\n              \"value\": \"devops-engineer\",\n              \"type\": \"string\"\n            },\n            {\n              \"id\": \"2\",\n              \"name\": \"prompt\",\n              \"value\": \"=Roll production back from the failed {{ $json.body.version }} deploy — there is no single ArgoCD Application per environment (each service has its own, `\u003cARGOCD_PROJECT\u003e-\u003cservice\u003e-production`), and 'rollback' here means restoring the previous known-good image tag, not re-syncing current (broken) state. For every file under env/production/*/values.yaml: run `git log -2 --format=%H -- \u003cfile\u003e` to get its previous commit (before the {{ $json.body.version }} deploy that just failed), then `git show \u003cprevious-commit\u003e:\u003cfile\u003e` to read that prior version's content, and overwrite the current file with it. Commit all reverted files in one commit ('rollback: revert production to pre-{{ $json.body.version }} state') and push to main — ArgoCD's automated syncPolicy on each production Application picks up the reverted tag from there. Then wait for each service's production Deployment rollout to complete (kubectl --context $PRODUCTION_CLUSTER_CONTEXT rollout status deployment/\u003cservice\u003e -n hr-portal --timeout=120s). If any env/production/*/values.yaml has no prior commit (first-ever deploy, nothing to roll back to), flag that service explicitly rather than silently skipping it. Report which services were reverted and to which tags.\",\n              \"type\": \"string\"\n            },\n            {\n              \"id\": \"3\",\n              \"name\": \"story\",\n              \"value\": \"={{ $env.RELEASE_VERSION }}\",\n              \"type\": \"string\"\n            }\n          ]\n        }\n      }\n    },\n    {\n      \"id\": \"f21000001-0000-0000-0000-000000000002\",\n      \"name\": \"DevOps: Revert Production\",\n      \"type\": \"n8n-nodes-base.executeWorkflow\",\n      \"typeVersion\": 1.1,\n      \"position\": [\n        1000,\n        300\n      ],\n      \"parameters\": {\n        \"source\": \"database\",\n        \"workflowId\": {\n          \"mode\": \"id\",\n          \"value\": \"jAv16SAzGy9fA5G4\"\n        },\n        \"mode\": \"once\"\n      }\n    },\n    {\n      \"id\": \"988fb99a-f4e9-454c-84c6-8ae4f212101a\",\n      \"name\": \"Open Incident Ticket\",\n      \"type\": \"n8n-nodes-base.code\",\n      \"typeVersion\": 2,\n      \"position\": [\n        1120,\n        300\n      ],\n      \"parameters\": {\n        \"jsCode\": \"// ponytail: Kaneo has one ticket resource (task) -- no separate issue\\n// type, so a bugfix ticket is just a task; its label is the closest\\n// equivalent to Taiga's release-grouping tags. Verify field names against\\n// the deployed Kaneo version.\\nconst kaneoAuth = { Authorization: `Bearer ${$env.KANEO_TOKEN}` };\\nconst created = await this.helpers.httpRequest({\\n  method: 'POST',\\n  url: `${$env.KANEO_URL}/api/task`,\\n  headers: { ...kaneoAuth, 'Content-Type': 'application/json' },\\n  body: { projectId: $env.KANEO_PROJECT_ID, title: `[bugfix] Production rollback ${$env.RELEASE_VERSION}`, description: 'Auto-created on /rollback', label: $env.RELEASE_VERSION },\\n  json: true,\\n});\\nreturn [{ json: { ...$json, incident_ticket_id: created.id } }];\"\n      }\n    },\n    {\n      \"id\": \"46478b12-9904-4aee-a771-78ac0cc68834\",\n      \"name\": \"Notify: Rollback complete\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4.2,\n      \"position\": [\n        1340,\n        300\n      ],\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.OPENWEBUI_CALLBACK_URL }}\",\n        \"sendHeaders\": true,\n        \"headerParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"Content-Type\",\n              \"value\": \"application/json\"\n            }\n          ]\n        },\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"flow_id\",\n              \"value\": \"={{ $json.body?.flow_id ?? $json.flow_id ?? '' }}\"\n            },\n            {\n              \"name\": \"message\",\n              \"value\": \"✅ Rollback complete — monitoring production, incident ticket opened\"\n            },\n            {\n              \"name\": \"notes\",\n              \"value\": \"\"\n            }\n          ]\n        }\n      }\n    }\n  ],\n  \"connections\": {\n    \"Webhook Trigger\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Notify: Rollback initiated\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Notify: Rollback initiated\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"DevOps Input\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"DevOps Input\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"DevOps: Revert Production\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"DevOps: Revert Production\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Open Incident Ticket\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Open Incident Ticket\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Notify: Rollback complete\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    }\n  },\n  \"active\": true,\n  \"tags\": [],\n  \"settings\": {\n    \"executionOrder\": \"v1\"\n  }\n}\n","F-22-rollback-story.json":"{\n  \"name\": \"F-22 /rollback_story\",\n  \"nodes\": [\n    {\n      \"id\": \"fad1f1c4-8a4f-4088-8a6f-09f0aa09e331\",\n      \"name\": \"Webhook Trigger\",\n      \"type\": \"n8n-nodes-base.webhook\",\n      \"typeVersion\": 2,\n      \"position\": [240, 300],\n      \"parameters\": {\n        \"path\": \"rollback-story\",\n        \"httpMethod\": \"POST\",\n        \"responseMode\": \"onReceived\",\n        \"responseData\": \"allEntries\"\n      },\n      \"webhookId\": \"a4896378-3cae-46f1-863a-2e798a4879d8\"\n    },\n    {\n      \"id\": \"09ac856d-3d58-4321-b07d-ce705b364c9a\",\n      \"name\": \"Notify: Story rollback started\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4.2,\n      \"position\": [680, 300],\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.OPENWEBUI_CALLBACK_URL }}\",\n        \"sendHeaders\": true,\n        \"headerParameters\": {\n          \"parameters\": [{ \"name\": \"Content-Type\", \"value\": \"application/json\" }]\n        },\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            { \"name\": \"flow_id\", \"value\": \"={{ $json.body?.flow_id ?? $json.flow_id ?? '' }}\" },\n            { \"name\": \"message\", \"value\": \"=⏪ Story rollback initiated for {{ $json.body.story_id }}\" },\n            { \"name\": \"notes\", \"value\": \"\" }\n          ]\n        }\n      }\n    },\n    {\n      \"id\": \"b22000001-0000-0000-0000-000000000001\",\n      \"name\": \"TL Dep Check Input\",\n      \"type\": \"n8n-nodes-base.set\",\n      \"typeVersion\": 3.4,\n      \"position\": [900, 300],\n      \"parameters\": {\n        \"mode\": \"manual\",\n        \"assignments\": {\n          \"assignments\": [\n            { \"id\": \"1\", \"name\": \"role\", \"value\": \"tech-lead\", \"type\": \"string\" },\n            { \"id\": \"2\", \"name\": \"prompt\", \"value\": \"=Check if story {{ $node['Webhook Trigger'].json.body.body.story_id }} has downstream dependents already merged. Output JSON only: {\\\"status\\\": \\\"safe\\\"|\\\"blocked\\\", \\\"list\\\": \\\"string\\\"}\", \"type\": \"string\" },\n            { \"id\": \"3\", \"name\": \"story\", \"value\": \"={{ $node['Webhook Trigger'].json.body.body.story_id }}\", \"type\": \"string\" }\n          ]\n        }\n      }\n    },\n    {\n      \"id\": \"47c483dc-4cf8-4115-87b0-c692f9512572\",\n      \"name\": \"TL: Dependency Check\",\n      \"type\": \"n8n-nodes-base.executeWorkflow\",\n      \"typeVersion\": 1.1,\n      \"position\": [1080, 300],\n      \"parameters\": {\n        \"source\": \"database\",\n        \"workflowId\": { \"mode\": \"id\", \"value\": \"jAv16SAzGy9fA5G4\" },\n        \"mode\": \"once\"\n      }\n    },\n    {\n      \"id\": \"26772671-af9c-4ef6-b1cb-86213621a230\",\n      \"name\": \"Safe to Revert?\",\n      \"type\": \"n8n-nodes-base.if\",\n      \"typeVersion\": 2,\n      \"position\": [1300, 300],\n      \"parameters\": {\n        \"conditions\": {\n          \"options\": {\n            \"leftValue\": \"={{ $json.output.includes('\\\"status\\\"') \u0026\u0026 $json.output.includes('\\\"safe\\\"') }}\",\n            \"operation\": \"equals\",\n            \"rightValue\": \"true\"\n          }\n        }\n      }\n    },\n    {\n      \"id\": \"b22000001-0000-0000-0000-000000000002\",\n      \"name\": \"TL Revert MR Input\",\n      \"type\": \"n8n-nodes-base.set\",\n      \"typeVersion\": 3.4,\n      \"position\": [1520, 200],\n      \"parameters\": {\n        \"mode\": \"manual\",\n        \"assignments\": {\n          \"assignments\": [\n            { \"id\": \"1\", \"name\": \"role\", \"value\": \"tech-lead\", \"type\": \"string\" },\n            { \"id\": \"2\", \"name\": \"prompt\", \"value\": \"=Open a revert MR for us/{{ $node['Webhook Trigger'].json.body.body.story_id }} via glab. Notify Edward for merge.\", \"type\": \"string\" },\n            { \"id\": \"3\", \"name\": \"story\", \"value\": \"={{ $node['Webhook Trigger'].json.body.body.story_id }}\", \"type\": \"string\" }\n          ]\n        }\n      }\n    },\n    {\n      \"id\": \"6eec7698-ac02-4554-b95e-15786702d88e\",\n      \"name\": \"TL: Open Revert MR\",\n      \"type\": \"n8n-nodes-base.executeWorkflow\",\n      \"typeVersion\": 1.1,\n      \"position\": [1700, 200],\n      \"parameters\": {\n        \"source\": \"database\",\n        \"workflowId\": { \"mode\": \"id\", \"value\": \"jAv16SAzGy9fA5G4\" },\n        \"mode\": \"once\"\n      }\n    },\n    {\n      \"id\": \"18aa5a88-e841-418f-ac64-474d92749e96\",\n      \"name\": \"Notify: Revert MR ready\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4.2,\n      \"position\": [1900, 200],\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.OPENWEBUI_CALLBACK_URL }}\",\n        \"sendHeaders\": true,\n        \"headerParameters\": {\n          \"parameters\": [{ \"name\": \"Content-Type\", \"value\": \"application/json\" }]\n        },\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            { \"name\": \"flow_id\", \"value\": \"={{ $node['Webhook Trigger'].json.body.flow_id ?? '' }}\" },\n            { \"name\": \"message\", \"value\": \"👤 Revert MR ready — Edward please merge to complete rollback\" },\n            { \"name\": \"notes\", \"value\": \"\" }\n          ]\n        }\n      }\n    },\n    {\n      \"id\": \"f7e91a1d-f23f-450b-81f7-f2dc6a064ed8\",\n      \"name\": \"Notify: Rollback blocked\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4.2,\n      \"position\": [1520, 420],\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.OPENWEBUI_CALLBACK_URL }}\",\n        \"sendHeaders\": true,\n        \"headerParameters\": {\n          \"parameters\": [{ \"name\": \"Content-Type\", \"value\": \"application/json\" }]\n        },\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            { \"name\": \"flow_id\", \"value\": \"={{ $node['Webhook Trigger'].json.body.flow_id ?? '' }}\" },\n            { \"name\": \"message\", \"value\": \"=🚫 Story rollback blocked — dependents found: {{ $node['TL: Dependency Check'].json.output }}\" },\n            { \"name\": \"notes\", \"value\": \"\" }\n          ]\n        }\n      }\n    }\n  ],\n  \"connections\": {\n    \"Webhook Trigger\": {\n      \"main\": [[{ \"node\": \"Notify: Story rollback started\", \"type\": \"main\", \"index\": 0 }]]\n    },\n    \"Notify: Story rollback started\": {\n      \"main\": [[{ \"node\": \"TL Dep Check Input\", \"type\": \"main\", \"index\": 0 }]]\n    },\n    \"TL Dep Check Input\": {\n      \"main\": [[{ \"node\": \"TL: Dependency Check\", \"type\": \"main\", \"index\": 0 }]]\n    },\n    \"TL: Dependency Check\": {\n      \"main\": [[{ \"node\": \"Safe to Revert?\", \"type\": \"main\", \"index\": 0 }]]\n    },\n    \"Safe to Revert?\": {\n      \"main\": [\n        [{ \"node\": \"TL Revert MR Input\", \"type\": \"main\", \"index\": 0 }],\n        [{ \"node\": \"Notify: Rollback blocked\", \"type\": \"main\", \"index\": 0 }]\n      ]\n    },\n    \"TL Revert MR Input\": {\n      \"main\": [[{ \"node\": \"TL: Open Revert MR\", \"type\": \"main\", \"index\": 0 }]]\n    },\n    \"TL: Open Revert MR\": {\n      \"main\": [[{ \"node\": \"Notify: Revert MR ready\", \"type\": \"main\", \"index\": 0 }]]\n    }\n  },\n  \"active\": true,\n  \"tags\": [],\n  \"settings\": {\n    \"executionOrder\": \"v1\"\n  }\n}\n","F-23-revert-merged.json":"{\n  \"name\": \"F-23 Revert MR Merged\",\n  \"nodes\": [\n    {\n      \"id\": \"100e299c-6e9b-4521-82b8-7c5c00b2b416\",\n      \"name\": \"Webhook Trigger\",\n      \"type\": \"n8n-nodes-base.webhook\",\n      \"typeVersion\": 2,\n      \"position\": [\n        240,\n        300\n      ],\n      \"parameters\": {\n        \"path\": \"gitlab-revert-merged\",\n        \"httpMethod\": \"POST\",\n        \"responseMode\": \"onReceived\",\n        \"responseData\": \"allEntries\"\n      },\n      \"webhookId\": \"d554a772-19ed-4e7e-a1c4-5c3bef8c787f\"\n    },\n    {\n      \"id\": \"ded48d7b-dcbf-48a5-9967-98fd7004248d\",\n      \"name\": \"Label story: Deferred\",\n      \"type\": \"n8n-nodes-base.code\",\n      \"typeVersion\": 2,\n      \"position\": [\n        680,\n        300\n      ],\n      \"parameters\": {\n        \"jsCode\": \"// ponytail: Kaneo has one ticket resource (task, no separate userstory\\n// type) with a plain status field -- no status-id lookup needed. Verify\\n// the 'deferred' status value against the deployed Kaneo version.\\nconst kaneoAuth = { Authorization: `Bearer ${$env.KANEO_TOKEN}` };\\n// branch is 'us/GL-{story id}' — GL- is branch-naming vocabulary only, {N} is the Kaneo task id\\nconst storyId = $json.object_attributes.source_branch.split('/')[1].split('-')[1];\\nawait this.helpers.httpRequest({\\n  method: 'PATCH',\\n  url: `${$env.KANEO_URL}/api/task/${storyId}`,\\n  headers: { ...kaneoAuth, 'Content-Type': 'application/json' },\\n  body: { status: 'deferred' },\\n  json: true,\\n});\\nreturn [{ json: { ...$json, story_id: storyId } }];\"\n      }\n    },\n    {\n      \"id\": \"65cdfa49-870a-40b9-800a-b689e6340f00\",\n      \"name\": \"Notify: Story deferred\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4.2,\n      \"position\": [\n        900,\n        300\n      ],\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.OPENWEBUI_CALLBACK_URL }}\",\n        \"sendHeaders\": true,\n        \"headerParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"Content-Type\",\n              \"value\": \"application/json\"\n            }\n          ]\n        },\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"flow_id\",\n              \"value\": \"={{ $json.body?.flow_id ?? $json.flow_id ?? '' }}\"\n            },\n            {\n              \"name\": \"message\",\n              \"value\": \"📦 Story deferred — re-triggering /uat\"\n            },\n            {\n              \"name\": \"notes\",\n              \"value\": \"\"\n            }\n          ]\n        }\n      }\n    },\n    {\n      \"id\": \"adf03156-16e4-45ad-9da1-fc042b79dcb6\",\n      \"name\": \"→ F-10 /uat\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4.2,\n      \"position\": [\n        1120,\n        300\n      ],\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/uat\",\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"version\",\n              \"value\": \"={{ $env.RELEASE_VERSION }}\"\n            }\n          ]\n        }\n      }\n    }\n  ],\n  \"connections\": {\n    \"Webhook Trigger\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Label story: Deferred\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Label story: Deferred\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Notify: Story deferred\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Notify: Story deferred\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"→ F-10 /uat\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    }\n  },\n  \"active\": true,\n  \"tags\": [],\n  \"settings\": {\n    \"executionOrder\": \"v1\"\n  }\n}\n","F-24-retro.json":"{\n  \"name\": \"F-24 /retro\",\n  \"nodes\": [\n    {\n      \"id\": \"01128661-b98e-41e0-8695-c091872ecb72\",\n      \"name\": \"Webhook Trigger\",\n      \"type\": \"n8n-nodes-base.webhook\",\n      \"typeVersion\": 2,\n      \"position\": [\n        240,\n        300\n      ],\n      \"parameters\": {\n        \"path\": \"retro\",\n        \"httpMethod\": \"POST\",\n        \"responseMode\": \"onReceived\",\n        \"responseData\": \"allEntries\"\n      },\n      \"webhookId\": \"24ebe495-943d-482b-9d32-c57d92cb11ca\"\n    },\n    {\n      \"id\": \"9bd2dfa9-1743-4d85-ad08-83329e3dc5cd\",\n      \"name\": \"Notify: Retro started\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4.2,\n      \"position\": [\n        680,\n        300\n      ],\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.OPENWEBUI_CALLBACK_URL }}\",\n        \"sendHeaders\": true,\n        \"headerParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"Content-Type\",\n              \"value\": \"application/json\"\n            }\n          ]\n        },\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"flow_id\",\n              \"value\": \"={{ $json.body?.flow_id ?? $json.flow_id ?? '' }}\"\n            },\n            {\n              \"name\": \"message\",\n              \"value\": \"🔄 Retro started — 4 pods compiling in parallel\"\n            },\n            {\n              \"name\": \"notes\",\n              \"value\": \"\"\n            }\n          ]\n        }\n      }\n    },\n    {\n      \"id\": \"b24000001-0000-0000-0000-000000000001\",\n      \"name\": \"TL Input\",\n      \"type\": \"n8n-nodes-base.set\",\n      \"typeVersion\": 3.4,\n      \"position\": [\n        900,\n        100\n      ],\n      \"parameters\": {\n        \"mode\": \"manual\",\n        \"assignments\": {\n          \"assignments\": [\n            {\n              \"id\": \"1\",\n              \"name\": \"role\",\n              \"value\": \"tech-lead\",\n              \"type\": \"string\"\n            },\n            {\n              \"id\": \"2\",\n              \"name\": \"prompt\",\n              \"value\": \"=Compile a technical retrospective for {{ $node['Webhook Trigger'].json.body.body.version }}: code quality, architecture decisions, technical debt incurred, pseudocode accuracy.\",\n              \"type\": \"string\"\n            },\n            {\n              \"id\": \"3\",\n              \"name\": \"story\",\n              \"value\": \"={{ $node['Webhook Trigger'].json.body.body.version }}\",\n              \"type\": \"string\"\n            }\n          ]\n        }\n      }\n    },\n    {\n      \"id\": \"0c7322e9-f26b-4356-a4f6-76e9ccc579a3\",\n      \"name\": \"TL: Tech Retro\",\n      \"type\": \"n8n-nodes-base.executeWorkflow\",\n      \"typeVersion\": 1.1,\n      \"position\": [\n        1080,\n        100\n      ],\n      \"parameters\": {\n        \"source\": \"database\",\n        \"workflowId\": {\n          \"mode\": \"id\",\n          \"value\": \"jAv16SAzGy9fA5G4\"\n        },\n        \"mode\": \"once\"\n      }\n    },\n    {\n      \"id\": \"b24000001-0000-0000-0000-000000000002\",\n      \"name\": \"QA Input\",\n      \"type\": \"n8n-nodes-base.set\",\n      \"typeVersion\": 3.4,\n      \"position\": [\n        900,\n        260\n      ],\n      \"parameters\": {\n        \"mode\": \"manual\",\n        \"assignments\": {\n          \"assignments\": [\n            {\n              \"id\": \"1\",\n              \"name\": \"role\",\n              \"value\": \"qa-engineer\",\n              \"type\": \"string\"\n            },\n            {\n              \"id\": \"2\",\n              \"name\": \"prompt\",\n              \"value\": \"=Compile a QA retrospective for {{ $node['Webhook Trigger'].json.body.body.version }}: test coverage, defect escape rate, UAT findings.\",\n              \"type\": \"string\"\n            },\n            {\n              \"id\": \"3\",\n              \"name\": \"story\",\n              \"value\": \"={{ $node['Webhook Trigger'].json.body.body.version }}\",\n              \"type\": \"string\"\n            }\n          ]\n        }\n      }\n    },\n    {\n      \"id\": \"298c9e5c-59ae-4481-9264-a11cc043a469\",\n      \"name\": \"QA: Quality Retro\",\n      \"type\": \"n8n-nodes-base.executeWorkflow\",\n      \"typeVersion\": 1.1,\n      \"position\": [\n        1080,\n        260\n      ],\n      \"parameters\": {\n        \"source\": \"database\",\n        \"workflowId\": {\n          \"mode\": \"id\",\n          \"value\": \"jAv16SAzGy9fA5G4\"\n        },\n        \"mode\": \"once\"\n      }\n    },\n    {\n      \"id\": \"b24000001-0000-0000-0000-000000000003\",\n      \"name\": \"Security Input\",\n      \"type\": \"n8n-nodes-base.set\",\n      \"typeVersion\": 3.4,\n      \"position\": [\n        900,\n        420\n      ],\n      \"parameters\": {\n        \"mode\": \"manual\",\n        \"assignments\": {\n          \"assignments\": [\n            {\n              \"id\": \"1\",\n              \"name\": \"role\",\n              \"value\": \"security-engineer\",\n              \"type\": \"string\"\n            },\n            {\n              \"id\": \"2\",\n              \"name\": \"prompt\",\n              \"value\": \"=Compile a security retrospective for {{ $node['Webhook Trigger'].json.body.body.version }}: vulnerabilities found, SAST/DAST findings, remediation time.\",\n              \"type\": \"string\"\n            },\n            {\n              \"id\": \"3\",\n              \"name\": \"story\",\n              \"value\": \"={{ $node['Webhook Trigger'].json.body.body.version }}\",\n              \"type\": \"string\"\n            }\n          ]\n        }\n      }\n    },\n    {\n      \"id\": \"4587422c-f0a2-4819-81e8-aa34af664a0a\",\n      \"name\": \"Sec: Security Retro\",\n      \"type\": \"n8n-nodes-base.executeWorkflow\",\n      \"typeVersion\": 1.1,\n      \"position\": [\n        1080,\n        420\n      ],\n      \"parameters\": {\n        \"source\": \"database\",\n        \"workflowId\": {\n          \"mode\": \"id\",\n          \"value\": \"jAv16SAzGy9fA5G4\"\n        },\n        \"mode\": \"once\"\n      }\n    },\n    {\n      \"id\": \"b24000001-0000-0000-0000-000000000004\",\n      \"name\": \"RM Input\",\n      \"type\": \"n8n-nodes-base.set\",\n      \"typeVersion\": 3.4,\n      \"position\": [\n        900,\n        580\n      ],\n      \"parameters\": {\n        \"mode\": \"manual\",\n        \"assignments\": {\n          \"assignments\": [\n            {\n              \"id\": \"1\",\n              \"name\": \"role\",\n              \"value\": \"release-manager\",\n              \"type\": \"string\"\n            },\n            {\n              \"id\": \"2\",\n              \"name\": \"prompt\",\n              \"value\": \"=Compile a release process retrospective for {{ $node['Webhook Trigger'].json.body.body.version }}: timeline, gate durations, go/no-go history.\",\n              \"type\": \"string\"\n            },\n            {\n              \"id\": \"3\",\n              \"name\": \"story\",\n              \"value\": \"={{ $node['Webhook Trigger'].json.body.body.version }}\",\n              \"type\": \"string\"\n            }\n          ]\n        }\n      }\n    },\n    {\n      \"id\": \"dca7ebc4-641e-4a8f-86d5-c93c6c7ae414\",\n      \"name\": \"RM: Process Retro\",\n      \"type\": \"n8n-nodes-base.executeWorkflow\",\n      \"typeVersion\": 1.1,\n      \"position\": [\n        1080,\n        580\n      ],\n      \"parameters\": {\n        \"source\": \"database\",\n        \"workflowId\": {\n          \"mode\": \"id\",\n          \"value\": \"jAv16SAzGy9fA5G4\"\n        },\n        \"mode\": \"once\"\n      }\n    },\n    {\n      \"id\": \"1ebfe007-62ed-4fa7-bd56-a1262b89fc35\",\n      \"name\": \"Merge 4 Retros\",\n      \"type\": \"n8n-nodes-base.merge\",\n      \"typeVersion\": 3,\n      \"position\": [\n        1300,\n        340\n      ],\n      \"parameters\": {\n        \"mode\": \"combine\",\n        \"combineBy\": \"combineByPosition\",\n        \"numberInputs\": 4\n      }\n    },\n    {\n      \"id\": \"9c4eda4e-da49-464d-b76c-64a4a310f4e9\",\n      \"name\": \"Notify: Synthesising\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4.2,\n      \"position\": [\n        1520,\n        340\n      ],\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.OPENWEBUI_CALLBACK_URL }}\",\n        \"sendHeaders\": true,\n        \"headerParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"Content-Type\",\n              \"value\": \"application/json\"\n            }\n          ]\n        },\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"flow_id\",\n              \"value\": \"={{ $node['Webhook Trigger'].json.body.flow_id ?? '' }}\"\n            },\n            {\n              \"name\": \"message\",\n              \"value\": \"📝 All retro inputs gathered — PM synthesising 11-section report\"\n            },\n            {\n              \"name\": \"notes\",\n              \"value\": \"\"\n            }\n          ]\n        }\n      }\n    },\n    {\n      \"id\": \"b24000001-0000-0000-0000-000000000005\",\n      \"name\": \"PM Input\",\n      \"type\": \"n8n-nodes-base.set\",\n      \"typeVersion\": 3.4,\n      \"position\": [\n        1740,\n        340\n      ],\n      \"parameters\": {\n        \"mode\": \"manual\",\n        \"assignments\": {\n          \"assignments\": [\n            {\n              \"id\": \"1\",\n              \"name\": \"role\",\n              \"value\": \"pm\",\n              \"type\": \"string\"\n            },\n            {\n              \"id\": \"2\",\n              \"name\": \"prompt\",\n              \"value\": \"=Synthesise an 11-section retrospective report for {{ $node['Webhook Trigger'].json.body.body.version }} from these inputs, then publish it as a GitLab wiki page titled '{{ $node['Webhook Trigger'].json.body.body.version }}/Retrospective' via `glab api projects/{{ $node['Webhook Trigger'].json.body.gitlab_project_path?.replaceAll('/','%2F') ?? $env.GITLAB_PROJECT_PATH }}/wikis --method POST -f title=\\\"{{ $node['Webhook Trigger'].json.body.body.version }}/Retrospective\\\" -f format=markdown -F content=@\u003ccontent-file\u003e` (note -F, not -f — -f sends the value as a literal string, -F substitutes the file's actual content) — the slash nests this page under the '{{ $node['Webhook Trigger'].json.body.body.version }}' wiki directory alongside its PRD/Architecture/UX-Design pages (if the page already exists, PUT to `glab api projects/{{ $node['Webhook Trigger'].json.body.gitlab_project_path?.replaceAll('/','%2F') ?? $env.GITLAB_PROJECT_PATH }}/wikis/{{ $node['Webhook Trigger'].json.body.body.version }}%2FRetrospective` instead — %2F, not a literal slash, in the URL path). Then post a summary via glab.\\n\\n--- Tech Lead retro ---\\n{{ $node['TL: Tech Retro'].json.output }}\\n\\n--- QA retro ---\\n{{ $node['QA: Quality Retro'].json.output }}\\n\\n--- Security retro ---\\n{{ $node['Sec: Security Retro'].json.output }}\\n\\n--- Release Manager retro ---\\n{{ $node['RM: Process Retro'].json.output }}\",\n              \"type\": \"string\"\n            },\n            {\n              \"id\": \"3\",\n              \"name\": \"story\",\n              \"value\": \"={{ $node['Webhook Trigger'].json.body.body.version }}\",\n              \"type\": \"string\"\n            }\n          ]\n        }\n      }\n    },\n    {\n      \"id\": \"2bbbccbc-3a9f-40eb-a4cc-d8b4e71b554b\",\n      \"name\": \"PM: Synthesise Report\",\n      \"type\": \"n8n-nodes-base.executeWorkflow\",\n      \"typeVersion\": 1.1,\n      \"position\": [\n        1960,\n        340\n      ],\n      \"parameters\": {\n        \"source\": \"database\",\n        \"workflowId\": {\n          \"mode\": \"id\",\n          \"value\": \"jAv16SAzGy9fA5G4\"\n        },\n        \"mode\": \"once\"\n      }\n    },\n    {\n      \"id\": \"c5c0189c-3622-493b-8c22-8580b88558bf\",\n      \"name\": \"Notify: Retro complete\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4.2,\n      \"position\": [\n        2180,\n        340\n      ],\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.OPENWEBUI_CALLBACK_URL }}\",\n        \"sendHeaders\": true,\n        \"headerParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"Content-Type\",\n              \"value\": \"application/json\"\n            }\n          ]\n        },\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"flow_id\",\n              \"value\": \"={{ $node['Webhook Trigger'].json.body.flow_id ?? '' }}\"\n            },\n            {\n              \"name\": \"message\",\n              \"value\": \"✅ Retro complete — report published to wiki\"\n            },\n            {\n              \"name\": \"notes\",\n              \"value\": \"\"\n            }\n          ]\n        }\n      }\n    }\n  ],\n  \"connections\": {\n    \"Webhook Trigger\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Notify: Retro started\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Notify: Retro started\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"TL Input\",\n            \"type\": \"main\",\n            \"index\": 0\n          },\n          {\n            \"node\": \"QA Input\",\n            \"type\": \"main\",\n            \"index\": 0\n          },\n          {\n            \"node\": \"Security Input\",\n            \"type\": \"main\",\n            \"index\": 0\n          },\n          {\n            \"node\": \"RM Input\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"TL Input\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"TL: Tech Retro\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"QA Input\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"QA: Quality Retro\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Security Input\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Sec: Security Retro\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"RM Input\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"RM: Process Retro\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"TL: Tech Retro\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Merge 4 Retros\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"QA: Quality Retro\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Merge 4 Retros\",\n            \"type\": \"main\",\n            \"index\": 1\n          }\n        ]\n      ]\n    },\n    \"Sec: Security Retro\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Merge 4 Retros\",\n            \"type\": \"main\",\n            \"index\": 2\n          }\n        ]\n      ]\n    },\n    \"RM: Process Retro\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Merge 4 Retros\",\n            \"type\": \"main\",\n            \"index\": 3\n          }\n        ]\n      ]\n    },\n    \"Merge 4 Retros\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Notify: Synthesising\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Notify: Synthesising\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"PM Input\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"PM Input\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"PM: Synthesise Report\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"PM: Synthesise Report\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Notify: Retro complete\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    }\n  },\n  \"active\": true,\n  \"tags\": [],\n  \"settings\": {\n    \"executionOrder\": \"v1\"\n  }\n}","F-25-escalate.json":"{\n  \"name\": \"F-25 /escalate\",\n  \"nodes\": [\n    {\n      \"id\": \"eb6d990b-6de1-4945-a1dc-17515ee5e874\",\n      \"name\": \"Webhook Trigger\",\n      \"type\": \"n8n-nodes-base.webhook\",\n      \"typeVersion\": 2,\n      \"position\": [\n        240,\n        300\n      ],\n      \"parameters\": {\n        \"path\": \"escalate\",\n        \"httpMethod\": \"POST\",\n        \"responseMode\": \"onReceived\",\n        \"responseData\": \"allEntries\"\n      },\n      \"webhookId\": \"d0831192-d92b-4838-aa02-b20f4636d72b\"\n    },\n    {\n      \"id\": \"8b9c6c31-d424-4a9f-b994-460b9bfeb90d\",\n      \"name\": \"Pause DAG State\",\n      \"type\": \"n8n-nodes-base.set\",\n      \"typeVersion\": 3.4,\n      \"position\": [\n        680,\n        300\n      ],\n      \"parameters\": {\n        \"assignments\": {\n          \"assignments\": [\n            {\n              \"id\": \"3c5ff122-c010-44e2-bca8-0d36392f5667\",\n              \"name\": \"dag_paused\",\n              \"value\": \"true\",\n              \"type\": \"string\"\n            },\n            {\n              \"id\": \"0cc4e41f-3179-413d-afde-ee552e217854\",\n              \"name\": \"escalation_reason\",\n              \"value\": \"={{ $json.body.reason }}\",\n              \"type\": \"string\"\n            },\n            {\n              \"id\": \"5c4d989b-7dad-4c1e-98ac-6bbbfd045116\",\n              \"name\": \"escalated_at\",\n              \"value\": \"={{ $now.toISO() }}\",\n              \"type\": \"string\"\n            }\n          ]\n        }\n      }\n    },\n    {\n      \"id\": \"a61db17a-ed2b-4dbe-b255-db74242ab93d\",\n      \"name\": \"Notify: ESCALATION\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4.2,\n      \"position\": [\n        900,\n        300\n      ],\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.OPENWEBUI_CALLBACK_URL }}\",\n        \"sendHeaders\": true,\n        \"headerParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"Content-Type\",\n              \"value\": \"application/json\"\n            }\n          ]\n        },\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"flow_id\",\n              \"value\": \"={{ $json.body?.flow_id ?? $json.flow_id ?? '' }}\"\n            },\n            {\n              \"name\": \"message\",\n              \"value\": \"🚨 ESCALATION — DAG paused. Reason: {{ $json.body.reason }}. Human intervention required.\"\n            },\n            {\n              \"name\": \"notes\",\n              \"value\": \"\"\n            }\n          ]\n        }\n      }\n    },\n    {\n      \"id\": \"c32fa87a-b132-416a-b3db-0aa7d00728fb\",\n      \"name\": \"Open Escalation Ticket\",\n      \"type\": \"n8n-nodes-base.code\",\n      \"typeVersion\": 2,\n      \"position\": [\n        1120,\n        300\n      ],\n      \"parameters\": {\n        \"jsCode\": \"// ponytail: Kaneo has one ticket resource (task, no separate issue type)\\n// and no confirmed priorities endpoint -- pass priority as a plain string\\n// field directly instead of resolving an id. Verify field name/value\\n// against the deployed Kaneo version.\\nconst kaneoAuth = { Authorization: `Bearer ${$env.KANEO_TOKEN}` };\\nconst created = await this.helpers.httpRequest({\\n  method: 'POST',\\n  url: `${$env.KANEO_URL}/api/task`,\\n  headers: { ...kaneoAuth, 'Content-Type': 'application/json' },\\n  body: {\\n    projectId: $env.KANEO_PROJECT_ID,\\n    title: `[bugfix] ESCALATION: ${$json.body.reason}`,\\n    description: 'Auto-escalated by n8n SDLC orchestrator.',\\n    priority: 'urgent',\\n  },\\n  json: true,\\n});\\nreturn [{ json: { ...$json, escalation_ticket_id: created.id } }];\"\n      }\n    }\n  ],\n  \"connections\": {\n    \"Webhook Trigger\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Pause DAG State\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Pause DAG State\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Notify: ESCALATION\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Notify: ESCALATION\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Open Escalation Ticket\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    }\n  },\n  \"active\": true,\n  \"tags\": [],\n  \"settings\": {\n    \"executionOrder\": \"v1\"\n  }\n}\n","F-26-projects.json":"{\n  \"name\": \"F-26 /projects\",\n  \"nodes\": [\n    {\n      \"id\": \"012cb2a3-5712-42eb-9cc7-d7bbe6112a6a\",\n      \"name\": \"Webhook Trigger\",\n      \"type\": \"n8n-nodes-base.webhook\",\n      \"typeVersion\": 2,\n      \"position\": [\n        240,\n        300\n      ],\n      \"parameters\": {\n        \"path\": \"projects\",\n        \"httpMethod\": \"GET\",\n        \"responseMode\": \"onReceived\",\n        \"responseData\": \"allEntries\"\n      },\n      \"webhookId\": \"0ba3c35a-7646-4360-b4fd-d570efdb6283\"\n    },\n    {\n      \"id\": \"d0342401-24c5-437f-a35c-d26606bdeba7\",\n      \"name\": \"Query DAG State\",\n      \"type\": \"n8n-nodes-base.code\",\n      \"typeVersion\": 2,\n      \"position\": [\n        680,\n        300\n      ],\n      \"parameters\": {\n        \"jsCode\": \"// ponytail: Kaneo collapses Taiga's epic/userstory/task/issue into one\\n// task resource -- single list call instead of separate userstory+task\\n// fetches. label is the closest equivalent to Taiga's release-grouping\\n// tags; verify both against the deployed Kaneo version.\\nconst kaneoAuth = { Authorization: `Bearer ${$env.KANEO_TOKEN}` };\\nconst tasks = await this.helpers.httpRequest({ method: 'GET', url: `${$env.KANEO_URL}/api/task/tasks/${$env.KANEO_PROJECT_ID}`, qs: { label: $env.RELEASE_VERSION }, headers: kaneoAuth, json: true });\\nreturn tasks.map(t =\u003e ({ json: t }));\"\n      }\n    },\n    {\n      \"id\": \"7dc9f5b9-02e2-4b3d-9819-7e36e3cca501\",\n      \"name\": \"Build DAG Summary\",\n      \"type\": \"n8n-nodes-base.code\",\n      \"typeVersion\": 2,\n      \"position\": [\n        900,\n        300\n      ],\n      \"parameters\": {\n        \"jsCode\": \"// ponytail: Kaneo has one ticket resource (task) -- no more\\n// stories-vs-tasks split to report separately.\\nconst items = $input.all().map(i =\u003e i.json);\\nconst open = items.filter(t =\u003e t.status !== 'done').length;\\nconst closed = items.filter(t =\u003e t.status === 'done').length;\\nreturn [{json: {\\n  version: $env.RELEASE_VERSION,\\n  tasks_total: items.length,\\n  tasks_open: open,\\n  tasks_closed: closed,\\n  dag_paused: $env.DAG_PAUSED ?? false,\\n  summary: `${closed}/${items.length} tasks closed, ${open} open`\\n}}];\\n\"\n      }\n    },\n    {\n      \"id\": \"d3ff71cd-fc3f-4906-b479-7c0a23df6e68\",\n      \"name\": \"Notify: DAG state\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4.2,\n      \"position\": [\n        1120,\n        300\n      ],\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.OPENWEBUI_CALLBACK_URL }}\",\n        \"sendHeaders\": true,\n        \"headerParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"Content-Type\",\n              \"value\": \"application/json\"\n            }\n          ]\n        },\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"flow_id\",\n              \"value\": \"={{ $json.body?.flow_id ?? $json.flow_id ?? '' }}\"\n            },\n            {\n              \"name\": \"message\",\n              \"value\": \"📊 DAG state {{ $env.RELEASE_VERSION }}: {{ $json.summary }} | paused={{ $json.dag_paused }}\"\n            },\n            {\n              \"name\": \"notes\",\n              \"value\": \"\"\n            }\n          ]\n        }\n      }\n    }\n  ],\n  \"connections\": {\n    \"Webhook Trigger\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Query DAG State\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Query DAG State\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Build DAG Summary\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Build DAG Summary\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Notify: DAG state\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    }\n  },\n  \"active\": true,\n  \"tags\": [],\n  \"settings\": {\n    \"executionOrder\": \"v1\"\n  }\n}\n","F-27-cluster-lifecycle.json":"{\n  \"name\": \"F-27 Cluster Lifecycle\",\n  \"nodes\": [\n    {\n      \"id\": \"7bbb5a9d-514f-4fcd-a13d-5a5096eb05bc\",\n      \"name\": \"Webhook Trigger\",\n      \"type\": \"n8n-nodes-base.webhook\",\n      \"typeVersion\": 2,\n      \"position\": [\n        240,\n        300\n      ],\n      \"parameters\": {\n        \"path\": \"cluster-lifecycle\",\n        \"httpMethod\": \"POST\",\n        \"responseMode\": \"onReceived\",\n        \"responseData\": \"allEntries\"\n      },\n      \"webhookId\": \"8ae0992e-3a28-46f4-91e8-01d980907f1b\"\n    },\n    {\n      \"id\": \"e39e2cb4-1ffd-4765-b6a4-950d36a4a3a0\",\n      \"name\": \"Action?\",\n      \"type\": \"n8n-nodes-base.switch\",\n      \"typeVersion\": 3,\n      \"position\": [\n        680,\n        300\n      ],\n      \"parameters\": {\n        \"mode\": \"rules\",\n        \"rules\": {\n          \"values\": [\n            {\n              \"conditions\": {\n                \"options\": {\n                  \"leftValue\": \"={{ $json.body.action }}\",\n                  \"operation\": \"equals\",\n                  \"rightValue\": \"wake\"\n                }\n              },\n              \"outputKey\": \"wake\"\n            },\n            {\n              \"conditions\": {\n                \"options\": {\n                  \"leftValue\": \"={{ $json.body.action }}\",\n                  \"operation\": \"equals\",\n                  \"rightValue\": \"sleep\"\n                }\n              },\n              \"outputKey\": \"sleep\"\n            }\n          ]\n        }\n      }\n    },\n    {\n      \"id\": \"79e04b85-1fa7-40b2-b7f3-044e08807cf6\",\n      \"name\": \"kubectl: Scale Up\",\n      \"type\": \"n8n-nodes-base.executeCommand\",\n      \"typeVersion\": 1,\n      \"position\": [\n        900,\n        200\n      ],\n      \"parameters\": {\n        \"command\": \"=kubectl scale deploy --all --replicas=1 -n {{ $node['Webhook Trigger'].json.body.deploy_namespace ?? $env.DEPLOY_NAMESPACE }} --context=k3d-{{ $json.body.cluster }}\"\n      }\n    },\n    {\n      \"id\": \"ba42f8d6-7b37-40f0-94aa-1c024c22f67c\",\n      \"name\": \"kubectl: Scale Down\",\n      \"type\": \"n8n-nodes-base.executeCommand\",\n      \"typeVersion\": 1,\n      \"position\": [\n        900,\n        400\n      ],\n      \"parameters\": {\n        \"command\": \"=kubectl scale deploy --all --replicas=0 -n {{ $node['Webhook Trigger'].json.body.deploy_namespace ?? $env.DEPLOY_NAMESPACE }} --context=k3d-{{ $json.body.cluster }}\"\n      }\n    },\n    {\n      \"id\": \"a5c05c09-27ae-4c83-b4f4-7269e29d94a7\",\n      \"name\": \"Notify: Cluster woken\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4.2,\n      \"position\": [\n        1120,\n        200\n      ],\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.OPENWEBUI_CALLBACK_URL }}\",\n        \"sendHeaders\": true,\n        \"headerParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"Content-Type\",\n              \"value\": \"application/json\"\n            }\n          ]\n        },\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"flow_id\",\n              \"value\": \"={{ $json.body?.flow_id ?? $json.flow_id ?? '' }}\"\n            },\n            {\n              \"name\": \"message\",\n              \"value\": \"☀️ {{ $json.body.cluster }} cluster woken\"\n            },\n            {\n              \"name\": \"notes\",\n              \"value\": \"\"\n            }\n          ]\n        }\n      }\n    },\n    {\n      \"id\": \"af49003d-1c6a-488a-85be-342cb7b386df\",\n      \"name\": \"Notify: Cluster sleeping\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4.2,\n      \"position\": [\n        1120,\n        400\n      ],\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.OPENWEBUI_CALLBACK_URL }}\",\n        \"sendHeaders\": true,\n        \"headerParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"Content-Type\",\n              \"value\": \"application/json\"\n            }\n          ]\n        },\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"flow_id\",\n              \"value\": \"={{ $json.body?.flow_id ?? $json.flow_id ?? '' }}\"\n            },\n            {\n              \"name\": \"message\",\n              \"value\": \"🌙 {{ $json.body.cluster }} cluster sleeping\"\n            },\n            {\n              \"name\": \"notes\",\n              \"value\": \"\"\n            }\n          ]\n        }\n      }\n    }\n  ],\n  \"connections\": {\n    \"Webhook Trigger\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Action?\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Action?\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"kubectl: Scale Up\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ],\n        [\n          {\n            \"node\": \"kubectl: Scale Down\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"kubectl: Scale Up\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Notify: Cluster woken\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"kubectl: Scale Down\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Notify: Cluster sleeping\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    }\n  },\n  \"active\": true,\n  \"tags\": [],\n  \"settings\": {\n    \"executionOrder\": \"v1\"\n  }\n}\n","F-28-chat.json":"{\n  \"name\": \"F-28 Mattermost chat with omp\",\n  \"nodes\": [\n    {\n      \"parameters\": {\n        \"httpMethod\": \"POST\",\n        \"path\": \"mm-chat\",\n        \"responseMode\": \"responseNode\",\n        \"options\": {}\n      },\n      \"id\": \"chat-trigger\",\n      \"name\": \"Mattermost: trigger\",\n      \"type\": \"n8n-nodes-base.webhook\",\n      \"typeVersion\": 1,\n      \"position\": [240, 300]\n    },\n    {\n      \"parameters\": {\n        \"respondWith\": \"json\",\n        \"responseBody\": \"{}\"\n      },\n      \"id\": \"chat-ack\",\n      \"name\": \"Ack (200 within 5s)\",\n      \"type\": \"n8n-nodes-base.respondToWebhook\",\n      \"typeVersion\": 1,\n      \"position\": [480, 200]\n    },\n    {\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.LITELLM_BASE }}/v1/chat/completions\",\n        \"sendHeaders\": true,\n        \"headerParameters\": {\n          \"parameters\": [\n            { \"name\": \"Authorization\", \"value\": \"=Bearer {{ $env.LITELLM_MASTER_KEY }}\" }\n          ]\n        },\n        \"sendBody\": true,\n        \"specifyBody\": \"json\",\n        \"jsonBody\": \"={{ JSON.stringify({ model: 'omp', messages: [ { role: 'user', content: ($json.body.text || '').replace(/^\\\\s*omp\\\\s+/i, '') } ] }) }}\",\n        \"options\": { \"timeout\": 300000 }\n      },\n      \"id\": \"ask-omp\",\n      \"name\": \"Ask omp\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4,\n      \"position\": [480, 380]\n    },\n    {\n      \"parameters\": {\n        \"channelId\": \"={{ $('Mattermost: trigger').item.json.body.channel_id }}\",\n        \"message\": \"={{ $json.choices[0].message.content }}\",\n        \"otherOptions\": {}\n      },\n      \"id\": \"chat-reply\",\n      \"name\": \"Mattermost: reply\",\n      \"type\": \"n8n-nodes-base.mattermost\",\n      \"typeVersion\": 1,\n      \"position\": [720, 380],\n      \"credentials\": {\n        \"mattermostApi\": { \"id\": \"mm-creds\", \"name\": \"Mattermost SDLC Bot\" }\n      }\n    }\n  ],\n  \"connections\": {\n    \"Mattermost: trigger\": {\n      \"main\": [\n        [\n          { \"node\": \"Ack (200 within 5s)\", \"type\": \"main\", \"index\": 0 },\n          { \"node\": \"Ask omp\", \"type\": \"main\", \"index\": 0 }\n        ]\n      ]\n    },\n    \"Ask omp\": {\n      \"main\": [\n        [\n          { \"node\": \"Mattermost: reply\", \"type\": \"main\", \"index\": 0 }\n        ]\n      ]\n    }\n  },\n  \"active\": true,\n  \"settings\": {\n    \"executionOrder\": \"v1\"\n  },\n  \"tags\": [\n    { \"name\": \"cross-cutting\" },\n    { \"name\": \"mattermost\" }\n  ]\n}\n","F-29-flow-progress-sink.json":"{\n  \"name\": \"F-29 Flow Progress Sink\",\n  \"nodes\": [\n    {\n      \"id\": \"a1b2c3d4-0029-4001-8001-000000000001\",\n      \"name\": \"Webhook Trigger\",\n      \"type\": \"n8n-nodes-base.webhook\",\n      \"typeVersion\": 2,\n      \"position\": [240, 300],\n      \"parameters\": {\n        \"path\": \"flow-progress\",\n        \"httpMethod\": \"POST\",\n        \"responseMode\": \"onReceived\",\n        \"responseData\": \"allEntries\"\n      },\n      \"webhookId\": \"b7a1c5e2-0029-4001-8001-000000000001\"\n    },\n    {\n      \"id\": \"a1b2c3d4-0029-4001-8001-000000000002\",\n      \"name\": \"Insert Progress Row\",\n      \"type\": \"n8n-nodes-base.postgres\",\n      \"typeVersion\": 2.7,\n      \"position\": [460, 300],\n      \"parameters\": {\n        \"operation\": \"executeQuery\",\n        \"query\": \"INSERT INTO sdlc_flow_progress (flow_id, message, notes) VALUES ($1, $2, $3)\",\n        \"options\": {\n          \"queryReplacement\": \"={{ [$json.body.flow_id ?? '', $json.body.message ?? '', $json.body.notes ?? ''] }}\"\n        }\n      },\n      \"credentials\": {\n        \"postgres\": {\n          \"id\": \"fsyufCBhX6sCVQpV\",\n          \"name\": \"SDLC Progress Postgres\"\n        }\n      }\n    }\n  ],\n  \"connections\": {\n    \"Webhook Trigger\": {\n      \"main\": [[{ \"node\": \"Insert Progress Row\", \"type\": \"main\", \"index\": 0 }]]\n    }\n  },\n  \"settings\": {}\n}\n","F-30-flow-progress-poll.json":"{\n  \"name\": \"F-30 Flow Progress Poll\",\n  \"nodes\": [\n    {\n      \"id\": \"a1b2c3d4-0030-4001-8001-000000000001\",\n      \"name\": \"Webhook Trigger\",\n      \"type\": \"n8n-nodes-base.webhook\",\n      \"typeVersion\": 2,\n      \"position\": [240, 300],\n      \"parameters\": {\n        \"path\": \"flow-progress-poll\",\n        \"httpMethod\": \"GET\",\n        \"responseMode\": \"lastNode\"\n      },\n      \"webhookId\": \"b7a1c5e2-0030-4001-8001-000000000001\"\n    },\n    {\n      \"id\": \"a1b2c3d4-0030-4001-8001-000000000002\",\n      \"name\": \"Select Progress Rows\",\n      \"type\": \"n8n-nodes-base.postgres\",\n      \"typeVersion\": 2.7,\n      \"position\": [460, 300],\n      \"parameters\": {\n        \"operation\": \"executeQuery\",\n        \"query\": \"SELECT message, notes, created_at FROM sdlc_flow_progress WHERE flow_id = $1 AND created_at \u003e $2 ORDER BY created_at ASC\",\n        \"options\": {\n          \"queryReplacement\": \"={{ [$json.query.flow_id ?? '', $json.query.since ?? '1970-01-01T00:00:00Z'] }}\"\n        }\n      },\n      \"credentials\": {\n        \"postgres\": {\n          \"id\": \"fsyufCBhX6sCVQpV\",\n          \"name\": \"SDLC Progress Postgres\"\n        }\n      }\n    }\n  ],\n  \"connections\": {\n    \"Webhook Trigger\": {\n      \"main\": [[{ \"node\": \"Select Progress Rows\", \"type\": \"main\", \"index\": 0 }]]\n    }\n  },\n  \"settings\": {}\n}\n","F-31-spawn-agent-role.json":"{\n  \"name\": \"F-31 Spawn Agent Role\",\n  \"nodes\": [\n    {\n      \"id\": \"f31-0001-0000-0000-000000000001\",\n      \"name\": \"Execute Workflow Trigger\",\n      \"type\": \"n8n-nodes-base.executeWorkflowTrigger\",\n      \"typeVersion\": 1.2,\n      \"position\": [\n        240,\n        300\n      ],\n      \"parameters\": {\n        \"inputSource\": \"passthrough\"\n      }\n    },\n    {\n      \"id\": \"f31-0001-0000-0000-000000000002\",\n      \"name\": \"Build Job Manifest\",\n      \"type\": \"n8n-nodes-base.code\",\n      \"typeVersion\": 1,\n      \"position\": [\n        460,\n        300\n      ],\n      \"parameters\": {\n        \"mode\": \"runOnceForAllItems\",\n        \"jsCode\": \"const role = $json.role;\\nconst prompt = $json.prompt;\\nconst story = (($json.story) || 'adhoc').toString().toLowerCase().replace(/[^a-z0-9-]/g, '-');\\nconst ts = new Date().toISOString().replace(/[-:.]/g, '').replace('Z', '').slice(0, 14);\\nlet jobName = `claude-${role}-${story}-${ts}`.toLowerCase().replace(/[^a-z0-9-]/g, '-');\\nconst rand = Math.random().toString(36).slice(2, 6);\\njobName = (jobName + '-' + rand).slice(0, 63).replace(/-+$/, '');\\nconst autonomyPrefix = 'You are running headless with no user available to answer questions or confirmations. glab is already authenticated for this GitLab host (gitlab-webservice-default.gitlab.svc.cluster.local:8181, http protocol) via a prior `glab auth login` that already succeeded — do not ask for clarification or report that you lack access. If a glab/git command errors, do not assume auth or network is broken: run `glab api user --hostname gitlab-webservice-default.gitlab.svc.cluster.local` to verify first, then retry the original command with corrected syntax/args before concluding anything is unreachable. Do not write status/handoff/README files describing a blocker instead of doing the task — either complete the task for real or, only after the verify-and-retry step above still fails, say exactly what command you ran and what error it returned. ';\\nconst promptEscaped = String(autonomyPrefix + prompt).replace(/'/g, \\\"'\\\\\\\\''\\\");\\n\\nconst GITLAB_HOST = 'gitlab-webservice-default.gitlab.svc.cluster.local';\\nconst GITLAB_API_HOST = `${GITLAB_HOST}:8181`;\\n// ponytail: glab treats a bare GITLAB_TOKEN env var as a global override for\\n// EVERY host (including defaulting to gitlab.com), which 401s there instead\\n// of using our in-cluster instance. Feed the secret in as GL_TOKEN_RAW,\\n// consume it once into glab's own config via `auth login`, then unset it.\\n//\\n// ponytail: GL_TOKEN_RAW is resolved shell-side from GL_TOKEN_ROLE (this\\n// role's own minted PAT, from the omp-role-gitlab-tokens Secret --\\n// optional, only present once helm/ansible/playbooks/role-accounts.yml has\\n// been run) falling back to GL_TOKEN_SHARED (the one admin PAT every pod\\n// used before) -- without this, every commit/MR gets authored as whoever\\n// var.omp_gitlab_token belongs to, regardless of the `--assignee\\n// \\\"\u003crole\u003e\\\"` cosmetic field every SKILL.md already sets (found live: a\\n// dry-run MR showed up as the human operator's own GitLab account).\\nconst resolveGlToken = `GL_TOKEN_RAW=\\\"\\\\${GL_TOKEN_ROLE:-$GL_TOKEN_SHARED}\\\"`;\\nconst glabLogin = `${resolveGlToken}; glab auth login --hostname ${GITLAB_HOST} --token \\\\\\\"$GL_TOKEN_RAW\\\\\\\" --api-host ${GITLAB_API_HOST} --api-protocol http --git-protocol http \u003e/dev/null 2\u003e\u00261; glab config set host ${GITLAB_HOST} -g \u003e/dev/null 2\u003e\u00261`;\\n\\n// ponytail: KN_TOKEN_ROLE is this role's own minted Kaneo API key (from the\\n// omp-role-kaneo-tokens Secret -- optional, only present once\\n// helm/ansible/playbooks/role-accounts.yml has been run), falling back to\\n// KANEO_TOKEN_SHARED (one admin key every pod used before). Same split as\\n// GL_TOKEN_ROLE/GL_TOKEN_SHARED above, for the same reason: without a real\\n// per-role credential, every Kaneo call would be attributable only to\\n// whoever var.kaneo_api_token belongs to. EXPORTed (unlike GL_TOKEN_RAW,\\n// which glab persists to its own config file) because every role's\\n// SKILL.md curl examples read $KANEO_TOKEN directly -- those run as Bash\\n// tool calls spawned by the claude process below, which only inherit env\\n// vars actually exported into this shell, not shell-local assignments.\\nconst resolveKnToken = `export KANEO_TOKEN=\\\"\\\\${KN_TOKEN_ROLE:-$KANEO_TOKEN_SHARED}\\\"`;\\n\\n// ponytail: kaneo MCP server, in-cluster address (mirrors mcp-servers-gitlab's\\n// own DNS-rebind-guard reasoning) — written to a file at container start since\\n// the bearer token comes from a Secret env var, not something Helm can bake\\n// into a static ConfigMap-mounted mcp-config.json. Single-quoted JSON skeleton\\n// with the token spliced in via the standard '...'\\\"$VAR\\\"'...' shell trick\\n// (close single-quote, expand inside double-quotes, reopen single-quote) — no\\n// nested-quote escaping needed since none of these tokens ever collide.\\n// kaneo-mcp has no credential of its own -- it forwards this exact bearer\\n// straight through to Kaneo's API, so this role's real per-role API key is\\n// the identity on every call it makes (see helm/mcp-servers/kaneo-mcp).\\n// mcp__kaneo__* in --allowedTools below is Claude Code's own MCP tool-naming\\n// convention (mcp__\u003cserver-name\u003e__\u003ctool-name\u003e).\\nconst mcpConfigCmd = `echo '{\\\"mcpServers\\\":{\\\"kaneo\\\":{\\\"type\\\":\\\"http\\\",\\\"url\\\":\\\"http://mcp-servers-kaneo.mcp-servers.svc.cluster.local:8300/mcp\\\",\\\"headers\\\":{\\\"Authorization\\\":\\\"Bearer '\\\"$KANEO_TOKEN\\\"'\\\"}},\\\"sonarqube\\\":{\\\"type\\\":\\\"http\\\",\\\"url\\\":\\\"http://mcp-servers-sonarqube.mcp-servers.svc.cluster.local:8080/mcp\\\",\\\"headers\\\":{\\\"Authorization\\\":\\\"Bearer '\\\"$SONARQUBE_MCP_AUTH_TOKEN\\\"'\\\"}}}}' \u003e /tmp/mcp-config.json`;\\n\\n// ponytail: haiku sometimes reports \\\"done\\\" without actually publishing the\\n// artifact it was told to. Hard-fail the Job when the outcome is\\n// mechanically checkable so a silent no-op shows up as a Job failure\\n// instead of a false Complete. Extend this map as more roles get one.\\nconst rawStory = ($json.story || 'adhoc').toString();\\n// ponytail: wiki verify targets GitLab's own per-project wiki (Kaneo has no\\n// wiki module at all -- see AGENT.md's \\\"Kaneo\\\" section). GitLab wiki slugs\\n// keep '/' as a literal hierarchy separator (no '.'/'/' mangling like\\n// Taiga's did), but DO need percent-encoding in the URL path segment.\\nconst wikiSlugByRole = { architect: `${rawStory}/Architecture` };\\nconst wikiSlug = $json.skipWikiVerify ? undefined : wikiSlugByRole[role];\\nconst verifyCmd = wikiSlug\\n  ? `; if [ \\\\\\\"$cstatus\\\\\\\" = \\\\\\\"0\\\\\\\" ]; then wcode=$(curl -s -o /dev/null -w '%{http_code}' -H \\\\\\\"Authorization: Bearer $GL_TOKEN_RAW\\\\\\\" \\\\\\\"http://${GITLAB_API_HOST}/api/v4/projects/$GITLAB_PROJECT_ID/wikis/$(echo -n '${wikiSlug}' | sed 's#/#%2F#g')\\\\\\\"); if [ \\\\\\\"$wcode\\\\\\\" != \\\\\\\"200\\\\\\\" ]; then echo \\\\\\\"VERIFY FAILED: GitLab wiki page ${wikiSlug} not found (HTTP $wcode)\\\\\\\" \u003e\u00262; cstatus=1; fi; fi`\\n  : '';\\n\\nconst manifest = {\\n  apiVersion: 'batch/v1',\\n  kind: 'Job',\\n  metadata: {\\n    name: jobName,\\n    namespace: 'sdlc',\\n    labels: { 'app.kubernetes.io/name': 'omp-agent', 'omp-role': role }\\n  },\\n  spec: {\\n    ttlSecondsAfterFinished: 1800,\\n    backoffLimit: 1,\\n    template: {\\n      metadata: { labels: { 'app.kubernetes.io/name': 'omp-agent', 'omp-role': role, 'job-name': jobName } },\\n      spec: {\\n        restartPolicy: 'Never',\\n        serviceAccountName: 'omp-agent',\\n        containers: [{\\n      name: 'claude',\\n      image: 'k3d-registry:5111/omp-box:dev',\\n      imagePullPolicy: 'Always',\\n      command: ['sh', '-c'],\\n      args: [`${glabLogin}; ${resolveKnToken}; ${mcpConfigCmd}; claude -p '${promptEscaped}' --model sonnet --mcp-config /tmp/mcp-config.json --allowedTools 'Bash,Edit,Write,Read,Glob,Grep,mcp__kaneo__kaneo_get,mcp__kaneo__kaneo_post,mcp__kaneo__kaneo_patch,mcp__kaneo__kaneo_delete,mcp__sonarqube__analyze_code_snippet,mcp__sonarqube__search_sonar_issues_in_projects,mcp__sonarqube__get_project_quality_gate_status,mcp__sonarqube__show_rule,mcp__sonarqube__search_my_sonarqube_projects' --permission-mode acceptEdits --no-session-persistence; cstatus=$?${verifyCmd}; unset GL_TOKEN_RAW GL_TOKEN_ROLE GL_TOKEN_SHARED KN_TOKEN_ROLE KANEO_TOKEN KANEO_TOKEN_SHARED SONARQUBE_MCP_AUTH_TOKEN; exit $cstatus`],\\n      env: [\\n        { name: 'CLAUDE_CODE_OAUTH_TOKEN', valueFrom: { secretKeyRef: { name: 'omp-agent-secrets', key: 'claude_code_token' } } },\\n        { name: 'GL_TOKEN_ROLE', valueFrom: { secretKeyRef: { name: 'omp-role-gitlab-tokens', key: role, optional: true } } },\\n        { name: 'GL_TOKEN_SHARED', valueFrom: { secretKeyRef: { name: 'omp-agent-secrets', key: 'gitlab_token' } } },\\n        { name: 'KN_TOKEN_ROLE', valueFrom: { secretKeyRef: { name: 'omp-role-kaneo-tokens', key: role, optional: true } } },\\n        { name: 'KANEO_TOKEN_SHARED', valueFrom: { secretKeyRef: { name: 'omp-agent-secrets', key: 'kaneo_token' } } },\\n        { name: 'KANEO_URL', valueFrom: { secretKeyRef: { name: 'omp-agent-secrets', key: 'kaneo_url' } } },\\n        { name: 'GRAFANA_URL', valueFrom: { secretKeyRef: { name: 'omp-agent-secrets', key: 'grafana_url' } } },\\n        { name: 'SONARQUBE_MCP_AUTH_TOKEN', valueFrom: { secretKeyRef: { name: 'omp-agent-secrets', key: 'sonarqube_mcp_auth_token' } } },\\n        { name: 'KANEO_PROJECT_ID', value: String($json.kaneo_project_id || $env.KANEO_PROJECT_ID || '') },\\n        { name: 'KANEO_WORKSPACE_ID', value: String($json.kaneo_workspace_id || $env.KANEO_WORKSPACE_ID || '') },\\n        { name: 'GITLAB_PROJECT_ID', value: String($json.gitlab_project_id || $env.GITLAB_PROJECT_ID || '') },\\n        { name: 'NEXTCLOUD_URL', valueFrom: { secretKeyRef: { name: 'omp-agent-secrets', key: 'nextcloud_url' } } },\\n        { name: 'NEXTCLOUD_USER', valueFrom: { secretKeyRef: { name: 'omp-agent-secrets', key: 'nextcloud_user' } } },\\n        { name: 'NEXTCLOUD_PASSWORD', valueFrom: { secretKeyRef: { name: 'omp-agent-secrets', key: 'nextcloud_password' } } },\\n        { name: 'MINIO_ENDPOINT', valueFrom: { secretKeyRef: { name: 'omp-agent-secrets', key: 'minio_endpoint' } } },\\n        { name: 'MINIO_ROOT_USER', valueFrom: { secretKeyRef: { name: 'omp-agent-secrets', key: 'minio_root_user' } } },\\n        { name: 'MINIO_ROOT_PASSWORD', valueFrom: { secretKeyRef: { name: 'omp-agent-secrets', key: 'minio_root_password' } } }\\n      ]\\n    }]\\n      }\\n    }\\n  }\\n};\\n\\nreturn [{ json: { jobName, manifest } }];\"\n      }\n    },\n    {\n      \"id\": \"f31-0001-0000-0000-000000000003\",\n      \"name\": \"Read SA Token\",\n      \"type\": \"n8n-nodes-base.executeCommand\",\n      \"typeVersion\": 1,\n      \"position\": [\n        680,\n        300\n      ],\n      \"parameters\": {\n        \"command\": \"cat /var/run/secrets/kubernetes.io/serviceaccount/token\"\n      }\n    },\n    {\n      \"id\": \"f31-0001-0000-0000-000000000004\",\n      \"name\": \"Create Job\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4.2,\n      \"position\": [\n        900,\n        300\n      ],\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"https://kubernetes.default.svc/apis/batch/v1/namespaces/sdlc/jobs\",\n        \"authentication\": \"none\",\n        \"sendHeaders\": true,\n        \"specifyHeaders\": \"keypair\",\n        \"headerParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"Authorization\",\n              \"value\": \"=Bearer {{ $node[\\\"Read SA Token\\\"].json.stdout.trim() }}\"\n            },\n            {\n              \"name\": \"Content-Type\",\n              \"value\": \"application/json\"\n            }\n          ]\n        },\n        \"sendBody\": true,\n        \"contentType\": \"json\",\n        \"specifyBody\": \"json\",\n        \"jsonBody\": \"={{ $node[\\\"Build Job Manifest\\\"].json.manifest }}\",\n        \"options\": {\n          \"allowUnauthorizedCerts\": true\n        }\n      }\n    },\n    {\n      \"id\": \"f31-0001-0000-0000-00000000000b\",\n      \"name\": \"Set Deadline\",\n      \"type\": \"n8n-nodes-base.code\",\n      \"typeVersion\": 1,\n      \"position\": [\n        1010,\n        300\n      ],\n      \"parameters\": {\n        \"mode\": \"runOnceForAllItems\",\n        \"jsCode\": \"// ponytail: single wall-clock deadline set once, looked up by node name\\n// from every loop iteration below (not carried through item json, which\\n// Get Job Status overwrites each pass with the raw k8s API response).\\nreturn [{ json: { deadline: Date.now() + 20 * 60 * 1000 } }];\"\n      }\n    },\n    {\n      \"id\": \"f31-0001-0000-0000-000000000005\",\n      \"name\": \"Wait For Job\",\n      \"type\": \"n8n-nodes-base.wait\",\n      \"typeVersion\": 1.1,\n      \"position\": [\n        1120,\n        300\n      ],\n      \"parameters\": {\n        \"resume\": \"timeInterval\",\n        \"amount\": 15,\n        \"unit\": \"seconds\"\n      },\n      \"webhookId\": \"f31wait0-0000-0000-0000-000000000001\"\n    },\n    {\n      \"id\": \"f31-0001-0000-0000-000000000006\",\n      \"name\": \"Get Job Status\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4.2,\n      \"position\": [\n        1340,\n        300\n      ],\n      \"parameters\": {\n        \"method\": \"GET\",\n        \"url\": \"=https://kubernetes.default.svc/apis/batch/v1/namespaces/sdlc/jobs/{{ $node[\\\"Build Job Manifest\\\"].json.jobName }}\",\n        \"authentication\": \"none\",\n        \"sendHeaders\": true,\n        \"specifyHeaders\": \"keypair\",\n        \"headerParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"Authorization\",\n              \"value\": \"=Bearer {{ $node[\\\"Read SA Token\\\"].json.stdout.trim() }}\"\n            }\n          ]\n        },\n        \"options\": {\n          \"allowUnauthorizedCerts\": true\n        }\n      }\n    },\n    {\n      \"id\": \"f31-0001-0000-0000-00000000000c\",\n      \"name\": \"Job Done or Timed Out?\",\n      \"type\": \"n8n-nodes-base.if\",\n      \"typeVersion\": 2.2,\n      \"position\": [\n        1450,\n        300\n      ],\n      \"parameters\": {\n        \"conditions\": {\n          \"options\": {\n            \"caseSensitive\": true,\n            \"leftValue\": \"\",\n            \"typeValidation\": \"loose\"\n          },\n          \"combinator\": \"or\",\n          \"conditions\": [\n            {\n              \"leftValue\": \"={{ ($json.status.succeeded || 0) \u003e= 1 }}\",\n              \"rightValue\": \"\",\n              \"operator\": {\n                \"type\": \"boolean\",\n                \"operation\": \"true\",\n                \"singleValue\": true\n              }\n            },\n            {\n              \"leftValue\": \"={{ ($json.status.failed || 0) \u003e 1 }}\",\n              \"rightValue\": \"\",\n              \"operator\": {\n                \"type\": \"boolean\",\n                \"operation\": \"true\",\n                \"singleValue\": true\n              }\n            },\n            {\n              \"leftValue\": \"={{ Date.now() \u003e $node[\\\"Set Deadline\\\"].json.deadline }}\",\n              \"rightValue\": \"\",\n              \"operator\": {\n                \"type\": \"boolean\",\n                \"operation\": \"true\",\n                \"singleValue\": true\n              }\n            }\n          ]\n        }\n      }\n    },\n    {\n      \"id\": \"f31-0001-0000-0000-000000000007\",\n      \"name\": \"List Job Pods\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4.2,\n      \"position\": [\n        1560,\n        300\n      ],\n      \"parameters\": {\n        \"method\": \"GET\",\n        \"url\": \"=https://kubernetes.default.svc/api/v1/namespaces/sdlc/pods?labelSelector=job-name={{ $node[\\\"Build Job Manifest\\\"].json.jobName }}\",\n        \"authentication\": \"none\",\n        \"sendHeaders\": true,\n        \"specifyHeaders\": \"keypair\",\n        \"headerParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"Authorization\",\n              \"value\": \"=Bearer {{ $node[\\\"Read SA Token\\\"].json.stdout.trim() }}\"\n            }\n          ]\n        },\n        \"options\": {\n          \"allowUnauthorizedCerts\": true\n        }\n      }\n    },\n    {\n      \"id\": \"f31-0001-0000-0000-000000000008\",\n      \"name\": \"Extract Pod Name\",\n      \"type\": \"n8n-nodes-base.code\",\n      \"typeVersion\": 1,\n      \"position\": [\n        1780,\n        300\n      ],\n      \"parameters\": {\n        \"mode\": \"runOnceForAllItems\",\n        \"jsCode\": \"const items = ($json.items) || [];\\nconst podName = items.length ? items[0].metadata.name : '';\\nreturn [{ json: { podName } }];\"\n      }\n    },\n    {\n      \"id\": \"f31-0001-0000-0000-000000000009\",\n      \"name\": \"Get Pod Logs\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4.2,\n      \"position\": [\n        2000,\n        300\n      ],\n      \"parameters\": {\n        \"method\": \"GET\",\n        \"url\": \"=https://kubernetes.default.svc/api/v1/namespaces/sdlc/pods/{{ $json.podName }}/log\",\n        \"authentication\": \"none\",\n        \"sendHeaders\": true,\n        \"specifyHeaders\": \"keypair\",\n        \"headerParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"Authorization\",\n              \"value\": \"=Bearer {{ $node[\\\"Read SA Token\\\"].json.stdout.trim() }}\"\n            }\n          ]\n        },\n        \"options\": {\n          \"allowUnauthorizedCerts\": true,\n          \"response\": {\n            \"response\": {\n              \"responseFormat\": \"text\"\n            }\n          }\n        }\n      }\n    },\n    {\n      \"id\": \"f31-0001-0000-0000-00000000000a\",\n      \"name\": \"Format Output\",\n      \"type\": \"n8n-nodes-base.code\",\n      \"typeVersion\": 1,\n      \"position\": [\n        2220,\n        300\n      ],\n      \"parameters\": {\n        \"mode\": \"runOnceForAllItems\",\n        \"jsCode\": \"const status = $node[\\\"Get Job Status\\\"].json.status || {};\\nconst succeeded = (status.succeeded || 0) \u003e= 1;\\nconst failed = (status.failed || 0) \u003e= 1;\\nconst jobName = $node[\\\"Build Job Manifest\\\"].json.jobName;\\nconst output = $json.data !== undefined ? $json.data : ($json.body !== undefined ? $json.body : JSON.stringify($json));\\nreturn [{ json: { jobName, succeeded, failed, output } }];\"\n      }\n    }\n  ],\n  \"connections\": {\n    \"Execute Workflow Trigger\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Build Job Manifest\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Build Job Manifest\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Read SA Token\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Read SA Token\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Create Job\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Create Job\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Set Deadline\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Set Deadline\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Wait For Job\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Wait For Job\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Get Job Status\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Get Job Status\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Job Done or Timed Out?\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Job Done or Timed Out?\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"List Job Pods\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ],\n        [\n          {\n            \"node\": \"Wait For Job\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"List Job Pods\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Extract Pod Name\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Extract Pod Name\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Get Pod Logs\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Get Pod Logs\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Format Output\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    }\n  },\n  \"settings\": {}\n}","bind-mm-cred.py":"#!/usr/bin/env python3\n\"\"\"Point every seeded workflow's `mattermostApi` node at a real credential.\n\nThe flow JSON files carry a placeholder credential ref (`id: mm-creds`). n8n's\npublic API can't create a credential with a chosen id and can't list existing\nones, so playbooks/mattermost.yml creates the credential fresh, then runs this\nto rebind the seeded workflows to whatever id it got.\n\nEnv:\n  N8N_URL        base url (e.g. http://n8n.n8n.svc.cluster.local:5678)\n  N8N_API_KEY    public API key\n  MM_CRED_ID     credential id to bind\n  MM_CRED_NAME   credential name (default \"Mattermost SDLC Bot\")\n\nponytail: stdlib only, runs in the alpine ansible runner. Idempotent — a\nre-run just re-writes the same id.\n\"\"\"\nimport json\nimport os\nimport sys\nimport urllib.error\nimport urllib.request\n\nBASE = os.environ[\"N8N_URL\"].rstrip(\"/\")\nKEY = os.environ[\"N8N_API_KEY\"]\nCRED_ID = os.environ[\"MM_CRED_ID\"]\nCRED_NAME = os.environ.get(\"MM_CRED_NAME\", \"Mattermost SDLC Bot\")\n\n\ndef api(method, path, body=None):\n    req = urllib.request.Request(\n        BASE + path,\n        method=method,\n        headers={\"X-N8N-API-KEY\": KEY, \"Content-Type\": \"application/json\"},\n        data=json.dumps(body).encode() if body is not None else None,\n    )\n    with urllib.request.urlopen(req, timeout=30) as resp:\n        return json.load(resp)\n\n\ndef main():\n    workflows = api(\"GET\", \"/api/v1/workflows?limit=250\").get(\"data\", [])\n    bound = 0\n    for wf in workflows:\n        full = api(\"GET\", f\"/api/v1/workflows/{wf['id']}\")\n        touched = False\n        for node in full.get(\"nodes\", []):\n            creds = node.get(\"credentials\") or {}\n            if \"mattermostApi\" in creds:\n                creds[\"mattermostApi\"] = {\"id\": CRED_ID, \"name\": CRED_NAME}\n                node[\"credentials\"] = creds\n                touched = True\n        if not touched:\n            continue\n        payload = {k: full[k] for k in (\"name\", \"nodes\", \"connections\", \"settings\") if k in full}\n        api(\"PUT\", f\"/api/v1/workflows/{wf['id']}\", payload)\n        if full.get(\"active\"):\n            try:\n                api(\"POST\", f\"/api/v1/workflows/{wf['id']}/activate\")\n            except urllib.error.HTTPError:\n                pass\n        bound += 1\n        print(f\"  bound: {full['name']}\")\n    print(f\"{bound} workflow(s) bound to credential {CRED_ID} ({CRED_NAME})\")\n\n\nif __name__ == \"__main__\":\n    try:\n        main()\n    except urllib.error.HTTPError as e:\n        sys.exit(f\"n8n API {e.code}: {e.read().decode()[:300]}\")\n","seed.sh":"#!/usr/bin/env bash\n# seed.sh — seeds all 28 SDLC n8n flows via n8n REST API\n# Flows use Mattermost slash commands for user-invoked phases.\n# GitLab/CI events remain as webhooks.\n#\n# Usage:\n#   N8N_URL=http://localhost:5678 N8N_API_KEY=your-key ./seed.sh [--force]\n\nset -euo pipefail\n\nN8N_URL=\"${N8N_URL:-http://localhost:5678}\"\nN8N_API_KEY=\"${N8N_API_KEY:?N8N_API_KEY is required}\"\nSCRIPT_DIR=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" \u0026\u0026 pwd)\"\n\ncat \u003c\u003c 'SETUP'\n================================\nn8n SDLC Flow Seeder — Mattermost edition\n================================\n\nMATTERMOST SETUP (required before flows work):\n\n1. Create a Bot account in Mattermost:\n   System Console → Integrations → Bot Accounts → Add Bot\n   Username: sdlc-bot\n   Copy the Bot Access Token\n\n2. Add n8n credential:\n   n8n → Credentials → New → Mattermost API\n   Name: \"Mattermost SDLC Bot\"\n   Access Token: (paste Bot Access Token)\n   Base URL: https://mattermost.yourdomain.com\n\n3. Register slash commands in Mattermost:\n   Main Menu → Integrations → Slash Commands → Add Slash Command\n\n   Command        → Request URL\n   /plan_release  → https://n8n.yourdomain.com/webhook/mm-plan_release\n   /kickoff       → https://n8n.yourdomain.com/webhook/mm-kickoff\n   /develop       → https://n8n.yourdomain.com/webhook/mm-develop\n   /uat           → https://n8n.yourdomain.com/webhook/mm-uat\n   /release_staging     → https://n8n.yourdomain.com/webhook/mm-release_staging\n   /release_production  → https://n8n.yourdomain.com/webhook/mm-release_production\n   /rollback      → https://n8n.yourdomain.com/webhook/mm-rollback\n   /rollback_story → https://n8n.yourdomain.com/webhook/mm-rollback_story\n   /retro         → https://n8n.yourdomain.com/webhook/mm-retro\n   /projects      → https://n8n.yourdomain.com/webhook/mm-projects\n\n   For each command:\n     Request method: POST\n     Response username: sdlc-bot\n     Autocomplete: enabled (add description)\n\n4. Add bot to your SDLC channel:\n   /invite @sdlc-bot\n\n5. Set env vars in n8n Settings → Variables:\n   MM_SDLC_CHANNEL = your-channel-id  (find in channel URL or API)\n   MM_BASE_URL     = https://mattermost.yourdomain.com\n   GITLAB_URL, GITLAB_TOKEN, GITLAB_PROJECT_ID\n   N8N_WEBHOOK_BASE, GITLAB_WEBHOOK_SECRET\n   ARGOCD_URL, ARGOCD_PROJECT\n   RELEASE_VERSION (the release ticket itself is looked up dynamically by\n   `type::release` label + milestone — never set a static RELEASE_TICKET_ID)\n\n6. Chat with omp (flow F-28) — the sdlc-svc user, the 'ai' channel, the\n   outgoing webhook, and the n8n credential are all created by\n   playbooks/mattermost.yml:\n     scripts/ansible-run.sh mattermost\n   Then in the 'ai' channel type:  omp \u003cyour question\u003e\n   (trigger word 'omp' — mmctl's create-outgoing needs one). First message\n   after the omp pod idles waits ~30-120s for scale-up + model load.\n\n7. GitLab group webhook -\u003e n8n F-00 router. Registered automatically by the\n   DevOps pod at /kickoff; for bootstrap / disaster recovery run:\n     scripts/ansible-run.sh gitlab-webhook\n   URL: \u003cn8n\u003e/webhook/gitlab-events, events: Merge requests + Pipelines,\n   secret: TF_VAR_gitlab_webhook_secret (same value F-00 verifies against).\n\nSETUP\n\necho \"\"\n\n# Wait for n8n\necho \"Waiting for n8n to be ready...\"\nfor i in {1..30}; do\n  if curl -sf \"$N8N_URL/healthz\" \u003e /dev/null 2\u003e\u00261; then\n    echo \"n8n is ready.\"\n    break\n  fi\n  echo \"  attempt $i/30 ...\"\n  sleep 5\ndone\n\n# True upsert: fetch every existing workflow's id+name once, keyed by name,\n# so re-running this script always applies edits to the SAME workflow\n# instead of bailing out (old behavior) or POSTing a same-name duplicate\n# (old --force behavior). n8n's list endpoint pages at 100 by default and\n# there are ~29 flows, so one page is enough — pagination added anyway in\n# case flows grow past that.\necho \"Fetching existing workflows for upsert lookup...\"\n: \u003e /tmp/n8n-existing.json\nCURSOR=\"\"\nwhile :; do\n  URL=\"$N8N_URL/api/v1/workflows?limit=100\"\n  [ -n \"$CURSOR\" ] \u0026\u0026 URL=\"$URL\u0026cursor=$CURSOR\"\n  PAGE=$(curl -sf -H \"X-N8N-API-KEY: $N8N_API_KEY\" \"$URL\")\n  echo \"$PAGE\" | python3 -c \"\nimport json,sys\nd = json.load(sys.stdin)\nfor wf in d.get('data', []):\n    print(wf['name'] + '\\t' + str(wf['id']))\n\" \u003e\u003e /tmp/n8n-existing.json\n  CURSOR=$(echo \"$PAGE\" | python3 -c \"import json,sys; print(json.load(sys.stdin).get('nextCursor') or '')\")\n  [ -z \"$CURSOR\" ] \u0026\u0026 break\ndone\nEXISTING_COUNT=$(wc -l \u003c /tmp/n8n-existing.json)\necho \"Found $EXISTING_COUNT existing workflow(s).\"\n\nSUCCESS=0\nFAILED=0\n# ponytail: filenames verified against actual webhook `path` values each\n# flow uses and what F-00/F-10 actually call by URL — this directory has\n# several stale duplicate/renamed leftovers (e.g. F-07-flow.json,\n# F-23-revert-mr-merged.json) that do NOT match what the live dispatchers\n# call. Don't \"fix\" a filename here without re-checking the caller's URL.\nFLOWS=(\n  \"F-00-gitlab-event-router.json\"\n  \"F-01-plan-release.json\"\n  \"F-02-kickoff.json\"\n  \"F-03-develop.json\"\n  \"F-04-task-mr-opened.json\"\n  \"F-05-task-mr-merged.json\"\n  \"F-06-dod-check.json\"\n  \"F-07-story-mr-open.json\"\n  \"F-08-story-mr-merged.json\"\n  \"F-09-ci-pipeline.json\"\n  \"F-10-uat.json\"\n  \"F-11-uat-qa.json\"\n  \"F-12-uat-security.json\"\n  \"F-13-uat-po.json\"\n  \"F-14-release-staging.json\"\n  \"F-15-staging-deployed.json\"\n  \"F-16-go-nogo.json\"\n  \"F-17-release-production.json\"\n  \"F-18-release-mr-merged.json\"\n  \"F-19-production-deployed.json\"\n  \"F-20-monitoring-window.json\"\n  \"F-21-rollback.json\"\n  \"F-22-rollback-story.json\"\n  \"F-23-revert-merged.json\"\n  \"F-24-retro.json\"\n  \"F-25-escalate.json\"\n  \"F-26-projects.json\"\n  \"F-27-cluster-lifecycle.json\"\n  \"F-28-chat.json\"\n  \"F-29-flow-progress-sink.json\"\n  \"F-30-flow-progress-poll.json\"\n  \"F-31-spawn-agent-role.json\"\n)\n\nfor flow_file in \"${FLOWS[@]}\"; do\n  flow_path=\"$SCRIPT_DIR/$flow_file\"\n  if [ ! -f \"$flow_path\" ]; then\n    echo \"  SKIP: $flow_file (not found)\"\n    continue\n  fi\n  flow_name=$(python3 -c \"import json; print(json.load(open('$flow_path')).get('name','?'))\")\n\n  # Look up existing workflow by exact name (tab-separated name\u003cTAB\u003eid lines).\n  EXISTING_ID=$(awk -F'\\t' -v n=\"$flow_name\" '$1==n {print $2; exit}' /tmp/n8n-existing.json)\n\n  # n8n 2.x public API rejects read-only keys (active, tags, id, ...) on\n  # create AND update. Keep only the writable fields either way.\n  python3 -c \"import json,sys; d=json.load(open('$flow_path')); json.dump({k:d[k] for k in ('name','nodes','connections','settings','staticData') if k in d}, open('/tmp/n8n-seed-body.json','w'))\"\n\n  if [ -n \"$EXISTING_ID\" ]; then\n    echo -n \"  Updating: $flow_name (id: $EXISTING_ID) ... \"\n    HTTP_CODE=$(curl -s -o /tmp/n8n-seed-resp.json -w \"%{http_code}\" \\\n      -X PUT \"$N8N_URL/api/v1/workflows/$EXISTING_ID\" \\\n      -H \"X-N8N-API-KEY: $N8N_API_KEY\" \\\n      -H \"Content-Type: application/json\" \\\n      -d @/tmp/n8n-seed-body.json)\n    if [ \"$HTTP_CODE\" -eq 200 ]; then\n      echo \"OK (updated, id: $EXISTING_ID)\"\n      # ponytail: n8n deactivates a workflow's webhook registration on PUT\n      # even when content didn't structurally change — re-activate every\n      # update, not just creates, or the workflow silently stops answering\n      # its webhook until someone notices.\n      curl -sf -X POST \"$N8N_URL/api/v1/workflows/$EXISTING_ID/activate\" \\\n        -H \"X-N8N-API-KEY: $N8N_API_KEY\" \u003e /dev/null 2\u003e\u00261 \\\n        \u0026\u0026 echo \"    → activated\" || echo \"    → activation failed (activate manually)\"\n      SUCCESS=$((SUCCESS+1))\n    else\n      echo \"FAILED (HTTP $HTTP_CODE)\"\n      python3 -m json.tool /tmp/n8n-seed-resp.json 2\u003e/dev/null || true\n      FAILED=$((FAILED+1))\n    fi\n  else\n    echo -n \"  Creating: $flow_name ... \"\n    HTTP_CODE=$(curl -s -o /tmp/n8n-seed-resp.json -w \"%{http_code}\" \\\n      -X POST \"$N8N_URL/api/v1/workflows\" \\\n      -H \"X-N8N-API-KEY: $N8N_API_KEY\" \\\n      -H \"Content-Type: application/json\" \\\n      -d @/tmp/n8n-seed-body.json)\n    if [ \"$HTTP_CODE\" -eq 200 ] || [ \"$HTTP_CODE\" -eq 201 ]; then\n      WF_ID=$(python3 -c \"import json; print(json.load(open('/tmp/n8n-seed-resp.json')).get('id','?'))\" 2\u003e/dev/null || echo \"?\")\n      echo \"OK (created, id: $WF_ID)\"\n      if [ \"$WF_ID\" != \"?\" ]; then\n        curl -sf -X POST \"$N8N_URL/api/v1/workflows/$WF_ID/activate\" \\\n          -H \"X-N8N-API-KEY: $N8N_API_KEY\" \u003e /dev/null 2\u003e\u00261 \\\n          \u0026\u0026 echo \"    → activated\" || echo \"    → activation failed (activate manually)\"\n      fi\n      SUCCESS=$((SUCCESS+1))\n    else\n      echo \"FAILED (HTTP $HTTP_CODE)\"\n      python3 -m json.tool /tmp/n8n-seed-resp.json 2\u003e/dev/null || true\n      FAILED=$((FAILED+1))\n    fi\n  fi\ndone\n\necho \"\"\necho \"================================\"\necho \"Seeding complete: $SUCCESS OK  $FAILED failed\"\necho \"================================\"\necho \"\"\necho \"Slash command → webhook path mapping:\"\necho \"  /plan_release        → /webhook/mm-plan_release   (F-01)\"\necho \"  /kickoff             → /webhook/mm-kickoff        (F-02)\"\necho \"  /develop             → /webhook/mm-develop        (F-03)\"\necho \"  /uat                 → /webhook/mm-uat            (F-10)\"\necho \"  /release_staging     → /webhook/mm-release_staging (F-14)\"\necho \"  /release_production  → /webhook/mm-release_production (F-17)\"\necho \"  /rollback            → /webhook/mm-rollback       (F-21)\"\necho \"  /rollback_story      → /webhook/mm-rollback_story (F-22)\"\necho \"  /retro               → /webhook/mm-retro          (F-24)\"\necho \"  /projects            → /webhook/mm-projects       (F-26)\"\necho \"\"\necho \"GitLab single webhook → /webhook/gitlab-events (F-00)\"\necho \"(DevOps pod registers this at /kickoff via glab — no manual setup)\"\n"},"id":"ansible/ansible-n8n-flows","immutable":false,"metadata":[{"annotations":{},"generate_name":"","generation":0,"labels":{},"name":"ansible-n8n-flows","namespace":"ansible","resource_version":"551508","uid":"fe2a8a68-b5d5-4ee0-9b6e-2a041e110fd2"}]},"sensitive_attributes":[],"private":"bnVsbA==","dependencies":["kubernetes_namespace.ansible"],"identity":{"api_version":"v1","kind":"ConfigMap","name":"ansible-n8n-flows","namespace":"ansible"},"identity_schema_version":1}]},{"mode":"managed","type":"kubernetes_config_map","name":"ansible_pipe","provider":"provider[\"registry.opentofu.org/hashicorp/kubernetes\"]","instances":[{"schema_version":0,"attributes":{"binary_data":{},"data":{"mcp_tools_filter.py":"\"\"\"\nmcp_tools_filter — gives every chat model access to LiteLLM's MCP servers by\ndefault (gitlab, sonarqube, grafana, playwright, n8n — see\nhelm/litellm/templates/config.yaml's mcp_servers: block).\n\nOpenWebUI never attaches an MCP `tools` array to a chat completion request on\nits own. This Filter's inlet hook adds one before the request reaches\nLiteLLM, so any model — Ollama included — gets LiteLLM's MCP bridge\n(`server_url: \"litellm_proxy\"`) without per-model setup. LiteLLM executes the\nactual tool call server-side and folds the result into the reply.\n\nInstall: OpenWebUI -\u003e Admin -\u003e Functions -\u003e import this file, then mark it\nGlobal (installed automatically by playbooks/openwebui.yml).\n\nponytail: whether the underlying model actually calls a tool it's given is a\nseparate, model-capability problem (small local models often don't) — this\nfilter only makes the tools available, it doesn't make the model use them.\n\"\"\"\nfrom typing import Optional\n\nfrom pydantic import BaseModel\n\n\nclass Filter:\n    class Valves(BaseModel):\n        enabled: bool = True\n        require_approval: str = \"never\"\n\n    def __init__(self):\n        self.valves = self.Valves()\n\n    def inlet(self, body: dict, __user__: Optional[dict] = None) -\u003e dict:\n        if not self.valves.enabled:\n            return body\n        if body.get(\"tools\"):\n            # ponytail: don't clobber a caller-supplied tools array\n            return body\n        body[\"tools\"] = [\n            {\n                \"type\": \"mcp\",\n                \"server_label\": \"litellm\",\n                \"server_url\": \"litellm_proxy\",\n                \"require_approval\": self.valves.require_approval,\n            }\n        ]\n        return body\n","sdlc_pipe.py":"\"\"\"\nSDLC Pipe — OpenWebUI edition\nDispatches SDLC slash commands to n8n webhooks and streams progress back.\n\nInstall: OpenWebUI -\u003e Admin -\u003e Functions -\u003e import this file\nEnv vars to set in the pipe's Valve UI:\n  N8N_BASE_URL        e.g. https://n8n.your-domain.com\n  N8N_WEBHOOK_SECRET  shared secret for pipe-\u003en8n auth (optional but recommended)\n\nFlow:\n  1. User types a slash command in chat  -\u003e  pipe parses it\n  2. Pipe POSTs to n8n's command webhook with {flow_id, body: {...}}\n  3. n8n runs asynchronously; each \"Notify: ...\" node POSTs progress to n8n's\n     own F-29 Flow Progress Sink (self-call), which inserts into the\n     sdlc_flow_progress Postgres table\n  4. Pipe polls n8n's F-30 Flow Progress Poll webhook for new rows and\n     streams them into the chat as they arrive\n\nponytail: this used to expect n8n to push progress into a\n/api/v1/pipe/callback route this module registered via an on_startup(app,\nvalves) hook. That never worked — OpenWebUI's function loader\n(backend/open_webui/utils/plugin.py) only ever instantiates the Pipe/Filter/\nAction/Event class and calls its own methods; it has no mechanism for a\nFunction to register arbitrary FastAPI routes. Polling F-30 instead needs\nnothing from OpenWebUI beyond what every other Pipe already gets.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport asyncio\nimport re\nimport uuid\nfrom dataclasses import dataclass\nfrom typing import AsyncGenerator, Optional\n\nimport aiohttp\nfrom pydantic import BaseModel\n\n\n# ── Valves (admin-configurable env vars) ─────────────────────────────────────\n\nclass Valves(BaseModel):\n    N8N_BASE_URL: str = \"http://n8n.n8n.svc.cluster.local:5678\"\n    N8N_WEBHOOK_SECRET: str = \"\"          # added as X-SDLC-Secret header on every call\n    POLL_TIMEOUT_SECONDS: int = 300       # how long to wait for n8n to finish\n    POLL_INTERVAL_SECONDS: float = 1.0    # seconds between polling F-30\n\n\n# ── Command registry ──────────────────────────────────────────────────────────\n\n@dataclass\nclass Command:\n    name: str\n    path: str\n    method: str\n    params: list[str]           # required body params extracted from user input\n    optional: list[str]         # optional body params\n    description: str\n    example: str\n\nCOMMANDS: dict[str, Command] = {\n    \"/plan_release\": Command(\n        name=\"/plan_release\",\n        path=\"plan-release\",\n        method=\"POST\",\n        params=[\"version\"],\n        optional=[\"group\", \"project\"],\n        description=\"Multi-agent release planning: Arch+DE -\u003e QA+Sec+UX -\u003e PM PRD. Optional group/project: GitLab group+project to create/use (default: sdlc/hr-portal, the dry-run fixture — always name both explicitly for a real project)\",\n        example=\"/plan_release v1.2.0 my-team my-app\",\n    ),\n    \"/kickoff\": Command(\n        name=\"/kickoff\",\n        path=\"kickoff\",\n        method=\"POST\",\n        params=[\"version\"],\n        optional=[],\n        description=\"Kickoff sprint: TL branches+pseudocode - PM GitLab artifacts - DevOps infra\",\n        example=\"/kickoff v1.2.0\",\n    ),\n    \"/develop\": Command(\n        name=\"/develop\",\n        path=\"develop\",\n        method=\"POST\",\n        params=[\"version\"],\n        optional=[],\n        description=\"Gate A-\u003eB-\u003eC then fan out dev pods (backend, frontend, QA, security)\",\n        example=\"/develop v1.2.0\",\n    ),\n    \"/uat\": Command(\n        name=\"/uat\",\n        path=\"uat\",\n        method=\"POST\",\n        params=[],\n        optional=[],\n        description=\"UAT pipeline: safeguard -\u003e deploy -\u003e QA -\u003e Security -\u003e PO sign-off\",\n        example=\"/uat\",\n    ),\n    \"/release_staging\": Command(\n        name=\"/release_staging\",\n        path=\"release-staging\",\n        method=\"POST\",\n        params=[],\n        optional=[],\n        description=\"Stage release: UAT safeguard -\u003e release-plan ticket -\u003e promote/ branch -\u003e CI\",\n        example=\"/release_staging\",\n    ),\n    \"/release_production\": Command(\n        name=\"/release_production\",\n        path=\"release-production\",\n        method=\"POST\",\n        params=[],\n        optional=[],\n        description=\"Production release: rm:go safeguard -\u003e create promote-\u003emain MR for Edward\",\n        example=\"/release_production\",\n    ),\n    \"/rollback\": Command(\n        name=\"/rollback\",\n        path=\"rollback\",\n        method=\"POST\",\n        params=[\"version\"],\n        optional=[],\n        description=\"ArgoCD rollback production + open incident ticket\",\n        example=\"/rollback v1.2.0\",\n    ),\n    \"/rollback_story\": Command(\n        name=\"/rollback_story\",\n        path=\"rollback-story\",\n        method=\"POST\",\n        params=[\"story_id\"],\n        optional=[],\n        description=\"Dependency check -\u003e revert MR -\u003e TL review -\u003e Edward merges -\u003e re-UAT\",\n        example=\"/rollback_story GL-42\",\n    ),\n    \"/retro\": Command(\n        name=\"/retro\",\n        path=\"retro\",\n        method=\"POST\",\n        params=[\"version\"],\n        optional=[],\n        description=\"4-pod parallel retro (TL+QA+Sec+RM) -\u003e PM 11-section report\",\n        example=\"/retro v1.2.0\",\n    ),\n    \"/escalate\": Command(\n        name=\"/escalate\",\n        path=\"escalate\",\n        method=\"POST\",\n        params=[\"reason\"],\n        optional=[],\n        description=\"Pause DAG + open escalation ticket + immediate alert\",\n        example='/escalate \"pipeline stuck at gate B for 2h\"',\n    ),\n    \"/projects\": Command(\n        name=\"/projects\",\n        path=\"projects\",\n        method=\"GET\",\n        params=[],\n        optional=[],\n        description=\"Instant DAG state query — stories/tasks open vs merged\",\n        example=\"/projects\",\n    ),\n}\n\nHELP_TEXT = \"\"\"**SDLC Commands**\n\n| Command | Params | Description |\n|---|---|---|\n| `/requirements` | — | Prints a requirements checklist to fill in before `/plan_release` |\n| `/plan_release \u003cversion\u003e [group] [project]` | version, optional group+project (default: sdlc/hr-portal — dry-run fixture, name both for a real project) | Multi-agent release planning |\n| `/kickoff \u003cversion\u003e` | version | Sprint kickoff |\n| `/develop \u003cversion\u003e` | version | Dev gates + pod fan-out |\n| `/uat` | — | UAT pipeline |\n| `/release_staging` | — | Stage the release |\n| `/release_production` | — | Create production MR |\n| `/rollback \u003cversion\u003e` | version | ArgoCD rollback |\n| `/rollback_story \u003cstory_id\u003e` | story_id | Revert a story |\n| `/retro \u003cversion\u003e` | version | Retrospective |\n| `/escalate \u003creason\u003e` | reason | Pause DAG + alert |\n| `/projects` | — | DAG state snapshot |\n\n**Discussing requirements before `/plan_release`**\n\n`/plan_release` reads every message you sent earlier in this same chat (as\ncontext for the Architect/Data Engineer/PM pods) — so type out what you\nwant built first, in plain chat, *then* run `/plan_release \u003cversion\u003e`. Use\n`/requirements` first if you want a checklist to fill in rather than typing\nfrom scratch.\n\n**Examples**\n```\n/requirements\n/kickoff v1.2.0\n/develop v1.2.0\n/rollback_story GL-42\n/escalate \"staging deploy hung\"\n```\n\"\"\"\n\nREQUIREMENTS_TEMPLATE = \"\"\"**Requirements checklist** — fill this in below, then run `/plan_release \u003cversion\u003e [group] [project]`. Everything you type in this chat before that command becomes context for the Architect, Data Engineer, and PM pods.\n\n- **Business goal**: what problem does this solve, for whom?\n- **Success metrics**: how do we know it worked?\n- **Key user stories**: the 3-5 things a user must be able to do\n- **Stack**: given (name it exactly) or \"choose per Design Principles\"\n- **Platform infrastructure**: which of Authentik/Kafka/Apicurio/Unleash/Vault/MinIO/Meilisearch does this need? (\"none\" is a valid answer, but say so)\n- **Constraints**: compliance, data residency, SLA, deadline\n- **Out of scope**: what this release explicitly does NOT do\n- **Risks**: anything you already know could go wrong\n\nSkipping a section is fine — an empty answer just means the planning pods won't have that context and may ask (via the wiki/PRD) rather than assume.\"\"\"\n\n\n# ── Parser ────────────────────────────────────────────────────────────────────\n\ndef parse_command(text: str) -\u003e tuple[Optional[Command], dict, Optional[str]]:\n    \"\"\"\n    Returns (command, body_dict, error_string).\n    error_string is set when parsing fails.\n    \"\"\"\n    text = text.strip()\n    if not text.startswith(\"/\"):\n        return None, {}, None\n\n    # split on whitespace respecting quoted strings\n    parts = re.findall(r'\"[^\"]*\"|\\S+', text)\n    cmd_name = parts[0].lower()\n\n    if cmd_name == \"/help\" or cmd_name == \"/sdlc\":\n        return None, {}, \"__help__\"\n\n    cmd = COMMANDS.get(cmd_name)\n    if cmd is None:\n        return None, {}, f\"Unknown command `{cmd_name}`. Type `/help` to see available commands.\"\n\n    # build body from positional args\n    positional = [p.strip('\"') for p in parts[1:]]\n    body: dict = {}\n\n    for i, param in enumerate(cmd.params):\n        if i \u003c len(positional):\n            body[param] = positional[i]\n        else:\n            return cmd, {}, (\n                f\"Missing required parameter `{param}` for `{cmd_name}`.\\n\"\n                f\"Usage: `{cmd.example}`\"\n            )\n\n    # remaining positional args fill cmd.optional in order, one word each\n    rest = positional[len(cmd.params):]\n    for i, param in enumerate(cmd.optional):\n        if i \u003c len(rest):\n            body[param] = rest[i]\n\n    # remaining positional -\u003e reason (for /escalate multi-word, overrides\n    # the single-word optional-fill above since /escalate's \"reason\" is\n    # meant to capture everything, not just the first extra word)\n    if cmd_name == \"/escalate\" and len(positional) \u003e 1:\n        body[\"reason\"] = \" \".join(positional)\n\n    return cmd, body, None\n\n\n# ── Pipe class ────────────────────────────────────────────────────────────────\n\nclass Pipe:\n    \"\"\"\n    OpenWebUI pipe — SDLC command dispatcher.\n    \"\"\"\n\n    class Valves(Valves):\n        pass\n\n    def __init__(self):\n        self.valves = self.Valves()\n        self.name = \"SDLC\"\n\n    # ── public API called by OpenWebUI ────────────────────────────────────────\n\n    async def pipe(\n        self,\n        body: dict,\n        __user__: Optional[dict] = None,\n        __event_emitter__=None,\n    ) -\u003e AsyncGenerator[str, None]:\n\n        messages = body.get(\"messages\", [])\n        if not messages:\n            yield \"No message received.\"\n            return\n\n        user_text = messages[-1].get(\"content\", \"\").strip()\n\n        # ── help ──────────────────────────────────────────────────────────────\n        if not user_text.startswith(\"/\") or user_text in (\"/help\", \"/sdlc\"):\n            yield HELP_TEXT\n            return\n\n        # ── requirements checklist (local only, never dispatched to n8n) ───────\n        if user_text == \"/requirements\":\n            yield REQUIREMENTS_TEMPLATE\n            return\n\n        # ── parse ─────────────────────────────────────────────────────────────\n        cmd, payload_body, error = parse_command(user_text)\n\n        # ponytail: everything the user typed BEFORE the slash command in this\n        # chat is the requirements discussion — forward it as context so n8n's\n        # role prompts can use it instead of just the bare command args.\n        if cmd is not None and not error:\n            prior = \"\\n\\n\".join(\n                m.get(\"content\", \"\").strip()\n                for m in messages[:-1]\n                if m.get(\"role\") == \"user\" and m.get(\"content\", \"\").strip()\n            )\n            if prior:\n                payload_body[\"context\"] = prior\n\n        if error == \"__help__\":\n            yield HELP_TEXT\n            return\n\n        if error:\n            yield f\"❌ {error}\"\n            return\n\n        # ── dispatch ──────────────────────────────────────────────────────────\n        flow_id = str(uuid.uuid4())\n        webhook_url = f\"{self.valves.N8N_BASE_URL.rstrip('/')}/webhook/{cmd.path}\"\n        headers = {\"Content-Type\": \"application/json\"}\n        if self.valves.N8N_WEBHOOK_SECRET:\n            headers[\"X-SDLC-Secret\"] = self.valves.N8N_WEBHOOK_SECRET\n\n        request_payload = {\n            \"flow_id\": flow_id,\n            \"body\": payload_body,\n        }\n\n        yield f\"⏳ Dispatching `{cmd.name}`...\\n\\n\"\n\n        try:\n            async with aiohttp.ClientSession() as session:\n                if cmd.method == \"GET\":\n                    resp = await session.get(webhook_url, headers=headers, params=payload_body)\n                else:\n                    resp = await session.post(webhook_url, headers=headers, json=request_payload)\n\n                if resp.status \u003e= 400:\n                    body_text = await resp.text()\n                    yield f\"❌ n8n returned HTTP {resp.status}: {body_text}\"\n                    return\n\n        except aiohttp.ClientConnectorError as e:\n            yield f\"❌ Cannot reach n8n at `{self.valves.N8N_BASE_URL}`: {e}\"\n            return\n\n        except Exception as e:\n            yield f\"❌ Dispatch error: {e}\"\n            return\n\n        yield f\"✅ `{cmd.name}` accepted by n8n (flow_id: `{flow_id}`)\\n\\n---\\n\\n\"\n\n        # ── poll for progress ────────────────────────────────────────────────\n        # /projects is near-instant — short timeout\n        timeout = 30 if cmd.name == \"/projects\" else self.valves.POLL_TIMEOUT_SECONDS\n        poll_url = f\"{self.valves.N8N_BASE_URL.rstrip('/')}/webhook/flow-progress-poll\"\n        deadline = asyncio.get_event_loop().time() + timeout\n        since = \"1970-01-01T00:00:00Z\"\n        idle_since = asyncio.get_event_loop().time()\n\n        done_signals = [\n            \"complete\", \"complete —\", \"confirmed\", \"failed\", \"blocked\",\n            \"escalating\", \"deferred\", \"sleeping\", \"publishing\"\n        ]\n\n        try:\n            async with aiohttp.ClientSession() as session:\n                while True:\n                    now = asyncio.get_event_loop().time()\n                    if now \u003e deadline:\n                        yield \"\\n⏱ Timeout waiting for n8n updates. Flow may still be running.\"\n                        break\n\n                    try:\n                        resp = await session.get(\n                            poll_url,\n                            params={\"flow_id\": flow_id, \"since\": since},\n                            timeout=aiohttp.ClientTimeout(total=10),\n                        )\n                        rows = await resp.json(content_type=None) if resp.status == 200 else []\n                    except Exception:\n                        rows = []\n\n                    if not isinstance(rows, list):\n                        rows = [rows] if rows else []\n\n                    if not rows:\n                        idle = asyncio.get_event_loop().time() - idle_since\n                        if idle \u003e 60 and cmd.name in (\"/projects\", \"/escalate\"):\n                            break\n                        await asyncio.sleep(self.valves.POLL_INTERVAL_SECONDS)\n                        continue\n\n                    idle_since = asyncio.get_event_loop().time()\n                    stop = False\n                    for row in rows:\n                        msg = row.get(\"message\", \"\")\n                        notes = row.get(\"notes\") or \"\"\n                        since = row.get(\"created_at\", since)\n                        full_msg = f\"{msg}\\n\u003e {notes}\" if notes else msg\n                        yield f\"{full_msg}\\n\\n\"\n                        if any(s in msg.lower() for s in done_signals):\n                            stop = True\n                    if stop:\n                        break\n\n        except Exception as e:\n            yield f\"\\n❌ Error polling flow progress: {e}\"\n"},"id":"ansible/ansible-pipe","immutable":false,"metadata":[{"annotations":{},"generate_name":"","generation":0,"labels":{},"name":"ansible-pipe","namespace":"ansible","resource_version":"265710","uid":"a6015335-984b-44d2-afd1-32af72ec3193"}]},"sensitive_attributes":[],"private":"bnVsbA==","dependencies":["kubernetes_namespace.ansible"],"identity":{"api_version":"v1","kind":"ConfigMap","name":"ansible-pipe","namespace":"ansible"},"identity_schema_version":1}]},{"mode":"managed","type":"kubernetes_config_map","name":"coredns_custom","provider":"provider[\"registry.opentofu.org/hashicorp/kubernetes\"]","instances":[{"schema_version":0,"attributes":{"binary_data":{},"data":{"authentik.override":"rewrite name exact authentik.tail60240b.ts.net traefik.kube-system.svc.cluster.local"},"id":"kube-system/coredns-custom","immutable":false,"metadata":[{"annotations":{},"generate_name":"","generation":0,"labels":{},"name":"coredns-custom","namespace":"kube-system","resource_version":"20773","uid":"0ce575f6-117b-4705-a8b6-16787cda265b"}]},"sensitive_attributes":[],"private":"bnVsbA==","identity":{"api_version":"v1","kind":"ConfigMap","name":"coredns-custom","namespace":"kube-system"},"identity_schema_version":1}]},{"mode":"managed","type":"kubernetes_config_map","name":"n8n_oidc_hooks","provider":"provider[\"registry.opentofu.org/hashicorp/kubernetes\"]","instances":[{"schema_version":0,"attributes":{"binary_data":{},"data":{"hooks.js":"/**\r\n * n8n External Hooks for OIDC Authentication\r\n *\r\n * This file implements OIDC authentication support for n8n using only built-in Node.js modules.\r\n * It provides:\r\n * - OIDC discovery endpoint support\r\n * - Authorization code flow\r\n * - User provisioning (JIT - Just In Time)\r\n * - Frontend customization to show OIDC login button\r\n *\r\n * Environment Variables Required:\r\n * - OIDC_ISSUER_URL: The OIDC provider's issuer URL (e.g., https://auth.example.com)\r\n * - OIDC_CLIENT_ID: OAuth2 client ID\r\n * - OIDC_CLIENT_SECRET: OAuth2 client secret\r\n * - OIDC_REDIRECT_URI: The callback URL (e.g., https://n8n.example.com/auth/oidc/callback)\r\n *\r\n * Optional:\r\n * - OIDC_SCOPES: Space-separated list of scopes (default: \"openid email profile\")\r\n */\r\n\r\nconst https = require('https');\r\nconst http = require('http');\r\nconst crypto = require('crypto');\r\nconst { URL, URLSearchParams } = require('url');\r\n\r\n// Configuration from environment\r\nconst config = {\r\n  issuerUrl: process.env.OIDC_ISSUER_URL,\r\n  clientId: process.env.OIDC_CLIENT_ID,\r\n  clientSecret: process.env.OIDC_CLIENT_SECRET,\r\n  redirectUri: process.env.OIDC_REDIRECT_URI,\r\n  scopes: process.env.OIDC_SCOPES || 'openid email profile',\r\n};\r\n\r\n// Validate configuration\r\nfunction validateConfig() {\r\n  const missing = [];\r\n  if (!config.issuerUrl) missing.push('OIDC_ISSUER_URL');\r\n  if (!config.clientId) missing.push('OIDC_CLIENT_ID');\r\n  if (!config.clientSecret) missing.push('OIDC_CLIENT_SECRET');\r\n  if (!config.redirectUri) missing.push('OIDC_REDIRECT_URI');\r\n  return missing;\r\n}\r\n\r\n// Cache for OIDC discovery document\r\nlet discoveryCache = null;\r\nlet discoveryCacheTime = 0;\r\nconst DISCOVERY_CACHE_TTL = 3600000; // 1 hour\r\n\r\n/**\r\n * Make an HTTP/HTTPS request\r\n * @param {string} url - The URL to request\r\n * @param {object} options - Request options\r\n * @returns {Promise\u003c{statusCode: number, headers: object, body: string}\u003e}\r\n */\r\nfunction makeRequest(url, options = {}) {\r\n  return new Promise((resolve, reject) =\u003e {\r\n    const parsedUrl = new URL(url);\r\n    const protocol = parsedUrl.protocol === 'https:' ? https : http;\r\n\r\n    const reqOptions = {\r\n      hostname: parsedUrl.hostname,\r\n      port: parsedUrl.port || (parsedUrl.protocol === 'https:' ? 443 : 80),\r\n      path: parsedUrl.pathname + parsedUrl.search,\r\n      method: options.method || 'GET',\r\n      headers: options.headers || {},\r\n    };\r\n\r\n    const req = protocol.request(reqOptions, (res) =\u003e {\r\n      let body = '';\r\n      res.on('data', (chunk) =\u003e (body += chunk));\r\n      res.on('end', () =\u003e {\r\n        resolve({\r\n          statusCode: res.statusCode,\r\n          headers: res.headers,\r\n          body,\r\n        });\r\n      });\r\n    });\r\n\r\n    req.on('error', reject);\r\n\r\n    if (options.body) {\r\n      req.write(options.body);\r\n    }\r\n\r\n    req.end();\r\n  });\r\n}\r\n\r\n/**\r\n * Fetch OIDC discovery document\r\n * @returns {Promise\u003cobject\u003e}\r\n */\r\nasync function fetchDiscoveryDocument() {\r\n  const now = Date.now();\r\n  if (discoveryCache \u0026\u0026 now - discoveryCacheTime \u003c DISCOVERY_CACHE_TTL) {\r\n    return discoveryCache;\r\n  }\r\n\r\n  const discoveryUrl = config.issuerUrl.replace(/\\/$/, '') + '/.well-known/openid-configuration';\r\n  const response = await makeRequest(discoveryUrl);\r\n\r\n  if (response.statusCode !== 200) {\r\n    throw new Error(`Failed to fetch OIDC discovery document: ${response.statusCode}`);\r\n  }\r\n\r\n  discoveryCache = JSON.parse(response.body);\r\n  discoveryCacheTime = now;\r\n  return discoveryCache;\r\n}\r\n\r\n/**\r\n * Generate a random string for state/nonce\r\n * @param {number} length\r\n * @returns {string}\r\n */\r\nfunction generateRandomString(length = 32) {\r\n  return crypto.randomBytes(length).toString('hex');\r\n}\r\n\r\n/**\r\n * Base64URL encode\r\n * @param {Buffer|string} input\r\n * @returns {string}\r\n */\r\nfunction base64UrlEncode(input) {\r\n  const base64 = Buffer.isBuffer(input) ? input.toString('base64') : Buffer.from(input).toString('base64');\r\n  return base64.replace(/\\+/g, '-').replace(/\\//g, '_').replace(/=/g, '');\r\n}\r\n\r\n/**\r\n * Base64URL decode\r\n * @param {string} input\r\n * @returns {Buffer}\r\n */\r\nfunction base64UrlDecode(input) {\r\n  let base64 = input.replace(/-/g, '+').replace(/_/g, '/');\r\n  while (base64.length % 4) {\r\n    base64 += '=';\r\n  }\r\n  return Buffer.from(base64, 'base64');\r\n}\r\n\r\n/**\r\n * Decode JWT without verification (for extracting claims)\r\n * @param {string} token\r\n * @returns {object}\r\n */\r\nfunction decodeJwt(token) {\r\n  const parts = token.split('.');\r\n  if (parts.length !== 3) {\r\n    throw new Error('Invalid JWT format');\r\n  }\r\n\r\n  const payload = JSON.parse(base64UrlDecode(parts[1]).toString('utf8'));\r\n  return payload;\r\n}\r\n\r\n/**\r\n * Exchange authorization code for tokens\r\n * @param {string} code\r\n * @param {object} discovery\r\n * @returns {Promise\u003cobject\u003e}\r\n */\r\nasync function exchangeCodeForTokens(code, discovery) {\r\n  const params = new URLSearchParams({\r\n    grant_type: 'authorization_code',\r\n    code,\r\n    redirect_uri: config.redirectUri,\r\n    client_id: config.clientId,\r\n    client_secret: config.clientSecret,\r\n  });\r\n\r\n  const response = await makeRequest(discovery.token_endpoint, {\r\n    method: 'POST',\r\n    headers: {\r\n      'Content-Type': 'application/x-www-form-urlencoded',\r\n    },\r\n    body: params.toString(),\r\n  });\r\n\r\n  if (response.statusCode !== 200) {\r\n    console.error('Token exchange failed:', response.body);\r\n    throw new Error(`Token exchange failed: ${response.statusCode}`);\r\n  }\r\n\r\n  return JSON.parse(response.body);\r\n}\r\n\r\n/**\r\n * Fetch user info from OIDC provider\r\n * @param {string} accessToken\r\n * @param {object} discovery\r\n * @returns {Promise\u003cobject\u003e}\r\n */\r\nasync function fetchUserInfo(accessToken, discovery) {\r\n  const response = await makeRequest(discovery.userinfo_endpoint, {\r\n    headers: {\r\n      Authorization: `Bearer ${accessToken}`,\r\n    },\r\n  });\r\n\r\n  if (response.statusCode !== 200) {\r\n    console.error('UserInfo fetch failed:', response.body);\r\n    throw new Error(`UserInfo fetch failed: ${response.statusCode}`);\r\n  }\r\n\r\n  return JSON.parse(response.body);\r\n}\r\n\r\n/**\r\n * Create a signed JWT for state/nonce storage\r\n * We use the JWT service from n8n when available, but for cookies we just use HMAC\r\n * @param {object} payload\r\n * @param {string} secret\r\n * @param {number} expiresInSeconds\r\n * @returns {string}\r\n */\r\nfunction createSignedCookie(payload, secret, expiresInSeconds = 900) {\r\n  const exp = Math.floor(Date.now() / 1000) + expiresInSeconds;\r\n  const data = JSON.stringify({ ...payload, exp });\r\n  const hmac = crypto.createHmac('sha256', secret);\r\n  hmac.update(data);\r\n  const signature = hmac.digest('hex');\r\n  return base64UrlEncode(data) + '.' + signature;\r\n}\r\n\r\n/**\r\n * Verify and decode a signed cookie\r\n * @param {string} cookie\r\n * @param {string} secret\r\n * @returns {object|null}\r\n */\r\nfunction verifySignedCookie(cookie, secret) {\r\n  try {\r\n    const [dataB64, signature] = cookie.split('.');\r\n    const data = base64UrlDecode(dataB64).toString('utf8');\r\n\r\n    const hmac = crypto.createHmac('sha256', secret);\r\n    hmac.update(data);\r\n    const expectedSignature = hmac.digest('hex');\r\n\r\n    if (signature !== expectedSignature) {\r\n      return null;\r\n    }\r\n\r\n    const payload = JSON.parse(data);\r\n    if (payload.exp \u0026\u0026 payload.exp \u003c Date.now() / 1000) {\r\n      return null;\r\n    }\r\n\r\n    return payload;\r\n  } catch {\r\n    return null;\r\n  }\r\n}\r\n\r\n/**\r\n * Get or create the cookie signing secret\r\n * We derive it from the n8n encryption key if available\r\n * @param {object} context\r\n * @returns {string}\r\n */\r\nfunction getCookieSecret(context) {\r\n  // Use a combination of environment variables to create a stable secret\r\n  const baseKey = process.env.N8N_ENCRYPTION_KEY || process.env.OIDC_CLIENT_SECRET || 'n8n-oidc-hook-secret';\r\n  const hash = crypto.createHash('sha256').update(baseKey + '-oidc-state').digest('hex');\r\n  return hash;\r\n}\r\n\r\n/**\r\n * Create the n8n auth cookie using n8n's JwtService\r\n * @param {object} user\r\n * @param {object} jwtService - n8n's JwtService instance\r\n * @returns {string}\r\n */\r\nfunction createAuthToken(user, jwtService) {\r\n  // n8n's JWT contains: { id, hash, browserId?, usedMfa? }\r\n  const payload = {\r\n    id: user.id,\r\n    hash: createUserHash(user),\r\n    usedMfa: false,\r\n  };\r\n\r\n  return jwtService.sign(payload, { expiresIn: '7d' });\r\n}\r\n\r\n/**\r\n * Create user hash for JWT (mimics n8n's AuthService.createJWTHash)\r\n * @param {object} user\r\n * @returns {string}\r\n */\r\nfunction createUserHash(user) {\r\n  const payload = [user.email, user.password || ''];\r\n  if (user.mfaEnabled \u0026\u0026 user.mfaSecret) {\r\n    payload.push(user.mfaSecret.substring(0, 3));\r\n  }\r\n  return crypto.createHash('sha256').update(payload.join(':')).digest('base64').substring(0, 10);\r\n}\r\n\r\n/**\r\n * Check if email is valid\r\n * @param {string} email\r\n * @returns {boolean}\r\n */\r\nfunction isValidEmail(email) {\r\n  const emailRegex = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\r\n  return emailRegex.test(email);\r\n}\r\n\r\n// n8n module paths (specific to the Docker image)\r\nconst N8N_DI_PATH = '/usr/local/lib/node_modules/n8n/node_modules/@n8n/di';\r\nconst N8N_JWT_SERVICE_PATH = '/usr/local/lib/node_modules/n8n/dist/services/jwt.service.js';\r\n\r\n// Export the hooks\r\nmodule.exports = {\r\n  n8n: {\r\n    /**\r\n     * Called when n8n is ready\r\n     * We use this to register custom routes for OIDC\r\n     */\r\n    ready: [\r\n      async function (server, n8nConfig) {\r\n        const missing = validateConfig();\r\n        if (missing.length \u003e 0) {\r\n          console.warn(`[OIDC Hook] Missing configuration: ${missing.join(', ')}. OIDC disabled.`);\r\n          return;\r\n        }\r\n\r\n        console.log('[OIDC Hook] Initializing OIDC authentication...');\r\n\r\n        // Get n8n's JwtService from the DI container\r\n        const { Container } = require(N8N_DI_PATH);\r\n        const { JwtService } = require(N8N_JWT_SERVICE_PATH);\r\n        const jwtService = Container.get(JwtService);\r\n\r\n        const { app } = server;\r\n        const cookieSecret = getCookieSecret();\r\n\r\n        // Cookie settings\r\n        const cookieOptions = {\r\n          httpOnly: true,\r\n          secure: process.env.N8N_PROTOCOL === 'https',\r\n          sameSite: 'lax',\r\n          maxAge: 15 * 60 * 1000, // 15 minutes\r\n        };\r\n\r\n        const authCookieOptions = {\r\n          httpOnly: true,\r\n          secure: process.env.N8N_PROTOCOL === 'https',\r\n          sameSite: 'lax',\r\n          maxAge: 7 * 24 * 60 * 60 * 1000, // 7 days\r\n        };\r\n\r\n        /**\r\n         * OIDC Login endpoint - redirects to the OIDC provider\r\n         */\r\n        app.get('/auth/oidc/login', async (req, res) =\u003e {\r\n          try {\r\n            const discovery = await fetchDiscoveryDocument();\r\n\r\n            const state = generateRandomString();\r\n            const nonce = generateRandomString();\r\n\r\n            // Store state and nonce in signed cookies\r\n            const stateCookie = createSignedCookie({ state }, cookieSecret);\r\n            const nonceCookie = createSignedCookie({ nonce }, cookieSecret);\r\n\r\n            res.cookie('n8n-oidc-state', stateCookie, cookieOptions);\r\n            res.cookie('n8n-oidc-nonce', nonceCookie, cookieOptions);\r\n\r\n            // Build authorization URL\r\n            const authUrl = new URL(discovery.authorization_endpoint);\r\n            authUrl.searchParams.set('client_id', config.clientId);\r\n            authUrl.searchParams.set('redirect_uri', config.redirectUri);\r\n            authUrl.searchParams.set('response_type', 'code');\r\n            authUrl.searchParams.set('scope', config.scopes);\r\n            authUrl.searchParams.set('state', state);\r\n            authUrl.searchParams.set('nonce', nonce);\r\n\r\n            res.redirect(authUrl.toString());\r\n          } catch (error) {\r\n            console.error('[OIDC Hook] Login error:', error);\r\n            res.status(500).send('OIDC configuration error. Please check the logs.');\r\n          }\r\n        });\r\n\r\n        /**\r\n         * OIDC Callback endpoint - handles the authorization code\r\n         */\r\n        app.get('/auth/oidc/callback', async (req, res) =\u003e {\r\n          try {\r\n            const { code, state, error, error_description } = req.query;\r\n\r\n            // Handle OIDC errors\r\n            if (error) {\r\n              console.error('[OIDC Hook] OIDC error:', error, error_description);\r\n              return res.redirect('/signin?error=' + encodeURIComponent(error_description || error));\r\n            }\r\n\r\n            if (!code || !state) {\r\n              return res.redirect('/signin?error=' + encodeURIComponent('Missing authorization code or state'));\r\n            }\r\n\r\n            // Verify state\r\n            const stateCookie = req.cookies['n8n-oidc-state'];\r\n            const nonceCookie = req.cookies['n8n-oidc-nonce'];\r\n\r\n            if (!stateCookie || !nonceCookie) {\r\n              return res.redirect('/signin?error=' + encodeURIComponent('Missing state cookies - session expired'));\r\n            }\r\n\r\n            const statePayload = verifySignedCookie(stateCookie, cookieSecret);\r\n            const noncePayload = verifySignedCookie(nonceCookie, cookieSecret);\r\n\r\n            if (!statePayload || statePayload.state !== state) {\r\n              return res.redirect('/signin?error=' + encodeURIComponent('Invalid state - possible CSRF attack'));\r\n            }\r\n\r\n            // Clear state cookies\r\n            res.clearCookie('n8n-oidc-state');\r\n            res.clearCookie('n8n-oidc-nonce');\r\n\r\n            // Exchange code for tokens\r\n            const discovery = await fetchDiscoveryDocument();\r\n            const tokens = await exchangeCodeForTokens(code, discovery);\r\n\r\n            // Verify nonce in ID token if present\r\n            if (tokens.id_token) {\r\n              const idTokenClaims = decodeJwt(tokens.id_token);\r\n              if (noncePayload \u0026\u0026 idTokenClaims.nonce !== noncePayload.nonce) {\r\n                return res.redirect('/signin?error=' + encodeURIComponent('Invalid nonce - possible replay attack'));\r\n              }\r\n            }\r\n\r\n            // Get user info\r\n            let userInfo;\r\n            try {\r\n              userInfo = await fetchUserInfo(tokens.access_token, discovery);\r\n            } catch (e) {\r\n              // Fall back to ID token claims if userinfo endpoint fails\r\n              if (tokens.id_token) {\r\n                userInfo = decodeJwt(tokens.id_token);\r\n              } else {\r\n                throw e;\r\n              }\r\n            }\r\n\r\n            // Validate we have an email\r\n            if (!userInfo.email || !isValidEmail(userInfo.email)) {\r\n              return res.redirect('/signin?error=' + encodeURIComponent('No valid email in OIDC response'));\r\n            }\r\n\r\n            // Find or create user in n8n database\r\n            const { User, Settings, Credentials, Workflow } = this.dbCollections;\r\n\r\n            // Try to find existing user by email\r\n            let user = await User.findOne({\r\n              where: { email: userInfo.email },\r\n              relations: ['role'],\r\n            });\r\n\r\n            if (!user) {\r\n              // Check if this is the first user (should be owner)\r\n              const userCount = await User.count();\r\n\r\n              const userData = {\r\n                email: userInfo.email,\r\n                firstName: userInfo.given_name || userInfo.name?.split(' ')[0] || 'User',\r\n                lastName: userInfo.family_name || userInfo.name?.split(' ').slice(1).join(' ') || '',\r\n                password: crypto.randomBytes(32).toString('hex'), // Random password, can't be used\r\n                role: { slug: userCount === 0 ? 'global:owner' : 'global:member' },\r\n              };\r\n\r\n              // Use createUserWithProject to create both user and personal project\r\n              const result = await User.createUserWithProject(userData);\r\n              user = result.user;\r\n\r\n              console.log(`[OIDC Hook] Created ${userCount === 0 ? 'owner' : 'member'} user with personal project: ${userInfo.email}`);\r\n            }\r\n\r\n            if (!user) {\r\n              return res.redirect('/signin?error=' + encodeURIComponent('Failed to create or find user'));\r\n            }\r\n\r\n            // Create auth token using n8n's JwtService\r\n            const authToken = createAuthToken(user, jwtService);\r\n\r\n            // Set the n8n auth cookie\r\n            res.cookie('n8n-auth', authToken, authCookieOptions);\r\n\r\n            // Redirect to home\r\n            res.redirect('/');\r\n          } catch (error) {\r\n            console.error('[OIDC Hook] Callback error:', error);\r\n            res.redirect('/signin?error=' + encodeURIComponent('Authentication failed: ' + error.message));\r\n          }\r\n        });\r\n\r\n        /**\r\n         * Serve the frontend customization script\r\n         * This script will replace the login form with an OIDC button\r\n         *\r\n         * NOTE: The route must be under /assets/ or another non-UI route prefix\r\n         * to avoid being intercepted by n8n's history API handler which would\r\n         * serve index.html instead of our JavaScript file.\r\n         */\r\n        app.get('/assets/oidc-frontend-hook.js', (req, res) =\u003e {\r\n          // Use res.type() for proper MIME type handling with nosniff\r\n          res.type('text/javascript; charset=utf-8');\r\n          res.set('Cache-Control', 'public, max-age=3600');\r\n          res.send(getFrontendScript());\r\n        });\r\n\r\n        console.log('[OIDC Hook] OIDC routes registered:');\r\n        console.log('  - GET /auth/oidc/login');\r\n        console.log('  - GET /auth/oidc/callback');\r\n        console.log('  - GET /assets/oidc-frontend-hook.js');\r\n      },\r\n    ],\r\n  },\r\n\r\n  frontend: {\r\n    /**\r\n     * Modify frontend settings to configure SSO display\r\n     */\r\n    settings: [\r\n      async function (frontendSettings) {\r\n        const missing = validateConfig();\r\n        if (missing.length \u003e 0) {\r\n          return; // OIDC not configured, don't modify settings\r\n        }\r\n\r\n        // Enable OIDC login button by setting these properties\r\n        // This tells the frontend that OIDC is available\r\n        frontendSettings.sso = frontendSettings.sso || {};\r\n        frontendSettings.sso.oidc = {\r\n          loginEnabled: true,\r\n          loginUrl: '/auth/oidc/login',\r\n          callbackUrl: config.redirectUri,\r\n        };\r\n\r\n        // Set authentication method to OIDC so the frontend knows SSO is primary\r\n        frontendSettings.userManagement = frontendSettings.userManagement || {};\r\n        frontendSettings.userManagement.authenticationMethod = 'oidc';\r\n\r\n        // Enable enterprise OIDC feature flag so the SSO button shows\r\n        frontendSettings.enterprise = frontendSettings.enterprise || {};\r\n        frontendSettings.enterprise.oidc = true;\r\n\r\n        console.log('[OIDC Hook] Frontend settings configured for OIDC');\r\n      },\r\n    ],\r\n  },\r\n};\r\n\r\n/**\r\n * Generate the frontend customization script\r\n * This script runs in the browser and customizes the login page\r\n */\r\nfunction getFrontendScript() {\r\n  return `\r\n/**\r\n * n8n OIDC Frontend Customization\r\n *\r\n * This script surgically modifies the login form to show an SSO button.\r\n * To access the normal login form, add ?showLogin=true to the URL.\r\n */\r\n(function() {\r\n\t'use strict';\r\n\r\n\tfunction shouldShowNormalLogin() {\r\n\t\treturn new URLSearchParams(window.location.search).get('showLogin') === 'true';\r\n\t}\r\n\r\n\tfunction isSigninPage() {\r\n\t\treturn window.location.pathname === '/signin' || window.location.pathname === '/login';\r\n\t}\r\n\r\n\tfunction displayError(form) {\r\n\t\tvar error = new URLSearchParams(window.location.search).get('error');\r\n\t\tif (!error || !form || form.querySelector('#oidc-error')) return;\r\n\r\n\t\tvar errorDiv = document.createElement('div');\r\n\t\terrorDiv.id = 'oidc-error';\r\n\t\terrorDiv.style.cssText = 'background: var(--color-danger-tint-1, #fee); border: 1px solid var(--color-danger, #fcc); color: var(--color-danger, #c00); padding: 12px; border-radius: 4px; margin: 16px 0;';\r\n\t\terrorDiv.textContent = decodeURIComponent(error);\r\n\r\n\t\tvar heading = form.querySelector('div[class*=\"_heading_\"]');\r\n\t\tif (heading) heading.after(errorDiv);\r\n\t\telse form.prepend(errorDiv);\r\n\t}\r\n\r\n\tfunction injectSsoButton() {\r\n\t\tif (shouldShowNormalLogin()) return;\r\n\t\tif (!isSigninPage()) return;\r\n\r\n\t\tvar form = document.querySelector('[data-test-id=\"auth-form\"]');\r\n\t\tif (!form || form.querySelector('#oidc-sso-button')) return;\r\n\r\n\t\t// Find existing button to clone its classes\r\n\t\tvar existingButton = form.querySelector('[data-test-id=\"form-submit-button\"]');\r\n\t\tvar buttonClasses = existingButton ? existingButton.className : '';\r\n\r\n\t\t// Hide the form elements (inputs, buttons, forgot password)\r\n\t\tform.querySelectorAll('div[class*=\"_inputsContainer_\"], div[class*=\"_buttonsContainer_\"], div[class*=\"_actionContainer_\"]')\r\n\t\t\t.forEach(function(el) { el.style.display = 'none'; });\r\n\r\n\t\t// Create SSO button container\r\n\t\tvar ssoContainer = document.createElement('div');\r\n\t\tssoContainer.id = 'oidc-sso-container';\r\n\t\tssoContainer.style.cssText = 'text-align: center;';\r\n\r\n\t\t// Create button - use cloned classes or fallback styles\r\n\t\tvar button = document.createElement('button');\r\n\t\tbutton.id = 'oidc-sso-button';\r\n\t\tbutton.type = 'button';\r\n\t\tbutton.textContent = 'Sign in with SSO';\r\n\t\tbutton.onclick = function() { window.location.href = '/auth/oidc/login'; };\r\n\r\n\t\tif (buttonClasses) {\r\n\t\t\tbutton.className = buttonClasses;\r\n\t\t\tbutton.style.width = '100%';\r\n\t\t} else {\r\n\t\t\tbutton.style.cssText = 'width: 100%; padding: 12px 24px; font-size: 14px; font-weight: 600; color: white; background: var(--color-primary, #ea4b30); border: none; border-radius: 4px; cursor: pointer;';\r\n\t\t}\r\n\r\n\t\t// Create admin link\r\n\t\tvar adminLink = document.createElement('p');\r\n\t\tadminLink.style.cssText = 'margin-top: 16px; font-size: 12px; color: var(--color-text-light, #666);';\r\n\t\tadminLink.innerHTML = 'Admin? \u003ca href=\"?showLogin=true\" style=\"color: var(--color-primary, #ea4b30);\"\u003eSign in with email\u003c/a\u003e';\r\n\r\n\t\tssoContainer.appendChild(button);\r\n\t\tssoContainer.appendChild(adminLink);\r\n\r\n\t\t// Insert after the heading\r\n\t\tvar heading = form.querySelector('div[class*=\"_heading_\"]');\r\n\t\tif (heading) heading.after(ssoContainer);\r\n\t\telse form.prepend(ssoContainer);\r\n\r\n\t\tdisplayError(form);\r\n\t}\r\n\r\n\tfunction observeAndInject() {\r\n\t\tif (shouldShowNormalLogin() || !isSigninPage()) return;\r\n\r\n\t\tinjectSsoButton();\r\n\r\n\t\tvar observer = new MutationObserver(function() {\r\n\t\t\tif (isSigninPage() \u0026\u0026 !shouldShowNormalLogin()) {\r\n\t\t\t\tvar form = document.querySelector('[data-test-id=\"auth-form\"]');\r\n\t\t\t\tif (form \u0026\u0026 !form.querySelector('#oidc-sso-button')) {\r\n\t\t\t\t\tinjectSsoButton();\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t});\r\n\r\n\t\tobserver.observe(document.body, { childList: true, subtree: true });\r\n\t\tsetTimeout(function() { observer.disconnect(); }, 10000);\r\n\t}\r\n\r\n\tfunction handleNavigation() {\r\n\t\tvar origPush = history.pushState;\r\n\t\tvar origReplace = history.replaceState;\r\n\r\n\t\thistory.pushState = function() {\r\n\t\t\torigPush.apply(this, arguments);\r\n\t\t\tsetTimeout(observeAndInject, 100);\r\n\t\t};\r\n\r\n\t\thistory.replaceState = function() {\r\n\t\t\torigReplace.apply(this, arguments);\r\n\t\t\tsetTimeout(observeAndInject, 100);\r\n\t\t};\r\n\r\n\t\twindow.addEventListener('popstate', function() {\r\n\t\t\tsetTimeout(observeAndInject, 100);\r\n\t\t});\r\n\t}\r\n\r\n\tif (document.readyState === 'loading') {\r\n\t\tdocument.addEventListener('DOMContentLoaded', function() {\r\n\t\t\tobserveAndInject();\r\n\t\t\thandleNavigation();\r\n\t\t});\r\n\t} else {\r\n\t\tobserveAndInject();\r\n\t\thandleNavigation();\r\n\t}\r\n\r\n\tsetTimeout(observeAndInject, 500);\r\n\tsetTimeout(observeAndInject, 1000);\r\n\r\n\tconsole.log('[OIDC Hook] Frontend customization loaded');\r\n})();\r\n`;\r\n}\r\n"},"id":"n8n/n8n-oidc-hooks","immutable":false,"metadata":[{"annotations":{},"generate_name":"","generation":0,"labels":{},"name":"n8n-oidc-hooks","namespace":"n8n","resource_version":"822","uid":"6337b217-9c35-4183-a369-a8b598a1a72f"}]},"sensitive_attributes":[],"private":"bnVsbA==","dependencies":["kubernetes_namespace.n8n"],"identity":{"api_version":"v1","kind":"ConfigMap","name":"n8n-oidc-hooks","namespace":"n8n"},"identity_schema_version":1}]},{"mode":"managed","type":"kubernetes_namespace","name":"ansible","provider":"provider[\"registry.opentofu.org/hashicorp/kubernetes\"]","instances":[{"schema_version":0,"attributes":{"id":"ansible","metadata":[{"annotations":{},"generate_name":"","generation":0,"labels":{},"name":"ansible","resource_version":"770","uid":"3f51c981-9b9e-415a-939f-d2e66286416e"}],"timeouts":null,"wait_for_default_service_account":false},"sensitive_attributes":[],"private":"eyJlMmJmYjczMC1lY2FhLTExZTYtOGY4OC0zNDM2M2JjN2M0YzAiOnsiZGVsZXRlIjozMDAwMDAwMDAwMDB9fQ==","identity":{"api_version":"v1","kind":"Namespace","name":"ansible"},"identity_schema_version":1}]},{"mode":"managed","type":"kubernetes_namespace","name":"argocd","provider":"provider[\"registry.opentofu.org/hashicorp/kubernetes\"]","instances":[{"schema_version":0,"attributes":{"id":"argocd","metadata":[{"annotations":{},"generate_name":"","generation":0,"labels":{},"name":"argocd","resource_version":"774","uid":"aa568e13-6ded-431f-9008-c81c0ea4a582"}],"timeouts":null,"wait_for_default_service_account":false},"sensitive_attributes":[],"private":"eyJlMmJmYjczMC1lY2FhLTExZTYtOGY4OC0zNDM2M2JjN2M0YzAiOnsiZGVsZXRlIjozMDAwMDAwMDAwMDB9fQ==","identity":{"api_version":"v1","kind":"Namespace","name":"argocd"},"identity_schema_version":1}]},{"mode":"managed","type":"kubernetes_namespace","name":"authentik","provider":"provider[\"registry.opentofu.org/hashicorp/kubernetes\"]","instances":[{"schema_version":0,"attributes":{"id":"authentik","metadata":[{"annotations":{},"generate_name":"","generation":0,"labels":{},"name":"authentik","resource_version":"792","uid":"cf855666-90f2-45fa-99d5-2314b7df7a48"}],"timeouts":null,"wait_for_default_service_account":false},"sensitive_attributes":[],"private":"eyJlMmJmYjczMC1lY2FhLTExZTYtOGY4OC0zNDM2M2JjN2M0YzAiOnsiZGVsZXRlIjozMDAwMDAwMDAwMDB9fQ==","identity":{"api_version":"v1","kind":"Namespace","name":"authentik"},"identity_schema_version":1}]},{"mode":"managed","type":"kubernetes_namespace","name":"cert_manager","provider":"provider[\"registry.opentofu.org/hashicorp/kubernetes\"]","instances":[{"schema_version":0,"attributes":{"id":"cert-manager","metadata":[{"annotations":{},"generate_name":"","generation":0,"labels":{},"name":"cert-manager","resource_version":"791","uid":"1137f705-8bf5-45d5-802c-2c277aa84cfb"}],"timeouts":null,"wait_for_default_service_account":false},"sensitive_attributes":[],"private":"eyJlMmJmYjczMC1lY2FhLTExZTYtOGY4OC0zNDM2M2JjN2M0YzAiOnsiZGVsZXRlIjozMDAwMDAwMDAwMDB9fQ==","identity":{"api_version":"v1",