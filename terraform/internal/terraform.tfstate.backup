     \"node\": \"Comment MR: Handover\",\r\n            \"type\": \"main\",\r\n            \"index\": 0\r\n          },\r\n          {\r\n            \"node\": \"Comment Kaneo: Handover\",\r\n            \"type\": \"main\",\r\n            \"index\": 0\r\n          }\r\n        ]\r\n      ]\r\n    }\r\n  },\r\n  \"active\": true,\r\n  \"tags\": [],\r\n  \"settings\": {\r\n    \"executionOrder\": \"v1\"\r\n  }\r\n}","F-05-task-mr-merged.json":"{\n  \"name\": \"F-05 Task MR Merged\",\n  \"nodes\": [\n    {\n      \"id\": \"f6d90ca8-33d9-4d9d-9dc9-85e3accbf919\",\n      \"name\": \"Webhook Trigger\",\n      \"type\": \"n8n-nodes-base.webhook\",\n      \"typeVersion\": 2,\n      \"position\": [\n        240,\n        300\n      ],\n      \"parameters\": {\n        \"path\": \"gitlab-task-mr-merged\",\n        \"httpMethod\": \"POST\",\n        \"responseMode\": \"onReceived\",\n        \"responseData\": \"allEntries\"\n      },\n      \"webhookId\": \"be0ec9eb-7225-4d1e-a824-eff2f4c1e226\"\n    },\n    {\n      \"id\": \"b453a6f3-c578-401c-a8cd-4bc72e4dc3c1\",\n      \"name\": \"Update DAG State\",\n      \"type\": \"n8n-nodes-base.set\",\n      \"typeVersion\": 3.4,\n      \"position\": [\n        680,\n        300\n      ],\n      \"parameters\": {\n        \"assignments\": {\n          \"assignments\": [\n            {\n              \"id\": \"f040fb47-aec2-4173-8509-e24468e0a34d\",\n              \"name\": \"event\",\n              \"value\": \"task_merged\",\n              \"type\": \"string\"\n            },\n            {\n              \"id\": \"1a559a8c-2f91-4920-bb69-64a9162496e2\",\n              \"name\": \"mr_iid\",\n              \"value\": \"={{ $json.body.object_attributes.iid }}\",\n              \"type\": \"string\"\n            },\n            {\n              \"id\": \"d2ea9e0d-c2de-4d30-a817-9b25facee345\",\n              \"name\": \"branch\",\n              \"value\": \"={{ $json.body.object_attributes.source_branch }}\",\n              \"type\": \"string\"\n            },\n            {\n              \"id\": \"e3f5a6b7-1234-4abc-9def-0123456789ab\",\n              \"name\": \"story_branch\",\n              \"value\": \"={{ $json.body.object_attributes.target_branch }}\",\n              \"type\": \"string\"\n            },\n            {\n              \"id\": \"f4a6b7c8-2345-4bcd-8ef0-123456789abc\",\n              \"name\": \"story_id\",\n              \"value\": \"={{ $json.body.object_attributes.target_branch.replace('story/', '') }}\",\n              \"type\": \"string\"\n            }\n          ]\n        }\n      }\n    },\n    {\n      \"id\": \"2ba76ce2-cdb6-4d7b-92ba-a9a2b10d3726\",\n      \"name\": \"All Story Tasks Done?\",\n      \"type\": \"n8n-nodes-base.code\",\n      \"typeVersion\": 2,\n      \"position\": [\n        900,\n        300\n      ],\n      \"parameters\": {\n        \"jsCode\": \"const storyBranch = $json.story_branch;\\nconst url = `${$env.GITLAB_URL}/api/v4/projects/${$json.body.project?.id ?? $env.GITLAB_PROJECT_PATH}/merge_requests?target_branch=${encodeURIComponent(storyBranch)}\u0026state=opened`;\\nconst res = await this.helpers.httpRequest({\\n  method: 'GET',\\n  url,\\n  headers: { 'PRIVATE-TOKEN': $env.GITLAB_TOKEN },\\n  json: true,\\n});\\nreturn [{ json: { ...$json, remaining: Array.isArray(res) ? res.length : 0 } }];\"\n      }\n    },\n    {\n      \"id\": \"9b62d1f1-9a5a-40ee-b9a0-859966ac85e5\",\n      \"name\": \"Tasks Remaining?\",\n      \"type\": \"n8n-nodes-base.if\",\n      \"typeVersion\": 2,\n      \"position\": [\n        1120,\n        300\n      ],\n      \"parameters\": {\n        \"conditions\": {\n          \"options\": {\n            \"leftValue\": \"={{ $json.remaining }}\",\n            \"operation\": \"equals\",\n            \"rightValue\": \"0\"\n          }\n        }\n      }\n    },\n    {\n      \"id\": \"c16a2450-10cf-4cfa-8ff6-b0f3e72d09a9\",\n      \"name\": \"→ F-06 DoD Check\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      