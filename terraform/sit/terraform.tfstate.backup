{"version":4,"terraform_version":"1.12.5","serial":47,"lineage":"3958731b-1d2b-0fa2-ec02-a5a2ba163e71","outputs":{},"resources":[{"module":"module.platform_apps","mode":"managed","type":"helm_release","name":"apicurio","provider":"provider[\"registry.opentofu.org/hashicorp/helm\"]","instances":[{"index_key":0,"schema_version":1,"attributes":{"atomic":false,"chart":"../modules/platform-apps/../../../helm/apicurio-registry","cleanup_on_fail":false,"create_namespace":false,"dependency_update":true,"description":null,"devel":null,"disable_crd_hooks":false,"disable_openapi_validation":false,"disable_webhooks":false,"force_update":false,"id":"apicurio-registry","keyring":null,"lint":false,"manifest":null,"max_history":0,"metadata":[{"app_version":"","chart":"apicurio-registry","first_deployed":1791434586,"last_deployed":1791434586,"name":"apicurio-registry","namespace":"apicurio","notes":"","revision":1,"values":"{\"apicurio-registry\":{\"registry\":{\"enabled\":true}}}","version":"0.1.0"}],"name":"apicurio-registry","namespace":"apicurio","pass_credentials":false,"postrender":[],"recreate_pods":false,"render_subchart_notes":true,"replace":false,"repository":null,"repository_ca_file":null,"repository_cert_file":null,"repository_key_file":null,"repository_password":null,"repository_username":null,"reset_values":false,"reuse_values":false,"set":[],"set_list":[],"set_sensitive":[],"skip_crds":false,"status":"deployed","timeout":600,"upgrade_install":null,"values":["# ponytail: chart defaults already do what we want - registry.enabled=true,\n# in-memory storage (kafka/postgres persistence block left commented in the\n# upstream chart = mem image variant). Chart also ships a \"sync\" sidecar\n# component (k8s-resource sync) enabled by default - harmless, left as-is.\n# Migrate to the kafka-backed persistence block (against helm_release.kafka)\n# before production actually depends on schemas surviving a restart.\napicurio-registry:\n  registry:\n    enabled: true\n"],"verify":false,"version":"0.1.0","wait":true,"wait_for_jobs":false},"sensitive_attributes":[[{"type":"get_attr","value":"repository_password"}]],"private":"eyJzY2hlbWFfdmVyc2lvbiI6IjEifQ==","dependencies":["module.platform_apps.kubernetes_namespace.apicurio"]}]},{"module":"module.platform_apps","mode":"managed","type":"helm_release","name":"authentik","provider":"provider[\"registry.opentofu.org/hashicorp/helm\"]","instances":[{"index_key":0,"schema_version":1,"attributes":{"atomic":false,"chart":"../modules/platform-apps/../../../helm/authentik","cleanup_on_fail":false,"create_namespace":false,"dependency_update":true,"description":null,"devel":null,"disable_crd_hooks":false,"disable_openapi_validation":false,"disable_webhooks":false,"force_update":false,"id":"authentik","keyring":null,"lint":false,"manifest":null,"max_history":0,"metadata":[{"app_version":"","chart":"authentik","first_deployed":1791434771,"last_deployed":1791434771,"name":"authentik","namespace":"authentik","notes":"Run the commands below to get a kubeconfig file for authentik:\n\nKUBE_API=$(kubectl config view --minify --output jsonpath=\"{.clusters[*].cluster.server}\")\nNAMESPACE=authentik\nSECRET_NAME=$(kubectl get serviceaccount authentik -o jsonpath='{.secrets[0].name}' 2\u003e/dev/null || echo -n \"authentik\")\nKUBE_CA=$(kubectl -n $NAMESPACE get secret/$SECRET_NAME -o jsonpath='{.data.ca\\.crt}')\nKUBE_TOKEN=$(kubectl -n $NAMESPACE get secret/$SECRET_NAME -o jsonpath='{.data.token}' | base64 --decode)\n\necho \"apiVersion: v1\nkind: Config\nclusters:\n- name: default-cluster\n  cluster:\n    certificate-authority-data: ${KUBE_CA}\n    server: ${KUBE_API}\ncontexts:\n- name: default-context\n  context:\n    cluster: default-cluster\n    namespace: $NAMESPACE\n    user: authentik-user\ncurrent-context: default-context\nusers:\n- name: authentik-user\n  user:\n    token: ${KUBE_TOKEN}\"\n","revision":1,"values":"{\"authentik\":{\"authentik\":{\"log_level\":\"info\",\"postgresql\":{\"host\":\"postgres.postgres.svc.cluster.local\",\"name\":\"authentik\",\"password\":\"(sensitive value)\",\"user\":\"authentik\"},\"redis\":{\"host\":\"redis.redis.svc.cluster.local\"},\"secret_key\":\"(sensitive value)\"},\"global\":{\"env\":[{\"name\":\"AUTHENTIK_BOOTSTRAP_TOKEN\",\"value\":\"dev-phase-authentik-bootstrap-token-not-for-prod-use\"},{\"name\":\"AUTHENTIK_BOOTSTRAP_PASSWORD\",\"value\":\"Admin1234!\"}]},\"postgresql\":{\"enabled\":false},\"redis\":{\"enabled\":false},\"server\":{\"ingress\":{\"enabled\":false},\"replicas\":1},\"worker\":{\"replicas\":1}}}","version":"0.1.0"}],"name":"authentik","namespace":"authentik","pass_credentials":false,"postrender":[],"recreate_pods":false,"render_subchart_notes":true,"replace":false,"repository":null,"repository_ca_file":null,"repository_cert_file":null,"repository_key_file":null,"repository_password":null,"repository_username":null,"reset_values":false,"reuse_values":false,"set":[{"name":"authentik.global.env[0].name","type":"","value":"AUTHENTIK_BOOTSTRAP_TOKEN"},{"name":"authentik.global.env[1].name","type":"","value":"AUTHENTIK_BOOTSTRAP_PASSWORD"}],"set_list":[],"set_sensitive":[{"name":"authentik.authentik.postgresql.password","type":"","value":"dev-phase-shared-db-password-not-for-prod-use"},{"name":"authentik.authentik.secret_key","type":"","value":"dev-phase-authentik-secret-key-not-for-prod-use"},{"name":"authentik.global.env[0].value","type":"","value":"dev-phase-authentik-bootstrap-token-not-for-prod-use"},{"name":"authentik.global.env[1].value","type":"","value":"Admin1234!"}],"skip_crds":false,"status":"deployed","timeout":900,"upgrade_install":null,"values":["# ponytail: sit/uat/production only. Unlike values.yaml (internal cluster -\n# shared postgres/redis, tailscale/OIDC/traefik-local ingress wiring) these\n# phase clusters get their own dedicated postgres/redis pods instead (see\n# postgres.tf/redis.tf) - no ingress (reached via port-forward/in-cluster\n# only for now).\n# secret_key / bootstrap token+password are set via terraform `set_sensitive`\n# (same pattern as internal's authentik.tf), not in this file.\nauthentik:\n  authentik:\n    log_level: info\n\n    # ponytail: dedicated postgres:16 / redis:7-alpine per phase cluster\n    # (postgres.tf / redis.tf in platform-apps, same official images as\n    # internal's helm/postgres / helm/redis) — avoids the goauthentik chart's\n    # bundled bitnami postgresql/redis subcharts entirely.\n    postgresql:\n      host: \"postgres.postgres.svc.cluster.local\"\n      name: \"authentik\"\n      user: \"authentik\"\n      password: \"\"  # set via terraform (phase_shared_db_password)\n    redis:\n      host: \"redis.redis.svc.cluster.local\"\n\n  postgresql:\n    enabled: false\n  redis:\n    enabled: false\n\n  server:\n    replicas: 1\n    ingress:\n      enabled: false\n\n  worker:\n    replicas: 1\n"],"verify":false,"version":"0.1.0","wait":true,"wait_for_jobs":false},"sensitive_attributes":[[{"type":"get_attr","value":"repository_password"}],[{"type":"get_attr","value":"set_sensitive"}]],"private":"eyJzY2hlbWFfdmVyc2lvbiI6IjEifQ==","dependencies":["module.platform_apps.helm_release.postgres","module.platform_apps.helm_release.redis","module.platform_apps.kubernetes_namespace.authentik","module.platform_apps.kubernetes_namespace.postgres","module.platform_apps.kubernetes_namespace.redis"]}]},{"module":"module.platform_apps","mode":"managed","type":"helm_release","name":"kafka","provider":"provider[\"registry.opentofu.org/hashicorp/helm\"]","instances":[{"index_key":0,"schema_version":1,"attributes":{"atomic":false,"chart":"../modules/platform-apps/../../../helm/kafka","cleanup_on_fail":false,"create_namespace":false,"dependency_update":true,"description":null,"devel":null,"disable_crd_hooks":false,"disable_openapi_validation":false,"disable_webhooks":false,"force_update":false,"id":"kafka","keyring":null,"lint":false,"manifest":null,"max_history":0,"metadata":[{"app_version":"","chart":"kafka","first_deployed":1791434584,"last_deployed":1791434584,"name":"kafka","namespace":"kafka","notes":"","revision":1,"values":"{\"image\":\"apache/kafka:4.3.0\",\"resources\":{\"limits\":{\"memory\":\"1Gi\"},\"requests\":{\"cpu\":\"100m\",\"memory\":\"512Mi\"}},\"storageSize\":\"2Gi\"}","version":"0.1.0"}],"name":"kafka","namespace":"kafka","pass_credentials":false,"postrender":[],"recreate_pods":false,"render_subchart_notes":true,"replace":false,"repository":null,"repository_ca_file":null,"repository_cert_file":null,"repository_key_file":null,"repository_password":null,"repository_username":null,"reset_values":false,"reuse_values":false,"set":[],"set_list":[],"set_sensitive":[],"skip_crds":false,"status":"deployed","timeout":600,"upgrade_install":null,"values":["# ponytail: single-node KRaft (combined broker+controller), PLAINTEXT\n# listener (no SASL/TLS) - fine for cluster-internal-only traffic in a lab.\n# Official apache/kafka image (no bitnami). Add SASL/TLS + more nodes before\n# anything outside the cluster needs to reach it.\nimage: apache/kafka:4.3.0\n\nstorageSize: 2Gi\n\nresources:\n  requests:\n    cpu: 100m\n    memory: 512Mi\n  limits:\n    memory: 1Gi\n"],"verify":false,"version":"0.1.0","wait":true,"wait_for_jobs":false},"sensitive_attributes":[[{"type":"get_attr","value":"repository_password"}]],"private":"eyJzY2hlbWFfdmVyc2lvbiI6IjEifQ==","dependencies":["module.platform_apps.kubernetes_namespace.kafka"]}]},{"module":"module.platform_apps","mode":"managed","type":"helm_release","name":"log_shipper","provider":"provider[\"registry.opentofu.org/hashicorp/helm\"]","instances":[{"schema_version":1,"attributes":{"atomic":false,"chart":"../modules/platform-apps/../../../helm/log-shipper","cleanup_on_fail":false,"create_namespace":false,"dependency_update":true,"description":null,"devel":null,"disable_crd_hooks":false,"disable_openapi_validation":false,"disable_webhooks":false,"force_update":false,"id":"log-shipper","keyring":null,"lint":false,"manifest":null,"max_history":0,"metadata":[{"app_version":"","chart":"log-shipper","first_deployed":1791434586,"last_deployed":1791434586,"name":"log-shipper","namespace":"log-shipper","notes":"Welcome to Grafana Alloy!\n","revision":1,"values":"{\"alloy\":{\"alloy\":{\"configMap\":{\"content\":\"// ── K8s pod logs → internal Loki ─────────────────────────────────────\\ndiscovery.kubernetes \\\"pods\\\" {\\n  role = \\\"pod\\\"\\n}\\n\\ndiscovery.relabel \\\"pod_logs\\\" {\\n  targets = discovery.kubernetes.pods.targets\\n  rule {\\n    source_labels = [\\\"__meta_kubernetes_pod_node_name\\\"]\\n    target_label  = \\\"node\\\"\\n  }\\n  rule {\\n    source_labels = [\\\"__meta_kubernetes_namespace\\\"]\\n    target_label  = \\\"namespace\\\"\\n  }\\n  rule {\\n    source_labels = [\\\"__meta_kubernetes_pod_name\\\"]\\n    target_label  = \\\"pod\\\"\\n  }\\n  rule {\\n    source_labels = [\\\"__meta_kubernetes_pod_container_name\\\"]\\n    target_label  = \\\"container\\\"\\n  }\\n  rule {\\n    source_labels = [\\\"__meta_kubernetes_pod_label_app_kubernetes_io_name\\\"]\\n    target_label  = \\\"app\\\"\\n  }\\n  rule {\\n    target_label = \\\"cluster_id\\\"\\n    replacement  = \\\"sit\\\"\\n  }\\n}\\n\\nloki.source.kubernetes \\\"pods\\\" {\\n  targets    = discovery.relabel.pod_logs.output\\n  forward_to = [loki.write.default.receiver]\\n}\\n\\nloki.write \\\"default\\\" {\\n  endpoint {\\n    url = \\\"http://host.docker.internal:30511/loki/api/v1/push\\\"\\n  }\\n}\\n\\n// ── OTLP traces (apps in this cluster → Alloy → internal Tempo) ──────\\notelcol.receiver.otlp \\\"default\\\" {\\n  http { endpoint = \\\"0.0.0.0:4318\\\" }\\n  grpc { endpoint = \\\"0.0.0.0:4317\\\" }\\n  output {\\n    traces = [otelcol.exporter.otlp.tempo.input]\\n  }\\n}\\n\\notelcol.exporter.otlp \\\"tempo\\\" {\\n  client {\\n    endpoint = \\\"host.docker.internal:30512\\\"\\n    tls {\\n      insecure = true\\n    }\\n  }\\n}\\n\"},\"extraPorts\":[{\"name\":\"otlp-grpc\",\"port\":4317,\"protocol\":\"TCP\",\"targetPort\":4317},{\"name\":\"otlp-http\",\"port\":4318,\"protocol\":\"TCP\",\"targetPort\":4318}]},\"resources\":{\"limits\":{\"memory\":\"128Mi\"},\"requests\":{\"cpu\":\"50m\",\"memory\":\"64Mi\"}}}}","version":"0.1.0"}],"name":"log-shipper","namespace":"log-shipper","pass_credentials":false,"postrender":[],"recreate_pods":false,"render_subchart_notes":true,"replace":false,"repository":null,"repository_ca_file":null,"repository_cert_file":null,"repository_key_file":null,"repository_password":null,"repository_username":null,"reset_values":false,"reuse_values":false,"set":[],"set_list":[],"set_sensitive":[],"skip_crds":false,"status":"deployed","timeout":300,"upgrade_install":null,"values":["# Logs + traces for this phase cluster, bridged to internal's Grafana stack\n# via host.docker.internal (same pattern opencost.tf's Mimir remote_write\n# bridge uses) — see terraform/modules/platform-apps/log-shipper.tf.\nalloy:\n  alloy:\n    # ponytail: extraPorts so generated apps in THIS cluster can reach this\n    # Alloy's OTLP receiver (traces only — logs are scraped from stdout\n    # automatically below, apps don't push those). Same reasoning as\n    # helm/observability's own Alloy Service (values.yaml's alloy.extraPorts).\n    extraPorts:\n      - name: otlp-grpc\n        port: 4317\n        targetPort: 4317\n        protocol: TCP\n      - name: otlp-http\n        port: 4318\n        targetPort: 4318\n        protocol: TCP\n\n    configMap:\n      content: |\n        // ── K8s pod logs → internal Loki ─────────────────────────────────────\n        discovery.kubernetes \"pods\" {\n          role = \"pod\"\n        }\n\n        discovery.relabel \"pod_logs\" {\n          targets = discovery.kubernetes.pods.targets\n          rule {\n            source_labels = [\"__meta_kubernetes_pod_node_name\"]\n            target_label  = \"node\"\n          }\n          rule {\n            source_labels = [\"__meta_kubernetes_namespace\"]\n            target_label  = \"namespace\"\n          }\n          rule {\n            source_labels = [\"__meta_kubernetes_pod_name\"]\n            target_label  = \"pod\"\n          }\n          rule {\n            source_labels = [\"__meta_kubernetes_pod_container_name\"]\n            target_label  = \"container\"\n          }\n          rule {\n            source_labels = [\"__meta_kubernetes_pod_label_app_kubernetes_io_name\"]\n            target_label  = \"app\"\n          }\n          rule {\n            target_label = \"cluster_id\"\n            replacement  = \"sit\"\n          }\n        }\n\n        loki.source.kubernetes \"pods\" {\n          targets    = discovery.relabel.pod_logs.output\n          forward_to = [loki.write.default.receiver]\n        }\n\n        loki.write \"default\" {\n          endpoint {\n            url = \"http://host.docker.internal:30511/loki/api/v1/push\"\n          }\n        }\n\n        // ── OTLP traces (apps in this cluster → Alloy → internal Tempo) ──────\n        otelcol.receiver.otlp \"default\" {\n          http { endpoint = \"0.0.0.0:4318\" }\n          grpc { endpoint = \"0.0.0.0:4317\" }\n          output {\n            traces = [otelcol.exporter.otlp.tempo.input]\n          }\n        }\n\n        otelcol.exporter.otlp \"tempo\" {\n          client {\n            endpoint = \"host.docker.internal:30512\"\n            tls {\n              insecure = true\n            }\n          }\n        }\n\n  resources:\n    requests:\n      cpu: 50m\n      memory: 64Mi\n    limits:\n      memory: 128Mi\n"],"verify":false,"version":"0.1.0","wait":true,"wait_for_jobs":false},"sensitive_attributes":[[{"type":"get_attr","value":"repository_password"}]],"private":"eyJzY2hlbWFfdmVyc2lvbiI6IjEifQ==","dependencies":["module.platform_apps.kubernetes_namespace.log_shipper"]}]},{"module":"module.platform_apps","mode":"managed","type":"helm_release","name":"meilisearch","provider":"provider[\"registry.opentofu.org/hashicorp/helm\"]","instances":[{"index_key":0,"schema_version":1,"attributes":{"atomic":false,"chart":"../modules/platform-apps/../../../helm/meilisearch","cleanup_on_fail":false,"create_namespace":false,"dependency_update":true,"description":null,"devel":null,"disable_crd_hooks":false,"disable_openapi_validation":false,"disable_webhooks":false,"force_update":false,"id":"meilisearch","keyring":null,"lint":false,"manifest":null,"max_history":0,"metadata":[{"app_version":"","chart":"meilisearch","first_deployed":1791434584,"last_deployed":1791434584,"name":"meilisearch","namespace":"meilisearch","notes":"1. Get the application URL by running these commands:\n  kubectl port-forward --namespace meilisearch svc/meilisearch 7700:7700 \u0026\n  echo \"Visit http://127.0.0.1:7700 to use your application\"","revision":1,"values":"{\"meilisearch\":{\"environment\":{\"MEILI_MASTER_KEY\":\"(sensitive value)\"},\"persistence\":{\"enabled\":true,\"size\":\"1Gi\"}}}","version":"0.1.0"}],"name":"meilisearch","namespace":"meilisearch","pass_credentials":false,"postrender":[],"recreate_pods":false,"render_subchart_notes":true,"replace":false,"repository":null,"repository_ca_file":null,"repository_cert_file":null,"repository_key_file":null,"repository_password":null,"repository_username":null,"reset_values":false,"reuse_values":false,"set":[],"set_list":[],"set_sensitive":[{"name":"meilisearch.environment.MEILI_MASTER_KEY","type":"","value":"dev-phase-meilisearch-master-key-not-for-prod-use"}],"skip_crds":false,"status":"deployed","timeout":600,"upgrade_install":null,"values":["# ponytail: MEILI_MASTER_KEY set via terraform `set_sensitive`\n# (meilisearch.tf), not in this file.\nmeilisearch:\n  persistence:\n    enabled: true\n    size: 1Gi\n"],"verify":false,"version":"0.1.0","wait":true,"wait_for_jobs":false},"sensitive_attributes":[[{"type":"get_attr","value":"repository_password"}],[{"type":"get_attr","value":"set_sensitive"}]],"private":"eyJzY2hlbWFfdmVyc2lvbiI6IjEifQ==","dependencies":["module.platform_apps.kubernetes_namespace.meilisearch"]}]},{"module":"module.platform_apps","mode":"managed","type":"helm_release","name":"minio","provider":"provider[\"registry.opentofu.org/hashicorp/helm\"]","instances":[{"index_key":0,"schema_version":1,"attributes":{"atomic":false,"chart":"minio","cleanup_on_fail":false,"create_namespace":false,"dependency_update":false,"description":"Install complete","devel":null,"disable_crd_hooks":false,"disable_openapi_validation":false,"disable_webhooks":false,"force_update":false,"id":"minio","keyring":null,"lint":false,"manifest":null,"max_history":0,"metadata":[{"app_version":"","chart":"minio","first_deployed":1791435392,"last_deployed":1791435392,"name":"minio","namespace":"minio","notes":"\nMinIO can be accessed via port 9000 on the following DNS name from within your cluster:\nminio.minio.cluster.local\n\nTo access MinIO from localhost, run the below commands:\n\n  1. export POD_NAME=$(kubectl get pods --namespace minio -l \"release=minio\" -o jsonpath=\"{.items[0].metadata.name}\")\n\n  2. kubectl port-forward $POD_NAME 9000 --namespace minio\n\nRead more about port forwarding here: http://kubernetes.io/docs/user-guide/kubectl/kubectl_port-forward/\n\nYou can now access MinIO server on http://localhost:9000. Follow the below steps to connect to MinIO server with mc client:\n\n  1. Download the MinIO mc client - https://min.io/docs/minio/linux/reference/minio-mc.html#quickstart\n\n  2. export MC_HOST_minio-local=http://$(kubectl get secret --namespace minio minio -o jsonpath=\"{.data.rootUser}\" | base64 --decode):$(kubectl get secret --namespace minio minio -o jsonpath=\"{.data.rootPassword}\" | base64 --decode)@localhost:9000\n\n  3. mc ls minio-local\n\n\n","revision":1,"values":"{\"minio\":{\"consoleIngress\":{\"enabled\":false},\"drivesPerNode\":1,\"ingress\":{\"enabled\":false},\"mode\":\"standalone\",\"persistence\":{\"size\":\"2Gi\"},\"pools\":1,\"replicas\":1,\"rootPassword\":\"dev-phase-minio-root-password-not-for-prod-use\",\"rootUser\":\"admin\",\"trustedCertsSecret\":\"\"}}","version":"0.1.0"}],"name":"minio","namespace":"minio","pass_credentials":false,"postrender":[],"recreate_pods":false,"render_subchart_notes":true,"replace":false,"repository":null,"repository_ca_file":null,"repository_cert_file":null,"repository_key_file":null,"repository_password":null,"repository_username":null,"reset_values":false,"reuse_values":false,"set":[],"set_list":[],"set_sensitive":[],"skip_crds":false,"status":"deployed","timeout":300,"upgrade_install":null,"values":null,"verify":false,"version":"0.1.0","wait":true,"wait_for_jobs":false},"sensitive_attributes":[[{"type":"get_attr","value":"repository_password"}],[{"type":"get_attr","value":"set_sensitive"}]],"private":"eyJzY2hlbWFfdmVyc2lvbiI6IjEifQ=="}]},{"module":"module.platform_apps","mode":"managed","type":"helm_release","name":"opencost","provider":"provider[\"registry.opentofu.org/hashicorp/helm\"]","instances":[{"index_key":0,"schema_version":1,"attributes":{"atomic":false,"chart":"../modules/platform-apps/../../../helm/opencost","cleanup_on_fail":false,"create_namespace":false,"dependency_update":true,"description":null,"devel":null,"disable_crd_hooks":false,"disable_openapi_validation":false,"disable_webhooks":false,"force_update":false,"id":"opencost","keyring":null,"lint":false,"manifest":null,"max_history":0,"metadata":[{"app_version":"","chart":"opencost","first_deployed":1791434584,"last_deployed":1791434584,"name":"opencost","namespace":"opencost","notes":"1. Get the application URL by running these commands:\n  export POD_NAME=$(kubectl get pods --namespace opencost -l \"app.kubernetes.io/name=prometheus-node-exporter,app.kubernetes.io/instance=opencost\" -o jsonpath=\"{.items[0].metadata.name}\")\n  echo \"Visit http://127.0.0.1:9100 to use your application\"\n  kubectl port-forward --namespace opencost $POD_NAME 9100\nThe Prometheus server can be accessed via port 80 on the following DNS name from within your cluster:\nopencost-prometheus-server.opencost.svc.cluster.local\n\n\nGet the Prometheus server URL by running these commands in the same shell:\n  export POD_NAME=$(kubectl get pods --namespace opencost -l \"app.kubernetes.io/name=prometheus,app.kubernetes.io/instance=opencost\" -o jsonpath=\"{.items[0].metadata.name}\")\n  kubectl --namespace opencost port-forward $POD_NAME 9090\n\n\n\n\n\nFor more information on running Prometheus, visit:\nhttps://prometheus.io/\n\nkube-state-metrics is a simple service that listens to the Kubernetes API server and generates metrics about the state of the objects.\nThe exposed metrics can be found here:\nhttps://github.com/kubernetes/kube-state-metrics/blob/master/docs/README.md#exposed-metrics\n\nThe metrics are exported on the HTTP endpoint /metrics on the listening port.\nIn your case, opencost-kube-state-metrics.opencost.svc.cluster.local:8080/metrics\n\nThey are served either as plaintext or protobuf depending on the Accept header.\nThey are designed to be consumed either by Prometheus itself or by a scraper that is compatible with scraping a Prometheus client endpoint.\n\nThank you for installing the OpenCost Helm Chart!\n\nYour release is named: opencost\n\nTo verify that OpenCost is running, execute the following commands:\n\n1. Check the status of the pods:\n   kubectl get pods -l app.kubernetes.io/instance=opencost -n opencost\n\n2. Access the OpenCost UI:\n\n   If the service is only accessible within the cluster, you can use port-forwarding:\n   export SVC_NAME=opencost\n   kubectl port-forward svc/$SVC_NAME 9090 -n opencost\n\n   Alternatively, you can port-forward directly to the OpenCost pod:\n   export POD_NAME=$(kubectl get pod -l app.kubernetes.io/instance=opencost -n opencost -o jsonpath=\"{.items[0].metadata.name}\")\n   kubectl -n opencost port-forward $POD_NAME 9090\n\nFor more information, visit the OpenCost documentation:\nhttps://www.opencost.io/docs/","revision":1,"values":"{\"oc\":{\"fullnameOverride\":\"opencost\",\"opencost\":{\"prometheus\":{\"external\":{\"enabled\":true,\"url\":\"http://opencost-prometheus-server.opencost.svc.cluster.local:80\"},\"internal\":{\"enabled\":false}},\"ui\":{\"enabled\":false}},\"podAnnotations\":{\"prometheus.io/path\":\"/metrics\",\"prometheus.io/port\":\"9003\",\"prometheus.io/scrape\":\"true\"}},\"prometheus\":{\"alertmanager\":{\"enabled\":false},\"enabled\":true,\"kube-state-metrics\":{\"enabled\":true},\"prometheus-node-exporter\":{\"enabled\":true},\"prometheus-pushgateway\":{\"enabled\":false},\"server\":{\"global\":{\"evaluation_interval\":\"15s\",\"external_labels\":{\"cluster_id\":\"sit\"},\"scrape_interval\":\"15s\"},\"persistentVolume\":{\"enabled\":true,\"size\":\"2Gi\"},\"remoteWrite\":[{\"url\":\"http://host.docker.internal:30510/api/v1/push\"}],\"resources\":{\"limits\":{\"memory\":\"1536Mi\"},\"requests\":{\"cpu\":\"50m\",\"memory\":\"512Mi\"}},\"retention\":\"3d\"}}}","version":"0.1.0"}],"name":"opencost","namespace":"opencost","pass_credentials":false,"postrender":[],"recreate_pods":false,"render_subchart_notes":true,"replace":false,"repository":null,"repository_ca_file":null,"repository_cert_file":null,"repository_key_file":null,"repository_password":null,"repository_username":null,"reset_values":false,"reuse_values":false,"set":[{"name":"oc.opencost.prometheus.external.url","type":"","value":"http://opencost-prometheus-server.opencost.svc.cluster.local:80"},{"name":"prometheus.enabled","type":"","value":"true"},{"name":"prometheus.server.global.external_labels.cluster_id","type":"","value":"sit"},{"name":"prometheus.server.remoteWrite[0].url","type":"","value":"http://host.docker.internal:30510/api/v1/push"}],"set_list":[],"set_sensitive":[],"skip_crds":false,"status":"deployed","timeout":600,"upgrade_install":null,"values":["# ponytail: shared across all 4 clusters. oc.opencost.prometheus.external.url\n# and the prometheus.* block differ per cluster (internal -\u003e observability's\n# Mimir, prometheus.enabled stays false; sit/uat/production -\u003e the bundled\n# prometheus dependency below, prometheus.enabled=true) - set via terraform\n# `set{}` in each cluster's opencost.tf, not in this file. No bundled UI -\n# cost data surfaces through the Grafana dashboard\n# (helm/observability/dashboards/opencost.json) instead, so there's nothing\n# here needing tailscale/authentik exposure the way kubecost's native UI did.\n#\n# ponytail: the \"oc\" alias (Chart.yaml) + the double \"opencost.opencost.*\"\n# nesting below aren't decorative — the upstream chart's own values.yaml\n# nests almost everything under an internal \"opencost:\" key, and our\n# dependency is *also* named \"opencost\", so without the alias every path here\n# would collide and silently not apply (verified: --set opencost.ui.enabled\n# through an unaliased dependency is a no-op; --set oc.opencost.ui.enabled\n# through the alias is not).\noc:\n  # deterministic service/deployment name regardless of the alias/release-name\n  # substring quirk above (fullname helper would otherwise emit \"opencost-oc\").\n  fullnameOverride: opencost\n\n  # scraped by whichever Prometheus opencost.prometheus.external.url points\n  # back at (community `prometheus` chart's default scrape config picks up\n  # any pod carrying these annotations). Root-level in the subchart's own\n  # values schema, not nested under the inner opencost: block.\n  podAnnotations:\n    prometheus.io/scrape: \"true\"\n    prometheus.io/port: \"9003\"\n    prometheus.io/path: \"/metrics\"\n\n  opencost:\n    prometheus:\n      internal:\n        enabled: false\n      external:\n        enabled: true\n        # placeholder - every cluster's opencost.tf overrides this with the\n        # real endpoint.\n        url: \"http://REPLACED-BY-TERRAFORM\"\n\n    ui:\n      enabled: false\n\n# bundled Prometheus for sit/uat/production only (see Chart.yaml condition) -\n# internal reuses helm/observability's existing one instead.\nprometheus:\n  enabled: false\n  server:\n    global:\n      scrape_interval: 15s\n      evaluation_interval: 15s\n    persistentVolume:\n      enabled: true\n      size: 2Gi\n    # ponytail: short - this cluster's own cost history isn't queried far\n    # back; longer retention lives in internal's Mimir via remoteWrite.\n    retention: \"3d\"\n    resources:\n      requests:\n        cpu: 50m\n        memory: 512Mi\n      limits:\n        memory: 1536Mi\n  alertmanager:\n    enabled: false\n  prometheus-pushgateway:\n    enabled: false\n  kube-state-metrics:\n    enabled: true\n  prometheus-node-exporter:\n    enabled: true\n"],"verify":false,"version":"0.1.0","wait":true,"wait_for_jobs":false},"sensitive_attributes":[[{"type":"get_attr","value":"repository_password"}]],"private":"eyJzY2hlbWFfdmVyc2lvbiI6IjEifQ==","dependencies":["module.platform_apps.kubernetes_namespace.opencost"]}]},{"module":"module.platform_apps","mode":"managed","type":"helm_release","name":"postgres","provider":"provider[\"registry.opentofu.org/hashicorp/helm\"]","instances":[{"index_key":0,"schema_version":1,"attributes":{"atomic":false,"chart":"../modules/platform-apps/../../../helm/postgres","cleanup_on_fail":false,"create_namespace":false,"dependency_update":true,"description":null,"devel":null,"disable_crd_hooks":false,"disable_openapi_validation":false,"disable_webhooks":false,"force_update":false,"id":"postgres","keyring":null,"lint":false,"manifest":null,"max_history":0,"metadata":[{"app_version":"","chart":"postgres","first_deployed":1791434584,"last_deployed":1791434584,"name":"postgres","namespace":"postgres","notes":"","revision":1,"values":"{\"databases\":[\"authentik\"],\"gitlabDatabase\":\"\",\"password\":\"(sensitive value)\"}","version":"0.1.0"}],"name":"postgres","namespace":"postgres","pass_credentials":false,"postrender":[],"recreate_pods":false,"render_subchart_notes":true,"replace":false,"repository":null,"repository_ca_file":null,"repository_cert_file":null,"repository_key_file":null,"repository_password":null,"repository_username":null,"reset_values":false,"reuse_values":false,"set":[{"name":"databases[0]","type":"","value":"authentik"},{"name":"gitlabDatabase","type":"","value":""}],"set_list":[],"set_sensitive":[{"name":"password","type":"","value":"dev-phase-shared-db-password-not-for-prod-use"}],"skip_crds":false,"status":"deployed","timeout":300,"upgrade_install":null,"values":null,"verify":false,"version":"0.1.0","wait":true,"wait_for_jobs":false},"sensitive_attributes":[[{"type":"get_attr","value":"repository_password"}],[{"type":"get_attr","value":"set_sensitive"}]],"private":"eyJzY2hlbWFfdmVyc2lvbiI6IjEifQ==","dependencies":["module.platform_apps.kubernetes_namespace.postgres"]}]},{"module":"module.platform_apps","mode":"managed","type":"helm_release","name":"redis","provider":"provider[\"registry.opentofu.org/hashicorp/helm\"]","instances":[{"index_key":0,"schema_version":1,"attributes":{"atomic":false,"chart":"../modules/platform-apps/../../../helm/redis","cleanup_on_fail":false,"create_namespace":false,"dependency_update":true,"description":null,"devel":null,"disable_crd_hooks":false,"disable_openapi_validation":false,"disable_webhooks":false,"force_update":false,"id":"redis","keyring":null,"lint":false,"manifest":null,"max_history":0,"metadata":[{"app_version":"","chart":"redis","first_deployed":1791434584,"last_deployed":1791434584,"name":"redis","namespace":"redis","notes":"","revision":1,"values":"{}","version":"0.1.0"}],"name":"redis","namespace":"redis","pass_credentials":false,"postrender":[],"recreate_pods":false,"render_subchart_notes":true,"replace":false,"repository":null,"repository_ca_file":null,"repository_cert_file":null,"repository_key_file":null,"repository_password":null,"repository_username":null,"reset_values":false,"reuse_values":false,"set":[],"set_list":[],"set_sensitive":[],"skip_crds":false,"status":"deployed","timeout":300,"upgrade_install":null,"values":null,"verify":false,"version":"0.1.0","wait":true,"wait_for_jobs":false},"sensitive_attributes":[[{"type":"get_attr","value":"repository_password"}]],"private":"eyJzY2hlbWFfdmVyc2lvbiI6IjEifQ==","dependencies":["module.platform_apps.kubernetes_namespace.redis"]}]},{"module":"module.platform_apps","mode":"managed","type":"helm_release","name":"traefik","provider":"provider[\"registry.opentofu.org/hashicorp/helm\"]","instances":[{"index_key":0,"schema_version":1,"attributes":{"atomic":false,"chart":"../modules/platform-apps/../../../helm/traefik","cleanup_on_fail":false,"create_namespace":false,"dependency_update":true,"description":null,"devel":null,"disable_crd_hooks":false,"disable_openapi_validation":false,"disable_webhooks":false,"force_update":false,"id":"traefik","keyring":null,"lint":false,"manifest":null,"max_history":0,"metadata":[{"app_version":"","chart":"traefik","first_deployed":1791434586,"last_deployed":1791434586,"name":"traefik","namespace":"traefik","notes":"\n\ntraefik with docker.io/traefik:v3.3.2 has been deployed successfully on traefik namespace !\n","revision":1,"values":"{\"traefik\":{\"deployment\":{\"replicas\":1},\"ports\":{\"web\":{\"port\":80},\"websecure\":{\"port\":443}},\"service\":{\"type\":\"LoadBalancer\"}}}","version":"0.1.0"}],"name":"traefik","namespace":"traefik","pass_credentials":false,"postrender":[],"recreate_pods":false,"render_subchart_notes":true,"replace":false,"repository":null,"repository_ca_file":null,"repository_cert_file":null,"repository_key_file":null,"repository_password":null,"repository_username":null,"reset_values":false,"reuse_values":false,"set":[],"set_list":[],"set_sensitive":[],"skip_crds":false,"status":"deployed","timeout":300,"upgrade_install":null,"values":["# ponytail: only used on the sit/uat/production phase clusters. The\n# \"internal\" cluster keeps k3s's own bundled traefik (kube-system) - unrelated\n# terraform/cert-manager/coredns wiring already depends on that one, don't\n# touch it. Phase clusters have k3s's traefik add-on disabled at cluster\n# creation (create-cluster.sh --k3s-arg disable=traefik) so this one owns\n# ports 80/443 instead.\ntraefik:\n  deployment:\n    replicas: 1\n\n  service:\n    type: LoadBalancer\n\n  ports:\n    web:\n      port: 80\n    websecure:\n      port: 443\n"],"verify":false,"version":"0.1.0","wait":true,"wait_for_jobs":false},"sensitive_attributes":[[{"type":"get_attr","value":"repository_password"}]],"private":"eyJzY2hlbWFfdmVyc2lvbiI6IjEifQ==","dependencies":["module.platform_apps.kubernetes_namespace.traefik"]}]},{"module":"module.platform_apps","mode":"managed","type":"helm_release","name":"unleash","provider":"provider[\"registry.opentofu.org/hashicorp/helm\"]","instances":[{"index_key":0,"schema_version":1,"attributes":{"atomic":false,"chart":"../modules/platform-apps/../../../helm/unleash","cleanup_on_fail":false,"create_namespace":false,"dependency_update":true,"description":null,"devel":null,"disable_crd_hooks":false,"disable_openapi_validation":false,"disable_webhooks":false,"force_update":false,"id":"unleash","keyring":null,"lint":false,"manifest":null,"max_history":0,"metadata":[{"app_version":"","chart":"unleash","first_deployed":1791434584,"last_deployed":1791434584,"name":"unleash","namespace":"unleash","notes":"CHART NAME: postgresql\nCHART VERSION: 13.4.4\nAPP VERSION: 16.1.0\n\n** Please be patient while the chart is being deployed **\n\nPostgreSQL can be accessed via port 5432 on the following DNS names from within your cluster:\n\n    unleash-postgresql.unleash.svc.cluster.local - Read/Write connection\n\nTo get the password for \"postgres\" run:\n\n    export POSTGRES_ADMIN_PASSWORD=$(kubectl get secret --namespace unleash unleash-postgresql -o jsonpath=\"{.data.postgres-password}\" | base64 -d)\n\nTo get the password for \"unleash\" run:\n\n    export POSTGRES_PASSWORD=$(kubectl get secret --namespace unleash unleash-postgresql -o jsonpath=\"{.data.password}\" | base64 -d)\n\nTo connect to your database run the following command:\n\n    kubectl run unleash-postgresql-client --rm --tty -i --restart='Never' --namespace unleash --image docker.io/postgres:18-alpine --env=\"PGPASSWORD=$POSTGRES_PASSWORD\" \\\n      --command -- psql --host unleash-postgresql -U unleash -d unleash -p 5432\n\n    \u003e NOTE: If you access the container using bash, make sure that you execute \"/opt/bitnami/scripts/postgresql/entrypoint.sh /bin/bash\" in order to avoid the error \"psql: local user with ID 1001} does not exist\"\n\nTo connect to your database from outside the cluster execute the following commands:\n\n    kubectl port-forward --namespace unleash svc/unleash-postgresql 5432:5432 \u0026\n    PGPASSWORD=\"$POSTGRES_PASSWORD\" psql --host 127.0.0.1 -U unleash -d unleash -p 5432\n\nWARNING: The configured password will be ignored on new installation in case when previous PostgreSQL release was deleted through the helm command. In that case, old PVC will have an old password, and setting it through helm won't take effect. Deleting persistent volumes (PVs) will solve the issue.\n\n1. Get the application URL by running these commands:\n  export POD_NAME=$(kubectl get pods --namespace unleash -l \"app.kubernetes.io/name=unleash,app.kubernetes.io/instance=unleash\" -o jsonpath=\"{.items[0].metadata.name}\")\n  export CONTAINER_PORT=$(kubectl get pod --namespace unleash $POD_NAME -o jsonpath=\"{.spec.containers[0].ports[0].containerPort}\")\n  echo \"Visit http://127.0.0.1:8080 to use your application\"\n  kubectl --namespace unleash port-forward $POD_NAME 8080:$CONTAINER_PORT\n","revision":1,"values":"{\"unleash\":{\"env\":[{\"name\":\"INIT_ADMIN_API_TOKENS\",\"value\":\"*:*.dev-phase-unleash-admin-password-not-for-prod-use\"}],\"postgresql\":{\"enabled\":true},\"replicaCount\":1}}","version":"0.1.0"}],"name":"unleash","namespace":"unleash","pass_credentials":false,"postrender":[],"recreate_pods":false,"render_subchart_notes":true,"replace":false,"repository":null,"repository_ca_file":null,"repository_cert_file":null,"repository_key_file":null,"repository_password":null,"repository_username":null,"reset_values":false,"reuse_values":false,"set":[{"name":"unleash.env[0].name","type":"","value":"INIT_ADMIN_API_TOKENS"}],"set_list":[],"set_sensitive":[{"name":"unleash.env[0].value","type":"","value":"*:*.dev-phase-unleash-admin-password-not-for-prod-use"}],"skip_crds":false,"status":"deployed","timeout":600,"upgrade_install":null,"values":["# ponytail: bundled postgresql subchart (own DB, not the shared homelab one -\n# these phase clusters have no shared postgres). Admin bootstrap token set\n# via terraform `set_sensitive` (unleash.tf, INIT_ADMIN_API_TOKENS env var),\n# not in this file.\nunleash:\n  replicaCount: 1\n\n  postgresql:\n    enabled: true\n"],"verify":false,"version":"0.1.0","wait":true,"wait_for_jobs":false},"sensitive_attributes":[[{"type":"get_attr","value":"repository_password"}],[{"type":"get_attr","value":"set_sensitive"}]],"private":"eyJzY2hlbWFfdmVyc2lvbiI6IjEifQ==","dependencies":["module.platform_apps.kubernetes_namespace.unleash"]}]},{"module":"module.platform_apps","mode":"managed","type":"helm_release","name":"vault","provider":"provider[\"registry.opentofu.org/hashicorp/helm\"]","instances":[{"index_key":0,"schema_version":1,"attributes":{"atomic":false,"chart":"../modules/platform-apps/../../../helm/vault","cleanup_on_fail":false,"create_namespace":false,"dependency_update":true,"description":null,"devel":null,"disable_crd_hooks":false,"disable_openapi_validation":false,"disable_webhooks":false,"force_update":false,"id":"vault","keyring":null,"lint":false,"manifest":null,"max_history":0,"metadata":[{"app_version":"","chart":"vault","first_deployed":1791434589,"last_deployed":1791434589,"name":"vault","namespace":"vault","notes":"\nThank you for installing HashiCorp Vault!\n\nNow that you have deployed Vault, you should look over the docs on using\nVault with Kubernetes available here:\n\nhttps://developer.hashicorp.com/vault/docs\n\n\nYour release is named vault. To learn more about the release, try:\n\n  $ helm status vault\n  $ helm get manifes