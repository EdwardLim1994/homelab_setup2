      960,\n        440\n      ]\n    }\n  ],\n  \"connections\": {\n    \"Webhook: F-12-uat-security-complete trigger\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Spawn security-engineer: uat-stage-2\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Spawn security-engineer: uat-stage-2\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Passed?\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Passed?\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Apply security:cleared on release ticket\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ],\n        [\n          {\n            \"node\": \"Create bug ticket (type:bug-uat)\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Apply security:cleared on release ticket\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Trigger next stage\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    }\n  },\n  \"active\": true,\n  \"settings\": {\n    \"executionOrder\": \"v1\"\n  },\n  \"tags\": [\n    {\n      \"name\": \"uat\"\n    },\n    {\n      \"name\": \"phase-3\"\n    }\n  ]\n}\n","F-13-uat-po-complete.json":"{\n  \"name\": \"F-13-uat-po-complete\",\n  \"nodes\": [\n    {\n      \"parameters\": {\n        \"httpMethod\": \"POST\",\n        \"path\": \"po-validation-start\",\n        \"responseMode\": \"lastNode\",\n        \"options\": {}\n      },\n      \"id\": \"webhook-F-13-uat-po-complete\",\n      \"name\": \"Webhook: F-13-uat-po-complete trigger\",\n      \"type\": \"n8n-nodes-base.webhook\",\n      \"typeVersion\": 1,\n      \"position\": [\n        240,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/spawn-role\",\n        \"sendBody\": true,\n        \"specifyBody\": \"json\",\n        \"jsonBody\": \"={{ JSON.stringify({ role: 'product-owner', task: 'uat-stage-3', version: $json.body.version, project: $json.body.project }) }}\",\n        \"options\": {}\n      },\n      \"id\": \"spawn-F-13-uat-po-complete\",\n      \"name\": \"Spawn product-owner: uat-stage-3\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4,\n      \"position\": [\n        480,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"conditions\": {\n          \"conditions\": [\n            {\n              \"leftValue\": \"={{ $json.exitCode }}\",\n              \"rightValue\": 0,\n              \"operator\": {\n                \"type\": \"number\",\n                \"operation\": \"equals\"\n              }\n            }\n          ]\n        }\n      },\n      \"id\": \"check-F-13-uat-po-complete\",\n      \"name\": \"Passed?\",\n      \"type\": \"n8n-nodes-base.if\",\n      \"typeVersion\": 2,\n      \"position\": [\n        720,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"command\": \"glab issue update {{ $json.body.release_ticket_id }} --label-add 'po:uat-approved' \u0026\u0026 glab issue comment {{ $json.body.release_ticket_id }} --message 'po:uat-approved applied'\"\n      },\n      \"id\": \"label-F-13-uat-po-complete\",\n      \"name\": \"Apply po:uat-approved on release ticket\",\n      \"type\": \"n8n-nodes-base.executeCommand\",\n      \"typeVersion\": 1,\n      \"position\": [\n        960,\n        200\n      ]\n    },\n    {\n      \"parameters\": {\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/f13-all-signoffs\",\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"version\",\n              \"value\": \"={{ $json.body.version }}\"\n            },\n            {\n              \"name\": \"project\",\n              \"value\": \"={{ $json.body.project }}\"\n            },\n            {\n              \"name\": \"release_ticket_id\",\n              \"value\": \"={{ $json.body.release_ticket_id }}\"\n            }\n          ]\n        }\n      },\n      \"id\": \"next-F-13-uat-po-complete\",\n      \"name\": \"Trigger next stage\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4,\n      \"position\": [\n        1200,\n        200\n      ]\n    },\n    {\n      \"parameters\": {\n        \"command\": \"glab issue create --title '[bugfix] product-owner finding during uat-stage-3' --label 'type:bugfix,role:product-owner' --milestone '{{ $json.body.version }}' --description 'Found during UAT uat-stage-3. Environment: UAT cluster.'\"\n      },\n      \"id\": \"bug-F-13-uat-po-complete\",\n      \"name\": \"Create bug ticket (type:bug-uat)\",\n      \"type\": \"n8n-nodes-base.executeCommand\",\n      \"typeVersion\": 1,\n      \"position\": [\n        960,\n        440\n      ]\n    }\n  ],\n  \"connections\": {\n    \"Webhook: F-13-uat-po-complete trigger\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Spawn product-owner: uat-stage-3\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Spawn product-owner: uat-stage-3\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Passed?\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Passed?\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Apply po:uat-approved on release ticket\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ],\n        [\n          {\n            \"node\": \"Create bug ticket (type:bug-uat)\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Apply po:uat-approved on release ticket\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Trigger next stage\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    }\n  },\n  \"active\": true,\n  \"settings\": {\n    \"executionOrder\": \"v1\"\n  },\n  \"tags\": [\n    {\n      \"name\": \"uat\"\n    },\n    {\n      \"name\": \"phase-3\"\n    }\n  ]\n}\n","F-14-release-staging.json":"{\n  \"name\": \"F-14 /release-staging\",\n  \"nodes\": [\n    {\n      \"parameters\": {\n        \"httpMethod\": \"POST\",\n        \"path\": \"release-staging\",\n        \"responseMode\": \"lastNode\",\n        \"options\": {}\n      },\n      \"id\": \"wh-14\",\n      \"name\": \"Webhook: /release-staging\",\n      \"type\": \"n8n-nodes-base.webhook\",\n      \"typeVersion\": 1,\n      \"position\": [\n        240,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"url\": \"={{ $env.GITLAB_URL }}/api/v4/projects/{{ $json.body.project_id }}/issues/{{ $json.body.release_ticket_id }}\",\n        \"sendHeaders\": true,\n        \"headerParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"PRIVATE-TOKEN\",\n              \"value\": \"={{ $env.GITLAB_TOKEN }}\"\n            }\n          ]\n        }\n      },\n      \"id\": \"check-signoffs-14\",\n      \"name\": \"Safeguard: check all 3 UAT sign-offs on release ticket\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4,\n      \"position\": [\n        480,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"jsCode\": \"const labels = $json.labels || [];\\nconst required = ['qa:uat-approved','security:cleared','po:uat-approved'];\\nconst missing = required.filter(l =\u003e !labels.includes(l));\\nreturn [{ json: { safe: missing.length === 0, missing, labels } }];\"\n      },\n      \"id\": \"validate-signoffs-14\",\n      \"name\": \"All UAT sign-offs present?\",\n      \"type\": \"n8n-nodes-base.code\",\n      \"typeVersion\": 2,\n      \"position\": [\n        720,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"conditions\": {\n          \"conditions\": [\n            {\n              \"leftValue\": \"={{ $json.safe }}\",\n              \"rightValue\": true,\n              \"operator\": {\n                \"type\": \"boolean\",\n                \"operation\": \"equals\"\n              }\n            }\n          ]\n        }\n      },\n      \"id\": \"gate-14\",\n      \"name\": \"Safeguard gate\",\n      \"type\": \"n8n-nodes-base.if\",\n      \"typeVersion\": 2,\n      \"position\": [\n        960,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/f14-feedback\",\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"message\",\n              \"value\": \"Staging blocked: missing UAT sign-offs\"\n            },\n            {\n              \"name\": \"missing\",\n              \"value\": \"={{ JSON.stringify($json.missing) }}\"\n            }\n          ]\n        }\n      },\n      \"id\": \"feedback-14\",\n      \"name\": \"Feedback to Edward: missing sign-offs\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4,\n      \"position\": [\n        1200,\n        440\n      ]\n    },\n    {\n      \"parameters\": {\n        \"command\": \"omp -p 'Create release-plan ticket as child of release ticket {{ $json.body.release_ticket_id }} for version {{ $json.body.version }}'\"\n      },\n      \"id\": \"rm-release-plan-14\",\n      \"name\": \"RM creates release plan ticket (omp+glab)\",\n      \"type\": \"n8n-nodes-base.executeCommand\",\n      \"typeVersion\": 1,\n      \"position\": [\n        1200,\n        160\n      ]\n    },\n    {\n      \"parameters\": {\n        \"command\": \"glab api projects/{{ $json.body.project_id }}/repository/branches --method POST -f branch='promote/{{ $json.body.version }}' -f ref='release/{{ $json.body.version }}'\"\n      },\n      \"id\": \"create-promote-14\",\n      \"name\": \"Create promote/v branch from release/v\",\n      \"type\": \"n8n-nodes-base.executeCommand\",\n      \"typeVersion\": 1,\n      \"position\": [\n        1200,\n        280\n      ]\n    },\n    {\n      \"parameters\": {\n        \"url\": \"={{ $env.GITLAB_URL }}/api/v4/projects/{{ $json.body.project_id }}/pipelines\",\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"ref\",\n              \"value\": \"={{ 'promote/' + $json.body.version }}\"\n            },\n            {\n              \"name\": \"variables[STAGE]\",\n              \"value\": \"promote-build-deploy\"\n            }\n          ]\n        },\n        \"sendHeaders\": true,\n        \"headerParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"PRIVATE-TOKEN\",\n              \"value\": \"={{ $env.GITLAB_TOKEN }}\"\n            }\n          ]\n        }\n      },\n      \"id\": \"trigger-promote-ci-14\",\n      \"name\": \"Trigger promotion CI pipeline (4 stages)\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4,\n      \"position\": [\n        1440,\n        220\n      ]\n    }\n  ],\n  \"connections\": {\n    \"Webhook: /release-staging\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Safeguard: check all 3 UAT sign-offs on release ticket\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Safeguard: check all 3 UAT sign-offs on release ticket\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"All UAT sign-offs present?\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"All UAT sign-offs present?\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Safeguard gate\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Safeguard gate\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"RM creates release plan ticket (omp+glab)\",\n            \"type\": \"main\",\n            \"index\": 0\n          },\n          {\n            \"node\": \"Create promote/v branch from release/v\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ],\n        [\n          {\n            \"node\": \"Feedback to Edward: missing sign-offs\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"RM creates release plan ticket (omp+glab)\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Trigger promotion CI pipeline (4 stages)\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Create promote/v branch from release/v\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Trigger promotion CI pipeline (4 stages)\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    }\n  },\n  \"active\": true,\n  \"settings\": {\n    \"executionOrder\": \"v1\"\n  },\n  \"tags\": [\n    {\n      \"name\": \"staging\"\n    },\n    {\n      \"name\": \"phase-4\"\n    }\n  ]\n}","F-15-staging-deployed.json":"{\n  \"name\": \"F-15 Staging Deployed (CI Webhook)\",\n  \"nodes\": [\n    {\n      \"parameters\": {\n        \"httpMethod\": \"POST\",\n        \"path\": \"ci-staging-deployed\",\n        \"responseMode\": \"lastNode\",\n        \"options\": {}\n      },\n      \"id\": \"wh-15\",\n      \"name\": \"Webhook: CI staging deployed\",\n      \"type\": \"n8n-nodes-base.webhook\",\n      \"typeVersion\": 1,\n      \"position\": [\n        240,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"command\": \"glab issue comment {{ $json.body.release_ticket_id }} --message 'Staging deployed: {{ $json.body.version }} at {{ new Date().toISOString() }}'\"\n      },\n      \"id\": \"update-ticket-15\",\n      \"name\": \"Update release ticket: staging deployment log\",\n      \"type\": \"n8n-nodes-base.executeCommand\",\n      \"typeVersion\": 1,\n      \"position\": [\n        480,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/spawn-role\",\n        \"sendBody\": true,\n        \"specifyBody\": \"json\",\n        \"jsonBody\": \"={{ JSON.stringify({ role: 'qa-engineer', task: 'staging-performance', version: $json.body.version, project: $json.body.project }) }}\",\n        \"options\": {}\n      },\n      \"id\": \"spawn-qa-15\",\n      \"name\": \"Spawn QA Pod: k6 performance + stress tests\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4,\n      \"position\": [\n        720,\n        200\n      ]\n    },\n    {\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/spawn-role\",\n        \"sendBody\": true,\n        \"specifyBody\": \"json\",\n        \"jsonBody\": \"={{ JSON.stringify({ role: 'security-engineer', task: 'staging-zap-confirmation', version: $json.body.version, project: $json.body.project }) }}\",\n        \"options\": {}\n      },\n      \"id\": \"spawn-sec-15\",\n      \"name\": \"Spawn Security Pod: ZAP full scan confirmation\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4,\n      \"position\": [\n        720,\n        400\n      ]\n    },\n    {\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/spawn-role\",\n        \"sendBody\": true,\n        \"specifyBody\": \"json\",\n        \"jsonBody\": \"={{ JSON.stringify({ role: 'release-manager', task: 'go-nogo-assessment', version: $json.body.version, project: $json.body.project }) }}\",\n        \"options\": {}\n      },\n      \"id\": \"spawn-rm-15\",\n      \"name\": \"Spawn RM Pod: go/no-go assessment (F-16)\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4,\n      \"position\": [\n        960,\n        300\n      ]\n    }\n  ],\n  \"connections\": {\n    \"Webhook: CI staging deployed\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Update release ticket: staging deployment log\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Update release ticket: staging deployment log\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Spawn QA Pod: k6 performance + stress tests\",\n            \"type\": \"main\",\n            \"index\": 0\n          },\n          {\n            \"node\": \"Spawn Security Pod: ZAP full scan confirmation\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Spawn QA Pod: k6 performance + stress tests\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Spawn RM Pod: go/no-go assessment (F-16)\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Spawn Security Pod: ZAP full scan confirmation\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Spawn RM Pod: go/no-go assessment (F-16)\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    }\n  },\n  \"active\": true,\n  \"settings\": {\n    \"executionOrder\": \"v1\"\n  },\n  \"tags\": [\n    {\n      \"name\": \"staging\"\n    },\n    {\n      \"name\": \"phase-4\"\n    }\n  ]\n}\n","F-16-go-nogo.json":"{\n  \"name\": \"F-16 Release Manager Go/No-Go\",\n  \"nodes\": [\n    {\n      \"parameters\": {\n        \"httpMethod\": \"POST\",\n        \"path\": \"go-nogo-result\",\n        \"responseMode\": \"lastNode\",\n        \"options\": {}\n      },\n      \"id\": \"wh-16\",\n      \"name\": \"Webhook: RM go/no-go signal\",\n      \"type\": \"n8n-nodes-base.webhook\",\n      \"typeVersion\": 1,\n      \"position\": [\n        240,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"conditions\": {\n          \"conditions\": [\n            {\n              \"leftValue\": \"={{ $json.body.decision }}\",\n              \"rightValue\": \"go\",\n              \"operator\": {\n                \"type\": \"string\",\n                \"operation\": \"equals\"\n              }\n            }\n          ]\n        }\n      },\n      \"id\": \"go-check-16\",\n      \"name\": \"GO or NO-GO?\",\n      \"type\": \"n8n-nodes-base.if\",\n      \"typeVersion\": 2,\n      \"position\": [\n        480,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"command\": \"glab issue update {{ $json.body.release_ticket_id }} --label-add 'rm:go' \u0026\u0026 glab issue comment {{ $json.body.release_ticket_id }} --message 'rm:go applied by Release Manager. Staging validation passed. Ready for /release-production.'\"\n      },\n      \"id\": \"apply-rmgo-16\",\n      \"name\": \"Apply rm:go on release ticket\",\n      \"type\": \"n8n-nodes-base.executeCommand\",\n      \"typeVersion\": 1,\n      \"position\": [\n        720,\n        160\n      ]\n    },\n    {\n      \"parameters\": {\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/f16-notify-go\",\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"message\",\n              \"value\": \"Staging GO. Ready for /release-production.\"\n            },\n            {\n              \"name\": \"version\",\n              \"value\": \"={{ $json.body.version }}\"\n            }\n          ]\n        }\n      },\n      \"id\": \"notify-go-16\",\n      \"name\": \"Notify Edward: GO, ready for /release-production\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4,\n      \"position\": [\n        960,\n        160\n      ]\n    },\n    {\n      \"parameters\": {\n        \"command\": \"glab issue comment {{ $json.body.release_ticket_id }} --message 'NO-GO: {{ $json.body.reason }}\\n\\nValidation table:\\n{{ $json.body.validation_table }}\\n\\nSuggestions:\\nA) {{ $json.body.suggestion_a }}\\nB) {{ $json.body.suggestion_b }}\\nC) {{ $json.body.suggestion_c }}\\n\\nAwaiting your decision.'\"\n      },\n      \"id\": \"post-nogo-report-16\",\n      \"name\": \"Post no-go report: reason + suggestions A/B/C on release ticket\",\n      \"type\": \"n8n-nodes-base.executeCommand\",\n      \"typeVersion\": 1,\n      \"position\": [\n        720,\n        440\n      ]\n    },\n    {\n      \"parameters\": {\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/f16-notify-nogo\",\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"message\",\n              \"value\": \"Staging NO-GO. Review release ticket for details.\"\n            },\n            {\n              \"name\": \"version\",\n              \"value\": \"={{ $json.body.version }}\"\n            },\n            {\n              \"name\": \"reason\",\n              \"value\": \"={{ $json.body.reason }}\"\n            }\n          ]\n        }\n      },\n      \"id\": \"notify-nogo-16\",\n      \"name\": \"Notify Edward: NO-GO, awaiting decision\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4,\n      \"position\": [\n        960,\n        440\n      ]\n    }\n  ],\n  \"connections\": {\n    \"Webhook: RM go/no-go signal\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"GO or NO-GO?\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"GO or NO-GO?\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Apply rm:go on release ticket\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ],\n        [\n          {\n            \"node\": \"Post no-go report: reason + suggestions A/B/C on release ticket\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Apply rm:go on release ticket\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Notify Edward: GO, ready for /release-production\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Post no-go report: reason + suggestions A/B/C on release ticket\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Notify Edward: NO-GO, awaiting decision\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    }\n  },\n  \"active\": true,\n  \"settings\": {\n    \"executionOrder\": \"v1\"\n  },\n  \"tags\": [\n    {\n      \"name\": \"staging\"\n    },\n    {\n      \"name\": \"phase-4\"\n    }\n  ]\n}","F-17-release-production.json":"{\n  \"name\": \"F-17 /release-production\",\n  \"nodes\": [\n    {\n      \"parameters\": {\n        \"httpMethod\": \"POST\",\n        \"path\": \"release-production\",\n        \"responseMode\": \"lastNode\",\n        \"options\": {}\n      },\n      \"id\": \"wh-17\",\n      \"name\": \"Webhook: /release-production\",\n      \"type\": \"n8n-nodes-base.webhook\",\n      \"typeVersion\": 1,\n      \"position\": [\n        240,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"url\": \"={{ $env.GITLAB_URL }}/api/v4/projects/{{ $json.body.project_id }}/issues/{{ $json.body.release_ticket_id }}\",\n        \"sendHeaders\": true,\n        \"headerParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"PRIVATE-TOKEN\",\n              \"value\": \"={{ $env.GITLAB_TOKEN }}\"\n            }\n          ]\n        }\n      },\n      \"id\": \"check-rmgo-17\",\n      \"name\": \"Safeguard: check rm:go label on release ticket\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4,\n      \"position\": [\n        480,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"jsCode\": \"const labels = $json.labels || [];\\nconst hasGo = labels.includes('rm:go');\\nreturn [{ json: { safe: hasGo, labels } }];\"\n      },\n      \"id\": \"validate-rmgo-17\",\n      \"name\": \"rm:go confirmed?\",\n      \"type\": \"n8n-nodes-base.code\",\n      \"typeVersion\": 2,\n      \"position\": [\n        720,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"conditions\": {\n          \"conditions\": [\n            {\n              \"leftValue\": \"={{ $json.safe }}\",\n              \"rightValue\": true,\n              \"operator\": {\n                \"type\": \"boolean\",\n                \"operation\": \"equals\"\n              }\n            }\n          ]\n        }\n      },\n      \"id\": \"gate-17\",\n      \"name\": \"Staging GO confirmed?\",\n      \"type\": \"n8n-nodes-base.if\",\n      \"typeVersion\": 2,\n      \"position\": [\n        960,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/f17-feedback\",\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"message\",\n              \"value\": \"Production blocked: rm:go not found on release ticket. Run /release-staging first.\"\n            }\n          ]\n        }\n      },\n      \"id\": \"feedback-17\",\n      \"name\": \"Feedback to Edward: staging not GO\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4,\n      \"position\": [\n        1200,\n        440\n      ]\n    },\n    {\n      \"parameters\": {\n        \"url\": \"={{ $env.GITLAB_URL }}/api/v4/projects/{{ $json.body.project_id }}/merge_requests\",\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"source_branch\",\n              \"value\": \"={{ 'promote/' + $json.body.version }}\"\n            },\n            {\n              \"name\": \"target_branch\",\n              \"value\": \"main\"\n            },\n            {\n              \"name\": \"title\",\n              \"value\": \"={{ '[release] ' + $json.body.version }}\"\n            },\n            {\n              \"name\": \"labels\",\n              \"value\": \"type:release\"\n            },\n            {\n              \"name\": \"description\",\n              \"value\": \"Release MR for {{ $json.body.version }}. CI validates no rc versions remain and all images in registry.\"\n            }\n          ]\n        },\n        \"sendHeaders\": true,\n        \"headerParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"PRIVATE-TOKEN\",\n              \"value\": \"={{ $env.GITLAB_TOKEN }}\"\n            }\n          ]\n        }\n      },\n      \"id\": \"create-release-mr-17\",\n      \"name\": \"Create promote\\u2192main MR via GitLab API\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4,\n      \"position\": [\n        1200,\n        200\n      ]\n    },\n    {\n      \"parameters\": {\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/f17-notify\",\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"message\",\n              \"value\": \"Release MR created. Review, approve, and merge to deploy to production.\"\n            },\n            {\n              \"name\": \"mr_url\",\n              \"value\": \"={{ $json.web_url }}\"\n            }\n          ]\n        }\n      },\n      \"id\": \"notify-17\",\n      \"name\": \"Notify Edward: release MR ready for review\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4,\n      \"position\": [\n        1440,\n        200\n      ]\n    }\n  ],\n  \"connections\": {\n    \"Webhook: /release-production\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Safeguard: check rm:go label on release ticket\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Safeguard: check rm:go label on release ticket\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"rm:go confirmed?\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"rm:go confirmed?\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Staging GO confirmed?\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Staging GO confirmed?\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Create promote\\u2192main MR via GitLab API\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ],\n        [\n          {\n            \"node\": \"Feedback to Edward: staging not GO\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Create promote\\u2192main MR via GitLab API\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Notify Edward: release MR ready for review\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    }\n  },\n  \"active\": true,\n  \"settings\": {\n    \"executionOrder\": \"v1\"\n  },\n  \"tags\": [\n    {\n      \"name\": \"production\"\n    },\n    {\n      \"name\": \"phase-5\"\n    }\n  ]\n}","F-18-release-mr-merged.json":"{\n  \"name\": \"F-18 Release MR Merged\",\n  \"nodes\": [\n    {\n      \"parameters\": {\n        \"httpMethod\": \"POST\",\n        \"path\": \"release-mr-merged\",\n        \"responseMode\": \"lastNode\",\n        \"options\": {}\n      },\n      \"id\": \"wh-18\",\n      \"name\": \"Webhook: release MR merged by Edward\",\n      \"type\": \"n8n-nodes-base.webhook\",\n      \"typeVersion\": 1,\n      \"position\": [\n        240,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"command\": \"echo 'Post-merge CI fires on main: git diff, argocd sync production, health gate, git tag applied. No retry on failure.'\"\n      },\n      \"id\": \"wait-post-merge-ci-18\",\n      \"name\": \"Wait: post-merge CI deploys production + applies git tag\",\n      \"type\": \"n8n-nodes-base.executeCommand\",\n      \"typeVersion\": 1,\n      \"position\": [\n        480,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/ci-production-deployed\",\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"version\",\n              \"value\": \"={{ $json.body.version }}\"\n            },\n            {\n              \"name\": \"release_ticket_id\",\n              \"value\": \"={{ $json.body.release_ticket_id }}\"\n            },\n            {\n              \"name\": \"project_id\",\n              \"value\": \"={{ $json.body.project_id }}\"\n            }\n          ]\n        }\n      },\n      \"id\": \"trigger-f19-18\",\n      \"name\": \"CI notifies n8n: production deployed \\u2192 F-19\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4,\n      \"position\": [\n        720,\n        300\n      ]\n    }\n  ],\n  \"connections\": {\n    \"Webhook: release MR merged by Edward\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Wait: post-merge CI deploys production + applies git tag\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Wait: post-merge CI deploys production + applies git tag\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"CI notifies n8n: production deployed \\u2192 F-19\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    }\n  },\n  \"active\": true,\n  \"settings\": {\n    \"executionOrder\": \"v1\"\n  },\n  \"tags\": [\n    {\n      \"name\": \"production\"\n    },\n    {\n      \"name\": \"phase-5\"\n    }\n  ]\n}","F-19-production-deployed.json":"{\n  \"name\": \"F-19 Production Deployed (CI Webhook)\",\n  \"nodes\": [\n    {\n      \"parameters\": {\n        \"httpMethod\": \"POST\",\n        \"path\": \"ci-production-deployed\",\n        \"responseMode\": \"lastNode\",\n        \"options\": {}\n      },\n      \"id\": \"wh-19\",\n      \"name\": \"Webhook: CI production deployed\",\n      \"type\": \"n8n-nodes-base.webhook\",\n      \"typeVersion\": 1,\n      \"position\": [\n        240,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"command\": \"glab issue comment {{ $json.body.release_ticket_id }} --message 'Production deployed: {{ $json.body.version }} at {{ new Date().toISOString() }}'\"\n      },\n      \"id\": \"update-ticket-19\",\n      \"name\": \"Update release ticket: deployed + timestamp\",\n      \"type\": \"n8n-nodes-base.executeCommand\",\n      \"typeVersion\": 1,\n      \"position\": [\n        480,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/spawn-role\",\n        \"sendBody\": true,\n        \"specifyBody\": \"json\",\n        \"jsonBody\": \"={{ JSON.stringify({ role: 'qa-engineer', task: 'smoke-tests', version: $json.body.version, project: $json.body.project }) }}\",\n        \"options\": {}\n      },\n      \"id\": \"run-smoke-19\",\n      \"name\": \"Run smoke tests from QA smoke plan ticket\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4,\n      \"position\": [\n        720,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"conditions\": {\n          \"conditions\": [\n            {\n              \"leftValue\": \"={{ $json.exitCode }}\",\n              \"rightValue\": 0,\n              \"operator\": {\n                \"type\": \"number\",\n                \"operation\": \"equals\"\n              }\n            }\n          ]\n        }\n      },\n      \"id\": \"smoke-pass-19\",\n      \"name\": \"Smoke tests pass?\",\n      \"type\": \"n8n-nodes-base.if\",\n      \"typeVersion\": 2,\n      \"position\": [\n        960,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/f19-smoke-fail\",\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"message\",\n              \"value\": \"Smoke tests FAILED\"\n            },\n            {\n              \"name\": \"failed_test\",\n              \"value\": \"={{ $json.stdout }}\"\n            },\n            {\n              \"name\": \"version\",\n              \"value\": \"={{ $json.body.version }}\"\n            }\n          ]\n        }\n      },\n      \"id\": \"smoke-fail-notify-19\",\n      \"name\": \"Smoke fail: report + suggestion + escalate to Edward\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4,\n      \"position\": [\n        1200,\n        440\n      ]\n    },\n    {\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/spawn-role\",\n        \"sendBody\": true,\n        \"specifyBody\": \"json\",\n        \"jsonBody\": \"={{ JSON.stringify({ role: 'release-manager', task: 'production-monitoring', version: $json.body.version, project: $json.body.project }) }}\",\n        \"options\": {}\n      },\n      \"id\": \"spawn-rm-monitor-19\",\n      \"name\": \"Spawn RM Pod: production monitoring window (F-20)\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4,\n      \"position\": [\n        1200,\n        200\n      ]\n    },\n    {\n      \"parameters\": {\n        \"command\": \"glab release create {{ $json.body.version }} --title 'Release {{ $json.body.version }}' --notes 'See wiki for full release notes.' \u0026\u0026 echo 'Branch cleanup scheduled for 30 days.'\"\n      },\n      \"id\": \"release-artifacts-19\",\n      \"name\": \"n8n: create GitLab release object + schedule cleanup\",\n      \"type\": \"n8n-nodes-base.executeCommand\",\n      \"typeVersion\": 1,\n      \"position\": [\n        1200,\n        320\n      ]\n    }\n  ],\n  \"connections\": {\n    \"Webhook: CI production deployed\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Update release ticket: deployed + timestamp\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Update release ticket: deployed + timestamp\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Run smoke tests from QA smoke plan ticket\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Run smoke tests from QA smoke plan ticket\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Smoke tests pass?\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Smoke tests pass?\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Spawn RM Pod: production monitoring window (F-20)\",\n            \"type\": \"main\",\n            \"index\": 0\n          },\n          {\n            \"node\": \"n8n: create GitLab release object + schedule cleanup\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ],\n        [\n          {\n            \"node\": \"Smoke fail: report + suggestion + escalate to Edward\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    }\n  },\n  \"active\": true,\n  \"settings\": {\n    \"executionOrder\": \"v1\"\n  },\n  \"tags\": [\n    {\n      \"name\": \"production\"\n    },\n    {\n      \"name\": \"phase-5\"\n    }\n  ]\n}\n","F-20-monitoring-window.json":"{\n  \"name\": \"F-20 Monitoring Window Complete\",\n  \"nodes\": [\n    {\n      \"parameters\": {\n        \"httpMethod\": \"POST\",\n        \"path\": \"monitoring-complete\",\n        \"responseMode\": \"lastNode\",\n        \"options\": {}\n      },\n      \"id\": \"wh-20\",\n      \"name\": \"Webhook: RM monitoring window signal\",\n      \"type\": \"n8n-nodes-base.webhook\",\n      \"typeVersion\": 1,\n      \"position\": [\n        240,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"conditions\": {\n          \"conditions\": [\n            {\n              \"leftValue\": \"={{ $json.body.incident }}\",\n              \"rightValue\": true,\n              \"operator\": {\n                \"type\": \"boolean\",\n                \"operation\": \"equals\"\n              }\n            }\n          ]\n        }\n      },\n      \"id\": \"incident-check-20\",\n      \"name\": \"Incident detected?\",\n      \"type\": \"n8n-nodes-base.if\",\n      \"typeVersion\": 2,\n      \"position\": [\n        480,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/f20-incident\",\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"message\",\n              \"value\": \"PRODUCTION INCIDENT\"\n            },\n            {\n              \"name\": \"metric\",\n              \"value\": \"={{ $json.body.metric }}\"\n            },\n            {\n              \"name\": \"value\",\n              \"value\": \"={{ $json.body.value }}\"\n            },\n            {\n              \"name\": \"trend\",\n              \"value\": \"={{ $json.body.trend }}\"\n            },\n            {\n              \"name\": \"recommended_action\",\n              \"value\": \"={{ $json.body.recommended_action }}\"\n            },\n            {\n              \"name\": \"version\",\n              \"value\": \"={{ $json.body.version }}\"\n            }\n          ]\n        }\n      },\n      \"id\": \"escalate-incident-20\",\n      \"name\": \"RM creates incident report + escalates to Edward\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4,\n      \"position\": [\n        720,\n        160\n      ]\n    },\n    {\n      \"parameters\": {\n        \"command\": \"glab issue update {{ $json.body.release_ticket_id }} --label-add 'monitoring:passed' \u0026\u0026 glab issue comment {{ $json.body.release_ticket_id }} --message 'Monitoring window complete. No incidents. Release confirmed stable.'\"\n      },\n      \"id\": \"confirm-release-20\",\n      \"name\": \"Update release ticket: monitoring passed\",\n      \"type\": \"n8n-nodes-base.executeCommand\",\n      \"typeVersion\": 1,\n      \"position\": [\n        720,\n        400\n      ]\n    },\n    {\n      \"parameters\": {\n        \"command\": \"echo '{\\\"role\\\":\\\"pm\\\",\\\"task\\\":\\\"release-communication\\\",\\\"version\\\":\\\"{{ $json.body.version }}\\\"}' \u003e /tmp/pm-comms.json \u0026\u0026 omp -p \\\"$(cat /tmp/pm-comms.json)\\\"\"\n      },\n      \"id\": \"pm-comms-20\",\n      \"name\": \"Spawn PM Pod: write release communication\",\n      \"type\": \"n8n-nodes-base.executeCommand\",\n      \"typeVersion\": 1,\n      \"position\": [\n        960,\n        400\n      ]\n    },\n    {\n      \"parameters\": {\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/cluster-sleep\",\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"cluster\",\n              \"value\": \"staging\"\n            }\n          ]\n        }\n      },\n      \"id\": \"sleep-staging-20\",\n      \"name\": \"Sleep staging cluster (F-27)\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4,\n      \"position\": [\n        1200,\n        400\n      ]\n    },\n    {\n      \"parameters\": {\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/f20-notify-confirmed\",\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"message\",\n              \"value\": \"v{{ $json.body.version }} successfully shipped. Release confirmed.\"\n            },\n            {\n              \"name\": \"version\",\n              \"value\": \"={{ $json.body.version }}\"\n            }\n          ]\n        }\n      },\n      \"id\": \"notify-shipped-20\",\n      \"name\": \"Notify Edward: release confirmed\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4,\n      \"position\": [\n        1440,\n        400\n      ]\n    }\n  ],\n  \"connections\": {\n    \"Webhook: RM monitoring window signal\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Incident detected?\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Incident detected?\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"RM creates incident report + escalates to Edward\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ],\n        [\n          {\n            \"node\": \"Update release ticket: monitoring passed\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Update release ticket: monitoring passed\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Spawn PM Pod: write release communication\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Spawn PM Pod: write release communication\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Sleep staging cluster (F-27)\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Sleep staging cluster (F-27)\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Notify Edward: release confirmed\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    }\n  },\n  \"active\": true,\n  \"settings\": {\n    \"executionOrder\": \"v1\"\n  },\n  \"tags\": [\n    {\n      \"name\": \"production\"\n    },\n    {\n      \"name\": \"phase-5\"\n    }\n  ]\n}","F-21-rollback.json":"{\n  \"name\": \"F-21 /rollback (Production)\",\n  \"nodes\": [\n    {\n      \"parameters\": {\n        \"httpMethod\": \"POST\",\n        \"path\": \"rollback\",\n        \"responseMode\": \"lastNode\",\n        \"options\": {}\n      },\n      \"id\": \"wh-21\",\n      \"name\": \"Webhook: /rollback command\",\n      \"type\": \"n8n-nodes-base.webhook\",\n      \"typeVersion\": 1,\n      \"position\": [\n        240,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"command\": \"argocd app rollback {{ $json.body.project }}-production --server $ARGOCD_URL \u0026\u0026 echo 'Rollback initiated for {{ $json.body.project }} production'\"\n      },\n      \"id\": \"rollback-21\",\n      \"name\": \"ArgoCD rollback production to previous version\",\n      \"type\": \"n8n-nodes-base.executeCommand\",\n      \"typeVersion\": 1,\n      \"position\": [\n        480,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"command\": \"glab issue create --title '[incident] Production rollback {{ $json.body.version }}' --label 'type:incident' --description 'Production rollback executed. Version: {{ $json.body.version }}. Reason: {{ $json.body.reason }}. Time: {{ new Date().toISOString() }}'\"\n      },\n      \"id\": \"create-incident-21\",\n      \"name\": \"Create incident ticket on release ticket\",\n      \"type\": \"n8n-nodes-base.executeCommand\",\n      \"typeVersion\": 1,\n      \"position\": [\n        720,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/spawn-role\",\n        \"sendBody\": true,\n        \"specifyBody\": \"json\",\n        \"jsonBody\": \"={{ JSON.stringify({ role: 'release-manager', task: 'monitor-rollback', version: $json.body.version, project: $json.body.project }) }}\",\n        \"options\": {}\n      },\n      \"id\": \"rm-monitor-rollback-21\",\n      \"name\": \"RM Pod: monitor rollback health\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4,\n      \"position\": [\n        960,\n        300\n      ]\n    }\n  ],\n  \"connections\": {\n    \"Webhook: /rollback command\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"ArgoCD rollback production to previous version\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"ArgoCD rollback production to previous version\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Create incident ticket on release ticket\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Create incident ticket on release ticket\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"RM Pod: monitor rollback health\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    }\n  },\n  \"active\": true,\n  \"settings\": {\n    \"executionOrder\": \"v1\"\n  },\n  \"tags\": [\n    {\n      \"name\": \"production\"\n    },\n    {\n      \"name\": \"phase-5\"\n    }\n  ]\n}\n","F-22-rollback-story.json":"{\n  \"name\": \"F-22 /rollback-story\",\n  \"nodes\": [\n    {\n      \"parameters\": {\n        \"httpMethod\": \"POST\",\n        \"path\": \"rollback-story\",\n        \"responseMode\": \"lastNode\",\n        \"options\": {}\n      },\n      \"id\": \"wh-22\",\n      \"name\": \"Webhook: /rollback-story command\",\n      \"type\": \"n8n-nodes-base.webhook\",\n      \"typeVersion\": 1,\n      \"position\": [\n        240,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"url\": \"={{ $env.GITLAB_URL }}/api/v4/projects/{{ $json.body.project_id }}/issues/{{ $json.body.story_id }}\",\n        \"sendHeaders\": true,\n        \"headerParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"PRIVATE-TOKEN\",\n              \"value\": \"={{ $env.GITLAB_TOKEN }}\"\n            }\n          ]\n        }\n      },\n      \"id\": \"verify-merged-22\",\n      \"name\": \"Verify story is merged to release branch\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4,\n      \"position\": [\n        480,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"jsCode\": \"const labels = $json.labels || [];\\nconst isMerged = labels.includes('merged-to-release');\\nconst hasDependents = false; // TODO: check dependency graph in DAG state\\nreturn [{ json: { isMerged, hasDependents, storyId: $json.iid } }];\"\n      },\n      \"id\": \"check-deps-22\",\n      \"name\": \"Check dependency graph for cascade\",\n      \"type\": \"n8n-nodes-base.code\",\n      \"typeVersion\": 2,\n      \"position\": [\n        720,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"conditions\": {\n          \"conditions\": [\n            {\n              \"leftValue\": \"={{ $json.hasDependents }}\",\n              \"rightValue\": true,\n              \"operator\": {\n                \"type\": \"boolean\",\n                \"operation\": \"equals\"\n              }\n            }\n          ]\n        }\n      },\n      \"id\": \"dep-check-22\",\n      \"name\": \"Dependent stories?\",\n      \"type\": \"n8n-nodes-base.if\",\n      \"typeVersion\": 2,\n      \"position\": [\n        960,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/f22-cascade-warn\",\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"message\",\n              \"value\": \"Cascade warning: other stories depend on GL-{{ $json.body.story_id }}. Confirm scope.\"\n            },\n            {\n              \"name\": \"story_id\",\n              \"value\": \"={{ $json.body.story_id }}\"\n            }\n          ]\n        }\n      },\n      \"id\": \"cascade-warn-22\",\n      \"name\": \"Notify Edward: cascade warning, await confirmation\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4,\n      \"position\": [\n        1200,\n        160\n      ]\n    },\n    {\n      \"parameters\": {\n        \"url\": \"={{ $env.GITLAB_URL }}/api/v4/projects/{{ $json.body.project_id }}/merge_requests\",\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"source_branch\",\n              \"value\": \"={{ 'revert-GL-' + $json.body.story_id + '/' + $json.body.version }}\"\n            },\n            {\n              \"name\": \"target_branch\",\n              \"value\": \"={{ 'release/' + $json.body.version }}\"\n            },\n            {\n              \"name\": \"title\",\n              \"value\": \"={{ '[revert] GL-' + $json.body.story_id + ' from ' + $json.body.version }}\"\n            },\n            {\n              \"name\": \"description\",\n              \"value\": \"Reverts story GL-{{ $json.body.story_id }} from release {{ $json.body.version }}.\"\n            }\n          ]\n        },\n        \"sendHeaders\": true,\n        \"headerParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"PRIVATE-TOKEN\",\n              \"value\": \"={{ $env.GITLAB_TOKEN }}\"\n            }\n          ]\n        }\n      },\n      \"id\": \"create-revert-mr-22\",\n      \"name\": \"Create revert MR on release branch\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4,\n      \"position\": [\n        1200,\n        400\n      ]\n    },\n    {\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/spawn-role\",\n        \"sendBody\": true,\n        \"specifyBody\": \"json\",\n        \"jsonBody\": \"={{ JSON.stringify({ role: 'tech-lead', task: 'review-revert-mr', version: $json.body.version, project: $json.body.project }) }}\",\n        \"options\": {}\n      },\n      \"id\": \"tl-review-revert-22\",\n      \"name\": \"TL Pod: review revert MR\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4,\n      \"position\": [\n        1440,\n        400\n      ]\n    },\n    {\n      \"parameters\": {\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/f22-notify-revert-ready\",\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"message\",\n              \"value\": \"Revert MR ready for your review and merge\"\n            },\n            {\n              \"name\": \"story_id\",\n              \"value\": \"={{ $json.body.story_id }}\"\n            },\n            {\n              \"name\": \"mr_url\",\n              \"value\": \"={{ $json.web_url }}\"\n            }\n          ]\n        }\n      },\n      \"id\": \"notify-revert-22\",\n      \"name\": \"Notify Edward: revert MR ready → F-23\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4,\n      \"position\": [\n        1680,\n        400\n      ]\n    }\n  ],\n  \"connections\": {\n    \"Webhook: /rollback-story command\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Verify story is merged to release branch\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Verify story is merged to release branch\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Check dependency graph for cascade\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Check dependency graph for cascade\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Dependent stories?\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Dependent stories?\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Notify Edward: cascade warning, await confirmation\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ],\n        [\n          {\n            \"node\": \"Create revert MR on release branch\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Create revert MR on release branch\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"TL Pod: review revert MR\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"TL Pod: review revert MR\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Notify Edward: revert MR ready → F-23\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    }\n  },\n  \"active\": true,\n  \"settings\": {\n    \"executionOrder\": \"v1\"\n  },\n  \"tags\": [\n    {\n      \"name\": \"production\"\n    },\n    {\n      \"name\": \"phase-5\"\n    }\n  ]\n}\n","F-23-revert-mr-merged.json":"{\n  \"name\": \"F-23 Revert MR Merged\",\n  \"nodes\": [\n    {\n      \"parameters\": {\n        \"httpMethod\": \"POST\",\n        \"path\": \"revert-mr-merged\",\n        \"responseMode\": \"lastNode\",\n        \"options\": {}\n      },\n      \"id\": \"wh-23\",\n      \"name\": \"Webhook: revert MR merged\",\n      \"type\": \"n8n-nodes-base.webhook\",\n      \"typeVersion\": 1,\n      \"position\": [\n        240,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"command\": \"glab issue update {{ $json.body.story_id }} --label-add 'deferred:{{ $json.body.version }}' \u0026\u0026 glab issue comment {{ $json.body.story_id }} --message 'Deferred from {{ $json.body.version }}. Reason: {{ $json.body.reason }}. Story preserved for future release. Revert MR: {{ $json.body.revert_mr_url }}'\"\n      },\n      \"id\": \"update-story-23\",\n      \"name\": \"Story ticket: status Deferred + label + reason\",\n      \"type\": \"n8n-nodes-base.executeCommand\",\n      \"typeVersion\": 1,\n      \"position\": [\n        480,\n        200\n      ]\n    },\n    {\n      \"parameters\": {\n        \"command\": \"echo 'Update all child task tickets of GL-{{ $json.body.story_id }} with deferred label, keep open'\"\n      },\n      \"id\": \"update-tasks-23\",\n      \"name\": \"Child tasks: label deferred, stay open\",\n      \"type\": \"n8n-nodes-base.executeCommand\",\n      \"typeVersion\": 1,\n      \"position\": [\n        480,\n        340\n      ]\n    },\n    {\n      \"parameters\": {\n        \"command\": \"glab issue comment {{ $json.body.release_ticket_id }} --message 'GL-{{ $json.body.story_id }} deferred from {{ $json.body.version }}. Scope reduced. Remaining stories: {{ $json.body.remaining_stories }}'\"\n      },\n      \"id\": \"update-release-ticket-23\",\n      \"name\": \"Release ticket: remove story from scope\",\n      \"type\": \"n8n-nodes-base.executeCommand\",\n      \"typeVersion\": 1,\n      \"position\": [\n        480,\n        480\n      ]\n    },\n    {\n      \"parameters\": {\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/uat\",\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"version\",\n              \"value\": \"={{ $json.body.version }}\"\n            },\n            {\n              \"name\": \"project\",\n              \"value\": \"={{ $json.body.project }}\"\n            },\n            {\n              \"name\": \"note\",\n              \"value\": \"Re-triggered after story deferral\"\n            }\n          ]\n        }\n      },\n      \"id\": \"retrigger-uat-23\",\n      \"name\": \"Re-trigger /uat with reduced scope\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4,\n      \"position\": [\n        720,\n        340\n      ]\n    }\n  ],\n  \"connections\": {\n    \"Webhook: revert MR merged\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Story ticket: status Deferred + label + reason\",\n            \"type\": \"main\",\n            \"index\": 0\n          },\n          {\n            \"node\": \"Child tasks: label deferred, stay open\",\n            \"type\": \"main\",\n            \"index\": 0\n          },\n          {\n            \"node\": \"Release ticket: remove story from scope\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Story ticket: status Deferred + label + reason\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Re-trigger /uat with reduced scope\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Child tasks: label deferred, stay open\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Re-trigger /uat with reduced scope\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Release ticket: remove story from scope\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Re-trigger /uat with reduced scope\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    }\n  },\n  \"active\": true,\n  \"settings\": {\n    \"executionOrder\": \"v1\"\n  },\n  \"tags\": [\n    {\n      \"name\": \"production\"\n    },\n    {\n      \"name\": \"phase-5\"\n    }\n  ]\n}","F-24-retro.json":"{\n  \"name\": \"F-24 /retro\",\n  \"nodes\": [\n    {\n      \"parameters\": {\n        \"httpMethod\": \"POST\",\n        \"path\": \"retro\",\n        \"responseMode\": \"lastNode\",\n        \"options\": {}\n      },\n      \"id\": \"wh-24\",\n      \"name\": \"Webhook: /retro command\",\n      \"type\": \"n8n-nodes-base.webhook\",\n      \"typeVersion\": 1,\n      \"position\": [\n        240,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/spawn-role\",\n        \"sendBody\": true,\n        \"specifyBody\": \"json\",\n        \"jsonBody\": \"={{ JSON.stringify({ role: 'tech-lead', task: 'retro-code-quality', version: $json.body.version, project: $json.body.project }) }}\",\n        \"options\": {}\n      },\n      \"id\": \"spawn-tl-retro\",\n      \"name\": \"Spawn TL Pod: code quality metrics (smart model)\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4,\n      \"position\": [\n        480,\n        160\n      ]\n    },\n    {\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/spawn-role\",\n        \"sendBody\": true,\n        \"specifyBody\": \"json\",\n        \"jsonBody\": \"={{ JSON.stringify({ role: 'qa-engineer', task: 'retro-qa-metrics', version: $json.body.version, project: $json.body.project }) }}\",\n        \"options\": {}\n      },\n      \"id\": \"spawn-qa-retro\",\n      \"name\": \"Spawn QA Pod: test metrics\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4,\n      \"position\": [\n        480,\n        280\n      ]\n    },\n    {\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/spawn-role\",\n        \"sendBody\": true,\n        \"specifyBody\": \"json\",\n        \"jsonBody\": \"={{ JSON.stringify({ role: 'security-engineer', task: 'retro-security-metrics', version: $json.body.version, project: $json.body.project }) }}\",\n        \"options\": {}\n      },\n      \"id\": \"spawn-sec-retro\",\n      \"name\": \"Spawn Security Pod: security metrics\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4,\n      \"position\": [\n        480,\n        400\n      ]\n    },\n    {\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/spawn-role\",\n        \"sendBody\": true,\n        \"specifyBody\": \"json\",\n        \"jsonBody\": \"={{ JSON.stringify({ role: 'release-manager', task: 'retro-release-metrics', version: $json.body.version, project: $json.body.project }) }}\",\n        \"options\": {}\n      },\n      \"id\": \"spawn-rm-retro\",\n      \"name\": \"Spawn RM Pod: release metrics\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4,\n      \"position\": [\n        480,\n        520\n      ]\n    },\n    {\n      \"parameters\": {\n        \"command\": \"echo '{\\\"role\\\":\\\"pm\\\",\\\"task\\\":\\\"retro-synthesis\\\",\\\"version\\\":\\\"{{ $json.body.version }}\\\",\\\"tl_input\\\":\\\"{{ $node['Spawn TL Pod: code quality metrics (smart model)'].json.stdout }}\\\",\\\"qa_input\\\":\\\"{{ $node['Spawn QA Pod: test metrics'].json.stdout }}\\\",\\\"sec_input\\\":\\\"{{ $node['Spawn Security Pod: security metrics'].json.stdout }}\\\",\\\"rm_input\\\":\\\"{{ $node['Spawn RM Pod: release metrics'].json.stdout }}\\\"}' \u003e /tmp/r-pm.json \u0026\u0026 omp -p \\\"$(cat /tmp/r-pm.json)\\\"\"\n      },\n      \"id\": \"spawn-pm-retro\",\n      \"name\": \"Spawn PM Pod: synthesise 11-section retro report\",\n      \"type\": \"n8n-nodes-base.executeCommand\",\n      \"typeVersion\": 1,\n      \"position\": [\n        720,\n        340\n      ]\n    },\n    {\n      \"parameters\": {\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/f24-notify\",\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"message\",\n              \"value\": \"Retrospective complete. Report published to wiki.\"\n            },\n            {\n              \"name\": \"version\",\n              \"value\": \"={{ $json.body.version }}\"\n            }\n          ]\n        }\n      },\n      \"id\": \"notify-retro-24\",\n      \"name\": \"Notify Edward: retrospective complete\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4,\n      \"position\": [\n        960,\n        340\n      ]\n    }\n  ],\n  \"connections\": {\n    \"Webhook: /retro command\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Spawn TL Pod: code quality metrics (smart model)\",\n            \"type\": \"main\",\n            \"index\": 0\n          },\n          {\n            \"node\": \"Spawn QA Pod: test metrics\",\n            \"type\": \"main\",\n            \"index\": 0\n          },\n          {\n            \"node\": \"Spawn Security Pod: security metrics\",\n            \"type\": \"main\",\n            \"index\": 0\n          },\n          {\n            \"node\": \"Spawn RM Pod: release metrics\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Spawn TL Pod: code quality metrics (smart model)\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Spawn PM Pod: synthesise 11-section retro report\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Spawn QA Pod: test metrics\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Spawn PM Pod: synthesise 11-section retro report\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Spawn Security Pod: security metrics\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Spawn PM Pod: synthesise 11-section retro report\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Spawn RM Pod: release metrics\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Spawn PM Pod: synthesise 11-section retro report\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Spawn PM Pod: synthesise 11-section retro report\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Notify Edward: retrospective complete\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    }\n  },\n  \"active\": true,\n  \"settings\": {\n    \"executionOrder\": \"v1\"\n  },\n  \"tags\": [\n    {\n      \"name\": \"retro\"\n    },\n    {\n      \"name\": \"phase-6\"\n    }\n  ]\n}\n","F-25-escalate.json":"{\n  \"name\": \"F-25 /escalate (Cross-cutting)\",\n  \"nodes\": [\n    {\n      \"parameters\": {\n        \"httpMethod\": \"POST\",\n        \"path\": \"escalate\",\n        \"responseMode\": \"lastNode\",\n        \"options\": {}\n      },\n      \"id\": \"wh-25\",\n      \"name\": \"Webhook: /escalate trigger\",\n      \"type\": \"n8n-nodes-base.webhook\",\n      \"typeVersion\": 1,\n      \"position\": [\n        240,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"jsCode\": \"const dag = $workflow.staticData.dagState || {};\\ndag.pausedTasks = dag.pausedTasks || [];\\ndag.pausedTasks.push($json.body.context);\\n$workflow.staticData.dagState = dag;\\nreturn [{ json: { paused: true, context: $json.body.context, reason: $json.body.reason, attempts: $json.body.attempts } }];\"\n      },\n      \"id\": \"pause-dag-25\",\n      \"name\": \"Pause dependent DAG tasks\",\n      \"type\": \"n8n-nodes-base.code\",\n      \"typeVersion\": 2,\n      \"position\": [\n        480,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/f25-notify-edward\",\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"message\",\n              \"value\": \"ESCALATION: {{ $json.body.reason }}\"\n            },\n            {\n              \"name\": \"flow\",\n              \"value\": \"={{ $json.body.flow }}\"\n            },\n            {\n              \"name\": \"attempts\",\n              \"value\": \"={{ $json.body.attempts }}\"\n            },\n            {\n              \"name\": \"failures\",\n              \"value\": \"={{ $json.body.failures }}\"\n            },\n            {\n              \"name\": \"recommended_action\",\n              \"value\": \"={{ $json.body.recommended_action }}\"\n            },\n            {\n              \"name\": \"context\",\n              \"value\": \"={{ JSON.stringify($json.body.context) }}\"\n            }\n          ]\n        }\n      },\n      \"id\": \"notify-edward-25\",\n      \"name\": \"Notify Edward immediately with full context\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4,\n      \"position\": [\n        720,\n        300\n      ]\n    }\n  ],\n  \"connections\": {\n    \"Webhook: /escalate trigger\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Pause dependent DAG tasks\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Pause dependent DAG tasks\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Notify Edward immediately with full context\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    }\n  },\n  \"active\": true,\n  \"settings\": {\n    \"executionOrder\": \"v1\"\n  },\n  \"tags\": [\n    {\n      \"name\": \"cross-cutting\"\n    }\n  ]\n}","F-26-projects.json":"{\n  \"name\": \"F-26 /projects\",\n  \"nodes\": [\n    {\n      \"parameters\": {\n        \"httpMethod\": \"POST\",\n        \"path\": \"projects\",\n        \"responseMode\": \"lastNode\",\n        \"options\": {}\n      },\n      \"id\": \"wh-26\",\n      \"name\": \"Webhook: /projects query\",\n      \"type\": \"n8n-nodes-base.webhook\",\n      \"typeVersion\": 1,\n      \"position\": [\n        240,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"jsCode\": \"const dag = $workflow.staticData.dagState || {};\\nconst summary = {\\n  version: dag.version,\\n  project: dag.project,\\n  phase: dag.currentPhase || 'unknown',\\n  storiesTotal: dag.totalStories || 0,\\n  storiesMerged: (dag.mergedStories || []).length,\\n  storiesInProgress: Object.keys(dag.openMRs || {}).length,\\n  clusterStates: dag.clusterStates || {},\\n  lastActivity: dag.lastActivity || 'unknown',\\n  pausedTasks: dag.pausedTasks || []\\n};\\nreturn [{ json: summary }];\"\n      },\n      \"id\": \"read-dag-26\",\n      \"name\": \"Read n8n DAG state for all active projects\",\n      \"type\": \"n8n-nodes-base.code\",\n      \"typeVersion\": 2,\n      \"position\": [\n        480,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/f26-report\",\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"report\",\n              \"value\": \"={{ JSON.stringify($json) }}\"\n            },\n            {\n              \"name\": \"timestamp\",\n              \"value\": \"={{ new Date().toISOString() }}\"\n            }\n          ]\n        }\n      },\n      \"id\": \"return-report-26\",\n      \"name\": \"Return project status report\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4,\n      \"position\": [\n        720,\n        300\n      ]\n    }\n  ],\n  \"connections\": {\n    \"Webhook: /projects query\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Read n8n DAG state for all active projects\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Read n8n DAG state for all active projects\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Return project status report\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    }\n  },\n  \"active\": true,\n  \"settings\": {\n    \"executionOrder\": \"v1\"\n  },\n  \"tags\": [\n    {\n      \"name\": \"cross-cutting\"\n    }\n  ]\n}","F-27-cluster-lifecycle.json":"{\n  \"name\": \"F-27 Cluster Lifecycle Management\",\n  \"nodes\": [\n    {\n      \"parameters\": {\n        \"httpMethod\": \"POST\",\n        \"path\": \"cluster-wake\",\n        \"responseMode\": \"lastNode\",\n        \"options\": {}\n      },\n      \"id\": \"wh-wake-27\",\n      \"name\": \"Webhook: cluster wake\",\n      \"type\": \"n8n-nodes-base.webhook\",\n      \"typeVersion\": 1,\n      \"position\": [\n        240,\n        200\n      ]\n    },\n    {\n      \"parameters\": {\n        \"httpMethod\": \"POST\",\n        \"path\": \"cluster-sleep\",\n        \"responseMode\": \"lastNode\",\n        \"options\": {}\n      },\n      \"id\": \"wh-sleep-27\",\n      \"name\": \"Webhook: cluster sleep\",\n      \"type\": \"n8n-nodes-base.webhook\",\n      \"typeVersion\": 1,\n      \"position\": [\n        240,\n        420\n      ]\n    },\n    {\n      \"parameters\": {\n        \"conditions\": {\n          \"conditions\": [\n            {\n              \"leftValue\": \"={{ $json.body.cluster }}\",\n              \"rightValue\": \"sit\",\n              \"operator\": {\n                \"type\": \"string\",\n                \"operation\": \"notEquals\"\n              }\n            }\n          ]\n        }\n      },\n      \"id\": \"not-sit-wake-27\",\n      \"name\": \"Not SIT? (SIT always on)\",\n      \"type\": \"n8n-nodes-base.if\",\n      \"typeVersion\": 2,\n      \"position\": [\n        480,\n        200\n      ]\n    },\n    {\n      \"parameters\": {\n        \"command\": \"kubectl scale deployment --all --replicas=1 -n {{ $json.body.cluster }} \u0026\u0026 kubectl rollout status deployment --all -n {{ $json.body.cluster }} \u0026\u0026 echo 'Cluster {{ $json.body.cluster }} healthy'\"\n      },\n      \"id\": \"wake-cmd-27\",\n      \"name\": \"kubectl scale up: wake cluster\",\n      \"type\": \"n8n-nodes-base.executeCommand\",\n      \"typeVersion\": 1,\n      \"position\": [\n        720,\n        160\n      ]\n    },\n    {\n      \"parameters\": {\n        \"conditions\": {\n          \"conditions\": [\n            {\n              \"leftValue\": \"={{ $json.body.cluster }}\",\n              \"rightValue\": \"production\",\n              \"operator\": {\n                \"type\": \"string\",\n                \"operation\": \"notEquals\"\n              }\n            }\n          ]\n        }\n      },\n      \"id\": \"not-prod-sleep-27\",\n      \"name\": \"Not production? (production never sleeps)\",\n      \"type\": \"n8n-nodes-base.if\",\n      \"typeVersion\": 2,\n      \"position\": [\n        480,\n        420\n      ]\n    },\n    {\n      \"parameters\": {\n        \"command\": \"kubectl scale deployment --all --replicas=0 -n {{ $json.body.cluster }}-server \u0026\u0026 kubectl scale deployment --all --replicas=0 -n {{ $json.body.cluster }}-frontend \u0026\u0026 echo 'Cluster {{ $json.body.cluster }} sleeping. Infra namespace stays warm.'\"\n      },\n      \"id\": \"sleep-cmd-27\",\n      \"name\": \"kubectl scale down: sleep cluster (infra stays warm)\",\n      \"type\": \"n8n-nodes-base.executeCommand\",\n      \"typeVersion\": 1,\n      \"position\": [\n        720,\n        420\n      ]\n    },\n    {\n      \"parameters\": {\n        \"jsCode\": \"const dag = $workflow.staticData.dagState || {};\\ndag.clusterStates = dag.clusterStates || {};\\ndag.clusterStates[$json.body.cluster] = $json.body.cluster ? 'awake' : 'sleeping';\\n$workflow.staticData.dagState = dag;\\nreturn [{ json: { updated: true } }];\"\n      },\n      \"id\": \"update-cluster-state-27\",\n      \"name\": \"Update cluster state in DAG\",\n      \"type\": \"n8n-nodes-base.code\",\n      \"typeVersion\": 2,\n      \"position\": [\n        960,\n        300\n      ]\n    }\n  ],\n  \"connections\": {\n    \"Webhook: cluster wake\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Not SIT? (SIT always on)\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Not SIT? (SIT always on)\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"kubectl scale up: wake cluster\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"kubectl scale up: wake cluster\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Update cluster state in DAG\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Webhook: cluster sleep\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Not production? (production never sleeps)\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Not production? (production never sleeps)\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"kubectl scale down: sleep cluster (infra stays warm)\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"kubectl scale down: sleep cluster (infra stays warm)\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Update cluster state in DAG\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    }\n  },\n  \"active\": true,\n  \"settings\": {\n    \"executionOrder\": \"v1\"\n  },\n  \"tags\": [\n    {\n      \"name\": \"cross-cutting\"\n    }\n  ]\n}","F-28-spawn-agent.json":"{\n  \"name\": \"F-28 Spawn / Despawn Agent Pod\",\n  \"_comment\": \"Three ways in: /spawn-agent + /despawn-agent claim a generic slot from the omp-slot-N pool and clone a skillsRepo into it; /spawn-role + /despawn-role scale a pre-built per-role Deployment (omp-\u003crole\u003e, skill baked in via ConfigMap by the omp chart). Flows that need a specific role call /spawn-role.\",\n  \"nodes\": [\n    {\n      \"parameters\": {\n        \"httpMethod\": \"POST\",\n        \"path\": \"spawn-agent\",\n        \"responseMode\": \"lastNode\",\n        \"options\": {}\n      },\n      \"id\": \"wh-spawn\",\n      \"name\": \"Webhook: /spawn-agent\",\n      \"type\": \"n8n-nodes-base.webhook\",\n      \"typeVersion\": 1,\n      \"position\": [\n        240,\n        200\n      ]\n    },\n    {\n      \"parameters\": {\n        \"command\": \"cat /var/run/secrets/kubernetes.io/serviceaccount/token\"\n      },\n      \"id\": \"tok-spawn\",\n      \"name\": \"K8s Token\",\n      \"type\": \"n8n-nodes-base.executeCommand\",\n      \"typeVersion\": 1,\n      \"position\": [\n        460,\n        200\n      ]\n    },\n    {\n      \"parameters\": {\n        \"url\": \"https://kubernetes.default.svc/apis/apps/v1/namespaces/omp/deployments\",\n        \"sendQuery\": true,\n        \"queryParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"labelSelector\",\n              \"value\": \"omp.slot=free\"\n            }\n          ]\n        },\n        \"sendHeaders\": true,\n        \"headerParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"Authorization\",\n              \"value\": \"=Bearer {{ $node[\\\"K8s Token\\\"].json.stdout.trim() }}\"\n            }\n          ]\n        },\n        \"options\": {\n          \"allowUnauthorizedCerts\": true\n        }\n      },\n      \"id\": \"list-free\",\n      \"name\": \"List Free Slots\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4,\n      \"position\": [\n        680,\n        200\n      ]\n    },\n    {\n      \"parameters\": {\n        \"jsCode\": \"const body = $node['Webhook: /spawn-agent'].json.body || {};\\nconst name = String(body.name || '').toLowerCase().replace(/[^a-z0-9-]/g, '').slice(0, 40);\\nif (!name) throw new Error('body.name required (a-z0-9-)');\\nconst skillsRepo = body.skillsRepo || 'https://github.com/dietrichgebert/ponytail';\\nconst free = ($json.items || []).filter(d =\u003e (d.spec.replicas || 0) === 0);\\nif (!free.length) throw new Error('no free omp slot — raise slots.count or despawn one');\\nreturn [{ json: { slot: free[0].metadata.name, name, skillsRepo } }];\"\n      },\n      \"id\": \"pick-slot\",\n      \"name\": \"Pick Slot\",\n      \"type\": \"n8n-nodes-base.code\",\n      \"typeVersion\": 2,\n      \"position\": [\n        900,\n        200\n      ]\n    },\n    {\n      \"parameters\": {\n        \"method\": \"PATCH\",\n        \"url\": \"=https://kubernetes.default.svc/apis/apps/v1/namespaces/omp/deployments/{{ $json.slot }}\",\n        \"sendHeaders\": true,\n        \"headerParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"Authorization\",\n              \"value\": \"=Bearer {{ $node[\\\"K8s Token\\\"].json.stdout.trim() }}\"\n            },\n            {\n              \"name\": \"Content-Type\",\n              \"value\": \"application/strategic-merge-patch+json\"\n            }\n          ]\n        },\n        \"sendBody\": true,\n        \"specifyBody\": \"json\",\n        \"jsonBody\": \"={{ JSON.stringify({ metadata: { labels: { 'omp.slot': $json.name } }, spec: { replicas: 1, template: { spec: { initContainers: [ { name: 'fetch-skills', args: ['clone','--depth','1', $json.skillsRepo, '/skills-src'] } ] } } } }) }}\",\n        \"options\": {\n          \"allowUnauthorizedCerts\": true\n        }\n      },\n      \"id\": \"patch-up\",\n      \"name\": \"Claim + Scale Up\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4,\n      \"position\": [\n        1120,\n        200\n      ]\n    },\n    {\n      \"parameters\": {\n        \"jsCode\": \"return [{ json: { spawned: $node['Pick Slot'].json.name, slot: $node['Pick Slot'].json.slot, service: `http://${$node['Pick Slot'].json.slot}.omp.svc:4096`, skillsRepo: $node['Pick Slot'].json.skillsRepo } }];\"\n      },\n      \"id\": \"resp-spawn\",\n      \"name\": \"Result\",\n      \"type\": \"n8n-nodes-base.code\",\n      \"typeVersion\": 2,\n      \"position\": [\n        1340,\n        200\n      ]\n    },\n    {\n      \"parameters\": {\n        \"httpMethod\": \"POST\",\n        \"path\": \"despawn-agent\",\n        \"responseMode\": \"lastNode\",\n        \"options\": {}\n      },\n      \"id\": \"wh-despawn\",\n      \"name\": \"Webhook: /despawn-agent\",\n      \"type\": \"n8n-nodes-base.webhook\",\n      \"typeVersion\": 1,\n      \"position\": [\n        240,\n        460\n      ]\n    },\n    {\n      \"parameters\": {\n        \"command\": \"cat /var/run/secrets/kubernetes.io/serviceaccount/token\"\n      },\n      \"id\": \"tok-despawn\",\n      \"name\": \"K8s Token (despawn)\",\n      \"type\": \"n8n-nodes-base.executeCommand\",\n      \"typeVersion\": 1,\n      \"position\": [\n        460,\n        460\n      ]\n    },\n    {\n      \"parameters\": {\n        \"jsCode\": \"const body = $node['Webhook: /despawn-agent'].json.body || {};\\nconst name = String(body.name || body.slot || '').toLowerCase().replace(/[^a-z0-9-]/g, '');\\nif (!name) throw new Error('body.name or body.slot required');\\nreturn [{ json: { name } }];\"\n      },\n      \"id\": \"despawn-arg\",\n      \"name\": \"Despawn Arg\",\n      \"type\": \"n8n-nodes-base.code\",\n      \"typeVersion\": 2,\n      \"position\": [\n        680,\n        460\n      ]\n    },\n    {\n      \"parameters\": {\n        \"url\": \"https://kubernetes.default.svc/apis/apps/v1/namespaces/omp/deployments\",\n        \"sendQuery\": true,\n        \"queryParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"labelSelector\",\n              \"value\": \"=omp.slot={{ $json.name }}\"\n            }\n          ]\n        },\n        \"sendHeaders\": true,\n        \"headerParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"Authorization\",\n              \"value\": \"=Bearer {{ $node[\\\"K8s Token (despawn)\\\"].json.stdout.trim() }}\"\n            }\n          ]\n        },\n        \"options\": {\n          \"allowUnauthorizedCerts\": true\n        }\n      },\n      \"id\": \"find-claimed\",\n      \"name\": \"Find Claimed Slot\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4,\n      \"position\": [\n        900,\n        460\n      ]\n    },\n    {\n      \"parameters\": {\n        \"jsCode\": \"const items = $json.items || [];\\nif (!items.length) throw new Error('no slot labelled omp.slot=' + $node['Despawn Arg'].json.name);\\nreturn [{ json: { slot: items[0].metadata.name } }];\"\n      },\n      \"id\": \"despawn-pick\",\n      \"name\": \"Resolve Slot\",\n      \"type\": \"n8n-nodes-base.code\",\n      \"typeVersion\": 2,\n      \"position\": [\n        1120,\n        460\n      ]\n    },\n    {\n      \"parameters\": {\n        \"method\": \"PATCH\",\n        \"url\": \"=https://kubernetes.default.svc/apis/apps/v1/namespaces/omp/deployments/{{ $json.slot }}\",\n        \"sendHeaders\": true,\n        \"headerParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"Authorization\",\n              \"value\": \"=Bearer {{ $node[\\\"K8s Token (despawn)\\\"].json.stdout.trim() }}\"\n            },\n            {\n              \"name\": \"Content-Type\",\n              \"value\": \"application/strategic-merge-patch+json\"\n            }\n          ]\n        },\n        \"sendBody\": true,\n        \"specifyBody\": \"json\",\n        \"jsonBody\": \"={{ JSON.stringify({ metadata: { labels: { 'omp.slot': 'free' } }, spec: { replicas: 0 } }) }}\",\n        \"options\": {\n          \"allowUnauthorizedCerts\": true\n        }\n      },\n      \"id\": \"patch-down\",\n      \"name\": \"Release + Scale Down\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4,\n      \"position\": [\n        1340,\n        460\n      ]\n    },\n    {\n      \"parameters\": {\n        \"httpMethod\": \"POST\",\n        \"path\": \"spawn-role\",\n        \"responseMode\": \"lastNode\",\n        \"options\": {}\n      },\n      \"id\": \"wh-spawn-role\",\n      \"name\": \"Webhook: /spawn-role\",\n      \"type\": \"n8n-nodes-base.webhook\",\n      \"typeVersion\": 1,\n      \"position\": [\n        240,\n        720\n      ]\n    },\n    {\n      \"parameters\": {\n        \"command\": \"cat /var/run/secrets/kubernetes.io/serviceaccount/token\"\n      },\n      \"id\": \"tok-spawn-role\",\n      \"name\": \"K8s Token (role)\",\n      \"type\": \"n8n-nodes-base.executeCommand\",\n      \"typeVersion\": 1,\n      \"position\": [\n        460,\n        720\n      ]\n    },\n    {\n      \"parameters\": {\n        \"jsCode\": \"// ponytail: allowlist mirrors helm/omp/values.yaml `roles:` — n8n\\n// can't read the chart. Keep in sync, or a typo'd role scales nothing.\\nconst ROLES = ['backend-developer','data-engineer','devops-engineer','frontend-developer','product-owner','project-manager','qa-engineer','release-manager','security-engineer','solution-architect','tech-lead','uiux-designer'];\\nconst body = $node['Webhook: /spawn-role'].json.body || {};\\nconst role = String(body.role || '').toLowerCase().replace(/[^a-z0-9-]/g, '');\\nif (!ROLES.includes(role)) throw new Error(`body.role must be one of: ${ROLES.join(', ')}`);\\nreturn [{ json: { role, deployment: `omp-${role}`, service: `http://omp-${role}.omp.svc:4096` } }];\"\n      },\n      \"id\": \"validate-role\",\n      \"name\": \"Validate Role\",\n      \"type\": \"n8n-nodes-base.code\",\n      \"typeVersion\": 2,\n      \"position\": [\n        680,\n        720\n      ]\n    },\n    {\n      \"parameters\": {\n        \"method\": \"PATCH\",\n        \"url\": \"=https://kubernetes.default.svc/apis/apps/v1/namespaces/omp/deployments/{{ $json.deployment }}/scale\",\n        \"sendHeaders\": true,\n        \"headerParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"Authorization\",\n              \"value\": \"=Bearer {{ $node[\\\"K8s Token (role)\\\"].json.stdout.trim() }}\"\n            },\n            {\n              \"name\": \"Content-Type\",\n              \"value\": \"application/merge-patch+json\"\n            }\n          ]\n        },\n        \"sendBody\": true,\n        \"specifyBody\": \"json\",\n        \"jsonBody\": \"={{ JSON.stringify({ spec: { replicas: 1 } }) }}\",\n        \"options\": {\n          \"allowUnauthorizedCerts\": true\n        }\n      },\n      \"id\": \"scale-up-role\",\n      \"name\": \"Scale Up Role\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4,\n      \"position\": [\n        900,\n        720\n      ]\n    },\n    {\n      \"parameters\": {\n        \"jsCode\": \"// ponytail: exitCode:0 keeps the omp-era `$json.exitCode === 0` gate\\n// checks working. Scales the pod up — does NOT run the task inside it yet.\\n// service = direct Service DNS; litellm = same pod via the LiteLLM\\n// pass-through route (central auth + request logging).\\nconst v = $node['Validate Role'].json;\\nreturn [{ json: {\\n  spawned: v.role,\\n  deployment: v.deployment,\\n  service: v.service,\\n  litellm: 'http://litellm.litellm.svc.cluster.local:4000/omp-' + v.role,\\n  replicas: 1,\\n  exitCode: 0\\n} }];\"\n      },\n      \"id\": \"resp-spawn-role\",\n      \"name\": \"Role Result\",\n      \"type\": \"n8n-nodes-base.code\",\n      \"typeVersion\": 2,\n      \"position\": [\n        1120,\n        720\n      ]\n    },\n    {\n      \"parameters\": {\n        \"httpMethod\": \"POST\",\n        \"path\": \"despawn-role\",\n        \"responseMode\": \"lastNode\",\n        \"options\": {}\n      },\n      \"id\": \"wh-despawn-role\",\n      \"name\": \"Webhook: /despawn-role\",\n      \"type\": \"n8n-nodes-base.webhook\",\n      \"typeVersion\": 1,\n      \"position\": [\n        240,\n        960\n      ]\n    },\n    {\n      \"parameters\": {\n        \"command\": \"cat /var/run/secrets/kubernetes.io/serviceaccount/token\"\n      },\n      \"id\": \"tok-despawn-role\",\n      \"name\": \"K8s Token (role despawn)\",\n      \"type\": \"n8n-nodes-base.executeCommand\",\n      \"typeVersion\": 1,\n      \"position\": [\n        460,\n        960\n      ]\n    },\n    {\n      \"parameters\": {\n        \"jsCode\": \"const ROLES = ['backend-developer','data-engineer','devops-engineer','frontend-developer','product-owner','project-manager','qa-engineer','release-manager','security-engineer','solution-architect','tech-lead','uiux-designer'];\\nconst body = $node['Webhook: /despawn-role'].json.body || {};\\nconst role = String(body.role || '').toLowerCase().replace(/[^a-z0-9-]/g, '');\\nif (!ROLES.includes(role)) throw new Error(`body.role must be one of: ${ROLES.join(', ')}`);\\nreturn [{ json: { role, deployment: `omp-${role}` } }];\"\n      },\n      \"id\": \"validate-role-d\",\n      \"name\": \"Validate Role (despawn)\",\n      \"type\": \"n8n-nodes-base.code\",\n      \"typeVersion\": 2,\n      \"position\": [\n        680,\n        960\n      ]\n    },\n    {\n      \"parameters\": {\n        \"method\": \"PATCH\",\n        \"url\": \"=https://kubernetes.default.svc/apis/apps/v1/namespaces/omp/deployments/{{ $json.deployment }}/scale\",\n        \"sendHeaders\": true,\n        \"headerParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"Authorization\",\n              \"value\": \"=Bearer {{ $node[\\\"K8s Token (role despawn)\\\"].json.stdout.trim() }}\"\n            },\n            {\n              \"name\": \"Content-Type\",\n              \"value\": \"application/merge-patch+json\"\n            }\n          ]\n        },\n        \"sendBody\": true,\n        \"specifyBody\": \"json\",\n        \"jsonBody\": \"={{ JSON.stringify({ spec: { replicas: 0 } }) }}\",\n        \"options\": {\n          \"allowUnauthorizedCerts\": true\n        }\n      },\n      \"id\": \"scale-down-role\",\n      \"name\": \"Scale Down Role\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4,\n      \"position\": [\n        900,\n        960\n      ]\n    }\n  ],\n  \"connections\": {\n    \"Webhook: /spawn-agent\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"K8s Token\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"K8s Token\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"List Free Slots\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"List Free Slots\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Pick Slot\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Pick Slot\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Claim + Scale Up\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Claim + Scale Up\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Result\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Webhook: /despawn-agent\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"K8s Token (despawn)\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"K8s Token (despawn)\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Despawn Arg\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Despawn Arg\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Find Claimed Slot\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Find Claimed Slot\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Resolve Slot\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Resolve Slot\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Release + Scale Down\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Webhook: /spawn-role\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"K8s Token (role)\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"K8s Token (role)\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Validate Role\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Validate Role\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Scale Up Role\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Scale Up Role\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Role Result\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Webhook: /despawn-role\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"K8s Token (role despawn)\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"K8s Token (role despawn)\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Validate Role (despawn)\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Validate Role (despawn)\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Scale Down Role\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    }\n  },\n  \"settings\": {}\n}\n","F-30-openwebui-trigger.json":"{\n  \"name\": \"F-30 Open WebUI Trigger\",\n  \"_comment\": \"Called by the Open WebUI 'n8n Trigger' pipe (helm/openwebui/functions/n8n_pipe.py). A prompt starting with '/\u003cflow\u003e' fans out to that flow's webhook via N8N_WEBHOOK_BASE; anything else returns a help string. responseMode=lastNode so the pipe reads the reply from {response}.\",\n  \"nodes\": [\n    {\n      \"parameters\": {\n        \"httpMethod\": \"POST\",\n        \"path\": \"openwebui-trigger\",\n        \"responseMode\": \"lastNode\",\n        \"options\": {}\n      },\n      \"id\": \"wh-30\",\n      \"name\": \"Webhook: /openwebui-trigger\",\n      \"type\": \"n8n-nodes-base.webhook\",\n      \"typeVersion\": 1,\n      \"position\": [240, 300]\n    },\n    {\n      \"parameters\": {\n        \"jsCode\": \"const b = $json.body || {};\\nconst p = String(b.prompt || '').trim();\\nconst m = p.match(/^\\\\/([a-z0-9-]+)\\\\s*([\\\\s\\\\S]*)$/i);\\nreturn [{ json: {\\n  prompt: p,\\n  user: b.user || '',\\n  command: m ? m[1].toLowerCase() : '',\\n  args: m ? m[2].trim() : '',\\n  hasCommand: !!m\\n} }];\"\n      },\n      \"id\": \"parse-30\",\n      \"name\": \"Parse command\",\n      \"type\": \"n8n-nodes-base.code\",\n      \"typeVersion\": 2,\n      \"position\": [460, 300]\n    },\n    {\n      \"parameters\": {\n        \"conditions\": {\n          \"options\": { \"caseSensitive\": true },\n          \"conditions\": [\n            {\n              \"leftValue\": \"={{ $json.command }}\",\n              \"rightValue\": \"\",\n              \"operator\": { \"type\": \"string\", \"operation\": \"notEmpty\", \"singleValue\": true }\n            }\n          ]\n        }\n      },\n      \"id\": \"if-30\",\n      \"name\": \"Has command?\",\n      \"type\": \"n8n-nodes-base.if\",\n      \"typeVersion\": 2,\n      \"position\": [680, 300]\n    },\n    {\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/{{ $json.command }}\",\n        \"sendBody\": true,\n        \"specifyBody\": \"json\",\n        \"jsonBody\": \"={{ JSON.stringify({ source: 'openwebui', user: $json.user, raw: $json.args }) }}\",\n        \"options\": { \"allowUnauthorizedCerts\": true, \"response\": { \"response\": { \"neverError\": true } } }\n      },\n      \"id\": \"fanout-30\",\n      \"name\": \"Trigger flow\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4,\n      \"position\": [900, 200],\n      \"onError\": \"continueRegularOutput\"\n    },\n    {\n      \"parameters\": {\n        \"jsCode\": \"const cmd = $node['Parse command'].json.command;\\nlet out = $json;\\nif (out \u0026\u0026 typeof out === 'object' \u0026\u0026 'body' in out) out = out.body;\\nconst detail = typeof out === 'object' ? JSON.stringify(out, null, 2) : String(out || '');\\nreturn [{ json: { response: `Triggered \\\\`/${cmd}\\\\`.\\\\n\\\\n${detail}`.trim() } }];\"\n      },\n      \"id\": \"reply-ok-30\",\n      \"name\": \"Reply (triggered)\",\n      \"type\": \"n8n-nodes-base.code\",\n      \"typeVersion\": 2,\n      \"position\": [1120, 200]\n    },\n    {\n      \"parameters\": {\n        \"jsCode\": \"return [{ json: { response: 'No command recognised. Start your message with a slash command, e.g.\\\\n\\\\n  /plan-release 1.4.0\\\\n  /kickoff my-project\\\\n  /develop 1.4.0\\\\n  /uat 1.4.0\\\\n\\\\nOne command maps to one F-* flow webhook.' } }];\"\n      },\n      \"id\": \"reply-help-30\",\n      \"name\": \"Reply (help)\",\n      \"type\": \"n8n-nodes-base.code\",\n      \"typeVersion\": 2,\n      \"position\": [900, 420]\n    }\n  ],\n  \"connections\": {\n    \"Webhook: /openwebui-trigger\": { \"main\": [[{ \"node\": \"Parse command\", \"type\": \"main\", \"index\": 0 }]] },\n    \"Parse command\": { \"main\": [[{ \"node\": \"Has command?\", \"type\": \"main\", \"index\": 0 }]] },\n    \"Has command?\": {\n      \"main\": [\n        [{ \"node\": \"Trigger flow\", \"type\": \"main\", \"index\": 0 }],\n        [{ \"node\": \"Reply (help)\", \"type\": \"main\", \"index\": 0 }]\n      ]\n    },\n    \"Trigger flow\": { \"main\": [[{ \"node\": \"Reply (triggered)\", \"type\": \"main\", \"index\": 0 }]] }\n  },\n  \"settings\": { \"executionOrder\": \"v1\" }\n}\n","seed.sh":"#!/usr/bin/env bash\n# seed.sh — upserts the SDLC n8n flows via the n8n public REST API.\n#\n# Invoked by the ansible runner (helm/ansible/playbooks/n8n.yml), and by hand:\n#\n#   N8N_URL=http://localhost:5678 N8N_API_KEY=\u003ckey\u003e ./seed.sh\n#\n# Needs: curl, jq. Idempotent — matches each flow by name, PUTs if it already\n# exists, POSTs if not, then activates. Re-run any time to push edits.\n# No API key -\u003e logs and exits 0, so a fresh cluster without the key set still\n# deploys cleanly.\n\nset -euo pipefail\n\nN8N_URL=\"${N8N_URL:-http://localhost:5678}\"\nN8N_API_KEY=\"${N8N_API_KEY:-}\"\nFLOW_DIR=\"${FLOW_DIR:-$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" \u0026\u0026 pwd)}\"\n\necho \"n8n flow seeder -\u003e $N8N_URL (flows: $FLOW_DIR)\"\n\nif [ -z \"$N8N_API_KEY\" ]; then\n  echo \"N8N_API_KEY is empty — skipping flow seeding.\"\n  echo \"Set TF_VAR_n8n_api_key in .env (create the key in n8n Settings -\u003e API Keys) and redeploy.\"\n  exit 0\nfi\n\napi() { curl -sf -H \"X-N8N-API-KEY: $N8N_API_KEY\" \"$@\"; }\n\necho \"Waiting for n8n...\"\nfor i in $(seq 1 30); do\n  if curl -sf \"$N8N_URL/healthz\" \u003e/dev/null 2\u003e\u00261; then echo \"  ready\"; break; fi\n  echo \"  attempt $i/30...\"; sleep 5\ndone\n\n# Fail loud on a bad key — otherwise `set -e` kills the script mid-pipe and the\n# Job just says \"backoff limit reached\" with no reason.\nprobe=$(curl -s -o /dev/null -w '%{http_code}' \\\n  -H \"X-N8N-API-KEY: $N8N_API_KEY\" \"$N8N_URL/api/v1/workflows?limit=1\")\nif [ \"$probe\" = 401 ] || [ \"$probe\" = 403 ]; then\n  echo \"ERROR: n8n rejected the API key (HTTP $probe).\"\n  echo \"The key in TF_VAR_n8n_api_key is gone or invalid (n8n data reset, or key deleted).\"\n  echo \"Create a fresh one in n8n Settings -\u003e API Keys, update .env, redeploy.\"\n  exit 1\nfi\n[ \"$probe\" = 200 ] || { echo \"ERROR: GET /api/v1/workflows -\u003e HTTP $probe\"; exit 1; }\n\n# name -\u003e id map of what's already there (paginate; API caps limit at 250)\necho \"Fetching existing workflows...\"\nEXISTING=$(mktemp)\ncursor=\"\"\n: \u003e \"$EXISTING\"\nwhile :; do\n  page=$(api \"$N8N_URL/api/v1/workflows?limit=250${cursor:+\u0026cursor=$cursor}\")\n  echo \"$page\" | jq -r '.data[] | [.name, .id] | @tsv' \u003e\u003e \"$EXISTING\"\n  cursor=$(echo \"$page\" | jq -r '.nextCursor // empty')\n  [ -z \"$cursor\" ] \u0026\u0026 break\ndone\necho \"  $(wc -l \u003c \"$EXISTING\") present\"\n\nid_for() { awk -F'\\t' -v n=\"$1\" '$1==n{print $2; exit}' \"$EXISTING\"; }\n\nCREATED=0; UPDATED=0; FAILED=0\nfor flow_path in \"$FLOW_DIR\"/F-*.json; do\n  [ -f \"$flow_path\" ] || continue\n  name=$(jq -r '.name // \"unknown\"' \"$flow_path\")\n  # public API rejects unknown top-level props (id, active, tags, pinData, ...)\n  body=$(jq '{name, nodes, connections, settings: (.settings // {})}' \"$flow_path\")\n  id=$(id_for \"$name\")\n\n  resp=$(mktemp)\n  if [ -n \"$id\" ]; then\n    printf '  update %s ... ' \"$name\"\n    code=$(curl -s -o \"$resp\" -w '%{http_code}' \\\n      -X PUT \"$N8N_URL/api/v1/workflows/$id\" \\\n      -H \"X-N8N-API-KEY: $N8N_API_KEY\" -H 'Content-Type: application/json' \\\n      --data-binary \"$body\")\n    ok_codes=\"200\"\n    verb=UPDATED\n  else\n    printf '  create %s ... ' \"$name\"\n    code=$(curl -s -o \"$resp\" -w '%{http_code}' \\\n      -X POST \"$N8N_URL/api/v1/workflows\" \\\n      -H \"X-N8N-API-KEY: $N8N_API_KEY\" -H 'Content-Type: application/json' \\\n      --data-binary \"$body\")\n    ok_codes=\"200 201\"\n    verb=CREATED\n  fi\n\n  if echo \"$ok_codes\" | grep -qw \"$code\"; then\n    id=$(jq -r '.id // empty' \"$resp\")\n    echo \"OK (id: ${id:-$id})\"\n    [ \"$verb\" = CREATED ] \u0026\u0026 CREATED=$((CREATED+1)) || UPDATED=$((UPDATED+1))\n    if [ -n \"$id\" ]; then\n      api -X POST \"$N8N_URL/api/v1/workflows/$id/activate\" \u003e/dev/null 2\u003e\u00261 \\\n        \u0026\u0026 echo \"    active\" || echo \"    activation failed — activate manually in the UI\"\n    fi\n  else\n    echo \"FAILED (HTTP $code)\"\n    jq . \"$resp\" 2\u003e/dev/null || cat \"$resp\"\n    FAILED=$((FAILED + 1))\n  fi\n  rm -f \"$resp\"\ndone\n\nrm -f \"$EXISTING\"\necho \"Done: $CREATED created, $UPDATED updated, $FAILED failed.\"\n[ \"$FAILED\" -eq 0 ]\n"},"id":"ansible/ansible-n8n-flows","immutable":false,"metadata":[{"annotations":{},"generate_name":"","generation":0,"labels":{},"name":"ansible-n8n-flows","namespace":"ansible","resource_version":"50204","uid":"e0da503a-043b-4bea-a079-c0a30a3e887c"}]},"sensitive_attributes":[],"private":"bnVsbA==","dependencies":["kubernetes_namespace.ansible"],"identity":{"api_version":"v1","kind":"ConfigMap","name":"ansible-n8n-flows","namespace":"ansible"},"identity_schema_version":1}]},{"mode":"managed","type":"kubernetes_config_map","name":"n8n_oidc_hooks","provider":"provider[\"registry.opentofu.org/hashicorp/kubernetes\"]","instances":[{"schema_version":0,"attributes":{"binary_data":{},"data":{"hooks.js":"/**\r\n * n8n External Hooks for OIDC Authentication\r\n *\r\n * This file implements OIDC authentication support for n8n using only built-in Node.js modules.\r\n * It provides:\r\n * - OIDC discovery endpoint support\r\n * - Authorization code flow\r\n * - User provisioning (JIT - Just In Time)\r\n * - Frontend customization to show OIDC login button\r\n *\r\n * Environment Variables Required:\r\n * - OIDC_ISSUER_URL: The OIDC provider's issuer URL (e.g., https://auth.example.com)\r\n * - OIDC_CLIENT_ID: OAuth2 client ID\r\n * - OIDC_CLIENT_SECRET: OAuth2 client secret\r\n * - OIDC_REDIRECT_URI: The callback URL (e.g., https://n8n.example.com/auth/oidc/callback)\r\n *\r\n * Optional:\r\n * - OIDC_SCOPES: Space-separated list of scopes (default: \"openid email profile\")\r\n */\r\n\r\nconst https = require('https');\r\nconst http = require('http');\r\nconst crypto = require('crypto');\r\nconst { URL, URLSearchParams } = require('url');\r\n\r\n// Configuration from environment\r\nconst config = {\r\n  issuerUrl: process.env.OIDC_ISSUER_URL,\r\n  clientId: process.env.OIDC_CLIENT_ID,\r\n  clientSecret: process.env.OIDC_CLIENT_SECRET,\r\n  redirectUri: process.env.OIDC_REDIRECT_URI,\r\n  scopes: process.env.OIDC_SCOPES || 'openid email profile',\r\n};\r\n\r\n// Validate configuration\r\nfunction validateConfig() {\r\n  const missing = [];\r\n  if (!config.issuerUrl) missing.push('OIDC_ISSUER_URL');\r\n  if (!config.clientId) missing.push('OIDC_CLIENT_ID');\r\n  if (!config.clientSecret) missing.push('OIDC_CLIENT_SECRET');\r\n  if (!config.redirectUri) missing.push('OIDC_REDIRECT_URI');\r\n  return missing;\r\n}\r\n\r\n// Cache for OIDC discovery document\r\nlet discoveryCache = null;\r\nlet discoveryCacheTime = 0;\r\nconst DISCOVERY_CACHE_TTL = 3600000; // 1 hour\r\n\r\n/**\r\n * Make an HTTP/HTTPS request\r\n * @param {string} url - The URL to request\r\n * @param {object} options - Request options\r\n * @returns {Promise\u003c{statusCode: number, headers: object, body: string}\u003e}\r\n */\r\nfunction makeRequest(url, options = {}) {\r\n  return new Promise((resolve, reject) =\u003e {\r\n    const parsedUrl = new URL(url);\r\n    const protocol = parsedUrl.protocol === 'https:' ? https : http;\r\n\r\n    const reqOptions = {\r\n      hostname: parsedUrl.hostname,\r\n      port: parsedUrl.port || (parsedUrl.protocol === 'https:' ? 443 : 80),\r\n      path: parsedUrl.pathname + parsedUrl.search,\r\n      method: options.method || 'GET',\r\n      headers: options.headers || {},\r\n    };\r\n\r\n    const req = protocol.request(reqOptions, (res) =\u003e {\r\n      let body = '';\r\n      res.on('data', (chunk) =\u003e (body += chunk));\r\n      res.on('end', () =\u003e {\r\n        resolve({\r\n          statusCode: res.statusCode,\r\n          headers: res.headers,\r\n          body,\r\n        });\r\n      });\r\n    });\r\n\r\n    req.on('error', reject);\r\n\r\n    if (options.body) {\r\n      req.write(options.body);\r\n    }\r\n\r\n    req.end();\r\n  });\r\n}\r\n\r\n/**\r\n * Fetch OIDC discovery document\r\n * @returns {Promise\u003cobject\u003e}\r\n */\r\nasync function fetchDiscoveryDocument() {\r\n  const now = Date.now();\r\n  if (discoveryCache \u0026\u0026 now - discoveryCacheTime \u003c DISCOVERY_CACHE_TTL) {\r\n    return discoveryCache;\r\n  }\r\n\r\n  const discoveryUrl = config.issuerUrl.replace(/\\/$/, '') + '/.well-known/openid-configuration';\r\n  const response = await makeRequest(discoveryUrl);\r\n\r\n  if (response.statusCode !== 200) {\r\n    throw new Error(`Failed to fetch OIDC discovery document: ${response.statusCode}`);\r\n  }\r\n\r\n  discoveryCache = JSON.parse(response.body);\r\n  discoveryCacheTime = now;\r\n  return discoveryCache;\r\n}\r\n\r\n/**\r\n * Generate a random string for state/nonce\r\n * @param {number} length\r\n * @returns {string}\r\n */\r\nfunction generateRandomString(length = 32) {\r\n  return crypto.randomBytes(length).toString('hex');\r\n}\r\n\r\n/**\r\n * Base64URL encode\r\n * @param {Buffer|string} input\r\n * @returns {string}\r\n */\r\nfunction base64UrlEncode(input) {\r\n  const base64 = Buffer.isBuffer(input) ? input.toString('base64') : Buffer.from(input).toString('base64');\r\n  return base64.replace(/\\+/g, '-').replace(/\\//g, '_').replace(/=/g, '');\r\n}\r\n\r\n/**\r\n * Base64URL decode\r\n * @param {string} input\r\n * @returns {Buffer}\r\n */\r\nfunction base64UrlDecode(input) {\r\n  let base64 = input.replace(/-/g, '+').replace(/_/g, '/');\r\n  while (base64.length % 4) {\r\n    base64 += '=';\r\n  }\r\n  return Buffer.from(base64, 'base64');\r\n}\r\n\r\n/**\r\n * Decode JWT without verification (for extracting claims)\r\n * @param {string} token\r\n * @returns {object}\r\n */\r\nfunction decodeJwt(token) {\r\n  const parts = token.split('.');\r\n  if (parts.length !== 3) {\r\n    throw new Error('Invalid JWT format');\r\n  }\r\n\r\n  const payload = JSON.parse(base64UrlDecode(parts[1]).toString('utf8'));\r\n  return payload;\r\n}\r\n\r\n/**\r\n * Exchange authorization code for tokens\r\n * @param {string} code\r\n * @param {object} discovery\r\n * @returns {Promise\u003cobject\u003e}\r\n */\r\nasync function exchangeCodeForTokens(code, discovery) {\r\n  const params = new URLSearchParams({\r\n    grant_type: 'authorization_code',\r\n    code,\r\n    redirect_uri: config.redirectUri,\r\n    client_id: config.clientId,\r\n    client_secret: config.clientSecret,\r\n  });\r\n\r\n  const response = await makeRequest(discovery.token_endpoint, {\r\n    method: 'POST',\r\n    headers: {\r\n      'Content-Type': 'application/x-www-form-urlencoded',\r\n    },\r\n    body: params.toString(),\r\n  });\r\n\r\n  if (response.statusCode !== 200) {\r\n    console.error('Token exchange failed:', response.body);\r\n    throw new Error(`Token exchange failed: ${response.statusCode}`);\r\n  }\r\n\r\n  return JSON.parse(response.body);\r\n}\r\n\r\n/**\r\n * Fetch user info from OIDC provider\r\n * @param {string} accessToken\r\n * @param {object} discovery\r\n * @returns {Promise\u003cobject\u003e}\r\n */\r\nasync function fetchUserInfo(accessToken, discovery) {\r\n  const response = await makeRequest(discovery.userinfo_endpoint, {\r\n    headers: {\r\n      Authorization: `Bearer ${accessToken}`,\r\n    },\r\n  });\r\n\r\n  if (response.statusCode !== 200) {\r\n    console.error('UserInfo fetch failed:', response.body);\r\n    throw new Error(`UserInfo fetch failed: ${response.statusCode}`);\r\n  }\r\n\r\n  return JSON.parse(response.body);\r\n}\r\n\r\n/**\r\n * Create a signed JWT for state/nonce storage\r\n * We use the JWT service from n8n when available, but for cookies we just use HMAC\r\n * @param {object} payload\r\n * @param {string} secret\r\n * @param {number} expiresInSeconds\r\n * @returns {string}\r\n */\r\nfunction createSignedCookie(payload, secret, expiresInSeconds = 900) {\r\n  const exp = Math.floor(Date.now() / 1000) + expiresInSeconds;\r\n  const data = JSON.stringify({ ...payload, exp });\r\n  const hmac = crypto.createHmac('sha256', secret);\r\n  hmac.update(data);\r\n  const signature = hmac.digest('hex');\r\n  return base64UrlEncode(data) + '.' + signature;\r\n}\r\n\r\n/**\r\n * Verify and decode a signed cookie\r\n * @param {string} cookie\r\n * @param {string} secret\r\n * @returns {object|null}\r\n */\r\nfunction verifySignedCookie(cookie, secret) {\r\n  try {\r\n    const [dataB64, signature] = cookie.split('.');\r\n    const data = base64UrlDecode(dataB64).toString('utf8');\r\n\r\n    const hmac = crypto.createHmac('sha256', secret);\r\n    hmac.update(data);\r\n    const expectedSignature = hmac.digest('hex');\r\n\r\n    if (signature !== expectedSignature) {\r\n      return null;\r\n    }\r\n\r\n    const payload = JSON.parse(data);\r\n    if (payload.exp \u0026\u0026 payload.exp \u003c Date.now() / 1000) {\r\n      return null;\r\n    }\r\n\r\n    return payload;\r\n  } catch {\r\n    return null;\r\n  }\r\n}\r\n\r\n/**\r\n * Get or create the cookie signing secret\r\n * We derive it from the n8n encryption key if available\r\n * @param {object} context\r\n * @returns {string}\r\n */\r\nfunction getCookieSecret(context) {\r\n  // Use a combination of environment variables to create a stable secret\r\n  const baseKey = process.env.N8N_ENCRYPTION_KEY || process.env.OIDC_CLIENT_SECRET || 'n8n-oidc-hook-secret';\r\n  const hash = crypto.createHash('sha256').update(baseKey + '-oidc-state').digest('hex');\r\n  return hash;\r\n}\r\n\r\n/**\r\n * Create the n8n auth cookie using n8n's JwtService\r\n * @param {object} user\r\n * @param {object} jwtService - n8n's JwtService instance\r\n * @returns {string}\r\n */\r\nfunction createAuthToken(user, jwtService) {\r\n  // n8n's JWT contains: { id, hash, browserId?, usedMfa? }\r\n  const payload = {\r\n    id: user.id,\r\n    hash: createUserHash(user),\r\n    usedMfa: false,\r\n  };\r\n\r\n  return jwtService.sign(payload, { expiresIn: '7d' });\r\n}\r\n\r\n/**\r\n * Create user hash for JWT (mimics n8n's AuthService.createJWTHash)\r\n * @param {object} user\r\n * @returns {string}\r\n */\r\nfunction createUserHash(user) {\r\n  const payload = [user.email, user.password || ''];\r\n  if (user.mfaEnabled \u0026\u0026 user.mfaSecret) {\r\n    payload.push(user.mfaSecret.substring(0, 3));\r\n  }\r\n  return crypto.createHash('sha256').update(payload.join(':')).digest('base64').substring(0, 10);\r\n}\r\n\r\n/**\r\n * Check if email is valid\r\n * @param {string} email\r\n * @returns {boolean}\r\n */\r\nfunction isValidEmail(email) {\r\n  const emailRegex = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\r\n  return emailRegex.test(email);\r\n}\r\n\r\n// n8n module paths (specific to the Docker image)\r\nconst N8N_DI_PATH = '/usr/local/lib/node_modules/n8n/node_modules/@n8n/di';\r\nconst N8N_JWT_SERVICE_PATH = '/usr/local/lib/node_modules/n8n/dist/services/jwt.service.js';\r\n\r\n// Export the hooks\r\nmodule.exports = {\r\n  n8n: {\r\n    /**\r\n     * Called when n8n is ready\r\n     * We use this to register custom routes for OIDC\r\n     */\r\n    ready: [\r\n      async function (server, n8nConfig) {\r\n        const missing = validateConfig();\r\n        if (missing.length \u003e 0) {\r\n          console.warn(`[OIDC Hook] Missing configuration: ${missing.join(', ')}. OIDC disabled.`);\r\n          return;\r\n        }\r\n\r\n        console.log('[OIDC Hook] Initializing OIDC authentication...');\r\n\r\n        // Get n8n's JwtService from the DI container\r\n        const { Container } = require(N8N_DI_PATH);\r\n        const { JwtService } = require(N8N_JWT_SERVICE_PATH);\r\n        const jwtService = Container.get(JwtService);\r\n\r\n        const { app } = server;\r\n        const cookieSecret = getCookieSecret();\r\n\r\n        // Cookie settings\r\n        const cookieOptions = {\r\n          httpOnly: true,\r\n          secure: process.env.N8N_PROTOCOL === 'https',\r\n          sameSite: 'lax',\r\n          maxAge: 15 * 60 * 1000, // 15 minutes\r\n        };\r\n\r\n        const authCookieOptions = {\r\n          httpOnly: true,\r\n          secure: process.env.N8N_PROTOCOL === 'https',\r\n          sameSite: 'lax',\r\n          maxAge: 7 * 24 * 60 * 60 * 1000, // 7 days\r\n        };\r\n\r\n        /**\r\n         * OIDC Login endpoint - redirects to the OIDC provider\r\n         */\r\n        app.get('/auth/oidc/login', async (req, res) =\u003e {\r\n          try {\r\n            const discovery = await fetchDiscoveryDocument();\r\n\r\n            const state = generateRandomString();\r\n            const nonce = generateRandomString();\r\n\r\n            // Store state and nonce in signed cookies\r\n            const stateCookie = createSignedCookie({ state }, cookieSecret);\r\n            const nonceCookie = createSignedCookie({ nonce }, cookieSecret);\r\n\r\n            res.cookie('n8n-oidc-state', stateCookie, cookieOptions);\r\n            res.cookie('n8n-oidc-nonce', nonceCookie, cookieOptions);\r\n\r\n            // Build authorization URL\r\n            const authUrl = new URL(discovery.authorization_endpoint);\r\n            authUrl.searchParams.set('client_id', config.clientId);\r\n            authUrl.searchParams.set('redirect_uri', config.redirectUri);\r\n            authUrl.searchParams.set('response_type', 'code');\r\n            authUrl.searchParams.set('scope', config.scopes);\r\n            authUrl.searchParams.set('state', state);\r\n            authUrl.searchParams.set('nonce', nonce);\r\n\r\n            res.redirect(authUrl.toString());\r\n          } catch (error) {\r\n            console.error('[OIDC Hook] Login error:', error);\r\n            res.status(500).send('OIDC configuration error. Please check the logs.');\r\n          }\r\n        });\r\n\r\n        /**\r\n         * OIDC Callback endpoint - handles the authorization code\r\n         */\r\n        app.get('/auth/oidc/callback', async (req, res) =\u003e {\r\n          try {\r\n            const { code, state, error, error_description } = req.query;\r\n\r\n            // Handle OIDC errors\r\n            if (error) {\r\n              console.error('[OIDC Hook] OIDC error:', error, error_description);\r\n              return res.redirect('/signin?error=' + encodeURIComponent(error_description || error));\r\n            }\r\n\r\n            if (!code || !state) {\r\n              return res.redirect('/signin?error=' + encodeURIComponent('Missing authorization code or state'));\r\n            }\r\n\r\n            // Verify state\r\n            const stateCookie = req.cookies['n8n-oidc-state'];\r\n            const nonceCookie = req.cookies['n8n-oidc-nonce'];\r\n\r\n            if (!stateCookie || !nonceCookie) {\r\n              return res.redirect('/signin?error=' + encodeURIComponent('Missing state cookies - session expired'));\r\n            }\r\n\r\n            const statePayload = verifySignedCookie(stateCookie, cookieSecret);\r\n            const noncePayload = verifySignedCookie(nonceCookie, cookieSecret);\r\n\r\n            if (!statePayload || statePayload.state !== state) {\r\n              return res.redirect('/signin?error=' + encodeURIComponent('Invalid state - possible CSRF attack'));\r\n            }\r\n\r\n            // Clear state cookies\r\n            res.clearCookie('n8n-oidc-state');\r\n            res.clearCookie('n8n-oidc-nonce');\r\n\r\n            // Exchange code for tokens\r\n            const discovery = await fetchDiscoveryDocument();\r\n            const tokens = await exchangeCodeForTokens(code, discovery);\r\n\r\n            // Verify nonce in ID token if present\r\n            if (tokens.id_token) {\r\n              const idTokenClaims = decodeJwt(tokens.id_token);\r\n              if (noncePayload \u0026\u0026 idTokenClaims.nonce !== noncePayload.nonce) {\r\n                return res.redirect('/signin?error=' + encodeURIComponent('Invalid nonce - possible replay attack'));\r\n              }\r\n            }\r\n\r\n            // Get user info\r\n            let userInfo;\r\n            try {\r\n              userInfo = await fetchUserInfo(tokens.access_token, discovery);\r\n            } catch (e) {\r\n              // Fall back to ID token claims if userinfo endpoint fails\r\n              if (tokens.id_token) {\r\n                userInfo = decodeJwt(tokens.id_token);\r\n              } else {\r\n                throw e;\r\n              }\r\n            }\r\n\r\n            // Validate we have an email\r\n            if (!userInfo.email || !isValidEmail(userInfo.email)) {\r\n              return res.redirect('/signin?error=' + encodeURIComponent('No valid email in OIDC response'));\r\n            }\r\n\r\n            // Find or create user in n8n database\r\n            const { User, Settings, Credentials, Workflow } = this.dbCollections;\r\n\r\n            // Try to find existing user by email\r\n            let user = await User.findOne({\r\n              where: { email: userInfo.email },\r\n              relations: ['role'],\r\n            });\r\n\r\n            if (!user) {\r\n              // Check if this is the first user (should be owner)\r\n              const userCount = await User.count();\r\n\r\n              const userData = {\r\n                email: userInfo.email,\r\n                firstName: userInfo.given_name || userInfo.name?.split(' ')[0] || 'User',\r\n                lastName: userInfo.family_name || userInfo.name?.split(' ').slice(1).join(' ') || '',\r\n                password: crypto.randomBytes(32).toString('hex'), // Random password, can't be used\r\n                role: { slug: userCount === 0 ? 'global:owner' : 'global:member' },\r\n              };\r\n\r\n              // Use createUserWithProject to create both user and personal project\r\n              const result = await User.createUserWithProject(userData);\r\n              user = result.user;\r\n\r\n              console.log(`[OIDC Hook] Created ${userCount === 0 ? 'owner' : 'member'} user with personal project: ${userInfo.email}`);\r\n            }\r\n\r\n            if (!user) {\r\n              return res.redirect('/signin?error=' + encodeURIComponent('Failed to create or find user'));\r\n            }\r\n\r\n            // Create auth token using n8n's JwtService\r\n            const authToken = createAuthToken(user, jwtService);\r\n\r\n            // Set the n8n auth cookie\r\n            res.cookie('n8n-auth', authToken, authCookieOptions);\r\n\r\n            // Redirect to home\r\n            res.redirect('/');\r\n          } catch (error) {\r\n            console.error('[OIDC Hook] Callback error:', error);\r\n            res.redirect('/signin?error=' + encodeURIComponent('Authentication failed: ' + error.message));\r\n          }\r\n        });\r\n\r\n        /**\r\n         * Serve the frontend customization script\r\n         * This script will replace the login form with an OIDC button\r\n         *\r\n         * NOTE: The route must be under /assets/ or another non-UI route prefix\r\n         * to avoid being intercepted by n8n's history API handler which would\r\n         * serve index.html instead of our JavaScript file.\r\n         */\r\n        app.get('/assets/oidc-frontend-hook.js', (req, res) =\u003e {\r\n          // Use res.type() for proper MIME type handling with nosniff\r\n          res.type('text/javascript; charset=utf-8');\r\n          res.set('Cache-Control', 'public, max-age=3600');\r\n          res.send(getFrontendScript());\r\n        });\r\n\r\n        console.log('[OIDC Hook] OIDC routes registered:');\r\n        console.log('  - GET /auth/oidc/login');\r\n        console.log('  - GET /auth/oidc/callback');\r\n        console.log('  - GET /assets/oidc-frontend-hook.js');\r\n      },\r\n    ],\r\n  },\r\n\r\n  frontend: {\r\n    /**\r\n     * Modify frontend settings to configure SSO display\r\n     */\r\n    settings: [\r\n      async function (frontendSettings) {\r\n        const missing = validateConfig();\r\n        if (missing.length \u003e 0) {\r\n          return; // OIDC not configured, don't modify settings\r\n        }\r\n\r\n        // Enable OIDC login button by setting these properties\r\n        // This tells the frontend that OIDC is available\r\n        frontendSettings.sso = frontendSettings.sso || {};\r\n        frontendSettings.sso.oidc = {\r\n          loginEnabled: true,\r\n          loginUrl: '/auth/oidc/login',\r\n          callbackUrl: config.redirectUri,\r\n        };\r\n\r\n        // Set authentication method to OIDC so the frontend knows SSO is primary\r\n        frontendSettings.userManagement = frontendSettings.userManagement || {};\r\n        frontendSettings.userManagement.authenticationMethod = 'oidc';\r\n\r\n        // Enable enterprise OIDC feature flag so the SSO button shows\r\n        frontendSettings.enterprise = frontendSettings.enterprise || {};\r\n        frontendSettings.enterprise.oidc = true;\r\n\r\n        console.log('[OIDC Hook] Frontend settings configured for OIDC');\r\n      },\r\n    ],\r\n  },\r\n};\r\n\r\n/**\r\n * Generate the frontend customization script\r\n * This script runs in the browser and customizes the login page\r\n */\r\nfunction getFrontendScript() {\r\n  return `\r\n/**\r\n * n8n OIDC Frontend Customization\r\n *\r\n * This script surgically modifies the login form to show an SSO button.\r\n * To access the normal login form, add ?showLogin=true to the URL.\r\n */\r\n(function() {\r\n\t'use strict';\r\n\r\n\tfunction shouldShowNormalLogin() {\r\n\t\treturn new URLSearchParams(window.location.search).get('showLogin') === 'true';\r\n\t}\r\n\r\n\tfunction isSigninPage() {\r\n\t\treturn window.location.pathname === '/signin' || window.location.pathname === '/login';\r\n\t}\r\n\r\n\tfunction displayError(form) {\r\n\t\tvar error = new URLSearchParams(window.location.search).get('error');\r\n\t\tif (!error || !form || form.querySelector('#oidc-error')) return;\r\n\r\n\t\tvar errorDiv = document.createElement('div');\r\n\t\terrorDiv.id = 'oidc-error';\r\n\t\terrorDiv.style.cssText = 'background: var(--color-danger-tint-1, #fee); border: 1px solid var(--color-danger, #fcc); color: var(--color-danger, #c00); padding: 12px; border-radius: 4px; margin: 16px 0;';\r\n\t\terrorDiv.textContent = decodeURIComponent(error);\r\n\r\n\t\tvar heading = form.querySelector('div[class*=\"_heading_\"]');\r\n\t\tif (heading) heading.after(errorDiv);\r\n\t\telse form.prepend(errorDiv);\r\n\t}\r\n\r\n\tfunction injectSsoButton() {\r\n\t\tif (shouldShowNormalLogin()) return;\r\n\t\tif (!isSigninPage()) return;\r\n\r\n\t\tvar form = document.querySelector('[data-test-id=\"auth-form\"]');\r\n\t\tif (!form || form.querySelector('#oidc-sso-button')) return;\r\n\r\n\t\t// Find existing button to clone its classes\r\n\t\tvar existingButton = form.querySelector('[data-test-id=\"form-submit-button\"]');\r\n\t\tvar buttonClasses = existingButton ? existingButton.className : '';\r\n\r\n\t\t// Hide the form elements (inputs, buttons, forgot password)\r\n\t\tform.querySelectorAll('div[class*=\"_inputsContainer_\"], div[class*=\"_buttonsContainer_\"], div[class*=\"_actionContainer_\"]')\r\n\t\t\t.forEach(function(el) { el.style.display = 'none'; });\r\n\r\n\t\t// Create SSO button container\r\n\t\tvar ssoContainer = document.createElement('div');\r\n\t\tssoContainer.id = 'oidc-sso-container';\r\n\t\tssoContainer.style.cssText = 'text-align: center;';\r\n\r\n\t\t// Create button - use cloned classes or fallback styles\r\n\t\tvar button = document.createElement('button');\r\n\t\tbutton.id = 'oidc-sso-button';\r\n\t\tbutton.type = 'button';\r\n\t\tbutton.textContent = 'Sign in with SSO';\r\n\t\tbutton.onclick = function() { window.location.href = '/auth/oidc/login'; };\r\n\r\n\t\tif (buttonClasses) {\r\n\t\t\tbutton.className = buttonClasses;\r\n\t\t\tbutton.style.width = '100%';\r\n\t\t} else {\r\n\t\t\tbutton.style.cssText = 'width: 100%; padding: 12px 24px; font-size: 14px; font-weight: 600; color: white; background: var(--color-primary, #ea4b30); border: none; border-radius: 4px; cursor: pointer;';\r\n\t\t}\r\n\r\n\t\t// Create admin link\r\n\t\tvar adminLink = document.createElement('p');\r\n\t\tadminLink.style.cssText = 'margin-top: 16px; font-size: 12px; color: var(--color-text-light, #666);';\r\n\t\tadminLink.innerHTML = 'Admin? \u003ca href=\"?showLogin=true\" style=\"color: var(--color-primary, #ea4b30);\"\u003eSign in with email\u003c/a\u003e';\r\n\r\n\t\tssoContainer.appendChild(button);\r\n\t\tssoContainer.appendChild(adminLink);\r\n\r\n\t\t// Insert after the heading\r\n\t\tvar heading = form.querySelector('div[class*=\"_heading_\"]');\r\n\t\tif (heading) heading.after(ssoContainer);\r\n\t\telse form.prepend(ssoContainer);\r\n\r\n\t\tdisplayError(form);\r\n\t}\r\n\r\n\tfunction observeAndInject() {\r\n\t\tif (shouldShowNormalLogin() || !isSigninPage()) return;\r\n\r\n\t\tinjectSsoButton();\r\n\r\n\t\tvar observer = new MutationObserver(function() {\r\n\t\t\tif (isSigninPage() \u0026\u0026 !shouldShowNormalLogin()) {\r\n\t\t\t\tvar form = document.querySelector('[data-test-id=\"auth-form\"]');\r\n\t\t\t\tif (form \u0026\u0026 !form.querySelector('#oidc-sso-button')) {\r\n\t\t\t\t\tinjectSsoButton();\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t});\r\n\r\n\t\tobserver.observe(document.body, { childList: true, subtree: true });\r\n\t\tsetTimeout(function() { observer.disconnect(); }, 10000);\r\n\t}\r\n\r\n\tfunction handleNavigation() {\r\n\t\tvar origPush = history.pushState;\r\n\t\tvar origReplace = history.replaceState;\r\n\r\n\t\thistory.pushState = function() {\r\n\t\t\torigPush.apply(this, arguments);\r\n\t\t\tsetTimeout(observeAndInject, 100);\r\n\t\t};\r\n\r\n\t\thistory.replaceState = function() {\r\n\t\t\torigReplace.apply(this, arguments);\r\n\t\t\tsetTimeout(observeAndInject, 100);\r\n\t\t};\r\n\r\n\t\twindow.addEventListener('popstate', function() {\r\n\t\t\tsetTimeout(observeAndInject, 100);\r\n\t\t});\r\n\t}\r\n\r\n\tif (document.readyState === 'loading') {\r\n\t\tdocument.addEventListener('DOMContentLoaded', function() {\r\n\t\t\tobserveAndInject();\r\n\t\t\thandleNavigation();\r\n\t\t});\r\n\t} else {\r\n\t\tobserveAndInject();\r\n\t\thandleNavigation();\r\n\t}\r\n\r\n\tsetTimeout(observeAndInject, 500);\r\n\tsetTimeout(observeAndInject, 1000);\r\n\r\n\tconsole.log('[OIDC Hook] Frontend customization loaded');\r\n})();\r\n`;\r\n}\r\n"},"id":"n8n/n8n-oidc-hooks","immutable":false,"metadata":[{"annotations":{},"generate_name":"","generation":0,"labels":{},"name":"n8n-oidc-hooks","namespace":"n8n","resource_version":"797","uid":"caa66dff-0539-4613-9826-0c2702e2d07b"}]},"sensitive_attributes":[],"private":"bnVsbA==","dependencies":["kubernetes_namespace.n8n"],"identity":{"api_version":"v1","kind":"ConfigMap","name":"n8n-oidc-hooks","namespace":"n8n"},"identity_schema_version":1}]},{"mode":"managed","type":"kubernetes_namespace","name":"ansible","provider":"provider[\"registry.opentofu.org/hashicorp/kubernetes\"]","instances":[{"schema_version":0,"attributes":{"id":"ansible","metadata":[{"annotations":{},"generate_name":"","generation":0,"labels":{},"name":"ansible","resource_version":"776","uid":"2b5f690f-7cc0-422d-89db-3c627bfdcced"}],"timeouts":null,"wait_for_default_service_account":false},"sensitive_attributes":[],"private":"eyJlMmJmYjczMC1lY2FhLTExZTYtOGY4OC0zNDM2M2JjN2M0YzAiOnsiZGVsZXRlIjozMDAwMDAwMDAwMDB9fQ==","identity":{"api_version":"v1","kind":"Namespace","name":"ansible"},"identity_schema_version":1}]},{"mode":"managed","type":"kubernetes_namespace","name":"argocd","provider":"provider[\"registry.opentofu.org/hashicorp/kubernetes\"]","instances":[{"schema_version":0,"attributes":{"id":"argocd",