spawn-role\",\n        \"sendBody\": true,\n        \"specifyBody\": \"json\",\n        \"jsonBody\": \"={{ JSON.stringify({ role: 'qa-engineer', task: 'uat-stage-1', version: $json.body.version, project: $json.body.project }) }}\",\n        \"options\": {}\n      },\n      \"id\": \"spawn-F-11-uat-qa-complete\",\n      \"name\": \"Spawn qa-engineer: uat-stage-1\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4,\n      \"position\": [\n        480,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"conditions\": {\n          \"conditions\": [\n            {\n              \"leftValue\": \"={{ $json.exitCode }}\",\n              \"rightValue\": 0,\n              \"operator\": {\n                \"type\": \"number\",\n                \"operation\": \"equals\"\n              }\n            }\n          ]\n        }\n      },\n      \"id\": \"check-F-11-uat-qa-complete\",\n      \"name\": \"Passed?\",\n      \"type\": \"n8n-nodes-base.if\",\n      \"typeVersion\": 2,\n      \"position\": [\n        720,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"command\": \"glab issue update {{ $json.body.release_ticket_id }} --label-add 'qa:uat-approved' \u0026\u0026 glab issue comment {{ $json.body.release_ticket_id }} --message 'qa:uat-approved applied'\"\n      },\n      \"id\": \"label-F-11-uat-qa-complete\",\n      \"name\": \"Apply qa:uat-approved on release ticket\",\n      \"type\": \"n8n-nodes-base.executeCommand\",\n      \"typeVersion\": 1,\n      \"position\": [\n        960,\n        200\n      ]\n    },\n    {\n      \"parameters\": {\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/security-scan-start\",\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"version\",\n              \"value\": \"={{ $json.body.version }}\"\n            },\n            {\n              \"name\": \"project\",\n              \"value\": \"={{ $json.body.project }}\"\n            },\n            {\n              \"name\": \"release_ticket_id\",\n              \"value\": \"={{ $json.body.release_ticket_id }}\"\n            }\n          ]\n        }\n      },\n      \"id\": \"next-F-11-uat-qa-complete\",\n      \"name\": \"Trigger next stage\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4,\n      \"position\": [\n        1200,\n        200\n      ]\n    },\n    {\n      \"parameters\": {\n        \"command\": \"glab issue create --title '[bugfix] qa-engineer finding during uat-stage-1' --label 'type:bugfix,role:qa-engineer' --milestone '{{ $json.body.version }}' --description 'Found during UAT uat-stage-1. Environment: UAT cluster.'\"\n      },\n      \"id\": \"bug-F-11-uat-qa-complete\",\n      \"name\": \"Create bug ticket (type:bug-uat)\",\n      \"type\": \"n8n-nodes-base.executeCommand\",\n      \"typeVersion\": 1,\n      \"position\": [\n        960,\n        440\n      ]\n    }\n  ],\n  \"connections\": {\n    \"Webhook: F-11-uat-qa-complete trigger\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Spawn qa-engineer: uat-stage-1\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Spawn qa-engineer: uat-stage-1\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Passed?\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Passed?\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Apply qa:uat-approved on release ticket\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ],\n        [\n          {\n            \"node\": \"Create bug ticket (type:bug-uat)\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Apply qa:uat-approved on release ticket\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Trigger next stage\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    }\n  },\n  \"active\": true,\n  \"settings\": {\n    \"executionOrder\": \"v1\"\n  },\n  \"tags\": [\n    {\n      \"name\": \"uat\"\n    },\n    {\n      \"name\": \"phase-3\"\n    }\n  ]\n}\n","F-12-uat-security-complete.json":"{\n  \"name\": \"F-12-uat-security-complete\",\n  \"nodes\": [\n    {\n      \"parameters\": {\n        \"httpMethod\": \"POST\",\n        \"path\": \"security-scan-start\",\n        \"responseMode\": \"lastNode\",\n        \"options\": {}\n      },\n      \"id\": \"webhook-F-12-uat-security-complete\",\n      \"name\": \"Webhook: F-12-uat-security-complete trigger\",\n      \"type\": \"n8n-nodes-base.webhook\",\n      \"typeVersion\": 1,\n      \"position\": [\n        240,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/spawn-role\",\n        \"sendBody\": true,\n        \"specifyBody\": \"json\",\n        \"jsonBody\": \"={{ JSON.stringify({ role: 'security-engineer', task: 'uat-stage-2', version: $json.body.version, project: $json.body.project }) }}\",\n        \"options\": {}\n      },\n      \"id\": \"spawn-F-12-uat-security-complete\",\n      \"name\": \"Spawn security-engineer: uat-stage-2\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4,\n      \"position\": [\n        480,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"conditions\": {\n          \"conditions\": [\n            {\n              \"leftValue\": \"={{ $json.exitCode }}\",\n              \"rightValue\": 0,\n              \"operator\": {\n                \"type\": \"number\",\n                \"operation\": \"equals\"\n              }\n            }\n          ]\n        }\n      },\n      \"id\": \"check-F-12-uat-security-complete\",\n      \"name\": \"Passed?\",\n      \"type\": \"n8n-node