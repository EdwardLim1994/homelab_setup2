 \"number\": 9000\n  \"ingressClassName\": \"tailscale\"\n  \"tls\":\n  - \"hosts\":\n    - \"sonarqube\"\n","yaml_body_parsed":"apiVersion: networking.k8s.io/v1\nkind: Ingress\nmetadata:\n  name: ts-sonarqube\n  namespace: sonarqube\nspec:\n  defaultBackend:\n    service:\n      name: sonarqube-sonarqube\n      port:\n        number: 9000\n  ingressClassName: tailscale\n  tls:\n  - hosts:\n    - sonarqube\n","yaml_incluster":"1b96b5d194c21cf29fbe50eb6e3aba443c274f16e1ad03541f9d000e59f41abd"},"sensitive_attributes":[[{"type":"get_attr","value":"live_manifest_incluster"}],[{"type":"get_attr","value":"yaml_body"}],[{"type":"get_attr","value":"yaml_incluster"}]],"private":"eyJlMmJmYjczMC1lY2FhLTExZTYtOGY4OC0zNDM2M2JjN2M0YzAiOnsiY3JlYXRlIjo2MDAwMDAwMDAwMDB9LCJzY2hlbWFfdmVyc2lvbiI6IjEifQ==","dependencies":["helm_release.tailscale_operator","kubernetes_namespace.tailscale"]}]},{"mode":"managed","type":"kubernetes_config_map","name":"ansible_n8n_flows","provider":"provider[\"registry.opentofu.org/hashicorp/kubernetes\"]","instances":[{"schema_version":0,"attributes":{"binary_data":{},"data":{"F-01-plan-release.json":"{\n  \"name\": \"F-01 /plan-release\",\n  \"nodes\": [\n    {\n      \"parameters\": {\n        \"httpMethod\": \"POST\",\n        \"path\": \"plan-release\",\n        \"responseMode\": \"lastNode\",\n        \"options\": {}\n      },\n      \"id\": \"webhook-plan-release\",\n      \"name\": \"Webhook: /plan-release\",\n      \"type\": \"n8n-nodes-base.webhook\",\n      \"typeVersion\": 1,\n      \"position\": [\n        240,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/spawn-role\",\n        \"sendBody\": true,\n        \"specifyBody\": \"json\",\n        \"jsonBody\": \"={{ JSON.stringify({ role: 'solution-architect', task: 'gate-A-planning', version: $json.body.version, project: $json.body.project, openspec_path: 'openspec/architecture.md' }) }}\",\n        \"options\": {}\n      },\n      \"id\": \"spawn-architect-pod\",\n      \"name\": \"Spawn Architect Pod (gate A)\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4,\n      \"position\": [\n        480,\n        200\n      ]\n    },\n    {\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/spawn-role\",\n        \"sendBody\": true,\n        \"specifyBody\": \"json\",\n        \"jsonBody\": \"={{ JSON.stringify({ role: 'data-engineer', task: 'gate-A-planning', version: $json.body.version, project: $json.body.project }) }}\",\n        \"options\": {}\n      },\n      \"id\": \"spawn-de-pod\",\n      \"name\": \"Spawn Data Engineer Pod (gate A)\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4,\n      \"position\": [\n        480,\n        400\n      ]\n    },\n    {\n      \"parameters\": {\n        \"conditions\": {\n          \"options\": {\n            \"caseSensitive\": true\n          },\n          \"conditions\": [\n            {\n              \"leftValue\": \"={{ $node['Spawn Architect Pod (gate A)'].json.exitCode }}\",\n              \"rightValue\": 0,\n              \"operator\": {\n                \"type\": \"number\",\n                \"operation\": \"equals\"\n              }\n            }\n          ]\n        }\n      },\n      \"id\": \"check-gate-a\",\n      \"name\": \"Gate A: both complete?\",\n      \"type\": \"n8n-nodes-base.if\",\n      \"typeVersion\": 2,\n      \"position\": [\n        720,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/spawn-role\",\n        \"sendBody\": true,\n        \"specifyBody\": \"json\",\n        \"jsonBody\": \"={{ JSON.stringify({ role: 'qa-engineer', task: 'gate-B-challenge', version: $json.body.version, project: $json.body.project }) }}\",\n        \"options\": {}\n      },\n      \"id\": \"spawn-qa-pod\",\n      \"name\": \"Spawn QA Pod (gate B)\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4,\n      \"position\": [\n        960,\n        160\n      ]\n    },\n    {\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/spawn-role\",\n        \"sendBody\": true,\n        \"specifyBody\": \"json\",\n        \"jsonBody\": \"={{ JSON.stringify({ role: 'security-engineer', task: 'gate-B-threat-model', version: $json.body.version, project: $json.body.project }) }}\",\n        \"options\": {}\n      },\n      \"id\": \"spawn-sec-pod\",\n      \"name\": \"Spawn Security Pod (gate B)\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4,\n      \"position\": [\n        960,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/spawn-role\",\n        \"sendBody\": true,\n        \"specifyBody\": \"json\",\n        \"jsonBody\": \"={{ JSON.stringify({ role: 'uiux-designer', task: 'gate-B-ux-spec', version: $json.body.version, project: $json.body.project }) }}\",\n        \"options\": {}\n      },\n      \"id\": \"spawn-ux-pod\",\n      \"name\": \"Spawn UX Pod (gate B)\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4,\n      \"position\": [\n        960,\n        440\n      ]\n    },\n    {\n      \"parameters\": {\n        \"jsCode\": \"const revisionCount = $workflow.staticData.revisionCount || 0;\\nif (revisionCount \u003e= 3) {\\n  return [{ json: { escalate: true, reason: 'Max arch revisions reached', revisions: revisionCount } }];\\n}\\n$workflow.staticData.revisionCount = revisionCount + 1;\\nreturn [{ json: { escalate: false, revisionCount: revisionCount + 1 } }];\"\n      },\n      \"id\": \"check-arch-revision\",\n      \"name\": \"Check: arch revision needed? (max 3)\",\n      \"type\": \"n8n-nodes-base.code\",\n      \"typeVersion\": 2,\n      \"position\": [\n        1200,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"conditions\": {\n          \"conditions\": [\n            {\n              \"leftValue\": \"={{ $json.escalate }}\",\n              \"rightValue\": true,\n              \"operator\": {\n                \"type\": \"boolean\",\n                \"operation\": \"equals\"\n              }\n            }\n          ]\n        }\n      },\n      \"id\": \"escalate-check\",\n      \"name\": \"Escalate or re-arch?\",\n      \"type\": \"n8n-nodes-base.if\",\n      \"typeVersion\": 2,\n      \"position\": [\n        1440,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/spawn-role\",\n        \"sendBody\": true,\n        \"specifyBody\": \"json\",\n        \"jsonBody\": \"={{ JSON.stringify({ role: 'project-manager', task: 'prd-and-task-breakdown', version: $json.body.version, project: $json.body.project }) }}\",\n        \"options\": {}\n      },\n      \"id\": \"spawn-pm-pod\",\n      \"name\": \"Spawn PM Pod (gate C – PRD + scoring)\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4,\n      \"position\": [\n        1680,\n        200\n      ]\n    },\n    {\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/spawn-role\",\n        \"sendBody\": true,\n        \"specifyBody\": \"json\",\n        \"jsonBody\": \"={{ JSON.stringify({ role: 'security-engineer', task: 'priority-scoring', version: $json.body.version, project: $json.body.project }) }}\",\n        \"options\": {}\n      },\n      \"id\": \"spawn-scoring-pod\",\n      \"name\": \"Spawn Security Scoring Pod (gate C)\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4,\n      \"position\": [\n        1680,\n        400\n      ]\n    },\n    {\n      \"parameters\": {\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/f01-notify-edward\",\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"message\",\n              \"value\": \"Sprint plan ready for /kickoff\"\n            },\n            {\n              \"name\": \"version\",\n              \"value\": \"={{ $json.body.version }}\"\n            },\n            {\n              \"name\": \"project\",\n              \"value\": \"={{ $json.body.project }}\"\n            }\n          ]\n        }\n      },\n      \"id\": \"notify-edward\",\n      \"name\": \"Notify Edward: sprint plan ready\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4,\n      \"position\": [\n        1920,\n        300\n      ]\n    }\n  ],\n  \"connections\": {\n    \"Webhook: /plan-release\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Spawn Architect Pod (gate A)\",\n            \"type\": \"main\",\n            \"index\": 0\n          },\n          {\n            \"node\": \"Spawn Data Engineer Pod (gate A)\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Spawn Architect Pod (gate A)\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Gate A: both complete?\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Spawn Data Engineer Pod (gate A)\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Gate A: both complete?\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Gate A: both complete?\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Spawn QA Pod (gate B)\",\n            \"type\": \"main\",\n            \"index\": 0\n          },\n          {\n            \"node\": \"Spawn Security Pod (gate B)\",\n            \"type\": \"main\",\n            \"index\": 0\n          },\n          {\n            \"node\": \"Spawn UX Pod (gate B)\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ],\n        [\n          {\n            \"node\": \"Notify Edward: sprint plan ready\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Spawn QA Pod (gate B)\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Check: arch revision needed? (max 3)\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Spawn Security Pod (gate B)\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Check: arch revision needed? (max 3)\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Spawn UX Pod (gate B)\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Check: arch revision needed? (max 3)\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Check: arch revision needed? (max 3)\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Escalate or re-arch?\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Escalate or re-arch?\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Notify Edward: sprint plan ready\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ],\n        [\n          {\n            \"node\": \"Spawn PM Pod (gate C – PRD + scoring)\",\n            \"type\": \"main\",\n            \"index\": 0\n          },\n          {\n            \"node\": \"Spawn Security Scoring Pod (gate C)\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Spawn PM Pod (gate C – PRD + scoring)\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Notify Edward: sprint plan ready\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Spawn Security Scoring Pod (gate C)\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Notify Edward: sprint plan ready\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    }\n  },\n  \"active\": true,\n  \"settings\": {\n    \"executionOrder\": \"v1\"\n  },\n  \"tags\": [\n    {\n      \"name\": \"planning\"\n    },\n    {\n      \"name\": \"phase-0\"\n    }\n  ]\n}\n","F-02-kickoff.json":"{\n  \"name\": \"F-02 /kickoff\",\n  \"nodes\": [\n    {\n      \"parameters\": {\n        \"httpMethod\": \"POST\",\n        \"path\": \"kickoff\",\n        \"responseMode\": \"lastNode\",\n        \"options\": {}\n      },\n      \"id\": \"webhook-kickoff\",\n      \"name\": \"Webhook: /kickoff\",\n      \"type\": \"n8n-nodes-base.webhook\",\n      \"typeVersion\": 1,\n      \"position\": [\n        240,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/spawn-role\",\n        \"sendBody\": true,\n        \"specifyBody\": \"json\",\n        \"jsonBody\": \"={{ JSON.stringify({ role: 'tech-lead', task: 'kickoff-branches', version: $json.body.version, project: $json.body.project }) }}\",\n        \"options\": {}\n      },\n      \"id\": \"spawn-tl-kickoff\",\n      \"name\": \"Spawn TL Pod: branches + openspec + pseudocode\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4,\n      \"position\": [\n        480,\n        160\n      ]\n    },\n    {\n      \"parameters\": {\n        \"command\": \"=echo '{\\\"role\\\":\\\"pm\\\",\\\"task\\\":\\\"kickoff-gitlab-artifacts\\\",\\\"version\\\":\\\"{{ $json.body.version }}\\\",\\\"project\\\":\\\"{{ $json.body.project }}\\\"}' \u003e /tmp/task-pm-kick.json \u0026\u0026 omp -p \\\"$(cat /tmp/task-pm-kick.json)\\\"\"\n      },\n      \"id\": \"spawn-pm-kickoff\",\n      \"name\": \"Spawn PM Pod (omp): GitLab artifacts\",\n      \"type\": \"n8n-nodes-base.executeCommand\",\n      \"typeVersion\": 1,\n      \"position\": [\n        480,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/spawn-role\",\n        \"sendBody\": true,\n        \"specifyBody\": \"json\",\n        \"jsonBody\": \"={{ JSON.stringify({ role: 'devops-engineer', task: 'kickoff-infra', version: $json.body.version, project: $json.body.project }) }}\",\n        \"options\": {}\n      },\n      \"id\": \"spawn-devops-kickoff\",\n      \"name\": \"Spawn DevOps Pod: provision infra (new projects)\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4,\n      \"position\": [\n        480,\n        440\n      ]\n    },\n    {\n      \"parameters\": {\n        \"jsCode\": \"const tl = $node['Spawn TL Pod: branches + openspec + pseudocode'].json.exitCode;\\nconst pm = $node['Spawn PM Pod (omp): GitLab artifacts'].json.exitCode;\\nconst devops = $node['Spawn DevOps Pod: provision infra (new projects)'].json.exitCode;\\nif (tl === 0 \u0026\u0026 pm === 0 \u0026\u0026 devops === 0) {\\n  return [{ json: { status: 'ready', allComplete: true } }];\\n}\\nreturn [{ json: { status: 'partial-failure', tl, pm, devops } }];\"\n      },\n      \"id\": \"check-kickoff-complete\",\n      \"name\": \"All 3 tracks complete?\",\n      \"type\": \"n8n-nodes-base.code\",\n      \"typeVersion\": 2,\n      \"position\": [\n        720,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/f02-notify\",\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"message\",\n              \"value\": \"Kickoff complete. Review branches and openspec, then run /develop.\"\n            },\n            {\n              \"name\": \"version\",\n              \"value\": \"={{ $json.body.version }}\"\n            }\n          ]\n        }\n      },\n      \"id\": \"notify-edward-kickoff\",\n      \"name\": \"Notify Edward: ready for /develop\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4,\n      \"position\": [\n        960,\n        300\n      ]\n    }\n  ],\n  \"connections\": {\n    \"Webhook: /kickoff\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Spawn TL Pod: branches + openspec + pseudocode\",\n            \"type\": \"main\",\n            \"index\": 0\n          },\n          {\n            \"node\": \"Spawn PM Pod (omp): GitLab artifacts\",\n            \"type\": \"main\",\n            \"index\": 0\n          },\n          {\n            \"node\": \"Spawn DevOps Pod: provision infra (new projects)\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Spawn TL Pod: branches + openspec + pseudocode\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"All 3 tracks complete?\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Spawn PM Pod (omp): GitLab artifacts\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"All 3 tracks complete?\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Spawn DevOps Pod: provision infra (new projects)\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"All 3 tracks complete?\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"All 3 tracks complete?\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Notify Edward: ready for /develop\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    }\n  },\n  \"active\": true,\n  \"settings\": {\n    \"executionOrder\": \"v1\"\n  },\n  \"tags\": [\n    {\n      \"name\": \"planning\"\n    },\n    {\n      \"name\": \"phase-0\"\n    }\n  ]\n}\n","F-03-develop.json":"{\n  \"name\": \"F-03 /develop\",\n  \"nodes\": [\n    {\n      \"parameters\": {\n        \"httpMethod\": \"POST\",\n        \"path\": \"develop\",\n        \"responseMode\": \"lastNode\",\n        \"options\": {}\n      },\n      \"id\": \"webhook-develop\",\n      \"name\": \"Webhook: /develop\",\n      \"type\": \"n8n-nodes-base.webhook\",\n      \"typeVersion\": 1,\n      \"position\": [\n        240,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"jsCode\": \"$workflow.staticData.dagState = { version: $json.body.version, project: $json.body.project, stories: {}, retryCounters: {} };\\nreturn [{ json: { status: 'dag-activated', version: $json.body.version } }];\"\n      },\n      \"id\": \"activate-dag\",\n      \"name\": \"Activate sprint DAG\",\n      \"type\": \"n8n-nodes-base.code\",\n      \"typeVersion\": 2,\n      \"position\": [\n        480,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/spawn-role\",\n        \"sendBody\": true,\n        \"specifyBody\": \"json\",\n        \"jsonBody\": \"={{ JSON.stringify({ role: 'devops-engineer', task: 'gate-A-infra-check', version: $json.body.version, project: $json.body.project }) }}\",\n        \"options\": {}\n      },\n      \"id\": \"spawn-devops-gate-a\",\n      \"name\": \"Spawn DevOps Pod (gate A)\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4,\n      \"position\": [\n        720,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"conditions\": {\n          \"conditions\": [\n            {\n              \"leftValue\": \"={{ $json.exitCode }}\",\n              \"rightValue\": 0,\n              \"operator\": {\n                \"type\": \"number\",\n                \"operation\": \"equals\"\n              }\n            }\n          ]\n        }\n      },\n      \"id\": \"gate-a-check\",\n      \"name\": \"Gate A: infra ready?\",\n      \"type\": \"n8n-nodes-base.if\",\n      \"typeVersion\": 2,\n      \"position\": [\n        960,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/spawn-role\",\n        \"sendBody\": true,\n        \"specifyBody\": \"json\",\n        \"jsonBody\": \"={{ JSON.stringify({ role: 'data-engineer', task: 'gate-B-contracts', version: $json.body.version, project: $json.body.project }) }}\",\n        \"options\": {}\n      },\n      \"id\": \"spawn-de-gate-b\",\n      \"name\": \"Spawn Data Engineer Pod (gate B)\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4,\n      \"position\": [\n        1200,\n        220\n      ]\n    },\n    {\n      \"parameters\": {\n        \"conditions\": {\n          \"conditions\": [\n            {\n              \"leftValue\": \"={{ $json.exitCode }}\",\n              \"rightValue\": 0,\n              \"operator\": {\n                \"type\": \"number\",\n                \"operation\": \"equals\"\n              }\n            }\n          ]\n        }\n      },\n      \"id\": \"gate-b-check\",\n      \"name\": \"Gate B: types ready?\",\n      \"type\": \"n8n-nodes-base.if\",\n      \"typeVersion\": 2,\n      \"position\": [\n        1440,\n        220\n      ]\n    },\n    {\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/spawn-role\",\n        \"sendBody\": true,\n        \"specifyBody\": \"json\",\n        \"jsonBody\": \"={{ JSON.stringify({ role: 'tech-lead', task: 'gate-C-pseudocode', version: $json.body.version, project: $json.body.project }) }}\",\n        \"options\": {}\n      },\n      \"id\": \"spawn-tl-pseudocode\",\n      \"name\": \"Spawn TL Pod (gate C): pseudocode authoring\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4,\n      \"position\": [\n        1680,\n        220\n      ]\n    },\n    {\n      \"parameters\": {\n        \"conditions\": {\n          \"conditions\": [\n            {\n              \"leftValue\": \"={{ $json.exitCode }}\",\n              \"rightValue\": 0,\n              \"operator\": {\n                \"type\": \"number\",\n                \"operation\": \"equals\"\n              }\n            }\n          ]\n        }\n      },\n      \"id\": \"gate-c-check\",\n      \"name\": \"Gate C: all openspec:ready?\",\n      \"type\": \"n8n-nodes-base.if\",\n      \"typeVersion\": 2,\n      \"position\": [\n        1920,\n        220\n      ]\n    },\n    {\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/spawn-role\",\n        \"sendBody\": true,\n        \"specifyBody\": \"json\",\n        \"jsonBody\": \"={{ JSON.stringify({ role: 'backend-developer', task: 'implement', version: $json.body.version, project: $json.body.project }) }}\",\n        \"options\": {}\n      },\n      \"id\": \"spawn-backend-pods\",\n      \"name\": \"Spawn Backend Developer Pods (smol)\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4,\n      \"position\": [\n        2160,\n        100\n      ]\n    },\n    {\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/spawn-role\",\n        \"sendBody\": true,\n        \"specifyBody\": \"json\",\n        \"jsonBody\": \"={{ JSON.stringify({ role: 'frontend-developer', task: 'implement', version: $json.body.version, project: $json.body.project }) }}\",\n        \"options\": {}\n      },\n      \"id\": \"spawn-frontend-pods\",\n      \"name\": \"Spawn Frontend Developer Pods (smol)\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4,\n      \"position\": [\n        2160,\n        240\n      ]\n    },\n    {\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/spawn-role\",\n        \"sendBody\": true,\n        \"specifyBody\": \"json\",\n        \"jsonBody\": \"={{ JSON.stringify({ role: 'qa-engineer', task: 'write-tests', version: $json.body.version, project: $json.body.project }) }}\",\n        \"options\": {}\n      },\n      \"id\": \"spawn-qa-pods\",\n      \"name\": \"Spawn QA Pods (smol)\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4,\n      \"position\": [\n        2160,\n        380\n      ]\n    },\n    {\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/spawn-role\",\n        \"sendBody\": true,\n        \"specifyBody\": \"json\",\n        \"jsonBody\": \"={{ JSON.stringify({ role: 'devops-engineer', task: 'pipeline-config', version: $json.body.version, project: $json.body.project }) }}\",\n        \"options\": {}\n      },\n      \"id\": \"spawn-devops-pods\",\n      \"name\": \"Spawn DevOps Pods (smol)\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4,\n      \"position\": [\n        2160,\n        520\n      ]\n    },\n    {\n      \"parameters\": {\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/f03-infra-fail\",\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"message\",\n              \"value\": \"Gate A failed: DevOps infra not ready\"\n            }\n          ]\n        }\n      },\n      \"id\": \"infra-fail-notify\",\n      \"name\": \"Notify: infra gate A failed\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4,\n      \"position\": [\n        1200,\n        440\n      ]\n    }\n  ],\n  \"connections\": {\n    \"Webhook: /develop\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Activate sprint DAG\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Activate sprint DAG\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Spawn DevOps Pod (gate A)\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Spawn DevOps Pod (gate A)\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Gate A: infra ready?\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Gate A: infra ready?\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Spawn Data Engineer Pod (gate B)\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ],\n        [\n          {\n            \"node\": \"Notify: infra gate A failed\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Spawn Data Engineer Pod (gate B)\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Gate B: types ready?\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Gate B: types ready?\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Spawn TL Pod (gate C): pseudocode authoring\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ],\n        [\n          {\n            \"node\": \"Notify: infra gate A failed\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Spawn TL Pod (gate C): pseudocode authoring\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Gate C: all openspec:ready?\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Gate C: all openspec:ready?\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Spawn Backend Developer Pods (smol)\",\n            \"type\": \"main\",\n            \"index\": 0\n          },\n          {\n            \"node\": \"Spawn Frontend Developer Pods (smol)\",\n            \"type\": \"main\",\n            \"index\": 0\n          },\n          {\n            \"node\": \"Spawn QA Pods (smol)\",\n            \"type\": \"main\",\n            \"index\": 0\n          },\n          {\n            \"node\": \"Spawn DevOps Pods (smol)\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ],\n        [\n          {\n            \"node\": \"Notify: infra gate A failed\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    }\n  },\n  \"active\": true,\n  \"settings\": {\n    \"executionOrder\": \"v1\"\n  },\n  \"tags\": [\n    {\n      \"name\": \"development\"\n    },\n    {\n      \"name\": \"phase-2\"\n    }\n  ]\n}\n","F-04-task-mr-opened.json":"{\n  \"name\": \"F-04 Task MR Opened\",\n  \"nodes\": [\n    {\n      \"parameters\": {\n        \"httpMethod\": \"POST\",\n        \"path\": \"gitlab-mr-opened\",\n        \"responseMode\": \"lastNode\",\n        \"options\": {}\n      },\n      \"id\": \"webhook-mr-open\",\n      \"name\": \"Webhook: GitLab MR opened\",\n      \"type\": \"n8n-nodes-base.webhook\",\n      \"typeVersion\": 1,\n      \"position\": [\n        240,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"conditions\": {\n          \"conditions\": [\n            {\n              \"leftValue\": \"={{ $json.body.object_attributes.source_branch }}\",\n              \"rightValue\": \"task/\",\n              \"operator\": {\n                \"type\": \"string\",\n                \"operation\": \"startsWith\"\n              }\n            }\n          ]\n        }\n      },\n      \"id\": \"filter-task-mr\",\n      \"name\": \"Is task MR?\",\n      \"type\": \"n8n-nodes-base.if\",\n      \"typeVersion\": 2,\n      \"position\": [\n        480,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"jsCode\": \"const mrId = $json.body.object_attributes.iid;\\nconst branch = $json.body.object_attributes.source_branch;\\nconst dag = $workflow.staticData.dagState || {};\\nif (!dag.retryCounters) dag.retryCounters = {};\\ndag.retryCounters[mrId] = 0;\\ndag.openMRs = dag.openMRs || {};\\ndag.openMRs[mrId] = { branch, status: 'open', ciStatus: null, tlStatus: null };\\n$workflow.staticData.dagState = dag;\\nreturn [{ json: { mrId, branch, retryCount: 0 } }];\"\n      },\n      \"id\": \"register-mr-dag\",\n      \"name\": \"Register MR in DAG + init retry counter\",\n      \"type\": \"n8n-nodes-base.code\",\n      \"typeVersion\": 2,\n      \"position\": [\n        720,\n        220\n      ]\n    },\n    {\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/spawn-role\",\n        \"sendBody\": true,\n        \"specifyBody\": \"json\",\n        \"jsonBody\": \"={{ JSON.stringify({ role: 'tech-lead', task: 'mr-review', version: $json.body.version, project: $json.body.project }) }}\",\n        \"options\": {}\n      },\n      \"id\": \"spawn-tl-review\",\n      \"name\": \"Spawn TL Pod: MR review (parallel with CI)\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4,\n      \"position\": [\n        960,\n        160\n      ]\n    },\n    {\n      \"parameters\": {\n        \"url\": \"={{ $env.GITLAB_URL }}/api/v4/projects/{{ $json.body.project.id }}/merge_requests/{{ $json.body.object_attributes.iid }}/pipelines\",\n        \"authentication\": \"predefinedCredentialType\",\n        \"nodeCredentialType\": \"gitlabApi\",\n        \"sendHeaders\": true,\n        \"headerParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"PRIVATE-TOKEN\",\n              \"value\": \"={{ $env.GITLAB_TOKEN }}\"\n            }\n          ]\n        }\n      },\n      \"id\": \"poll-ci-status\",\n      \"name\": \"Poll CI pipeline status\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4,\n      \"position\": [\n        960,\n        360\n      ]\n    },\n    {\n      \"parameters\": {\n        \"conditions\": {\n          \"conditions\": [\n            {\n              \"leftValue\": \"={{ $node['Spawn TL Pod: MR review (parallel with CI)'].json.exitCode }}\",\n              \"rightValue\": 0,\n              \"operator\": {\n                \"type\": \"number\",\n                \"operation\": \"equals\"\n              }\n            },\n            {\n              \"leftValue\": \"={{ $node['Poll CI pipeline status'].json[0].status }}\",\n              \"rightValue\": \"success\",\n              \"operator\": {\n                \"type\": \"string\",\n                \"operation\": \"equals\"\n              }\n            }\n          ]\n        }\n      },\n      \"id\": \"both-pass-check\",\n      \"name\": \"Both CI green AND TL approved?\",\n      \"type\": \"n8n-nodes-base.if\",\n      \"typeVersion\": 2,\n      \"position\": [\n        1200,\n        260\n      ]\n    },\n    {\n      \"parameters\": {\n        \"jsCode\": \"const mrId = $json.body.object_attributes.iid;\\nconst dag = $workflow.staticData.dagState || {};\\nconst count = (dag.retryCounters[mrId] || 0) + 1;\\ndag.retryCounters[mrId] = count;\\n$workflow.staticData.dagState = dag;\\nif (count \u003e= 3) {\\n  return [{ json: { escalate: true, mrId, retryCount: count, reason: 'Max fix attempts reached' } }];\\n}\\nreturn [{ json: { escalate: false, mrId, retryCount: count } }];\"\n      },\n      \"id\": \"increment-retry\",\n      \"name\": \"Increment retry counter\",\n      \"type\": \"n8n-nodes-base.code\",\n      \"typeVersion\": 2,\n      \"position\": [\n        1440,\n        400\n      ]\n    },\n    {\n      \"parameters\": {\n        \"conditions\": {\n          \"conditions\": [\n            {\n              \"leftValue\": \"={{ $json.escalate }}\",\n              \"rightValue\": true,\n              \"operator\": {\n                \"type\": \"boolean\",\n                \"operation\": \"equals\"\n              }\n            }\n          ]\n        }\n      },\n      \"id\": \"escalate-or-feedback\",\n      \"name\": \"Escalate or feedback to developer?\",\n      \"type\": \"n8n-nodes-base.if\",\n      \"typeVersion\": 2,\n      \"position\": [\n        1680,\n        400\n      ]\n    },\n    {\n      \"parameters\": {\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/escalate\",\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"flow\",\n              \"value\": \"F-04\"\n            },\n            {\n              \"name\": \"reason\",\n              \"value\": \"Max retries on MR\"\n            },\n            {\n              \"name\": \"mr_id\",\n              \"value\": \"={{ $json.mrId }}\"\n            }\n          ]\n        }\n      },\n      \"id\": \"escalate-edward\",\n      \"name\": \"Escalate to Edward (/escalate F-25)\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4,\n      \"position\": [\n        1920,\n        340\n      ]\n    },\n    {\n      \"parameters\": {\n        \"command\": \"=echo 'Developer fix required — reads CI log or TL inline comments, fixes code, pushes to branch' \u0026\u0026 glab mr comment {{ $json.body.object_attributes.iid }} --message 'Fix required: CI or TL review needs attention. Please review comments and push a fix.'\"\n      },\n      \"id\": \"feedback-developer\",\n      \"name\": \"Feedback to developer: fix + push\",\n      \"type\": \"n8n-nodes-base.executeCommand\",\n      \"typeVersion\": 1,\n      \"position\": [\n        1920,\n        480\n      ]\n    },\n    {\n      \"parameters\": {\n        \"command\": \"=glab mr merge {{ $json.body.object_attributes.iid }} --auto-merge --squash-message '[task] GL-{{ $json.body.object_attributes.iid }} merged by Tech Lead' \u0026\u0026 glab mr comment {{ $json.body.object_attributes.iid }} --message 'Merged by Tech Lead. CI green + TL approved.'\"\n      },\n      \"id\": \"tl-merges-mr\",\n      \"name\": \"Tech Lead merges task MR\",\n      \"type\": \"n8n-nodes-base.executeCommand\",\n      \"typeVersion\": 1,\n      \"position\": [\n        1440,\n        160\n      ]\n    },\n    {\n      \"parameters\": {\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/gitlab-mr-merged\",\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"mr_id\",\n              \"value\": \"={{ $json.body.object_attributes.iid }}\"\n            },\n            {\n              \"name\": \"flow\",\n              \"value\": \"F-04-trigger-F-05\"\n            }\n          ]\n        }\n      },\n      \"id\": \"trigger-f05\",\n      \"name\": \"Trigger F-05: MR merged\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4,\n      \"position\": [\n        1680,\n        160\n      ]\n    }\n  ],\n  \"connections\": {\n    \"Webhook: GitLab MR opened\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Is task MR?\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Is task MR?\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Register MR in DAG + init retry counter\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Register MR in DAG + init retry counter\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Spawn TL Pod: MR review (parallel with CI)\",\n            \"type\": \"main\",\n            \"index\": 0\n          },\n          {\n            \"node\": \"Poll CI pipeline status\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Spawn TL Pod: MR review (parallel with CI)\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Both CI green AND TL approved?\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Poll CI pipeline status\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Both CI green AND TL approved?\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Both CI green AND TL approved?\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Tech Lead merges task MR\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ],\n        [\n          {\n            \"node\": \"Increment retry counter\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Tech Lead merges task MR\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Trigger F-05: MR merged\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Increment retry counter\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Escalate or feedback to developer?\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Escalate or feedback to developer?\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Escalate to Edward (/escalate F-25)\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ],\n        [\n          {\n            \"node\": \"Feedback to developer: fix + push\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    }\n  },\n  \"active\": true,\n  \"settings\": {\n    \"executionOrder\": \"v1\"\n  },\n  \"tags\": [\n    {\n      \"name\": \"development\"\n    },\n    {\n      \"name\": \"phase-2\"\n    }\n  ]\n}\n","F-05-task-mr-merged.json":"{\n  \"name\": \"F-05 Task MR Merged\",\n  \"nodes\": [\n    { \"parameters\": { \"httpMethod\": \"POST\", \"path\": \"gitlab-mr-merged\", \"responseMode\": \"lastNode\", \"options\": {} }, \"id\": \"webhook-mr-merged\", \"name\": \"Webhook: GitLab MR merged\", \"type\": \"n8n-nodes-base.webhook\", \"typeVersion\": 1, \"position\": [240, 300] },\n    { \"parameters\": { \"jsCode\": \"const dag = $workflow.staticData.dagState || {};\\nconst mrId = $json.body.mr_id || $json.body.object_attributes?.iid;\\nif (dag.openMRs \u0026\u0026 dag.openMRs[mrId]) {\\n  dag.openMRs[mrId].status = 'merged';\\n}\\n$workflow.staticData.dagState = dag;\\nconst storyId = $json.body.story_id;\\nconst allTasksMerged = Object.values(dag.openMRs || {}).filter(mr =\u003e mr.storyId === storyId).every(mr =\u003e mr.status === 'merged');\\nreturn [{ json: { mrId, storyId, allTasksMerged, dag } }];\" }, \"id\": \"update-dag\", \"name\": \"Update DAG: task marked complete\", \"type\": \"n8n-nodes-base.code\", \"typeVersion\": 2, \"position\": [480, 300] },\n    { \"parameters\": { \"conditions\": { \"conditions\": [{ \"leftValue\": \"={{ $json.allTasksMerged }}\", \"rightValue\": true, \"operator\": { \"type\": \"boolean\", \"operation\": \"equals\" } }] } }, \"id\": \"all-tasks-check\", \"name\": \"All story tasks merged?\", \"type\": \"n8n-nodes-base.if\", \"typeVersion\": 2, \"position\": [720, 300] },\n    { \"parameters\": { \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/dod-check\", \"sendBody\": true, \"bodyParameters\": { \"parameters\": [{ \"name\": \"story_id\", \"value\": \"={{ $json.storyId }}\" }, { \"name\": \"flow\", \"value\": \"F-05-trigger-F-06\" }] } }, \"id\": \"trigger-f06\", \"name\": \"Trigger F-06: DoD check\", \"type\": \"n8n-nodes-base.httpRequest\", \"typeVersion\": 4, \"position\": [960, 200] },\n    { \"parameters\": { \"jsCode\": \"return [{ json: { status: 'waiting', message: 'Other story tasks still in progress' } }];\" }, \"id\": \"wait-other-tasks\", \"name\": \"Wait: other tasks still in progress\", \"type\": \"n8n-nodes-base.code\", \"typeVersion\": 2, \"position\": [960, 400] }\n  ],\n  \"connections\": {\n    \"Webhook: GitLab MR merged\": { \"main\": [[{ \"node\": \"Update DAG: task marked complete\", \"type\": \"main\", \"index\": 0 }]] },\n    \"Update DAG: task marked complete\": { \"main\": [[{ \"node\": \"All story tasks merged?\", \"type\": \"main\", \"index\": 0 }]] },\n    \"All story tasks merged?\": { \"main\": [[{ \"node\": \"Trigger F-06: DoD check\", \"type\": \"main\", \"index\": 0 }], [{ \"node\": \"Wait: other tasks still in progress\", \"type\": \"main\", \"index\": 0 }]] }\n  },\n  \"active\": true, \"settings\": { \"executionOrder\": \"v1\" },\n  \"tags\": [{ \"name\": \"development\" }, { \"name\": \"phase-2\" }]\n}\n","F-06-dod-check.json":"{\n  \"name\": \"F-06 DoD Check\",\n  \"nodes\": [\n    {\n      \"parameters\": {\n        \"httpMethod\": \"POST\",\n        \"path\": \"dod-check\",\n        \"responseMode\": \"lastNode\",\n        \"options\": {}\n      },\n      \"id\": \"webhook-dod\",\n      \"name\": \"Webhook: DoD check trigger\",\n      \"type\": \"n8n-nodes-base.webhook\",\n      \"typeVersion\": 1,\n      \"position\": [\n        240,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/spawn-role\",\n        \"sendBody\": true,\n        \"specifyBody\": \"json\",\n        \"jsonBody\": \"={{ JSON.stringify({ role: 'tech-lead', task: 'dod-check', version: $json.body.version, project: $json.body.project }) }}\",\n        \"options\": {}\n      },\n      \"id\": \"spawn-tl-dod\",\n      \"name\": \"Spawn TL Pod: DoD check (smart model)\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4,\n      \"position\": [\n        480,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"conditions\": {\n          \"conditions\": [\n            {\n              \"leftValue\": \"={{ $json.exitCode }}\",\n              \"rightValue\": 0,\n              \"operator\": {\n                \"type\": \"number\",\n                \"operation\": \"equals\"\n              }\n            }\n          ]\n        }\n      },\n      \"id\": \"dod-pass\",\n      \"name\": \"DoD satisfied?\",\n      \"type\": \"n8n-nodes-base.if\",\n      \"typeVersion\": 2,\n      \"position\": [\n        720,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/story-mr-open\",\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"story_id\",\n              \"value\": \"={{ $json.body.story_id }}\"\n            },\n            {\n              \"name\": \"flow\",\n              \"value\": \"F-06-trigger-F-07\"\n            }\n          ]\n        }\n      },\n      \"id\": \"trigger-f07\",\n      \"name\": \"Trigger F-07: open story MR\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4,\n      \"position\": [\n        960,\n        200\n      ]\n    },\n    {\n      \"parameters\": {\n        \"jsCode\": \"const dag = $workflow.staticData.dagState || {};\\nconst retries = dag.dodRetries || {};\\nconst storyId = $json.body.story_id;\\nretries[storyId] = (retries[storyId] || 0) + 1;\\ndag.dodRetries = retries;\\n$workflow.staticData.dagState = dag;\\nreturn [{ json: { escalate: retries[storyId] \u003e= 3, retryCount: retries[storyId], storyId } }];\"\n      },\n      \"id\": \"dod-fail-counter\",\n      \"name\": \"DoD fail: feedback developer + re-trigger F-04\",\n      \"type\": \"n8n-nodes-base.code\",\n      \"typeVersion\": 2,\n      \"position\": [\n        960,\n        400\n      ]\n    },\n    {\n      \"parameters\": {\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/gitlab-mr-opened\",\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"story_id\",\n              \"value\": \"={{ $json.storyId }}\"\n            },\n            {\n              \"name\": \"reason\",\n              \"value\": \"DoD failed — re-triggers F-04 review cycle\"\n            }\n          ]\n        }\n      },\n      \"id\": \"retrigger-f04\",\n      \"name\": \"Re-trigger F-04: CI + TL review cycle\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4,\n      \"position\": [\n        1200,\n        400\n      ]\n    }\n  ],\n  \"connections\": {\n    \"Webhook: DoD check trigger\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Spawn TL Pod: DoD check (smart model)\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Spawn TL Pod: DoD check (smart model)\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"DoD satisfied?\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"DoD satisfied?\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Trigger F-07: open story MR\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ],\n        [\n          {\n            \"node\": \"DoD fail: feedback developer + re-trigger F-04\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"DoD fail: feedback developer + re-trigger F-04\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Re-trigger F-04: CI + TL review cycle\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    }\n  },\n  \"active\": true,\n  \"settings\": {\n    \"executionOrder\": \"v1\"\n  },\n  \"tags\": [\n    {\n      \"name\": \"development\"\n    },\n    {\n      \"name\": \"phase-2\"\n    }\n  ]\n}\n","F-07-flow.json":"{\n  \"name\": \"F-07 Story MR Opened\",\n  \"nodes\": [\n    {\n      \"parameters\": {\n        \"httpMethod\": \"POST\",\n        \"path\": \"story-mr-open\",\n        \"responseMode\": \"lastNode\",\n        \"options\": {}\n      },\n      \"id\": \"webhook-story-mr\",\n      \"name\": \"Webhook: story MR open trigger\",\n      \"type\": \"n8n-nodes-base.webhook\",\n      \"typeVersion\": 1,\n      \"position\": [\n        240,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"command\": \"=echo '{\\\"role\\\":\\\"tech-lead\\\",\\\"task\\\":\\\"open-story-mr\\\",\\\"story_id\\\":\\\"{{ $json.body.story_id }}\\\",\\\"version\\\":\\\"{{ $json.body.version }}\\\",\\\"project\\\":\\\"{{ $json.body.project }}\\\"}' \u003e /tmp/story-mr.json \u0026\u0026 omp -p \\\"$(cat /tmp/story-mr.json)\\\"\"\n      },\n      \"id\": \"tl-opens-story-mr\",\n      \"name\": \"TL opens [story] MR per repo (omp+glab)\",\n      \"type\": \"n8n-nodes-base.executeCommand\",\n      \"typeVersion\": 1,\n      \"position\": [\n        480,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"command\": \"=echo 'CI fires on story MR - builds rc images and deploys to QA cluster' \u0026\u0026 sleep 30\"\n      },\n      \"id\": \"wait-qa-deploy\",\n      \"name\": \"Wait: CI deploys rc images to QA cluster\",\n      \"type\": \"n8n-nodes-base.executeCommand\",\n      \"typeVersion\": 1,\n      \"position\": [\n        720,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/spawn-role\",\n        \"sendBody\": true,\n        \"specifyBody\": \"json\",\n        \"jsonBody\": \"={{ JSON.stringify({ role: 'qa-engineer', task: 'story-testing', version: $json.body.version, project: $json.body.project }) }}\",\n        \"options\": {}\n      },\n      \"id\": \"spawn-qa-story\",\n      \"name\": \"Spawn QA Pod: story-level testing\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4,\n      \"position\": [\n        960,\n        200\n      ]\n    },\n    {\n      \"parameters\": {\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/f07-notify-edward\",\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"message\",\n              \"value\": \"Story MR ready for your review\"\n            },\n            {\n              \"name\": \"story_id\",\n              \"value\": \"={{ $json.body.story_id }}\"\n            }\n          ]\n        }\n      },\n      \"id\": \"notify-edward-story-mr\",\n      \"name\": \"Notify Edward: story MR ready for review\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4,\n      \"position\": [\n        960,\n        400\n      ]\n    }\n  ],\n  \"connections\": {\n    \"Webhook: story MR open trigger\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"TL opens [story] MR per repo (omp+glab)\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"TL opens [story] MR per repo (omp+glab)\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Wait: CI deploys rc images to QA cluster\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Wait: CI deploys rc images to QA cluster\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Spawn QA Pod: story-level testing\",\n            \"type\": \"main\",\n            \"index\": 0\n          },\n          {\n            \"node\": \"Notify Edward: story MR ready for review\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    }\n  },\n  \"active\": true,\n  \"settings\": {\n    \"executionOrder\": \"v1\"\n  },\n  \"tags\": [\n    {\n      \"name\": \"development\"\n    },\n    {\n      \"name\": \"phase-2\"\n    }\n  ]\n}\n","F-08-flow.json":"{\n  \"name\": \"F-08 Story MR Merged\",\n  \"nodes\": [\n    { \"parameters\": { \"httpMethod\": \"POST\", \"path\": \"story-mr-merged\", \"responseMode\": \"lastNode\", \"options\": {} }, \"id\": \"webhook-story-merged\", \"name\": \"Webhook: story MR merged by Edward\", \"type\": \"n8n-nodes-base.webhook\", \"typeVersion\": 1, \"position\": [240, 300] },\n    { \"parameters\": { \"command\": \"=glab issue update {{ $json.body.story_id }} --label-add 'merged-to-release' \u0026\u0026 glab issue close {{ $json.body.story_id }} --message 'Merged by Edward on {{ new Date().toISOString() }}. Story complete.'\" }, \"id\": \"close-story-ticket\", \"name\": \"Close story ticket + label merged-to-release\", \"type\": \"n8n-nodes-base.executeCommand\", \"typeVersion\": 1, \"position\": [480, 160] },\n    { \"parameters\": { \"command\": \"=echo 'Close all child task tickets for story {{ $json.body.story_id }}' \u0026\u0026 glab issue list --label 'type:task' --milestone '{{ $json.body.version }}' | grep 'GL-{{ $json.body.story_id }}' | awk '{print $1}' | xargs -I{} glab issue close {} --label-add released\" }, \"id\": \"close-child-tasks\", \"name\": \"Close all child task tickets\", \"type\": \"n8n-nodes-base.executeCommand\", \"typeVersion\": 1, \"position\": [480, 280] },\n    { \"parameters\": { \"command\": \"=glab issue comment {{ $json.body.release_ticket_id }} --message 'Story GL-{{ $json.body.story_id }} merged to release. Deployment log entry: {{ new Date().toISOString() }}'\" }, \"id\": \"update-release-ticket\", \"name\": \"Update release ticket: deployment log\", \"type\": \"n8n-nodes-base.executeCommand\", \"typeVersion\": 1, \"position\": [480, 400] },\n    { \"parameters\": { \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/cluster-sleep\", \"sendBody\": true, \"bodyParameters\": { \"parameters\": [{ \"name\": \"cluster\", \"value\": \"qa\" }, { \"name\": \"story_id\", \"value\": \"={{ $json.body.story_id }}\" }] } }, \"id\": \"sleep-qa-cluster\", \"name\": \"Sleep QA cluster for this story (F-27)\", \"type\": \"n8n-nodes-base.httpRequest\", \"typeVersion\": 4, \"position\": [480, 520] },\n    { \"parameters\": { \"jsCode\": \"const dag = $workflow.staticData.dagState || {};\\nconst version = $json.body.version;\\ndag.mergedStories = dag.mergedStories || [];\\ndag.mergedStories.push($json.body.story_id);\\n$workflow.staticData.dagState = dag;\\nconst allStories = dag.totalStories || 0;\\nconst merged = dag.mergedStories.length;\\nreturn [{ json: { allMerged: merged \u003e= allStories, merged, total: allStories, version } }];\" }, \"id\": \"check-all-stories\", \"name\": \"All stories merged to release?\", \"type\": \"n8n-nodes-base.code\", \"typeVersion\": 2, \"position\": [720, 340] },\n    { \"parameters\": { \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/f08-notify-uat-ready\", \"sendBody\": true, \"bodyParameters\": { \"parameters\": [{ \"name\": \"message\", \"value\": \"All stories merged. Ready for /uat\" }, { \"name\": \"version\", \"value\": \"={{ $json.version }}\" }] } }, \"id\": \"notify-uat-ready\", \"name\": \"Notify Edward: all stories merged, ready for /uat\", \"type\": \"n8n-nodes-base.httpRequest\", \"typeVersion\": 4, \"position\": [960, 260] }\n  ],\n  \"connections\": {\n    \"Webhook: story MR merged by Edward\": { \"main\": [[{ \"node\": \"Close story ticket + label merged-to-release\", \"type\": \"main\", \"index\": 0 }, { \"node\": \"Close all child task tickets\", \"type\": \"main\", \"index\": 0 }, { \"node\": \"Update release ticket: deployment log\", \"type\": \"main\", \"index\": 0 }, { \"node\": \"Sleep QA cluster for this story (F-27)\", \"type\": \"main\", \"index\": 0 }]] },\n    \"Close story ticket + label merged-to-release\": { \"main\": [[{ \"node\": \"All stories merged to release?\", \"type\": \"main\", \"index\": 0 }]] },\n    \"Close all child task tickets\": { \"main\": [[{ \"node\": \"All stories merged to release?\", \"type\": \"main\", \"index\": 0 }]] },\n    \"Update release ticket: deployment log\": { \"main\": [[{ \"node\": \"All stories merged to release?\", \"type\": \"main\", \"index\": 0 }]] },\n    \"Sleep QA cluster for this story (F-27)\": { \"main\": [[{ \"node\": \"All stories merged to release?\", \"type\": \"main\", \"index\": 0 }]] },\n    \"All stories merged to release?\": { \"main\": [[{ \"node\": \"Notify Edward: all stories merged, ready for /uat\", \"type\": \"main\", \"index\": 0 }]] }\n  },\n  \"active\": true, \"settings\": { \"executionOrder\": \"v1\" },\n  \"tags\": [{ \"name\": \"development\" }, { \"name\": \"phase-2\" }]\n}\n","F-09-flow.json":"{\n  \"name\": \"F-09 Version Built (CI Webhook)\",\n  \"nodes\": [\n    { \"parameters\": { \"httpMethod\": \"POST\", \"path\": \"ci-version-built\", \"responseMode\": \"lastNode\", \"options\": {} }, \"id\": \"webhook-ci-built\", \"name\": \"Webhook: CI image build complete\", \"type\": \"n8n-nodes-base.webhook\", \"typeVersion\": 1, \"position\": [240, 300] },\n    { \"parameters\": { \"jsCode\": \"const dag = $workflow.staticData.dagState || {};\\ndag.builtImages = dag.builtImages || {};\\ndag.builtImages[$json.body.service] = { rcTag: $json.body.rc_tag, image: $json.body.image, builtAt: new Date().toISOString() };\\n$workflow.staticData.dagState = dag;\\nreturn [{ json: { status: 'state-updated', service: $json.body.service, rcTag: $json.body.rc_tag, message: 'ArgoCD Image Updater handles SIT deploy automatically' } }];\" }, \"id\": \"update-image-state\", \"name\": \"Update n8n state: rc image built (state only)\", \"type\": \"n8n-nodes-base.code\", \"typeVersion\": 2, \"position\": [480, 300] }\n  ],\n  \"connections\": {\n    \"Webhook: CI image build complete\": { \"main\": [[{ \"node\": \"Update n8n state: rc image built (state only)\", \"type\": \"main\", \"index\": 0 }]] }\n  },\n  \"active\": true, \"settings\": { \"executionOrder\": \"v1\" },\n  \"tags\": [{ \"name\": \"development\" }, { \"name\": \"phase-2\" }]\n}\n","F-10-uat.json":"{\n  \"name\": \"F-10 /uat\",\n  \"nodes\": [\n    { \"parameters\": { \"httpMethod\": \"POST\", \"path\": \"uat\", \"responseMode\": \"lastNode\", \"options\": {} }, \"id\": \"webhook-uat\", \"name\": \"Webhook: /uat command\", \"type\": \"n8n-nodes-base.webhook\", \"typeVersion\": 1, \"position\": [240, 300] },\n    { \"parameters\": { \"url\": \"={{ $env.GITLAB_URL }}/api/v4/projects/{{ $json.body.project_id }}/issues?milestone={{ $json.body.version }}\u0026labels=type:user-story\u0026per_page=100\", \"authentication\": \"predefinedCredentialType\", \"nodeCredentialType\": \"gitlabApi\", \"sendHeaders\": true, \"headerParameters\": { \"parameters\": [{ \"name\": \"PRIVATE-TOKEN\", \"value\": \"={{ $env.GITLAB_TOKEN }}\" }] } }, \"id\": \"query-milestone-stories\", \"name\": \"Safeguard: query sprint milestone for all stories\", \"type\": \"n8n-nodes-base.httpRequest\", \"typeVersion\": 4, \"position\": [480, 300] },\n    { \"parameters\": { \"jsCode\": \"const stories = $json;\\nconst unmerged = stories.filter(s =\u003e !s.labels.includes('merged-to-release'));\\nif (unmerged.length \u003e 0) {\\n  return [{ json: { safe: false, unmergedStories: unmerged.map(s =\u003e ({ id: s.iid, title: s.title })), count: unmerged.length } }];\\n}\\nreturn [{ json: { safe: true, totalStories: stories.length } }];\" }, \"id\": \"check-all-merged\", \"name\": \"Check: all stories have merged-to-release label?\", \"type\": \"n8n-nodes-base.code\", \"typeVersion\": 2, \"position\": [720, 300] },\n    { \"parameters\": { \"conditions\": { \"conditions\": [{ \"leftValue\": \"={{ $json.safe }}\", \"rightValue\": true, \"operator\": { \"type\": \"boolean\", \"operation\": \"equals\" } }] } }, \"id\": \"safeguard-gate\", \"name\": \"Safeguard: all stories merged?\", \"type\": \"n8n-nodes-base.if\", \"typeVersion\": 2, \"position\": [960, 300] },\n    { \"parameters\": { \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/f10-feedback\", \"sendBody\": true, \"bodyParameters\": { \"parameters\": [{ \"name\": \"message\", \"value\": \"UAT blocked: unfinished stories\" }, { \"name\": \"unmerged\", \"value\": \"={{ JSON.stringify($json.unmergedStories) }}\" }] } }, \"id\": \"feedback-unfinished\", \"name\": \"Feedback to Edward: unfinished stories\", \"type\": \"n8n-nodes-base.httpRequest\", \"typeVersion\": 4, \"position\": [1200, 440] },\n    { \"parameters\": { \"url\": \"={{ $env.GITLAB_URL }}/api/v4/projects/{{ $json.body.project_id }}/pipelines\", \"sendBody\": true, \"bodyParameters\": { \"parameters\": [{ \"name\": \"ref\", \"value\": \"={{ 'release/' + $json.body.version }}\" }, { \"name\": \"variables[DEPLOY_ENV]\", \"value\": \"uat\" }] }, \"authentication\": \"predefinedCredentialType\", \"nodeCredentialType\": \"gitlabApi\", \"sendHeaders\": true, \"headerParameters\": { \"parameters\": [{ \"name\": \"PRIVATE-TOKEN\", \"value\": \"={{ $env.GITLAB_TOKEN }}\" }] } }, \"id\": \"trigger-manual-pipeline\", \"name\": \"Trigger manual CI pipeline on release branch\", \"type\": \"n8n-nodes-base.httpRequest\", \"typeVersion\": 4, \"position\": [1200, 200] },\n    { \"parameters\": { \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/cluster-wake\", \"sendBody\": true, \"bodyParameters\": { \"parameters\": [{ \"name\": \"cluster\", \"value\": \"uat\" }, { \"name\": \"version\", \"value\": \"={{ $json.body.version }}\" }] } }, \"id\": \"wake-uat-cluster\", \"name\": \"Wake UAT cluster (F-27)\", \"type\": \"n8n-nodes-base.httpRequest\", \"typeVersion\": 4, \"position\": [1440, 200] },\n    { \"parameters\": { \"command\": \"=echo 'ArgoCD sync UAT with rc images from pipeline detect-versions output'\" }, \"id\": \"argocd-sync-uat\", \"name\": \"ArgoCD sync: changed services with rc tags\", \"type\": \"n8n-nodes-base.executeCommand\", \"typeVersion\": 1, \"position\": [1680, 200] },\n    { \"parameters\": { \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/uat-qa-start\", \"sendBody\": true, \"bodyParameters\": { \"parameters\": [{ \"name\": \"version\", \"value\": \"={{ $json.body.version }}\" }, { \"name\": \"project\", \"value\": \"={{ $json.body.project }}\" }] } }, \"id\": \"trigger-f11\", \"name\": \"Create QA Pod: UAT stage 1 (F-11)\", \"type\": \"n8n-nodes-base.httpRequest\", \"typeVersion\": 4, \"position\": [1920, 200]