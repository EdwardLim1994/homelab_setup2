{"version":4,"terraform_version":"1.12.5","serial":200,"lineage":"2eb2a68f-aff6-6eea-5b8c-5d0b6fe33403","outputs":{},"resources":[{"mode":"data","type":"kubernetes_secret","name":"homelab_ca","provider":"provider[\"registry.opentofu.org/hashicorp/kubernetes\"]","instances":[{"schema_version":0,"attributes":{"binary_data":null,"data":{"ca.crt":"-----BEGIN CERTIFICATE-----\nMIIBbzCCARSgAwIBAgIUYF8nyIed6sZrj4s5pXhFwIyRe9wwCgYIKoZIzj0EAwIw\nFTETMBEGA1UEAxMKaG9tZWxhYi1jYTAeFw0yNjA5MDIwNzQ2MzZaFw0yNjEyMDEw\nNzQ2MzZaMBUxEzARBgNVBAMTCmhvbWVsYWItY2EwWTATBgcqhkjOPQIBBggqhkjO\nPQMBBwNCAAT3B9EUtUUJIhzDMNFfrnfhQRk8TDPTj4msPZghM6LUkbAKD06QdEiu\nYT5CNbJtbHcmdILxb203USpBr1r/RgUFo0IwQDAOBgNVHQ8BAf8EBAMCAqQwDwYD\nVR0TAQH/BAUwAwEB/zAdBgNVHQ4EFgQU99ru2debr6CvdOODcfc5q+feqOgwCgYI\nKoZIzj0EAwIDSQAwRgIhAM0vqtLmMRYbxC/vscftpEd+CG7Q9eUSbheGZCQ5D5uP\nAiEAiDv1llUutYF1hmgHetWnpP4fXJFKHWl0h41fmDeucFc=\n-----END CERTIFICATE-----\n","tls.crt":"-----BEGIN CERTIFICATE-----\nMIIBbzCCARSgAwIBAgIUYF8nyIed6sZrj4s5pXhFwIyRe9wwCgYIKoZIzj0EAwIw\nFTETMBEGA1UEAxMKaG9tZWxhYi1jYTAeFw0yNjA5MDIwNzQ2MzZaFw0yNjEyMDEw\nNzQ2MzZaMBUxEzARBgNVBAMTCmhvbWVsYWItY2EwWTATBgcqhkjOPQIBBggqhkjO\nPQMBBwNCAAT3B9EUtUUJIhzDMNFfrnfhQRk8TDPTj4msPZghM6LUkbAKD06QdEiu\nYT5CNbJtbHcmdILxb203USpBr1r/RgUFo0IwQDAOBgNVHQ8BAf8EBAMCAqQwDwYD\nVR0TAQH/BAUwAwEB/zAdBgNVHQ4EFgQU99ru2debr6CvdOODcfc5q+feqOgwCgYI\nKoZIzj0EAwIDSQAwRgIhAM0vqtLmMRYbxC/vscftpEd+CG7Q9eUSbheGZCQ5D5uP\nAiEAiDv1llUutYF1hmgHetWnpP4fXJFKHWl0h41fmDeucFc=\n-----END CERTIFICATE-----\n","tls.key":"-----BEGIN EC PRIVATE KEY-----\nMHcCAQEEIKsORJtTf7BgmwOEE317oIpjPgngT11UNIZRxntQvQbcoAoGCCqGSM49\nAwEHoUQDQgAE9wfRFLVFCSIcwzDRX6534UEZPEwz04+JrD2YITOi1JGwCg9OkHRI\nrmE+QjWybWx3JnSC8W9tN1EqQa9a/0YFBQ==\n-----END EC PRIVATE KEY-----\n"},"id":"cert-manager/homelab-ca-secret","immutable":false,"metadata":[{"annotations":{"cert-manager.io/alt-names":"","cert-manager.io/certificate-name":"homelab-ca","cert-manager.io/common-name":"homelab-ca","cert-manager.io/ip-sans":"","cert-manager.io/issuer-group":"cert-manager.io","cert-manager.io/issuer-kind":"ClusterIssuer","cert-manager.io/issuer-name":"selfsigned-bootstrap","cert-manager.io/uri-sans":""},"generate_name":"","generation":0,"labels":{"controller.cert-manager.io/fao":"true"},"name":"homelab-ca-secret","namespace":"cert-manager","resource_version":"4862","uid":"341398a9-aa74-4418-8419-41f548fad1d7"}],"type":"kubernetes.io/tls"},"sensitive_attributes":[]}]},{"mode":"managed","type":"helm_release","name":"ansible","provider":"provider[\"registry.opentofu.org/hashicorp/helm\"]","instances":[{"schema_version":1,"attributes":{"atomic":false,"chart":"./../helm/ansible","cleanup_on_fail":false,"create_namespace":false,"dependency_update":false,"description":null,"devel":null,"disable_crd_hooks":false,"disable_openapi_validation":false,"disable_webhooks":false,"force_update":false,"id":"ansible","keyring":null,"lint":false,"manifest":null,"max_history":0,"metadata":[{"app_version":"","chart":"ansible","first_deployed":1788334133,"last_deployed":1788485876,"name":"ansible","namespace":"ansible","notes":"","revision":5,"values":"{\"chartHash\":\"6bc2593d9b87c250ba595db7dd76b1fc349853ad\"}","version":"0.1.0"}],"name":"ansible","namespace":"ansible","pass_credentials":false,"postrender":[],"recreate_pods":false,"render_subchart_notes":true,"replace":false,"repository":null,"repository_ca_file":null,"repository_cert_file":null,"repository_key_file":null,"repository_password":null,"repository_username":null,"reset_values":false,"reuse_values":false,"set":[{"name":"chartHash","type":"","value":"6bc2593d9b87c250ba595db7dd76b1fc349853ad"}],"set_list":[],"set_sensitive":[],"skip_crds":false,"status":"deployed","timeout":300,"upgrade_install":null,"values":null,"verify":false,"version":"0.1.0","wait":false,"wait_for_jobs":false},"sensitive_attributes":[[{"type":"get_attr","value":"repository_password"}]],"private":"eyJzY2hlbWFfdmVyc2lvbiI6IjEifQ==","dependencies":["kubernetes_config_map.ansible_n8n_flows","kubernetes_namespace.ansible","kubernetes_secret.ansible_secrets"]}]},{"mode":"managed","type":"helm_release","name":"argocd","provider":"provider[\"registry.opentofu.org/hashicorp/helm\"]","instances":[{"schema_version":1,"attributes":{"atomic":false,"chart":"./../helm/argocd","cleanup_on_fail":false,"create_namespace":false,"dependency_update":true,"description":null,"devel":null,"disable_crd_hooks":false,"disable_openapi_validation":false,"disable_webhooks":false,"force_update":false,"id":"argocd","keyring":null,"lint":false,"manifest":null,"max_history":0,"metadata":[{"app_version":"","chart":"argocd","first_deployed":1788334128,"last_deployed":1788351909,"name":"argocd","namespace":"argocd","notes":"In order to access the server UI you have the following options:\n\n1. kubectl port-forward service/argocd-server -n argocd 8080:443\n\n    and then open the browser on http://localhost:8080 and accept the certificate\n\n2. enable ingress in the values file `server.ingress.enabled` and either\n      - Add the annotation for ssl passthrough: https://argo-cd.readthedocs.io/en/stable/operator-manual/ingress/#option-1-ssl-passthrough\n      - Set the `configs.params.\"server.insecure\"` in the values file and terminate SSL at your ingress: https://argo-cd.readthedocs.io/en/stable/operator-manual/ingress/#option-2-multiple-ingress-objects-and-hosts\n\n\nAfter reaching the UI the first time you can login with username: admin and the random password generated during the installation. You can find the password by running:\n\nkubectl -n argocd get secret argocd-initial-admin-secret -o jsonpath=\"{.data.password}\" | base64 -d\n\n(You should delete the initial secret afterwards as suggested by the Getting Started Guide: https://argo-cd.readthedocs.io/en/stable/getting_started/#4-login-using-the-cli)\n","revision":2,"values":"{\"argo-cd\":{\"applicationSet\":{\"resources\":{\"limits\":{\"memory\":\"128Mi\"},\"requests\":{\"cpu\":\"10m\",\"memory\":\"64Mi\"}}},\"configs\":{\"cm\":{\"oidc.config\":\"name: Authentik\\nissuer: https://authentik.tail60240b.ts.net/application/o/argocd/\\nclientID: dev-argocd-oidc-client-id\\nclientSecret: dev-argocd-oidc-client-secret-not-for-prod-use\\nrequestedScopes:\\n  - openid\\n  - profile\\n  - email\\n\",\"url\":\"https://argocd.tail60240b.ts.net\"},\"params\":{\"server.insecure\":true},\"rbac\":{\"policy.csv\":\"g, edwardlimkoksiong1994@gmail.com, role:admin\\n\",\"policy.default\":\"role:readonly\",\"scopes\":\"[email]\"}},\"controller\":{\"resources\":{\"limits\":{\"memory\":\"512Mi\"},\"requests\":{\"cpu\":\"50m\",\"memory\":\"256Mi\"}}},\"dex\":{\"enabled\":false},\"notifications\":{\"enabled\":false},\"redis\":{\"resources\":{\"limits\":{\"memory\":\"128Mi\"},\"requests\":{\"cpu\":\"10m\",\"memory\":\"64Mi\"}}},\"repoServer\":{\"resources\":{\"limits\":{\"memory\":\"256Mi\"},\"requests\":{\"cpu\":\"50m\",\"memory\":\"128Mi\"}}},\"server\":{\"ingress\":{\"annotations\":{\"cert-manager.io/cluster-issuer\":\"homelab-ca-issuer\"},\"enabled\":true,\"hosts\":[\"argocd.local\"],\"ingressClassName\":\"traefik\",\"tls\":[{\"hosts\":[\"argocd.local\"],\"secretName\":\"argocd.local-tls\"}]},\"resources\":{\"limits\":{\"memory\":\"256Mi\"},\"requests\":{\"cpu\":\"50m\",\"memory\":\"128Mi\"}}}}}","version":"0.1.0"}],"name":"argocd","namespace":"argocd","pass_credentials":false,"postrender":[],"recreate_pods":false,"render_subchart_notes":true,"replace":false,"repository":null,"repository_ca_file":null,"repository_cert_file":null,"repository_key_file":null,"repository_password":null,"repository_username":null,"reset_values":false,"reuse_values":false,"set":[],"set_list":[],"set_sensitive":[],"skip_crds":false,"status":"deployed","timeout":600,"upgrade_install":null,"values":["argo-cd:\n  # ponytail: Dex is an OIDC proxy that ArgoCD bundles for providers that\n  # don't support OIDC natively. Authentik speaks OIDC directly, so Dex is\n  # dead weight here.\n  dex:\n    enabled: false\n\n  # ponytail: notifications controller is off — no alerting infra in this\n  # homelab. Enable when you wire up Slack/email webhooks.\n  notifications:\n    enabled: false\n\n  server:\n    # ponytail: Traefik terminates TLS at the ingress; ArgoCD server runs\n    # plain HTTP internally. Without --insecure the server redirects to its\n    # own HTTPS port which Traefik never sends traffic to.\n    ingress:\n      enabled: true\n      ingressClassName: traefik\n      annotations:\n        cert-manager.io/cluster-issuer: homelab-ca-issuer\n      hosts:\n        - argocd.local\n      tls:\n        - secretName: argocd.local-tls\n          hosts:\n            - argocd.local\n    resources:\n      requests:\n        cpu: 50m\n        memory: 128Mi\n      limits:\n        memory: 256Mi\n\n  controller:\n    resources:\n      requests:\n        cpu: 50m\n        memory: 256Mi\n      limits:\n        memory: 512Mi\n\n  repoServer:\n    resources:\n      requests:\n        cpu: 50m\n        memory: 128Mi\n      limits:\n        memory: 256Mi\n\n  applicationSet:\n    resources:\n      requests:\n        cpu: 10m\n        memory: 64Mi\n      limits:\n        memory: 128Mi\n\n  redis:\n    resources:\n      requests:\n        cpu: 10m\n        memory: 64Mi\n      limits:\n        memory: 128Mi\n\n  configs:\n    params:\n      # ponytail: run HTTP internally; Traefik ingress handles TLS termination\n      server.insecure: true\n\n    cm:\n      # ponytail: url must match the external Tailscale URL — ArgoCD embeds\n      # it in the OIDC redirect_uri sent to Authentik. Wrong url = callback\n      # mismatch error after login.\n      url: \"https://argocd.tail60240b.ts.net\"\n      # ponytail: oidc.config drives ArgoCD's built-in OIDC client (no Dex).\n      # clientSecret is plain text here (ConfigMap, not Secret) because helm\n      # template base64-encodes Secret values before rendered.replace() runs —\n      # the placeholder would never match. Homelab trade-off: acceptable.\n      oidc.config: |\n        name: Authentik\n        issuer: https://authentik.tail60240b.ts.net/application/o/argocd/\n        clientID: dev-argocd-oidc-client-id\n        clientSecret: dev-argocd-oidc-client-secret-not-for-prod-use\n        requestedScopes:\n          - openid\n          - profile\n          - email\n\n    rbac:\n      # ponytail: scopes tells ArgoCD which OIDC token claims to use as group\n      # subjects for RBAC matching. '[email]' means policy.csv entries like\n      # \"g, user@example.com, role:admin\" match against the email claim.\n      scopes: '[email]'\n      policy.default: role:readonly\n      policy.csv: |\n        g, edwardlimkoksiong1994@gmail.com, role:admin\n"],"verify":false,"version":"0.1.0","wait":true,"wait_for_jobs":false},"sensitive_attributes":[[{"type":"get_attr","value":"repository_password"}],[{"type":"get_attr","value":"values"},{"type":"index","value":{"value":0,"type":"number"}}]],"private":"eyJzY2hlbWFfdmVyc2lvbiI6IjEifQ==","dependencies":["kubernetes_namespace.argocd"]}]},{"mode":"managed","type":"helm_release","name":"authentik","provider":"provider[\"registry.opentofu.org/hashicorp/helm\"]","instances":[{"schema_version":1,"attributes":{"atomic":false,"chart":"./../helm/authentik","cleanup_on_fail":false,"create_namespace":false,"dependency_update":true,"description":null,"devel":null,"disable_crd_hooks":false,"disable_openapi_validation":false,"disable_webhooks":false,"force_update":false,"id":"authentik","keyring":null,"lint":false,"manifest":null,"max_history":0,"metadata":[{"app_version":"","chart":"authentik","first_deployed":1788335196,"last_deployed":1788429284,"name":"authentik","namespace":"authentik","notes":"Run the commands below to get a kubeconfig file for authentik:\n\nKUBE_API=$(kubectl config view --minify --output jsonpath=\"{.clusters[*].cluster.server}\")\nNAMESPACE=authentik\nSECRET_NAME=$(kubectl get serviceaccount authentik -o jsonpath='{.secrets[0].name}' 2\u003e/dev/null || echo -n \"authentik\")\nKUBE_CA=$(kubectl -n $NAMESPACE get secret/$SECRET_NAME -o jsonpath='{.data.ca\\.crt}')\nKUBE_TOKEN=$(kubectl -n $NAMESPACE get secret/$SECRET_NAME -o jsonpath='{.data.token}' | base64 --decode)\n\necho \"apiVersion: v1\nkind: Config\nclusters:\n- name: default-cluster\n  cluster:\n    certificate-authority-data: ${KUBE_CA}\n    server: ${KUBE_API}\ncontexts:\n- name: default-context\n  context:\n    cluster: default-cluster\n    namespace: $NAMESPACE\n    user: authentik-user\ncurrent-context: default-context\nusers:\n- name: authentik-user\n  user:\n    token: ${KUBE_TOKEN}\"\n","revision":2,"values":"{\"authentik\":{\"authentik\":{\"log_level\":\"info\",\"postgresql\":{\"host\":\"authentik-postgres\",\"name\":\"authentik\",\"password\":\"(sensitive value)\",\"user\":\"authentik\"},\"redis\":{\"host\":\"authentik-redis\"},\"secret_key\":\"(sensitive value)\"},\"global\":{\"env\":[{\"name\":\"AUTHENTIK_BOOTSTRAP_TOKEN\",\"value\":\"dev-authentik-bootstrap-token-not-for-prod-use\"},{\"name\":\"AUTHENTIK_BOOTSTRAP_PASSWORD\",\"value\":\"Admin1234!\"},{\"name\":\"AUTHENTIK_BOOTSTRAP_EMAIL\",\"value\":\"akadmin@authentik.local\"},{\"name\":\"GITHUB_OAUTH_CLIENT_ID\",\"value\":\"Ov23li7sHVJbV4ziaPII\"},{\"name\":\"GITHUB_OAUTH_CLIENT_SECRET\",\"value\":\"af73a65d4f17db2a356b47dd2faee77dbcabcaf1\"}]},\"postgresql\":{\"enabled\":false},\"redis\":{\"enabled\":false},\"server\":{\"ingress\":{\"annotations\":{\"cert-manager.io/cluster-issuer\":\"homelab-ca-issuer\"},\"enabled\":true,\"hosts\":[\"authentik.local\"],\"ingressClassName\":\"traefik\",\"tls\":[{\"hosts\":[\"authentik.local\"],\"secretName\":\"authentik-tls\"}]},\"replicas\":1,\"resources\":{\"limits\":{\"memory\":\"1Gi\"},\"requests\":{\"cpu\":\"100m\",\"memory\":\"512Mi\"}}},\"worker\":{\"replicas\":1,\"resources\":{\"limits\":{\"memory\":\"1Gi\"},\"requests\":{\"cpu\":\"50m\",\"memory\":\"512Mi\"}}}},\"postgres\":{\"database\":\"authentik\",\"image\":\"postgres:16\",\"password\":\"(sensitive value)\",\"resources\":{\"limits\":{\"memory\":\"512Mi\"},\"requests\":{\"cpu\":\"50m\",\"memory\":\"256Mi\"}},\"storageSize\":\"4Gi\",\"username\":\"authentik\"},\"redis\":{\"image\":\"redis:7-alpine\",\"resources\":{\"limits\":{\"memory\":\"128Mi\"},\"requests\":{\"cpu\":\"25m\",\"memory\":\"32Mi\"}}}}","version":"0.1.0"}],"name":"authentik","namespace":"authentik","pass_credentials":false,"postrender":[],"recreate_pods":false,"render_subchart_notes":true,"replace":false,"repository":null,"repository_ca_file":null,"repository_cert_file":null,"repository_key_file":null,"repository_password":null,"repository_username":null,"reset_values":false,"reuse_values":false,"set":[{"name":"authentik.global.env[0].name","type":"","value":"AUTHENTIK_BOOTSTRAP_TOKEN"},{"name":"authentik.global.env[1].name","type":"","value":"AUTHENTIK_BOOTSTRAP_PASSWORD"},{"name":"authentik.global.env[2].name","type":"","value":"AUTHENTIK_BOOTSTRAP_EMAIL"},{"name":"authentik.global.env[2].value","type":"","value":"akadmin@authentik.local"},{"name":"authentik.global.env[3].name","type":"","value":"GITHUB_OAUTH_CLIENT_ID"},{"name":"authentik.global.env[4].name","type":"","value":"GITHUB_OAUTH_CLIENT_SECRET"}],"set_list":[],"set_sensitive":[{"name":"authentik.authentik.postgresql.password","type":"","value":"dev-authentik-db-password"},{"name":"authentik.authentik.secret_key","type":"","value":"dev-authentik-secret-key-not-for-prod-use"},{"name":"authentik.global.env[0].value","type":"","value":"dev-authentik-bootstrap-token-not-for-prod-use"},{"name":"authentik.global.env[1].value","type":"","value":"Admin1234!"},{"name":"authentik.global.env[3].value","type":"","value":"Ov23li7sHVJbV4ziaPII"},{"name":"authentik.global.env[4].value","type":"","value":"af73a65d4f17db2a356b47dd2faee77dbcabcaf1"},{"name":"postgres.password","type":"","value":"dev-authentik-db-password"}],"skip_crds":false,"status":"deployed","timeout":300,"upgrade_install":null,"values":["authentik:\n  authentik:\n    secret_key: \"\"  # set via terraform variable\n    log_level: info\n    # ponytail: point at this wrapper chart's own plain postgres:16 /\n    # redis:7-alpine StatefulSets (templates/), NOT the goauthentik chart's\n    # bundled bitnami subcharts — bitnami sunset the free images. Same pattern\n    # as helm/n8n and helm/litellm.\n    postgresql:\n      host: \"authentik-postgres\"\n      name: \"authentik\"\n      user: \"authentik\"\n      password: \"\"  # set via terraform variable\n    redis:\n      host: \"authentik-redis\"\n\n  # ponytail: bundled bitnami subcharts off — replaced by templates/postgres.yaml\n  # + templates/redis.yaml below.\n  postgresql:\n    enabled: false\n  redis:\n    enabled: false\n\n  server:\n    replicas: 1\n    resources:\n      requests:\n        cpu: 100m\n        memory: 512Mi\n      limits:\n        memory: 1Gi\n    ingress:\n      enabled: true\n      ingressClassName: traefik\n      annotations:\n        cert-manager.io/cluster-issuer: homelab-ca-issuer\n      hosts:\n        - authentik.local\n      tls:\n        - secretName: authentik-tls\n          hosts:\n            - authentik.local\n\n  worker:\n    replicas: 1\n    resources:\n      requests:\n        cpu: 50m\n        memory: 512Mi\n      limits:\n        memory: 1Gi\n\n# ponytail: consumed by templates/postgres.yaml + templates/redis.yaml (this\n# wrapper chart's own templates). Keep db name/user/password in sync with\n# authentik.authentik.postgresql above.\npostgres:\n  image: postgres:16\n  database: authentik\n  username: authentik\n  password: \"\"  # set via terraform / Tiltfile\n  storageSize: 4Gi\n  resources:\n    requests:\n      cpu: 50m\n      memory: 256Mi\n    limits:\n      memory: 512Mi\n\nredis:\n  image: redis:7-alpine\n  resources:\n    requests:\n      cpu: 25m\n      memory: 32Mi\n    limits:\n      memory: 128Mi\n"],"verify":false,"version":"0.1.0","wait":true,"wait_for_jobs":false},"sensitive_attributes":[[{"type":"get_attr","value":"repository_password"}],[{"type":"get_attr","value":"set_sensitive"}]],"private":"eyJzY2hlbWFfdmVyc2lvbiI6IjEifQ==","dependencies":["helm_release.cert_manager","kubectl_manifest.homelab_ca","kubectl_manifest.homelab_ca_issuer","kubectl_manifest.selfsigned_bootstrap","kubernetes_namespace.authentik","kubernetes_namespace.cert_manager"]}]},{"mode":"managed","type":"helm_release","name":"cert_manager","provider":"provider[\"registry.opentofu.org/hashicorp/helm\"]","instances":[{"schema_version":1,"attributes":{"atomic":false,"chart":"./../helm/cert-manager","cleanup_on_fail":false,"create_namespace":false,"dependency_update":true,"description":null,"devel":null,"disable_crd_hooks":false,"disable_openapi_validation":false,"disable_webhooks":false,"force_update":false,"id":"cert-manager","keyring":null,"lint":false,"manifest":null,"max_history":0,"metadata":[{"app_version":"","chart":"cert-manager","first_deployed":1788335109,"last_deployed":1788335109,"name":"cert-manager","namespace":"cert-manager","notes":"\ncert-manager v1.21.1 has been deployed successfully!\n\nIn order to begin issuing certificates, you will need to set up a ClusterIssuer\nor Issuer resource (for example, by creating a 'letsencrypt-staging' issuer).\n\nMore information on the different types of issuers and how to configure them\ncan be found in our documentation:\n\nhttps://cert-manager.io/docs/configuration/\n\nFor information on how to configure cert-manager to automatically provision\nCertificates for Ingress resources, take a look at the `ingress-shim`\ndocumentation:\n\nhttps://cert-manager.io/docs/usage/ingress/\n\nFor information on how to configure cert-manager to automatically provision\nCertificates for Gateway API resources, take a look at the `gateway resource`\ndocumentation:\n\nhttps://cert-manager.io/docs/usage/gateway/\n","revision":1,"values":"{\"cert-manager\":{\"cainjector\":{\"resources\":{\"limits\":{\"memory\":\"128Mi\"},\"requests\":{\"cpu\":\"25m\",\"memory\":\"64Mi\"}}},\"crds\":{\"enabled\":true},\"resources\":{\"limits\":{\"memory\":\"128Mi\"},\"requests\":{\"cpu\":\"25m\",\"memory\":\"64Mi\"}},\"webhook\":{\"resources\":{\"limits\":{\"memory\":\"64Mi\"},\"requests\":{\"cpu\":\"25m\",\"memory\":\"32Mi\"}}}}}","version":"0.1.0"}],"name":"cert-manager","namespace":"cert-manager","pass_credentials":false,"postrender":[],"recreate_pods":false,"render_subchart_notes":true,"replace":false,"repository":null,"repository_ca_file":null,"repository_cert_file":null,"repository_key_file":null,"repository_password":null,"repository_username":null,"reset_values":false,"reuse_values":false,"set":[],"set_list":[],"set_sensitive":[],"skip_crds":false,"status":"deployed","timeout":300,"upgrade_install":null,"values":["cert-manager:\r\n  crds:\r\n    enabled: true\r\n  resources:\r\n    requests:\r\n      cpu: 25m\r\n      memory: 64Mi\r\n    limits:\r\n      memory: 128Mi\r\n  webhook:\r\n    resources:\r\n      requests:\r\n        cpu: 25m\r\n        memory: 32Mi\r\n      limits:\r\n        memory: 64Mi\r\n  cainjector:\r\n    resources:\r\n      requests:\r\n        cpu: 25m\r\n        memory: 64Mi\r\n      limits:\r\n        memory: 128Mi\r\n"],"verify":false,"version":"0.1.0","wait":true,"wait_for_jobs":false},"sensitive_attributes":[[{"type":"get_attr","value":"repository_password"}]],"private":"eyJzY2hlbWFfdmVyc2lvbiI6IjEifQ==","dependencies":["kubernetes_namespace.cert_manager"]}]},{"mode":"managed","type":"helm_release","name":"gitlab","provider":"provider[\"registry.opentofu.org/hashicorp/helm\"]","instances":[{"schema_version":1,"attributes":{"atomic":false,"chart":"./../helm/gitlab","cleanup_on_fail":false,"create_namespace":false,"dependency_update":true,"description":null,"devel":null,"disable_crd_hooks":false,"disable_openapi_validation":false,"disable_webhooks":false,"force_update":false,"id":"gitlab","keyring":null,"lint":false,"manifest":null,"max_history":0,"metadata":[{"app_version":"","chart":"gitlab","first_deployed":1788335996,"last_deployed":1788433384,"name":"gitlab","namespace":"gitlab","notes":"","revision":9,"values":"{\"gitlab\":{\"certmanager\":{\"installCRDs\":false},\"certmanager-issuer\":{\"email\":\"edwardlimkoksiong1994@gmail.com\"},\"gitlab\":{\"gitaly\":{\"resources\":{\"limits\":{\"memory\":\"512Mi\"},\"requests\":{\"cpu\":\"50m\",\"memory\":\"256Mi\"}}},\"gitlab-shell\":{\"maxReplicas\":1,\"minReplicas\":1},\"sidekiq\":{\"maxReplicas\":1,\"minReplicas\":1,\"resources\":{\"limits\":{\"memory\":\"1Gi\"},\"requests\":{\"cpu\":\"50m\",\"memory\":\"512Mi\"}}},\"toolbox\":{\"enabled\":false},\"webservice\":{\"maxReplicas\":1,\"minReplicas\":1,\"resources\":{\"limits\":{\"memory\":\"3Gi\"},\"requests\":{\"cpu\":\"100m\",\"memory\":\"1Gi\"}}}},\"gitlab-runner\":{\"gitlabUrl\":\"http://gitlab-webservice-default.gitlab.svc.cluster.local:8181/\",\"install\":true,\"rbac\":{\"create\":true},\"runners\":{\"cache\":{\"secretName\":\"gitlab-runner-cache-credentials\"},\"config\":\"[[runners]]\\n  # ponytail: CI_REPOSITORY_URL is derived from GitLab's external URL,\\n  # which job pods can't reach — force in-cluster clones.\\n  clone_url = \\\"http://gitlab-webservice-default.gitlab.svc.cluster.local:8181\\\"\\n  [runners.cache]\\n    Type = \\\"s3\\\"\\n    Shared = true\\n    [runners.cache.s3]\\n      ServerAddress = \\\"minio.minio.svc.cluster.local:9000\\\"\\n      BucketName = \\\"gitlab-runner-cache\\\"\\n      BucketLocation = \\\"us-east-1\\\"\\n      Insecure = true\\n  [runners.kubernetes]\\n    namespace = \\\"gitlab\\\"\\n    image = \\\"alpine:3.21\\\"\\n    privileged = true\\n    cpu_request = \\\"100m\\\"\\n    memory_request = \\\"256Mi\\\"\\n    cpu_limit = \\\"1\\\"\\n    memory_limit = \\\"2Gi\\\"\\n    # ponytail: shared /certs/client between build + docker:dind service\\n    [[runners.kubernetes.volumes.empty_dir]]\\n      name = \\\"docker-certs\\\"\\n      mount_path = \\\"/certs/client\\\"\\n      medium = \\\"Memory\\\"\\n  [runners.kubernetes.pod_labels]\\n    app = \\\"gitlab-ci-job\\\"\\n\",\"privileged\":true}},\"global\":{\"appConfig\":{\"artifacts\":{\"bucket\":\"gitlab-artifacts\",\"enabled\":true},\"backups\":{\"bucket\":\"gitlab-backups\"},\"ciSecureFiles\":{\"bucket\":\"gitlab-ci-secure-files\",\"enabled\":true},\"dependencyProxy\":{\"bucket\":\"gitlab-dependency-proxy\",\"enabled\":true},\"externalDiffs\":{\"bucket\":\"gitlab-mr-diffs\",\"enabled\":true},\"lfs\":{\"bucket\":\"git-lfs\",\"enabled\":true},\"object_store\":{\"connection\":{\"key\":\"connection\",\"secret\":\"gitlab-object-storage\"},\"enabled\":true},\"omniauth\":{\"allowSingleSignOn\":[\"openid_connect\"],\"autoSignInWithProvider\":\"openid_connect\",\"blockAutoCreatedUsers\":false,\"enabled\":true,\"providers\":[{\"key\":\"provider\",\"secret\":\"gitlab-omniauth-authentik\"}]},\"packages\":{\"bucket\":\"gitlab-packages\",\"enabled\":true},\"terraformState\":{\"bucket\":\"gitlab-terraform-state\",\"enabled\":true},\"uploads\":{\"bucket\":\"gitlab-uploads\",\"enabled\":true}},\"edition\":\"ce\",\"hosts\":{\"domain\":\"gitlab.local\",\"gitlab\":{\"https\":true,\"name\":\"gitlab.tail60240b.ts.net\"},\"https\":true},\"hpa\":{\"apiVersion\":\"autoscaling/v2\"},\"ingress\":{\"annotations\":{\"cert-manager.io/cluster-issuer\":\"homelab-ca-issuer\"},\"apiVersion\":\"networking.k8s.io/v1\",\"class\":\"traefik\",\"configureCertmanager\":false,\"enabled\":true,\"provider\":\"traefik\",\"tls\":{\"enabled\":true,\"secretName\":\"gitlab-tls\"}},\"initialRootPassword\":{\"secret\":\"gitlab-initial-root-password\"},\"kas\":{\"enabled\":false},\"minio\":{\"enabled\":false},\"pdb\":{\"apiVersion\":\"policy/v1\"},\"psql\":{\"database\":\"gitlabhq_production\",\"host\":\"gitlab-postgres\",\"password\":{\"key\":\"password\",\"secret\":\"gitlab-postgres-secret\"},\"port\":5432,\"username\":\"gitlab\"},\"redis\":{\"auth\":{\"enabled\":false},\"host\":\"gitlab-redis\"},\"traefik\":{\"apiVersion\":\"traefik.io/v1alpha1\"}},\"grafana\":{\"enabled\":false},\"installCertmanager\":false,\"nginx-ingress\":{\"enabled\":false},\"postgresql\":{\"install\":false},\"prometheus\":{\"install\":false},\"redis\":{\"install\":false},\"registry\":{\"enabled\":false}},\"postgres\":{\"image\":\"postgres:16\",\"password\":\"(sensitive value)\",\"resources\":{\"limits\":{\"memory\":\"2Gi\"},\"requests\":{\"cpu\":\"100m\",\"memory\":\"512Mi\"}},\"storageSize\":\"8Gi\"},\"redis\":{\"image\":\"redis:7-alpine\",\"resources\":{\"limits\":{\"memory\":\"256Mi\"},\"requests\":{\"cpu\":\"25m\",\"memory\":\"64Mi\"}}}}","version":"0.1.0"}],"name":"gitlab","namespace":"gitlab","pass_credentials":false,"postrender":[],"recreate_pods":false,"render_subchart_notes":true,"replace":false,"repository":null,"repository_ca_file":null,"repository_cert_file":null,"repository_key_file":null,"repository_password":null,"repository_username":null,"reset_values":false,"reuse_values":false,"set":[{"name":"gitlab.certmanager-issuer.email","type":"","value":"edwardlimkoksiong1994@gmail.com"},{"name":"gitlab.global.appConfig.object_store.connection.key","type":"","value":"connection"},{"name":"gitlab.global.appConfig.object_store.connection.secret","type":"","value":"gitlab-object-storage"},{"name":"gitlab.global.appConfig.omniauth.allowSingleSignOn[0]","type":"","value":"openid_connect"},{"name":"gitlab.global.appConfig.omniauth.autoSignInWithProvider","type":"","value":"openid_connect"},{"name":"gitlab.global.appConfig.omniauth.blockAutoCreatedUsers","type":"","value":"false"},{"name":"gitlab.global.appConfig.omniauth.enabled","type":"","value":"true"},{"name":"gitlab.global.appConfig.omniauth.providers[0].key","type":"","value":"provider"},{"name":"gitlab.global.appConfig.omniauth.providers[0].secret","type":"","value":"gitlab-omniauth-authentik"},{"name":"gitlab.global.hosts.gitlab.https","type":"","value":"true"},{"name":"gitlab.global.hosts.gitlab.name","type":"","value":"gitlab.tail60240b.ts.net"},{"name":"gitlab.global.hosts.https","type":"","value":"true"},{"name":"gitlab.global.initialRootPassword.secret","type":"","value":"gitlab-initial-root-password"}],"set_list":[],"set_sensitive":[{"name":"postgres.password","type":"","value":"dev-gitlab-db-password"}],"skip_crds":false,"status":"deployed","timeout":600,"upgrade_install":null,"values":["gitlab:\r\n  global:\r\n    edition: ce\r\n    hosts:\r\n      domain: gitlab.local\r\n      # ponytail: without this, hostname defaults to \"gitlab.\u003cdomain\u003e\" i.e.\r\n      # gitlab.gitlab.local (domain already includes \"gitlab\")\r\n      gitlab:\r\n        name: gitlab.local\r\n    initialRootPassword:\r\n      secret: \"\"  # set via terraform\r\n\r\n    # ponytail: external DB + cache — this wrapper chart's own plain postgres:16\r\n    # / redis:7-alpine StatefulSets (templates/), not the bundled bitnami\r\n    # subcharts. Password secret is rendered by templates/postgres.yaml from\r\n    # .Values.postgres.password.\r\n    psql:\r\n      host: gitlab-postgres\r\n      port: 5432\r\n      database: gitlabhq_production\r\n      username: gitlab\r\n      password:\r\n        secret: gitlab-postgres-secret\r\n        key: password\r\n    redis:\r\n      host: gitlab-redis\r\n      auth:\r\n        enabled: false\r\n    ingress:\r\n      enabled: true\r\n      # ponytail: helm template has no live cluster to auto-detect API\r\n      # versions from; same class of issue as the pdb/hpa overrides above\r\n      apiVersion: networking.k8s.io/v1\r\n      provider: traefik\r\n      class: traefik\r\n      annotations:\r\n        cert-manager.io/cluster-issuer: homelab-ca-issuer\r\n      tls:\r\n        enabled: true\r\n        secretName: gitlab-tls\r\n      # ponytail: defaults true independent of ingress.enabled, keeps\r\n      # spawning a cert-manager issuer job; we manage our own ClusterIssuer\r\n      configureCertmanager: false\r\n    # ponytail: backed by the standalone minio app (helm/minio), not the\r\n    # gitlab chart's own bundled minio subchart (global.minio stays\r\n    # disabled below) — connection secret wired in gitlab/Tiltfile.\r\n    # Per-feature blocks below must leave `connection` empty and only set\r\n    # `bucket` for the chart to treat object_store.connection as the\r\n    # consolidated one they all inherit (see charts/gitlab/_objectStorage.tpl).\r\n    appConfig:\r\n      object_store:\r\n        enabled: true\r\n      lfs:\r\n        enabled: true\r\n        bucket: git-lfs\r\n      artifacts:\r\n        enabled: true\r\n        bucket: gitlab-artifacts\r\n      uploads:\r\n        enabled: true\r\n        bucket: gitlab-uploads\r\n      packages:\r\n        enabled: true\r\n        bucket: gitlab-packages\r\n      externalDiffs:\r\n        enabled: true\r\n        bucket: gitlab-mr-diffs\r\n      dependencyProxy:\r\n        enabled: true\r\n        bucket: gitlab-dependency-proxy\r\n      terraformState:\r\n        enabled: true\r\n        bucket: gitlab-terraform-state\r\n      ciSecureFiles:\r\n        enabled: true\r\n        bucket: gitlab-ci-secure-files\r\n      backups:\r\n        bucket: gitlab-backups\r\n    minio:\r\n      enabled: false\r\n    kas:\r\n      enabled: false\r\n    # ponytail: Tilt's helm() runs `helm template` with no cluster connection,\r\n    # so Capabilities-based API auto-detection can't run and falls back to the\r\n    # long-removed policy/v1beta1 PDB kind. Pin explicitly.\r\n    pdb:\r\n      apiVersion: policy/v1\r\n    hpa:\r\n      apiVersion: autoscaling/v2\r\n    # ponytail: gitlab-shell's SSH IngressRouteTCP only renders once\r\n    # ingress.provider is traefik; same live-cluster-detection gap as above,\r\n    # this cluster's Traefik (v3) only registers the newer traefik.io group\r\n    traefik:\r\n      apiVersion: traefik.io/v1alpha1\r\n\r\n  # disable non-essential components\r\n  registry:\r\n    enabled: false\r\n  # ponytail: chart 9.x renamed certmanager.install -\u003e top-level\r\n  # installCertmanager. We run our own ClusterIssuer\r\n  # (global.ingress.configureCertmanager: false above) — no bundled\r\n  # cert-manager, no CRDs.\r\n  installCertmanager: false\r\n  certmanager:\r\n    installCRDs: false\r\n  nginx-ingress:\r\n    enabled: false\r\n  # ponytail: runner registers + clones over the in-cluster Service, not the\r\n  # tailnet hostname — the job/runner pods aren't on the tailnet and\r\n  # `tailscale serve` is tailnet-only, so the external URL is unreachable\r\n  # from inside k3d.\r\n  # GitLab 18 removed registration tokens: the Tiltfile's\r\n  # gitlab-runner-auth-token step mints a glrt- auth token post-deploy and\r\n  # writes it into gitlab-gitlab-runner-secret (key: runner-token).\r\n  gitlab-runner:\r\n    install: true\r\n    gitlabUrl: http://gitlab-webservice-default.gitlab.svc.cluster.local:8181/\r\n    rbac:\r\n      create: true\r\n    runners:\r\n      # ponytail: privileged so `docker:dind` service containers work. k3d\r\n      # nodes already run privileged (k3s needs it), so this works on Docker\r\n      # Desktop. Prefer kaniko for image builds where you can — dind is the\r\n      # escape hatch for jobs that genuinely need the docker daemon.\r\n      privileged: true\r\n      # ponytail: distributed cache in MinIO so jobs on different runner pods\r\n      # share cache/. Secret carries the S3 creds (keys: accesskey/secretkey).\r\n      cache:\r\n        secretName: gitlab-runner-cache-credentials\r\n      config: |\r\n        [[runners]]\r\n          # ponytail: CI_REPOSITORY_URL is derived from GitLab's external URL,\r\n          # which job pods can't reach — force in-cluster clones.\r\n          clone_url = \"http://gitlab-webservice-default.gitlab.svc.cluster.local:8181\"\r\n          [runners.cache]\r\n            Type = \"s3\"\r\n            Shared = true\r\n            [runners.cache.s3]\r\n              ServerAddress = \"minio.minio.svc.cluster.local:9000\"\r\n              BucketName = \"gitlab-runner-cache\"\r\n              BucketLocation = \"us-east-1\"\r\n              Insecure = true\r\n          [runners.kubernetes]\r\n            namespace = \"gitlab\"\r\n            image = \"alpine:3.21\"\r\n            privileged = true\r\n            cpu_request = \"100m\"\r\n            memory_request = \"256Mi\"\r\n            cpu_limit = \"1\"\r\n            memory_limit = \"2Gi\"\r\n            # ponytail: shared /certs/client between build + docker:dind service\r\n            [[runners.kubernetes.volumes.empty_dir]]\r\n              name = \"docker-certs\"\r\n              mount_path = \"/certs/client\"\r\n              medium = \"Memory\"\r\n          [runners.kubernetes.pod_labels]\r\n            app = \"gitlab-ci-job\"\r\n  prometheus:\r\n    install: false\r\n  grafana:\r\n    enabled: false\r\n  gitlab:\r\n    toolbox:\r\n      enabled: false\r\n    webservice:\r\n      minReplicas: 1\r\n      maxReplicas: 1\r\n      resources:\r\n        requests:\r\n          cpu: 100m\r\n          memory: 1Gi\r\n        # ponytail: 2Gi leaves no headroom for a second Rails boot, so\r\n        # `rails runner` (gitlab-promote-admin) gets OOMKilled (exit 137) and\r\n        # the Web IDE OAuth redirect_uri realign silently never runs. 3Gi fits\r\n        # puma + one runner. Node has room; bump back down if it doesn't.\r\n        limits:\r\n          memory: 3Gi\r\n    sidekiq:\r\n      minReplicas: 1\r\n      maxReplicas: 1\r\n      resources:\r\n        requests:\r\n          cpu: 50m\r\n          memory: 512Mi\r\n        limits:\r\n          memory: 1Gi\r\n    gitaly:\r\n      resources:\r\n        requests:\r\n          cpu: 50m\r\n          memory: 256Mi\r\n        limits:\r\n          memory: 512Mi\r\n    gitlab-shell:\r\n      minReplicas: 1\r\n      maxReplicas: 1\r\n\r\n  # ponytail: bundled bitnami postgresql + redis subcharts off — replaced by this\r\n  # wrapper chart's own plain StatefulSets (templates/postgres.yaml,\r\n  # templates/redis.yaml). GitLab officially supports external psql/redis via\r\n  # global.psql / global.redis above. bitnami sunset the free images.\r\n  postgresql:\r\n    install: false\r\n  redis:\r\n    install: false\r\n\n# ponytail: consumed by templates/{postgres,redis}.yaml (this wrapper chart's own\n# templates). postgres.password must match global.psql above; it's also written\n# into the gitlab-postgres-secret the template renders.\npostgres:\n  image: postgres:16\n  password: \"\"   # set via terraform / Tiltfile\n  storageSize: 8Gi\n  resources:\n    requests:\n      cpu: 100m\n      memory: 512Mi\n    limits:\n      memory: 2Gi\n\nredis:\n  image: redis:7-alpine\n  resources:\n    requests:\n      cpu: 25m\n      memory: 64Mi\n    limits:\n      memory: 256Mi\n"],"verify":false,"version":"0.1.0","wait":false,"wait_for_jobs":false},"sensitive_attributes":[[{"type":"get_attr","value":"repository_password"}],[{"type":"get_attr","value":"set_sensitive"}]],"private":"eyJzY2hlbWFfdmVyc2lvbiI6IjEifQ==","dependencies":["helm_release.cert_manager","kubectl_manifest.homelab_ca","kubectl_manifest.homelab_ca_issuer","kubectl_manifest.selfsigned_bootstrap","kubernetes_namespace.cert_manager","kubernetes_namespace.gitlab","kubernetes_secret.gitlab_object_storage","kubernetes_secret.gitlab_omniauth_authentik","kubernetes_secret.gitlab_root_password","kubernetes_secret.gitlab_runner_cache_credentials"]}]},{"mode":"managed","type":"helm_release","name":"litellm","provider":"provider[\"registry.opentofu.org/hashicorp/helm\"]","instances":[{"schema_version":1,"attributes":{"atomic":false,"chart":"./../helm/litellm","cleanup_on_fail":false,"create_namespace":false,"dependency_update":true,"description":null,"devel":null,"disable_crd_hooks":false,"disable_openapi_validation":false,"disable_webhooks":false,"force_update":false,"id":"litellm","keyring":null,"lint":false,"manifest":null,"max_history":0,"metadata":[{"app_version":"","chart":"litellm","first_deployed":1788335108,"last_deployed":1788491090,"name":"litellm","namespace":"litellm","notes":"\nCHART NAME: postgresql\nCHART VERSION: 18.8.13\nAPP VERSION: 18.6.0\n\n** Please be patient while the chart is being deployed **\n\nPostgreSQL can be accessed via port 5432 on the following DNS names from within your cluster:\n\n    litellm-postgresql.litellm.svc.cluster.local - Read/Write connection\n\nTo get the password for \"postgres\" run:\n\n    export POSTGRES_PASSWORD=$(kubectl get secret --namespace litellm litellm-postgresql -o jsonpath=\"{.data.postgres-password}\" | base64 -d)\n\nTo connect to your database run the following command:\n\n    kubectl run litellm-postgresql-client --rm --tty -i --restart='Never' --namespace litellm --image registry-1.docker.io/bitnami/postgresql:latest --env=\"PGPASSWORD=$POSTGRES_PASSWORD\" \\\n      --command -- psql --host litellm-postgresql -U postgres -d postgres -p 5432\n\n    \u003e NOTE: If you access the container using bash, make sure that you execute \"/opt/bitnami/scripts/postgresql/entrypoint.sh /bin/bash\" in order to avoid the error \"psql: local user with ID 1001 does not exist\"\n\nTo connect to your database from outside the cluster execute the following commands:\n\n    kubectl port-forward --namespace litellm svc/litellm-postgresql 5432:5432 \u0026\n    PGPASSWORD=\"$POSTGRES_PASSWORD\" psql --host 127.0.0.1 -U postgres -d postgres -p 5432\nWARNING: Rolling tag detected (bitnami/postgresql:latest), please note that it is strongly recommended to avoid using rolling tags in a production environment.\n+info https://techdocs.broadcom.com/us/en/vmware-tanzu/bitnami-secure-images/bitnami-secure-images/services/bsi-doc/apps-tutorials-understand-rolling-tags-containers-index.html\nWARNING: Rolling tag detected (bitnami/postgres-exporter:latest), please note that it is strongly recommended to avoid using rolling tags in a production environment.\n+info https://techdocs.broadcom.com/us/en/vmware-tanzu/bitnami-secure-images/bitnami-secure-images/services/bsi-doc/apps-tutorials-understand-rolling-tags-containers-index.html\nWARNING: Rolling tag detected (bitnami/os-shell:latest), please note that it is strongly recommended to avoid using rolling tags in a production environment.\n+info https://techdocs.broadcom.com/us/en/vmware-tanzu/bitnami-secure-images/bitnami-secure-images/services/bsi-doc/apps-tutorials-understand-rolling-tags-containers-index.html\n\nWARNING: There are \"resources\" sections in the chart not set. Using \"resourcesPreset\" is not recommended for production. For production installations, please set the following values according to your workload needs:\n  - primary.resources\n  - readReplicas.resources\n+info https://kubernetes.io/docs/concepts/configuration/manage-resources-containers/\n","revision":5,"values":"{\"env\":{\"AUTO_REDIRECT_UI_LOGIN_TO_SSO\":\"true\",\"DATABASE_URL\":\"postgresql://litellm:dev-litellm-db-password@litellm-postgres:5432/litellm\",\"GENERIC_AUTHORIZATION_ENDPOINT\":\"https://authentik.tail60240b.ts.net/application/o/authorize/\",\"GENERIC_CLIENT_ID\":\"dev-litellm-oidc-client-id\",\"GENERIC_CLIENT_SECRET\":\"dev-litellm-oidc-client-secret-not-for-prod-use\",\"GENERIC_SCOPE\":\"openid profile email litellm_role\",\"GENERIC_TOKEN_ENDPOINT\":\"http://authentik-server.authentik.svc.cluster.local/application/o/token/\",\"GENERIC_USERINFO_ENDPOINT\":\"http://authentik-server.authentik.svc.cluster.local/application/o/userinfo/\",\"GENERIC_USER_ROLE_ATTRIBUTE\":\"litellm_role\",\"LITELLM_MASTER_KEY\":\"sk-dev-litellm-master-key-not-for-prod-use\",\"LITELLM_SALT_KEY\":\"sk-dev-litellm-salt-key-not-for-prod-use\",\"PROXY_BASE_URL\":\"https://litellm.tail60240b.ts.net\",\"PROXY_LOGOUT_URL\":\"https://authentik.tail60240b.ts.net/application/o/litellm/end-session/\",\"STORE_MODEL_IN_DB\":\"True\"},\"image\":{\"repository\":\"ghcr.io/berriai/litellm\",\"tag\":\"main-latest\"},\"mcpGitlabAuthToken\":\"dev-gitlab-mcp-auth-token\",\"mcpSonarqubeAuthToken\":\"squ_2ea8c27ba77841e9c51c2171b6b73098b7e167a4\",\"ollamaBaseUrl\":\"http://host.docker.internal:11434\",\"ollamaModels\":[\"qwen3-coder-next\",\"qwen3:1.7b\"],\"ompRoles\":[\"backend-developer\",\"data-engineer\",\"devops-engineer\",\"frontend-developer\",\"product-owner\",\"project-manager\",\"qa-engineer\",\"release-manager\",\"security-engineer\",\"solution-architect\",\"tech-lead\",\"uiux-designer\"],\"postgres\":{\"database\":\"litellm\",\"image\":\"postgres:16\",\"password\":\"dev-litellm-db-password\",\"resources\":{\"limits\":{\"memory\":\"256Mi\"},\"requests\":{\"cpu\":\"50m\",\"memory\":\"128Mi\"}},\"storageSize\":\"4Gi\",\"username\":\"litellm\"},\"resources\":{\"limits\":{\"memory\":\"2Gi\"},\"requests\":{\"cpu\":\"100m\",\"memory\":\"512Mi\"}}}","version":"0.1.0"}],"name":"litellm","namespace":"litellm","pass_credentials":false,"postrender":[],"recreate_pods":false,"render_subchart_notes":true,"replace":false,"repository":null,"repository_ca_file":null,"repository_cert_file":null,"repository_key_file":null,"repository_password":null,"repository_username":null,"reset_values":false,"reuse_values":false,"set":[],"set_list":[],"set_sensitive":[],"skip_crds":false,"status":"deployed","timeout":600,"upgrade_install":null,"values":["image:\n  repository: ghcr.io/berriai/litellm\n  tag: main-latest\n\n# ponytail: per-caller bearer for the gitlab MCP server (its\n# STREAMABLE_HTTP_AUTH_TOKEN). Same value as TF_VAR_gitlab_mcp_auth_token.\nmcpGitlabAuthToken: \"dev-gitlab-mcp-auth-token\"\n\n# ponytail: SonarQube user token LiteLLM forwards to the sonarqube MCP server\n# as `Authorization: Bearer` (HTTP mode needs it per request). Same value as\n# TF_VAR_sonarqube_mcp_token.\nmcpSonarqubeAuthToken: \"squ_2ea8c27ba77841e9c51c2171b6b73098b7e167a4\"\n\n# ponytail: the host's Ollama, reached from the cluster via k3d's built-in\n# host alias. `ollama_chat/*` provider — no /v1 suffix. `ollamaModels` are the\n# tags shown by name in OpenWebUI's picker; add/remove to match `ollama list`.\n# host.docker.internal resolves from k3d pods on Docker Desktop; host.k3d.internal\n# depends on k3d's flaky CoreDNS NodeHosts injection and was failing name lookup.\nollamaBaseUrl: \"http://host.docker.internal:11434\"\nollamaModels:\n  - qwen3-coder-next\n  - \"qwen3:1.7b\"\n\nenv:\n  DATABASE_URL: \"postgresql://litellm:dev-litellm-db-password@litellm-postgres:5432/litellm\"\n  STORE_MODEL_IN_DB: \"True\"\n  LITELLM_MASTER_KEY: \"sk-dev-litellm-master-key-not-for-prod-use\"\n  LITELLM_SALT_KEY: \"sk-dev-litellm-salt-key-not-for-prod-use\"\n\n  # SSO via Authentik generic OIDC\n  GENERIC_CLIENT_ID: \"dev-litellm-oidc-client-id\"\n  GENERIC_CLIENT_SECRET: \"dev-litellm-oidc-client-secret-not-for-prod-use\"\n  # ponytail: browser-navigated endpoint must use Tailscale HTTPS (external).\n  # Token and userinfo are server-side calls — use in-cluster HTTP to avoid\n  # self-signed cert validation against homelab CA.\n  GENERIC_AUTHORIZATION_ENDPOINT: \"https://authentik.tail60240b.ts.net/application/o/authorize/\"\n  GENERIC_TOKEN_ENDPOINT: \"http://authentik-server.authentik.svc.cluster.local/application/o/token/\"\n  GENERIC_USERINFO_ENDPOINT: \"http://authentik-server.authentik.svc.cluster.local/application/o/userinfo/\"\n  GENERIC_SCOPE: \"openid profile email litellm_role\"\n  GENERIC_USER_ROLE_ATTRIBUTE: \"litellm_role\"\n  PROXY_BASE_URL: \"https://litellm.tail60240b.ts.net\"\n  PROXY_LOGOUT_URL: \"https://authentik.tail60240b.ts.net/application/o/litellm/end-session/\"\n  AUTO_REDIRECT_UI_LOGIN_TO_SSO: \"true\"\n\nresources:\n  requests:\n    cpu: 100m\n    memory: 512Mi\n  limits:\n    memory: 2Gi\n\n# ponytail: one LiteLLM pass-through route per omp role pod\n# (/omp-\u003crole\u003e -\u003e omp-\u003crole\u003e.omp.svc:4096). Duplicated from\n# helm/omp/values.yaml `roles:` — n8n can't read that chart. Keep in sync,\n# or drop a name here to stop routing to it.\nompRoles:\n  - backend-developer\n  - data-engineer\n  - devops-engineer\n  - frontend-developer\n  - product-owner\n  - project-manager\n  - qa-engineer\n  - release-manager\n  - security-engineer\n  - solution-architect\n  - tech-lead\n  - uiux-designer\n\npostgres:\n  image: postgres:16\n  database: litellm\n  username: litellm\n  password: \"dev-litellm-db-password\"\n  storageSize: 4Gi\n  resources:\n    requests:\n      cpu: 50m\n      memory: 128Mi\n    limits:\n      memory: 256Mi\n"],"verify":false,"version":"0.1.0","wait":true,"wait_for_jobs":false},"sensitive_attributes":[[{"type":"get_attr","value":"repository_password"}],[{"type":"get_attr","value":"values"},{"type":"index","value":{"value":0,"type":"number"}}]],"private":"eyJzY2hlbWFfdmVyc2lvbiI6IjEifQ==","dependencies":["kubernetes_namespace.litellm"]}]},{"mode":"managed","type":"helm_release","name":"mcp_servers","provider":"provider[\"registry.opentofu.org/hashicorp/helm\"]","instances":[{"schema_version":1,"attributes":{"atomic":false,"chart":"./../helm/mcp-servers","cleanup_on_fail":false,"create_namespace":false,"dependency_update":true,"description":null,"devel":null,"disable_crd_hooks":false,"disable_openapi_validation":false,"disable_webhooks":false,"force_update":false,"id":"mcp-servers","keyring":null,"lint":false,"manifest":null,"max_history":0,"metadata":[{"app_version":"","chart":"mcp-servers","first_deployed":1788334128,"last_deployed":1788491996,"name":"mcp-servers","namespace":"mcp-servers","notes":"","revision":4,"values":"{\"defaultResources\":{\"limits\":{\"memory\":\"256Mi\"},\"requests\":{\"cpu\":\"50m\",\"memory\":\"128Mi\"}},\"servers\":{\"gitlab\":{\"env\":{\"GITLAB_API_URL\":\"http://gitlab-webservice-default.gitlab.svc.cluster.local:8181/api/v4\",\"GITLAB_PERSONAL_ACCESS_TOKEN\":\"(sensitive value)\",\"HOST\":\"0.0.0.0\",\"MCP_SERVER_URL\":\"http://mcp-servers-gitlab.mcp-servers.svc.cluster.local:3002\",\"PORT\":\"3002\",\"STREAMABLE_HTTP\":\"true\",\"STREAMABLE_HTTP_AUTH_TOKEN\":\"(sensitive value)\"},\"image\":\"zereight050/gitlab-mcp:latest\",\"port\":3002},\"grafana\":{\"args\":[\"-transport\",\"streamable-http\",\"-address\",\"0.0.0.0:8000\",\"-allowed-hosts\",\"*\",\"-allowed-origins\",\"*\"],\"command\":[\"/app/mcp-grafana\"],\"env\":{\"GRAFANA_SERVICE_ACCOUNT_TOKEN\":\"(sensitive value)\",\"GRAFANA_URL\":\"http://observability-grafana.observability.svc.cluster.local\"},\"image\":\"grafana/mcp-grafana:latest\",\"port\":8000},\"playwright\":{\"args\":[\"--headless\",\"--browser\",\"chromium\",\"--no-sandbox\",\"--port\",\"8931\",\"--host\",\"0.0.0.0\",\"--allowed-hosts\",\"*\"],\"command\":[\"node\",\"/app/cli.js\"],\"image\":\"mcr.microsoft.com/playwright/mcp:latest\",\"port\":8931,\"resources\":{\"limits\":{\"memory\":\"1Gi\"},\"requests\":{\"cpu\":\"250m\",\"memory\":\"512Mi\"}}},\"sonarqube\":{\"env\":{\"SONARQUBE_HTTP_HOST\":\"0.0.0.0\",\"SONARQUBE_HTTP_PORT\":\"8080\",\"SONARQUBE_MCP_IN_CONTAINER\":\"true\",\"SONARQUBE_TOKEN\":\"(sensitive value)\",\"SONARQUBE_TRANSPORT\":\"http\",\"SONARQUBE_URL\":\"http://sonarqube-sonarqube.sonarqube.svc.cluster.local:9000\"},\"image\":\"sonarsource/sonarqube-mcp:latest\",\"port\":8080,\"resources\":{\"limits\":{\"memory\":\"1Gi\"},\"requests\":{\"cpu\":\"100m\",\"memory\":\"512Mi\"}}}}}","version":"0.1.0"}],"name":"mcp-servers","namespace":"mcp-servers","pass_credentials":false,"postrender":[],"recreate_pods":false,"render_subchart_notes":true,"replace":false,"repository":null,"repository_ca_file":null,"repository_cert_file":null,"repository_key_file":null,"repository_password":null,"repository_username":null,"reset_values":false,"reuse_values":false,"set":[],"set_list":[],"set_sensitive":[{"name":"servers.gitlab.env.GITLAB_PERSONAL_ACCESS_TOKEN","type":"","value":"glpat-JP4IVat33w5kasBGc-fZyW86MQp1OjIH.01.0w145zvsc"},{"name":"servers.gitlab.env.STREAMABLE_HTTP_AUTH_TOKEN","type":"","value":"dev-gitlab-mcp-auth-token"},{"name":"servers.grafana.env.GRAFANA_SERVICE_ACCOUNT_TOKEN","type":"","value":""},{"name":"servers.sonarqube.env.SONARQUBE_TOKEN","type":"","value":"squ_2ea8c27ba77841e9c51c2171b6b73098b7e167a4"}],"skip_crds":false,"status":"deployed","timeout":300,"upgrade_install":null,"values":["# ponytail: one Deployment+Service template looped over this map instead of\n# 5 near-identical template files — every server here is the same shape\n# (image, optional command/args override, one HTTP port, env vars).\ndefaultResources:\n  requests:\n    cpu: 50m\n    memory: 128Mi\n  limits:\n    memory: 256Mi\n\nservers:\n  grafana:\n    image: grafana/mcp-grafana:latest\n    # ponytail: override the image's baked entrypoint flags\n    # (`--transport sse --address 0.0.0.0:8000`) so `args` is the whole set.\n    command: [\"/app/mcp-grafana\"]\n    # ponytail: -allowed-hosts \"*\" — LiteLLM's MCP client connects by Service\n    # DNS, so mcp-grafana's DNS-rebind Host-header check 403s it otherwise.\n    # \"*\" is safe here: only in-cluster traffic can reach :8000.\n    args: [\"-transport\", \"streamable-http\", \"-address\", \"0.0.0.0:8000\", \"-allowed-hosts\", \"*\", \"-allowed-origins\", \"*\"]\n    port: 8000\n    env:\n      GRAFANA_URL: http://observability-grafana.observability.svc.cluster.local\n      GRAFANA_SERVICE_ACCOUNT_TOKEN: \"\"  # set via Tiltfile/terraform\n\n  sonarqube:\n    image: sonarsource/sonarqube-mcp:latest\n    port: 8080\n    # ponytail: JVM server + downloads analyzer plugins on boot — OOMKills\n    # (exit 137, CrashLoopBackOff) at the 256Mi default. 1Gi limit gives the\n    # container-aware JVM enough headroom; drop it if analyzer set shrinks.\n    resources:\n      requests:\n        cpu: 100m\n        memory: 512Mi\n      limits:\n        memory: 1Gi\n    env:\n      SONARQUBE_TRANSPORT: \"http\"\n      SONARQUBE_HTTP_PORT: \"8080\"\n      SONARQUBE_HTTP_HOST: \"0.0.0.0\"\n      SONARQUBE_MCP_IN_CONTAINER: \"true\"\n      SONARQUBE_URL: http://sonarqube-sonarqube.sonarqube.svc.cluster.local:9000\n      # ponytail: used only for this server's background plugin sync. In HTTP\n      # mode the per-request token comes from the caller's `Authorization:\n      # Bearer` header (LiteLLM sends it — see helm/litellm mcpSonarqubeAuthToken).\n      # Must be a VALID SonarQube user token or bg init logs \"Not authorized\".\n      SONARQUBE_TOKEN: \"\"  # set via Tiltfile/terraform (TF_VAR_sonarqube_mcp_token)\n\n  gitlab:\n    # ponytail: NOT mcp/gitlab (Docker's own catalog wrapper, stdio-only) —\n    # this is the actual zereight/gitlab-mcp project, which supports HTTP\n    # transport via env vars.\n    image: zereight050/gitlab-mcp:latest\n    port: 3002\n    env:\n      STREAMABLE_HTTP: \"true\"\n      HOST: \"0.0.0.0\"\n      PORT: \"3002\"\n      # ponytail: without this the /mcp DNS-rebind guard 403s any request whose\n      # Host header isn't loopback — LiteLLM connects by this Service DNS name.\n      MCP_SERVER_URL: \"http://mcp-servers-gitlab.mcp-servers.svc.cluster.local:3002\"\n      GITLAB_API_URL: http://gitlab-webservice-default.gitlab.svc.cluster.local:8181/api/v4\n      GITLAB_PERSONAL_ACCESS_TOKEN: \"\"  # set via Tiltfile/terraform\n      # ponytail: server holds a static PAT (not per-client OAuth), so this\n      # is the \"who's allowed to call this server\" bearer token — required\n      # by the image whenever STREAMABLE_HTTP + a static PAT are combined.\n      STREAMABLE_HTTP_AUTH_TOKEN: \"\"  # set via Tiltfile/terraform\n\n  playwright:\n    image: mcr.microsoft.com/playwright/mcp:latest\n    command: [\"node\", \"/app/cli.js\"]\n    # ponytail: --allowed-hosts \"*\" — same DNS-rebind guard as the others; the\n    # server otherwise 403s anything not hitting it as localhost:8931.\n    args: [\"--headless\", \"--browser\", \"chromium\", \"--no-sandbox\", \"--port\", \"8931\", \"--host\", \"0.0.0.0\", \"--allowed-hosts\", \"*\"]\n    port: 8931\n    # ponytail: real chromium instance, not a thin API wrapper — needs more\n    # than the other servers' default resources.\n    resources:\n      requests:\n        cpu: 250m\n        memory: 512Mi\n      limits:\n        memory: 1Gi\n"],"verify":false,"version":"0.1.0","wait":false,"wait_for_jobs":false},"sensitive_attributes":[[{"type":"get_attr","value":"repository_password"}],[{"type":"get_attr","value":"set_sensitive"}]],"private":"eyJzY2hlbWFfdmVyc2lvbiI6IjEifQ==","dependencies":["kubernetes_namespace.mcp_servers"]}]},{"mode":"managed","type":"helm_release","name":"minio","provider":"provider[\"registry.opentofu.org/hashicorp/helm\"]","instances":[{"schema_version":1,"attributes":{"atomic":false,"chart":"./../helm/minio","cleanup_on_fail":false,"create_namespace":false,"dependency_update":true,"description":null,"devel":null,"disable_crd_hooks":false,"disable_openapi_validation":false,"disable_webhooks":false,"force_update":false,"id":"minio","keyring":null,"lint":false,"manifest":null,"max_history":0,"metadata":[{"app_version":"","chart":"minio","first_deployed":1788334128,"last_deployed":1788351908,"name":"minio","namespace":"minio","notes":"\nMinIO can be accessed via port 9000 on the following DNS name from within your cluster:\nminio.minio.cluster.local\n\nTo access MinIO from localhost, run the below commands:\n\n  1. export POD_NAME=$(kubectl get pods --namespace minio -l \"release=minio\" -o jsonpath=\"{.items[0].metadata.name}\")\n\n  2. kubectl port-forward $POD_NAME 9000 --namespace minio\n\nRead more about port forwarding here: http://kubernetes.io/docs/user-guide/kubectl/kubectl_port-forward/\n\nYou can now access MinIO server on http://localhost:9000. Follow the below steps to connect to MinIO server with mc client:\n\n  1. Download the MinIO mc client - https://min.io/docs/minio/linux/reference/minio-mc.html#quickstart\n\n  2. export MC_HOST_minio-local=http://$(kubectl get secret --namespace minio minio -o jsonpath=\"{.data.rootUser}\" | base64 --decode):$(kubectl get secret --namespace minio minio -o jsonpath=\"{.data.rootPassword}\" | base64 --decode)@localhost:9000\n\n  3. mc ls minio-local\n\n\n","revision":2,"values":"{\"minio\":{\"buckets\":[{\"name\":\"gitlab-runner-cache\"},{\"name\":\"git-lfs\"},{\"name\":\"gitlab-artifacts\"},{\"name\":\"gitlab-uploads\"},{\"name\":\"gitlab-packages\"},{\"name\":\"gitlab-mr-diffs\"},{\"name\":\"gitlab-dependency-proxy\"},{\"name\":\"gitlab-terraform-state\"},{\"name\":\"gitlab-ci-secure-files\"},{\"name\":\"gitlab-backups\"}],\"consoleIngress\":{\"annotations\":{\"cert-manager.io/cluster-issuer\":\"homelab-ca-issuer\"},\"enabled\":true,\"hosts\":[\"minio-console.local\"],\"ingressClassName\":\"traefik\",\"tls\":[{\"hosts\":[\"minio-console.local\"],\"secretName\":\"minio-console.local-tls\"}]},\"drivesPerNode\":1,\"environment\":{\"MINIO_BROWSER\":\"on\",\"MINIO_IDENTITY_OPENID_CLAIM_NAME\":\"policy\",\"MINIO_IDENTITY_OPENID_CLIENT_ID\":\"(sensitive value)\",\"MINIO_IDENTITY_OPENID_CLIENT_SECRET\":\"(sensitive value)\",\"MINIO_IDENTITY_OPENID_CONFIG_URL\":\"https://authentik.tail60240b.ts.net/application/o/minio/.well-known/openid-configuration\",\"MINIO_IDENTITY_OPENID_DISPLAY_NAME\":\"Authentik\",\"MINIO_IDENTITY_OPENID_REDIRECT_URI\":\"https://minio-console.tail60240b.ts.net/oauth_callback\",\"MINIO_IDENTITY_OPENID_SCOPES\":\"openid,profile,email,policy\"},\"image\":{\"repository\":\"quay.io/minio/minio\",\"tag\":\"RELEASE.2024-11-07T00-52-20Z\"},\"ingress\":{\"annotations\":{\"cert-manager.io/cluster-issuer\":\"homelab-ca-issuer\"},\"enabled\":true,\"hosts\":[\"minio.local\"],\"ingressClassName\":\"traefik\",\"tls\":[{\"hosts\":[\"minio.local\"],\"secretName\":\"minio.local-tls\"}]},\"mode\":\"standalone\",\"persistence\":{\"size\":\"8Gi\"},\"pools\":1,\"replicas\":1,\"resources\":{\"limits\":{\"memory\":\"512Mi\"},\"requests\":{\"cpu\":\"50m\",\"memory\":\"256Mi\"}},\"rootPassword\":\"(sensitive value)\",\"rootUser\":\"admin\"}}","version":"0.1.0"}],"name":"minio","namespace":"minio","pass_credentials":false,"postrender":[],"recreate_pods":false,"render_subchart_notes":true,"replace":false,"repository":null,"repository_ca_file":null,"repository_cert_file":null,"repository_key_file":null,"repository_password":null,"repository_username":null,"reset_values":false,"reuse_values":false,"set":[],"set_list":[],"set_sensitive":[{"name":"minio.environment.MINIO_IDENTITY_OPENID_CLIENT_ID","type":"","value":"dev-minio-oidc-client-id"},{"name":"minio.environment.MINIO_IDENTITY_OPENID_CLIENT_SECRET","type":"","value":"dev-minio-oidc-client-secret-not-for-prod-use"},{"name":"minio.rootPassword","type":"","value":"dev-minio-root-password"}],"skip_crds":false,"status":"deployed","timeout":600,"upgrade_install":null,"values":["minio:\n  image:\n    repository: quay.io/minio/minio\n    # ponytail: pinned — newer builds (tried up through RELEASE.2025-09-07)\n    # have a regression where the WebUI never shows the SSO login button\n    # despite fully correct, live-verified server-side OIDC config. This tag\n    # matches a known-working reference project exactly. Re-test on chart/\n    # image bumps before moving off it.\n    tag: RELEASE.2024-11-07T00-52-20Z\n\n  mode: standalone\n  replicas: 1\n  drivesPerNode: 1\n  pools: 1\n\n  rootUser: admin\n  rootPassword: \"\"  # set via terraform variable\n\n  # ponytail: chart's post-install job (`mc mb`) creates these. GitLab's\n  # consolidated object storage + the CI runner cache all need their bucket\n  # to pre-exist — S3 doesn't auto-create. Names must match the buckets in\n  # helm/gitlab/values.yaml appConfig + the runner cache config.\n  buckets:\n    - name: gitlab-runner-cache\n    - name: git-lfs\n    - name: gitlab-artifacts\n    - name: gitlab-uploads\n    - name: gitlab-packages\n    - name: gitlab-mr-diffs\n    - name: gitlab-dependency-proxy\n    - name: gitlab-terraform-state\n    - name: gitlab-ci-secure-files\n    - name: gitlab-backups\n\n  persistence:\n    size: 8Gi\n\n  resources:\n    requests:\n      cpu: 50m\n      memory: 256Mi\n    limits:\n      memory: 512Mi\n\n  # ponytail: fixed dev client_id/secret matching the Authentik OAuth2\n  # provider created via the API (same one-time-setup pattern as GitLab's).\n  # If minio boots before Authentik/tailscale-serve is reachable (e.g. after\n  # a full cluster/host restart), the discovery fetch below 502s once and\n  # OIDC stays disabled for that pod's lifetime — no retry. Fix: `kubectl\n  # rollout restart deploy/minio -n minio` once Authentik is up. Chart has\n  # no initContainers hook to wait-for-it automatically (only extraContainers,\n  # which doesn't block startup), not worth patching the chart for a homelab.\n  environment:\n    MINIO_BROWSER: \"on\"\n    MINIO_IDENTITY_OPENID_CONFIG_URL: \"https://authentik.tail60240b.ts.net/application/o/minio/.well-known/openid-configuration\"\n    # MINIO_IDENTITY_OPENID_CLIENT_ID / _CLIENT_SECRET set via Tiltfile/terraform (.env)\n    MINIO_IDENTITY_OPENID_CLAIM_NAME: \"policy\"\n    MINIO_IDENTITY_OPENID_SCOPES: \"openid,profile,email,policy\"\n    MINIO_IDENTITY_OPENID_REDIRECT_URI: \"https://minio-console.tail60240b.ts.net/oauth_callback\"\n    MINIO_IDENTITY_OPENID_DISPLAY_NAME: \"Authentik\"\n\n  ingress:\n    enabled: true\n    ingressClassName: traefik\n    annotations:\n      cert-manager.io/cluster-issuer: homelab-ca-issuer\n    hosts:\n      - minio.local\n    tls:\n      - secretName: minio.local-tls\n        hosts:\n          - minio.local\n\n  consoleIngress:\n    enabled: true\n    ingressClassName: traefik\n    annotations:\n      cert-manager.io/cluster-issuer: homelab-ca-issuer\n    hosts:\n      - minio-console.local\n    tls:\n      - secretName: minio-console.local-tls\n        hosts:\n          - minio-console.local\n"],"verify":false,"version":"0.1.0","wait":true,"wait_for_jobs":false},"sensitive_attributes":[[{"type":"get_attr","value":"repository_password"}],[{"type":"get_attr","value":"set_sensitive"}]],"private":"eyJzY2hlbWFfdmVyc2lvbiI6IjEifQ==","dependencies":["kubernetes_namespace.minio"]}]},{"mode":"managed","type":"helm_release","name":"n8n","provider":"provider[\"registry.opentofu.org/hashicorp/helm\"]","instances":[{"schema_version":1,"attributes":{"atomic":false,"chart":"./../helm/n8n","cleanup_on_fail":false,"create_namespace":false,"dependency_update":true,"description":null,"devel":null,"disable_crd_hooks":false,"disable_openapi_validation":false,"disable_webhooks":false,"force_update":false,"id":"n8n","keyring":null,"lint":false,"manifest":null,"max_history":0,"metadata":[{"app_version":"","chart":"n8n","first_deployed":1788335108,"last_deployed":1788351909,"name":"n8n","namespace":"n8n","notes":"1. Get the application URL by running these commands:\n  export POD_NAME=$(kubectl get pods --namespace n8n -l \"app.kubernetes.io/name=n8n,app.kubernetes.io/instance=n8n\" -o jsonpath=\"{.items[0].metadata.name}\")\n  export CONTAINER_PORT=$(kubectl get pod --namespace n8n $POD_NAME -o jsonpath=\"{.spec.containers[0].ports[0].containerPort}\")\n  echo \"Visit http://127.0.0.1:8080 to use your application\"\n  kubectl --namespace n8n port-forward $POD_NAME 8080:$CONTAINER_PORT\n","revision":3,"values":"{\"n8n\":{\"db\":{\"type\":\"postgresdb\"},\"encryptionKey\":\"(sensitive value)\",\"externalPostgresql\":{\"database\":\"n8n\",\"host\":\"n8n-postgres\",\"password\":\"(sensitive value)\",\"port\":5432,\"username\":\"n8n\"},\"main\":{\"extraEnvVars\":{\"EXTERNAL_FRONTEND_HOOKS_URLS\":\"/assets/oidc-frontend-hook.js\",\"EXTERNAL_HOOK_FILES\":\"/hooks/hooks.js\",\"N8N_ADDITIONAL_NON_UI_ROUTES\":\"auth\",\"N8N_EDITOR_BASE_URL\":\"https://n8n.tail60240b.ts.net/\",\"N8N_PROTOCOL\":\"https\",\"N8N_WEBHOOK_BASE\":\"http://localhost:5678/webhook\",\"NODES_EXCLUDE\":\"[]\",\"OIDC_CLIENT_ID\":\"(sensitive value)\",\"OIDC_CLIENT_SECRET\":\"(sensitive value)\",\"OIDC_ISSUER_URL\":\"https://authentik.tail60240b.ts.net/application/o/n8n/\",\"OIDC_REDIRECT_URI\":\"https://n8n.tail60240b.ts.net/auth/oidc/callback\",\"WEBHOOK_URL\":\"https://n8n.tail60240b.ts.net/\"},\"livenessProbe\":{\"timeoutSeconds\":10},\"persistence\":{\"annotations\":{},\"enabled\":true},\"readinessProbe\":{\"timeoutSeconds\":10},\"resources\":{\"limits\":{\"memory\":\"1Gi\"},\"requests\":{\"cpu\":\"50m\",\"memory\":\"512Mi\"}},\"volumeMounts\":[{\"mountPath\":\"/hooks\",\"name\":\"oidc-hooks\",\"readOnly\":true}],\"volumes\":[{\"configMap\":{\"name\":\"n8n-oidc-hooks\"},\"name\":\"oidc-hooks\"}]}},\"postgres\":{\"database\":\"n8n\",\"image\":\"postgres:16\",\"password\":\"(sensitive value)\",\"resources\":{\"limits\":{\"memory\":\"256Mi\"},\"requests\":{\"cpu\":\"50m\",\"memory\":\"128Mi\"}},\"storageSize\":\"2Gi\",\"username\":\"n8n\"}}","version":"0.1.0"}],"name":"n8n","namespace":"n8n","pass_credentials":false,"postrender":[],"recreate_pods":false,"render_subchart_notes":true,"replace":false,"repository":null,"repository_ca_file":null,"repository_cert_file":null,"repository_key_file":null,"repository_password":null,"repository_username":null,"reset_values":false,"reuse_values":false,"set":[],"set_list":[],"set_sensitive":[{"name":"n8n.encryptionKey","type":"","value":"dev-n8n-encryption-key-not-for-prod-use"},{"name":"n8n.externalPostgresql.password","type":"","value":"dev-n8n-db-password-not-for-prod-use"},{"name":"n8n.main.extraEnvVars.OIDC_CLIENT_ID","type":"","value":"dev-n8n-oidc-client-id"},{"name":"n8n.main.extraEnvVars.OIDC_CLIENT_SECRET","type":"","value":"dev-n8n-oidc-client-secret-not-for-prod-use"},{"name":"postgres.password","type":"","value":"dev-n8n-db-password-not-for-prod-use"}],"skip_crds":false,"status":"deployed","timeout":600,"upgrade_install":null,"values":["n8n:\n  # ponytail: postgres (external) instead of sqlite — sqlite's single-writer\n  # lock stalls under the SDLC flows' concurrent webhook fan-out, and the file\n  # lives on a PVC that gets wiped on encryption-key resets. The server is a\n  # plain postgres:16 StatefulSet from this chart's own templates/postgres.yaml\n  # (see the comment there for why not the bundled bitnami subchart).\n  db:\n    type: postgresdb\n  externalPostgresql:\n    host: n8n-postgres\n    port: 5432\n    username: n8n\n    database: n8n\n    password: \"\"  # set via Tiltfile/terraform, matches postgres.password below\n\n  main:\n    persistence:\n      enabled: true\n      # ponytail: chart defaults this to \"helm.sh/resource-policy: keep\",\n      # which makes Tilt refuse to recreate the PVC after a manual delete\n      # (e.g. wiping it to reset the encryption key) — drop it so Tilt fully\n      # owns the PVC lifecycle like every other app's storage in this repo.\n      annotations: {}\n    resources:\n      requests:\n        cpu: 50m\n        memory: 512Mi\n      limits:\n        # ponytail: 512Mi wasn't enough headroom for Node's heap on top of\n        # n8n's own footprint — OOMKilled with \"JavaScript heap out of memory\"\n        memory: 1Gi\n\n    # ponytail: chart's 1s default probe timeout is too tight on this RPi\n    # under load (6 apps running concurrently) — caused a liveness-kill\n    # restart loop even though n8n was actually up. Same fix as sonarqube/\n    # seafile-mariadb's probe timeouts.\n    livenessProbe:\n      timeoutSeconds: 10\n    readinessProbe:\n      timeoutSeconds: 10\n\n    # ponytail: n8n gates native OIDC/SSO behind an Enterprise license.\n    # cweagans/n8n-oidc (MIT) bolts it on via n8n's external-hooks system\n    # instead — no license, no fork, just a JS file + env vars. hooks.js is\n    # mounted from a ConfigMap the Tiltfile builds from helm/n8n/hooks.js.\n    volumes:\n      - name: oidc-hooks\n        configMap:\n          name: n8n-oidc-hooks\n    volumeMounts:\n      - name: oidc-hooks\n        mountPath: /hooks\n        readOnly: true\n\n    # ponytail: fixed dev client_id/secret matching the Authentik OAuth2\n    # provider created via the API (same one-time-setup pattern as the\n    # other apps'). OIDC_ISSUER_URL uses the tailscale hostname so the\n    # server-side discovery fetch and the browser redirect agree on the\n    # same authority — same reasoning as minio/gitlab's OIDC wiring.\n    extraEnvVars:\n      # ponytail: n8n 2.0 disables executeCommand + localFileTrigger by default\n      # (NODES_EXCLUDE defaults to that pair). The SDLC flows are built on\n      # executeCommand — without this, seeded flows fail to activate and a\n      # manual run 502s. \"[]\" re-enables all. Revisit if these flows ever stop\n      # shelling out (GitLab REST node instead of glab, k8s API instead of kubectl).\n      NODES_EXCLUDE: \"[]\"\n      # ponytail: flows call sibling flows by webhook (…/spawn-role, …/dod-check).\n      # In-cluster self-call over localhost — no proxy round-trip, no tailnet.\n      N8N_WEBHOOK_BASE: \"http://localhost:5678/webhook\"\n      EXTERNAL_HOOK_FILES: \"/hooks/hooks.js\"\n      N8N_ADDITIONAL_NON_UI_ROUTES: \"auth\"\n      EXTERNAL_FRONTEND_HOOKS_URLS: \"/assets/oidc-frontend-hook.js\"\n      N8N_PROTOCOL: \"https\"\n      # https://n8n.tail60240b.ts.net / https://authentik.tail60240b.ts.net are string-replaced by terraform/Tiltfile\n      # with this app's and Authentik's tailscale-operator MagicDNS URLs\n      # (https://n8n.\u003ctailnet\u003e.ts.net etc).\n      N8N_EDITOR_BASE_URL: \"https://n8n.tail60240b.ts.net/\"\n      WEBHOOK_URL: \"https://n8n.tail60240b.ts.net/\"\n      OIDC_ISSUER_URL: \"https://authentik.tail60240b.ts.net/application/o/n8n/\"\n      # OIDC_CLIENT_ID / OIDC_CLIENT_SECRET set via Tiltfile/terraform (.env)\n      OIDC_REDIRECT_URI: \"https://n8n.tail60240b.ts.net/auth/oidc/callback\"\n\n# ponytail: flow seeding (and n8n owner setup + API-key minting) moved to the\n# ansible runner — helm/ansible/flows/ + playbooks/n8n.yml. Run it with\n# `scripts/ansible-run.sh n8n`.\n\n# ponytail: consumed by templates/postgres.yaml (this wrapper chart's own\n# template, not the n8n subchart). n8n connects to it via n8n.externalPostgresql\n# above — keep host/user/db/password in sync between the two blocks.\npostgres:\n  image: postgres:16\n  database: n8n\n  username: n8n\n  password: \"\"  # set via Tiltfile/terraform\n  storageSize: 2Gi\n  resources:\n    requests:\n      cpu: 50m\n      memory: 128Mi\n    limits:\n      memory: 256Mi\n"],"verify":false,"version":"0.1.0","wait":true,"wait_for_jobs":false},"sensitive_attributes":[[{"type":"get_attr","value":"repository_password"}],[{"type":"get_attr","value":"set_sensitive"}]],"private":"eyJzY2hlbWFfdmVyc2lvbiI6IjEifQ==","dependencies":["kubernetes_config_map.n8n_oidc_hooks","kubernetes_namespace.n8n"]}]},{"mode":"managed","type":"helm_release","name":"nextcloud","provider":"provider[\"registry.opentofu.org/hashicorp/helm\"]","instances":[{"schema_version":1,"attributes":{"atomic":false,"chart":"./../helm/nextcloud","cleanup_on_fail":false,"create_namespace":false,"dependency_update":true,"description":null,"devel":null,"disable_crd_hooks":false,"disable_openapi_validation":false,"disable_webhooks":false,"force_update":false,"id":"nextcloud","keyring":null,"lint":false,"manifest":null,"max_history":0,"metadata":[{"app_version":"","chart":"nextcloud","first_deployed":1788416083,"last_deployed":1788485876,"name":"nextcloud","namespace":"nextcloud","notes":"1. Get the nextcloud URL by running:\n\n  export POD_NAME=$(kubectl get pods --namespace nextcloud -l \"app.kubernetes.io/name=nextcloud\" -o jsonpath=\"{.items[0].metadata.name}\")\n  echo http://127.0.0.1:8080/\n  kubectl port-forward --namespace nextcloud $POD_NAME 8080:80\n\n2. Get your nextcloud login credentials by running:\n\n  echo User:     admin\n  echo Password: $(kubectl get secret --namespace nextcloud nextcloud -o jsonpath=\"{.data.nextcloud-password}\" | base64 --decode)\n","revision":4,"values":"{\"mariadb\":{\"database\":\"nextcloud\",\"image\":\"mariadb:11.4\",\"password\":\"(sensitive value)\",\"resources\":{\"limits\":{\"memory\":\"512Mi\"},\"requests\":{\"cpu\":\"50m\",\"memory\":\"256Mi\"}},\"rootPassword\":\"(sensitive value)\",\"storageSize\":\"4Gi\",\"username\":\"nextcloud\"},\"nextcloud\":{\"externalDatabase\":{\"database\":\"nextcloud\",\"enabled\":true,\"host\":\"nextcloud-mariadb\",\"password\":\"(sensitive value)\",\"type\":\"mysql\",\"user\":\"nextcloud\"},\"ingress\":{\"annotations\":{\"cert-manager.io/cluster-issuer\":\"homelab-ca-issuer\"},\"className\":\"traefik\",\"enabled\":true,\"tls\":[{\"hosts\":[\"nextcloud.local\"],\"secretName\":\"nextcloud.local-tls\"}]},\"internalDatabase\":{\"enabled\":false},\"lifecycle\":{\"postStartCommand\":[\"/bin/sh\",\"-c\",\"OCC=\\\"runuser -u www-data -- php /var/www/html/occ\\\"\\ni=0\\nuntil $OCC status 2\\u003e/dev/null | grep -q 'installed: true'; do\\n  i=$((i+1)); [ $i -ge 240 ] \\u0026\\u0026 exit 0; sleep 2\\ndone\\n$OCC app:install sociallogin 2\\u003e/dev/null || $OCC app:enable sociallogin || true\\n$OCC config:system:set allow_local_remote_servers --type=boolean --value=true\\n$OCC config:app:set sociallogin custom_providers --value='{\\\"custom_oidc\\\":[{\\\"name\\\":\\\"authentik\\\",\\\"title\\\":\\\"Authentik\\\",\\\"authorizeUrl\\\":\\\"https://authentik.tail60240b.ts.net/application/o/authorize/\\\",\\\"tokenUrl\\\":\\\"http://authentik-server.authentik.svc.cluster.local/application/o/token/\\\",\\\"userInfoUrl\\\":\\\"http://authentik-server.authentik.svc.cluster.local/application/o/userinfo/\\\",\\\"logoutUrl\\\":\\\"\\\",\\\"clientId\\\":\\\"dev-nextcloud-oidc-client-id\\\",\\\"clientSecret\\\":\\\"dev-nextcloud-oidc-client-secret-not-for-prod-use\\\",\\\"scope\\\":\\\"openid profile email\\\",\\\"groupsClaim\\\":\\\"groups\\\",\\\"displayNameClaim\\\":\\\"name\\\",\\\"style\\\":\\\"\\\",\\\"defaultGroup\\\":\\\"\\\"}]}'\\n$OCC config:app:set sociallogin update_profile_on_login --value=1\\n$OCC config:app:set sociallogin disable_registration --value=0\\n# ponytail: auto-redirect login page straight to Authentik. Reach the\\n# local login form at /login?noredir=1 if you ever need it.\\n$OCC config:system:set social_login_auto_redirect --type=boolean --value=true\\n\"]},\"mariadb\":{\"enabled\":false},\"nextcloud\":{\"extraEnv\":[{\"name\":\"NEXTCLOUD_TRUSTED_DOMAINS\",\"value\":\"nextcloud.local nextcloud.tail60240b.ts.net\"},{\"name\":\"OVERWRITEHOST\",\"value\":\"nextcloud.tail60240b.ts.net\"},{\"name\":\"OVERWRITEPROTOCOL\",\"value\":\"https\"},{\"name\":\"OVERWRITECLIURL\",\"value\":\"https://nextcloud.tail60240b.ts.net\"},{\"name\":\"TRUSTED_PROXIES\",\"value\":\"10.0.0.0/8 100.64.0.0/10\"}],\"host\":\"nextcloud.local\",\"password\":\"(sensitive value)\",\"podSecurityContext\":{\"fsGroup\":33,\"fsGroupChangePolicy\":\"OnRootMismatch\"},\"username\":\"admin\"},\"persistence\":{\"accessMode\":\"ReadWriteOnce\",\"enabled\":true,\"size\":\"20Gi\"},\"redis\":{\"enabled\":false},\"resources\":{\"limits\":{\"memory\":\"1536Mi\"},\"requests\":{\"cpu\":\"100m\",\"memory\":\"512Mi\"}},\"startupProbe\":{\"enabled\":true,\"failureThreshold\":120,\"initialDelaySeconds\":30,\"periodSeconds\":10}}}","version":"0.1.0"}],"name":"nextcloud","namespace":"nextcloud","pass_credentials":false,"postrender":[],"recreate_pods":false,"render_subchart_notes":true,"replace":false,"repository":null,"repository_ca_file":null,"repository_cert_file":null,"repository_key_file":null,"repository_password":null,"repository_username":null,"reset_values":false,"reuse_values":false,"set":[],"set_list":[],"set_sensitive":[{"name":"mariadb.password","type":"","value":"dev-nextcloud-db-password"},{"name":"mariadb.rootPassword","type":"","value":"dev-nextcloud-db-root-password"},{"name":"nextcloud.externalDatabase.password","type":"","value":"dev-nextcloud-db-password"},{"name":"nextcloud.nextcloud.password","type":"","value":"dev-nextcloud-admin-password"}],"skip_crds":false,"status":"deployed","timeout":1500,"upgrade_install":null,"values":["nextcloud:\n  nextcloud:\n    # ponytail: ingress rule host stays the LAN name; the tailnet name is the\n    # \"real\" external URL Nextcloud bakes into generated links, injected via\n    # OVERWRITEHOST/CLIURL below. nextcloud.tail60240b.ts.net (no scheme) / https://nextcloud.tail60240b.ts.net (with\n    # https) are string-replaced by terraform + Tiltfile with the tailscale\n    # operator MagicDNS name (nextcloud.\u003ctailnet\u003e.ts.net).\n    host: nextcloud.local\n    username: admin\n    password: \"\"  # set via Tiltfile/terraform\n    extraEnv:\n      # ponytail: both names must be trusted or Nextcloud 400s the request whose\n      # Host header it doesn't recognise (tailnet host arrives via the operator).\n      - name: NEXTCLOUD_TRUSTED_DOMAINS\n        value: \"nextcloud.local nextcloud.tail60240b.ts.net\"\n      - name: OVERWRITEHOST\n        value: nextcloud.tail60240b.ts.net\n      - name: OVERWRITEPROTOCOL\n        value: https\n      - name: OVERWRITECLIURL\n        value: https://nextcloud.tail60240b.ts.net\n      # ponytail: traefik pod (cluster CIDR) + tailscale operator proxy\n      # (100.64/10 CGNAT) sit in front — without this, X-Forwarded-* is\n      # ignored and every generated link points at the in-pod address.\n      - name: TRUSTED_PROXIES\n        value: \"10.0.0.0/8 100.64.0.0/10\"\n    # ponytail: single pod, so APCu local cache is enough — no redis subchart,\n    # no \"don't name the Service 'redis'\" dance seafile needed. apcu.config.php\n    # is on by default via defaultConfigs.\n\n    # ponytail: chart default fsGroupChangePolicy is Always, so the kubelet\n    # recursively chowns all ~15k files of the data PVC on every pod start —\n    # minutes of stall on local-path storage, and it made helm --wait time out\n    # (\"Setting volume ownership ... is taking longer than expected\"). This\n    # replaces the chart's default block, so fsGroup: 33 must stay. OnRootMismatch\n    # only chowns when the volume root's gid is wrong (i.e. first boot only).\n    podSecurityContext:\n      fsGroup: 33\n      fsGroupChangePolicy: OnRootMismatch\n\n  # ponytail: OAuth wiring via `occ` in postStart — the chart has no init\n  # hook-point after the entrypoint's first-boot install. Polls until installed,\n  # then every boot re-applies the Social Login provider so URL changes take\n  # effect. Key is nextcloud.lifecycle (chart root), NOT nextcloud.nextcloud.*.\n  # https://authentik.tail60240b.ts.net / dev-nextcloud-oidc-client-id / _SECRET__ are string-\n  # replaced on the rendered YAML by terraform + Tiltfile (not --set — this is\n  # one multi-line shell string). authorizeUrl is the external tailnet URL (the\n  # browser hits it); token + userinfo are in-cluster http (the pod hits them).\n  lifecycle:\n    postStartCommand:\n      - /bin/sh\n      - -c\n      - |\n        OCC=\"runuser -u www-data -- php /var/www/html/occ\"\n        i=0\n        until $OCC status 2\u003e/dev/null | grep -q 'installed: true'; do\n          i=$((i+1)); [ $i -ge 240 ] \u0026\u0026 exit 0; sleep 2\n        done\n        $OCC app:install sociallogin 2\u003e/dev/null || $OCC app:enable sociallogin || true\n        $OCC config:system:set allow_local_remote_servers --type=boolean --value=true\n        $OCC config:app:set sociallogin custom_providers --value='{\"custom_oidc\":[{\"name\":\"authentik\",\"title\":\"Authentik\",\"authorizeUrl\":\"https://authentik.tail60240b.ts.net/application/o/authorize/\",\"tokenUrl\":\"http://authentik-server.authentik.svc.cluster.local/application/o/token/\",\"userInfoUrl\":\"http://authentik-server.authentik.svc.cluster.local/application/o/userinfo/\",\"logoutUrl\":\"\",\"clientId\":\"dev-nextcloud-oidc-client-id\",\"clientSecret\":\"dev-nextcloud-oidc-client-secret-not-for-prod-use\",\"scope\":\"openid profile email\",\"groupsClaim\":\"groups\",\"displayNameClaim\":\"name\",\"style\":\"\",\"defaultGroup\":\"\"}]}'\n        $OCC config:app:set sociallogin update_profile_on_login --value=1\n        $OCC config:app:set sociallogin disable_registration --value=0\n        # ponytail: auto-redirect login page straight to Authentik. Reach the\n        # local login form at /login?noredir=1 if you ever need it.\n        $OCC config:system:set social_login_auto_redirect --type=boolean --value=true\n\n  # ponytail: first boot rsyncs ~10k files of /var/www/html onto local-path\n  # storage (slow on a Docker-Desktop bind mount) - the default liveness probe\n  # SIGKILLs the container mid-init (exit 137) and it never finishes. startupProbe\n  # suspends liveness until install completes; 120 x 10s = 20 min ceiling. Raise\n  # failureThreshold if a fresh PVC still gets killed.\n  startupProbe:\n    enabled: true\n    initialDelaySeconds: 30\n    periodSeconds: 10\n    failureThreshold: 120\n\n  internalDatabase:\n    enabled: false\n\n  # ponytail: bundled bitnami mariadb off — replaced by templates/mariadb.yaml\n  # (plain official mariadb:11 image, same pattern as helm/n8n's postgres).\n  mariadb:\n    enabled: false\n  externalDatabase:\n    enabled: true\n    type: mysql\n    host: nextcloud-mariadb\n    database: nextcloud\n    user: nextcloud\n    password: \"\"  # set via Tiltfile/terraform\n\n  redis:\n    enabled: false\n\n  persistence:\n    enabled: true\n    accessMode: ReadWriteOnce\n    size: 20Gi\n\n  resources:\n    requests:\n      cpu: 100m\n      memory: 512Mi\n    limits:\n      memory: 1536Mi\n\n  ingress:\n    enabled: true\n    className: traefik\n    annotations:\n      cert-manager.io/cluster-issuer: homelab-ca-issuer\n    tls:\n      - secretName: nextcloud.local-tls\n        hosts:\n          - nextcloud.local\n\n# ponytail: consumed by templates/mariadb.yaml (this wrapper chart's own\n# template). Keep database/user/password in sync with nextcloud.externalDatabase.\nmariadb:\n  image: mariadb:11.4\n  database: nextcloud\n  username: nextcloud\n  password: \"\"       # set via terraform / Tiltfile\n  rootPassword: \"\"   # set via terraform / Tiltfile\n  storageSize: 4Gi\n  resources:\n    requests:\n      cpu: 50m\n      memory: 256Mi\n    limits:\n      memory: 512Mi\n"],"verify":false,"version":"0.1.0","wait":true,"wait_for_jobs":false},"sensitive_attributes":[[{"type":"get_attr","value":"repository_password"}],[{"type":"get_attr","value":"set_sensitive"}],[{"type":"get_attr","value":"values"},{"type":"index","value":{"value":0,"type":"number"}}]],"private":"eyJzY2hlbWFfdmVyc2lvbiI6IjEifQ==","dependencies":["kubernetes_namespace.nextcloud"]}]},{"mode":"managed","type":"helm_release","name":"observability","provider":"provider[\"registry.opentofu.org/hashicorp/helm\"]","instances":[{"schema_version":1,"attributes":{"atomic":false,"chart":"./../helm/observability","cleanup_on_fail":false,"create_namespace":false,"dependency_update":true,"description":null,"devel":null,"disable_crd_hooks":false,"disable_openapi_validation":false,"disable_webhooks":false,"force_update":false,"id":"observability","keyring":null,"lint":false,"manifest":null,"max_history":0,"metadata":[{"app_version":"","chart":"observability","first_deployed":1788334129,"last_deployed":1788489371,"name":"observability","namespace":"observability","notes":"The Prometheus server can be accessed via port 80 on the following DNS name from within your cluster:\nobservability-prometheus-server.observability.svc.cluster.local\n\n\nGet the Prometheus server URL by running these commands in the same shell:\n  export POD_NAME=$(kubectl get pods --namespace observability -l \"app.kubernetes.io/name=prometheus,app.kubernetes.io/instance=observability\" -o jsonpath=\"{.items[0].metadata.name}\")\n  kubectl --namespace observability port-forward $POD_NAME 9090\n\n\n\n\n\nFor more information on running Prometheus, visit:\nhttps://prometheus.io/\n\n1. Get the application URL by running these commands:\n  export POD_NAME=$(kubectl get pods --namespace observability -l \"app.kubernetes.io/name=prometheus-node-exporter,app.kubernetes.io/instance=observability\" -o jsonpath=\"{.items[0].metadata.name}\")\n  echo \"Visit http://127.0.0.1:9100 to use your application\"\n  kubectl port-forward --namespace observability $POD_NAME 9100\nkube-state-metrics is a simple service that listens to the Kubernetes API server and generates metrics about the state of the objects.\nThe exposed metrics can be found here:\nhttps://github.com/kubernetes/kube-state-metrics/blob/master/docs/README.md#exposed-metrics\n\nThe metrics are exported on the HTTP endpoint /metrics on the listening port.\nIn your case, observability-kube-state-metrics.observability.svc.cluster.local:8080/metrics\n\nThey are served either as plaintext or protobuf depending on the Accept header.\nThey are designed to be consumed either by Prometheus itself or by a scraper that is compatible with scraping a Prometheus client endpoint.\n\nWelcome to Grafana Alloy!\n\n***********************************************************************\n Welcome to Grafana Loki\n Chart version: 7.3.0\n Chart Name: loki\n Loki version: 3.6.12\n***********************************************************************\n\n** Please be patient while the chart is being deployed **\n\nTip:\n\n  Watch the deployment status using the command: kubectl get pods -w --namespace observability\n\nIf pods are taking too long to schedule make sure pod affinity can be fulfilled in the current cluster.\n\n***********************************************************************\nInstalled components:\n***********************************************************************\n* loki\n\nLoki has been deployed as a single binary.\nThis means a single pod is handling reads and writes. You can scale that pod vertically by adding more CPU and memory resources.\n\n\n***********************************************************************\nSending logs to Loki\n***********************************************************************\n\nYou can send logs from inside the cluster using the cluster DNS:\n\nhttp://observability-loki.observability.svc.cluster.local:3100/loki/api/v1/push\n\nYou can test to send data from outside the cluster by port-forwarding the gateway to your local machine:\n\n  kubectl port-forward --namespace observability svc/observability-loki 3100:3100 \u0026\n\nAnd then using http://127.0.0.1:3100/loki/api/v1/push URL as shown below:\n\n```\ncurl -H \"Content-Type: application/json\" -XPOST -s \"http://127.0.0.1:3100/loki/api/v1/push\"  \\\n--data-raw \"{\\\"streams\\\": [{\\\"stream\\\": {\\\"job\\\": \\\"test\\\"}, \\\"values\\\": [[\\\"$(date +%s)000000000\\\", \\\"fizzbuzz\\\"]]}]}\"\n```\n\nThen verify that Loki did receive the data using the following command:\n\n```\ncurl \"http://127.0.0.1:3100/loki/api/v1/query_range\" --data-urlencode 'query={job=\"test\"}' | jq .data.result\n```\n\n***********************************************************************\nConnecting Grafana to Loki\n***********************************************************************\n\nIf Grafana operates within the cluster, you'll set up a new Loki datasource by utilizing the following URL:\n\nhttp://observability-loki.observability.svc.cluster.local:3100/\n\n1. Get your 'admin' user password by running:\n\n   kubectl get secret --namespace observability observability-grafana -o jsonpath=\"{.data.admin-password}\" | base64 --decode ; echo\n\n\n2. The Grafana server can be accessed via port 80 on the following DNS name from within your cluster:\n\n   observability-grafana.observability.svc.cluster.local\n\n   If you bind grafana to 80, please update values in values.yaml and reinstall:\n   ```\n   securityContext:\n     runAsUser: 0\n     runAsGroup: 0\n     fsGroup: 0\n\n   command:\n   - \"setcap\"\n   - \"'cap_net_bind_service=+ep'\"\n   - \"/usr/sbin/grafana-server \u0026\u0026\"\n   - \"sh\"\n   - \"/run.sh\"\n   ```\n   Details refer to https://grafana.com/docs/installation/configuration/#http-port.\n   Or grafana would always crash.\n\n   From outside the cluster, the server URL(s) are:\n     http://grafana.local\n\n3. Login with the password from step 1 and the username: admin\n\nWelcome to Grafana Mimir!\nRemote write endpoints for Prometheus or Grafana Agent:\nIngress is not enabled, see the gateway.ingress values.\nFrom inside the cluster:\n  http://observability-mimir-gateway.observability.svc:80/api/v1/push\n\nRead address, Grafana data source (Prometheus) URL:\nIngress is not enabled, see the gateway.ingress values.\nFrom inside the cluster:\n  http://observability-mimir-gateway.observability.svc:80/prometheus\n\n**IMPORTANT**: Always consult CHANGELOG.md file at https://github.com/grafana/mimir/blob/main/operations/helm/charts/mimir-distributed/CHANGELOG.md and the deprecation list there to learn about breaking changes that require action during upgrade.\n","revision":9,"values":"{\"alloy\":{\"alloy\":{\"configMap\":{\"content\":\"// ── K8s pod logs → Loki ──────────────────────────────────────────────\\ndiscovery.kubernetes \\\"pods\\\" {\\n  role = \\\"pod\\\"\\n}\\n\\ndiscovery.relabel \\\"pod_logs\\\" {\\n  targets = discovery.kubernetes.pods.targets\\n  rule {\\n    source_labels = [\\\"__meta_kubernetes_pod_node_name\\\"]\\n    target_label  = \\\"node\\\"\\n  }\\n  rule {\\n    source_labels = [\\\"__meta_kubernetes_namespace\\\"]\\n    target_label  = \\\"namespace\\\"\\n  }\\n  rule {\\n    source_labels = [\\\"__meta_kubernetes_pod_name\\\"]\\n    target_label  = \\\"pod\\\"\\n  }\\n  rule {\\n    source_labels = [\\\"__meta_kubernetes_pod_container_name\\\"]\\n    target_label  = \\\"container\\\"\\n  }\\n  rule {\\n    source_labels = [\\\"__meta_kubernetes_pod_label_app_kubernetes_io_name\\\"]\\n    target_label  = \\\"app\\\"\\n  }\\n}\\n\\nloki.source.kubernetes \\\"pods\\\" {\\n  targets    = discovery.relabel.pod_logs.output\\n  forward_to = [loki.write.default.receiver]\\n}\\n\\nloki.write \\\"default\\\" {\\n  endpoint {\\n    url = \\\"http://observability-loki.observability.svc.cluster.local:3100/loki/api/v1/push\\\"\\n  }\\n}\\n\\n// ── OTLP receiver (apps → Alloy) ─────────────────────────────────────\\notelcol.receiver.otlp \\\"default\\\" {\\n  http { endpoint = \\\"0.0.0.0:4318\\\" }\\n  grpc { endpoint = \\\"0.0.0.0:4317\\\" }\\n  output {\\n    metrics = [otelcol.exporter.prometheus.mimir.input]\\n    logs    = [otelcol.exporter.loki.default.input]\\n    traces  = [otelcol.exporter.otlp.tempo.input]\\n  }\\n}\\n\\n// ── OTLP metrics → Mimir ─────────────────────────────────────────────\\notelcol.exporter.prometheus \\\"mimir\\\" {\\n  forward_to = [prometheus.remote_write.mimir.receiver]\\n}\\n\\nprometheus.remote_write \\\"mimir\\\" {\\n  endpoint {\\n    url = \\\"http://observability-mimir-distributor.observability.svc.cluster.local:8080/api/v1/push\\\"\\n  }\\n}\\n\\n// ── OTLP logs → Loki ─────────────────────────────────────────────────\\notelcol.exporter.loki \\\"default\\\" {\\n  forward_to = [loki.write.default.receiver]\\n}\\n\\n// ── OTLP traces → Tempo ──────────────────────────────────────────────\\notelcol.exporter.otlp \\\"tempo\\\" {\\n  client {\\n    endpoint = \\\"observability-tempo.observability.svc.cluster.local:4317\\\"\\n    tls { insecure = true }\\n  }\\n}\\n\"},\"extraPorts\":[{\"name\":\"otlp-grpc\",\"port\":4317,\"protocol\":\"TCP\",\"targetPort\":4317},{\"name\":\"otlp-http\",\"port\":4318,\"protocol\":\"TCP\",\"targetPort\":4318}]},\"clustering\":{\"enabled\":false},\"rbac\":{\"create\":true},\"serviceAccount\":{\"create\":true}},\"grafana\":{\"adminPassword\":\"dev-grafana-admin-password\",\"assertNoLeakedSecrets\":false,\"datasources\":{\"datasources.yaml\":{\"apiVersion\":1,\"datasources\":[{\"isDefault\":true,\"jsonData\":{\"timeInterval\":\"15s\"},\"name\":\"Mimir\",\"type\":\"prometheus\",\"uid\":\"mimir\",\"url\":\"http://observability-mimir-query-frontend.observability.svc.cluster.local:8080/prometheus\"},{\"jsonData\":{\"timeInterval\":\"15s\"},\"name\":\"Prometheus\",\"type\":\"prometheus\",\"uid\":\"prometheus\",\"url\":\"http://observability-prometheus-server.observability.svc.cluster.local\"},{\"name\":\"Loki\",\"type\":\"loki\",\"uid\":\"loki\",\"url\":\"http://observability-loki.observability.svc.cluster.local:3100\"},{\"jsonData\":{\"serviceMap\":{\"datasourceUid\":\"mimir\"},\"tracesToLogsV2\":{\"datasourceUid\":\"loki\"}},\"name\":\"Tempo\",\"type\":\"tempo\",\"uid\":\"tempo\",\"url\":\"http://observability-tempo.observability.svc.cluster.local:3100\"}]}},\"grafana.ini\":{\"auth\":{\"disable_login_form\":\"false\",\"oauth_allow_insecure_email_lookup\":\"true\"},\"auth.generic_oauth\":{\"allow_sign_up\":\"true\",\"api_url\":\"http://authentik-server.authentik.svc.cluster.local/application/o/userinfo/\",\"auth_url\":\"https://authentik.tail60240b.ts.net/application/o/authorize/\",\"client_id\":\"dev-grafana-oidc-client-id\",\"client_secret\":\"dev-grafana-oidc-client-secret-not-for-prod-use\",\"enabled\":\"true\",\"name\":\"Authentik\",\"role_attribute_path\":\"email == 'edwardlimkoksiong1994@gmail.com' \\u0026\\u0026 'Admin' || 'Viewer'\",\"scopes\":\"openid profile email\",\"token_url\":\"http://authentik-server.authentik.svc.cluster.local/application/o/token/\"},\"server\":{\"root_url\":\"https://grafana.tail60240b.ts.net\"}},\"ingress\":{\"annotations\":{\"cert-manager.io/cluster-issuer\":\"homelab-ca-issuer\"},\"enabled\":true,\"hosts\":[\"grafana.local\"],\"ingressClassName\":\"traefik\",\"tls\":[{\"hosts\":[\"grafana.local\"],\"secretName\":\"grafana.local-tls\"}]},\"persistence\":{\"enabled\":true,\"size\":\"2Gi\"},\"resources\":{\"limits\":{\"memory\":\"256Mi\"},\"requests\":{\"cpu\":\"50m\",\"memory\":\"128Mi\"}},\"sidecar\":{\"dashboards\":{\"enabled\":true,\"folder\":\"/tmp/dashboards\",\"label\":\"grafana_dashboard\",\"provider\":{\"foldersFromFilesStructure\":false},\"searchNamespace\":\"observability\"}}},\"loki\":{\"backend\":{\"replicas\":0},\"chunksCache\":{\"enabled\":false},\"deploymentMode\":\"SingleBinary\",\"gateway\":{\"enabled\":false},\"loki\":{\"auth_enabled\":false,\"commonConfig\":{\"replication_factor\":1},\"schemaConfig\":{\"configs\":[{\"from\":\"2024-01-01\",\"index\":{\"period\":\"24h\",\"prefix\":\"index_\"},\"object_store\":\"filesystem\",\"schema\":\"v13\",\"store\":\"tsdb\"}]},\"storage\":{\"type\":\"filesystem\"}},\"lokiCanary\":{\"enabled\":false},\"read\":{\"replicas\":0},\"resultsCache\":{\"enabled\":false},\"singleBinary\":{\"persistence\":{\"enabled\":true,\"size\":\"10Gi\"},\"replicas\":1,\"resources\":{\"limits\":{\"memory\":\"512Mi\"},\"requests\":{\"cpu\":\"50m\",\"memory\":\"256Mi\"}}},\"test\":{\"enabled\":false},\"write\":{\"replicas\":0}},\"mimir-distributed\":{\"alertmanager\":{\"enabled\":false},\"compactor\":{\"persistentVolume\":{\"enabled\":true,\"size\":\"10Gi\"},\"replicas\":1,\"resources\":{\"limits\":{\"memory\":\"256Mi\"},\"requests\":{\"cpu\":\"50m\",\"memory\":\"128Mi\"}}},\"distributor\":{\"replicas\":1,\"resources\":{\"limits\":{\"memory\":\"256Mi\"},\"requests\":{\"cpu\":\"50m\",\"memory\":\"128Mi\"}}},\"ingester\":{\"persistentVolume\":{\"enabled\":true,\"size\":\"10Gi\"},\"replicas\":1,\"resources\":{\"limits\":{\"memory\":\"512Mi\"},\"requests\":{\"cpu\":\"50m\",\"memory\":\"256Mi\"}},\"zoneAwareReplication\":{\"enabled\":false}},\"kafka\":{\"enabled\":false},\"mimir\":{\"structuredConfig\":{\"blocks_storage\":{\"backend\":\"filesystem\",\"filesystem\":{\"dir\":\"/data/blocks\"}},\"common\":{\"storage\":{\"backend\":\"filesystem\",\"filesystem\":{\"dir\":\"/data\"}}},\"compactor\":{\"data_dir\":\"/data/compactor\"},\"ingest_storage\":{\"enabled\":false},\"ingester\":{\"push_grpc_method_enabled\":true},\"multitenancy_enabled\":false,\"usage_stats\":{\"enabled\":false}}},\"minio\":{\"enabled\":false},\"overrides_exporter\":{\"enabled\":false},\"querier\":{\"replicas\":1,\"resources\":{\"limits\":{\"memory\":\"256Mi\"},\"requests\":{\"cpu\":\"50m\",\"memory\":\"128Mi\"}}},\"query_frontend\":{\"replicas\":1,\"resources\":{\"limits\":{\"memory\":\"256Mi\"},\"requests\":{\"cpu\":\"50m\",\"memory\":\"128Mi\"}}},\"query_scheduler\":{\"enabled\":false},\"rollout_operator\":{\"enabled\":false},\"ruler\":{\"enabled\":false},\"store_gateway\":{\"persistentVolume\":{\"enabled\":true,\"size\":\"10Gi\"},\"replicas\":1,\"resources\":{\"limits\":{\"memory\":\"256Mi\"},\"requests\":{\"cpu\":\"50m\",\"memory\":\"128Mi\"}},\"zoneAwareReplication\":{\"enabled\":false}}},\"prometheus\":{\"alertmanager\":{\"enabled\":false},\"kube-state-metrics\":{\"enabled\":true},\"prometheus-node-exporter\":{\"enabled\":true},\"prometheus-pushgateway\":{\"enabled\":false},\"server\":{\"global\":{\"evaluation_interval\":\"15s\",\"scrape_interval\":\"15s\"},\"persistentVolume\":{\"enabled\":true,\"size\":\"10Gi\"},\"remoteWrite\":[{\"url\":\"http://observability-mimir-distributor.observability.svc.cluster.local:8080/api/v1/push\"}],\"resources\":{\"limits\":{\"memory\":\"2Gi\"},\"requests\":{\"cpu\":\"50m\",\"memory\":\"512Mi\"}},\"retention\":\"3d\"}},\"tailnetDomain\":\"tail60240b.ts.net\",\"tempo\":{\"persistence\":{\"enabled\":true,\"size\":\"10Gi\"},\"resources\":{\"limits\":{\"memory\":\"512Mi\"},\"requests\":{\"cpu\":\"50m\",\"memory\":\"256Mi\"}},\"tempo\":{\"metricsGenerator\":{\"enabled\":true,\"processor\":{\"service_graphs\":{},\"span_metrics\":{\"enable_target_info\":true}},\"remoteWriteUrl\":\"http://observability-mimir-distributor.observability.svc.cluster.local:8080/api/v1/push\",\"storage\":{\"path\":\"/var/tempo/generator/wal\"},\"traces_storage\":{\"path\":\"/var/tempo/generator/traces\"}},\"overrides\":{\"defaults\":{\"metrics_generator\":{\"processors\":[\"service-graphs\",\"span-metrics\"]}}},\"receivers\":{\"otlp\":{\"protocols\":{\"grpc\":{\"endpoint\":\"0.0.0.0:4317\"},\"http\":{\"endpoint\":\"0.0.0.0:4318\"}}}},\"storage\":{\"trace\":{\"backend\":\"local\",\"local\":{\"path\":\"/var/tempo/traces\"},\"wal\":{\"path\":\"/var/tempo/wal\"}}}}},\"tsHost\":\"desktop-qv5aogf.tail60240b.ts.net\"}","version":"0.1.0"}],"name":"observability","namespace":"observability","pass_credentials":false,"postrender":[],"recreate_pods":false,"render_subchart_notes":true,"replace":false,"repository":null,"repository_ca_file":null,"repository_cert_file":null,"repository_key_file":null,"repository_password":null,"repository_username":null,"reset_values":false,"reuse_values":false,"set":[],"set_list":[],"set_sensitive":[],"skip_crds":false,"status":"deployed","timeout":900,"upgrade_install":null,"values":["# ponytail: terraform/Tiltfile do a plain string-replace of desktop-qv5aogf.tail60240b.ts.net across\n# this file, so exposing it as a value lets templates/dashboards.yaml reuse the\n# substituted host without a second injection path.\ntsHost: \"desktop-qv5aogf.tail60240b.ts.net\"\n# ponytail: tailnet MagicDNS suffix — dashboards/*.json use https://\u003capp\u003e.tail60240b.ts.net\n# for their nav links now that each app has its own tailscale-operator host.\ntailnetDomain: \"tail60240b.ts.net\"\n\ngrafana:\n  # ponytail: chart refuses to render any sensitive key (client_secret,\n  # adminPassword, etc.) in plain values as a guard against accidental\n  # secret commits. Our placeholder-replacement approach handles this at\n  # Tiltfile load time — disable the guard so helm template succeeds.\n  assertNoLeakedSecrets: false\n\n  adminPassword: \"dev-grafana-admin-password\"\n\n  grafana.ini:\n    server:\n      root_url: \"https://grafana.tail60240b.ts.net\"\n    auth:\n      # ponytail: keep login form so local admin still works as fallback\n      disable_login_form: \"false\"\n      # ponytail: Grafana 11+ defaults this false and stops matching an OAuth\n      # login to an existing user by email — so when Authentik's `sub` changes\n      # (provider re-provisioned on a cluster rebuild), the old user row is\n      # orphaned and login dies with \"user.sync: unable to create user: user\n      # not found\". Authentik verifies the email, so matching on it is safe here.\n      oauth_allow_insecure_email_lookup: \"true\"\n    auth.generic_oauth:\n      enabled: \"true\"\n      name: \"Authentik\"\n      client_id: \"dev-grafana-oidc-client-id\"\n      client_secret: \"dev-grafana-oidc-client-secret-not-for-prod-use\"\n      scopes: \"openid profile email\"\n      auth_url: \"https://authentik.tail60240b.ts.net/application/o/authorize/\"\n      # ponytail: token/userinfo use in-cluster DNS — browser never touches\n      # these endpoints so no need for the Tailscale HTTPS port here.\n      token_url: \"http://authentik-server.authentik.svc.cluster.local/application/o/token/\"\n      api_url: \"http://authentik-server.authentik.svc.cluster.local/application/o/userinfo/\"\n      role_attribute_path: \"email == 'edwardlimkoksiong1994@gmail.com' \u0026\u0026 'Admin' || 'Viewer'\"\n      allow_sign_up: \"true\"\n\n  datasources:\n    datasources.yaml:\n      apiVersion: 1\n      datasources:\n        - name: Mimir\n          uid: mimir\n          type: prometheus\n          url: http://observability-mimir-query-frontend.observability.svc.cluster.local:8080/prometheus\n          isDefault: true\n          jsonData:\n            timeInterval: 15s\n        - name: Prometheus\n          uid: prometheus\n          type: prometheus\n          url: http://observability-prometheus-server.observability.svc.cluster.local\n          jsonData:\n            timeInterval: 15s\n        - name: Loki\n          uid: loki\n          type: loki\n          url: http://observability-loki.observability.svc.cluster.local:3100\n        - name: Tempo\n          uid: tempo\n          type: tempo\n          url: http://observability-tempo.observability.svc.cluster.local:3100\n          jsonData:\n            tracesToLogsV2:\n              datasourceUid: loki\n            serviceMap:\n              datasourceUid: mimir\n\n  ingress:\n    enabled: true\n    ingressClassName: traefik\n    annotations:\n      cert-manager.io/cluster-issuer: homelab-ca-issuer\n    hosts:\n      - grafana.local\n    tls:\n      - secretName: grafana.local-tls\n        hosts:\n          - grafana.local\n\n  persistence:\n    enabled: true\n    size: 2Gi\n\n  # ponytail: sidecar auto-loads any ConfigMap in this namespace labelled\n  # grafana_dashboard. templates/dashboards.yaml emits one per dashboards/*.json.\n  sidecar:\n    dashboards:\n      enabled: true\n      label: grafana_dashboard\n      searchNamespace: observability\n      folder: /tmp/dashboards\n      provider:\n        foldersFromFilesStructure: false\n\n  resources:\n    requests:\n      cpu: 50m\n      memory: 128Mi\n    limits:\n      memory: 256Mi\n\n# ── Loki ──────────────────────────────────────────────────────────────────────\nloki:\n  # ponytail: SingleBinary = one pod, no object storage, no kafka, no cache.\n  # SimpleScalable (chart default) needs 3 write + 3 read + 3 backend pods —\n  # far too heavy for a single-node homelab.\n  deploymentMode: SingleBinary\n\n  loki:\n    auth_enabled: false\n    commonConfig:\n      replication_factor: 1\n    storage:\n      type: filesystem\n    schemaConfig:\n      configs:\n        - from: \"2024-01-01\"\n          store: tsdb\n          object_store: filesystem\n          schema: v13\n          index:\n            prefix: index_\n            period: 24h\n\n  singleBinary:\n    replicas: 1\n    persistence:\n      enabled: true\n      size: 10Gi\n    resources:\n      requests:\n        cpu: 50m\n        memory: 256Mi\n      limits:\n        memory: 512Mi\n\n  # ponytail: zero out the scalable-mode components that SingleBinary doesn't use\n  read:\n    replicas: 0\n  write:\n    replicas: 0\n  backend:\n    replicas: 0\n\n  gateway:\n    enabled: false\n  lokiCanary:\n    enabled: false\n  test:\n    enabled: false\n  # ponytail: caches need memcached sub-charts — overkill for homelab\n  chunksCache:\n    enabled: false\n  resultsCache:\n    enabled: false\n\n# ── Tempo ─────────────────────────────────────────────────────────────────────\ntempo:\n  tempo:\n    # ponytail: metrics-generator turns spans into RED metrics (rate/errors/\n    # duration) and remote-writes them to Mimir — that's the latency + traffic\n    # panels. Needs traces flowing in via OTLP (already wired through Alloy).\n    metricsGenerator:\n      enabled: true\n      remoteWriteUrl: \"http://observability-mimir-distributor.observability.svc.cluster.local:8080/api/v1/push\"\n      processor:\n        span_metrics:\n          enable_target_info: true\n        service_graphs: {}\n      storage:\n        path: /var/tempo/generator/wal\n      traces_storage:\n        path: /var/tempo/generator/traces\n    overrides:\n      defaults:\n        metrics_generator:\n          processors:\n            - service-graphs\n            - span-metrics\n    storage:\n      trace:\n        backend: local\n        local:\n          path: /var/tempo/traces\n        wal:\n          path: /var/tempo/wal\n    receivers:\n      otlp:\n        protocols:\n          grpc:\n            endpoint: 0.0.0.0:4317\n          http:\n            endpoint: 0.0.0.0:4318\n\n  persistence:\n    enabled: true\n    size: 10Gi\n\n  resources:\n    requests:\n      cpu: 50m\n      memory: 256Mi\n    limits:\n      memory: 512Mi\n\n# ── Mimir ─────────────────────────────────────────────────────────────────────\nmimir-distributed:\n  # ponytail: chart defaults to ingest-storage architecture (Kafka between\n  # distributor and ingester) — one more stateful thing to babysit for no\n  # benefit on a single-node homelab. Classic push-based ingesters instead.\n  kafka:\n    enabled: false\n\n  mimir:\n    structuredConfig:\n      multitenancy_enabled: false\n      # ponytail: usage-stats reporter defaults to its own S3 bucket client\n      # regardless of common.storage.backend — fails hard with no S3 endpoint\n      # configured. No need for anonymous telemetry on a homelab anyway.\n      usage_stats:\n        enabled: false\n      common:\n        storage:\n          backend: filesystem\n          filesystem:\n            dir: /data\n      # ponytail: chart's base config hardcodes blocks_storage.backend: s3\n      # (for its bundled minio demo) — component-specific config always wins\n      # over `common`, so filesystem must be set here explicitly too.\n      blocks_storage:\n        backend: filesystem\n        # ponytail: must differ from tsdb.dir (chart default /data/tsdb) —\n        # filesystem.dir is the simulated \"bucket\", tsdb.dir is local WAL/head.\n        filesystem:\n          dir: /data/blocks\n      # ponytail: chart default compactor.data_dir is \"/data\", which is a\n      # parent of blocks_storage.filesystem.dir above — must be a sibling.\n      compactor:\n        data_dir: /data/compactor\n      ingest_storage:\n        enabled: false\n      ingester:\n        push_grpc_method_enabled: true\n\n  # ponytail: single replicas throughout — no HA, no zone awareness.\n  # The rollout_operator and zone-aware replication exist for production\n  # multi-zone clusters, not a one-node homelab.\n  rollout_operator:\n    enabled: false\n\n  ingester:\n    replicas: 1\n    zoneAwareReplication:\n      enabled: false\n    persistentVolume:\n      enabled: true\n      size: 10Gi\n    resources:\n      requests:\n        cpu: 50m\n        memory: 256Mi\n      limits:\n        memory: 512Mi\n\n  distributor:\n    replicas: 1\n    resources:\n      requests:\n        cpu: 50m\n        memory: 128Mi\n      limits:\n        memory: 256Mi\n\n  querier:\n    replicas: 1\n    resources:\n      requests:\n        cpu: 50m\n        memory: 128Mi\n      limits:\n        memory: 256Mi\n\n  query_frontend:\n    replicas: 1\n    resources:\n      requests:\n        cpu: 50m\n        memory: 128Mi\n      limits:\n        memory: 256Mi\n\n  compactor:\n    replicas: 1\n    persistentVolume:\n      enabled: true\n      size: 10Gi\n    resources:\n      requests:\n        cpu: 50m\n        memory: 128Mi\n      limits:\n        memory: 256Mi\n\n  store_gateway:\n    replicas: 1\n    zoneAwareReplication:\n      enabled: false\n    persistentVolume:\n      enabled: true\n      size: 10Gi\n    resources:\n      requests:\n        cpu: 50m\n        memory: 128Mi\n      limits:\n        memory: 256Mi\n\n  # ponytail: disable optional components not needed for basic metrics ingestion\n  alertmanager:\n    enabled: false\n  ruler:\n    enabled: false\n  query_scheduler:\n    enabled: false\n  overrides_exporter:\n    enabled: false\n\n  # ponytail: mimir-distributed bundles its own minio subchart for demos;\n  # we use the already-deployed MinIO in the minio namespace instead.\n  minio:\n    enabled: false\n\n# ── Alloy ─────────────────────────────────────────────────────────────────────\nalloy:\n  alloy:\n    # ponytail: extraPorts needed so the Service exposes OTLP endpoints\n    # for apps to send traces/metrics/logs to. Without this, only Alloy's\n    # own UI port (12345) is in the Service spec.\n    extraPorts:\n      - name: otlp-grpc\n        port: 4317\n        targetPort: 4317\n        protocol: TCP\n      - name: otlp-http\n        port: 4318\n        targetPort: 4318\n        protocol: TCP\n\n    configMap:\n      content: |\n        // ── K8s pod logs → Loki ──────────────────────────────────────────────\n        discovery.kubernetes \"pods\" {\n          role = \"pod\"\n        }\n\n        discovery.relabel \"pod_logs\" {\n          targets = discovery.kubernetes.pods.targets\n          rule {\n            source_labels = [\"__meta_kubernetes_pod_node_name\"]\n            target_label  = \"node\"\n          }\n          rule {\n            source_labels = [\"__meta_kubernetes_namespace\"]\n            target_label  = \"namespace\"\n          }\n          rule {\n            source_labels = [\"__meta_kubernetes_pod_name\"]\n            target_label  = \"pod\"\n          }\n          rule {\n            source_labels = [\"__meta_kubernetes_pod_container_name\"]\n            target_label  = \"container\"\n          }\n          rule {\n            source_labels = [\"__meta_kubernetes_pod_label_app_kubernetes_io_name\"]\n            target_label  = \"app\"\n          }\n        }\n\n        loki.source.kubernetes \"pods\" {\n          targets    = discovery.relabel.pod_logs.output\n          forward_to = [loki.write.default.receiver]\n        }\n\n        loki.write \"default\" {\n          endpoint {\n            url = \"http://observability-loki.observability.svc.cluster.local:3100/loki/api/v1/push\"\n          }\n        }\n\n        // ── OTLP receiver (apps → Alloy) ─────────────────────────────────────\n        otelcol.receiver.otlp \"default\" {\n          http { endpoint = \"0.0.0.0:4318\" }\n          grpc { endpoint = \"0.0.0.0:4317\" }\n          output {\n            metrics = [otelcol.exporter.prometheus.mimir.input]\n            logs    = [otelcol.exporter.loki.default.input]\n            traces  = [otelcol.exporter.otlp.tempo.input]\n          }\n        }\n\n        // ── OTLP metrics → Mimir ─────────────────────────────────────────────\n        otelcol.exporter.prometheus \"mimir\" {\n          forward_to = [prometheus.remote_write.mimir.receiver]\n        }\n\n        prometheus.remote_write \"mimir\" {\n          endpoint {\n            url = \"http://observability-mimir-distributor.observability.svc.cluster.local:8080/api/v1/push\"\n          }\n        }\n\n        // ── OTLP logs → Loki ─────────────────────────────────────────────────\n        otelcol.exporter.loki \"default\" {\n          forward_to = [loki.write.default.receiver]\n        }\n\n        // ── OTLP traces → Tempo ──────────────────────────────────────────────\n        otelcol.exporter.otlp \"tempo\" {\n          client {\n            endpoint = \"observability-tempo.observability.svc.cluster.local:4317\"\n            tls { insecure = true }\n          }\n        }\n\n  clustering:\n    enabled: false\n\n  rbac:\n    create: true\n\n  serviceAccount:\n    create: true\n\n# ── Prometheus ────────────────────────────────────────────────────────────────\nprometheus:\n  server:\n    global:\n      scrape_interval: 15s\n      evaluation_interval: 15s\n    # ponytail: remote_write to Mimir so metrics survive beyond Prometheus's\n    # own retention window and are queryable from Grafana's Mimir datasource.\n    remoteWrite:\n      - url: \"http://observability-mimir-distributor.observability.svc.cluster.local:8080/api/v1/push\"\n    persistentVolume:\n      enabled: true\n      size: 10Gi\n    # ponytail: 3d not 7d — one node, cadvisor + kube-state + node-exporter +\n    # traefik is a lot of series; longer history lives in Mimir via remoteWrite.\n    retention: \"3d\"\n    resources:\n      requests:\n        cpu: 50m\n        # ponytail: 512Mi OOMKills mid-WAL-replay -\u003e 503 on every query -\u003e\n        # crashloop. WAL replay is the memory peak; 2Gi clears it. Drop back\n        # toward 1Gi if the node gets tight.\n        memory: 512Mi\n      limits:\n        memory: 2Gi\n\n  alertmanager:\n    enabled: false\n  prometheus-pushgateway:\n    enabled: false\n  kube-state-metrics:\n    enabled: true\n  prometheus-node-exporter:\n    enabled: true\n\n# dashboards-hash: 72d391e7d5ef8735fb18b2181dc3326838024fed"],"verify":false,"version":"0.1.0","wait":false,"wait_for_jobs":false},"sensitive_attributes":[[{"type":"get_attr","value":"repository_password"}],[{"type":"get_attr","value":"values"},{"type":"index","value":{"value":0,"type":"number"}}]],"private":"eyJzY2hlbWFfdmVyc2lvbiI6IjEifQ==","dependencies":["kubernetes_namespace.observability"]}]},{"mode":"managed","type":"helm_release","name":"omp","provider":"provider[\"registry.opentofu.org/hashicorp/helm\"]","instances":[{"schema_version":1,"attributes":{"atomic":false,"chart":"./../helm/omp","cleanup_on_fail":false,"create_namespace":false,"dependency_update":true,"description":null,"devel":null,"disable_crd_hooks":false,"disable_openapi_validation":false,"disable_webhooks":false,"force_update":false,"id":"omp","keyring":null,"lint":false,"manifest":null,"max_history":0,"metadata":[{"app_version":"","chart":"omp","first_deployed":1788486263,"last_deployed":1788486263,"name":"omp","namespace":"omp","notes":"","revision":1,"values":"{\"adapter\":{\"enabled\":true,\"image\":\"python:3.12-slim\",\"port\":8000},\"args\":[\"/opt/pod-openai.py\"],\"claudeAuth\":{\"secretName\":\"omp-claude-auth\"},\"command\":[\"python3\"],\"dockerSocket\":{\"enabled\":false,\"hostPath\":\"/var/run/docker.sock\"},\"env\":{},\"image\":\"k3d-registry:5111/omp-box:dev\",\"persistence\":{\"enabled\":true,\"size\":\"20Gi\"},\"port\":4096,\"replicas\":0,\"resources\":{\"limits\":{\"memory\":\"2Gi\"},\"requests\":{\"cpu\":\"250m\",\"memory\":\"512Mi\"}},\"roles\":[\"backend-developer\",\"data-engineer\",\"devops-engineer\",\"frontend-developer\",\"product-owner\",\"project-manager\",\"qa-engineer\",\"release-manager\",\"security-engineer\",\"solution-architect\",\"tech-lead\",\"uiux-designer\"],\"skillsRepo\":\"\",\"slots\":{\"count\":3,\"defaultSkillsRepo\":\"http://gitlab-webservice-default.gitlab.svc:8181/EdwardLim1994/internal-agent-skills.git\"},\"spawner\":{\"enabled\":true,\"subjectServiceAccount\":{\"name\":\"n8n\",\"namespace\":\"n8n\"}}}","version":"0.1.0"}],"name":"omp","namespace":"omp","pass_credentials":false,"postrender":[],"recreate_pods":false,"render_subchart_notes":true,"replace":false,"repository":null,"repository_ca_file":null,"repository_cert_file":null,"repository_key_file":null,"repository_password":null,"repository_username":null,"reset_values":false,"reuse_values":false,"set":[{"name":"dockerSocket.enabled","type":"","value":"false"},{"name":"image","type":"","value":"k3d-registry:5111/omp-box:dev"}],"set_list":[],"set_sensitive":[],"skip_crds":false,"status":"deployed","timeout":300,"upgrade_install":null,"values":["# ponytail: one Deployment + Service + PVC. No HPA, no ServiceAccount, no\n# Ingress until something needs them.\nimage: omp-box:dev\n\n# ponytail: scale-to-zero by default = \"waked on demand\". Wake it with\n#   kubectl -n omp scale deploy/omp --replicas=1\n# and let it idle back to 0 (cron, or by hand). Swap in KEDA http-add-on\n# only if you want an inbound request to trigger the wake.\nreplicas: 0\n\n# ponytail: keep `port` and the pod-openai shim's PORT in sync — single knob.\n# The pod runs pod-openai.py (OpenAI-compatible API backed by a persistent\n# `omp --mode rpc` session). Interactive TUI is still `kubectl exec -it\n# deploy/omp -- omp`.\nport: 4096\ncommand: [\"python3\"]\nargs: [\"/opt/pod-openai.py\"]\n\nenv: {}\n\n# ponytail: Secret (key CLAUDE_CODE_OAUTH_TOKEN) mounted as envFrom into every\n# omp pod — used when a pod runs the `claude` CLI instead of omp. The Tiltfile\n# creates it from TF_VAR_claude_code_token in .env. Set secretName: \"\" to drop\n# the mount entirely.\nclaudeAuth:\n  secretName: omp-claude-auth\n\n# ponytail: git URL of a skills repo (layout: skills/\u003cname\u003e/SKILL.md, same as\n# caveman/ponytail). When set, an initContainer clones it and the main\n# container copies skills/* into omp's skill dir on start — on top of the\n# caveman/ponytail skills already baked into the image. Empty = image skills\n# only. This is the per-agent knob a spawned pod overrides.\nskillsRepo: \"\"\n\n# ponytail: pre-created scale-to-zero pods the spawn-agent flow claims. Each\n# renders with the fetch-skills initContainer already wired (cloning\n# defaultSkillsRepo); the flow PATCHes replicas=1 + that initContainer's\n# args to the repo it actually wants. Point defaultSkillsRepo at the\n# homelab skills repo once it exists.\nslots:\n  count: 3\n  # ponytail: in-cluster clone URL — pods reach GitLab by Service DNS, not the\n  # tailnet name (no SSH exposed, and the tailnet round-trips out and back).\n  # Private repo: prefix creds, e.g.\n  #   http://oauth2:\u003cproject-access-token\u003e@gitlab-webservice-default.gitlab.svc:8181/\u003cgroup\u003e/\u003crepo\u003e.git\n  defaultSkillsRepo: \"http://gitlab-webservice-default.gitlab.svc:8181/EdwardLim1994/internal-agent-skills.git\"\n\n# ponytail: one Deployment+Service+ConfigMap per role. Base = the same omp\n# image; the role's roles/\u003cname\u003e/SKILL.md (in this chart) is mounted into the\n# skill dir via ConfigMap — no git clone. All at replicas 0; wake one:\n#   kubectl -n omp scale deploy/omp-\u003crole\u003e --replicas=1\n# Drop a name from this list to stop shipping that role's pod.\nroles:\n  - backend-developer\n  - data-engineer\n  - devops-engineer\n  - frontend-developer\n  - product-owner\n  - project-manager\n  - qa-engineer\n  - release-manager\n  - security-engineer\n  - solution-architect\n  - tech-lead\n  - uiux-designer\n\n# ponytail: scale-to-zero waker + flat proxy (helm/omp/adapter/server.py) so\n# LiteLLM can list the omp pods as models. The pods already serve an\n# OpenAI-compatible API (pod-openai.py); the adapter only scales a role pod to\n# 1 on first request and presents one /v1 surface. Register in LiteLLM: model\n# omp[-\u003crole\u003e], api_base http://omp-adapter.omp.svc:8000/v1.\nadapter:\n  enabled: true\n  image: python:3.12-slim\n  port: 8000\n\npersistence:\n  enabled: true\n  size: 20Gi\n\n# ponytail: mount the host's docker socket instead of running a dind daemon\n# in-pod (no privileged container). Switch to sysbox/dind if you need real\n# isolation between this pod and the host's other containers.\ndockerSocket:\n  enabled: true\n  hostPath: /var/run/docker.sock\n\n# ponytail: RBAC so an external service (n8n) can spawn/kill extra omp\n# Deployments in this namespace via the k8s API. Bound to n8n's SA. Ships\n# once with the base `omp` release; per-agent spawns are plain Deployments\n# the flow POSTs, not new Helm releases.\nspawner:\n  enabled: true\n  subjectServiceAccount:\n    name: n8n\n    namespace: n8n\n\nresources:\n  requests:\n    cpu: 250m\n    memory: 512Mi\n  limits:\n    memory: 2Gi\n"],"verify":false,"version":"0.1.0","wait":false,"wait_for_jobs":false},"sensitive_attributes":[[{"type":"get_attr","value":"repository_password"}]],"private":"eyJzY2hlbWFfdmVyc2lvbiI6IjEifQ==","dependencies":["kubernetes_namespace.omp","kubernetes_secret.omp_claude_auth","null_resource.omp_image"]}]},{"mode":"managed","type":"helm_release","name":"openwebui","provider":"provider[\"registry.opentofu.org/hashicorp/helm\"]","instances":[{"schema_version":1,"attributes":{"atomic":false,"chart":"./../helm/openwebui","cleanup_on_fail":false,"create_namespace":false,"dependency_update":true,"description":null,"devel":null,"disable_crd_hooks":false,"disable_openapi_validation":false,"disable_webhooks":false,"force_update":false,"id":"openwebui","keyring":null,"lint":false,"manifest":null,"max_history":0,"metadata":[{"app_version":"","chart":"openwebui","first_deployed":1788335993,"last_deployed":1788485876,"name":"openwebui","namespace":"openwebui","notes":"","revision":3,"values":"{\"env\":{\"ENABLE_LOGIN_FORM\":\"False\",\"ENABLE_OAUTH_ROLE_MANAGEMENT\":\"true\",\"ENABLE_OAUTH_SIGNUP\":\"true\",\"ENABLE_OLLAMA_API\":\"False\",\"ENABLE_PERSISTENT_CONFIG\":\"False\",\"OAUTH_ADMIN_ROLES\":\"admin\",\"OAUTH_CLIENT_ID\":\"dev-openwebui-oidc-client-id\",\"OAUTH_CLIENT_SECRET\":\"dev-openwebui-oidc-client-secret-not-for-prod-use\",\"OAUTH_PROVIDER_NAME\":\"Authentik\",\"OAUTH_ROLES_CLAIM\":\"roles\",\"OAUTH_SCOPES\":\"openid profile email openwebui_roles\",\"OLLAMA_BASE_URL\":\"\",\"OPENAI_API_BASE_URL\":\"http://litellm.litellm.svc.cluster.local:4000\",\"OPENAI_API_KEY\":\"sk-dev-litellm-master-key-not-for-prod-use\",\"OPENID_PROVIDER_URL\":\"https://authentik.tail60240b.ts.net/application/o/openwebui/.well-known/openid-configuration\",\"RESET_CONFIG_ON_START\":\"True\",\"SSL_CERT_FILE\":\"/certs/ca.crt\",\"WEBUI_URL\":\"https://openwebui.tail60240b.ts.net\"},\"image\":{\"repository\":\"ghcr.io/open-webui/open-webui\",\"tag\":\"main\"},\"resources\":{\"limits\":{\"memory\":\"2Gi\"},\"requests\":{\"cpu\":\"100m\",\"memory\":\"512Mi\"}},\"storageSize\":\"5Gi\"}","version":"0.1.0"}],"name":"openwebui","namespace":"openwebui","pass_credentials":false,"postrender":[],"recreate_pods":false,"render_subchart_notes":true,"replace":false,"repository":null,"repository_ca_file":null,"repository_cert_file":null,"repository_key_file":null,"repository_password":null,"repository_username":null,"reset_values":false,"reuse_values":false,"set":[],"set_list":[],"set_sensitive":[],"skip_crds":false,"status":"deployed","timeout":600,"upgrade_install":null,"values":["image:\n  repository: ghcr.io/open-webui/open-webui\n  tag: main\n\nstorageSize: 5Gi\n\nenv:\n  # ponytail: everything goes through LiteLLM (OpenAI-compatible) — chat models,\n  # the omp agents, and the host Ollama. Direct Ollama is off so there's\n  # one gateway to auth and log.\n  OPENAI_API_BASE_URL: \"http://litellm.litellm.svc.cluster.local:4000\"\n  # ponytail: LiteLLM master key — fine here, single-user trusted cluster.\n  # Swap for a virtual key (LiteLLM UI -\u003e Keys) if this ever gets more users.\n  OPENAI_API_KEY: \"sk-dev-litellm-master-key-not-for-prod-use\"\n  OLLAMA_BASE_URL: \"\"\n  ENABLE_OLLAMA_API: \"False\"\n\n  # OIDC / Authentik\n  ENABLE_OAUTH_SIGNUP: \"true\"\n  OAUTH_PROVIDER_NAME: \"Authentik\"\n  OPENID_PROVIDER_URL: \"https://authentik.tail60240b.ts.net/application/o/openwebui/.well-known/openid-configuration\"\n  OAUTH_CLIENT_ID: \"dev-openwebui-oidc-client-id\"\n  OAUTH_CLIENT_SECRET: \"dev-openwebui-oidc-client-secret-not-for-prod-use\"\n  OAUTH_SCOPES: \"openid profile email openwebui_roles\"\n  ENABLE_OAUTH_ROLE_MANAGEMENT: \"true\"\n  OAUTH_ROLES_CLAIM: \"roles\"\n  OAUTH_ADMIN_ROLES: \"admin\"\n  WEBUI_URL: \"https://openwebui.tail60240b.ts.net\"\n\n  # ponytail: ENABLE_LOGIN_FORM=False — SSO only. First SSO login by admin\n  # gets Admin role via openwebui_roles claim from Authentik.\n  ENABLE_LOGIN_FORM: \"False\"\n  ENABLE_PERSISTENT_CONFIG: \"False\"\n  RESET_CONFIG_ON_START: \"True\"\n\n  # ponytail: server-side OIDC calls go to Tailscale HTTPS; SSL_CERT_FILE\n  # trusts the homelab self-signed CA mounted from the homelab-ca Secret.\n  SSL_CERT_FILE: \"/certs/ca.crt\"\n\nresources:\n  requests:\n    cpu: 100m\n    memory: 512Mi\n  limits:\n    memory: 2Gi\n"],"verify":false,"version":"0.1.0","wait":true,"wait_for_jobs":false},"sensitive_attributes":[[{"type":"get_attr","value":"repository_password"}],[{"type":"get_attr","value":"values"},{"type":"index","value":{"value":0,"type":"number"}}]],"private":"eyJzY2hlbWFfdmVyc2lvbiI6IjEifQ==","dependencies":["data.kubernetes_secret.homelab_ca","helm_release.cert_manager","kubectl_manifest.homelab_ca","kubectl_manifest.selfsigned_bootstrap","kubernetes_namespace.cert_manager","kubernetes_namespace.openwebui","kubernetes_secret.openwebui_homelab_ca","null_resource.homelab_ca_ready"]}]},{"mode":"managed","type":"helm_release","name":"sonarqube","provider":"provider[\"registry.opentofu.org/hashicorp/helm\"]","instances":[{"schema_version":1,"attributes":{"atomic":false,"chart":"./../helm/sonarqube","cleanup_on_fail":false,"create_namespace":false,"dependency_update":true,"description":null,"devel":null,"disable_crd_hooks":false,"disable_openapi_validation":false,"disable_webhooks":false,"force_update":false,"id":"sonarqube","keyring":null,"lint":false,"manifest":null,"max_history":0,"metadata":[{"app_version":"","chart":"sonarqube","first_deployed":1788335114,"last_deployed":1788429284,"name":"sonarqube","namespace":"sonarqube","notes":"1. Get the application URL by running these commands:\n  http://sonarqube.local\nWARNING: \n         Please note that the SonarQube image runs with a non-root user (uid=1000) belonging to the root group (guid=0). In this way, the chart can support arbitrary user ids as recommended in OpenShift.\n         Please visit https://docs.openshift.com/container-platform/4.14/openshift_images/create-images.html#use-uid_create-images for more information.\n\n\nWARNING: Setting the deployment strategy type is deprecated and will be removed in a future release. It will be hard-coded to Recreate.\n\nWARNING: The deploymentType value is deprecated and won't be supported anymore. SonarQube will be deployed as a Deployment by default.\n","revision":3,"values":"{\"postgres\":{\"database\":\"sonarqube\",\"image\":\"postgres:16\",\"password\":\"(sensitive value)\",\"resources\":{\"limits\":{\"memory\":\"512Mi\"},\"requests\":{\"cpu\":\"50m\",\"memory\":\"256Mi\"}},\"storageSize\":\"5Gi\",\"username\":\"sonarqube\"},\"sonarqube\":{\"community\":{\"enabled\":true},\"ingress\":{\"annotations\":{\"cert-manager.io/cluster-issuer\":\"homelab-ca-issuer\"},\"enabled\":true,\"hosts\":[{\"name\":\"sonarqube.local\"}],\"ingressClassName\":\"traefik\",\"tls\":[{\"hosts\":[\"sonarqube.local\"],\"secretName\":\"sonarqube.local-tls\"}]},\"initSysctl\":{\"enabled\":false},\"jdbcOverwrite\":{\"enabled\":true,\"jdbcPassword\":\"(sensitive value)\",\"jdbcUrl\":\"jdbc:postgresql://sonarqube-postgres:5432/sonarqube\",\"jdbcUsername\":\"sonarqube\"},\"livenessProbe\":{\"timeoutSeconds\":10},\"monitoringPasscode\":\"(sensitive value)\",\"persistence\":{\"enabled\":true,\"size\":\"5Gi\"},\"plugins\":{\"install\":[\"https://github.com/sonar-auth-oidc/sonar-auth-oidc/releases/download/v3.0.0/sonar-auth-oidc-plugin-3.0.0.jar\"]},\"postgresql\":{\"enabled\":false},\"readinessProbe\":{\"timeoutSeconds\":10},\"resources\":{\"limits\":{\"memory\":\"3072M\"},\"requests\":{\"cpu\":\"200m\",\"memory\":\"1536M\"}},\"sonarProperties\":{\"sonar.auth.oidc.enabled\":\"true\",\"sonar.auth.oidc.issuerUri\":\"https://authentik.tail60240b.ts.net/application/o/sonarqube/\",\"sonar.auth.oidc.loginButtonText\":\"Log in with Authentik\",\"sonar.core.serverBaseURL\":\"https://sonarqube.tail60240b.ts.net\"},\"sonarSecretProperties\":\"sonarqube-oidc-secret\",\"startupProbe\":{\"timeoutSeconds\":10}}}","version":"0.1.0"}],"name":"sonarqube","namespace":"sonarqube","pass_credentials":false,"postrender":[],"recreate_pods":false,"render_subchart_notes":true,"replace":false,"repository":null,"repository_ca_file":null,"repository_cert_file":null,"repository_key_file":null,"repository_password":null,"repository_username":null,"reset_values":false,"reuse_values":false,"set":[],"set_list":[],"set_sensitive":[{"name":"postgres.password","type":"","value":"dev-sonarqube-db-password"},{"name":"sonarqube.jdbcOverwrite.jdbcPassword","type":"","value":"dev-sonarqube-db-password"},{"name":"sonarqube.monitoringPasscode","type":"","value":"dev-sonarqube-monitoring-passcode"}],"skip_crds":false,"status":"deployed","timeout":900,"upgrade_install":null,"values":["sonarqube:\n  community:\n    enabled: true\n\n  # ponytail: vm.max_map_count for the bundled Elasticsearch needs raising\n  # host-side once (`sudo sysctl -w vm.max_map_count=262144` on the k3d\n  # node/host, persist in /etc/sysctl.d/ if you want it to survive reboots).\n  # Chart's own initSysctl needs a privileged initContainer; skipping that\n  # in favor of the one-time host command.\n  initSysctl:\n    enabled: false\n\n  # monitoringPasscode set via Tiltfile/terraform (.env)\n\n  # ponytail: chart's 1s probe timeout is too tight on this RPi under load\n  # (JVM GC pauses, concurrent image pulls) — caused a liveness-kill restart\n  # loop even though the server was actually up. Same fix as seafile's mariadb.\n  readinessProbe:\n    timeoutSeconds: 10\n  livenessProbe:\n    timeoutSeconds: 10\n  startupProbe:\n    timeoutSeconds: 10\n\n  resources:\n    requests:\n      cpu: 200m\n      memory: 1536M\n    limits:\n      memory: 3072M\n\n  persistence:\n    enabled: true\n    size: 5Gi\n\n  # ponytail: SonarQube Community has no native SSO — this OSS plugin\n  # (sonar-auth-oidc, MIT-ish/Apache) bolts on generic OpenID Connect via\n  # the marketplace-jar mechanism, same \"no license, no fork\" pattern as\n  # n8n's cweagans/n8n-oidc. Its own settings (sonar.auth.oidc.*) are\n  # regular SonarQube global settings, so they load from sonarProperties\n  # below — no manual admin-UI step needed after first boot.\n  plugins:\n    install:\n      - \"https://github.com/sonar-auth-oidc/sonar-auth-oidc/releases/download/v3.0.0/sonar-auth-oidc-plugin-3.0.0.jar\"\n\n  # ponytail: fixed dev client_id/secret matching the Authentik OAuth2\n  # provider created via the API (same one-time-setup pattern as the other\n  # apps). Server base URL uses the tailscale hostname so the browser\n  # redirect and the plugin's own redirect URI agree on the same authority.\n  sonarProperties:\n    sonar.core.serverBaseURL: \"https://sonarqube.tail60240b.ts.net\"\n    sonar.auth.oidc.enabled: \"true\"\n    sonar.auth.oidc.issuerUri: \"https://authentik.tail60240b.ts.net/application/o/sonarqube/\"\n    # sonar.auth.oidc.clientId.secured set via Tiltfile/terraform (.env)\n    sonar.auth.oidc.loginButtonText: \"Log in with Authentik\"\n\n  # ponytail: sonarSecretProperties is a *reference* to an existing Secret\n  # (key \"secret.properties\"), not inline content — the chart concatenates\n  # it after sonarProperties above, so it can override the same keys.\n  # Secret itself is created in the Tiltfile alongside the other apps'\n  # dev-fixed OIDC secrets.\n  sonarSecretProperties: sonarqube-oidc-secret\n\n  # ponytail: use this wrapper chart's own plain postgres:16 StatefulSet\n  # (templates/postgres.yaml), not the bitnami subchart the SonarSource chart\n  # would bundle — bitnami sunset the free images.\n  postgresql:\n    enabled: false\n  jdbcOverwrite:\n    enabled: true\n    jdbcUrl: \"jdbc:postgresql://sonarqube-postgres:5432/sonarqube\"\n    jdbcUsername: \"sonarqube\"\n\n  ingress:\n    enabled: true\n    ingressClassName: traefik\n    annotations:\n      cert-manager.io/cluster-issuer: homelab-ca-issuer\n    hosts:\n      - name: sonarqube.local\n    tls:\n      - secretName: sonarqube.local-tls\n        hosts:\n          - sonarqube.local\n\n# ponytail: consumed by templates/postgres.yaml (this wrapper chart's own\n# template). Keep in sync with sonarqube.jdbcOverwrite above.\npostgres:\n  image: postgres:16\n  database: sonarqube\n  username: sonarqube\n  password: \"\"  # set via terraform / Tiltfile\n  storageSize: 5Gi\n  resources:\n    requests:\n      cpu: 50m\n      memory: 256Mi\n    limits:\n      memory: 512Mi\n"],"verify":false,"version":"0.1.0","wait":true,"wait_for_jobs":false},"sensitive_attributes":[[{"type":"get_attr","value":"repository_password"}],[{"type":"get_attr","value":"set_sensitive"}]],"private":"eyJzY2hlbWFfdmVyc2lvbiI6IjEifQ==","dependencies":["kubernetes_namespace.sonarqube","kubernetes_secret.sonarqube_oidc"]}]},{"mode":"managed","type":"helm_release","name":"tailscale_operator","provider":"provider[\"registry.opentofu.org/hashicorp/helm\"]","instances":[{"schema_version":1,"attributes":{"atomic":false,"chart":"./../helm/tailscale-operator","cleanup_on_fail":false,"create_namespace":false,"dependency_update":true,"description":null,"devel":null,"disable_crd_hooks":false,"disable_openapi_validation":false,"disable_webhooks":false,"force_update":false,"id":"tailscale-operator","keyring":null,"lint":false,"manifest":null,"max_history":0,"metadata":[{"app_version":"","chart":"tailscale-operator","first_deployed":1788351908,"last_deployed":1788351908,"name":"tailscale-operator","namespace":"tailscale","notes":"You have successfully installed the Tailscale Kubernetes Operator!\n\nOnce connected, the operator should appear as a device within the Tailscale admin console:\nhttps://login.tailscale.com/admin/machines\n\nIf you have not used the Tailscale operator before, here are some examples to try out:\n\n* Private Kubernetes API access and authorization using the API server proxy\n  https://tailscale.com/kb/1437/kubernetes-operator-api-server-proxy\n\n* Private access to cluster Services using an ingress proxy\n  https://tailscale.com/kb/1439/kubernetes-operator-cluster-ingress\n\n* Private access to the cluster's available subnets using a subnet router\n  https://tailscale.com/kb/1441/kubernetes-operator-connector\n\nYou can also explore the CRDs, operator, and associated resources within the tailscale namespace:\n\n$ kubectl explain connector\n$ kubectl explain proxygroup\n$ kubectl explain proxyclass\n$ kubectl explain recorder\n$ kubectl explain dnsconfig\n\nIf you're interested to explore what resources were created:\n\n$ kubectl --namespace=tailscale get all -l app.kubernetes.io/managed-by=Helm\n","revision":1,"values":"{\"tailscale-operator\":{\"oauth\":{\"clientId\":\"(sensitive value)\",\"clientSecret\":\"(sensitive value)\"},\"operatorConfig\":{\"hostname\":\"homelab-operator\"}}}","version":"0.1.0"}],"name":"tailscale-operator","namespace":"tailscale","pass_credentials":false,"postrender":[],"recreate_pods":false,"render_subchart_notes":true,"replace":false,"repository":null,"repository_ca_file":null,"repository_cert_file":null,"repository_key_file":null,"repository_password":null,"repository_username":null,"reset_values":false,"reuse_values":false,"set":[],"set_list":[],"set_sensitive":[{"name":"tailscale-operator.oauth.clientId","type":"","value":"kTPMn5Nfj511CNTRL"},{"name":"tailscale-operator.oauth.clientSecret","type":"","value":"tskey-client-kTPMn5Nfj511CNTRL-mWvUeAiBgi31NiA5uX7qi3kcbNFG6MAM"}],"skip_crds":false,"status":"deployed","timeout":300,"upgrade_install":null,"values":["tailscale-operator:\n  # ponytail: oauth.clientId / oauth.clientSecret come from Tiltfile/terraform\n  # (.env: TF_VAR_tailscale_oauth_client_id / _secret). Create the OAuth client\n  # once in the Tailscale admin console (Settings -\u003e OAuth clients) with write\n  # scope on Devices/Core and Keys/Auth Keys, and set tag:k8s-operator as a\n  # tagOwner of tag:k8s in the tailnet ACL. See helm/tailscale-operator/README\n  # note in terraform/tailscale.tf.\n  oauth:\n    clientId: \"\"\n    clientSecret: \"\"\n\n  # ponytail: chart default already creates the `tailscale` IngressClass and\n  # installs CRDs — nothing else to configure for L7 Ingress exposure. Each\n  # app opts in with `ingressClassName: tailscale` + `tls.hosts: [\u003cname\u003e]`.\n  operatorConfig:\n    hostname: \"homelab-operator\"\n"],"verify":false,"version":"0.1.0","wait":true,"wait_for_jobs":false},"sensitive_attributes":[[{"type":"get_attr","value":"repository_password"}],[{"type":"get_attr","value":"set_sensitive"}]],"private":"eyJzY2hlbWFfdmVyc2lvbiI6IjEifQ==","dependencies":["kubernetes_namespace.tailscale"]}]},{"mode":"managed","type":"kubectl_manifest","name":"homelab_ca","provider":"provid