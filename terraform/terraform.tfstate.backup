": \"Ingress\"\n\"metadata\":\n  \"name\": \"ts-n8n\"\n  \"namespace\": \"n8n\"\n\"spec\":\n  \"defaultBackend\":\n    \"service\":\n      \"name\": \"n8n\"\n      \"port\":\n        \"number\": 5678\n  \"ingressClassName\": \"tailscale\"\n  \"tls\":\n  - \"hosts\":\n    - \"n8n\"\n","yaml_body_parsed":"apiVersion: networking.k8s.io/v1\nkind: Ingress\nmetadata:\n  name: ts-n8n\n  namespace: n8n\nspec:\n  defaultBackend:\n    service:\n      name: n8n\n      port:\n        number: 5678\n  ingressClassName: tailscale\n  tls:\n  - hosts:\n    - n8n\n","yaml_incluster":"c93dce68d1268c5374b1617aa5ebb586a4637e91dd2e8faa40c4aa18c9e59e31"},"sensitive_attributes":[[{"type":"get_attr","value":"live_manifest_incluster"}],[{"type":"get_attr","value":"yaml_body"}],[{"type":"get_attr","value":"yaml_incluster"}]],"private":"eyJlMmJmYjczMC1lY2FhLTExZTYtOGY4OC0zNDM2M2JjN2M0YzAiOnsiY3JlYXRlIjo2MDAwMDAwMDAwMDB9LCJzY2hlbWFfdmVyc2lvbiI6IjEifQ==","dependencies":["helm_release.tailscale_operator","kubernetes_namespace.tailscale"]},{"index_key":"nextcloud","schema_version":1,"attributes":{"api_version":"networking.k8s.io/v1","apply_only":false,"force_conflicts":false,"force_new":false,"id":"/apis/networking.k8s.io/v1/namespaces/nextcloud/ingresses/ts-nextcloud","ignore_fields":null,"kind":"Ingress","live_manifest_incluster":"8fb7f04997b918161fd112afc99befefb7cba98311b9416d913a67620236899b","live_uid":"32565fa7-2678-43d4-916f-6d5d62ebe4f2","name":"ts-nextcloud","namespace":"nextcloud","override_namespace":null,"sensitive_fields":null,"server_side_apply":false,"timeouts":null,"uid":"32565fa7-2678-43d4-916f-6d5d62ebe4f2","validate_schema":true,"wait":null,"wait_for_rollout":true,"yaml_body":"\"apiVersion\": \"networking.k8s.io/v1\"\n\"kind\": \"Ingress\"\n\"metadata\":\n  \"name\": \"ts-nextcloud\"\n  \"namespace\": \"nextcloud\"\n\"spec\":\n  \"defaultBackend\":\n    \"service\":\n      \"name\": \"nextcloud\"\n      \"port\":\n        \"number\": 8080\n  \"ingressClassName\": \"tailscale\"\n  \"tls\":\n  - \"hosts\":\n    - \"nextcloud\"\n","yaml_body_parsed":"apiVersion: networking.k8s.io/v1\nkind: Ingress\nmetadata:\n  name: ts-nextcloud\n  namespace: nextcloud\nspec:\n  defaultBackend:\n    service:\n      name: nextcloud\n      port:\n        number: 8080\n  ingressClassName: tailscale\n  tls:\n  - hosts:\n    - nextcloud\n","yaml_incluster":"8fb7f04997b918161fd112afc99befefb7cba98311b9416d913a67620236899b"},"sensitive_attributes":[[{"type":"get_attr","value":"live_manifest_incluster"}],[{"type":"get_attr","value":"yaml_body"}],[{"type":"get_attr","value":"yaml_incluster"}]],"private":"eyJlMmJmYjczMC1lY2FhLTExZTYtOGY4OC0zNDM2M2JjN2M0YzAiOnsiY3JlYXRlIjo2MDAwMDAwMDAwMDB9LCJzY2hlbWFfdmVyc2lvbiI6IjEifQ==","dependencies":["helm_release.tailscale_operator","kubernetes_namespace.tailscale"]},{"index_key":"sonarqube","schema_version":1,"attributes":{"api_version":"networking.k8s.io/v1","apply_only":false,"force_conflicts":false,"force_new":false,"id":"/apis/networking.k8s.io/v1/namespaces/sonarqube/ingresses/ts-sonarqube","ignore_fields":null,"kind":"Ingress","live_manifest_incluster":"1b96b5d194c21cf29fbe50eb6e3aba443c274f16e1ad03541f9d000e59f41abd","live_uid":"4ea4f367-2655-4975-80d3-72bffa995f44","name":"ts-sonarqube","namespace":"sonarqube","override_namespace":null,"sensitive_fields":null,"server_side_apply":false,"timeouts":null,"uid":"4ea4f367-2655-4975-80d3-72bffa995f44","validate_schema":true,"wait":null,"wait_for_rollout":true,"yaml_body":"\"apiVersion\": \"networking.k8s.io/v1\"\n\"kind\": \"Ingress\"\n\"metadata\":\n  \"name\": \"ts-sonarqube\"\n  \"namespace\": \"sonarqube\"\n\"spec\":\n  \"defaultBackend\":\n    \"service\":\n      \"name\": \"sonarqube-sonarqube\"\n      \"port\":\n        \"number\": 9000\n  \"ingressClassName\": \"tailscale\"\n  \"tls\":\n  - \"hosts\":\n    - \"sonarqube\"\n","yaml_body_parsed":"apiVersion: networking.k8s.io/v1\nkind: Ingress\nmetadata:\n  name: ts-sonarqube\n  namespace: sonarqube\nspec:\n  defaultBackend:\n    service:\n      name: sonarqube-sonarqube\n      port:\n        number: 9000\n  ingressClassName: tailscale\n  tls:\n  - hosts:\n    - sonarqube\n","yaml_incluster":"1b96b5d194c21cf29fbe50eb6e3aba443c274f16e1ad03541f9d000e59f41abd"},"sensitive_attributes":[[{"type":"get_attr","value":"live_manifest_incluster"}],[{"type":"get_attr","value":"yaml_body"}],[{"type":"get_attr","value":"yaml_incluster"}]],"private":"eyJlMmJmYjczMC1lY2FhLTExZTYtOGY4OC0zNDM2M2JjN2M0YzAiOnsiY3JlYXRlIjo2MDAwMDAwMDAwMDB9LCJzY2hlbWFfdmVyc2lvbiI6IjEifQ==","dependencies":["helm_release.tailscale_operator","kubernetes_namespace.tailscale"]}]},{"mode":"managed","type":"kubernetes_config_map","name":"ansible_n8n_flows","provider":"provider[\"registry.opentofu.org/hashicorp/kubernetes\"]","instances":[{"schema_version":0,"attributes":{"binary_data":{},"data":{"F-00-gitlab-router.json":"{\n  \"name\": \"F-00 GitLab Event Router\",\n  \"nodes\": [\n    {\n      \"parameters\": {\n        \"httpMethod\": \"POST\",\n        \"path\": \"gitlab-events\",\n        \"responseMode\": \"lastNode\",\n        \"options\": {}\n      },\n      \"id\": \"webhook-gitlab-events\",\n      \"name\": \"Webhook: gitlab-events\",\n      \"type\": \"n8n-nodes-base.webhook\",\n      \"typeVersion\": 1,\n      \"position\": [\n        240,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"jsCode\": \"const secret = $env.GITLAB_WEBHOOK_SECRET;\\nconst header = $json.headers['x-gitlab-token'];\\nif (header !== secret) throw new Error('Invalid webhook secret');\\nconst body = $json.body;\\nconst eventType = $json.headers['x-gitlab-event'];\\nconst obj = body.object_attributes || {};\\nconst src = obj.source_branch || '';\\nconst ref = body.ref || '';\\nconst action = obj.action || obj.state || '';\\nlet route = null;\\nconst taskPrefixes = ['task/','api/','qa/','security/','devops/','bugfix/'];\\nconst isTask = taskPrefixes.some(p =\u003e src.startsWith(p));\\nif (eventType === 'Merge Request Hook') {\\n  if (action === 'open' || action === 'reopen') { if (isTask) route='task-mr-opened'; }\\n  else if (action === 'merge') {\\n    if (isTask) route='task-mr-merged';\\n    else if (src.startsWith('us/')) route='story-mr-merged';\\n    else if (src.startsWith('promote/')) route='release-mr-merged';\\n    else if (src.startsWith('revert-')) route='revert-mr-merged';\\n  }\\n} else if (eventType === 'Pipeline Hook') {\\n  const status = body.object_attributes?.status;\\n  if (status === 'success') {\\n    if (ref.startsWith('promote/')) route='ci-staging-deployed';\\n    else if (ref === 'main') route='ci-production-deployed';\\n    else if (ref.startsWith('us/')) route='ci-version-built';\\n  }\\n}\\nreturn [{ json: { ...body, _route: route, _event: eventType, _src: src, _ref: ref } }];\"\n      },\n      \"id\": \"detect-route\",\n      \"name\": \"Verify token + detect route\",\n      \"type\": \"n8n-nodes-base.code\",\n      \"typeVersion\": 2,\n      \"position\": [\n        480,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"dataType\": \"string\",\n        \"value1\": \"={{ $json._route }}\",\n        \"rules\": {\n          \"rules\": [\n            {\n              \"value2\": \"task-mr-opened\"\n            },\n            {\n              \"value2\": \"task-mr-merged\"\n            },\n            {\n              \"value2\": \"story-mr-merged\"\n            },\n            {\n              \"value2\": \"release-mr-merged\"\n            },\n            {\n              \"value2\": \"revert-mr-merged\"\n            },\n            {\n              \"value2\": \"ci-version-built\"\n            },\n            {\n              \"value2\": \"ci-staging-deployed\"\n            },\n            {\n              \"value2\": \"ci-production-deployed\"\n            }\n          ]\n        },\n        \"fallbackOutput\": \"extra\"\n      },\n      \"id\": \"route-switch\",\n      \"name\": \"Route by event + branch\",\n      \"type\": \"n8n-nodes-base.switch\",\n      \"typeVersion\": 3,\n      \"position\": [\n        720,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/gitlab-mr-opened\",\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"payload\",\n              \"value\": \"={{ JSON.stringify($json) }}\"\n            }\n          ]\n        }\n      },\n      \"id\": \"forward-gitlab-mr-opened\",\n      \"name\": \"Forward \\u2192 gitlab-mr-opened\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4,\n      \"position\": [\n        960,\n        60\n      ]\n    },\n    {\n      \"parameters\": {\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/gitlab-mr-merged\",\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"payload\",\n              \"value\": \"={{ JSON.stringify($json) }}\"\n            }\n          ]\n        }\n      },\n      \"id\": \"forward-gitlab-mr-merged\",\n      \"name\": \"Forward \\u2192 gitlab-mr-merged\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4,\n      \"position\": [\n        960,\n        108\n      ]\n    },\n    {\n      \"parameters\": {\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/story-mr-merged\",\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"payload\",\n              \"value\": \"={{ JSON.stringify($json) }}\"\n            }\n          ]\n        }\n      },\n      \"id\": \"forward-story-mr-merged\",\n      \"name\": \"Forward \\u2192 story-mr-merged\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4,\n      \"position\": [\n        960,\n        156\n      ]\n    },\n    {\n      \"parameters\": {\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/release-mr-merged\",\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"payload\",\n              \"value\": \"={{ JSON.stringify($json) }}\"\n            }\n          ]\n        }\n      },\n      \"id\": \"forward-release-mr-merged\",\n      \"name\": \"Forward \\u2192 release-mr-merged\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4,\n      \"position\": [\n        960,\n        204\n      ]\n    },\n    {\n      \"parameters\": {\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/revert-mr-merged\",\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"payload\",\n              \"value\": \"={{ JSON.stringify($json) }}\"\n            }\n          ]\n        }\n      },\n      \"id\": \"forward-revert-mr-merged\",\n      \"name\": \"Forward \\u2192 revert-mr-merged\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4,\n      \"position\": [\n        960,\n        252\n      ]\n    },\n    {\n      \"parameters\": {\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/ci-version-built\",\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"payload\",\n              \"value\": \"={{ JSON.stringify($json) }}\"\n            }\n          ]\n        }\n      },\n      \"id\": \"forward-ci-version-built\",\n      \"name\": \"Forward \\u2192 ci-version-built\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4,\n      \"position\": [\n        960,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/ci-staging-deployed\",\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"payload\",\n              \"value\": \"={{ JSON.stringify($json) }}\"\n            }\n          ]\n        }\n      },\n      \"id\": \"forward-ci-staging-deployed\",\n      \"name\": \"Forward \\u2192 ci-staging-deployed\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4,\n      \"position\": [\n        960,\n        348\n      ]\n    },\n    {\n      \"parameters\": {\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/ci-production-deployed\",\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"payload\",\n              \"value\": \"={{ JSON.stringify($json) }}\"\n            }\n          ]\n        }\n      },\n      \"id\": \"forward-ci-production-deployed\",\n      \"name\": \"Forward \\u2192 ci-production-deployed\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4,\n      \"position\": [\n        960,\n        396\n      ]\n    }\n  ],\n  \"connections\": {\n    \"Webhook: gitlab-events\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Verify token + detect route\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Verify token + detect route\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Route by event + branch\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Route by event + branch\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Forward \\u2192 gitlab-mr-opened\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ],\n        [\n          {\n            \"node\": \"Forward \\u2192 gitlab-mr-merged\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ],\n        [\n          {\n            \"node\": \"Forward \\u2192 story-mr-merged\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ],\n        [\n          {\n            \"node\": \"Forward \\u2192 release-mr-merged\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ],\n        [\n          {\n            \"node\": \"Forward \\u2192 revert-mr-merged\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ],\n        [\n          {\n            \"node\": \"Forward \\u2192 ci-version-built\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ],\n        [\n          {\n            \"node\": \"Forward \\u2192 ci-staging-deployed\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ],\n        [\n          {\n            \"node\": \"Forward \\u2192 ci-production-deployed\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    }\n  },\n  \"active\": true,\n  \"settings\": {\n    \"executionOrder\": \"v1\"\n  },\n  \"tags\": [\n    {\n      \"name\": \"router\"\n    },\n    {\n      \"name\": \"cross-cutting\"\n    }\n  ]\n}","F-01-plan-release.json":"{\n  \"name\": \"F-01 /plan-release\",\n  \"nodes\": [\n    {\n      \"parameters\": {\n        \"httpMethod\": \"POST\",\n        \"path\": \"mm-plan_release\",\n        \"responseMode\": \"responseNode\",\n        \"options\": {}\n      },\n      \"id\": \"slack-trigger\",\n      \"name\": \"Mattermost: trigger\",\n      \"type\": \"n8n-nodes-base.webhook\",\n      \"typeVersion\": 1,\n      \"position\": [\n        240,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"respondWith\": \"json\",\n        \"responseBody\": \"{\\\"response_type\\\": \\\"ephemeral\\\", \\\"text\\\": \\\":hourglass_flowing_sand: Running `/plan_release`...\\\"}\"\n      },\n      \"id\": \"mm-ack-slack-trigger\",\n      \"name\": \"Mattermost: ack command\",\n      \"type\": \"n8n-nodes-base.respondToWebhook\",\n      \"typeVersion\": 1,\n      \"position\": [\n        480,\n        200\n      ]\n    },\n    {\n      \"parameters\": {\n        \"channelId\": \"={{ $('Mattermost: trigger').item.json.body.channel_id }}\",\n        \"message\": \"@{{ $('Mattermost: trigger').item.json.body.user_name }} :hourglass: *Plan-release started* for `{{ $json.text }}`\\nGate A: Architect + Data Engineer pods spawning...\",\n        \"otherOptions\": {}\n      },\n      \"id\": \"ack-01\",\n      \"name\": \"Mattermost: ack received\",\n      \"type\": \"n8n-nodes-base.mattermost\",\n      \"typeVersion\": 1,\n      \"position\": [\n        480,\n        300\n      ],\n      \"credentials\": {\n        \"mattermostApi\": {\n          \"id\": \"mm-creds\",\n          \"name\": \"Mattermost SDLC Bot\"\n        }\n      }\n    },\n    {\n      \"parameters\": {\n        \"command\": \"=echo '{\\\"role\\\":\\\"architect\\\",\\\"task\\\":\\\"gate-A-planning\\\",\\\"version\\\":\\\"{{ $json.text }}\\\"}' \u003e /tmp/arch.json \u0026\u0026 omp run --mode json --role slow @/tmp/arch.json\"\n      },\n      \"id\": \"spawn-arch\",\n      \"name\": \"Spawn Architect Pod (gate A)\",\n      \"type\": \"n8n-nodes-base.executeCommand\",\n      \"typeVersion\": 1,\n      \"position\": [\n        720,\n        200\n      ]\n    },\n    {\n      \"parameters\": {\n        \"command\": \"=echo '{\\\"role\\\":\\\"data-engineer\\\",\\\"task\\\":\\\"gate-A-planning\\\",\\\"version\\\":\\\"{{ $json.text }}\\\"}' \u003e /tmp/de.json \u0026\u0026 omp run --mode json --role slow @/tmp/de.json\"\n      },\n      \"id\": \"spawn-de\",\n      \"name\": \"Spawn Data Engineer Pod (gate A)\",\n      \"type\": \"n8n-nodes-base.executeCommand\",\n      \"typeVersion\": 1,\n      \"position\": [\n        720,\n        400\n      ]\n    },\n    {\n      \"parameters\": {\n        \"jsCode\": \"const a=$node['Spawn Architect Pod (gate A)'].json.exitCode;\\nconst d=$node['Spawn Data Engineer Pod (gate A)'].json.exitCode;\\nreturn [{json:{ok:a===0\u0026\u0026d===0}}];\"\n      },\n      \"id\": \"gate-a-check\",\n      \"name\": \"Gate A complete?\",\n      \"type\": \"n8n-nodes-base.code\",\n      \"typeVersion\": 2,\n      \"position\": [\n        960,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"channelId\": \"={{ $('Mattermost: trigger').item.json.body.channel_id }}\",\n        \"message\": \"@{{ $('Mattermost: trigger').item.json.body.user_name }} :white_check_mark: Gate A done. Spawning QA · Security · UX pods (gate B)...\",\n        \"otherOptions\": {}\n      },\n      \"id\": \"ack-gate-a\",\n      \"name\": \"Mattermost: gate A complete\",\n      \"type\": \"n8n-nodes-base.mattermost\",\n      \"typeVersion\": 1,\n      \"position\": [\n        1200,\n        300\n      ],\n      \"credentials\": {\n        \"mattermostApi\": {\n          \"id\": \"mm-creds\",\n          \"name\": \"Mattermost SDLC Bot\"\n        }\n      }\n    },\n    {\n      \"parameters\": {\n        \"command\": \"=echo '{\\\"role\\\":\\\"qa\\\",\\\"task\\\":\\\"gate-B-challenge\\\",\\\"version\\\":\\\"{{ $('Slack: trigger').item.json.text }}\\\"}' \u003e /tmp/qa.json \u0026\u0026 omp run --mode json --role default @/tmp/qa.json\"\n      },\n      \"id\": \"spawn-qa\",\n      \"name\": \"Spawn QA Pod (gate B)\",\n      \"type\": \"n8n-nodes-base.executeCommand\",\n      \"typeVersion\": 1,\n      \"position\": [\n        1440,\n        160\n      ]\n    },\n    {\n      \"parameters\": {\n        \"command\": \"=echo '{\\\"role\\\":\\\"security\\\",\\\"task\\\":\\\"gate-B-threat-model\\\",\\\"version\\\":\\\"{{ $('Slack: trigger').item.json.text }}\\\"}' \u003e /tmp/sec.json \u0026\u0026 omp run --mode json --role default @/tmp/sec.json\"\n      },\n      \"id\": \"spawn-sec\",\n      \"name\": \"Spawn Security Pod (gate B)\",\n      \"type\": \"n8n-nodes-base.executeCommand\",\n      \"typeVersion\": 1,\n      \"position\": [\n        1440,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"command\": \"=echo '{\\\"role\\\":\\\"ui-ux\\\",\\\"task\\\":\\\"gate-B-ux-spec\\\",\\\"version\\\":\\\"{{ $('Slack: trigger').item.json.text }}\\\"}' \u003e /tmp/ux.json \u0026\u0026 omp run --mode json --role default @/tmp/ux.json\"\n      },\n      \"id\": \"spawn-ux\",\n      \"name\": \"Spawn UX Pod (gate B)\",\n      \"type\": \"n8n-nodes-base.executeCommand\",\n      \"typeVersion\": 1,\n      \"position\": [\n        1440,\n        440\n      ]\n    },\n    {\n      \"parameters\": {\n        \"jsCode\": \"const dag=$workflow.staticData;\\ndag.revisions=(dag.revisions||0)+1;\\nif(dag.revisions\u003e=3) return [{json:{escalate:true,count:dag.revisions}}];\\nreturn [{json:{escalate:false,count:dag.revisions}}];\"\n      },\n      \"id\": \"revision-check\",\n      \"name\": \"Arch revision check (max 3)\",\n      \"type\": \"n8n-nodes-base.code\",\n      \"typeVersion\": 2,\n      \"position\": [\n        1680,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"conditions\": {\n          \"conditions\": [\n            {\n              \"leftValue\": \"={{ $json.escalate }}\",\n              \"rightValue\": true,\n              \"operator\": {\n                \"type\": \"boolean\",\n                \"operation\": \"equals\"\n              }\n            }\n          ]\n        }\n      },\n      \"id\": \"escalate-if\",\n      \"name\": \"Escalate?\",\n      \"type\": \"n8n-nodes-base.if\",\n      \"typeVersion\": 2,\n      \"position\": [\n        1920,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"command\": \"=echo '{\\\"role\\\":\\\"pm\\\",\\\"task\\\":\\\"prd-scoring\\\",\\\"version\\\":\\\"{{ $('Slack: trigger').item.json.text }}\\\"}' \u003e /tmp/pm.json \u0026\u0026 omp run --mode json --role slow @/tmp/pm.json\"\n      },\n      \"id\": \"spawn-pm\",\n      \"name\": \"Spawn PM Pod (gate C)\",\n      \"type\": \"n8n-nodes-base.executeCommand\",\n      \"typeVersion\": 1,\n      \"position\": [\n        2160,\n        200\n      ]\n    },\n    {\n      \"parameters\": {\n        \"channelId\": \"={{ $('Mattermost: trigger').item.json.body.channel_id }}\",\n        \"message\": \"@{{ $('Mattermost: trigger').item.json.body.user_name }} :rocket: *Sprint plan ready* for `{{ $('Slack: trigger').item.json.text }}`\\nPRD + task breakdown complete. Review and run `/kickoff` when ready.\",\n        \"otherOptions\": {}\n      },\n      \"id\": \"notify-done-01\",\n      \"name\": \"Mattermost: plan-release complete\",\n      \"type\": \"n8n-nodes-base.mattermost\",\n      \"typeVersion\": 1,\n      \"position\": [\n        2400,\n        200\n      ],\n      \"credentials\": {\n        \"mattermostApi\": {\n          \"id\": \"mm-creds\",\n          \"name\": \"Mattermost SDLC Bot\"\n        }\n      }\n    },\n    {\n      \"parameters\": {\n        \"channelId\": \"={{ $('Mattermost: trigger').item.json.body.channel_id }}\",\n        \"message\": \"@{{ $('Mattermost: trigger').item.json.body.user_name }} :warning: *Architecture revision limit reached* (3 rounds)\\nManual review required before continuing. Check release ticket for details.\",\n        \"otherOptions\": {}\n      },\n      \"id\": \"notify-escalate-01\",\n      \"name\": \"Mattermost: escalation\",\n      \"type\": \"n8n-nodes-base.mattermost\",\n      \"typeVersion\": 1,\n      \"position\": [\n        2160,\n        440\n      ],\n      \"credentials\": {\n        \"mattermostApi\": {\n          \"id\": \"mm-creds\",\n          \"name\": \"Mattermost SDLC Bot\"\n        }\n      }\n    }\n  ],\n  \"connections\": {\n    \"Mattermost: trigger\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Mattermost: ack received\",\n            \"type\": \"main\",\n            \"index\": 0\n          },\n          {\n            \"node\": \"Mattermost: ack command\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Mattermost: ack received\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Spawn Architect Pod (gate A)\",\n            \"type\": \"main\",\n            \"index\": 0\n          },\n          {\n            \"node\": \"Spawn Data Engineer Pod (gate A)\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Spawn Architect Pod (gate A)\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Gate A complete?\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Spawn Data Engineer Pod (gate A)\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Gate A complete?\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Gate A complete?\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Mattermost: gate A complete\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Mattermost: gate A complete\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Spawn QA Pod (gate B)\",\n            \"type\": \"main\",\n            \"index\": 0\n          },\n          {\n            \"node\": \"Spawn Security Pod (gate B)\",\n            \"type\": \"main\",\n            \"index\": 0\n          },\n          {\n            \"node\": \"Spawn UX Pod (gate B)\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Spawn QA Pod (gate B)\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Arch revision check (max 3)\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Spawn Security Pod (gate B)\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Arch revision check (max 3)\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Spawn UX Pod (gate B)\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Arch revision check (max 3)\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Arch revision check (max 3)\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Escalate?\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Escalate?\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Spawn PM Pod (gate C)\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ],\n        [\n          {\n            \"node\": \"Mattermost: escalation\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Spawn PM Pod (gate C)\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Mattermost: plan-release complete\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    }\n  },\n  \"active\": true,\n  \"settings\": {\n    \"executionOrder\": \"v1\"\n  },\n  \"tags\": [\n    {\n      \"name\": \"planning\"\n    },\n    {\n      \"name\": \"phase-0\"\n    },\n    {\n      \"name\": \"mattermost\"\n    }\n  ]\n}\n","F-02-kickoff.json":"{\n  \"name\": \"F-02 /kickoff\",\n  \"nodes\": [\n    {\n      \"parameters\": {\n        \"httpMethod\": \"POST\",\n        \"path\": \"mm-kickoff\",\n        \"responseMode\": \"responseNode\",\n        \"options\": {}\n      },\n      \"id\": \"slack-trigger\",\n      \"name\": \"Mattermost: trigger\",\n      \"type\": \"n8n-nodes-base.webhook\",\n      \"typeVersion\": 1,\n      \"position\": [\n        240,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"respondWith\": \"json\",\n        \"responseBody\": \"{\\\"response_type\\\": \\\"ephemeral\\\", \\\"text\\\": \\\":hourglass_flowing_sand: Running `/kickoff`...\\\"}\"\n      },\n      \"id\": \"mm-ack-slack-trigger\",\n      \"name\": \"Mattermost: ack command\",\n      \"type\": \"n8n-nodes-base.respondToWebhook\",\n      \"typeVersion\": 1,\n      \"position\": [\n        480,\n        200\n      ]\n    },\n    {\n      \"parameters\": {\n        \"channelId\": \"={{ $('Mattermost: trigger').item.json.body.channel_id }}\",\n        \"message\": \"@{{ $('Mattermost: trigger').item.json.body.user_name }} :rocket: *Kickoff started* for `{{ $json.text }}`\\nSpawning 3 parallel tracks: TL branches · PM GitLab artifacts · DevOps infra + webhook...\",\n        \"otherOptions\": {}\n      },\n      \"id\": \"ack-02\",\n      \"name\": \"Mattermost: kickoff started\",\n      \"type\": \"n8n-nodes-base.mattermost\",\n      \"typeVersion\": 1,\n      \"position\": [\n        480,\n        300\n      ],\n      \"credentials\": {\n        \"mattermostApi\": {\n          \"id\": \"mm-creds\",\n          \"name\": \"Mattermost SDLC Bot\"\n        }\n      }\n    },\n    {\n      \"parameters\": {\n        \"command\": \"=echo '{\\\"role\\\":\\\"tech-lead\\\",\\\"task\\\":\\\"kickoff-branches\\\",\\\"version\\\":\\\"{{ $('Slack: trigger').item.json.text }}\\\"}' \u003e /tmp/tl.json \u0026\u0026 omp run --mode json --role slow @/tmp/tl.json\"\n      },\n      \"id\": \"spawn-tl\",\n      \"name\": \"Spawn TL Pod: branches+openspec+pseudocode\",\n      \"type\": \"n8n-nodes-base.executeCommand\",\n      \"typeVersion\": 1,\n      \"position\": [\n        720,\n        160\n      ]\n    },\n    {\n      \"parameters\": {\n        \"command\": \"=echo '{\\\"role\\\":\\\"pm\\\",\\\"task\\\":\\\"kickoff-gitlab-artifacts\\\",\\\"version\\\":\\\"{{ $('Slack: trigger').item.json.text }}\\\"}' \u003e /tmp/pm.json \u0026\u0026 opencode run --print \\\"$(cat /tmp/pm.json)\\\"\"\n      },\n      \"id\": \"spawn-pm\",\n      \"name\": \"Spawn PM Pod: GitLab artifacts (opencode)\",\n      \"type\": \"n8n-nodes-base.executeCommand\",\n      \"typeVersion\": 1,\n      \"position\": [\n        720,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"command\": \"=echo '{\\\"role\\\":\\\"devops\\\",\\\"task\\\":\\\"kickoff-infra-webhook\\\",\\\"version\\\":\\\"{{ $('Slack: trigger').item.json.text }}\\\"}' \u003e /tmp/do.json \u0026\u0026 omp run --mode json --role default @/tmp/do.json\"\n      },\n      \"id\": \"spawn-do\",\n      \"name\": \"Spawn DevOps Pod: infra+webhook+CI vars\",\n      \"type\": \"n8n-nodes-base.executeCommand\",\n      \"typeVersion\": 1,\n      \"position\": [\n        720,\n        440\n      ]\n    },\n    {\n      \"parameters\": {\n        \"jsCode\": \"const tl=$node['Spawn TL Pod: branches+openspec+pseudocode'].json.exitCode;\\nconst pm=$node['Spawn PM Pod: GitLab artifacts (opencode)'].json.exitCode;\\nconst dv=$node['Spawn DevOps Pod: infra+webhook+CI vars'].json.exitCode;\\nreturn [{json:{ok:tl===0\u0026\u0026pm===0\u0026\u0026dv===0,tl,pm,dv}}];\"\n      },\n      \"id\": \"all-done-02\",\n      \"name\": \"All 3 tracks complete?\",\n      \"type\": \"n8n-nodes-base.code\",\n      \"typeVersion\": 2,\n      \"position\": [\n        960,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"channelId\": \"={{ $('Mattermost: trigger').item.json.body.channel_id }}\",\n        \"message\": \"@{{ $('Mattermost: trigger').item.json.body.user_name }} :white_check_mark: *Kickoff complete* for `{{ $('Slack: trigger').item.json.text }}`\\n• Branches created + openspec + pseudocode committed\\n• GitLab milestone, stories, tasks, release ticket created\\n• Infra provisioned · GitLab group webhook registered\\n\\nReview branches and openspec, then run `/develop` to start.\",\n        \"otherOptions\": {}\n      },\n      \"id\": \"notify-02\",\n      \"name\": \"Mattermost: kickoff complete\",\n      \"type\": \"n8n-nodes-base.mattermost\",\n      \"typeVersion\": 1,\n      \"position\": [\n        1200,\n        300\n      ],\n      \"credentials\": {\n        \"mattermostApi\": {\n          \"id\": \"mm-creds\",\n          \"name\": \"Mattermost SDLC Bot\"\n        }\n      }\n    }\n  ],\n  \"connections\": {\n    \"Mattermost: trigger\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Mattermost: kickoff started\",\n            \"type\": \"main\",\n            \"index\": 0\n          },\n          {\n            \"node\": \"Mattermost: ack command\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Mattermost: kickoff started\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Spawn TL Pod: branches+openspec+pseudocode\",\n            \"type\": \"main\",\n            \"index\": 0\n          },\n          {\n            \"node\": \"Spawn PM Pod: GitLab artifacts (opencode)\",\n            \"type\": \"main\",\n            \"index\": 0\n          },\n          {\n            \"node\": \"Spawn DevOps Pod: infra+webhook+CI vars\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Spawn TL Pod: branches+openspec+pseudocode\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"All 3 tracks complete?\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Spawn PM Pod: GitLab artifacts (opencode)\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"All 3 tracks complete?\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Spawn DevOps Pod: infra+webhook+CI vars\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"All 3 tracks complete?\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"All 3 tracks complete?\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Mattermost: kickoff complete\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    }\n  },\n  \"active\": true,\n  \"settings\": {\n    \"executionOrder\": \"v1\"\n  },\n  \"tags\": [\n    {\n      \"name\": \"planning\"\n    },\n    {\n      \"name\": \"phase-0\"\n    },\n    {\n      \"name\": \"mattermost\"\n    }\n  ]\n}\n","F-03-develop.json":"{\n  \"name\": \"F-03 /develop\",\n  \"nodes\": [\n    {\n      \"parameters\": {\n        \"httpMethod\": \"POST\",\n        \"path\": \"mm-develop\",\n        \"responseMode\": \"responseNode\",\n        \"options\": {}\n      },\n      \"id\": \"slack-trigger\",\n      \"name\": \"Mattermost: trigger\",\n      \"type\": \"n8n-nodes-base.webhook\",\n      \"typeVersion\": 1,\n      \"position\": [\n        240,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"respondWith\": \"json\",\n        \"responseBody\": \"{\\\"response_type\\\": \\\"ephemeral\\\", \\\"text\\\": \\\":hourglass_flowing_sand: Running `/develop`...\\\"}\"\n      },\n      \"id\": \"mm-ack-slack-trigger\",\n      \"name\": \"Mattermost: ack command\",\n      \"type\": \"n8n-nodes-base.respondToWebhook\",\n      \"typeVersion\": 1,\n      \"position\": [\n        480,\n        200\n      ]\n    },\n    {\n      \"parameters\": {\n        \"channelId\": \"={{ $('Mattermost: trigger').item.json.body.channel_id }}\",\n        \"message\": \"@{{ $('Mattermost: trigger').item.json.body.user_name }} :hourglass_flowing_sand: *Development started* for `={{ $('Slack: trigger').item.json.text }}`\\nActivating sprint DAG · spawning DevOps gate A...\",\n        \"otherOptions\": {}\n      },\n      \"id\": \"ack-03\",\n      \"name\": \"Mattermost: develop started\",\n      \"type\": \"n8n-nodes-base.mattermost\",\n      \"typeVersion\": 1,\n      \"position\": [\n        480,\n        300\n      ],\n      \"credentials\": {\n        \"mattermostApi\": {\n          \"id\": \"mm-creds\",\n          \"name\": \"Mattermost SDLC Bot\"\n        }\n      }\n    },\n    {\n      \"parameters\": {\n        \"jsCode\": \"$workflow.staticData.dagState={version:$('Slack: trigger').item.json.text,project:$('Slack: trigger').item.json.user_name,stories:{},retryCounters:{}};\\nreturn [{json:{status:'dag-activated'}}];\"\n      },\n      \"id\": \"activate-dag\",\n      \"name\": \"Activate sprint DAG\",\n      \"type\": \"n8n-nodes-base.code\",\n      \"typeVersion\": 2,\n      \"position\": [\n        720,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"command\": \"=echo '{\\\"role\\\":\\\"devops\\\",\\\"task\\\":\\\"gate-A-infra-check\\\"}' \u003e /tmp/gA.json \u0026\u0026 omp run --mode json --role default @/tmp/gA.json\"\n      },\n      \"id\": \"spawn-do-a\",\n      \"name\": \"Spawn DevOps Pod (gate A)\",\n      \"type\": \"n8n-nodes-base.executeCommand\",\n      \"typeVersion\": 1,\n      \"position\": [\n        960,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"conditions\": {\n          \"conditions\": [\n            {\n              \"leftValue\": \"={{ $json.exitCode }}\",\n              \"rightValue\": 0,\n              \"operator\": {\n                \"type\": \"number\",\n                \"operation\": \"equals\"\n              }\n            }\n          ]\n        }\n      },\n      \"id\": \"gate-a\",\n      \"name\": \"Gate A: infra ready?\",\n      \"type\": \"n8n-nodes-base.if\",\n      \"typeVersion\": 2,\n      \"position\": [\n        1200,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"channelId\": \"={{ $('Mattermost: trigger').item.json.body.channel_id }}\",\n        \"message\": \"@{{ $('Mattermost: trigger').item.json.body.user_name }} :white_check_mark: Gate A (DevOps infra) ready. Spawning Data Engineer (gate B)...\",\n        \"otherOptions\": {}\n      },\n      \"id\": \"slack-gA-ok\",\n      \"name\": \"Mattermost: gate A ready\",\n      \"type\": \"n8n-nodes-base.mattermost\",\n      \"typeVersion\": 1,\n      \"position\": [\n        1440,\n        200\n      ],\n      \"credentials\": {\n        \"mattermostApi\": {\n          \"id\": \"mm-creds\",\n          \"name\": \"Mattermost SDLC Bot\"\n        }\n      }\n    },\n    {\n      \"parameters\": {\n        \"channelId\": \"={{ $('Mattermost: trigger').item.json.body.channel_id }}\",\n        \"message\": \"@{{ $('Mattermost: trigger').item.json.body.user_name }} :x: Gate A *failed* — DevOps infra not ready. Check DevOps pod logs.\",\n        \"otherOptions\": {}\n      },\n      \"id\": \"slack-gA-fail\",\n      \"name\": \"Mattermost: gate A failed\",\n      \"type\": \"n8n-nodes-base.mattermost\",\n      \"typeVersion\": 1,\n      \"position\": [\n        1440,\n        440\n      ],\n      \"credentials\": {\n        \"mattermostApi\": {\n          \"id\": \"mm-creds\",\n          \"name\": \"Mattermost SDLC Bot\"\n        }\n      }\n    },\n    {\n      \"parameters\": {\n        \"command\": \"=echo '{\\\"role\\\":\\\"data-engineer\\\",\\\"task\\\":\\\"gate-B-contracts\\\"}' \u003e /tmp/gB.json \u0026\u0026 omp run --mode json --role slow @/tmp/gB.json\"\n      },\n      \"id\": \"spawn-de-b\",\n      \"name\": \"Spawn Data Engineer Pod (gate B)\",\n      \"type\": \"n8n-nodes-base.executeCommand\",\n      \"typeVersion\": 1,\n      \"position\": [\n        1680,\n        200\n      ]\n    },\n    {\n      \"parameters\": {\n        \"conditions\": {\n          \"conditions\": [\n            {\n              \"leftValue\": \"={{ $json.exitCode }}\",\n              \"rightValue\": 0,\n              \"operator\": {\n                \"type\": \"number\",\n                \"operation\": \"equals\"\n              }\n            }\n          ]\n        }\n      },\n      \"id\": \"gate-b\",\n      \"name\": \"Gate B: types ready?\",\n      \"type\": \"n8n-nodes-base.if\",\n      \"typeVersion\": 2,\n      \"position\": [\n        1920,\n        200\n      ]\n    },\n    {\n      \"parameters\": {\n        \"channelId\": \"={{ $('Mattermost: trigger').item.json.body.channel_id }}\",\n        \"message\": \"@{{ $('Mattermost: trigger').item.json.body.user_name }} :white_check_mark: Gate B (types + contracts) ready. Spawning TL pseudocode (gate C)...\",\n        \"otherOptions\": {}\n      },\n      \"id\": \"slack-gB-ok\",\n      \"name\": \"Mattermost: gate B ready\",\n      \"type\": \"n8n-nodes-base.mattermost\",\n      \"typeVersion\": 1,\n      \"position\": [\n        2160,\n        120\n      ],\n      \"credentials\": {\n        \"mattermostApi\": {\n          \"id\": \"mm-creds\",\n          \"name\": \"Mattermost SDLC Bot\"\n        }\n      }\n    },\n    {\n      \"parameters\": {\n        \"command\": \"=echo '{\\\"role\\\":\\\"tech-lead\\\",\\\"task\\\":\\\"gate-C-pseudocode\\\"}' \u003e /tmp/gC.json \u0026\u0026 omp run --mode json --role slow @/tmp/gC.json\"\n      },\n      \"id\": \"spawn-tl-c\",\n      \"name\": \"Spawn TL Pod (gate C): pseudocode\",\n      \"type\": \"n8n-nodes-base.executeCommand\",\n      \"typeVersion\": 1,\n      \"position\": [\n        2400,\n        120\n      ]\n    },\n    {\n      \"parameters\": {\n        \"conditions\": {\n          \"conditions\": [\n            {\n              \"leftValue\": \"={{ $json.exitCode }}\",\n              \"rightValue\": 0,\n              \"operator\": {\n                \"type\": \"number\",\n                \"operation\": \"equals\"\n              }\n            }\n          ]\n        }\n      },\n      \"id\": \"gate-c\",\n      \"name\": \"Gate C: openspec:ready?\",\n      \"type\": \"n8n-nodes-base.if\",\n      \"typeVersion\": 2,\n      \"position\": [\n        2640,\n        120\n      ]\n    },\n    {\n      \"parameters\": {\n        \"channelId\": \"={{ $('Mattermost: trigger').item.json.body.channel_id }}\",\n        \"message\": \"@{{ $('Mattermost: trigger').item.json.body.user_name }} :rocket: All gates complete. Developer pods now running in parallel:\\n• Backend (smol+hashline)\\n• Frontend (smol+hashline)\\n• QA + Security (smol)\\n• DevOps (smol)\\n\\nMR opened events will drive F-04 review cycles.\",\n        \"otherOptions\": {}\n      },\n      \"id\": \"slack-gC-ok\",\n      \"name\": \"Mattermost: all pods unblocked\",\n      \"type\": \"n8n-nodes-base.mattermost\",\n      \"typeVersion\": 1,\n      \"position\": [\n        2880,\n        120\n      ],\n      \"credentials\": {\n        \"mattermostApi\": {\n          \"id\": \"mm-creds\",\n          \"name\": \"Mattermost SDLC Bot\"\n        }\n      }\n    },\n    {\n      \"parameters\": {\n        \"command\": \"=echo '{\\\"role\\\":\\\"backend-developer\\\",\\\"task\\\":\\\"implement\\\"}' \u003e /tmp/be.json \u0026\u0026 omp run --mode json --role smol @/tmp/be.json\"\n      },\n      \"id\": \"spawn-be\",\n      \"name\": \"Spawn Backend Pods\",\n      \"type\": \"n8n-nodes-base.executeCommand\",\n      \"typeVersion\": 1,\n      \"position\": [\n        3120,\n        60\n      ]\n    },\n    {\n      \"parameters\": {\n        \"command\": \"=echo '{\\\"role\\\":\\\"frontend-developer\\\",\\\"task\\\":\\\"implement\\\"}' \u003e /tmp/fe.json \u0026\u0026 omp run --mode json --role smol @/tmp/fe.json\"\n      },\n      \"id\": \"spawn-fe\",\n      \"name\": \"Spawn Frontend Pods\",\n      \"type\": \"n8n-nodes-base.executeCommand\",\n      \"typeVersion\": 1,\n      \"position\": [\n        3120,\n        180\n      ]\n    },\n    {\n      \"parameters\": {\n        \"command\": \"=echo '{\\\"role\\\":\\\"qa-engineer\\\",\\\"task\\\":\\\"write-tests\\\"}' \u003e /tmp/qa.json \u0026\u0026 omp run --mode json --role smol @/tmp/qa.json\"\n      },\n      \"id\": \"spawn-qa\",\n      \"name\": \"Spawn QA Pods\",\n      \"type\": \"n8n-nodes-base.executeCommand\",\n      \"typeVersion\": 1,\n      \"position\": [\n        3120,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"command\": \"=echo '{\\\"role\\\":\\\"devops-engineer\\\",\\\"task\\\":\\\"pipeline-config\\\"}' \u003e /tmp/dv.json \u0026\u0026 omp run --mode json --role smol @/tmp/dv.json\"\n      },\n      \"id\": \"spawn-dv\",\n      \"name\": \"Spawn DevOps Pods\",\n      \"type\": \"n8n-nodes-base.executeCommand\",\n      \"typeVersion\": 1,\n      \"position\": [\n        3120,\n        420\n      ]\n    }\n  ],\n  \"connections\": {\n    \"Mattermost: trigger\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Mattermost: develop started\",\n            \"type\": \"main\",\n            \"index\": 0\n          },\n          {\n            \"node\": \"Mattermost: ack command\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Mattermost: develop started\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Activate sprint DAG\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Activate sprint DAG\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Spawn DevOps Pod (gate A)\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Spawn DevOps Pod (gate A)\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Gate A: infra ready?\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Gate A: infra ready?\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Mattermost: gate A ready\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ],\n        [\n          {\n            \"node\": \"Mattermost: gate A failed\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Mattermost: gate A ready\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Spawn Data Engineer Pod (gate B)\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Spawn Data Engineer Pod (gate B)\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Gate B: types ready?\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Gate B: types ready?\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Mattermost: gate B ready\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Mattermost: gate B ready\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Spawn TL Pod (gate C): pseudocode\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Spawn TL Pod (gate C): pseudocode\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Gate C: openspec:ready?\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Gate C: openspec:ready?\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Mattermost: all pods unblocked\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Mattermost: all pods unblocked\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Spawn Backend Pods\",\n            \"type\": \"main\",\n            \"index\": 0\n          },\n          {\n            \"node\": \"Spawn Frontend Pods\",\n            \"type\": \"main\",\n            \"index\": 0\n          },\n          {\n            \"node\": \"Spawn QA Pods\",\n            \"type\": \"main\",\n            \"index\": 0\n          },\n          {\n            \"node\": \"Spawn DevOps Pods\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    }\n  },\n  \"active\": true,\n  \"settings\": {\n    \"executionOrder\": \"v1\"\n  },\n  \"tags\": [\n    {\n      \"name\": \"development\"\n    },\n    {\n      \"name\": \"phase-2\"\n    },\n    {\n      \"name\": \"mattermost\"\n    }\n  ]\n}\n","F-04-task-mr-opened.json":"{\n  \"name\": \"F-04 Task MR Opened\",\n  \"nodes\": [\n    {\n      \"parameters\": {\n        \"httpMethod\": \"POST\",\n        \"path\": \"gitlab-mr-opened\",\n        \"responseMode\": \"lastNode\",\n        \"options\": {}\n      },\n      \"id\": \"wh-04\",\n      \"name\": \"Webhook: gitlab-mr-opened\",\n      \"type\": \"n8n-nodes-base.webhook\",\n      \"typeVersion\": 1,\n      \"position\": [\n        240,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"conditions\": {\n          \"conditions\": [\n            {\n              \"leftValue\": \"={{ ['task/','api/','qa/','security/','devops/','bugfix/'].some(p=\u003e$json.body.object_attributes.source_branch.startsWith(p)) }}\",\n              \"rightValue\": true,\n              \"operator\": {\n                \"type\": \"number\",\n                \"operation\": \"equals\"\n              }\n            }\n          ]\n        }\n      },\n      \"id\": \"is-task\",\n      \"name\": \"Is task/api/qa/security/devops MR?\",\n      \"type\": \"n8n-nodes-base.if\",\n      \"typeVersion\": 2,\n      \"position\": [\n        480,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"jsCode\": \"const dag=$workflow.staticData.dagState||{};\\nconst mrId=$json.body.object_attributes.iid;\\ndag.retryCounters=dag.retryCounters||{};\\ndag.retryCounters[mrId]=0;\\ndag.openMRs=dag.openMRs||{};\\ndag.openMRs[mrId]={branch:$json.body.object_attributes.source_branch,status:'open'};\\n$workflow.staticData.dagState=dag;\\nreturn [{json:{mrId,retryCount:0,branch:$json.body.object_attributes.source_branch,mrUrl:$json.body.object_attributes.url}}];\"\n      },\n      \"id\": \"reg-dag\",\n      \"name\": \"Register MR + init retry counter\",\n      \"type\": \"n8n-nodes-base.code\",\n      \"typeVersion\": 2,\n      \"position\": [\n        720,\n        200\n      ]\n    },\n    {\n      \"parameters\": {\n        \"command\": \"=echo '{\\\"role\\\":\\\"tech-lead\\\",\\\"task\\\":\\\"mr-review\\\",\\\"mr_id\\\":\\\"{{ $json.body.object_attributes.iid }}\\\",\\\"mr_url\\\":\\\"{{ $json.body.object_attributes.url }}\\\"}' \u003e /tmp/tl-rev.json \u0026\u0026 omp run --mode json --role slow @/tmp/tl-rev.json\"\n      },\n      \"id\": \"spawn-tl-review\",\n      \"name\": \"Spawn TL Pod: MR review (omp slow+LSP+advisor)\",\n      \"type\": \"n8n-nodes-base.executeCommand\",\n      \"typeVersion\": 1,\n      \"position\": [\n        960,\n        160\n      ]\n    },\n    {\n      \"parameters\": {\n        \"url\": \"={{ $env.GITLAB_URL }}/api/v4/projects/{{ $json.body.project.id }}/merge_requests/{{ $json.body.object_attributes.iid }}/pipelines\",\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"per_page\",\n              \"value\": \"1\"\n            }\n          ]\n        }\n      },\n      \"id\": \"poll-ci\",\n      \"name\": \"Poll CI pipeline status\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4,\n      \"position\": [\n        960,\n        360\n      ]\n    },\n    {\n      \"parameters\": {\n        \"jsCode\": \"const tl=$node['Spawn TL Pod: MR review (omp slow+LSP+advisor)'].json.exitCode;\\nconst ci=$node['Poll CI pipeline status'].json[0]?.status;\\nreturn [{json:{ok:tl===0\u0026\u0026ci==='success',tl,ci,mrUrl:$('Webhook: gitlab-mr-opened').item.json.body.object_attributes.url}}];\"\n      },\n      \"id\": \"both-pass\",\n      \"name\": \"Both CI + TL passed?\",\n      \"type\": \"n8n-nodes-base.code\",\n      \"typeVersion\": 2,\n      \"position\": [\n        1200,\n        260\n      ]\n    },\n    {\n      \"parameters\": {\n        \"conditions\": {\n          \"conditions\": [\n            {\n              \"leftValue\": \"={{ $json.ok }}\",\n              \"rightValue\": true,\n              \"operator\": {\n                \"type\": \"number\",\n                \"operation\": \"equals\"\n              }\n            }\n          ]\n        }\n      },\n      \"id\": \"pass-check\",\n      \"name\": \"Both pass?\",\n      \"type\": \"n8n-nodes-base.if\",\n      \"typeVersion\": 2,\n      \"position\": [\n        1440,\n        260\n      ]\n    },\n    {\n      \"parameters\": {\n        \"command\": \"=glab mr merge {{ $('Webhook: gitlab-mr-opened').item.json.body.object_attributes.iid }} --auto-merge\"\n      },\n      \"id\": \"merge-mr\",\n      \"name\": \"Tech Lead merges task MR via glab\",\n      \"type\": \"n8n-nodes-base.executeCommand\",\n      \"typeVersion\": 1,\n      \"position\": [\n        1680,\n        160\n      ]\n    },\n    {\n      \"parameters\": {\n        \"channelId\": \"={{ $env.MM_SDLC_CHANNEL }}\",\n        \"message\": \":merged: *Task MR merged* — `{{ $('Webhook: gitlab-mr-opened').item.json.body.object_attributes.source_branch }}`\\nCI :white_check_mark: · TL review :white_check_mark:\\n\u003c{{ $('Webhook: gitlab-mr-opened').item.json.body.object_attributes.url }}|View MR\u003e\",\n        \"otherOptions\": {}\n      },\n      \"id\": \"slack-merged\",\n      \"name\": \"Mattermost: task MR merged\",\n      \"type\": \"n8n-nodes-base.mattermost\",\n      \"typeVersion\": 1,\n      \"position\": [\n        1920,\n        160\n      ],\n      \"credentials\": {\n        \"mattermostApi\": {\n          \"id\": \"mm-creds\",\n          \"name\": \"Mattermost SDLC Bot\"\n        }\n      }\n    },\n    {\n      \"parameters\": {\n        \"jsCode\": \"const dag=$workflow.staticData.dagState||{};\\nconst mrId=$('Webhook: gitlab-mr-opened').item.json.body.object_attributes.iid;\\nconst count=(dag.retryCounters[mrId]||0)+1;\\ndag.retryCounters[mrId]=count;\\n$workflow.staticData.dagState=dag;\\nreturn [{json:{escalate:count\u003e=3,count,mrId}}];\"\n      },\n      \"id\": \"retry-counter\",\n      \"name\": \"Increment retry counter\",\n      \"type\": \"n8n-nodes-base.code\",\n      \"typeVersion\": 2,\n      \"position\": [\n        1680,\n        380\n      ]\n    },\n    {\n      \"parameters\": {\n        \"conditions\": {\n          \"conditions\": [\n            {\n              \"leftValue\": \"={{ $json.escalate }}\",\n              \"rightValue\": true,\n              \"operator\": {\n                \"type\": \"number\",\n                \"operation\": \"equals\"\n              }\n            }\n          ]\n        }\n      },\n      \"id\": \"escalate-chk\",\n      \"name\": \"Escalate?\",\n      \"type\": \"n8n-nodes-base.if\",\n      \"typeVersion\": 2,\n      \"position\": [\n        1920,\n        380\n      ]\n    },\n    {\n      \"parameters\": {\n        \"channelId\": \"={{ $env.MM_SDLC_CHANNEL }}\",\n        \"message\": \":warning: *Fix required* on `{{ $('Webhook: gitlab-mr-opened').item.json.body.object_attributes.source_branch }}`\\nCI or TL review needs attention. Developer: check inline comments and push a fix.\\n\u003c{{ $('Webhook: gitlab-mr-opened').item.json.body.object_attributes.url }}|View MR\u003e\",\n        \"otherOptions\": {}\n      },\n      \"id\": \"slack-fix\",\n      \"name\": \"Mattermost: fix required\",\n      \"type\": \"n8n-nodes-base.mattermost\",\n      \"typeVersion\": 1,\n      \"position\": [\n        2160,\n        440\n      ],\n      \"credentials\": {\n        \"mattermostApi\": {\n          \"id\": \"mm-creds\",\n          \"name\": \"Mattermost SDLC Bot\"\n        }\n      }\n    },\n    {\n      \"parameters\": {\n        \"channelId\": \"={{ $env.MM_SDLC_CHANNEL }}\",\n        \"message\": \":rotating_light: *Escalation* — MR `{{ $('Webhook: gitlab-mr-opened').item.json.body.object_attributes.source_branch }}` has failed 3 fix attempts.\\nManual review required.\\n\u003c{{ $('Webhook: gitlab-mr-opened').item.json.body.object_attributes.url }}|View MR\u003e\",\n        \"otherOptions\": {}\n      },\n      \"id\": \"slack-escalate-04\",\n      \"name\": \"Mattermost: MR escalation\",\n      \"type\": \"n8n-nodes-base.mattermost\",\n      \"typeVersion\": 1,\n      \"position\": [\n        2160,\n        300\n      ],\n      \"credentials\": {\n        \"mattermostApi\": {\n          \"id\": \"mm-creds\",\n          \"name\": \"Mattermost SDLC Bot\"\n        }\n      }\n    }\n  ],\n  \"connections\": {\n    \"Webhook: gitlab-mr-opened\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Is task/api/qa/security/devops MR?\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Is task/api/qa/security/devops MR?\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Register MR + init retry counter\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Register MR + init retry counter\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Spawn TL Pod: MR review (omp slow+LSP+advisor)\",\n            \"type\": \"main\",\n            \"index\": 0\n          },\n          {\n            \"node\": \"Poll CI pipeline status\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Spawn TL Pod: MR review (omp slow+LSP+advisor)\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Both CI + TL passed?\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Poll CI pipeline status\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Both CI + TL passed?\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Both CI + TL passed?\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Both pass?\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Both pass?\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Tech Lead merges task MR via glab\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ],\n        [\n          {\n            \"node\": \"Increment retry counter\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Tech Lead merges task MR via glab\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Mattermost: task MR merged\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Increment retry counter\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Escalate?\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Escalate?\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Mattermost: MR escalation\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ],\n        [\n          {\n            \"node\": \"Mattermost: fix required\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    }\n  },\n  \"active\": true,\n  \"settings\": {\n    \"executionOrder\": \"v1\"\n  },\n  \"tags\": [\n    {\n      \"name\": \"development\"\n    },\n    {\n      \"name\": \"phase-2\"\n    },\n    {\n      \"name\": \"mattermost\"\n    }\n  ]\n}\n","F-05-task-mr-merged.json":"{\n  \"name\": \"F-05 Task MR Merged\",\n  \"nodes\": [\n    {\n      \"parameters\": {\n        \"httpMethod\": \"POST\",\n        \"path\": \"gitlab-mr-merged\",\n        \"responseMode\": \"lastNode\",\n        \"options\": {}\n      },\n      \"id\": \"wh-05\",\n      \"name\": \"Webhook: gitlab-mr-merged\",\n      \"type\": \"n8n-nodes-base.webhook\",\n      \"typeVersion\": 1,\n      \"position\": [\n        240,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"jsCode\": \"const dag=$workflow.staticData.dagState||{};\\nconst mrId=$json.body.mr_id||$json.body.object_attributes?.iid;\\nif(dag.openMRs\u0026\u0026dag.openMRs[mrId])dag.openMRs[mrId].status='merged';\\nconst storyId=$json.body.story_id;\\nconst all=Object.values(dag.openMRs||{}).filter(m=\u003em.storyId===storyId).every(m=\u003em.status==='merged');\\n$workflow.staticData.dagState=dag;\\nreturn [{json:{mrId,storyId,allTasksMerged:all}}];\"\n      },\n      \"id\": \"upd-dag\",\n      \"name\": \"Update DAG: task merged\",\n      \"type\": \"n8n-nodes-base.code\",\n      \"typeVersion\": 2,\n      \"position\": [\n        480,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"conditions\": {\n          \"conditions\": [\n            {\n              \"leftValue\": \"={{ $json.allTasksMerged }}\",\n              \"rightValue\": true,\n              \"operator\": {\n                \"type\": \"boolean\",\n                \"operation\": \"equals\"\n              }\n            }\n          ]\n        }\n      },\n      \"id\": \"all-merged\",\n      \"name\": \"All story tasks merged?\",\n      \"type\": \"n8n-nodes-base.if\",\n      \"typeVersion\": 2,\n      \"position\": [\n        720,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/dod-check\",\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"story_id\",\n              \"value\": \"={{ $json.storyId }}\"\n            }\n          ]\n        }\n      },\n      \"id\": \"trig-f06\",\n      \"name\": \"Trigger F-06: DoD check\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4,\n      \"position\": [\n        960,\n        200\n      ]\n    },\n    {\n      \"parameters\": {\n        \"channelId\": \"={{ $env.MM_SDLC_CHANNEL }}\",\n        \"message\": \":white_check_mark: All tasks merged for story `{{ $json.storyId }}`. Running DoD check...\",\n        \"otherOptions\": {}\n      },\n      \"id\": \"slack-05\",\n      \"name\": \"Mattermost: all tasks merged\",\n      \"type\": \"n8n-nodes-base.mattermost\",\n      \"typeVersion\": 1,\n      \"position\": [\n        960,\n        200\n      ],\n      \"credentials\": {\n        \"mattermostApi\": {\n          \"id\": \"mm-creds\",\n          \"name\": \"Mattermost SDLC Bot\"\n        }\n      }\n    }\n  ],\n  \"connections\": {\n    \"Webhook: gitlab-mr-merged\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Update DAG: task merged\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Update DAG: task merged\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"All story tasks merged?\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"All story tasks merged?\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Mattermost: all tasks merged\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Mattermost: all tasks merged\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Trigger F-06: DoD check\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    }\n  },\n  \"active\": true,\n  \"settings\": {\n    \"executionOrder\": \"v1\"\n  },\n  \"tags\": [\n    {\n      \"name\": \"development\"\n    },\n    {\n      \"name\": \"phase-2\"\n    },\n    {\n      \"name\": \"mattermost\"\n    }\n  ]\n}\n","F-06-dod-check.json":"{\n  \"name\": \"F-06 DoD Check\",\n  \"nodes\": [\n    {\n      \"parameters\": {\n        \"httpMethod\": \"POST\",\n        \"path\": \"dod-check\",\n        \"responseMode\": \"lastNode\",\n        \"options\": {}\n      },\n      \"id\": \"wh-06\",\n      \"name\": \"Webhook: dod-check\",\n      \"type\": \"n8n-nodes-base.webhook\",\n      \"typeVersion\": 1,\n      \"position\": [\n        240,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"command\": \"=echo '{\\\"role\\\":\\\"tech-lead\\\",\\\"task\\\":\\\"dod-check\\\",\\\"story_id\\\":\\\"{{ $json.body.story_id }}\\\"}' \u003e /tmp/dod.json \u0026\u0026 omp run --mode json --role slow @/tmp/dod.json\"\n      },\n      \"id\": \"spawn-tl-dod\",\n      \"name\": \"Spawn TL Pod: DoD check\",\n      \"type\": \"n8n-nodes-base.executeCommand\",\n      \"typeVersion\": 1,\n      \"position\": [\n        480,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"conditions\": {\n          \"conditions\": [\n            {\n              \"leftValue\": \"={{ $json.exitCode }}\",\n              \"rightValue\": 0,\n              \"operator\": {\n                \"type\": \"number\",\n                \"operation\": \"equals\"\n              }\n            }\n          ]\n        }\n      },\n      \"id\": \"dod-pass\",\n      \"name\": \"DoD satisfied?\",\n      \"type\": \"n8n-nodes-base.if\",\n      \"typeVersion\": 2,\n      \"position\": [\n        720,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/story-mr-open\",\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"story_id\",\n              \"value\": \"={{ $json.body.story_id }}\"\n            }\n          ]\n        }\n      },\n      \"id\": \"trig-f07\",\n      \"name\": \"Trigger F-07: open story MR\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4,\n      \"position\": [\n        960,\n        200\n      ]\n    },\n    {\n      \"parameters\": {\n        \"channelId\": \"={{ $env.MM_SDLC_CHANNEL }}\",\n        \"message\": \":white_check_mark: DoD passed for `{{ $json.body.story_id }}`. Opening story MR...\",\n        \"otherOptions\": {}\n      },\n      \"id\": \"slack-dod-pass\",\n      \"name\": \"Mattermost: DoD passed\",\n      \"type\": \"n8n-nodes-base.mattermost\",\n      \"typeVersion\": 1,\n      \"position\": [\n        960,\n        200\n      ],\n      \"credentials\": {\n        \"mattermostApi\": {\n          \"id\": \"mm-creds\",\n          \"name\": \"Mattermost SDLC Bot\"\n        }\n      }\n    },\n    {\n      \"parameters\": {\n        \"channelId\": \"={{ $env.MM_SDLC_CHANNEL }}\",\n        \"message\": \":x: DoD *failed* for `{{ $json.body.story_id }}`. Feedback sent to developer. Fix cycle restarting...\",\n        \"otherOptions\": {}\n      },\n      \"id\": \"slack-dod-fail\",\n      \"name\": \"Mattermost: DoD failed\",\n      \"type\": \"n8n-nodes-base.mattermost\",\n      \"typeVersion\": 1,\n      \"position\": [\n        960,\n        440\n      ],\n      \"credentials\": {\n        \"mattermostApi\": {\n          \"id\": \"mm-creds\",\n          \"name\": \"Mattermost SDLC Bot\"\n        }\n      }\n    },\n    {\n      \"parameters\": {\n        \"jsCode\": \"const dag=$workflow.staticData.dagState||{};\\nconst sid=$json.body.story_id;\\ndag.dodRetries=dag.dodRetries||{};\\ndag.dodRetries[sid]=(dag.dodRetries[sid]||0)+1;\\n$workflow.staticData.dagState=dag;\\nreturn [{json:{retries:dag.dodRetries[sid],storyId:sid}}];\"\n      },\n      \"id\": \"dod-retry\",\n      \"name\": \"DoD fail: feedback + re-trigger F-04\",\n      \"type\": \"n8n-nodes-base.code\",\n      \"typeVersion\": 2,\n      \"position\": [\n        1200,\n        440\n      ]\n    }\n  ],\n  \"connections\": {\n    \"Webhook: dod-check\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Spawn TL Pod: DoD check\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Spawn TL Pod: DoD check\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"DoD satisfied?\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"DoD satisfied?\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Mattermost: DoD passed\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ],\n        [\n          {\n            \"node\": \"Mattermost: DoD failed\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Mattermost: DoD passed\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Trigger F-07: open story MR\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Mattermost: DoD failed\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"DoD fail: feedback + re-trigger F-04\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    }\n  },\n  \"active\": true,\n  \"settings\": {\n    \"executionOrder\": \"v1\"\n  },\n  \"tags\": [\n    {\n      \"name\": \"development\"\n    },\n    {\n      \"name\": \"phase-2\"\n    },\n    {\n      \"name\": \"mattermost\"\n    }\n  ]\n}\n","F-07-flow.json":"{\n  \"name\": \"F-07 Story MR Opened\",\n  \"nodes\": [\n    {\n      \"parameters\": {\n        \"httpMethod\": \"POST\",\n        \"path\": \"story-mr-open\",\n        \"responseMode\": \"lastNode\",\n        \"options\": {}\n      },\n      \"id\": \"wh-07\",\n      \"name\": \"Webhook: story-mr-open\",\n      \"type\": \"n8n-nodes-base.webhook\",\n      \"typeVersion\": 1,\n      \"position\": [\n        240,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"command\": \"=echo '{\\\"role\\\":\\\"tech-lead\\\",\\\"task\\\":\\\"open-story-mr\\\",\\\"story_id\\\":\\\"{{ $json.body.story_id }}\\\"}' \u003e /tmp/smr.json \u0026\u0026 opencode run --print \\\"$(cat /tmp/smr.json)\\\"\"\n      },\n      \"id\": \"tl-story-mr\",\n      \"name\": \"TL opens story MR (opencode+glab)\",\n      \"type\": \"n8n-nodes-base.executeCommand\",\n      \"typeVersion\": 1,\n      \"position\": [\n        480,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"command\": \"=sleep 30 \u0026\u0026 echo 'QA cluster deployment complete'\"\n      },\n      \"id\": \"wait-qa-deploy\",\n      \"name\": \"Wait: CI deploys rc to QA cluster\",\n      \"type\": \"n8n-nodes-base.executeCommand\",\n      \"typeVersion\": 1,\n      \"position\": [\n        720,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"command\": \"=echo '{\\\"role\\\":\\\"qa-engineer\\\",\\\"task\\\":\\\"story-testing\\\",\\\"story_id\\\":\\\"{{ $json.body.story_id }}\\\"}' \u003e /tmp/qa-s.json \u0026\u0026 omp run --mode json --role smol @/tmp/qa-s.json\"\n      },\n      \"id\": \"spawn-qa\",\n      \"name\": \"Spawn QA Pod: story-level testing\",\n      \"type\": \"n8n-nodes-base.executeCommand\",\n      \"typeVersion\": 1,\n      \"position\": [\n        960,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"channelId\": \"={{ $env.MM_SDLC_CHANNEL }}\",\n        \"message\": \":eyes: *Story MR ready for your review* — `{{ $json.body.story_id }}`\\nQA story-level tests running on QA cluster.\\n\\n*Your action:* review + approve + merge the story MR.\",\n        \"otherOptions\": {}\n      },\n      \"id\": \"slack-07\",\n      \"name\": \"Mattermost: story MR ready for review\",\n      \"type\": \"n8n-nodes-base.mattermost\",\n      \"typeVersion\": 1,\n      \"position\": [\n        1200,\n        300\n      ],\n      \"credentials\": {\n        \"mattermostApi\": {\n          \"id\": \"mm-creds\",\n          \"name\": \"Mattermost SDLC Bot\"\n        }\n      }\n    }\n  ],\n  \"connections\": {\n    \"Webhook: story-mr-open\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"TL opens story MR (opencode+glab)\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"TL opens story MR (opencode+glab)\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Wait: CI deploys rc to QA cluster\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Wait: CI deploys rc to QA cluster\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Spawn QA Pod: story-level testing\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Spawn QA Pod: story-level testing\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Mattermost: story MR ready for review\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    }\n  },\n  \"active\": true,\n  \"settings\": {\n    \"executionOrder\": \"v1\"\n  },\n  \"tags\": [\n    {\n      \"name\": \"development\"\n    },\n    {\n      \"name\": \"phase-2\"\n    },\n    {\n      \"name\": \"mattermost\"\n    }\n  ]\n}\n","F-08-flow.json":"{\n  \"name\": \"F-08 Story MR Merged\",\n  \"nodes\": [\n    {\n      \"parameters\": {\n        \"httpMethod\": \"POST\",\n        \"path\": \"story-mr-merged\",\n        \"responseMode\": \"lastNode\",\n        \"options\": {}\n      },\n      \"id\": \"wh-08\",\n      \"name\": \"Webhook: story-mr-merged\",\n      \"type\": \"n8n-nodes-base.webhook\",\n      \"typeVersion\": 1,\n      \"position\": [\n        240,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"command\": \"=glab issue update {{ $json.body.story_id }} --label-add 'merged-to-release' \u0026\u0026 glab issue close {{ $json.body.story_id }}\"\n      },\n      \"id\": \"close-story\",\n      \"name\": \"Close story ticket + label merged-to-release\",\n      \"type\": \"n8n-nodes-base.executeCommand\",\n      \"typeVersion\": 1,\n      \"position\": [\n        480,\n        200\n      ]\n    },\n    {\n      \"parameters\": {\n        \"command\": \"=echo 'Closing child tasks for {{ $json.body.story_id }}'\"\n      },\n      \"id\": \"close-tasks\",\n      \"name\": \"Close all child task tickets\",\n      \"type\": \"n8n-nodes-base.executeCommand\",\n      \"typeVersion\": 1,\n      \"position\": [\n        480,\n        320\n      ]\n    },\n    {\n      \"parameters\": {\n        \"command\": \"=glab issue comment {{ $json.body.release_ticket_id }} --message 'Story GL-{{ $json.body.story_id }} merged to release. Time: {{ new Date().toISOString() }}'\"\n      },\n      \"id\": \"update-rel\",\n      \"name\": \"Update release ticket: deployment log\",\n      \"type\": \"n8n-nodes-base.executeCommand\",\n      \"typeVersion\": 1,\n      \"position\": [\n        480,\n        440\n      ]\n    },\n    {\n      \"parameters\": {\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/cluster-sleep\",\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"cluster\",\n              \"value\": \"qa\"\n            }\n          ]\n        }\n      },\n      \"id\": \"sleep-qa\",\n      \"name\": \"Sleep QA cluster (F-27)\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4,\n      \"position\": [\n        480,\n        560\n      ]\n    },\n    {\n      \"parameters\": {\n        \"jsCode\": \"const dag=$workflow.staticData.dagState||{};\\ndag.mergedStories=dag.mergedStories||[];\\ndag.mergedStories.push($json.body.story_id);\\n$workflow.staticData.dagState=dag;\\nconst all=(dag.mergedStories.length\u003e=(dag.totalStories||999));\\nreturn [{json:{allMerged:all,merged:dag.mergedStories.length,total:dag.totalStories||'?',version:dag.version}}];\"\n      },\n      \"id\": \"check-all-stories\",\n      \"name\": \"All stories merged?\",\n      \"type\": \"n8n-nodes-base.code\",\n      \"typeVersion\": 2,\n      \"position\": [\n        720,\n        380\n      ]\n    },\n    {\n      \"parameters\": {\n        \"channelId\": \"={{ $env.MM_SDLC_CHANNEL }}\",\n        \"message\": \":tada: *All stories merged* to `release/{{ $json.version }}`!\\n\\nRun `/uat {{ $json.version }}` when ready to start UAT.\",\n        \"otherOptions\": {}\n      },\n      \"id\": \"slack-all-done\",\n      \"name\": \"Mattermost: all stories merged — ready for UAT\",\n      \"type\": \"n8n-nodes-base.mattermost\",\n      \"typeVersion\": 1,\n      \"position\": [\n        1200,\n        260\n      ],\n      \"credentials\": {\n        \"mattermostApi\": {\n          \"id\": \"mm-creds\",\n          \"name\": \"Mattermost SDLC Bot\"\n        }\n      }\n    },\n    {\n      \"parameters\": {\n        \"channelId\": \"={{ $env.MM_SDLC_CHANNEL }}\",\n        \"message\": \"✅ Story `{{ $json.body.story_id }}` merged to release branch. Remaining: {{ (($json.total||0)-($json.merged||0)) }} stories.\",\n        \"otherOptions\": {}\n      },\n      \"id\": \"slack-one-merged\",\n      \"name\": \"Mattermost: story merged\",\n      \"type\": \"n8n-nodes-base.mattermost\",\n      \"typeVersion\": 1,\n      \"position\": [\n        1200,\n        500\n      ],\n      \"credentials\": {\n        \"mattermostApi\": {\n          \"id\": \"mm-creds\",\n          \"name\": \"Mattermost SDLC Bot\"\n        }\n      }\n    },\n    {\n      \"parameters\": {\n        \"conditions\": {\n          \"conditions\": [\n            {\n              \"leftValue\": \"={{ $json.allMerged }}\",\n              \"rightValue\": true,\n              \"operator\": {\n                \"type\": \"boolean\",\n                \"operation\": \"equals\"\n              }\n            }\n          ]\n        }\n      },\n      \"id\": \"all-merged-f08\",\n      \"name\": \"All stories merged? [if check]\",\n      \"type\": \"n8n-nodes-base.if\",\n      \"typeVersion\": 2,\n      \"position\": [\n        1200,\n        380\n      ]\n    }\n  ],\n  \"connections\": {\n    \"Webhook: story-mr-merged\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Close story ticket + label merged-to-release\",\n            \"type\": \"main\",\n            \"index\": 0\n          },\n          {\n            \"node\": \"Close all child task tickets\",\n            \"type\": \"main\",\n            \"index\": 0\n          },\n          {\n            \"node\": \"Update release ticket: deployment log\",\n            \"type\": \"main\",\n            \"index\": 0\n          },\n          {\n            \"node\": \"Sleep QA cluster (F-27)\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Close story ticket + label merged-to-release\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"All stories merged?\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"All stories merged?\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"All stories merged? [if check]\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"All stories merged? [if check]\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Mattermost: all stories merged — ready for UAT\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ],\n        [\n          {\n            \"node\": \"Mattermost: story merged\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    }\n  },\n  \"active\": true,\n  \"settings\": {\n    \"executionOrder\": \"v1\"\n  },\n  \"tags\": [\n    {\n      \"name\": \"development\"\n    },\n    {\n      \"name\": \"phase-2\"\n    },\n    {\n      \"name\": \"mattermost\"\n    }\n  ]\n}\n","F-09-flow.json":"{\n  \"name\": \"F-09 Version Built (CI Webhook)\",\n  \"nodes\": [\n    {\n      \"parameters\": {\n        \"httpMethod\": \"POST\",\n        \"path\": \"ci-version-built\",\n        \"responseMode\": \"lastNode\",\n        \"options\": {}\n      },\n      \"id\": \"wh-09\",\n      \"name\": \"Webhook: ci-version-built\",\n      \"type\": \"n8n-nodes-base.webhook\",\n      \"typeVersion\": 1,\n      \"position\": [\n        240,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"jsCode\": \"const dag=$workflow.staticData.dagState||{};\\ndag.builtImages=dag.builtImages||{};\\ndag.builtImages[$json.body.service]={rcTag:$json.body.rc_tag,image:$json.body.image,builtAt:new Date().toISOString()};\\n$workflow.staticData.dagState=dag;\\nreturn [{json:{service:$json.body.service,rcTag:$json.body.rc_tag}}];\"\n      },\n      \"id\": \"upd-img\",\n      \"name\": \"Update n8n state: rc image built\",\n      \"type\": \"n8n-nodes-base.code\",\n      \"typeVersion\": 2,\n      \"position\": [\n        480,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"channelId\": \"={{ $env.MM_SDLC_CHANNEL }}\",\n        \"message\": \":package: RC image built — `{{ $json.body.service }}:{{ $json.body.rc_tag }}`\\nArgoCD Image Updater deploying to SIT automatically.\",\n        \"otherOptions\": {}\n      },\n      \"id\": \"slack-09\",\n      \"name\": \"Mattermost: rc image built\",\n      \"type\": \"n8n-nodes-base.mattermost\",\n      \"typeVersion\": 1,\n      \"position\": [\n        720,\n        300\n      ],\n      \"credentials\": {\n        \"mattermostApi\": {\n          \"id\": \"mm-creds\",\n          \"name\": \"Mattermost SDLC Bot\"\n        }\n      }\n    }\n  ],\n  \"connections\": {\n    \"Webhook: ci-version-built\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Update n8n state: rc image built\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Update n8n state: rc image built\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Mattermost: rc image built\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    }\n  },\n  \"active\": true,\n  \"settings\": {\n    \"executionOrder\": \"v1\"\n  },\n  \"tags\": [\n    {\n      \"name\": \"development\"\n    },\n    {\n      \"name\": \"phase-2\"\n    },\n    {\n      \"name\": \"mattermost\"\n    }\n  ]\n}\n","F-10-uat.json":"{\n  \"name\": \"F-10 /uat\",\n  \"nodes\": [\n    {\n      \"parameters\": {\n        \"httpMethod\": \"POST\",\n        \"path\": \"mm-uat\",\n        \"responseMode\": \"responseNode\",\n        \"options\": {}\n      },\n      \"id\": \"slack-trigger\",\n      \"name\": \"Mattermost: trigger\",\n      \"type\": \"n8n-nodes-base.webhook\",\n      \"typeVersion\": 1,\n      \"position\": [\n        240,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"respondWith\": \"json\",\n        \"responseBody\": \"{\\\"response_type\\\": \\\"ephemeral\\\", \\\"text\\\": \\\":hourglass_flowing_sand: Running `/uat`...\\\"}\"\n      },\n      \"id\": \"mm-ack-slack-trigger\",\n      \"name\": \"Mattermost: ack command\",\n      \"type\": \"n8n-nodes-base.respondToWebhook\",\n      \"typeVersion\": 1,\n      \"position\": [\n        480,\n        200\n      ]\n    },\n    {\n      \"parameters\": {\n        \"channelId\": \"={{ $('Mattermost: trigger').item.json.body.channel_id }}\",\n        \"message\": \"@{{ $('Mattermost: trigger').item.json.body.user_name }} :hourglass: *UAT started* for `{{ $json.text }}`\\nRunning milestone safeguard...\",\n        \"otherOptions\": {}\n      },\n      \"id\": \"ack-10\",\n      \"name\": \"Mattermost: UAT started\",\n      \"type\": \"n8n-nodes-base.mattermost\",\n      \"typeVersion\": 1,\n      \"position\": [\n        480,\n        300\n      ],\n      \"credentials\": {\n        \"mattermostApi\": {\n          \"id\": \"mm-creds\",\n          \"name\": \"Mattermost SDLC Bot\"\n        }\n      }\n    },\n    {\n      \"parameters\": {\n        \"url\": \"={{ $env.GITLAB_URL }}/api/v4/projects/{{ $env.GITLAB_PROJECT_ID }}/issues?milestone={{ $('Slack: trigger').item.json.text }}\u0026labels=type:user-story\u0026per_page=100\",\n        \"sendHeaders\": true,\n        \"headerParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"PRIVATE-TOKEN\",\n              \"value\": \"={{ $env.GITLAB_TOKEN }}\"\n            }\n          ]\n        }\n      },\n      \"id\": \"query-stories\",\n      \"name\": \"Query sprint milestone stories\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4,\n      \"position\": [\n        720,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"jsCode\": \"const stories=$json;\\nconst unmerged=stories.filter(s=\u003e!s.labels.includes('merged-to-release'));\\nreturn [{json:{safe:unmerged.length===0,unmerged:unmerged.map(s=\u003e({id:s.iid,title:s.title})),total:stories.length}}];\"\n      },\n      \"id\": \"safeguard\",\n      \"name\": \"Check: all stories merged-to-release?\",\n      \"type\": \"n8n-nodes-base.code\",\n      \"typeVersion\": 2,\n      \"position\": [\n        960,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"conditions\": {\n          \"conditions\": [\n            {\n              \"leftValue\": \"={{ $json.safe }}\",\n              \"rightValue\": true,\n              \"operator\": {\n                \"type\": \"boolean\",\n                \"operation\": \"equals\"\n              }\n            }\n          ]\n        }\n      },\n      \"id\": \"safe-gate\",\n      \"name\": \"Safeguard passed?\",\n      \"type\": \"n8n-nodes-base.if\",\n      \"typeVersion\": 2,\n      \"position\": [\n        1200,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"channelId\": \"={{ $('Mattermost: trigger').item.json.body.channel_id }}\",\n        \"message\": \"@{{ $('Mattermost: trigger').item.json.body.user_name }} :x: *UAT blocked* — stories not yet merged to release. Check release branch.\",\n        \"otherOptions\": {}\n      },\n      \"id\": \"slack-blocked\",\n      \"name\": \"Mattermost: UAT blocked\",\n      \"type\": \"n8n-nodes-base.mattermost\",\n      \"typeVersion\": 1,\n      \"position\": [\n        1440,\n        440\n      ],\n      \"credentials\": {\n        \"mattermostApi\": {\n          \"id\": \"mm-creds\",\n          \"name\": \"Mattermost SDLC Bot\"\n        }\n      }\n    },\n    {\n      \"parameters\": {\n        \"url\": \"={{ $env.GITLAB_URL }}/api/v4/projects/{{ $env.GITLAB_PROJECT_ID }}/pipelines\",\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"ref\",\n              \"value\": \"={{ 'release/' + $('Slack: trigger').item.json.text }}\"\n            },\n            {\n              \"name\": \"variables[DEPLOY_ENV]\",\n              \"value\": \"uat\"\n            }\n          ]\n        },\n        \"sendHeaders\": true,\n        \"headerParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"PRIVATE-TOKEN\",\n              \"value\": \"={{ $env.GITLAB_TOKEN }}\"\n            }\n          ]\n        }\n      },\n      \"id\": \"trig-ci\",\n      \"name\": \"Trigger manual CI on release branch\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4,\n      \"position\": [\n        1440,\n        200\n      ]\n    },\n    {\n      \"parameters\": {\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/cluster-wake\",\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"cluster\",\n              \"value\": \"uat\"\n            }\n          ]\n        }\n      },\n      \"id\": \"wake-uat\",\n      \"name\": \"Wake UAT cluster\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4,\n      \"position\": [\n        1680,\n        200\n      ]\n    },\n    {\n      \"parameters\": {\n        \"command\": \"=argocd app sync {{ $env.ARGOCD_PROJECT }}-uat --server $ARGOCD_URL\"\n      },\n      \"id\": \"argocd\",\n      \"name\": \"ArgoCD sync: rc images to UAT\",\n      \"type\": \"n8n-nodes-base.executeCommand\",\n      \"typeVersion\": 1,\n      \"position\": [\n        1920,\n        200\n      ]\n    },\n    {\n      \"parameters\": {\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/uat-qa-start\",\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"version\",\n              \"value\": \"={{ $('Slack: trigger').item.json.text }}\"\n            },\n            {\n              \"name\": \"release_ticket_id\",\n              \"value\": \"={{ $env.RELEASE_TICKET_ID }}\"\n            }\n          ]\n        }\n      },\n      \"id\": \"trig-f11\",\n      \"name\": \"Trigger F-11: QA UAT stage 1\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4,\n      \"position\": [\n        2160,\n        200\n      ]\n    },\n    {\n      \"parameters\": {\n        \"channelId\": \"={{ $('Mattermost: trigger').item.json.body.channel_id }}\",\n        \"message\": \"@{{ $('Mattermost: trigger').item.json.body.user_name }} :white_check_mark: Safeguard passed · UAT cluster deploying · QA stage 1 started.\\n\\nYou'll be notified when all 3 stages complete.\",\n        \"otherOptions\": {}\n      },\n      \"id\": \"slack-uat-running\",\n      \"name\": \"Mattermost: UAT underway\",\n      \"type\": \"n8n-nodes-base.mattermost\",\n      \"typeVersion\": 1,\n      \"position\": [\n        2400,\n        200\n      ],\n      \"credentials\": {\n        \"mattermostApi\": {\n          \"id\": \"mm-creds\",\n          \"name\": \"Mattermost SDLC Bot\"\n        }\n      }\n    }\n  ],\n  \"connections\": {\n    \"Mattermost: trigger\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Mattermost: UAT started\",\n            \"type\": \"main\",\n            \"index\": 0\n          },\n          {\n            \"node\": \"Mattermost: ack command\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Mattermost: UAT started\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Query sprint milestone stories\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Query sprint milestone stories\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Check: all stories merged-to-release?\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Check: all stories merged-to-release?\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Safeguard passed?\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Safeguard passed?\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Trigger manual CI on release branch\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ],\n        [\n          {\n            \"node\": \"Mattermost: UAT blocked\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Trigger manual CI on release branch\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Wake UAT cluster\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Wake UAT cluster\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"ArgoCD sync: rc images to UAT\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"ArgoCD sync: rc images to UAT\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Trigger F-11: QA UAT stage 1\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Trigger F-11: QA UAT stage 1\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Mattermost: UAT underway\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    }\n  },\n  \"active\": true,\n  \"settings\": {\n    \"executionOrder\": \"v1\"\n  },\n  \"tags\": [\n    {\n      \"name\": \"uat\"\n    },\n    {\n      \"name\": \"phase-3\"\n    },\n    {\n      \"name\": \"mattermost\"\n    }\n  ]\n}\n","F-11-uat-qa-complete.json":"{\n  \"name\": \"F-11-uat-qa-complete\",\n  \"nodes\": [\n    {\n      \"parameters\": {\n        \"httpMethod\": \"POST\",\n        \"path\": \"uat-qa-start\",\n        \"responseMode\": \"lastNode\",\n        \"options\": {}\n      },\n      \"id\": \"wh-F-11-uat-qa-complete\",\n      \"name\": \"Webhook: uat-qa-start\",\n      \"type\": \"n8n-nodes-base.webhook\",\n      \"typeVersion\": 1,\n      \"position\": [\n        240,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"command\": \"echo '{\\\"role\\\":\\\"qa-engineer\\\",\\\"task\\\":\\\"uat-stage-1\\\"}' \u003e /tmp/F-11-uat-qa-complete.json \u0026\u0026 omp run --mode json --role smol @/tmp/F-11-uat-qa-complete.json\"\n      },\n      \"id\": \"spawn-F-11-uat-qa-complete\",\n      \"name\": \"Spawn qa-engineer: uat-stage-1\",\n      \"type\": \"n8n-nodes-base.executeCommand\",\n      \"typeVersion\": 1,\n      \"position\": [\n        480,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"conditions\": {\n          \"conditions\": [\n            {\n              \"leftValue\": \"={{ $json.exitCode }}\",\n              \"rightValue\": 0,\n              \"operator\": {\n                \"type\": \"number\",\n                \"operation\": \"equals\"\n              }\n            }\n          ]\n        }\n      },\n      \"id\": \"pass-F-11-uat-qa-complete\",\n      \"name\": \"Passed?\",\n      \"type\": \"n8n-nodes-base.if\",\n      \"typeVersion\": 2,\n      \"position\": [\n        720,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"command\": \"glab issue update {{ $json.body.release_ticket_id }} --label-add 'qa:uat-approved'\"\n      },\n      \"id\": \"label-F-11-uat-qa-complete\",\n      \"name\": \"Apply qa:uat-approved on release ticket\",\n      \"type\": \"n8n-nodes-base.executeCommand\",\n      \"typeVersion\": 1,\n      \"position\": [\n        960,\n        200\n      ]\n    },\n    {\n      \"parameters\": {\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/security-scan-start\",\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"version\",\n              \"value\": \"={{ $json.body.version }}\"\n            },\n            {\n              \"name\": \"release_ticket_id\",\n              \"value\": \"={{ $json.body.release_ticket_id }}\"\n            }\n          ]\n        }\n      },\n      \"id\": \"next-F-11-uat-qa-complete\",\n      \"name\": \"Trigger next stage\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4,\n      \"position\": [\n        1200,\n        200\n      ]\n    },\n    {\n      \"parameters\": {\n        \"channelId\": \"={{ $env.MM_SDLC_CHANNEL }}\",\n        \"message\": \":test_tube: *UAT QA* sign-off. Moving to next stage.\",\n        \"otherOptions\": {}\n      },\n      \"id\": \"slack-pass2-F-11-uat-qa-complete\",\n      \"name\": \"Mattermost: UAT QA sign-off\",\n      \"type\": \"n8n-nodes-base.mattermost\",\n      \"typeVersion\": 1,\n      \"position\": [\n        1440,\n        200\n      ],\n      \"credentials\": {\n        \"mattermostApi\": {\n          \"id\": \"mm-creds\",\n          \"name\": \"Mattermost SDLC Bot\"\n        }\n      }\n    },\n    {\n      \"parameters\": {\n        \"command\": \"glab issue create --title '[bugfix] qa-engineer finding in uat-stage-1' --label 'type:bugfix,role:qa-engineer' --milestone '{{ $json.body.version }}' --description 'Found during UAT.'\"\n      },\n      \"id\": \"bug-F-11-uat-qa-complete\",\n      \"name\": \"Create bug ticket\",\n      \"type\": \"n8n-nodes-base.executeCommand\",\n      \"typeVersion\": 1,\n      \"position\": [\n        960,\n        440\n      ]\n    },\n    {\n      \"parameters\": {\n        \"channelId\": \"={{ $env.MM_SDLC_CHANNEL }}\",\n        \"message\": \":warning: *UAT QA finding* — bug ticket created. Fix and re-run UAT.\",\n        \"otherOptions\": {}\n      },\n      \"id\": \"slack-bug-F-11-uat-qa-complete\",\n      \"name\": \"Mattermost: UAT QA bug\",\n      \"type\": \"n8n-nodes-base.mattermost\",\n      \"typeVersion\": 1,\n      \"position\": [\n        1200,\n        440\n      ],\n      \"credentials\": {\n        \"mattermostApi\": {\n          \"id\": \"mm-creds\",\n          \"name\": \"Mattermost SDLC Bot\"\n        }\n      }\n    }\n  ],\n  \"connections\": {\n    \"Webhook: uat-qa-start\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Spawn qa-engineer: uat-stage-1\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Spawn qa-engineer: uat-stage-1\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Passed?\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Passed?\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Apply qa:uat-approved on release ticket\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ],\n        [\n          {\n            \"node\": \"Create bug ticket\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Apply qa:uat-approved on release ticket\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Trigger next stage\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Create bug ticket\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Mattermost: UAT QA bug\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Trigger next stage\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Mattermost: UAT QA sign-off\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    }\n  },\n  \"active\": true,\n  \"settings\": {\n    \"executionOrder\": \"v1\"\n  },\n  \"tags\": [\n    {\n      \"name\": \"uat\"\n    },\n    {\n      \"name\": \"phase-3\"\n    },\n    {\n      \"name\": \"mattermost\"\n    }\n  ]\n}\n","F-12-uat-security-complete.json":"{\n  \"name\": \"F-12-uat-security-complete\",\n  \"nodes\": [\n    {\n      \"parameters\": {\n        \"httpMethod\": \"POST\",\n        \"path\": \"security-scan-start\",\n        \"responseMode\": \"lastNode\",\n        \"options\": {}\n      },\n      \"id\": \"wh-F-12-uat-security-complete\",\n      \"name\": \"Webhook: security-scan-start\",\n      \"type\": \"n8n-nodes-base.webhook\",\n      \"typeVersion\": 1,\n      \"position\": [\n        240,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"command\": \"echo '{\\\"role\\\":\\\"security-engineer\\\",\\\"task\\\":\\\"uat-stage-2\\\"}' \u003e /tmp/F-12-uat-security-complete.json \u0026\u0026 omp run --mode json --role smol @/tmp/F-12-uat-security-complete.json\"\n      },\n      \"id\": \"spawn-F-12-uat-security-complete\",\n      \"name\": \"Spawn security-engineer: uat-stage-2\",\n      \"type\": \"n8n-nodes-base.executeCommand\",\n      \"typeVersion\": 1,\n      \"position\": [\n        480,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"conditions\": {\n          \"conditions\": [\n            {\n              \"leftValue\": \"={{ $json.exitCode }}\",\n              \"rightValue\": 0,\n              \"operator\": {\n                \"type\": \"number\",\n                \"operation\": \"equals\"\n              }\n            }\n          ]\n        }\n      },\n      \"id\": \"pass-F-12-uat-security-complete\",\n      \"name\": \"Passed?\",\n      \"type\": \"n8n-nodes-base.if\",\n      \"typeVersion\": 2,\n      \"position\": [\n        720,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"command\": \"glab issue update {{ $json.body.release_ticket_id }} --label-add 'security:cleared'\"\n      },\n      \"id\": \"label-F-12-uat-security-complete\",\n      \"name\": \"Apply security:cleared on release ticket\",\n      \"type\": \"n8n-nodes-base.executeCommand\",\n      \"typeVersion\": 1,\n      \"position\": [\n        960,\n        200\n      ]\n    },\n    {\n      \"parameters\": {\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/po-validation-start\",\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"version\",\n              \"value\": \"={{ $json.body.version }}\"\n            },\n            {\n              \"name\": \"release_ticket_id\",\n              \"value\": \"={{ $json.body.release_ticket_id }}\"\n            }\n          ]\n        }\n      },\n      \"id\": \"next-F-12-uat-security-complete\",\n      \"name\": \"Trigger next stage\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4,\n      \"position\": [\n        1200,\n        200\n      ]\n    },\n    {\n      \"parameters\": {\n        \"channelId\": \"={{ $env.MM_SDLC_CHANNEL }}\",\n        \"message\": \":shield: *UAT Security* sign-off. Moving to next stage.\",\n        \"otherOptions\": {}\n      },\n      \"id\": \"slack-pass2-F-12-uat-security-complete\",\n      \"name\": \"Mattermost: UAT Security sign-off\",\n      \"type\": \"n8n-nodes-base.mattermost\",\n      \"typeVersion\": 1,\n      \"position\": [\n        1440,\n        200\n      ],\n      \"credentials\": {\n        \"mattermostApi\": {\n          \"id\": \"mm-creds\",\n          \"name\": \"Mattermost SDLC Bot\"\n        }\n      }\n    },\n    {\n      \"parameters\": {\n        \"command\": \"glab issue create --title '[bugfix] security-engineer finding in uat-stage-2' --label 'type:bugfix,role:security-engineer' --milestone '{{ $json.body.version }}' --description 'Found during UAT.'\"\n      },\n      \"id\": \"bug-F-12-uat-security-complete\",\n      \"name\": \"Create bug ticket\",\n      \"type\": \"n8n-nodes-base.executeCommand\",\n      \"typeVersion\": 1,\n      \"position\": [\n        960,\n        440\n      ]\n    },\n    {\n      \"parameters\": {\n        \"channelId\": \"={{ $env.MM_SDLC_CHANNEL }}\",\n        \"message\": \":warning: *UAT Security finding* — bug ticket created. Fix and re-run UAT.\",\n        \"otherOptions\": {}\n      },\n      \"id\": \"slack-bug-F-12-uat-security-complete\",\n      \"name\": \"Mattermost: UAT Security bug\",\n      \"type\": \"n8n-nodes-base.mattermost\",\n      \"typeVersion\": 1,\n      \"position\": [\n        1200,\n        440\n      ],\n      \"credentials\": {\n        \"mattermostApi\": {\n          \"id\": \"mm-creds\",\n          \"name\": \"Mattermost SDLC Bot\"\n        }\n      }\n    }\n  ],\n  \"connections\": {\n    \"Webhook: security-scan-start\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Spawn security-engineer: uat-stage-2\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Spawn security-engineer: uat-stage-2\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Passed?\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Passed?\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Apply security:cleared on release ticket\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ],\n        [\n          {\n            \"node\": \"Create bug ticket\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Apply security:cleared on release ticket\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Trigger next stage\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Create bug ticket\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Mattermost: UAT Security bug\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Trigger next stage\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Mattermost: UAT Security sign-off\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    }\n  },\n  \"active\": true,\n  \"settings\": {\n    \"executionOrder\": \"v1\"\n  },\n  \"tags\": [\n    {\n      \"name\": \"uat\"\n    },\n    {\n      \"name\": \"phase-3\"\n    },\n    {\n      \"name\": \"mattermost\"\n    }\n  ]\n}\n","F-13-uat-po-complete.json":"{\n  \"name\": \"F-13-uat-po-complete\",\n  \"nodes\": [\n    {\n      \"parameters\": {\n        \"httpMethod\": \"POST\",\n        \"path\": \"po-validation-start\",\n        \"responseMode\": \"lastNode\",\n        \"options\": {}\n      },\n      \"id\": \"wh-F-13-uat-po-complete\",\n      \"name\": \"Webhook: po-validation-start\",\n      \"type\": \"n8n-nodes-base.webhook\",\n      \"typeVersion\": 1,\n      \"position\": [\n        240,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"command\": \"echo '{\\\"role\\\":\\\"product-owner\\\",\\\"task\\\":\\\"uat-stage-3\\\"}' \u003e /tmp/F-13-uat-po-complete.json \u0026\u0026 omp run --mode json --role smol @/tmp/F-13-uat-po-complete.json\"\n      },\n      \"id\": \"spawn-F-13-uat-po-complete\",\n      \"name\": \"Spawn product-owner: uat-stage-3\",\n      \"type\": \"n8n-nodes-base.executeCommand\",\n      \"typeVersion\": 1,\n      \"position\": [\n        480,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"conditions\": {\n          \"conditions\": [\n            {\n              \"leftValue\": \"={{ $json.exitCode }}\",\n              \"rightValue\": 0,\n              \"operator\": {\n                \"type\": \"number\",\n                \"operation\": \"equals\"\n              }\n            }\n          ]\n        }\n      },\n      \"id\": \"pass-F-13-uat-po-complete\",\n      \"name\": \"Passed?\",\n      \"type\": \"n8n-nodes-base.if\",\n      \"typeVersion\": 2,\n      \"position\": [\n        720,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"command\": \"glab issue update {{ $json.body.release_ticket_id }} --label-add 'po:uat-approved'\"\n      },\n      \"id\": \"label-F-13-uat-po-complete\",\n      \"name\": \"Apply po:uat-approved on release ticket\",\n      \"type\": \"n8n-nodes-base.executeCommand\",\n      \"typeVersion\": 1,\n      \"position\": [\n        960,\n        200\n      ]\n    },\n    {\n      \"parameters\": {\n        \"channelId\": \"={{ $env.MM_SDLC_CHANNEL }}\",\n        \"message\": \"🏁 *UAT PO sign-off* complete — `po:uat-approved` applied.\\n\\nAll 3 UAT stages done. Run `/release-staging` when ready.\",\n        \"otherOptions\": {}\n      },\n      \"id\": \"slack-pass-F-13-uat-po-complete\",\n      \"name\": \"Mattermost: UAT PO complete\",\n      \"type\": \"n8n-nodes-base.mattermost\",\n      \"typeVersion\": 1,\n      \"position\": [\n        1440,\n        200\n      ],\n      \"credentials\": {\n        \"mattermostApi\": {\n          \"id\": \"mm-creds\",\n          \"name\": \"Mattermost SDLC Bot\"\n        }\n      }\n    },\n    {\n      \"parameters\": {\n        \"channelId\": \"={{ $env.MM_SDLC_CHANNEL }}\",\n        \"message\": \":tada: *All 3 UAT stages complete*!\\nRun `/release-staging` to begin staging phase.\",\n        \"otherOptions\": {}\n      },\n      \"id\": \"slack-final-F-13-uat-po-complete\",\n      \"name\": \"Mattermost: all UAT done\",\n      \"type\": \"n8n-nodes-base.mattermost\",\n      \"typeVersion\": 1,\n      \"position\": [\n        1680,\n        200\n      ],\n      \"credentials\": {\n        \"mattermostApi\": {\n          \"id\": \"mm-creds\",\n          \"name\": \"Mattermost SDLC Bot\"\n        }\n      }\n    },\n    {\n      \"parameters\": {\n        \"command\": \"glab issue create --title '[bugfix] product-owner finding in uat-stage-3' --label 'type:bugfix,role:product-owner' --milestone '{{ $json.body.version }}' --description 'Found during UAT.'\"\n      },\n      \"id\": \"bug-F-13-uat-po-complete\",\n      \"name\": \"Create bug ticket\",\n      \"type\": \"n8n-nodes-base.executeCommand\",\n      \"typeVersion\": 1,\n      \"position\": [\n        960,\n        440\n      ]\n    },\n    {\n      \"parameters\": {\n        \"channelId\": \"={{ $env.MM_SDLC_CHANNEL }}\",\n        \"message\": \":warning: *UAT PO finding* — bug ticket created. Fix and re-run UAT.\",\n        \"otherOptions\": {}\n      },\n      \"id\": \"slack-bug-F-13-uat-po-complete\",\n      \"name\": \"Mattermost: UAT PO bug\",\n      \"type\": \"n8n-nodes-base.mattermost\",\n      \"typeVersion\": 1,\n      \"position\": [\n        1200,\n        440\n      ],\n      \"credentials\": {\n        \"mattermostApi\": {\n          \"id\": \"mm-creds\",\n          \"name\": \"Mattermost SDLC Bot\"\n        }\n      }\n    }\n  ],\n  \"connections\": {\n    \"Webhook: po-validation-start\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Spawn product-owner: uat-stage-3\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Spawn product-owner: uat-stage-3\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Passed?\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Passed?\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Apply po:uat-approved on release ticket\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ],\n        [\n          {\n            \"node\": \"Create bug ticket\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Apply po:uat-approved on release ticket\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Mattermost: UAT PO complete\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Create bug ticket\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Mattermost: UAT PO bug\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    }\n  },\n  \"active\": true,\n  \"settings\": {\n    \"executionOrder\": \"v1\"\n  },\n  \"tags\": [\n    {\n      \"name\": \"uat\"\n    },\n    {\n      \"name\": \"phase-3\"\n    },\n    {\n      \"name\": \"mattermost\"\n    }\n  ]\n}\n","F-14-release-staging.json":"{\n  \"name\": \"F-14 /release-staging\",\n  \"nodes\": [\n    {\n      \"parameters\": {\n        \"httpMethod\": \"POST\",\n        \"path\": \"mm-release_staging\",\n        \"responseMode\": \"responseNode\",\n        \"options\": {}\n      },\n      \"id\": \"slack-trigger\",\n      \"name\": \"Mattermost: trigger\",\n      \"type\": \"n8n-nodes-base.webhook\",\n      \"typeVersion\": 1,\n      \"position\": [\n        240,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"respondWith\": \"json\",\n        \"responseBody\": \"{\\\"response_type\\\": \\\"ephemeral\\\", \\\"text\\\": \\\":hourglass_flowing_sand: Running `/release_staging`...\\\"}\"\n      },\n      \"id\": \"mm-ack-slack-trigger\",\n      \"name\": \"Mattermost: ack command\",\n      \"type\": \"n8n-nodes-base.respondToWebhook\",\n      \"typeVersion\": 1,\n      \"position\": [\n        480,\n        200\n      ]\n    },\n    {\n      \"parameters\": {\n        \"channelId\": \"={{ $('Mattermost: trigger').item.json.body.channel_id }}\",\n        \"message\": \"@{{ $('Mattermost: trigger').item.json.body.user_name }} :hourglass: *Release-staging* for `={{ $('Slack: trigger').item.json.text }}`\\nChecking UAT sign-offs...\",\n        \"otherOptions\": {}\n      },\n      \"id\": \"ack-14\",\n      \"name\": \"Mattermost: staging started\",\n      \"type\": \"n8n-nodes-base.mattermost\",\n      \"typeVersion\": 1,\n      \"position\": [\n        480,\n        300\n      ],\n      \"credentials\": {\n        \"mattermostApi\": {\n          \"id\": \"mm-creds\",\n          \"name\": \"Mattermost SDLC Bot\"\n        }\n      }\n    },\n    {\n      \"parameters\": {\n        \"url\": \"={{ $env.GITLAB_URL }}/api/v4/projects/{{ $env.GITLAB_PROJECT_ID }}/issues/{{ $env.RELEASE_TICKET_ID }}\",\n        \"sendHeaders\": true,\n        \"headerParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"PRIVATE-TOKEN\",\n              \"value\": \"={{ $env.GITLAB_TOKEN }}\"\n            }\n          ]\n        }\n      },\n      \"id\": \"check-rt\",\n      \"name\": \"Check release ticket labels\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4,\n      \"position\": [\n        720,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"jsCode\": \"const labels=$json.labels||[];\\nconst req=['qa:uat-approved','security:cleared','po:uat-approved'];\\nconst missing=req.filter(l=\u003e!labels.includes(l));\\nreturn [{json:{safe:missing.length===0,missing}}];\"\n      },\n      \"id\": \"validate\",\n      \"name\": \"All UAT sign-offs present?\",\n      \"type\": \"n8n-nodes-base.code\",\n      \"typeVersion\": 2,\n      \"position\": [\n        960,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"conditions\": {\n          \"conditions\": [\n            {\n              \"leftValue\": \"={{ $json.safe }}\",\n              \"rightValue\": true,\n              \"operator\": {\n                \"type\": \"boolean\",\n                \"operation\": \"equals\"\n              }\n            }\n          ]\n        }\n      },\n      \"id\": \"safe-gate\",\n      \"name\": \"Safeguard passed?\",\n      \"type\": \"n8n-nodes-base.if\",\n      \"typeVersion\": 2,\n      \"position\": [\n        1200,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"channelId\": \"={{ $('Mattermost: trigger').item.json.body.channel_id }}\",\n        \"message\": \"@{{ $('Mattermost: trigger').item.json.body.user_name }} :x: *Staging blocked* — missing UAT sign-offs: `{{ $json.missing.join(', ') }}`\",\n        \"otherOptions\": {}\n      },\n      \"id\": \"slack-blocked\",\n      \"name\": \"Mattermost: staging blocked\",\n      \"type\": \"n8n-nodes-base.mattermost\",\n      \"typeVersion\": 1,\n      \"position\": [\n        1440,\n        440\n      ],\n      \"credentials\": {\n        \"mattermostApi\": {\n          \"id\": \"mm-creds\",\n          \"name\": \"Mattermost SDLC Bot\"\n        }\n      }\n    },\n    {\n      \"parameters\": {\n        \"command\": \"=opencode run --print 'Create release-plan ticket for version ={{ $('Slack: trigger').item.json.text }}'\"\n      },\n      \"id\": \"rm-ticket\",\n      \"name\": \"RM creates release-plan ticket\",\n      \"type\": \"n8n-nodes-base.executeCommand\",\n      \"typeVersion\": 1,\n      \"position\": [\n        1440,\n        160\n      ]\n    },\n    {\n      \"parameters\": {\n        \"url\": \"={{ $env.GITLAB_URL }}/api/v4/projects/{{ $env.GITLAB_PROJECT_ID }}/repository/branches\",\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"branch\",\n              \"value\": \"={{ 'promote/' + $('Slack: trigger').item.json.text }}\"\n            },\n            {\n              \"name\": \"ref\",\n              \"value\": \"={{ 'release/' + $('Slack: trigger').item.json.text }}\"\n            }\n          ]\n        },\n        \"sendHeaders\": true,\n        \"headerParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"PRIVATE-TOKEN\",\n              \"value\": \"={{ $env.GITLAB_TOKEN }}\"\n            }\n          ]\n        }\n      },\n      \"id\": \"create-promote\",\n      \"name\": \"Create promote/ branch\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4,\n      \"position\": [\n        1440,\n        280\n      ]\n    },\n    {\n      \"parameters\": {\n        \"url\": \"={{ $env.GITLAB_URL }}/api/v4/projects/{{ $env.GITLAB_PROJECT_ID }}/pipelines\",\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"ref\",\n              \"value\": \"={{ 'promote/' + $('Slack: trigger').item.json.text }}\"\n            },\n            {\n              \"name\": \"variables[STAGE]\",\n              \"value\": \"promote-build-deploy\"\n            }\n          ]\n        },\n        \"sendHeaders\": true,\n        \"headerParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"PRIVATE-TOKEN\",\n              \"value\": \"={{ $env.GITLAB_TOKEN }}\"\n            }\n          ]\n        }\n      },\n      \"id\": \"trig-ci\",\n      \"name\": \"Trigger promotion CI\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4,\n      \"position\": [\n        1680,\n        220\n      ]\n    },\n    {\n      \"parameters\": {\n        \"channelId\": \"={{ $('Mattermost: trigger').item.json.body.channel_id }}\",\n        \"message\": \"@{{ $('Mattermost: trigger').item.json.body.user_name }} :rocket: Staging kicked off for `={{ $('Slack: trigger').item.json.text }}`!\\n• Release-plan ticket created · promote/ branch created · Promotion CI running\\n\\nYou'll be notified with the go/no-go decision.\",\n        \"otherOptions\": {}\n      },\n      \"id\": \"slack-kicked\",\n      \"name\": \"Mattermost: staging pipeline running\",\n      \"type\": \"n8n-nodes-base.mattermost\",\n      \"typeVersion\": 1,\n      \"position\": [\n        1920,\n        220\n      ],\n      \"credentials\": {\n        \"mattermostApi\": {\n          \"id\": \"mm-creds\",\n          \"name\": \"Mattermost SDLC Bot\"\n        }\n      }\n    }\n  ],\n  \"connections\": {\n    \"Mattermost: trigger\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Mattermost: staging started\",\n            \"type\": \"main\",\n            \"index\": 0\n          },\n          {\n            \"node\": \"Mattermost: ack command\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Mattermost: staging started\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Check release ticket labels\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Check release ticket labels\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"All UAT sign-offs present?\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"All UAT sign-offs present?\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Safeguard passed?\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Safeguard passed?\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"RM creates release-plan ticket\",\n            \"type\": \"main\",\n            \"index\": 0\n          },\n          {\n            \"node\": \"Create promote/ branch\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ],\n        [\n          {\n            \"node\": \"Mattermost: staging blocked\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"RM creates release-plan ticket\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Trigger promotion CI\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Create promote/ branch\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Trigger promotion CI\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Trigger promotion CI\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Mattermost: staging pipeline running\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    }\n  },\n  \"active\": true,\n  \"settings\": {\n    \"executionOrder\": \"v1\"\n  },\n  \"tags\": [\n    {\n      \"name\": \"staging\"\n    },\n    {\n      \"name\": \"phase-4\"\n    },\n    {\n      \"name\": \"mattermost\"\n    }\n  ]\n}\n","F-15-staging-deployed.json":"{\n  \"name\": \"F-15 Staging Deployed\",\n  \"nodes\": [\n    {\n      \"parameters\": {\n        \"httpMethod\": \"POST\",\n        \"path\": \"ci-staging-deployed\",\n        \"responseMode\": \"lastNode\",\n        \"options\": {}\n      },\n      \"id\": \"wh-15\",\n      \"name\": \"Webhook: ci-staging-deployed\",\n      \"type\": \"n8n-nodes-base.webhook\",\n      \"typeVersion\": 1,\n      \"position\": [\n        240,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"command\": \"=glab issue comment {{ $json.body.release_ticket_id }} --message 'Staging deployed: {{ $json.body.version }}'\"\n      },\n      \"id\": \"upd-rt\",\n      \"name\": \"Update release ticket\",\n      \"type\": \"n8n-nodes-base.executeCommand\",\n      \"typeVersion\": 1,\n      \"position\": [\n        480,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"command\": \"=echo '{\\\"role\\\":\\\"qa-engineer\\\",\\\"task\\\":\\\"staging-performance\\\"}' \u003e /tmp/qa-stg.json \u0026\u0026 omp run --mode json --role smol @/tmp/qa-stg.json\"\n      },\n      \"id\": \"qa-stg\",\n      \"name\": \"Spawn QA: k6 performance tests\",\n      \"type\": \"n8n-nodes-base.executeCommand\",\n      \"typeVersion\": 1,\n      \"position\": [\n        720,\n        200\n      ]\n    },\n    {\n      \"parameters\": {\n        \"command\": \"=echo '{\\\"role\\\":\\\"security-engineer\\\",\\\"task\\\":\\\"staging-zap\\\"}' \u003e /tmp/sec-stg.json \u0026\u0026 omp run --mode json --role smol @/tmp/sec-stg.json\"\n      },\n      \"id\": \"sec-stg\",\n      \"name\": \"Spawn Security: ZAP full scan\",\n      \"type\": \"n8n-nodes-base.executeCommand\",\n      \"typeVersion\": 1,\n      \"position\": [\n        720,\n        400\n      ]\n    },\n    {\n      \"parameters\": {\n        \"command\": \"=echo '{\\\"role\\\":\\\"release-manager\\\",\\\"task\\\":\\\"go-nogo\\\",\\\"version\\\":\\\"{{ $json.body.version }}\\\",\\\"release_ticket_id\\\":\\\"{{ $json.body.release_ticket_id }}\\\"}' \u003e /tmp/rm-gng.json \u0026\u0026 omp run --mode json --role default @/tmp/rm-gng.json\"\n      },\n      \"id\": \"rm-gng\",\n      \"name\": \"Spawn RM: go/no-go assessment\",\n      \"type\": \"n8n-nodes-base.executeCommand\",\n      \"typeVersion\": 1,\n      \"position\": [\n        960,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"channelId\": \"={{ $env.MM_SDLC_CHANNEL }}\",\n        \"message\": \":rocket: *Staging deployed* — `{{ $json.body.version }}`\\nQA k6 + Security ZAP running in parallel · RM go/no-go assessment in progress.\\n\\nYou'll be notified with the decision.\",\n        \"otherOptions\": {}\n      },\n      \"id\": \"slack-15\",\n      \"name\": \"Mattermost: staging deployed\",\n      \"type\": \"n8n-nodes-base.mattermost\",\n      \"typeVersion\": 1,\n      \"position\": [\n        1200,\n        300\n      ],\n      \"credentials\": {\n        \"mattermostApi\": {\n          \"id\": \"mm-creds\",\n          \"name\": \"Mattermost SDLC Bot\"\n        }\n      }\n    }\n  ],\n  \"connections\": {\n    \"Webhook: ci-staging-deployed\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Update release ticket\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Update release ticket\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Spawn QA: k6 performance tests\",\n            \"type\": \"main\",\n            \"index\": 0\n          },\n          {\n            \"node\": \"Spawn Security: ZAP full scan\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Spawn QA: k6 performance tests\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Spawn RM: go/no-go assessment\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Spawn Security: ZAP full scan\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Spawn RM: go/no-go assessment\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Spawn RM: go/no-go assessment\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Mattermost: staging deployed\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    }\n  },\n  \"active\": true,\n  \"settings\": {\n    \"executionOrder\": \"v1\"\n  },\n  \"tags\": [\n    {\n      \"name\": \"staging\"\n    },\n    {\n      \"name\": \"phase-4\"\n    },\n    {\n      \"name\": \"mattermost\"\n    }\n  ]\n}\n","F-16-go-nogo.json":"{\n  \"name\": \"F-16 Release Manager Go/No-Go\",\n  \"nodes\": [\n    {\n      \"parameters\": {\n        \"httpMethod\": \"POST\",\n        \"path\": \"go-nogo-result\",\n        \"responseMode\": \"lastNode\",\n        \"options\": {}\n      },\n      \"id\": \"wh-16\",\n      \"name\": \"Webhook: go-nogo-result\",\n      \"type\": \"n8n-nodes-base.webhook\",\n      \"typeVersion\": 1,\n      \"position\": [\n        240,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"conditions\": {\n          \"conditions\": [\n            {\n              \"leftValue\": \"={{ $json.body.decision }}\",\n              \"rightValue\": \"go\",\n              \"operator\": {\n                \"type\": \"string\",\n                \"operation\": \"equals\"\n              }\n            }\n          ]\n        }\n      },\n      \"id\": \"go-check\",\n      \"name\": \"GO or NO-GO?\",\n      \"type\": \"n8n-nodes-base.if\",\n      \"typeVersion\": 2,\n      \"position\": [\n        480,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"command\": \"=glab issue update {{ $json.body.release_ticket_id }} --label-add 'rm:go'\"\n      },\n      \"id\": \"apply-go\",\n      \"name\": \"Apply rm:go label\",\n      \"type\": \"n8n-nodes-base.executeCommand\",\n      \"typeVersion\": 1,\n      \"position\": [\n        720,\n        160\n      ]\n    },\n    {\n      \"parameters\": {\n        \"channelId\": \"={{ $env.MM_SDLC_CHANNEL }}\",\n        \"message\": \":green_circle: *Staging GO* — `rm:go` applied.\\n\\n{{ $json.body.validation_table }}\\n\\nRun `/release_production {{ $json.body.version }}` to deploy.\",\n        \"otherOptions\": {}\n      },\n      \"id\": \"slack-go\",\n      \"name\": \"Mattermost: GO — ready for production\",\n      \"type\": \"n8n-nodes-base.mattermost\",\n      \"typeVersion\": 1,\n      \"position\": [\n        960,\n        160\n      ],\n      \"credentials\": {\n        \"mattermostApi\": {\n          \"id\": \"mm-creds\",\n          \"name\": \"Mattermost SDLC Bot\"\n        }\n      }\n    },\n    {\n      \"parameters\": {\n        \"command\": \"=glab issue comment {{ $json.body.release_ticket_id }} --message 'NO-GO: {{ $json.body.reason }}\\\\n\\\\nOptions: A) {{ $json.body.suggestion_a }} B) {{ $json.body.suggestion_b }} C) {{ $json.body.suggestion_c }}'\"\n      },\n      \"id\": \"post-nogo\",\n      \"name\": \"Post NO-GO report on release ticket\",\n      \"type\": \"n8n-nodes-base.executeCommand\",\n      \"typeVersion\": 1,\n      \"position\": [\n        720,\n        440\n      ]\n    },\n    {\n      \"parameters\": {\n        \"channelId\": \"={{ $env.MM_SDLC_CHANNEL }}\",\n        \"message\": \":red_circle: *Staging NO-GO* — `{{ $json.body.reason }}`\\n\\n*Options:*\\n• A) {{ $json.body.suggestion_a }}\\n• B) {{ $json.body.suggestion_b }}\\n• C) {{ $json.body.suggestion_c }}\\n\\nReview release ticket and reply with your decision.\",\n        \"otherOptions\": {}\n      },\n      \"id\": \"slack-nogo\",\n      \"name\": \"Mattermost: NO-GO — decision required\",\n      \"type\": \"n8n-nodes-base.mattermost\",\n      \"typeVersion\": 1,\n      \"position\": [\n        960,\n        440\n      ],\n      \"credentials\": {\n        \"mattermostApi\": {\n          \"id\": \"mm-creds\",\n          \"name\": \"Mattermost SDLC Bot\"\n        }\n      }\n    }\n  ],\n  \"connections\": {\n    \"Webhook: go-nogo-result\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"GO or NO-GO?\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"GO or NO-GO?\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Apply rm:go label\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ],\n        [\n          {\n            \"node\": \"Post NO-GO report on release ticket\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Apply rm:go label\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Mattermost: GO — ready for production\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Post NO-GO report on release ticket\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Mattermost: NO-GO — decision required\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    }\n  },\n  \"active\": true,\n  \"settings\": {\n    \"executionOrder\": \"v1\"\n  },\n  \"tags\": [\n    {\n      \"name\": \"staging\"\n    },\n    {\n      \"name\": \"phase-4\"\n    },\n    {\n      \"name\": \"mattermost\"\n    }\n  ]\n}\n","F-17-release-production.json":"{\n  \"name\": \"F-17 /release-production\",\n  \"nodes\": [\n    {\n      \"parameters\": {\n        \"httpMethod\": \"POST\",\n        \"path\": \"mm-release_production\",\n        \"responseMode\": \"responseNode\",\n        \"options\": {}\n      },\n      \"id\": \"slack-trigger\",\n      \"name\": \"Mattermost: trigger\",\n      \"type\": \"n8n-nodes-base.webhook\",\n      \"typeVersion\": 1,\n      \"position\": [\n        240,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"respondWith\": \"json\",\n        \"responseBody\": \"{\\\"response_type\\\": \\\"ephemeral\\\", \\\"text\\\": \\\":hourglass_flowing_sand: Running `/release_production`...\\\"}\"\n      },\n      \"id\": \"mm-ack-slack-trigger\",\n      \"name\": \"Mattermost: ack command\",\n      \"type\": \"n8n-nodes-base.respondToWebhook\",\n      \"typeVersion\": 1,\n      \"position\": [\n        480,\n        200\n      ]\n    },\n    {\n      \"parameters\": {\n        \"channelId\": \"={{ $('Mattermost: trigger').item.json.body.channel_id }}\",\n        \"message\": \"@{{ $('Mattermost: trigger').item.json.body.user_name }} :hourglass: *Production release* for `={{ $('Slack: trigger').item.json.text }}`\\nVerifying rm:go...\",\n        \"otherOptions\": {}\n      },\n      \"id\": \"ack-17\",\n      \"name\": \"Mattermost: production release started\",\n      \"type\": \"n8n-nodes-base.mattermost\",\n      \"typeVersion\": 1,\n      \"position\": [\n        480,\n        300\n      ],\n      \"credentials\": {\n        \"mattermostApi\": {\n          \"id\": \"mm-creds\",\n          \"name\": \"Mattermost SDLC Bot\"\n        }\n      }\n    },\n    {\n      \"parameters\": {\n        \"url\": \"={{ $env.GITLAB_URL }}/api/v4/projects/{{ $env.GITLAB_PROJECT_ID }}/issues/{{ $env.RELEASE_TICKET_ID }}\",\n        \"sendHeaders\": true,\n        \"headerParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"PRIVATE-TOKEN\",\n              \"value\": \"={{ $env.GITLAB_TOKEN }}\"\n            }\n          ]\n        }\n      },\n      \"id\": \"chk-rmgo\",\n      \"name\": \"Check rm:go on release ticket\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4,\n      \"position\": [\n        720,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"jsCode\": \"const labels=$json.labels||[];\\nreturn [{json:{safe:labels.includes('rm:go')}}];\"\n      },\n      \"id\": \"validate-go\",\n      \"name\": \"rm:go confirmed?\",\n      \"type\": \"n8n-nodes-base.code\",\n      \"typeVersion\": 2,\n      \"position\": [\n        960,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"conditions\": {\n          \"conditions\": [\n            {\n              \"leftValue\": \"={{ $json.safe }}\",\n              \"rightValue\": true,\n              \"operator\": {\n                \"type\": \"boolean\",\n                \"operation\": \"equals\"\n              }\n            }\n          ]\n        }\n      },\n      \"id\": \"go-gate\",\n      \"name\": \"rm:go present?\",\n      \"type\": \"n8n-nodes-base.if\",\n      \"typeVersion\": 2,\n      \"position\": [\n        1200,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"channelId\": \"={{ $('Mattermost: trigger').item.json.body.channel_id }}\",\n        \"message\": \"@{{ $('Mattermost: trigger').item.json.body.user_name }} :x: *Production blocked* — `rm:go` not found on release ticket.\\nRun `/release_staging` first.\",\n        \"otherOptions\": {}\n      },\n      \"id\": \"slack-no-go\",\n      \"name\": \"Mattermost: production blocked\",\n      \"type\": \"n8n-nodes-base.mattermost\",\n      \"typeVersion\": 1,\n      \"position\": [\n        1440,\n        440\n      ],\n      \"credentials\": {\n        \"mattermostApi\": {\n          \"id\": \"mm-creds\",\n          \"name\": \"Mattermost SDLC Bot\"\n        }\n      }\n    },\n    {\n      \"parameters\": {\n        \"url\": \"={{ $env.GITLAB_URL }}/api/v4/projects/{{ $env.GITLAB_PROJECT_ID }}/merge_requests\",\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"source_branch\",\n              \"value\": \"={{ 'promote/' + $('Slack: trigger').item.json.text }}\"\n            },\n            {\n              \"name\": \"target_branch\",\n              \"value\": \"main\"\n            },\n            {\n              \"name\": \"title\",\n              \"value\": \"={{ '[release] ' + $('Slack: trigger').item.json.text }}\"\n            },\n            {\n              \"name\": \"labels\",\n              \"value\": \"type:release\"\n            },\n            {\n              \"name\": \"description\",\n              \"value\": \"Release MR for `={{ $('Slack: trigger').item.json.text }}`. CI validates no rc versions.\"\n            }\n          ]\n        },\n        \"sendHeaders\": true,\n        \"headerParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"PRIVATE-TOKEN\",\n              \"value\": \"={{ $env.GITLAB_TOKEN }}\"\n            }\n          ]\n        }\n      },\n      \"id\": \"create-mr\",\n      \"name\": \"Create promote→main MR via GitLab API\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4,\n      \"position\": [\n        1440,\n        200\n      ]\n    },\n    {\n      \"parameters\": {\n        \"channelId\": \"={{ $('Mattermost: trigger').item.json.body.channel_id }}\",\n        \"message\": \"@{{ $('Mattermost: trigger').item.json.body.user_name }} :eyes: *Release MR created* — `{{ $json.web_url }}`\\n\\n*Your action:* review, approve, and merge to deploy to production.\",\n        \"otherOptions\": {}\n      },\n      \"id\": \"slack-mr-ready\",\n      \"name\": \"Mattermost: release MR ready\",\n      \"type\": \"n8n-nodes-base.mattermost\",\n      \"typeVersion\": 1,\n      \"position\": [\n        1680,\n        200\n      ],\n      \"credentials\": {\n        \"mattermostApi\": {\n          \"id\": \"mm-creds\",\n          \"name\": \"Mattermost SDLC Bot\"\n        }\n      }\n    }\n  ],\n  \"connections\": {\n    \"Mattermost: trigger\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Mattermost: production release started\",\n            \"type\": \"main\",\n            \"index\": 0\n          },\n          {\n            \"node\": \"Mattermost: ack command\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Mattermost: production release started\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Check rm:go on release ticket\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Check rm:go on release ticket\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"rm:go confirmed?\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"rm:go confirmed?\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"rm:go present?\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"rm:go present?\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Create promote→main MR via GitLab API\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ],\n        [\n          {\n            \"node\": \"Mattermost: production blocked\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Create promote→main MR via GitLab API\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Mattermost: release MR ready\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    }\n  },\n  \"active\": true,\n  \"settings\": {\n    \"executionOrder\": \"v1\"\n  },\n  \"tags\": [\n    {\n      \"name\": \"production\"\n    },\n    {\n      \"name\": \"phase-5\"\n    },\n    {\n      \"name\": \"mattermost\"\n    }\n  ]\n}\n","F-18-release-mr-merged.json":"{\n  \"name\": \"F-18 Release MR Merged\",\n  \"nodes\": [\n    {\n      \"parameters\": {\n        \"httpMethod\": \"POST\",\n        \"path\": \"release-mr-merged\",\n        \"responseMode\": \"lastNode\",\n        \"options\": {}\n      },\n      \"id\": \"wh-18\",\n      \"name\": \"Webhook: release-mr-merged\",\n      \"type\": \"n8n-nodes-base.webhook\",\n      \"typeVersion\": 1,\n      \"position\": [\n        240,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"channelId\": \"={{ $env.MM_SDLC_CHANNEL }}\",\n        \"message\": \":merged: *Release MR merged* — production deployment starting.\\nPost-merge CI: git diff → argocd sync → health gate → git tag.\\n\\nYou'll be notified when smoke tests complete.\",\n        \"otherOptions\": {}\n      },\n      \"id\": \"slack-18\",\n      \"name\": \"Mattermost: release MR merged — production deploying\",\n      \"type\": \"n8n-nodes-base.mattermost\",\n      \"typeVersion\": 1,\n      \"position\": [\n        480,\n        300\n      ],\n      \"credentials\": {\n        \"mattermostApi\": {\n          \"id\": \"mm-creds\",\n          \"name\": \"Mattermost SDLC Bot\"\n        }\n      }\n    },\n    {\n      \"parameters\": {\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/ci-production-deployed\",\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"version\",\n              \"value\": \"={{ $json.body.version }}\"\n            },\n            {\n              \"name\": \"release_ticket_id\",\n              \"value\": \"={{ $json.body.release_ticket_id }}\"\n            },\n            {\n              \"name\": \"project_id\",\n              \"value\": \"={{ $json.body.project_id }}\"\n            }\n          ]\n        }\n      },\n      \"id\": \"trig-f19\",\n      \"name\": \"CI notifies n8n → F-19 (after post-merge CI)\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4,\n      \"position\": [\n        720,\n        300\n      ]\n    }\n  ],\n  \"connections\": {\n    \"Webhook: release-mr-merged\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Mattermost: release MR merged — production deploying\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Mattermost: release MR merged — production deploying\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"CI notifies n8n → F-19 (after post-merge CI)\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    }\n  },\n  \"active\": true,\n  \"settings\": {\n    \"executionOrder\": \"v1\"\n  },\n  \"tags\": [\n    {\n      \"name\": \"production\"\n    },\n    {\n      \"name\": \"phase-5\"\n    },\n    {\n      \"name\": \"mattermost\"\n    }\n  ]\n}\n","F-19-production-deployed.json":"{\n  \"name\": \"F-19 Production Deployed\",\n  \"nodes\": [\n    {\n      \"parameters\": {\n        \"httpMethod\": \"POST\",\n        \"path\": \"ci-production-deployed\",\n        \"responseMode\": \"lastNode\",\n        \"options\": {}\n      },\n      \"id\": \"wh-19\",\n      \"name\": \"Webhook: ci-production-deployed\",\n      \"type\": \"n8n-nodes-base.webhook\",\n      \"typeVersion\": 1,\n      \"position\": [\n        240,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"command\": \"=glab issue comment {{ $json.body.release_ticket_id }} --message 'Production deployed: {{ $json.body.version }} at {{ new Date().toISOString() }}'\"\n      },\n      \"id\": \"upd-rt\",\n      \"name\": \"Update release ticket: prod deployed\",\n      \"type\": \"n8n-nodes-base.executeCommand\",\n      \"typeVersion\": 1,\n      \"position\": [\n        480,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"command\": \"=echo '{\\\"role\\\":\\\"qa-engineer\\\",\\\"task\\\":\\\"smoke-tests\\\",\\\"version\\\":\\\"{{ $json.body.version }}\\\",\\\"base_url\\\":\\\"https://production.{{ $json.body.project }}\\\"}' \u003e /tmp/smoke.json \u0026\u0026 omp run --mode json --role smol @/tmp/smoke.json\"\n      },\n      \"id\": \"smoke\",\n      \"name\": \"Run smoke tests from QA smoke plan ticket\",\n      \"type\": \"n8n-nodes-base.executeCommand\",\n      \"typeVersion\": 1,\n      \"position\": [\n        720,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"conditions\": {\n          \"conditions\": [\n            {\n              \"leftValue\": \"={{ $json.exitCode }}\",\n              \"rightValue\": 0,\n              \"operator\": {\n                \"type\": \"number\",\n                \"operation\": \"equals\"\n              }\n            }\n          ]\n        }\n      },\n      \"id\": \"smoke-pass\",\n      \"name\": \"Smoke tests pass?\",\n      \"type\": \"n8n-nodes-base.if\",\n      \"typeVersion\": 2,\n      \"position\": [\n        960,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"channelId\": \"={{ $env.MM_SDLC_CHANNEL }}\",\n        \"message\": \":rotating_light: *Production smoke tests FAILED* — `{{ $json.body.version }}`\\n{{ $json.stdout }}\\n\\nImmediate action required. Consider `/rollback {{ $json.body.version }}`.\",\n        \"otherOptions\": {}\n      },\n      \"id\": \"slack-smoke-fail\",\n      \"name\": \"Mattermost: smoke tests FAILED\",\n      \"type\": \"n8n-nodes-base.mattermost\",\n      \"typeVersion\": 1,\n      \"position\": [\n        1200,\n        440\n      ],\n      \"credentials\": {\n        \"mattermostApi\": {\n          \"id\": \"mm-creds\",\n          \"name\": \"Mattermost SDLC Bot\"\n        }\n      }\n    },\n    {\n      \"parameters\": {\n        \"command\": \"=echo '{\\\"role\\\":\\\"release-manager\\\",\\\"task\\\":\\\"production-monitoring\\\",\\\"version\\\":\\\"{{ $json.body.version }}\\\",\\\"release_ticket_id\\\":\\\"{{ $json.body.release_ticket_id }}\\\"}' \u003e /tmp/rm-mon.json \u0026\u0026 omp run --mode json --role default @/tmp/rm-mon.json\"\n      },\n      \"id\": \"spawn-rm\",\n      \"name\": \"Spawn RM: production monitoring window\",\n      \"type\": \"n8n-nodes-base.executeCommand\",\n      \"typeVersion\": 1,\n      \"position\": [\n        1200,\n        200\n      ]\n    },\n    {\n      \"parameters\": {\n        \"command\": \"=glab release create {{ $json.body.version }} --title 'Release {{ $json.body.version }}' --notes 'See wiki for release notes.'\"\n      },\n      \"id\": \"git-release\",\n      \"name\": \"Create GitLab release object + schedule cleanup\",\n      \"type\": \"n8n-nodes-base.executeCommand\",\n      \"typeVersion\": 1,\n      \"position\": [\n        1200,\n        320\n      ]\n    },\n    {\n      \"parameters\": {\n        \"channelId\": \"={{ $env.MM_SDLC_CHANNEL }}\",\n        \"message\": \":white_check_mark: *Production deployed* — `{{ $json.body.version }}`\\nSmoke tests passed. RM monitoring window active.\\n\\nYou'll be notified when the monitoring window completes.\",\n        \"otherOptions\": {}\n      },\n      \"id\": \"slack-prod-up\",\n      \"name\": \"Mattermost: production healthy — monitoring\",\n      \"type\": \"n8n-nodes-base.mattermost\",\n      \"typeVersion\": 1,\n      \"position\": [\n        1440,\n        260\n      ],\n      \"credentials\": {\n        \"mattermostApi\": {\n          \"id\": \"mm-creds\",\n          \"name\": \"Mattermost SDLC Bot\"\n        }\n      }\n    }\n  ],\n  \"connections\": {\n    \"Webhook: ci-production-deployed\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Update release ticket: prod deployed\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Update release ticket: prod deployed\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Run smoke tests from QA smoke plan ticket\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Run smoke tests from QA smoke plan ticket\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Smoke tests pass?\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Smoke tests pass?\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Spawn RM: production monitoring window\",\n            \"type\": \"main\",\n            \"index\": 0\n          },\n          {\n            \"node\": \"Create GitLab release object + schedule cleanup\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ],\n        [\n          {\n            \"node\": \"Mattermost: smoke tests FAILED\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Spawn RM: production monitoring window\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Mattermost: production healthy — monitoring\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Create GitLab release object + schedule cleanup\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Mattermost: production healthy — monitoring\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    }\n  },\n  \"active\": true,\n  \"settings\": {\n    \"executionOrder\": \"v1\"\n  },\n  \"tags\": [\n    {\n      \"name\": \"production\"\n    },\n    {\n      \"name\": \"phase-5\"\n    },\n    {\n      \"name\": \"mattermost\"\n    }\n  ]\n}\n","F-20-monitoring-window.json":"{\n  \"name\": \"F-20 Monitoring Window Complete\",\n  \"nodes\": [\n    {\n      \"parameters\": {\n        \"httpMethod\": \"POST\",\n        \"path\": \"monitoring-complete\",\n        \"responseMode\": \"lastNode\",\n        \"options\": {}\n      },\n      \"id\": \"wh-20\",\n      \"name\": \"Webhook: monitoring-complete\",\n      \"type\": \"n8n-nodes-base.webhook\",\n      \"typeVersion\": 1,\n      \"position\": [\n        240,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"conditions\": {\n          \"conditions\": [\n            {\n              \"leftValue\": \"={{ $json.body.incident }}\",\n              \"rightValue\": true,\n              \"operator\": {\n                \"type\": \"boolean\",\n                \"operation\": \"equals\"\n              }\n            }\n          ]\n        }\n      },\n      \"id\": \"incident-check\",\n      \"name\": \"Incident detected?\",\n      \"type\": \"n8n-nodes-base.if\",\n      \"typeVersion\": 2,\n      \"position\": [\n        480,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"channelId\": \"={{ $env.MM_SDLC_CHANNEL }}\",\n        \"message\": \":rotating_light: *PRODUCTION INCIDENT* — `{{ $json.body.version }}`\\n*Metric:* {{ $json.body.metric }} = {{ $json.body.value }} (threshold breached)\\n*Trend:* {{ $json.body.trend }}\\n\\n*RM recommendation:*\\n{{ $json.body.recommended_action }}\\n\\nReply with your decision.\",\n        \"otherOptions\": {}\n      },\n      \"id\": \"slack-incident\",\n      \"name\": \"Mattermost: PRODUCTION INCIDENT\",\n      \"type\": \"n8n-nodes-base.mattermost\",\n      \"typeVersion\": 1,\n      \"position\": [\n        720,\n        160\n      ],\n      \"credentials\": {\n        \"mattermostApi\": {\n          \"id\": \"mm-creds\",\n          \"name\": \"Mattermost SDLC Bot\"\n        }\n      }\n    },\n    {\n      \"parameters\": {\n        \"command\": \"=glab issue update {{ $json.body.release_ticket_id }} --label-add 'monitoring:passed' \u0026\u0026 glab issue close {{ $json.body.release_ticket_id }}\"\n      },\n      \"id\": \"close-rt\",\n      \"name\": \"Update release ticket: monitoring passed + close\",\n      \"type\": \"n8n-nodes-base.executeCommand\",\n      \"typeVersion\": 1,\n      \"position\": [\n        720,\n        440\n      ]\n    },\n    {\n      \"parameters\": {\n        \"command\": \"=echo '{\\\"role\\\":\\\"pm\\\",\\\"task\\\":\\\"release-communication\\\",\\\"version\\\":\\\"{{ $json.body.version }}\\\"}' \u003e /tmp/pm-comm.json \u0026\u0026 opencode run --print \\\"$(cat /tmp/pm-comm.json)\\\"\"\n      },\n      \"id\": \"pm-comms\",\n      \"name\": \"Spawn PM: release communication\",\n      \"type\": \"n8n-nodes-base.executeCommand\",\n      \"typeVersion\": 1,\n      \"position\": [\n        960,\n        440\n      ]\n    },\n    {\n      \"parameters\": {\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/cluster-sleep\",\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"cluster\",\n              \"value\": \"staging\"\n            }\n          ]\n        }\n      },\n      \"id\": \"sleep-stg\",\n      \"name\": \"Sleep staging cluster\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4,\n      \"position\": [\n        1200,\n        440\n      ]\n    },\n    {\n      \"parameters\": {\n        \"channelId\": \"={{ $env.MM_SDLC_CHANNEL }}\",\n        \"message\": \":tada: *Release `{{ $json.body.version }}` confirmed stable!*\\nMonitoring window complete · no incidents · release ticket closed.\\nRelease notes posted. Staging cluster sleeping.\\n\\nRun `/retro {{ $json.body.version }}` to complete the sprint.\",\n        \"otherOptions\": {}\n      },\n      \"id\": \"slack-confirmed\",\n      \"name\": \"Mattermost: release confirmed\",\n      \"type\": \"n8n-nodes-base.mattermost\",\n      \"typeVersion\": 1,\n      \"position\": [\n        1440,\n        440\n      ],\n      \"credentials\": {\n        \"mattermostApi\": {\n          \"id\": \"mm-creds\",\n          \"name\": \"Mattermost SDLC Bot\"\n        }\n      }\n    }\n  ],\n  \"connections\": {\n    \"Webhook: monitoring-complete\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Incident detected?\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Incident detected?\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Mattermost: PRODUCTION INCIDENT\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ],\n        [\n          {\n            \"node\": \"Update release ticket: monitoring passed + close\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Update release ticket: monitoring passed + close\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Spawn PM: release communication\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Spawn PM: release communication\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Sleep staging cluster\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Sleep staging cluster\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Mattermost: release confirmed\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    }\n  },\n  \"active\": true,\n  \"settings\": {\n    \"executionOrder\": \"v1\"\n  },\n  \"tags\": [\n    {\n      \"name\": \"production\"\n    },\n    {\n      \"name\": \"phase-5\"\n    },\n    {\n      \"name\": \"mattermost\"\n    }\n  ]\n}\n","F-21-rollback.json":"{\n  \"name\": \"F-21 /rollback\",\n  \"nodes\": [\n    {\n      \"parameters\": {\n        \"httpMethod\": \"POST\",\n        \"path\": \"mm-rollback\",\n        \"responseMode\": \"responseNode\",\n        \"options\": {}\n      },\n      \"id\": \"slack-trigger\",\n      \"name\": \"Mattermost: trigger\",\n      \"type\": \"n8n-nodes-base.webhook\",\n      \"typeVersion\": 1,\n      \"position\": [\n        240,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"respondWith\": \"json\",\n        \"responseBody\": \"{\\\"response_type\\\": \\\"ephemeral\\\", \\\"text\\\": \\\":hourglass_flowing_sand: Running `/rollback`...\\\"}\"\n      },\n      \"id\": \"mm-ack-slack-trigger\",\n      \"name\": \"Mattermost: ack command\",\n      \"type\": \"n8n-nodes-base.respondToWebhook\",\n      \"typeVersion\": 1,\n      \"position\": [\n        480,\n        200\n      ]\n    },\n    {\n      \"parameters\": {\n        \"channelId\": \"={{ $('Mattermost: trigger').item.json.body.channel_id }}\",\n        \"message\": \"@{{ $('Mattermost: trigger').item.json.body.user_name }} :rotating_light: *Production rollback initiated* for `{{ $json.text }}`\\nArgoCD rolling back now...\",\n        \"otherOptions\": {}\n      },\n      \"id\": \"ack-21\",\n      \"name\": \"Mattermost: rollback started\",\n      \"type\": \"n8n-nodes-base.mattermost\",\n      \"typeVersion\": 1,\n      \"position\": [\n        480,\n        300\n      ],\n      \"credentials\": {\n        \"mattermostApi\": {\n          \"id\": \"mm-creds\",\n          \"name\": \"Mattermost SDLC Bot\"\n        }\n      }\n    },\n    {\n      \"parameters\": {\n        \"command\": \"=argocd app rollback {{ $env.ARGOCD_PROJECT }}-production --server $ARGOCD_URL \u0026\u0026 echo 'Rollback initiated'\"\n      },\n      \"id\": \"rb\",\n      \"name\": \"ArgoCD rollback production\",\n      \"type\": \"n8n-nodes-base.executeCommand\",\n      \"typeVersion\": 1,\n      \"position\": [\n        720,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"command\": \"=glab issue create --title '[incident] Production rollback {{ $('Slack: trigger').item.json.text }}' --label 'type:incident' --description 'Production rollback executed. Time: {{ new Date().toISOString() }}. Reason: manual rollback command.'\"\n      },\n      \"id\": \"incident-ticket\",\n      \"name\": \"Create incident ticket\",\n      \"type\": \"n8n-nodes-base.executeCommand\",\n      \"typeVersion\": 1,\n      \"position\": [\n        960,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"command\": \"=echo '{\\\"role\\\":\\\"release-manager\\\",\\\"task\\\":\\\"monitor-rollback\\\",\\\"version\\\":\\\"{{ $('Slack: trigger').item.json.text }}\\\"}' \u003e /tmp/rm-rb.json \u0026\u0026 omp run --mode json --role default @/tmp/rm-rb.json\"\n      },\n      \"id\": \"rm-mon\",\n      \"name\": \"Spawn RM: monitor rollback health\",\n      \"type\": \"n8n-nodes-base.executeCommand\",\n      \"typeVersion\": 1,\n      \"position\": [\n        1200,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"channelId\": \"={{ $('Mattermost: trigger').item.json.body.channel_id }}\",\n        \"message\": \"@{{ $('Mattermost: trigger').item.json.body.user_name }} :white_check_mark: Rollback initiated · incident ticket created · RM monitoring health.\\n\\nYou'll be notified when the rollback is confirmed stable.\",\n        \"otherOptions\": {}\n      },\n      \"id\": \"slack-rb-done\",\n      \"name\": \"Mattermost: rollback underway\",\n      \"type\": \"n8n-nodes-base.mattermost\",\n      \"typeVersion\": 1,\n      \"position\": [\n        1440,\n        300\n      ],\n      \"credentials\": {\n        \"mattermostApi\": {\n          \"id\": \"mm-creds\",\n          \"name\": \"Mattermost SDLC Bot\"\n        }\n      }\n    }\n  ],\n  \"connections\": {\n    \"Mattermost: trigger\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Mattermost: rollback started\",\n            \"type\": \"main\",\n            \"index\": 0\n          },\n          {\n            \"node\": \"Mattermost: ack command\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Mattermost: rollback started\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"ArgoCD rollback production\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"ArgoCD rollback production\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Create incident ticket\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Create incident ticket\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Spawn RM: monitor rollback health\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Spawn RM: monitor rollback health\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Mattermost: rollback underway\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    }\n  },\n  \"active\": true,\n  \"settings\": {\n    \"executionOrder\": \"v1\"\n  },\n  \"tags\": [\n    {\n      \"name\": \"production\"\n    },\n    {\n      \"name\": \"phase-5\"\n    },\n    {\n      \"name\": \"mattermost\"\n    }\n  ]\n}\n","F-22-rollback-story.json":"{\n  \"name\": \"F-22 /rollback-story\",\n  \"nodes\": [\n    {\n      \"parameters\": {\n        \"httpMethod\": \"POST\",\n        \"path\": \"mm-rollback_story\",\n        \"responseMode\": \"responseNode\",\n        \"options\": {}\n      },\n      \"id\": \"slack-trigger\",\n      \"name\": \"Mattermost: trigger\",\n      \"type\": \"n8n-nodes-base.webhook\",\n      \"typeVersion\": 1,\n      \"position\": [\n        240,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"respondWith\": \"json\",\n        \"responseBody\": \"{\\\"response_type\\\": \\\"ephemeral\\\", \\\"text\\\": \\\":hourglass_flowing_sand: Running `/rollback_story`...\\\"}\"\n      },\n      \"id\": \"mm-ack-slack-trigger\",\n      \"name\": \"Mattermost: ack command\",\n      \"type\": \"n8n-nodes-base.respondToWebhook\",\n      \"typeVersion\": 1,\n      \"position\": [\n        480,\n        200\n      ]\n    },\n    {\n      \"parameters\": {\n        \"channelId\": \"={{ $('Mattermost: trigger').item.json.body.channel_id }}\",\n        \"message\": \"@{{ $('Mattermost: trigger').item.json.body.user_name }} :hourglass: *Story rollback* for `{{ $json.text }}`\\nChecking dependency graph...\",\n        \"otherOptions\": {}\n      },\n      \"id\": \"ack-22\",\n      \"name\": \"Mattermost: rollback-story started\",\n      \"type\": \"n8n-nodes-base.mattermost\",\n      \"typeVersion\": 1,\n      \"position\": [\n        480,\n        300\n      ],\n      \"credentials\": {\n        \"mattermostApi\": {\n          \"id\": \"mm-creds\",\n          \"name\": \"Mattermost SDLC Bot\"\n        }\n      }\n    },\n    {\n      \"parameters\": {\n        \"url\": \"={{ $env.GITLAB_URL }}/api/v4/projects/{{ $env.GITLAB_PROJECT_ID }}/issues/{{ $('Slack: trigger').item.json.text }}\",\n        \"sendHeaders\": true,\n        \"headerParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"PRIVATE-TOKEN\",\n              \"value\": \"={{ $env.GITLAB_TOKEN }}\"\n            }\n          ]\n        }\n      },\n      \"id\": \"verify-merged\",\n      \"name\": \"Verify story is merged\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4,\n      \"position\": [\n        720,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"jsCode\": \"const labels=$json.labels||[];\\nconst isMerged=labels.includes('merged-to-release');\\nreturn [{json:{isMerged,hasDependents:false,storyId:$json.iid}}];\"\n      },\n      \"id\": \"dep-check\",\n      \"name\": \"Check dependency graph\",\n      \"type\": \"n8n-nodes-base.code\",\n      \"typeVersion\": 2,\n      \"position\": [\n        960,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"conditions\": {\n          \"conditions\": [\n            {\n              \"leftValue\": \"={{ $json.hasDependents }}\",\n              \"rightValue\": true,\n              \"operator\": {\n                \"type\": \"boolean\",\n                \"operation\": \"equals\"\n              }\n            }\n          ]\n        }\n      },\n      \"id\": \"dep-gate\",\n      \"name\": \"Dependent stories?\",\n      \"type\": \"n8n-nodes-base.if\",\n      \"typeVersion\": 2,\n      \"position\": [\n        1200,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"channelId\": \"={{ $('Mattermost: trigger').item.json.body.channel_id }}\",\n        \"message\": \"@{{ $('Mattermost: trigger').item.json.body.user_name }} :warning: *Cascade warning* — other stories depend on GL-`{{ $json.storyId }}`.\\nConfirm scope before proceeding. Reply to confirm.\",\n        \"otherOptions\": {}\n      },\n      \"id\": \"cascade-warn\",\n      \"name\": \"Mattermost: cascade warning\",\n      \"type\": \"n8n-nodes-base.mattermost\",\n      \"typeVersion\": 1,\n      \"position\": [\n        1440,\n        160\n      ],\n      \"credentials\": {\n        \"mattermostApi\": {\n          \"id\": \"mm-creds\",\n          \"name\": \"Mattermost SDLC Bot\"\n        }\n      }\n    },\n    {\n      \"parameters\": {\n        \"url\": \"={{ $env.GITLAB_URL }}/api/v4/projects/{{ $env.GITLAB_PROJECT_ID }}/merge_requests\",\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"source_branch\",\n              \"value\": \"={{ 'revert-GL-' + $('Slack: trigger').item.json.text + '/' + $env.RELEASE_VERSION }}\"\n            },\n            {\n              \"name\": \"target_branch\",\n              \"value\": \"={{ 'release/' + $env.RELEASE_VERSION }}\"\n            },\n            {\n              \"name\": \"title\",\n              \"value\": \"={{ '[revert] GL-' + $('Slack: trigger').item.json.text + ' from ' + $env.RELEASE_VERSION }}\"\n            },\n            {\n              \"name\": \"description\",\n              \"value\": \"Story rollback revert MR.\"\n            }\n          ]\n        },\n        \"sendHeaders\": true,\n        \"headerParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"PRIVATE-TOKEN\",\n              \"value\": \"={{ $env.GITLAB_TOKEN }}\"\n            }\n          ]\n        }\n      },\n      \"id\": \"create-revert-mr\",\n      \"name\": \"Create revert MR on release branch\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4,\n      \"position\": [\n        1440,\n        440\n      ]\n    },\n    {\n      \"parameters\": {\n        \"command\": \"=echo '{\\\"role\\\":\\\"tech-lead\\\",\\\"task\\\":\\\"review-revert-mr\\\",\\\"story_id\\\":\\\"{{ $('Slack: trigger').item.json.text }}\\\"}' \u003e /tmp/tl-rv.json \u0026\u0026 omp run --mode json --role slow @/tmp/tl-rv.json\"\n      },\n      \"id\": \"tl-review\",\n      \"name\": \"TL Pod: review revert MR\",\n      \"type\": \"n8n-nodes-base.executeCommand\",\n      \"typeVersion\": 1,\n      \"position\": [\n        1680,\n        440\n      ]\n    },\n    {\n      \"parameters\": {\n        \"channelId\": \"={{ $('Mattermost: trigger').item.json.body.channel_id }}\",\n        \"message\": \"@{{ $('Mattermost: trigger').item.json.body.user_name }} :eyes: *Revert MR ready* — GL-`{{ $('Slack: trigger').item.json.text }}`\\nTL reviewed. Merge the revert MR to defer this story.\\n\u003c{{ $json.web_url }}|View revert MR\u003e\",\n        \"otherOptions\": {}\n      },\n      \"id\": \"slack-revert-ready\",\n      \"name\": \"Mattermost: revert MR ready for review\",\n      \"type\": \"n8n-nodes-base.mattermost\",\n      \"typeVersion\": 1,\n      \"position\": [\n        1920,\n        440\n      ],\n      \"credentials\": {\n        \"mattermostApi\": {\n          \"id\": \"mm-creds\",\n          \"name\": \"Mattermost SDLC Bot\"\n        }\n      }\n    }\n  ],\n  \"connections\": {\n    \"Mattermost: trigger\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Mattermost: rollback-story started\",\n            \"type\": \"main\",\n            \"index\": 0\n          },\n          {\n            \"node\": \"Mattermost: ack command\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Mattermost: rollback-story started\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Verify story is merged\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Verify story is merged\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Check dependency graph\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Check dependency graph\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Dependent stories?\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Dependent stories?\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Mattermost: cascade warning\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ],\n        [\n          {\n            \"node\": \"Create revert MR on release branch\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Create revert MR on release branch\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"TL Pod: review revert MR\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"TL Pod: review revert MR\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Mattermost: revert MR ready for review\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    }\n  },\n  \"active\": true,\n  \"settings\": {\n    \"executionOrder\": \"v1\"\n  },\n  \"tags\": [\n    {\n      \"name\": \"production\"\n    },\n    {\n      \"name\": \"phase-5\"\n    },\n    {\n      \"name\": \"mattermost\"\n    }\n  ]\n}\n","F-23-revert-mr-merged.json":"{\n  \"name\": \"F-23 Revert MR Merged\",\n  \"nodes\": [\n    {\n      \"parameters\": {\n        \"httpMethod\": \"POST\",\n        \"path\": \"revert-mr-merged\",\n        \"responseMode\": \"lastNode\",\n        \"options\": {}\n      },\n      \"id\": \"wh-23\",\n      \"name\": \"Webhook: revert-mr-merged\",\n      \"type\": \"n8n-nodes-base.webhook\",\n      \"typeVersion\": 1,\n      \"position\": [\n        240,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"command\": \"=glab issue update {{ $json.body.story_id }} --label-add 'deferred:{{ $json.body.version }}' \u0026\u0026 glab issue comment {{ $json.body.story_id }} --message 'Deferred from {{ $json.body.version }}. Child tasks preserved.'\"\n      },\n      \"id\": \"defer-story\",\n      \"name\": \"Story ticket: Deferred + label\",\n      \"type\": \"n8n-nodes-base.executeCommand\",\n      \"typeVersion\": 1,\n      \"position\": [\n        480,\n        200\n      ]\n    },\n    {\n      \"parameters\": {\n        \"command\": \"=echo 'Labelling child tasks as deferred for GL-{{ $json.body.story_id }}'\"\n      },\n      \"id\": \"update-tasks\",\n      \"name\": \"Child tasks: label deferred, stay open\",\n      \"type\": \"n8n-nodes-base.executeCommand\",\n      \"typeVersion\": 1,\n      \"position\": [\n        480,\n        340\n      ]\n    },\n    {\n      \"parameters\": {\n        \"command\": \"=glab issue comment {{ $json.body.release_ticket_id }} --message 'GL-{{ $json.body.story_id }} deferred from {{ $json.body.version }}. Reduced scope.'\"\n      },\n      \"id\": \"update-rel\",\n      \"name\": \"Release ticket: update scope\",\n      \"type\": \"n8n-nodes-base.executeCommand\",\n      \"typeVersion\": 1,\n      \"position\": [\n        480,\n        480\n      ]\n    },\n    {\n      \"parameters\": {\n        \"url\": \"={{ $env.N8N_WEBHOOK_BASE }}/uat\",\n        \"sendBody\": true,\n        \"bodyParameters\": {\n          \"parameters\": [\n            {\n              \"name\": \"version\",\n              \"value\": \"={{ $json.body.version }}\"\n            },\n            {\n              \"name\": \"project\",\n              \"value\": \"={{ $json.body.project }}\"\n            },\n            {\n              \"name\": \"note\",\n              \"value\": \"Re-triggered after story deferral\"\n            }\n          ]\n        }\n      },\n      \"id\": \"retrigger-uat\",\n      \"name\": \"Re-trigger /uat with reduced scope\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4,\n      \"position\": [\n        720,\n        340\n      ]\n    },\n    {\n      \"parameters\": {\n        \"channelId\": \"={{ $env.MM_SDLC_CHANNEL }}\",\n        \"message\": \":arrows_counterclockwise: Story GL-`{{ $json.body.story_id }}` *deferred* from `{{ $json.body.version }}`.\\nChild tasks preserved · Release scope reduced · UAT re-triggered with reduced scope.\",\n        \"otherOptions\": {}\n      },\n      \"id\": \"slack-23\",\n      \"name\": \"Mattermost: story deferred — /uat re-triggered\",\n      \"type\": \"n8n-nodes-base.mattermost\",\n      \"typeVersion\": 1,\n      \"position\": [\n        960,\n        340\n      ],\n      \"credentials\": {\n        \"mattermostApi\": {\n          \"id\": \"mm-creds\",\n          \"name\": \"Mattermost SDLC Bot\"\n        }\n      }\n    }\n  ],\n  \"connections\": {\n    \"Webhook: revert-mr-merged\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Story ticket: Deferred + label\",\n            \"type\": \"main\",\n            \"index\": 0\n          },\n          {\n            \"node\": \"Child tasks: label deferred, stay open\",\n            \"type\": \"main\",\n            \"index\": 0\n          },\n          {\n            \"node\": \"Release ticket: update scope\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Story ticket: Deferred + label\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Re-trigger /uat with reduced scope\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Child tasks: label deferred, stay open\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Re-trigger /uat with reduced scope\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Release ticket: update scope\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Re-trigger /uat with reduced scope\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Re-trigger /uat with reduced scope\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Mattermost: story deferred — /uat re-triggered\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    }\n  },\n  \"active\": true,\n  \"settings\": {\n    \"executionOrder\": \"v1\"\n  },\n  \"tags\": [\n    {\n      \"name\": \"production\"\n    },\n    {\n      \"name\": \"phase-5\"\n    },\n    {\n      \"name\": \"mattermost\"\n    }\n  ]\n}\n","F-24-retro.json":"{\n  \"name\": \"F-24 /retro\",\n  \"nodes\": [\n    {\n      \"parameters\": {\n        \"httpMethod\": \"POST\",\n        \"path\": \"mm-retro\",\n        \"responseMode\": \"responseNode\",\n        \"options\": {}\n      },\n      \"id\": \"slack-trigger\",\n      \"name\": \"Mattermost: trigger\",\n      \"type\": \"n8n-nodes-base.webhook\",\n      \"typeVersion\": 1,\n      \"position\": [\n        240,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"respondWith\": \"json\",\n        \"responseBody\": \"{\\\"response_type\\\": \\\"ephemeral\\\", \\\"text\\\": \\\":hourglass_flowing_sand: Running `/retro`...\\\"}\"\n      },\n      \"id\": \"mm-ack-slack-trigger\",\n      \"name\": \"Mattermost: ack command\",\n      \"type\": \"n8n-nodes-base.respondToWebhook\",\n      \"typeVersion\": 1,\n      \"position\": [\n        480,\n        200\n      ]\n    },\n    {\n      \"parameters\": {\n        \"channelId\": \"={{ $('Mattermost: trigger').item.json.body.channel_id }}\",\n        \"message\": \"@{{ $('Mattermost: trigger').item.json.body.user_name }} :hourglass: *Retrospective started* for `={{ $('Slack: trigger').item.json.text }}`\\n4 pods compiling in parallel (TL · QA · Security · RM)...\",\n        \"otherOptions\": {}\n      },\n      \"id\": \"ack-24\",\n      \"name\": \"Mattermost: retro started\",\n      \"type\": \"n8n-nodes-base.mattermost\",\n      \"typeVersion\": 1,\n      \"position\": [\n        480,\n        300\n      ],\n      \"credentials\": {\n        \"mattermostApi\": {\n          \"id\": \"mm-creds\",\n          \"name\": \"Mattermost SDLC Bot\"\n        }\n      }\n    },\n    {\n      \"parameters\": {\n        \"command\": \"=echo '{\\\"role\\\":\\\"tech-lead\\\",\\\"task\\\":\\\"retro-code-quality\\\"}' \u003e /tmp/r-tl.json \u0026\u0026 omp run --mode json --role slow @/tmp/r-tl.json\"\n      },\n      \"id\": \"tl-ret\",\n      \"name\": \"Spawn TL: code quality metrics\",\n      \"type\": \"n8n-nodes-base.executeCommand\",\n      \"typeVersion\": 1,\n      \"position\": [\n        720,\n        160\n      ]\n    },\n    {\n      \"parameters\": {\n        \"command\": \"=echo '{\\\"role\\\":\\\"qa-engineer\\\",\\\"task\\\":\\\"retro-qa-metrics\\\"}' \u003e /tmp/r-qa.json \u0026\u0026 omp run --mode json --role smol @/tmp/r-qa.json\"\n      },\n      \"id\": \"qa-ret\",\n      \"name\": \"Spawn QA: test metrics\",\n      \"type\": \"n8n-nodes-base.executeCommand\",\n      \"typeVersion\": 1,\n      \"position\": [\n        720,\n        280\n      ]\n    },\n    {\n      \"parameters\": {\n        \"command\": \"=echo '{\\\"role\\\":\\\"security-engineer\\\",\\\"task\\\":\\\"retro-security-metrics\\\"}' \u003e /tmp/r-sec.json \u0026\u0026 omp run --mode json --role smol @/tmp/r-sec.json\"\n      },\n      \"id\": \"sec-ret\",\n      \"name\": \"Spawn Security: security metrics\",\n      \"type\": \"n8n-nodes-base.executeCommand\",\n      \"typeVersion\": 1,\n      \"position\": [\n        720,\n        400\n      ]\n    },\n    {\n      \"parameters\": {\n        \"command\": \"=echo '{\\\"role\\\":\\\"release-manager\\\",\\\"task\\\":\\\"retro-release-metrics\\\"}' \u003e /tmp/r-rm.json \u0026\u0026 omp run --mode json --role smol @/tmp/r-rm.json\"\n      },\n      \"id\": \"rm-ret\",\n      \"name\": \"Spawn RM: release metrics\",\n      \"type\": \"n8n-nodes-base.executeCommand\",\n      \"typeVersion\": 1,\n      \"position\": [\n        720,\n        520\n      ]\n    },\n    {\n      \"parameters\": {\n        \"command\": \"=echo '{\\\"role\\\":\\\"pm\\\",\\\"task\\\":\\\"retro-synthesis\\\"}' \u003e /tmp/r-pm.json \u0026\u0026 opencode run --print \\\"$(cat /tmp/r-pm.json)\\\"\"\n      },\n      \"id\": \"pm-synth\",\n      \"name\": \"Spawn PM: synthesise 11-section retro report\",\n      \"type\": \"n8n-nodes-base.executeCommand\",\n      \"typeVersion\": 1,\n      \"position\": [\n        960,\n        340\n      ]\n    },\n    {\n      \"parameters\": {\n        \"channelId\": \"={{ $('Mattermost: trigger').item.json.body.channel_id }}\",\n        \"message\": \"@{{ $('Mattermost: trigger').item.json.body.user_name }} :books: *Retrospective complete* for `={{ $('Slack: trigger').item.json.text }}`\\n11-section report published to wiki.\\nImprovement actions added to backlog.\\n\\nSprint complete — ready for next `/plan_release`.\",\n        \"otherOptions\": {}\n      },\n      \"id\": \"slack-retro-done\",\n      \"name\": \"Mattermost: retrospective complete\",\n      \"type\": \"n8n-nodes-base.mattermost\",\n      \"typeVersion\": 1,\n      \"position\": [\n        1200,\n        340\n      ],\n      \"credentials\": {\n        \"mattermostApi\": {\n          \"id\": \"mm-creds\",\n          \"name\": \"Mattermost SDLC Bot\"\n        }\n      }\n    }\n  ],\n  \"connections\": {\n    \"Mattermost: trigger\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Mattermost: retro started\",\n            \"type\": \"main\",\n            \"index\": 0\n          },\n          {\n            \"node\": \"Mattermost: ack command\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Mattermost: retro started\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Spawn TL: code quality metrics\",\n            \"type\": \"main\",\n            \"index\": 0\n          },\n          {\n            \"node\": \"Spawn QA: test metrics\",\n            \"type\": \"main\",\n            \"index\": 0\n          },\n          {\n            \"node\": \"Spawn Security: security metrics\",\n            \"type\": \"main\",\n            \"index\": 0\n          },\n          {\n            \"node\": \"Spawn RM: release metrics\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Spawn TL: code quality metrics\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Spawn PM: synthesise 11-section retro report\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Spawn QA: test metrics\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Spawn PM: synthesise 11-section retro report\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Spawn Security: security metrics\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Spawn PM: synthesise 11-section retro report\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Spawn RM: release metrics\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Spawn PM: synthesise 11-section retro report\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Spawn PM: synthesise 11-section retro report\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Mattermost: retrospective complete\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    }\n  },\n  \"active\": true,\n  \"settings\": {\n    \"executionOrder\": \"v1\"\n  },\n  \"tags\": [\n    {\n      \"name\": \"retro\"\n    },\n    {\n      \"name\": \"phase-6\"\n    },\n    {\n      \"name\": \"mattermost\"\n    }\n  ]\n}\n","F-25-escalate.json":"{\n  \"name\": \"F-25 /escalate (Cross-cutting)\",\n  \"nodes\": [\n    {\n      \"parameters\": {\n        \"httpMethod\": \"POST\",\n        \"path\": \"escalate\",\n        \"responseMode\": \"lastNode\",\n        \"options\": {}\n      },\n      \"id\": \"wh-25\",\n      \"name\": \"Webhook: escalate\",\n      \"type\": \"n8n-nodes-base.webhook\",\n      \"typeVersion\": 1,\n      \"position\": [\n        240,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"jsCode\": \"const dag=$workflow.staticData.dagState||{};\\ndag.pausedTasks=dag.pausedTasks||[];\\ndag.pausedTasks.push($json.body.context);\\n$workflow.staticData.dagState=dag;\\nreturn [{json:{paused:true,context:$json.body.context,reason:$json.body.reason,flow:$json.body.flow,attempts:$json.body.attempts}}];\"\n      },\n      \"id\": \"pause-dag\",\n      \"name\": \"Pause DAG tasks\",\n      \"type\": \"n8n-nodes-base.code\",\n      \"typeVersion\": 2,\n      \"position\": [\n        480,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"channelId\": \"={{ $env.MM_SDLC_CHANNEL }}\",\n        \"message\": \":rotating_light: *ESCALATION* — `{{ $json.flow }}`\\n*Reason:* {{ $json.reason }}\\n*Attempts:* {{ $json.attempts }}\\n*Context:* {{ $json.context }}\\n\\nDAG paused. Your action required.\",\n        \"otherOptions\": {}\n      },\n      \"id\": \"slack-escalate\",\n      \"name\": \"Mattermost: ESCALATION\",\n      \"type\": \"n8n-nodes-base.mattermost\",\n      \"typeVersion\": 1,\n      \"position\": [\n        720,\n        300\n      ],\n      \"credentials\": {\n        \"mattermostApi\": {\n          \"id\": \"mm-creds\",\n          \"name\": \"Mattermost SDLC Bot\"\n        }\n      }\n    }\n  ],\n  \"connections\": {\n    \"Webhook: escalate\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Pause DAG tasks\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Pause DAG tasks\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Mattermost: ESCALATION\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    }\n  },\n  \"active\": true,\n  \"settings\": {\n    \"executionOrder\": \"v1\"\n  },\n  \"tags\": [\n    {\n      \"name\": \"cross-cutting\"\n    },\n    {\n      \"name\": \"mattermost\"\n    }\n  ]\n}\n","F-26-projects.json":"{\n  \"name\": \"F-26 /projects\",\n  \"nodes\": [\n    {\n      \"parameters\": {\n        \"httpMethod\": \"POST\",\n        \"path\": \"mm-projects\",\n        \"responseMode\": \"responseNode\",\n        \"options\": {}\n      },\n      \"id\": \"slack-trigger\",\n      \"name\": \"Mattermost: trigger\",\n      \"type\": \"n8n-nodes-base.webhook\",\n      \"typeVersion\": 1,\n      \"position\": [\n        240,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"respondWith\": \"json\",\n        \"responseBody\": \"{\\\"response_type\\\": \\\"ephemeral\\\", \\\"text\\\": \\\":hourglass_flowing_sand: Running `/projects`...\\\"}\"\n      },\n      \"id\": \"mm-ack-slack-trigger\",\n      \"name\": \"Mattermost: ack command\",\n      \"type\": \"n8n-nodes-base.respondToWebhook\",\n      \"typeVersion\": 1,\n      \"position\": [\n        480,\n        200\n      ]\n    },\n    {\n      \"parameters\": {\n        \"jsCode\": \"const dag=$workflow.staticData.dagState||{};\\nconst summary={\\n  version:dag.version||'(none)',\\n  phase:dag.currentPhase||'idle',\\n  storiesTotal:dag.totalStories||0,\\n  storiesMerged:(dag.mergedStories||[]).length,\\n  openMRs:Object.keys(dag.openMRs||{}).length,\\n  clusterStates:dag.clusterStates||{},\\n  pausedTasks:(dag.pausedTasks||[]).length,\\n  lastActivity:dag.lastActivity||'—'\\n};\\nreturn [{json:summary}];\"\n      },\n      \"id\": \"read-dag\",\n      \"name\": \"Read n8n DAG state\",\n      \"type\": \"n8n-nodes-base.code\",\n      \"typeVersion\": 2,\n      \"position\": [\n        480,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"channelId\": \"={{ $('Mattermost: trigger').item.json.body.channel_id }}\",\n        \"message\": \"@{{ $('Mattermost: trigger').item.json.body.user_name }} :bar_chart: *SDLC Status*\\n*Version:* `{{ $json.version }}`\\n*Phase:* {{ $json.phase }}\\n*Stories:* {{ $json.storiesMerged }}/{{ $json.storiesTotal }} merged\\n*Open MRs:* {{ $json.openMRs }}\\n*Paused tasks:* {{ $json.pausedTasks }}\\n*Clusters:* {{ JSON.stringify($json.clusterStates) }}\\n*Last activity:* {{ $json.lastActivity }}\",\n        \"otherOptions\": {}\n      },\n      \"id\": \"slack-status\",\n      \"name\": \"Mattermost: project status report\",\n      \"type\": \"n8n-nodes-base.mattermost\",\n      \"typeVersion\": 1,\n      \"position\": [\n        720,\n        300\n      ],\n      \"credentials\": {\n        \"mattermostApi\": {\n          \"id\": \"mm-creds\",\n          \"name\": \"Mattermost SDLC Bot\"\n        }\n      }\n    }\n  ],\n  \"connections\": {\n    \"Mattermost: trigger\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Read n8n DAG state\",\n            \"type\": \"main\",\n            \"index\": 0\n          },\n          {\n            \"node\": \"Mattermost: ack command\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Read n8n DAG state\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Mattermost: project status report\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    }\n  },\n  \"active\": true,\n  \"settings\": {\n    \"executionOrder\": \"v1\"\n  },\n  \"tags\": [\n    {\n      \"name\": \"cross-cutting\"\n    },\n    {\n      \"name\": \"mattermost\"\n    }\n  ]\n}\n","F-27-cluster-lifecycle.json":"{\n  \"name\": \"F-27 Cluster Lifecycle\",\n  \"nodes\": [\n    {\n      \"parameters\": {\n        \"httpMethod\": \"POST\",\n        \"path\": \"cluster-wake\",\n        \"responseMode\": \"lastNode\",\n        \"options\": {}\n      },\n      \"id\": \"wh-wake\",\n      \"name\": \"Webhook: cluster-wake\",\n      \"type\": \"n8n-nodes-base.webhook\",\n      \"typeVersion\": 1,\n      \"position\": [\n        240,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"httpMethod\": \"POST\",\n        \"path\": \"cluster-sleep\",\n        \"responseMode\": \"lastNode\",\n        \"options\": {}\n      },\n      \"id\": \"wh-sleep\",\n      \"name\": \"Webhook: cluster-sleep\",\n      \"type\": \"n8n-nodes-base.webhook\",\n      \"typeVersion\": 1,\n      \"position\": [\n        240,\n        300\n      ]\n    },\n    {\n      \"parameters\": {\n        \"conditions\": {\n          \"conditions\": [\n            {\n              \"leftValue\": \"={{ $json.body.cluster }}\",\n              \"rightValue\": \"sit\",\n              \"operator\": {\n                \"type\": \"string\",\n                \"operation\": \"equals\"\n              }\n            }\n          ]\n        }\n      },\n      \"id\": \"not-sit-wake\",\n      \"name\": \"Not SIT? (always on)\",\n      \"type\": \"n8n-nodes-base.if\",\n      \"typeVersion\": 2,\n      \"position\": [\n        480,\n        200\n      ]\n    },\n    {\n      \"parameters\": {\n        \"command\": \"=kubectl scale deployment --all --replicas=1 -n {{ $json.body.cluster }} \u0026\u0026 kubectl rollout status deployment --all -n {{ $json.body.cluster }}\"\n      },\n      \"id\": \"wake-cmd\",\n      \"name\": \"kubectl scale up: wake cluster\",\n      \"type\": \"n8n-nodes-base.executeCommand\",\n      \"typeVersion\": 1,\n      \"position\": [\n        720,\n        200\n      ]\n    },\n    {\n      \"parameters\": {\n        \"conditions\": {\n          \"conditions\": [\n            {\n              \"leftValue\": \"={{ $json.body.cluster }}\",\n              \"rightValue\": \"production\",\n              \"operator\": {\n                \"type\": \"string\",\n                \"operation\": \"equals\"\n              }\n            }\n          ]\n        }\n      },\n      \"id\": \"not-prod-sleep\",\n      \"name\": \"Not production? (never sleeps)\",\n      \"type\": \"n8n-nodes-base.if\",\n      \"typeVersion\": 2,\n      \"position\": [\n        480,\n        440\n      ]\n    },\n    {\n      \"parameters\": {\n        \"command\": \"=kubectl scale deployment --all --replicas=0 -n {{ $json.body.cluster }}-server \u0026\u0026 kubectl scale deployment --all --replicas=0 -n {{ $json.body.cluster }}-frontend\"\n      },\n      \"id\": \"sleep-cmd\",\n      \"name\": \"kubectl scale down: sleep cluster\",\n      \"type\": \"n8n-nodes-base.executeCommand\",\n      \"typeVersion\": 1,\n      \"position\": [\n        720,\n        440\n      ]\n    },\n    {\n      \"parameters\": {\n        \"jsCode\": \"const dag=$workflow.staticData.dagState||{};\\ndag.clusterStates=dag.clusterStates||{};\\ndag.clusterStates[$json.body.cluster]=$json.body.cluster?'awake':'sleeping';\\ndag.lastActivity=new Date().toISOString();\\n$workflow.staticData.dagState=dag;\\nreturn [{json:{updated:true,cluster:$json.body.cluster}}];\"\n      },\n      \"id\": \"upd-state\",\n      \"name\": \"Update cluster state in DAG\",\n      \"type\": \"n8n-nodes-base.code\",\n      \"typeVersion\": 2,\n      \"position\": [\n        960,\n        320\n      ]\n    },\n    {\n      \"parameters\": {\n        \"channelId\": \"={{ $env.MM_SDLC_CHANNEL }}\",\n        \"message\": \"={{ $json.body.cluster === 'cluster-wake' ? ':green_circle:' : ':zzz:' }} *Cluster `{{ $json.body.cluster }}`* state updated.\",\n        \"otherOptions\": {}\n      },\n      \"id\": \"slack-cluster\",\n      \"name\": \"Mattermost: cluster state updated\",\n      \"type\": \"n8n-nodes-base.mattermost\",\n      \"typeVersion\": 1,\n      \"position\": [\n        1200,\n        320\n      ],\n      \"credentials\": {\n        \"mattermostApi\": {\n          \"id\": \"mm-creds\",\n          \"name\": \"Mattermost SDLC Bot\"\n        }\n      }\n    }\n  ],\n  \"connections\": {\n    \"Webhook: cluster-wake\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Not SIT? (always on)\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Not SIT? (always on)\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"kubectl scale up: wake cluster\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"kubectl scale up: wake cluster\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Update cluster state in DAG\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Webhook: cluster-sleep\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Not production? (never sleeps)\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Not production? (never sleeps)\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"kubectl scale down: sleep cluster\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"kubectl scale down: sleep cluster\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Update cluster state in DAG\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    },\n    \"Update cluster state in DAG\": {\n      \"main\": [\n        [\n          {\n            \"node\": \"Mattermost: cluster state updated\",\n            \"type\": \"main\",\n            \"index\": 0\n          }\n        ]\n      ]\n    }\n  },\n  \"active\": true,\n  \"settings\": {\n    \"executionOrder\": \"v1\"\n  },\n  \"tags\": [\n    {\n      \"name\": \"cross-cutting\"\n    },\n    {\n      \"name\": \"mattermost\"\n    }\n  ]\n}\n","F-28-chat.json":"{\n  \"name\": \"F-28 Mattermost chat with omp\",\n  \"nodes\": [\n    {\n      \"parameters\": {\n        \"httpMethod\": \"POST\",\n        \"path\": \"mm-chat\",\n        \"responseMode\": \"responseNode\",\n        \"options\": {}\n      },\n      \"id\": \"chat-trigger\",\n      \"name\": \"Mattermost: trigger\",\n      \"type\": \"n8n-nodes-base.webhook\",\n      \"typeVersion\": 1,\n      \"position\": [240, 300]\n    },\n    {\n      \"parameters\": {\n        \"respondWith\": \"json\",\n        \"responseBody\": \"{}\"\n      },\n      \"id\": \"chat-ack\",\n      \"name\": \"Ack (200 within 5s)\",\n      \"type\": \"n8n-nodes-base.respondToWebhook\",\n      \"typeVersion\": 1,\n      \"position\": [480, 200]\n    },\n    {\n      \"parameters\": {\n        \"method\": \"POST\",\n        \"url\": \"={{ $env.LITELLM_BASE }}/v1/chat/completions\",\n        \"sendHeaders\": true,\n        \"headerParameters\": {\n          \"parameters\": [\n            { \"name\": \"Authorization\", \"value\": \"=Bearer {{ $env.LITELLM_MASTER_KEY }}\" }\n          ]\n        },\n        \"sendBody\": true,\n        \"specifyBody\": \"json\",\n        \"jsonBody\": \"={{ JSON.stringify({ model: 'omp', messages: [ { role: 'user', content: ($json.body.text || '').replace(/^\\\\s*omp\\\\s+/i, '') } ] }) }}\",\n        \"options\": { \"timeout\": 300000 }\n      },\n      \"id\": \"ask-omp\",\n      \"name\": \"Ask omp\",\n      \"type\": \"n8n-nodes-base.httpRequest\",\n      \"typeVersion\": 4,\n      \"position\": [480, 380]\n    },\n    {\n      \"parameters\": {\n        \"channelId\": \"={{ $('Mattermost: trigger').item.json.body.channel_id }}\",\n        \"message\": \"={{ $json.choices[0].message.content }}\",\n        \"otherOptions\": {}\n      },\n      \"id\": \"chat-reply\",\n      \"name\": \"Mattermost: reply\",\n      \"type\": \"n8n-nodes-base.mattermost\",\n      \"typeVersion\": 1,\n      \"position\": [720, 380],\n      \"credentials\": {\n        \"mattermostApi\": { \"id\": \"mm-creds\", \"name\": \"Mattermost SDLC Bot\" }\n      }\n    }\n  ],\n  \"connections\": {\n    \"Mattermost: trigger\": {\n      \"main\": [\n        [\n          { \"node\": \"Ack (200 within 5s)\", \"type\": \"main\", \"index\": 0 },\n          { \"node\": \"Ask omp\", \"type\": \"main\", \"index\": 0 }\n        ]\n      ]\n    },\n    \"Ask omp\": {\n      \"main\": [\n        [\n          { \"node\": \"Mattermost: reply\", \"type\": \"main\", \"index\": 0 }\n        ]\n      ]\n    }\n  },\n  \"active\": true,\n  \"settings\": {\n    \"executionOrder\": \"v1\"\n  },\n  \"tags\": [\n    { \"name\": \"cross-cutting\" },\n    { \"name\": \"mattermost\" }\n  ]\n}\n","bind-mm-cred.py":"#!/usr/bin/env python3\n\"\"\"Point every seeded workflow's `mattermostApi` node at a real credential.\n\nThe flow JSON files carry a placeholder credential ref (`id: mm-creds`). n8n's\npublic API can't create a credential with a chosen id and can't list existing\nones, so playbooks/mattermost.yml creates the credential fresh, then runs this\nto rebind the seeded workflows to whatever id it got.\n\nEnv:\n  N8N_URL        base url (e.g. http://n8n.n8n.svc.cluster.local:5678)\n  N8N_API_KEY    public API key\n  MM_CRED_ID     credential id to bind\n  MM_CRED_NAME   credential name (default \"Mattermost SDLC Bot\")\n\nponytail: stdlib only, runs in the alpine ansible runner. Idempotent — a\nre-run just re-writes the same id.\n\"\"\"\nimport json\nimport os\nimport sys\nimport urllib.error\nimport urllib.request\n\nBASE = os.environ[\"N8N_URL\"].rstrip(\"/\")\nKEY = os.environ[\"N8N_API_KEY\"]\nCRED_ID = os.environ[\"MM_CRED_ID\"]\nCRED_NAME = os.environ.get(\"MM_CRED_NAME\", \"Mattermost SDLC Bot\")\n\n\ndef api(method, path, body=None):\n    req = urllib.request.Request(\n        BASE + path,\n        method=method,\n        headers={\"X-N8N-API-KEY\": KEY, \"Content-Type\": \"application/json\"},\n        data=json.dumps(body).encode() if body is not None else None,\n    )\n    with urllib.request.urlopen(req, timeout=30) as resp:\n        return json.load(resp)\n\n\ndef main():\n    workflows = api(\"GET\", \"/api/v1/workflows?limit=250\").get(\"data\", [])\n    bound = 0\n    for wf in workflows:\n        full = api(\"GET\", f\"/api/v1/workflows/{wf['id']}\")\n        touched = False\n        for node in full.get(\"nodes\", []):\n            creds = node.get(\"credentials\") or {}\n            if \"mattermostApi\" in creds:\n                creds[\"mattermostApi\"] = {\"id\": CRED_ID, \"name\": CRED_NAME}\n                node[\"credentials\"] = creds\n                touched = True\n        if not touched:\n            continue\n        payload = {k: full[k] for k in (\"name\", \"nodes\", \"connections\", \"settings\") if k in full}\n        api(\"PUT\", f\"/api/v1/workflows/{wf['id']}\", payload)\n        if full.get(\"active\"):\n            try:\n                api(\"POST\", f\"/api/v1/workflows/{wf['id']}/activate\")\n            except urllib.error.HTTPError:\n                pass\n        bound += 1\n        print(f\"  bound: {full['name']}\")\n    print(f\"{bound} workflow(s) bound to credential {CRED_ID} ({CRED_NAME})\")\n\n\nif __name__ == \"__main__\":\n    try:\n        main()\n    except urllib.error.HTTPError as e:\n        sys.exit(f\"n8n API {e.code}: {e.read().decode()[:300]}\")\n","seed.sh":"#!/usr/bin/env bash\n# seed.sh — seeds all 28 SDLC n8n flows via n8n REST API\n# Flows use Mattermost slash commands for user-invoked phases.\n# GitLab/CI events remain as webhooks.\n#\n# Usage:\n#   N8N_URL=http://localhost:5678 N8N_API_KEY=your-key ./seed.sh [--force]\n\nset -euo pipefail\n\nN8N_URL=\"${N8N_URL:-http://localhost:5678}\"\nN8N_API_KEY=\"${N8N_API_KEY:?N8N_API_KEY is required}\"\nSCRIPT_DIR=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" \u0026\u0026 pwd)\"\n\ncat \u003c\u003c 'SETUP'\n================================\nn8n SDLC Flow Seeder — Mattermost edition\n================================\n\nMATTERMOST SETUP (required before flows work):\n\n1. Create a Bot account in Mattermost:\n   System Console → Integrations → Bot Accounts → Add Bot\n   Username: sdlc-bot\n   Copy the Bot Access Token\n\n2. Add n8n credential:\n   n8n → Credentials → New → Mattermost API\n   Name: \"Mattermost SDLC Bot\"\n   Access Token: (paste Bot Access Token)\n   Base URL: https://mattermost.yourdomain.com\n\n3. Register slash commands in Mattermost:\n   Main Menu → Integrations → Slash Commands → Add Slash Command\n\n   Command        → Request URL\n   /plan_release  → https://n8n.yourdomain.com/webhook/mm-plan_release\n   /kickoff       → https://n8n.yourdomain.com/webhook/mm-kickoff\n   /develop       → https://n8n.yourdomain.com/webhook/mm-develop\n   /uat           → https://n8n.yourdomain.com/webhook/mm-uat\n   /release_staging     → https://n8n.yourdomain.com/webhook/mm-release_staging\n   /release_production  → https://n8n.yourdomain.com/webhook/mm-release_production\n   /rollback      → https://n8n.yourdomain.com/webhook/mm-rollback\n   /rollback_story → https://n8n.yourdomain.com/webhook/mm-rollback_story\n   /retro         → https://n8n.yourdomain.com/webhook/mm-retro\n   /projects      → https://n8n.yourdomain.com/webhook/mm-projects\n\n   For each command:\n     Request method: POST\n     Response username: sdlc-bot\n     Autocomplete: enabled (add description)\n\n4. Add bot to your SDLC channel:\n   /invite @sdlc-bot\n\n5. Set env vars in n8n Settings → Variables:\n   MM_SDLC_CHANNEL = your-channel-id  (find in channel URL or API)\n   MM_BASE_URL     = https://mattermost.yourdomain.com\n   GITLAB_URL, GITLAB_TOKEN, GITLAB_PROJECT_ID\n   N8N_WEBHOOK_BASE, GITLAB_WEBHOOK_SECRET\n   ARGOCD_URL, ARGOCD_PROJECT\n   RELEASE_TICKET_ID, RELEASE_VERSION\n\n6. Chat with omp (flow F-28) — the sdlc-svc user, the 'ai' channel, the\n   outgoing webhook, and the n8n credential are all created by\n   playbooks/mattermost.yml:\n     scripts/ansible-run.sh mattermost\n   Then in the 'ai' channel type:  omp \u003cyour question\u003e\n   (trigger word 'omp' — mmctl's create-outgoing needs one). First message\n   after the omp pod idles waits ~30-120s for scale-up + model load.\n\n7. GitLab group webhook (registered automatically by DevOps pod at /kickoff):\n   URL: https://n8n.yourdomain.com/webhook/gitlab-events\n   Events: Merge requests + Pipelines\n   Secret: set GITLAB_WEBHOOK_SECRET to a random token\n\nSETUP\n\necho \"\"\n\n# Wait for n8n\necho \"Waiting for n8n to be ready...\"\nfor i in {1..30}; do\n  if curl -sf \"$N8N_URL/healthz\" \u003e /dev/null 2\u003e\u00261; then\n    echo \"n8n is ready.\"\n    break\n  fi\n  echo \"  attempt $i/30 ...\"\n  sleep 5\ndone\n\nEXISTING=$(curl -sf \\\n  -H \"X-N8N-API-KEY: $N8N_API_KEY\" \\\n  \"$N8N_URL/api/v1/workflows?limit=1\" \\\n  | python3 -c \"import json,sys; print(json.load(sys.stdin).get('count',0))\" 2\u003e/dev/null || echo \"0\")\n\nif [ \"$EXISTING\" -gt \"0\" ]; then\n  echo \"WARNING: $EXISTING workflows already exist.\"\n  if [[ \"${1:-}\" != \"--force\" ]]; then\n    echo \"Run with --force to override.\"\n    exit 0\n  fi\n  echo \"--force specified. Proceeding...\"\nfi\n\nSUCCESS=0\nFAILED=0\nFLOWS=(\n  \"F-00-gitlab-router.json\"\n  \"F-01-plan-release.json\"\n  \"F-02-kickoff.json\"\n  \"F-03-develop.json\"\n  \"F-04-task-mr-opened.json\"\n  \"F-05-task-mr-merged.json\"\n  \"F-06-dod-check.json\"\n  \"F-07-flow.json\"\n  \"F-08-flow.json\"\n  \"F-09-flow.json\"\n  \"F-10-uat.json\"\n  \"F-11-uat-qa-complete.json\"\n  \"F-12-uat-security-complete.json\"\n  \"F-13-uat-po-complete.json\"\n  \"F-14-release-staging.json\"\n  \"F-15-staging-deployed.json\"\n  \"F-16-go-nogo.json\"\n  \"F-17-release-production.json\"\n  \"F-18-release-mr-merged.json\"\n  \"F-19-production-deployed.json\"\n  \"F-20-monitoring-window.json\"\n  \"F-21-rollback.json\"\n  \"F-22-rollback-story.json\"\n  \"F-23-revert-mr-merged.json\"\n  \"F-24-retro.json\"\n  \"F-25-escalate.json\"\n  \"F-26-projects.json\"\n  \"F-27-cluster-lifecycle.json\"\n  \"F-28-chat.json\"\n)\n\nfor flow_file in \"${FLOWS[@]}\"; do\n  flow_path=\"$SCRIPT_DIR/$flow_file\"\n  if [ ! -f \"$flow_path\" ]; then\n    echo \"  SKIP: $flow_file (not found)\"\n    continue\n  fi\n  flow_name=$(python3 -c \"import json; print(json.load(open('$flow_path')).get('name','?'))\")\n  echo -n \"  Seeding: $flow_name ... \"\n  # n8n 2.x public API rejects read-only keys (active, tags, id, ...) on create.\n  # Keep only the writable fields.\n  python3 -c \"import json,sys; d=json.load(open('$flow_path')); json.dump({k:d[k] for k in ('name','nodes','connections','settings','staticData') if k in d}, open('/tmp/n8n-seed-body.json','w'))\"\n  HTTP_CODE=$(curl -s -o /tmp/n8n-seed-resp.json -w \"%{http_code}\" \\\n    -X POST \"$N8N_URL/api/v1/workflows\" \\\n    -H \"X-N8N-API-KEY: $N8N_API_KEY\" \\\n    -H \"Content-Type: application/json\" \\\n    -d @/tmp/n8n-seed-body.json)\n  if [ \"$HTTP_CODE\" -eq 200 ] || [ \"$HTTP_CODE\" -eq 201 ]; then\n    WF_ID=$(python3 -c \"import json; print(json.load(open('/tmp/n8n-seed-resp.json')).get('id','?'))\" 2\u003e/dev/null || echo \"?\")\n    echo \"OK (id: $WF_ID)\"\n    if [ \"$WF_ID\" != \"?\" ]; then\n      curl -sf -X POST \"$N8N_URL/api/v1/workflows/$WF_ID/activate\" \\\n        -H \"X-N8N-API-KEY: $N8N_API_KEY\" \u003e /dev/null 2\u003e\u00261 \\\n        \u0026\u0026 echo \"    → activated\" || echo \"    → activation failed (activate manually)\"\n    fi\n    SUCCESS=$((SUCCESS+1))\n  else\n    echo \"FAILED (HTTP $HTTP_CODE)\"\n    python3 -m json.tool /tmp/n8n-seed-resp.json 2\u003e/dev/null || true\n    FAILED=$((FAILED+1))\n  fi\ndone\n\necho \"\"\necho \"================================\"\necho \"Seeding complete: $SUCCESS OK  $FAILED failed\"\necho \"================================\"\necho \"\"\necho \"Slash command → webhook path mapping:\"\necho \"  /plan_release        → /webhook/mm-plan_release   (F-01)\"\necho \"  /kickoff             → /webhook/mm-kickoff        (F-02)\"\necho \"  /develop             → /webhook/mm-develop        (F-03)\"\necho \"  /uat                 → /webhook/mm-uat            (F-10)\"\necho \"  /release_staging     → /webhook/mm-release_staging (F-14)\"\necho \"  /release_production  → /webhook/mm-release_production (F-17)\"\necho \"  /rollback            → /webhook/mm-rollback       (F-21)\"\necho \"  /rollback_story      → /webhook/mm-rollback_story (F-22)\"\necho \"  /retro               → /webhook/mm-retro          (F-24)\"\necho \"  /projects            → /webhook/mm-projects       (F-26)\"\necho \"\"\necho \"GitLab single webhook → /webhook/gitlab-events (F-00)\"\necho \"(DevOps pod registers this at /kickoff via glab — no manual setup)\"\n"},"id":"ansible/ansible-n8n-flows","immutable":false,"metadata":[{"annotations":{},"generate_name":"","generation":0,"labels":{},"name":"ansible-n8n-flows","namespace":"ansible","resource_version":"84390","uid":"e0da503a-043b-4bea-a079-c0a30a3e887c"}]},"sensitive_attributes":[],"private":"bnVsbA==","dependencies":["kubernetes_namespace.ansible"],"identity":{"api_version":"v1","kind":"ConfigMap","name":"ansible-n8n-flows","namespace":"ansible"},"identity_schema_version":1}]},{"mode":"managed","type":"kubernetes_config_map","name":"n8n_oidc_hooks","provider":"provider[\"registry.opentofu.org/hashicorp/kubernetes\"]","instances":[{"schema_version":0,"attributes":{"binary_data":{},"data":{"hooks.js":"/**\r\n * n8n External Hooks for OIDC Authentication\r\n *\r\n * This file implements OIDC authentication support for n8n using only built-in Node.js modules.\r\n * It provides:\r\n * - OIDC discovery endpoint support\r\n * - Authorization code flow\r\n * - User provisioning (JIT - Just In Time)\r\n * - Frontend customization to show OIDC login button\r\n *\r\n * Environment Variables Required:\r\n * - OIDC_ISSUER_URL: The OIDC provider's issuer URL (e.g., https://auth.example.com)\r\n * - OIDC_CLIENT_ID: OAuth2 client ID\r\n * - OIDC_CLIENT_SECRET: OAuth2 client secret\r\n * - OIDC_REDIRECT_URI: The callback URL (e.g., https://n8n.example.com/auth/oidc/callback)\r\n *\r\n * Optional:\r\n * - OIDC_SCOPES: Space-separated list of scopes (default: \"openid email profile\")\r\n */\r\n\r\nconst https = require('https');\r\nconst http = require('http');\r\nconst crypto = require('crypto');\r\nconst { URL, URLSearchParams } = require('url');\r\n\r\n// Configuration from environment\r\nconst config = {\r\n  issuerUrl: process.env.OIDC_ISSUER_URL,\r\n  clientId: process.env.OIDC_CLIENT_ID,\r\n  clientSecret: process.env.OIDC_CLIENT_SECRET,\r\n  redirectUri: process.env.OIDC_REDIRECT_URI,\r\n  scopes: process.env.OIDC_SCOPES || 'openid email profile',\r\n};\r\n\r\n// Validate configuration\r\nfunction validateConfig() {\r\n  const missing = [];\r\n  if (!config.issuerUrl) missing.push('OIDC_ISSUER_URL');\r\n  if (!config.clientId) missing.push('OIDC_CLIENT_ID');\r\n  if (!config.clientSecret) missing.push('OIDC_CLIENT_SECRET');\r\n  if (!config.redirectUri) missing.push('OIDC_REDIRECT_URI');\r\n  return missing;\r\n}\r\n\r\n// Cache for OIDC discovery document\r\nlet discoveryCache = null;\r\nlet discoveryCacheTime = 0;\r\nconst DISCOVERY_CACHE_TTL = 3600000; // 1 hour\r\n\r\n/**\r\n * Make an HTTP/HTTPS request\r\n * @param {string} url - The URL to request\r\n * @param {object} options - Request options\r\n * @returns {Promise\u003c{statusCode: number, headers: object, body: string}\u003e}\r\n */\r\nfunction makeRequest(url, options = {}) {\r\n  return new Promise((resolve, reject) =\u003e {\r\n    const parsedUrl = new URL(url);\r\n    const protocol = parsedUrl.protocol === 'https:' ? https : http;\r\n\r\n    const reqOptions = {\r\n      hostname: parsedUrl.hostname,\r\n      port: parsedUrl.port || (parsedUrl.protocol === 'https:' ? 443 : 80),\r\n      path: parsedUrl.pathname + parsedUrl.search,\r\n      method: options.method || 'GET',\r\n      headers: options.headers || {},\r\n    };\r\n\r\n    const req = protocol.request(reqOptions, (res) =\u003e {\r\n      let body = '';\r\n      res.on('data', (chunk) =\u003e (body += chunk));\r\n      res.on('end', () =\u003e {\r\n        resolve({\r\n          statusCode: res.statusCode,\r\n          headers: res.headers,\r\n          body,\r\n        });\r\n      });\r\n    });\r\n\r\n    req.on('error', reject);\r\n\r\n    if (options.body) {\r\n      req.write(options.body);\r\n    }\r\n\r\n    req.end();\r\n  });\r\n}\r\n\r\n/**\r\n * Fetch OIDC discovery document\r\n * @returns {Promise\u003cobject\u003e}\r\n */\r\nasync function fetchDiscoveryDocument() {\r\n  const now = Date.now();\r\n  if (discoveryCache \u0026\u0026 now - discoveryCacheTime \u003c DISCOVERY_CACHE_TTL) {\r\n    return discoveryCache;\r\n  }\r\n\r\n  const discoveryUrl = config.issuerUrl.replace(/\\/$/, '') + '/.well-known/openid-configuration';\r\n  const response = await makeRequest(discoveryUrl);\r\n\r\n  if (response.statusCode !== 200) {\r\n    throw new Error(`Failed to fetch OIDC discovery document: ${response.statusCode}`);\r\n  }\r\n\r\n  discoveryCache = JSON.parse(response.body);\r\n  discoveryCacheTime = now;\r\n  return discoveryCache;\r\n}\r\n\r\n/**\r\n * Generate a random string for state/nonce\r\n * @param {number} length\r\n * @returns {string}\r\n */\r\nfunction generateRandomString(length = 32) {\r\n  return crypto.randomBytes(length).toString('hex');\r\n}\r\n\r\n/**\r\n * Base64URL encode\r\n * @param {Buffer|string} input\r\n * @returns {string}\r\n */\r\nfunction base64UrlEncode(input) {\r\n  const base64 = Buffer.isBuffer(input) ? input.toString('base64') : Buffer.from(input).toString('base64');\r\n  return base64.replace(/\\+/g, '-').replace(/\\//g, '_').replace(/=/g, '');\r\n}\r\n\r\n/**\r\n * Base64URL decode\r\n * @param {string} input\r\n * @returns {Buffer}\r\n */\r\nfunction base64UrlDecode(input) {\r\n  let base64 = input.replace(/-/g, '+').replace(/_/g, '/');\r\n  while (base64.length % 4) {\r\n    base64 += '=';\r\n  }\r\n  return Buffer.from(base64, 'base64');\r\n}\r\n\r\n/**\r\n * Decode JWT without verification (for extracting claims)\r\n * @param {string} token\r\n * @returns {object}\r\n */\r\nfunction decodeJwt(token) {\r\n  const parts = token.split('.');\r\n  if (parts.length !== 3) {\r\n    throw new Error('Invalid JWT format');\r\n  }\r\n\r\n  const payload = JSON.parse(base64UrlDecode(parts[1]).toString('utf8'));\r\n  return payload;\r\n}\r\n\r\n/**\r\n * Exchange authorization code for tokens\r\n * @param {string} code\r\n * @param {object} discovery\r\n * @returns {Promise\u003cobject\u003e}\r\n */\r\nasync function exchangeCodeForTokens(code, discovery) {\r\n  const params = new URLSearchParams({\r\n    grant_type: 'authorization_code',\r\n    code,\r\n    redirect_uri: config.redirectUri,\r\n    client_id: config.clientId,\r\n    client_secret: config.clientSecret,\r\n  });\r\n\r\n  const response = await makeRequest(discovery.token_endpoint, {\r\n    method: 'POST',\r\n    headers: {\r\n      'Content-Type': 'application/x-www-form-urlencoded',\r\n    },\r\n    body: params.toString(),\r\n  });\r\n\r\n  if (response.statusCode !== 200) {\r\n    console.error('Token exchange failed:', response.body);\r\n    throw new Error(`Token exchange failed: ${response.statusCode}`);\r\n  }\r\n\r\n  return JSON.parse(response.body);\r\n}\r\n\r\n/**\r\n * Fetch user info from OIDC provider\r\n * @param {string} accessToken\r\n * @param {object} discovery\r\n * @returns {Promise\u003cobject\u003e}\r\n */\r\nasync function fetchUserInfo(accessToken, discovery) {\r\n  const response = await makeRequest(discovery.userinfo_endpoint, {\r\n    headers: {\r\n      Authorization: `Bearer ${accessToken}`,\r\n    },\r\n  });\r\n\r\n  if (response.statusCode !== 200) {\r\n    console.error('UserInfo fetch failed:', response.body);\r\n    throw new Error(`UserInfo fetch failed: ${response.statusCode}`);\r\n  }\r\n\r\n  return JSON.parse(response.body);\r\n}\r\n\r\n/**\r\n * Create a signed JWT for state/nonce storage\r\n * We use the JWT service from n8n when available, but for cookies we just use HMAC\r\n * @param {object} payload\r\n * @param {string} secret\r\n * @param {number} expiresInSeconds\r\n * @returns {string}\r\n */\r\nfunction createSignedCookie(payload, secret, expiresInSeconds = 900) {\r\n  const exp = Math.floor(Date.now() / 1000) + expiresInSeconds;\r\n  const data = JSON.stringify({ ...payload, exp });\r\n  const hmac = crypto.createHmac('sha256', secret);\r\n  hmac.update(data);\r\n  const signature = hmac.digest('hex');\r\n  return base64UrlEncode(data) + '.' + signature;\r\n}\r\n\r\n/**\r\n * Verify and decode a signed cookie\r\n * @param {string} cookie\r\n * @param {string} secret\r\n * @returns {object|null}\r\n */\r\nfunction verifySignedCookie(cookie, secret) {\r\n  try {\r\n    const [dataB64, signature] = cookie.split('.');\r\n    const data = base64UrlDecode(dataB64).toString('utf8');\r\n\r\n    const hmac = crypto.createHmac('sha256', secret);\r\n    hmac.update(data);\r\n    const expectedSignature = hmac.digest('hex');\r\n\r\n    if (signature !== expectedSignature) {\r\n      return null;\r\n    }\r\n\r\n    const payload = JSON.parse(data);\r\n    if (payload.exp \u0026\u0026 payload.exp \u003c Date.now() / 1000) {\r\n      return null;\r\n    }\r\n\r\n    return payload;\r\n  } catch {\r\n    return null;\r\n  }\r\n}\r\n\r\n/**\r\n * Get or create the cookie signing secret\r\n * We derive it from the n8n encryption key if available\r\n * @param {object} context\r\n * @returns {string}\r\n */\r\nfunction getCookieSecret(context) {\r\n  // Use a combination of environment variables to create a stable secret\r\n  const baseKey = process.env.N8N_ENCRYPTION_KEY || process.env.OIDC_CLIENT_SECRET || 'n8n-oidc-hook-secret';\r\n  const hash = crypto.createHash('sha256').update(baseKey + '-oidc-state').digest('hex');\r\n  return hash;\r\n}\r\n\r\n/**\r\n * Create the n8n auth cookie using n8n's JwtService\r\n * @param {object} user\r\n * @param {object} jwtService - n8n's JwtService instance\r\n * @returns {string}\r\n */\r\nfunction createAuthToken(user, jwtService) {\r\n  // n8n's JWT contains: { id, hash, browserId?, usedMfa? }\r\n  const payload = {\r\n    id: user.id,\r\n    hash: createUserHash(user),\r\n    usedMfa: false,\r\n  };\r\n\r\n  return jwtService.sign(payload, { expiresIn: '7d' });\r\n}\r\n\r\n/**\r\n * Create user hash for JWT (mimics n8n's AuthService.createJWTHash)\r\n * @param {object} user\r\n * @returns {string}\r\n */\r\nfunction createUserHash(user) {\r\n  const payload = [user.email, user.password || ''];\r\n  if (user.mfaEnabled \u0026\u0026 user.mfaSecret) {\r\n    payload.push(user.mfaSecret.substring(0, 3));\r\n  }\r\n  return crypto.createHash('sha256').update(payload.join(':')).digest('base64').substring(0, 10);\r\n}\r\n\r\n/**\r\n * Check if email is valid\r\n * @param {string} email\r\n * @returns {boolean}\r\n */\r\nfunction isValidEmail(email) {\r\n  const emailRegex = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\r\n  return emailRegex.test(email);\r\n}\r\n\r\n// n8n module paths (specific to the Docker image)\r\nconst N8N_DI_PATH = '/usr/local/lib/node_modules/n8n/node_modules/@n8n/di';\r\nconst N8N_JWT_SERVICE_PATH = '/usr/local/lib/node_modules/n8n/dist/services/jwt.service.js';\r\n\r\n// Export the hooks\r\nmodule.exports = {\r\n  n8n: {\r\n    /**\r\n     * Called when n8n is ready\r\n     * We use this to register custom routes for OIDC\r\n     */\r\n    ready: [\r\n      async function (server, n8nConfig) {\r\n        const missing = validateConfig();\r\n        if (missing.length \u003e 0) {\r\n          console.warn(`[OIDC Hook] Missing configuration: ${missing.join(', ')}. OIDC disabled.`);\r\n          return;\r\n        }\r\n\r\n        console.log('[OIDC Hook] Initializing OIDC authentication...');\r\n\r\n        // Get n8n's JwtService from the DI container\r\n        const { Container } = require(N8N_DI_PATH);\r\n        const { JwtService } = require(N8N_JWT_SERVICE_PATH);\r\n        const jwtService = Container.get(JwtService);\r\n\r\n        const { app } = server;\r\n        const cookieSecret = getCookieSecret();\r\n\r\n        // Cookie settings\r\n        const cookieOptions = {\r\n          httpOnly: true,\r\n          secure: process.env.N8N_PROTOCOL === 'https',\r\n          sameSite: 'lax',\r\n          maxAge: 15 * 60 * 1000, // 15 minutes\r\n        };\r\n\r\n        const authCookieOptions = {\r\n          httpOnly: true,\r\n          secure: process.env.N8N_PROTOCOL === 'https',\r\n          sameSite: 'lax',\r\n          maxAge: 7 * 24 * 60 * 60 * 1000, // 7 days\r\n        };\r\n\r\n        /**\r\n         * OIDC Login endpoint - redirects to the OIDC provider\r\n         */\r\n        app.get('/auth/oidc/login', async (req, res) =\u003e {\r\n          try {\r\n            const discovery = await fetchDiscoveryDocument();\r\n\r\n            const state = generateRandomString();\r\n            const nonce = generateRandomString();\r\n\r\n            // Store state and nonce in signed cookies\r\n            const stateCookie = createSignedCookie({ state }, cookieSecret);\r\n            const nonceCookie = createSignedCookie({ nonce }, cookieSecret);\r\n\r\n            res.cookie('n8n-oidc-state', stateCookie, cookieOptions);\r\n            res.cookie('n8n-oidc-nonce', nonceCookie, cookieOptions);\r\n\r\n            // Build authorization URL\r\n            const authUrl = new URL(discovery.authorization_endpoint);\r\n            authUrl.searchParams.set('client_id', config.clientId);\r\n            authUrl.searchParams.set('redirect_uri', config.redirectUri);\r\n            authUrl.searchParams.set('response_type', 'code');\r\n            authUrl.searchParams.set('scope', config.scopes);\r\n            authUrl.searchParams.set('state', state);\r\n            authUrl.searchParams.set('nonce', nonce);\r\n\r\n            res.redirect(authUrl.toString());\r\n          } catch (error) {\r\n            console.error('[OIDC Hook] Login error:', error);\r\n            res.status(500).send('OIDC configuration error. Please check the logs.');\r\n          }\r\n        });\r\n\r\n        /**\r\n         * OIDC Callback endpoint - handles the authorization code\r\n         */\r\n        app.get('/auth/oidc/callback', async (req, res) =\u003e {\r\n          try {\r\n            const { code, state, error, error_description } = req.query;\r\n\r\n            // Handle OIDC errors\r\n            if (error) {\r\n              console.error('[OIDC Hook] OIDC error:', error, error_description);\r\n              return res.redirect('/signin?error=' + encodeURIComponent(error_description || error));\r\n            }\r\n\r\n            if (!code || !state) {\r\n              return res.redirect('/signin?error=' + encodeURIComponent('Missing authorization code or state'));\r\n            }\r\n\r\n            // Verify state\r\n            const stateCookie = req.cookies['n8n-oidc-state'];\r\n            const nonceCookie = req.cookies['n8n-oidc-nonce'];\r\n\r\n            if (!stateCookie || !nonceCookie) {\r\n              return res.redirect('/signin?error=' + encodeURIComponent('Missing state cookies - session expired'));\r\n            }\r\n\r\n            const statePayload = verifySignedCookie(stateCookie, cookieSecret);\r\n            const noncePayload = verifySignedCookie(nonceCookie, cookieSecret);\r\n\r\n            if (!statePayload || statePayload.state !== state) {\r\n              return res.redirect('/signin?error=' + encodeURIComponent('Invalid state - possible CSRF attack'));\r\n            }\r\n\r\n            // Clear state cookies\r\n            res.clearCookie('n8n-oidc-state');\r\n            res.clearCookie('n8n-oidc-nonce');\r\n\r\n            // Exchange code for tokens\r\n            const discovery = await fetchDiscoveryDocument();\r\n            const tokens = await exchangeCodeForTokens(code, discovery);\r\n\r\n            // Verify nonce in ID token if present\r\n            if (tokens.id_token) {\r\n              const idTokenClaims = decodeJwt(tokens.id_token);\r\n              if (noncePayload \u0026\u0026 idTokenClaims.nonce !== noncePayload.nonce) {\r\n                return res.redirect('/signin?error=' + encodeURIComponent('Invalid nonce - possible replay attack'));\r\n              }\r\n            }\r\n\r\n            // Get user info\r\n            let userInfo;\r\n            try {\r\n              userInfo = await fetchUserInfo(tokens.access_token, discovery);\r\n            } catch (e) {\r\n              // Fall back to ID token claims if userinfo endpoint fails\r\n              if (tokens.id_token) {\r\n                userInfo = decodeJwt(tokens.id_token);\r\n              } else {\r\n                throw e;\r\n              }\r\n            }\r\n\r\n            // Validate we have an email\r\n            if (!userInfo.email || !isValidEmail(userInfo.email)) {\r\n              return res.redirect('/signin?error=' + encodeURIComponent('No valid email in OIDC response'));\r\n            }\r\n\r\n            // Find or create user in n8n database\r\n            const { User, Settings, Credentials, Workflow } = this.dbCollections;\r\n\r\n            // Try to find existing user by email\r\n            let user = await User.findOne({\r\n              where: { email: userInfo.email },\r\n              relations: ['role'],\r\n            });\r\n\r\n            if (!user) {\r\n              // Check if this is the first user (should be owner)\r\n              const userCount = await User.count();\r\n\r\n              const userData = {\r\n                email: userInfo.email,\r\n                firstName: userInfo.given_name || userInfo.name?.split(' ')[0] || 'User',\r\n                lastName: userInfo.family_name || userInfo.name?.split(' ').slice(1).join(' ') || '',\r\n                password: crypto.randomBytes(32).toString('hex'), // Random password, can't be used\r\n                role: { slug: userCount === 0 ? 'global:owner' : 'global:member' },\r\n              };\r\n\r\n              // Use createUserWithProject to create both user and personal project\r\n              const result = await User.createUserWithProject(userData);\r\n              user = result.user;\r\n\r\n              console.log(`[OIDC Hook] Created ${userCount === 0 ? 'owner' : 'member'} user with personal project: ${userInfo.email}`);\r\n            }\r\n\r\n            if (!user) {\r\n              return res.redirect('/signin?error=' + encodeURIComponent('Failed to create or find user'));\r\n            }\r\n\r\n            // Create auth token using n8n's JwtService\r\n            const authToken = createAuthToken(user, jwtService);\r\n\r\n            // Set the n8n auth cookie\r\n            res.cookie('n8n-auth', authToken, authCookieOptions);\r\n\r\n            // Redirect to home\r\n            res.redirect('/');\r\n          } catch (error) {\r\n            console.error('[OIDC Hook] Callback error:', error);\r\n            res.redirect('/signin?error=' + encodeURIComponent('Authentication failed: ' + error.message));\r\n          }\r\n        });\r\n\r\n        /**\r\n         * Serve the frontend customization script\r\n         * This script will replace the login form with an OIDC button\r\n         *\r\n         * NOTE: The route must be under /assets/ or another non-UI route prefix\r\n         * to avoid being intercepted by n8n's history API handler which would\r\n         * serve index.html instead of our JavaScript file.\r\n         */\r\n        app.get('/assets/oidc-frontend-hook.js', (req, res) =\u003e {\r\n          // Use res.type() for proper MIME type handling with nosniff\r\n          res.type('text/javascript; charset=utf-8');\r\n          res.set('Cache-Control', 'public, max-age=3600');\r\n          res.send(getFrontendScript());\r\n        });\r\n\r\n        console.log('[OIDC Hook] OIDC routes registered:');\r\n        console.log('  - GET /auth/oidc/login');\r\n        console.log('  - GET /auth/oidc/callback');\r\n        console.log('  - GET /assets/oidc-frontend-hook.js');\r\n      },\r\n    ],\r\n  },\r\n\r\n  frontend: {\r\n    /**\r\n     * Modify frontend settings to configure SSO display\r\n     */\r\n    settings: [\r\n      async function (frontendSettings) {\r\n        const missing = validateConfig();\r\n        if (missing.length \u003e 0) {\r\n          return; // OIDC not configured, don't modify settings\r\n        }\r\n\r\n        // Enable OIDC login button by setting these properties\r\n        // This tells the frontend that OIDC is available\r\n        frontendSettings.sso = frontendSettings.sso || {};\r\n        frontendSettings.sso.oidc = {\r\n          loginEnabled: true,\r\n          loginUrl: '/auth/oidc/login',\r\n          callbackUrl: config.redirectUri,\r\n        };\r\n\r\n        // Set authentication method to OIDC so the frontend knows SSO is primary\r\n        frontendSettings.userManagement = frontendSettings.userManagement || {};\r\n        frontendSettings.userManagement.authenticationMethod = 'oidc';\r\n\r\n        // Enable enterprise OIDC feature flag so the SSO button shows\r\n        frontendSettings.enterprise = frontendSettings.enterprise || {};\r\n        frontendSettings.enterprise.oidc = true;\r\n\r\n        console.log('[OIDC Hook] Frontend settings configured for OIDC');\r\n      },\r\n    ],\r\n  },\r\n};\r\n\r\n/**\r\n * Generate the frontend customization script\r\n * This script runs in the browser and customizes the login page\r\n */\r\nfunction getFrontendScript() {\r\n  return `\r\n/**\r\n * n8n OIDC Frontend Customization\r\n *\r\n * This script surgically modifies the login form to show an SSO button.\r\n * To access the normal login form, add ?showLogin=true to the URL.\r\n */\r\n(function() {\r\n\t'use strict';\r\n\r\n\tfunction shouldShowNormalLogin() {\r\n\t\treturn new URLSearchParams(window.location.search).get('showLogin') === 'true';\r\n\t}\r\n\r\n\tfunction isSigninPage() {\r\n\t\treturn window.location.pathname === '/signin' || window.location.pathname === '/login';\r\n\t}\r\n\r\n\tfunction displayError(form) {\r\n\t\tvar error = new URLSearchParams(window.location.search).get('error');\r\n\t\tif (!error || !form || form.querySelector('#oidc-error')) return;\r\n\r\n\t\tvar errorDiv = document.createElement('div');\r\n\t\terrorDiv.id = 'oidc-error';\r\n\t\terrorDiv.style.cssText = 'background: var(--color-danger-tint-1, #fee); border: 1px solid var(--color-danger, #fcc); color: var(--color-danger, #c00); padding: 12px; border-radius: 4px; margin: 16px 0;';\r\n\t\terrorDiv.textContent = decodeURIComponent(error);\r\n\r\n\t\tvar heading = form.querySelector('div[class*=\"_heading_\"]');\r\n\t\tif (heading) heading.after(errorDiv);\r\n\t\telse form.prepend(errorDiv);\r\n\t}\r\n\r\n\tfunction injectSsoButton() {\r\n\t\tif (shouldShowNormalLogin()) return;\r\n\t\tif (!isSigninPage()) return;\r\n\r\n\t\tvar form = document.querySelector('[data-test-id=\"auth-form\"]');\r\n\t\tif (!form || form.querySelector('#oidc-sso-button')) return;\r\n\r\n\t\t// Find existing button to clone its classes\r\n\t\tvar existingButton = form.querySelector('[data-test-id=\"form-submit-button\"]');\r\n\t\tvar buttonClasses = existingButton ? existingButton.className : '';\r\n\r\n\t\t// Hide the form elements (inputs, buttons, forgot password)\r\n\t\tform.querySelectorAll('div[class*=\"_inputsContainer_\"], div[class*=\"_buttonsContainer_\"], div[class*=\"_actionContainer_\"]')\r\n\t\t\t.forEach(function(el) { el.style.display = 'none'; });\r\n\r\n\t\t// Create SSO button container\r\n\t\tvar ssoContainer = document.createElement('div');\r\n\t\tssoContainer.id = 'oidc-sso-container';\r\n\t\tssoContainer.style.cssText = 'text-align: center;';\r\n\r\n\t\t// Create button - use cloned classes or fallback styles\r\n\t\tvar button = document.createElement('button');\r\n\t\tbutton.id = 'oidc-sso-button';\r\n\t\tbutton.type = 'button';\r\n\t\tbutton.textContent = 'Sign in with SSO';\r\n\t\tbutton.onclick = function() { window.location.href = '/auth/oidc/login'; };\r\n\r\n\t\tif (buttonClasses) {\r\n\t\t\tbutton.className = buttonClasses;\r\n\t\t\tbutton.style.width = '100%';\r\n\t\t} else {\r\n\t\t\tbutton.style.cssText = 'width: 100%; padding: 12px 24px; font-size: 14px; font-weight: 600; color: white; background: var(--color-primary, #ea4b30); border: none; border-radius: 4px; cursor: pointer;';\r\n\t\t}\r\n\r\n\t\t// Create admin link\r\n\t\tvar adminLink = document.createElement('p');\r\n\t\tadminLink.style.cssText = 'margin-top: 16px; font-size: 12px; color: var(--color-text-light, #666);';\r\n\t\tadminLink.innerHTML = 'Admin? \u003ca href=\"?showLogin=true\" style=\"color: var(--color-primary, #ea4b30);\"\u003eSign in with email\u003c/a\u003e';\r\n\r\n\t\tssoContainer.appendChild(button);\r\n\t\tssoContainer.appendChild(adminLink);\r\n\r\n\t\t// Insert after the heading\r\n\t\tvar heading = form.querySelector('div[class*=\"_heading_\"]');\r\n\t\tif (heading) heading.after(ssoContainer);\r\n\t\telse form.prepend(ssoContainer);\r\n\r\n\t\tdisplayError(form);\r\n\t}\r\n\r\n\tfunction observeAndInject() {\r\n\t\tif (shouldShowNormalLogin() || !isSigninPage()) return;\r\n\r\n\t\tinjectSsoButton();\r\n\r\n\t\tvar observer = new MutationObserver(function() {\r\n\t\t\tif (isSigninPage() \u0026\u0026 !shouldShowNormalLogin()) {\r\n\t\t\t\tvar form = document.querySelector('[data-test-id=\"auth-form\"]');\r\n\t\t\t\tif (form \u0026\u0026 !form.querySelector('#oidc-sso-button')) {\r\n\t\t\t\t\tinjectSsoButton();\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t});\r\n\r\n\t\tobserver.observe(document.body, { childList: true, subtree: true });\r\n\t\tsetTimeout(function() { observer.disconnect(); }, 10000);\r\n\t}\r\n\r\n\tfunction handleNavigation() {\r\n\t\tvar origPush = history.pushState;\r\n\t\tvar origReplace = history.replaceState;\r\n\r\n\t\thistory.pushState = function() {\r\n\t\t\torigPush.apply(this, arguments);\r\n\t\t\tsetTimeout(observeAndInject, 100);\r\n\t\t};\r\n\r\n\t\thistory.replaceState = function() {\r\n\t\t\torigReplace.apply(this, arguments);\r\n\t\t\tsetTimeout(observeAndInject, 100);\r\n\t\t};\r\n\r\n\t\twindow.addEventListener('popstate', function() {\r\n\t\t\tsetTimeout(observeAndInject, 100);\r\n\t\t});\r\n\t}\r\n\r\n\tif (document.readyState === 'loading') {\r\n\t\tdocument.addEventListener('DOMContentLoaded', function() {\r\n\t\t\tobserveAndInject();\r\n\t\t\thandleNavigation();\r\n\t\t});\r\n\t} else {\r\n\t\tobserveAndInject();\r\n\t\thandleNavigation();\r\n\t}\r\n\r\n\tsetTimeout(observeAndInject, 500);\r\n\tsetTimeout(observeAndInject, 1000);\r\n\r\n\tconsole.log('[OIDC Hook] Frontend customization loaded');\r\n})();\r\n`;\r\n}\r\n"},"id":"n8n/n8n-oidc-hooks","immutable":false,"metadata":[{"annotations":{},"generate_name":"","generation":0,"labels":{},"name":"n8n-oidc-hooks","namespace":"n8n","resource_version":"797","uid":"caa66dff-0539-4613-9826-0c2702e2d07b"}]},"sensitive_attributes":[],"private":"bnVsbA==","dependencies":["kubernetes_namespace.n8n"],"identity":{"api_version":"v1","kind":"ConfigMap","name":"n8n-oidc-hooks","namespace":"n8n"},"identity_schema_version":1}]},{"mode":"managed","type":"kubernetes_namespace","name":"ansible","provider":"provider[\"registry.opentofu.org/hashicorp/kubernetes\"]","instances":[{"schema_version":0,"attributes":{"id":"ansible","metadata":[{"annotations":{},"generate_name":"","generation":0,"labels":{},"name":"ansible","resource_version":"776","uid":"2b5f690f-7cc0-422d-89db-3c627bfdcced"}],"timeouts":null,"wait_for_default_service_account":false},"sensitive_attributes":[],"private":"eyJlMmJmYjczMC1lY2FhLTExZTYtOGY4OC0zNDM2M2JjN2M0YzAiOnsiZGVsZXRlIjozMDAwMDAwMDAwMDB9fQ==","identity":{"api_version":"v1","kind":"Namespace","name":"ansible"},"identity_schema_version":1}]},{"mode":"managed","type":"kubernetes_namespace","name":"argocd","provider":"provider[\"registry.opentofu.org/hashicorp/kubernetes\"]","instances":[{"schema_version":0,"attributes":{"id":"argocd","metadata":[{"annotations":{},"generate_name":"","generation":0,"labels":{},"name":"argocd","resource_version":"775","uid":"c340b863-9f9d-4762-9c87-0ba3ad668d0a"}],"timeouts":null,"wait_for_default_service_account":false},"sensitive_attributes":[],"private":"eyJlMmJmYjczMC1lY2FhLTExZTYtOGY4OC0zNDM2M2JjN2M0YzAiOnsiZGVsZXRlIjozMDAwMDAwMDAwMDB9fQ==","identity":{"api_version":"v1","kind":"Namespace","name":"argocd"},"identity_schema_version":1}]},{"mode":"managed","type":"kubernetes_namespac