{"version":4,"terraform_version":"1.12.5","serial":64,"lineage":"2eb2a68f-aff6-6eea-5b8c-5d0b6fe33403","outputs":{},"resources":[{"mode":"data","type":"kubernetes_secret","name":"homelab_ca","provider":"provider[\"registry.opentofu.org/hashicorp/kubernetes\"]","instances":[{"schema_version":0,"attributes":{"binary_data":null,"data":{"ca.crt":"-----BEGIN CERTIFICATE-----\nMIIBbTCCARSgAwIBAgIUSL7c/d4SUVU7zp6+b52MP0N2PsgwCgYIKoZIzj0EAwIw\nFTETMBEGA1UEAxMKaG9tZWxhYi1jYTAeFw0yNjA4MjcwMTA2NDVaFw0yNjExMjUw\nMTA2NDVaMBUxEzARBgNVBAMTCmhvbWVsYWItY2EwWTATBgcqhkjOPQIBBggqhkjO\nPQMBBwNCAATwnM6V9Tx90v/NvPtMbhVolZTS0CBJ31KPrDCqk2TkAzgDCuvv5Wqh\ninHsID2xFfKmSc1yUuLvCCRMeKrq8x1Zo0IwQDAOBgNVHQ8BAf8EBAMCAqQwDwYD\nVR0TAQH/BAUwAwEB/zAdBgNVHQ4EFgQULUBqUc30I+qxQtXe8dOV9f85oR0wCgYI\nKoZIzj0EAwIDRwAwRAIgFbTyuQ92jlq1pWmaxfXCfpYVfHhqUL1kwKg2FyzxyEkC\nIAPnX4WBxZZrEydBz2Z2jc08vWJ8j0uqkVaF/vzJZaxj\n-----END CERTIFICATE-----\n","tls.crt":"-----BEGIN CERTIFICATE-----\nMIIBbTCCARSgAwIBAgIUSL7c/d4SUVU7zp6+b52MP0N2PsgwCgYIKoZIzj0EAwIw\nFTETMBEGA1UEAxMKaG9tZWxhYi1jYTAeFw0yNjA4MjcwMTA2NDVaFw0yNjExMjUw\nMTA2NDVaMBUxEzARBgNVBAMTCmhvbWVsYWItY2EwWTATBgcqhkjOPQIBBggqhkjO\nPQMBBwNCAATwnM6V9Tx90v/NvPtMbhVolZTS0CBJ31KPrDCqk2TkAzgDCuvv5Wqh\ninHsID2xFfKmSc1yUuLvCCRMeKrq8x1Zo0IwQDAOBgNVHQ8BAf8EBAMCAqQwDwYD\nVR0TAQH/BAUwAwEB/zAdBgNVHQ4EFgQULUBqUc30I+qxQtXe8dOV9f85oR0wCgYI\nKoZIzj0EAwIDRwAwRAIgFbTyuQ92jlq1pWmaxfXCfpYVfHhqUL1kwKg2FyzxyEkC\nIAPnX4WBxZZrEydBz2Z2jc08vWJ8j0uqkVaF/vzJZaxj\n-----END CERTIFICATE-----\n","tls.key":"-----BEGIN EC PRIVATE KEY-----\nMHcCAQEEIGUtklBU2Am12xKUenWKr3ndthvE2PR+h7ANp2sxClp/oAoGCCqGSM49\nAwEHoUQDQgAE8JzOlfU8fdL/zbz7TG4VaJWU0tAgSd9Sj6wwqpNk5AM4Awrr7+Vq\noYpx7CA9sRXypknNclLi7wgkTHiq6vMdWQ==\n-----END EC PRIVATE KEY-----\n"},"id":"cert-manager/homelab-ca-secret","immutable":false,"metadata":[{"annotations":{"cert-manager.io/alt-names":"","cert-manager.io/certificate-name":"homelab-ca","cert-manager.io/common-name":"homelab-ca","cert-manager.io/ip-sans":"","cert-manager.io/issuer-group":"cert-manager.io","cert-manager.io/issuer-kind":"ClusterIssuer","cert-manager.io/issuer-name":"selfsigned-bootstrap","cert-manager.io/uri-sans":""},"generate_name":"","generation":0,"labels":{"controller.cert-manager.io/fao":"true"},"name":"homelab-ca-secret","namespace":"cert-manager","resource_version":"1821","uid":"21de79e6-d412-48de-aaac-b8c42cb03b86"}],"type":"kubernetes.io/tls"},"sensitive_attributes":[]}]},{"mode":"managed","type":"helm_release","name":"argocd","provider":"provider[\"registry.opentofu.org/hashicorp/helm\"]","instances":[{"schema_version":1,"attributes":{"atomic":false,"chart":"./../helm/argocd","cleanup_on_fail":false,"create_namespace":false,"dependency_update":true,"description":null,"devel":null,"disable_crd_hooks":false,"disable_openapi_validation":false,"disable_webhooks":false,"force_update":false,"id":"argocd","keyring":null,"lint":false,"manifest":null,"max_history":0,"metadata":[{"app_version":"","chart":"argocd","first_deployed":1787798862,"last_deployed":1787798862,"name":"argocd","namespace":"argocd","notes":"In order to access the server UI you have the following options:\n\n1. kubectl port-forward service/argocd-server -n argocd 8080:443\n\n    and then open the browser on http://localhost:8080 and accept the certificate\n\n2. enable ingress in the values file `server.ingress.enabled` and either\n      - Add the annotation for ssl passthrough: https://argo-cd.readthedocs.io/en/stable/operator-manual/ingress/#option-1-ssl-passthrough\n      - Set the `configs.params.\"server.insecure\"` in the values file and terminate SSL at your ingress: https://argo-cd.readthedocs.io/en/stable/operator-manual/ingress/#option-2-multiple-ingress-objects-and-hosts\n\n\nAfter reaching the UI the first time you can login with username: admin and the random password generated during the installation. You can find the password by running:\n\nkubectl -n argocd get secret argocd-initial-admin-secret -o jsonpath=\"{.data.password}\" | base64 -d\n\n(You should delete the initial secret afterwards as suggested by the Getting Started Guide: https://argo-cd.readthedocs.io/en/stable/getting_started/#4-login-using-the-cli)\n","revision":1,"values":"{\"argo-cd\":{\"applicationSet\":{\"resources\":{\"limits\":{\"memory\":\"128Mi\"},\"requests\":{\"cpu\":\"10m\",\"memory\":\"64Mi\"}}},\"configs\":{\"cm\":{\"oidc.config\":\"name: Authentik\\nissuer: https://desktop-qv5aogf.tail60240b.ts.net:8443/application/o/argocd/\\nclientID: dev-argocd-oidc-client-id\\nclientSecret: dev-argocd-oidc-client-secret-not-for-prod-use\\nrequestedScopes:\\n  - openid\\n  - profile\\n  - email\\n\",\"url\":\"https://desktop-qv5aogf.tail60240b.ts.net:8450\"},\"params\":{\"server.insecure\":true},\"rbac\":{\"policy.csv\":\"g, edwardlimkoksiong1994@gmail.com, role:admin\\n\",\"policy.default\":\"role:readonly\",\"scopes\":\"[email]\"}},\"controller\":{\"resources\":{\"limits\":{\"memory\":\"512Mi\"},\"requests\":{\"cpu\":\"50m\",\"memory\":\"256Mi\"}}},\"dex\":{\"enabled\":false},\"notifications\":{\"enabled\":false},\"redis\":{\"resources\":{\"limits\":{\"memory\":\"128Mi\"},\"requests\":{\"cpu\":\"10m\",\"memory\":\"64Mi\"}}},\"repoServer\":{\"resources\":{\"limits\":{\"memory\":\"256Mi\"},\"requests\":{\"cpu\":\"50m\",\"memory\":\"128Mi\"}}},\"server\":{\"ingress\":{\"annotations\":{\"cert-manager.io/cluster-issuer\":\"homelab-ca-issuer\"},\"enabled\":true,\"hosts\":[\"argocd.local\"],\"ingressClassName\":\"traefik\",\"tls\":[{\"hosts\":[\"argocd.local\"],\"secretName\":\"argocd.local-tls\"}]},\"resources\":{\"limits\":{\"memory\":\"256Mi\"},\"requests\":{\"cpu\":\"50m\",\"memory\":\"128Mi\"}}}}}","version":"0.1.0"}],"name":"argocd","namespace":"argocd","pass_credentials":false,"postrender":[],"recreate_pods":false,"render_subchart_notes":true,"replace":false,"repository":null,"repository_ca_file":null,"repository_cert_file":null,"repository_key_file":null,"repository_password":null,"repository_username":null,"reset_values":false,"reuse_values":false,"set":[],"set_list":[],"set_sensitive":[],"skip_crds":false,"status":"deployed","timeout":600,"upgrade_install":null,"values":["argo-cd:\n  # ponytail: Dex is an OIDC proxy that ArgoCD bundles for providers that\n  # don't support OIDC natively. Authentik speaks OIDC directly, so Dex is\n  # dead weight here.\n  dex:\n    enabled: false\n\n  # ponytail: notifications controller is off — no alerting infra in this\n  # homelab. Enable when you wire up Slack/email webhooks.\n  notifications:\n    enabled: false\n\n  server:\n    # ponytail: Traefik terminates TLS at the ingress; ArgoCD server runs\n    # plain HTTP internally. Without --insecure the server redirects to its\n    # own HTTPS port which Traefik never sends traffic to.\n    ingress:\n      enabled: true\n      ingressClassName: traefik\n      annotations:\n        cert-manager.io/cluster-issuer: homelab-ca-issuer\n      hosts:\n        - argocd.local\n      tls:\n        - secretName: argocd.local-tls\n          hosts:\n            - argocd.local\n    resources:\n      requests:\n        cpu: 50m\n        memory: 128Mi\n      limits:\n        memory: 256Mi\n\n  controller:\n    resources:\n      requests:\n        cpu: 50m\n        memory: 256Mi\n      limits:\n        memory: 512Mi\n\n  repoServer:\n    resources:\n      requests:\n        cpu: 50m\n        memory: 128Mi\n      limits:\n        memory: 256Mi\n\n  applicationSet:\n    resources:\n      requests:\n        cpu: 10m\n        memory: 64Mi\n      limits:\n        memory: 128Mi\n\n  redis:\n    resources:\n      requests:\n        cpu: 10m\n        memory: 64Mi\n      limits:\n        memory: 128Mi\n\n  configs:\n    params:\n      # ponytail: run HTTP internally; Traefik ingress handles TLS termination\n      server.insecure: true\n\n    cm:\n      # ponytail: url must match the external Tailscale URL — ArgoCD embeds\n      # it in the OIDC redirect_uri sent to Authentik. Wrong url = callback\n      # mismatch error after login.\n      url: \"https://desktop-qv5aogf.tail60240b.ts.net:8450\"\n      # ponytail: oidc.config drives ArgoCD's built-in OIDC client (no Dex).\n      # clientSecret is plain text here (ConfigMap, not Secret) because helm\n      # template base64-encodes Secret values before rendered.replace() runs —\n      # the placeholder would never match. Homelab trade-off: acceptable.\n      oidc.config: |\n        name: Authentik\n        issuer: https://desktop-qv5aogf.tail60240b.ts.net:8443/application/o/argocd/\n        clientID: dev-argocd-oidc-client-id\n        clientSecret: dev-argocd-oidc-client-secret-not-for-prod-use\n        requestedScopes:\n          - openid\n          - profile\n          - email\n\n    rbac:\n      # ponytail: scopes tells ArgoCD which OIDC token claims to use as group\n      # subjects for RBAC matching. '[email]' means policy.csv entries like\n      # \"g, user@example.com, role:admin\" match against the email claim.\n      scopes: '[email]'\n      policy.default: role:readonly\n      policy.csv: |\n        g, edwardlimkoksiong1994@gmail.com, role:admin\n"],"verify":false,"version":"0.1.0","wait":true,"wait_for_jobs":false},"sensitive_attributes":[[{"type":"get_attr","value":"repository_password"}],[{"type":"get_attr","value":"values"},{"type":"index","value":{"value":0,"type":"number"}}]],"private":"eyJzY2hlbWFfdmVyc2lvbiI6IjEifQ==","dependencies":["kubernetes_namespace.argocd"]}]},{"mode":"managed","type":"helm_release","name":"authentik","provider":"provider[\"registry.opentofu.org/hashicorp/helm\"]","instances":[{"schema_version":1,"attributes":{"atomic":false,"chart":"./../helm/authentik","cleanup_on_fail":false,"create_namespace":false,"dependency_update":true,"description":null,"devel":null,"disable_crd_hooks":false,"disable_openapi_validation":false,"disable_webhooks":false,"force_update":false,"id":"authentik","keyring":null,"lint":false,"manifest":null,"max_history":0,"metadata":[{"app_version":"","chart":"authentik","first_deployed":1787792805,"last_deployed":1787805987,"name":"authentik","namespace":"authentik","notes":"Run the commands below to get a kubeconfig file for authentik:\n\nKUBE_API=$(kubectl config view --minify --output jsonpath=\"{.clusters[*].cluster.server}\")\nNAMESPACE=authentik\nSECRET_NAME=$(kubectl get serviceaccount authentik -o jsonpath='{.secrets[0].name}' 2\u003e/dev/null || echo -n \"authentik\")\nKUBE_CA=$(kubectl -n $NAMESPACE get secret/$SECRET_NAME -o jsonpath='{.data.ca\\.crt}')\nKUBE_TOKEN=$(kubectl -n $NAMESPACE get secret/$SECRET_NAME -o jsonpath='{.data.token}' | base64 --decode)\n\necho \"apiVersion: v1\nkind: Config\nclusters:\n- name: default-cluster\n  cluster:\n    certificate-authority-data: ${KUBE_CA}\n    server: ${KUBE_API}\ncontexts:\n- name: default-context\n  context:\n    cluster: default-cluster\n    namespace: $NAMESPACE\n    user: authentik-user\ncurrent-context: default-context\nusers:\n- name: authentik-user\n  user:\n    token: ${KUBE_TOKEN}\"\n\nCHART NAME: redis\nCHART VERSION: 20.2.1\nAPP VERSION: 7.4.1\n\n** Please be patient while the chart is being deployed **\n\nRedis\u0026reg; can be accessed via port 6379 on the following DNS name from within your cluster:\n\n    authentik-redis-master.authentik.svc.cluster.local\n\n\n\nTo connect to your Redis\u0026reg; server:\n\n1. Run a Redis\u0026reg; pod that you can use as a client:\n\n   kubectl run --namespace authentik redis-client --restart='Never'  --image docker.io/bitnamilegacy/redis:7.4.1-debian-12-r0 --command -- sleep infinity\n\n   Use the following command to attach to the pod:\n\n   kubectl exec --tty -i redis-client \\\n   --namespace authentik -- bash\n\n2. Connect using the Redis\u0026reg; CLI:\n   redis-cli -h authentik-redis-master\n\nTo connect to your database from outside the cluster execute the following commands:\n\n    kubectl port-forward --namespace authentik svc/authentik-redis-master 6379:6379 \u0026\n    redis-cli -h 127.0.0.1 -p 6379\n\nWARNING: There are \"resources\" sections in the chart not set. Using \"resourcesPreset\" is not recommended for production. For production installations, please set the following values according to your workload needs:\n  - replica.resources\n+info https://kubernetes.io/docs/concepts/configuration/manage-resources-containers/\n\n⚠ SECURITY WARNING: Original containers have been substituted. This Helm chart was designed, tested, and validated on multiple platforms using a specific set of Bitnami and Tanzu Application Catalog containers. Substituting other containers is likely to cause degraded security and performance, broken chart features, and missing environment variables.\n\nSubstituted images detected:\n  - docker.io/bitnamilegacy/redis:7.4.1-debian-12-r0\nCHART NAME: postgresql\nCHART VERSION: 16.0.4\nAPP VERSION: 17.0.0\n\n** Please be patient while the chart is being deployed **\n\nPostgreSQL can be accessed via port 5432 on the following DNS names from within your cluster:\n\n    authentik-postgresql.authentik.svc.cluster.local - Read/Write connection\n\nTo get the password for \"postgres\" run:\n\n    export POSTGRES_ADMIN_PASSWORD=$(kubectl get secret --namespace authentik authentik-postgresql -o jsonpath=\"{.data.postgres-password}\" | base64 -d)\n\nTo get the password for \"authentik\" run:\n\n    export POSTGRES_PASSWORD=$(kubectl get secret --namespace authentik authentik-postgresql -o jsonpath=\"{.data.password}\" | base64 -d)\n\nTo connect to your database run the following command:\n\n    kubectl run authentik-postgresql-client --rm --tty -i --restart='Never' --namespace authentik --image docker.io/bitnamilegacy/postgresql:15.8.0-debian-12-r18 --env=\"PGPASSWORD=$POSTGRES_PASSWORD\" \\\n      --command -- psql --host authentik-postgresql -U authentik -d authentik -p 5432\n\n    \u003e NOTE: If you access the container using bash, make sure that you execute \"/opt/bitnami/scripts/postgresql/entrypoint.sh /bin/bash\" in order to avoid the error \"psql: local user with ID 1001} does not exist\"\n\nTo connect to your database from outside the cluster execute the following commands:\n\n    kubectl port-forward --namespace authentik svc/authentik-postgresql 5432:5432 \u0026\n    PGPASSWORD=\"$POSTGRES_PASSWORD\" psql --host 127.0.0.1 -U authentik -d authentik -p 5432\n\nWARNING: The configured password will be ignored on new installation in case when previous PostgreSQL release was deleted through the helm command. In that case, old PVC will have an old password, and setting it through helm won't take effect. Deleting persistent volumes (PVs) will solve the issue.\n\nWARNING: There are \"resources\" sections in the chart not set. Using \"resourcesPreset\" is not recommended for production. For production installations, please set the following values according to your workload needs:\n  - readReplicas.resources\n+info https://kubernetes.io/docs/concepts/configuration/manage-resources-containers/\n\n⚠ SECURITY WARNING: Original containers have been substituted. This Helm chart was designed, tested, and validated on multiple platforms using a specific set of Bitnami and Tanzu Application Catalog containers. Substituting other containers is likely to cause degraded security and performance, broken chart features, and missing environment variables.\n\nSubstituted images detected:\n  - docker.io/bitnamilegacy/postgresql:15.8.0-debian-12-r18","revision":2,"values":"{\"authentik\":{\"authentik\":{\"log_level\":\"info\",\"postgresql\":{\"host\":\"authentik-postgresql\",\"password\":\"(sensitive value)\"},\"secret_key\":\"(sensitive value)\"},\"global\":{\"env\":[{\"name\":\"AUTHENTIK_BOOTSTRAP_TOKEN\",\"value\":\"dev-authentik-bootstrap-token-not-for-prod-use\"},{\"name\":\"AUTHENTIK_BOOTSTRAP_PASSWORD\",\"value\":\"Admin1234!\"},{\"name\":\"AUTHENTIK_BOOTSTRAP_EMAIL\",\"value\":\"akadmin@authentik.local\"},{\"name\":\"GITHUB_OAUTH_CLIENT_ID\",\"value\":\"Ov23li7sHVJbV4ziaPII\"},{\"name\":\"GITHUB_OAUTH_CLIENT_SECRET\",\"value\":\"af73a65d4f17db2a356b47dd2faee77dbcabcaf1\"}]},\"postgresql\":{\"auth\":{\"password\":\"(sensitive value)\"},\"enabled\":true,\"image\":{\"repository\":\"bitnamilegacy/postgresql\"},\"primary\":{\"resources\":{\"limits\":{\"memory\":\"512Mi\"},\"requests\":{\"cpu\":\"50m\",\"memory\":\"256Mi\"}}}},\"redis\":{\"enabled\":true,\"image\":{\"repository\":\"bitnamilegacy/redis\"},\"master\":{\"resources\":{\"limits\":{\"memory\":\"128Mi\"},\"requests\":{\"cpu\":\"25m\",\"memory\":\"64Mi\"}}}},\"server\":{\"ingress\":{\"annotations\":{\"cert-manager.io/cluster-issuer\":\"homelab-ca-issuer\"},\"enabled\":true,\"hosts\":[\"authentik.local\"],\"ingressClassName\":\"traefik\",\"tls\":[{\"hosts\":[\"authentik.local\"],\"secretName\":\"authentik-tls\"}]},\"replicas\":1,\"resources\":{\"limits\":{\"memory\":\"1Gi\"},\"requests\":{\"cpu\":\"100m\",\"memory\":\"512Mi\"}}},\"worker\":{\"replicas\":1,\"resources\":{\"limits\":{\"memory\":\"1Gi\"},\"requests\":{\"cpu\":\"50m\",\"memory\":\"512Mi\"}}}}}","version":"0.1.0"}],"name":"authentik","namespace":"authentik","pass_credentials":false,"postrender":[],"recreate_pods":false,"render_subchart_notes":true,"replace":false,"repository":null,"repository_ca_file":null,"repository_cert_file":null,"repository_key_file":null,"repository_password":null,"repository_username":null,"reset_values":false,"reuse_values":false,"set":[{"name":"authentik.global.env[0].name","type":"","value":"AUTHENTIK_BOOTSTRAP_TOKEN"},{"name":"authentik.global.env[1].name","type":"","value":"AUTHENTIK_BOOTSTRAP_PASSWORD"},{"name":"authentik.global.env[2].name","type":"","value":"AUTHENTIK_BOOTSTRAP_EMAIL"},{"name":"authentik.global.env[2].value","type":"","value":"akadmin@authentik.local"},{"name":"authentik.global.env[3].name","type":"","value":"GITHUB_OAUTH_CLIENT_ID"},{"name":"authentik.global.env[4].name","type":"","value":"GITHUB_OAUTH_CLIENT_SECRET"}],"set_list":[],"set_sensitive":[{"name":"authentik.authentik.postgresql.password","type":"","value":"dev-authentik-db-password"},{"name":"authentik.authentik.secret_key","type":"","value":"dev-authentik-secret-key-not-for-prod-use"},{"name":"authentik.global.env[0].value","type":"","value":"dev-authentik-bootstrap-token-not-for-prod-use"},{"name":"authentik.global.env[1].value","type":"","value":"Admin1234!"},{"name":"authentik.global.env[3].value","type":"","value":"Ov23li7sHVJbV4ziaPII"},{"name":"authentik.global.env[4].value","type":"","value":"af73a65d4f17db2a356b47dd2faee77dbcabcaf1"},{"name":"authentik.postgresql.auth.password","type":"","value":"dev-authentik-db-password"}],"skip_crds":false,"status":"deployed","timeout":300,"upgrade_install":null,"values":["authentik:\r\n  authentik:\r\n    secret_key: \"\"  # set via terraform variable\r\n    log_level: info\r\n    postgresql:\r\n      host: \"authentik-postgresql\"\r\n      password: \"\"  # set via terraform variable\r\n\r\n  postgresql:\r\n    enabled: true\r\n    # ponytail: bitnami moved old image tags to bitnamilegacy on docker.io, upgrade image.tag when bumping chart\r\n    image:\r\n      repository: bitnamilegacy/postgresql\r\n    auth:\r\n      password: \"\"  # set via terraform variable\r\n    primary:\r\n      resources:\r\n        requests:\r\n          cpu: 50m\r\n          memory: 256Mi\r\n        limits:\r\n          memory: 512Mi\r\n\r\n  redis:\r\n    enabled: true\r\n    image:\r\n      repository: bitnamilegacy/redis\r\n    master:\r\n      resources:\r\n        requests:\r\n          cpu: 25m\r\n          memory: 64Mi\r\n        limits:\r\n          memory: 128Mi\r\n\r\n  server:\r\n    replicas: 1\r\n    resources:\r\n      requests:\r\n        cpu: 100m\r\n        memory: 512Mi\r\n      limits:\r\n        memory: 1Gi\r\n    ingress:\r\n      enabled: true\r\n      ingressClassName: traefik\r\n      annotations:\r\n        cert-manager.io/cluster-issuer: homelab-ca-issuer\r\n      hosts:\r\n        - authentik.local\r\n      tls:\r\n        - secretName: authentik-tls\r\n          hosts:\r\n            - authentik.local\r\n\r\n  worker:\r\n    replicas: 1\r\n    resources:\r\n      requests:\r\n        cpu: 50m\r\n        memory: 512Mi\r\n      limits:\r\n        memory: 1Gi\r\n"],"verify":false,"version":"0.1.0","wait":true,"wait_for_jobs":false},"sensitive_attributes":[[{"type":"get_attr","value":"repository_password"}],[{"type":"get_attr","value":"set_sensitive"}]],"private":"eyJzY2hlbWFfdmVyc2lvbiI6IjEifQ==","dependencies":["helm_release.cert_manager","kubectl_manifest.homelab_ca","kubectl_manifest.homelab_ca_issuer","kubectl_manifest.selfsigned_bootstrap","kubernetes_namespace.authentik","kubernetes_namespace.cert_manager"]}]},{"mode":"managed","type":"helm_release","name":"cert_manager","provider":"provider[\"registry.opentofu.org/hashicorp/helm\"]","instances":[{"schema_version":1,"attributes":{"atomic":false,"chart":"./../helm/cert-manager","cleanup_on_fail":false,"create_namespace":false,"dependency_update":true,"description":null,"devel":null,"disable_crd_hooks":false,"disable_openapi_validation":false,"disable_webhooks":false,"force_update":false,"id":"cert-manager","keyring":null,"lint":false,"manifest":null,"max_history":0,"metadata":[{"app_version":"","chart":"cert-manager","first_deployed":1787792562,"last_deployed":1787792562,"name":"cert-manager","namespace":"cert-manager","notes":"\ncert-manager v1.21.1 has been deployed successfully!\n\nIn order to begin issuing certificates, you will need to set up a ClusterIssuer\nor Issuer resource (for example, by creating a 'letsencrypt-staging' issuer).\n\nMore information on the different types of issuers and how to configure them\ncan be found in our documentation:\n\nhttps://cert-manager.io/docs/configuration/\n\nFor information on how to configure cert-manager to automatically provision\nCertificates for Ingress resources, take a look at the `ingress-shim`\ndocumentation:\n\nhttps://cert-manager.io/docs/usage/ingress/\n\nFor information on how to configure cert-manager to automatically provision\nCertificates for Gateway API resources, take a look at the `gateway resource`\ndocumentation:\n\nhttps://cert-manager.io/docs/usage/gateway/\n","revision":1,"values":"{\"cert-manager\":{\"cainjector\":{\"resources\":{\"limits\":{\"memory\":\"128Mi\"},\"requests\":{\"cpu\":\"25m\",\"memory\":\"64Mi\"}}},\"crds\":{\"enabled\":true},\"resources\":{\"limits\":{\"memory\":\"128Mi\"},\"requests\":{\"cpu\":\"25m\",\"memory\":\"64Mi\"}},\"webhook\":{\"resources\":{\"limits\":{\"memory\":\"64Mi\"},\"requests\":{\"cpu\":\"25m\",\"memory\":\"32Mi\"}}}}}","version":"0.1.0"}],"name":"cert-manager","namespace":"cert-manager","pass_credentials":false,"postrender":[],"recreate_pods":false,"render_subchart_notes":true,"replace":false,"repository":null,"repository_ca_file":null,"repository_cert_file":null,"repository_key_file":null,"repository_password":null,"repository_username":null,"reset_values":false,"reuse_values":false,"set":[],"set_list":[],"set_sensitive":[],"skip_crds":false,"status":"deployed","timeout":300,"upgrade_install":null,"values":["cert-manager:\r\n  crds:\r\n    enabled: true\r\n  resources:\r\n    requests:\r\n      cpu: 25m\r\n      memory: 64Mi\r\n    limits:\r\n      memory: 128Mi\r\n  webhook:\r\n    resources:\r\n      requests:\r\n        cpu: 25m\r\n        memory: 32Mi\r\n      limits:\r\n        memory: 64Mi\r\n  cainjector:\r\n    resources:\r\n      requests:\r\n        cpu: 25m\r\n        memory: 64Mi\r\n      limits:\r\n        memory: 128Mi\r\n"],"verify":false,"version":"0.1.0","wait":true,"wait_for_jobs":false},"sensitive_attributes":[[{"type":"get_attr","value":"repository_password"}]],"private":"eyJzY2hlbWFfdmVyc2lvbiI6IjEifQ==","dependencies":["kubernetes_namespace.cert_manager"]}]},{"mode":"managed","type":"helm_release","name":"gitlab","provider":"provider[\"registry.opentofu.org/hashicorp/helm\"]","instances":[{"schema_version":1,"attributes":{"atomic":false,"chart":"./../helm/gitlab","cleanup_on_fail":false,"create_namespace":false,"dependency_update":true,"description":null,"devel":null,"disable_crd_hooks":false,"disable_openapi_validation":false,"disable_webhooks":false,"force_update":false,"id":"gitlab","keyring":null,"lint":false,"manifest":null,"max_history":0,"metadata":[{"app_version":"","chart":"gitlab","first_deployed":1787792806,"last_deployed":1787792806,"name":"gitlab","namespace":"gitlab","notes":"CHART NAME: redis\nCHART VERSION: 16.13.2\nAPP VERSION: 6.2.7\n\n** Please be patient while the chart is being deployed **\n\nRedis\u0026reg; can be accessed via port 6379 on the following DNS name from within your cluster:\n\n    gitlab-redis-master.gitlab.svc.cluster.local\n\n\n\nTo get your password run:\n\n    export REDIS_PASSWORD=$(kubectl get secret --namespace gitlab \"gitlab-redis-secret\" -o jsonpath=\"{.data.redis-password}\" | base64 -d)\n\nTo connect to your Redis\u0026reg; server:\n\n1. Run a Redis\u0026reg; pod that you can use as a client:\n\n   kubectl run --namespace gitlab redis-client --restart='Never'  --env REDIS_PASSWORD=$REDIS_PASSWORD  --image docker.io/bitnamilegacy/redis:6.2.16-debian-12-r3 --command -- sleep infinity\n\n   Use the following command to attach to the pod:\n\n   kubectl exec --tty -i redis-client \\\n   --namespace gitlab -- bash\n\n2. Connect using the Redis\u0026reg; CLI:\n   REDISCLI_AUTH=\"$REDIS_PASSWORD\" redis-cli -h gitlab-redis-master\n\nTo connect to your database from outside the cluster execute the following commands:\n\n    kubectl port-forward --namespace gitlab svc/gitlab-redis-master 6379:6379 \u0026\n    REDISCLI_AUTH=\"$REDIS_PASSWORD\" redis-cli -h 127.0.0.1 -p 6379\n\n\nMinio not enabled: `enabled: `. Please set to `true` to use Minio\n\nCHART NAME: postgresql\nCHART VERSION: 12.5.2\nAPP VERSION: 15.3.0\n\n** Please be patient while the chart is being deployed **\n\nPostgreSQL can be accessed via port 5432 on the following DNS names from within your cluster:\n\n    gitlab-postgresql.gitlab.svc.cluster.local - Read/Write connection\n\nTo get the password for \"postgres\" run:\n\n    export POSTGRES_ADMIN_PASSWORD=$(kubectl get secret --namespace gitlab \"gitlab-postgresql-password\" -o jsonpath=\"{.data.postgresql-postgres-password}\" | base64 -d)\n\nTo get the password for \"gitlab\" run:\n\n    export POSTGRES_PASSWORD=$(kubectl get secret --namespace gitlab \"gitlab-postgresql-password\" -o jsonpath=\"{.data.\"postgresql-password\"}\" | base64 -d)\n\nTo connect to your database run the following command:\n\n    kubectl run gitlab-postgresql-client --rm --tty -i --restart='Never' --namespace gitlab --image docker.io/bitnamilegacy/postgresql:14.8.0 --env=\"PGPASSWORD=$POSTGRES_PASSWORD\" \\\n      --command -- psql --host gitlab-postgresql -U gitlab -d gitlabhq_production -p 5432\n\n    \u003e NOTE: If you access the container using bash, make sure that you execute \"/opt/bitnami/scripts/postgresql/entrypoint.sh /bin/bash\" in order to avoid the error \"psql: local user with ID 1001} does not exist\"\n\nTo connect to your database from outside the cluster execute the following commands:\n\n    kubectl port-forward --namespace gitlab svc/gitlab-postgresql 5432:5432 \u0026\n    PGPASSWORD=\"$POSTGRES_PASSWORD\" psql --host 127.0.0.1 -U gitlab -d gitlabhq_production -p 5432\n\nWARNING: The configured password will be ignored on new installation in case when previous Posgresql release was deleted through the helm command. In that case, old PVC will have an old password, and setting it through helm won't take effect. Deleting persistent volumes (PVs) will solve the issue.\n\n\n\n=== CRITICAL\nThe following charts are included for evaluation purposes only. They will not be supported by GitLab Support\nfor production workloads. Use Cloud Native Hybrid deployments for production. For more information visit\nhttps://docs.gitlab.com/charts/installation/index.html#use-the-reference-architectures.\n- PostgreSQL\n- Redis\n- Gitaly\n\n=== NOTICE\nThe minimum required version of PostgreSQL is now 14. See https://docs.gitlab.com/charts/installation/upgrade.html for more details.\nHelp us improve the installation experience, let us know how we did with a 1 minute survey:https://gitlab.fra1.qualtrics.com/jfe/form/SV_6kVqZANThUQ1bZb?installation=helm\u0026release=17-5\n\n\n\n\n","revision":1,"values":"{\"gitlab\":{\"certmanager\":{\"install\":false},\"certmanager-issuer\":{\"email\":\"edwardlimkoksiong1994@gmail.com\"},\"gitlab\":{\"gitaly\":{\"resources\":{\"limits\":{\"memory\":\"512Mi\"},\"requests\":{\"cpu\":\"50m\",\"memory\":\"256Mi\"}}},\"gitlab-shell\":{\"maxReplicas\":1,\"minReplicas\":1},\"sidekiq\":{\"maxReplicas\":1,\"minReplicas\":1,\"resources\":{\"limits\":{\"memory\":\"1Gi\"},\"requests\":{\"cpu\":\"50m\",\"memory\":\"512Mi\"}}},\"toolbox\":{\"enabled\":false},\"webservice\":{\"maxReplicas\":1,\"minReplicas\":1,\"resources\":{\"limits\":{\"memory\":\"2Gi\"},\"requests\":{\"cpu\":\"100m\",\"memory\":\"1Gi\"}}}},\"gitlab-runner\":{\"install\":false},\"global\":{\"appConfig\":{\"artifacts\":{\"bucket\":\"gitlab-artifacts\",\"enabled\":true},\"backups\":{\"bucket\":\"gitlab-backups\"},\"ciSecureFiles\":{\"bucket\":\"gitlab-ci-secure-files\",\"enabled\":true},\"dependencyProxy\":{\"bucket\":\"gitlab-dependency-proxy\",\"enabled\":true},\"externalDiffs\":{\"bucket\":\"gitlab-mr-diffs\",\"enabled\":true},\"lfs\":{\"bucket\":\"git-lfs\",\"enabled\":true},\"object_store\":{\"enabled\":true},\"omniauth\":{\"allowSingleSignOn\":[\"openid_connect\"],\"autoSignInWithProvider\":\"openid_connect\",\"blockAutoCreatedUsers\":false,\"enabled\":true,\"providers\":[{\"key\":\"provider\",\"secret\":\"gitlab-omniauth-authentik\"}]},\"packages\":{\"bucket\":\"gitlab-packages\",\"enabled\":true},\"terraformState\":{\"bucket\":\"gitlab-terraform-state\",\"enabled\":true},\"uploads\":{\"bucket\":\"gitlab-uploads\",\"enabled\":true}},\"edition\":\"ce\",\"hosts\":{\"domain\":\"gitlab.local\",\"gitlab\":{\"name\":\"gitlab.local\"}},\"hpa\":{\"apiVersion\":\"autoscaling/v2\"},\"ingress\":{\"annotations\":{\"cert-manager.io/cluster-issuer\":\"homelab-ca-issuer\"},\"apiVersion\":\"networking.k8s.io/v1\",\"class\":\"traefik\",\"configureCertmanager\":false,\"enabled\":true,\"provider\":\"traefik\",\"tls\":{\"enabled\":true,\"secretName\":\"gitlab-tls\"}},\"initialRootPassword\":{\"secret\":\"gitlab-initial-root-password\"},\"kas\":{\"enabled\":false},\"minio\":{\"enabled\":false},\"pdb\":{\"apiVersion\":\"policy/v1\"},\"traefik\":{\"apiVersion\":\"traefik.io/v1alpha1\"}},\"grafana\":{\"enabled\":false},\"nginx-ingress\":{\"enabled\":false},\"postgresql\":{\"auth\":{\"password\":\"(sensitive value)\"},\"image\":{\"repository\":\"bitnamilegacy/postgresql\"},\"install\":true,\"metrics\":{\"image\":{\"repository\":\"bitnamilegacy/postgres-exporter\"}},\"primary\":{\"resources\":{\"limits\":{\"memory\":\"512Mi\"},\"requests\":{\"cpu\":\"50m\",\"memory\":\"256Mi\"}}}},\"prometheus\":{\"install\":false},\"redis\":{\"image\":{\"repository\":\"bitnamilegacy/redis\",\"tag\":\"6.2.16-debian-12-r3\"},\"install\":true,\"master\":{\"resources\":{\"limits\":{\"memory\":\"128Mi\"},\"requests\":{\"cpu\":\"25m\",\"memory\":\"64Mi\"}}},\"metrics\":{\"image\":{\"repository\":\"bitnamilegacy/redis-exporter\",\"tag\":\"1.76.0-debian-12-r0\"}}},\"registry\":{\"enabled\":false}}}","version":"0.1.0"}],"name":"gitlab","namespace":"gitlab","pass_credentials":false,"postrender":[],"recreate_pods":false,"render_subchart_notes":true,"replace":false,"repository":null,"repository_ca_file":null,"repository_cert_file":null,"repository_key_file":null,"repository_password":null,"repository_username":null,"reset_values":false,"reuse_values":false,"set":[{"name":"gitlab.certmanager-issuer.email","type":"","value":"edwardlimkoksiong1994@gmail.com"},{"name":"gitlab.global.appConfig.omniauth.allowSingleSignOn[0]","type":"","value":"openid_connect"},{"name":"gitlab.global.appConfig.omniauth.autoSignInWithProvider","type":"","value":"openid_connect"},{"name":"gitlab.global.appConfig.omniauth.blockAutoCreatedUsers","type":"","value":"false"},{"name":"gitlab.global.appConfig.omniauth.enabled","type":"","value":"true"},{"name":"gitlab.global.appConfig.omniauth.providers[0].key","type":"","value":"provider"},{"name":"gitlab.global.appConfig.omniauth.providers[0].secret","type":"","value":"gitlab-omniauth-authentik"},{"name":"gitlab.global.initialRootPassword.secret","type":"","value":"gitlab-initial-root-password"}],"set_list":[],"set_sensitive":[{"name":"gitlab.postgresql.auth.password","type":"","value":"dev-gitlab-db-password"}],"skip_crds":false,"status":"deployed","timeout":600,"upgrade_install":null,"values":["gitlab:\r\n  global:\r\n    edition: ce\r\n    hosts:\r\n      domain: gitlab.local\r\n      # ponytail: without this, hostname defaults to \"gitlab.\u003cdomain\u003e\" i.e.\r\n      # gitlab.gitlab.local (domain already includes \"gitlab\")\r\n      gitlab:\r\n        name: gitlab.local\r\n    initialRootPassword:\r\n      secret: \"\"  # set via terraform\r\n    ingress:\r\n      enabled: true\r\n      # ponytail: helm template has no live cluster to auto-detect API\r\n      # versions from; same class of issue as the pdb/hpa overrides above\r\n      apiVersion: networking.k8s.io/v1\r\n      provider: traefik\r\n      class: traefik\r\n      annotations:\r\n        cert-manager.io/cluster-issuer: homelab-ca-issuer\r\n      tls:\r\n        enabled: true\r\n        secretName: gitlab-tls\r\n      # ponytail: defaults true independent of ingress.enabled, keeps\r\n      # spawning a cert-manager issuer job; we manage our own ClusterIssuer\r\n      configureCertmanager: false\r\n    # ponytail: backed by the standalone minio app (helm/minio), not the\r\n    # gitlab chart's own bundled minio subchart (global.minio stays\r\n    # disabled below) — connection secret wired in gitlab/Tiltfile.\r\n    # Per-feature blocks below must leave `connection` empty and only set\r\n    # `bucket` for the chart to treat object_store.connection as the\r\n    # consolidated one they all inherit (see charts/gitlab/_objectStorage.tpl).\r\n    appConfig:\r\n      object_store:\r\n        enabled: true\r\n      lfs:\r\n        enabled: true\r\n        bucket: git-lfs\r\n      artifacts:\r\n        enabled: true\r\n        bucket: gitlab-artifacts\r\n      uploads:\r\n        enabled: true\r\n        bucket: gitlab-uploads\r\n      packages:\r\n        enabled: true\r\n        bucket: gitlab-packages\r\n      externalDiffs:\r\n        enabled: true\r\n        bucket: gitlab-mr-diffs\r\n      dependencyProxy:\r\n        enabled: true\r\n        bucket: gitlab-dependency-proxy\r\n      terraformState:\r\n        enabled: true\r\n        bucket: gitlab-terraform-state\r\n      ciSecureFiles:\r\n        enabled: true\r\n        bucket: gitlab-ci-secure-files\r\n      backups:\r\n        bucket: gitlab-backups\r\n    minio:\r\n      enabled: false\r\n    kas:\r\n      enabled: false\r\n    # ponytail: Tilt's helm() runs `helm template` with no cluster connection,\r\n    # so Capabilities-based API auto-detection can't run and falls back to the\r\n    # long-removed policy/v1beta1 PDB kind. Pin explicitly.\r\n    pdb:\r\n      apiVersion: policy/v1\r\n    hpa:\r\n      apiVersion: autoscaling/v2\r\n    # ponytail: gitlab-shell's SSH IngressRouteTCP only renders once\r\n    # ingress.provider is traefik; same live-cluster-detection gap as above,\r\n    # this cluster's Traefik (v3) only registers the newer traefik.io group\r\n    traefik:\r\n      apiVersion: traefik.io/v1alpha1\r\n\r\n  # disable non-essential components\r\n  registry:\r\n    enabled: false\r\n  certmanager:\r\n    install: false\r\n  nginx-ingress:\r\n    enabled: false\r\n  # ponytail: no ingress means no external hostname for the runner to register\r\n  # against (dial fails on gitlab.gitlab.local); CI isn't needed for dev testing\r\n  gitlab-runner:\r\n    install: false\r\n  prometheus:\r\n    install: false\r\n  grafana:\r\n    enabled: false\r\n  gitlab:\r\n    toolbox:\r\n      enabled: false\r\n    webservice:\r\n      minReplicas: 1\r\n      maxReplicas: 1\r\n      resources:\r\n        requests:\r\n          cpu: 100m\r\n          memory: 1Gi\r\n        limits:\r\n          memory: 2Gi\r\n    sidekiq:\r\n      minReplicas: 1\r\n      maxReplicas: 1\r\n      resources:\r\n        requests:\r\n          cpu: 50m\r\n          memory: 512Mi\r\n        limits:\r\n          memory: 1Gi\r\n    gitaly:\r\n      resources:\r\n        requests:\r\n          cpu: 50m\r\n          memory: 256Mi\r\n        limits:\r\n          memory: 512Mi\r\n    gitlab-shell:\r\n      minReplicas: 1\r\n      maxReplicas: 1\r\n\r\n  postgresql:\r\n    install: true\r\n    # ponytail: bitnami moved old image tags to bitnamilegacy on docker.io, upgrade image.tag when bumping chart\r\n    image:\r\n      repository: bitnamilegacy/postgresql\r\n    metrics:\r\n      image:\r\n        repository: bitnamilegacy/postgres-exporter\r\n    primary:\r\n      resources:\r\n        requests:\r\n          cpu: 50m\r\n          memory: 256Mi\r\n        limits:\r\n          memory: 512Mi\r\n\r\n  redis:\r\n    install: true\r\n    # ponytail: chart's pinned 6.2.7 tag is amd64-only in bitnamilegacy; pinned to a same-minor tag with arm64 support\r\n    image:\r\n      repository: bitnamilegacy/redis\r\n      tag: 6.2.16-debian-12-r3\r\n    metrics:\r\n      image:\r\n        repository: bitnamilegacy/redis-exporter\r\n        tag: 1.76.0-debian-12-r0\r\n    master:\r\n      resources:\r\n        requests:\r\n          cpu: 25m\r\n          memory: 64Mi\r\n        limits:\r\n          memory: 128Mi\r\n"],"verify":false,"version":"0.1.0","wait":true,"wait_for_jobs":false},"sensitive_attributes":[[{"type":"get_attr","value":"repository_password"}],[{"type":"get_attr","value":"set_sensitive"}]],"private":"eyJzY2hlbWFfdmVyc2lvbiI6IjEifQ==","dependencies":["helm_release.cert_manager","kubectl_manifest.homelab_ca","kubectl_manifest.homelab_ca_issuer","kubectl_manifest.selfsigned_bootstrap","kubernetes_namespace.cert_manager","kubernetes_namespace.gitlab","kubernetes_secret.gitlab_omniauth_authentik","kubernetes_secret.gitlab_root_password"]}]},{"mode":"managed","type":"helm_release","name":"litellm","provider":"provider[\"registry.opentofu.org/hashicorp/helm\"]","instances":[{"schema_version":1,"attributes":{"atomic":false,"chart":"./../helm/litellm","cleanup_on_fail":false,"create_namespace":false,"dependency_update":true,"description":null,"devel":null,"disable_crd_hooks":false,"disable_openapi_validation":false,"disable_webhooks":false,"force_update":false,"id":"litellm","keyring":null,"lint":false,"manifest":null,"max_history":0,"metadata":[{"app_version":"","chart":"litellm","first_deployed":1787798862,"last_deployed":1787798862,"name":"litellm","namespace":"litellm","notes":"\nCHART NAME: postgresql\nCHART VERSION: 18.8.13\nAPP VERSION: 18.6.0\n\n** Please be patient while the chart is being deployed **\n\nPostgreSQL can be accessed via port 5432 on the following DNS names from within your cluster:\n\n    litellm-postgresql.litellm.svc.cluster.local - Read/Write connection\n\nTo get the password for \"postgres\" run:\n\n    export POSTGRES_PASSWORD=$(kubectl get secret --namespace litellm litellm-postgresql -o jsonpath=\"{.data.postgres-password}\" | base64 -d)\n\nTo connect to your database run the following command:\n\n    kubectl run litellm-postgresql-client --rm --tty -i --restart='Never' --namespace litellm --image registry-1.docker.io/bitnami/postgresql:latest --env=\"PGPASSWORD=$POSTGRES_PASSWORD\" \\\n      --command -- psql --host litellm-postgresql -U postgres -d postgres -p 5432\n\n    \u003e NOTE: If you access the container using bash, make sure that you execute \"/opt/bitnami/scripts/postgresql/entrypoint.sh /bin/bash\" in order to avoid the error \"psql: local user with ID 1001 does not exist\"\n\nTo connect to your database from outside the cluster execute the following commands:\n\n    kubectl port-forward --namespace litellm svc/litellm-postgresql 5432:5432 \u0026\n    PGPASSWORD=\"$POSTGRES_PASSWORD\" psql --host 127.0.0.1 -U postgres -d postgres -p 5432\nWARNING: Rolling tag detected (bitnami/postgresql:latest), please note that it is strongly recommended to avoid using rolling tags in a production environment.\n+info https://techdocs.broadcom.com/us/en/vmware-tanzu/bitnami-secure-images/bitnami-secure-images/services/bsi-doc/apps-tutorials-understand-rolling-tags-containers-index.html\nWARNING: Rolling tag detected (bitnami/postgres-exporter:latest), please note that it is strongly recommended to avoid using rolling tags in a production environment.\n+info https://techdocs.broadcom.com/us/en/vmware-tanzu/bitnami-secure-images/bitnami-secure-images/services/bsi-doc/apps-tutorials-understand-rolling-tags-containers-index.html\nWARNING: Rolling tag detected (bitnami/os-shell:latest), please note that it is strongly recommended to avoid using rolling tags in a production environment.\n+info https://techdocs.broadcom.com/us/en/vmware-tanzu/bitnami-secure-images/bitnami-secure-images/services/bsi-doc/apps-tutorials-understand-rolling-tags-containers-index.html\n\nWARNING: There are \"resources\" sections in the chart not set. Using \"resourcesPreset\" is not recommended for production. For production installations, please set the following values according to your workload needs:\n  - primary.resources\n  - readReplicas.resources\n+info https://kubernetes.io/docs/concepts/configuration/manage-resources-containers/\n","revision":1,"values":"{\"env\":{\"AUTO_REDIRECT_UI_LOGIN_TO_SSO\":\"true\",\"DATABASE_URL\":\"postgresql://litellm:dev-litellm-db-password@litellm-postgres:5432/litellm\",\"GENERIC_AUTHORIZATION_ENDPOINT\":\"https://desktop-qv5aogf.tail60240b.ts.net:8443/application/o/authorize/\",\"GENERIC_CLIENT_ID\":\"dev-litellm-oidc-client-id\",\"GENERIC_CLIENT_SECRET\":\"dev-litellm-oidc-client-secret-not-for-prod-use\",\"GENERIC_SCOPE\":\"openid profile email litellm_role\",\"GENERIC_TOKEN_ENDPOINT\":\"http://authentik-server.authentik.svc.cluster.local/application/o/token/\",\"GENERIC_USERINFO_ENDPOINT\":\"http://authentik-server.authentik.svc.cluster.local/application/o/userinfo/\",\"GENERIC_USER_ROLE_ATTRIBUTE\":\"litellm_role\",\"LITELLM_MASTER_KEY\":\"sk-dev-litellm-master-key-not-for-prod-use\",\"LITELLM_SALT_KEY\":\"sk-dev-litellm-salt-key-not-for-prod-use\",\"PROXY_BASE_URL\":\"https://desktop-qv5aogf.tail60240b.ts.net:8453\",\"PROXY_LOGOUT_URL\":\"https://desktop-qv5aogf.tail60240b.ts.net:8443/application/o/litellm/end-session/\",\"STORE_MODEL_IN_DB\":\"True\"},\"image\":{\"repository\":\"ghcr.io/berriai/litellm\",\"tag\":\"main-latest\"},\"postgres\":{\"database\":\"litellm\",\"image\":\"postgres:16\",\"password\":\"dev-litellm-db-password\",\"resources\":{\"limits\":{\"memory\":\"256Mi\"},\"requests\":{\"cpu\":\"50m\",\"memory\":\"128Mi\"}},\"storageSize\":\"4Gi\",\"username\":\"litellm\"},\"resources\":{\"limits\":{\"memory\":\"2Gi\"},\"requests\":{\"cpu\":\"100m\",\"memory\":\"512Mi\"}}}","version":"0.1.0"}],"name":"litellm","namespace":"litellm","pass_credentials":false,"postrender":[],"recreate_pods":false,"render_subchart_notes":true,"replace":false,"repository":null,"repository_ca_file":null,"repository_cert_file":null,"repository_key_file":null,"repository_password":null,"repository_username":null,"reset_values":false,"reuse_values":false,"set":[],"set_list":[],"set_sensitive":[],"skip_crds":false,"status":"deployed","timeout":600,"upgrade_install":null,"values":["image:\n  repository: ghcr.io/berriai/litellm\n  tag: main-latest\n\nenv:\n  DATABASE_URL: \"postgresql://litellm:dev-litellm-db-password@litellm-postgres:5432/litellm\"\n  STORE_MODEL_IN_DB: \"True\"\n  LITELLM_MASTER_KEY: \"sk-dev-litellm-master-key-not-for-prod-use\"\n  LITELLM_SALT_KEY: \"sk-dev-litellm-salt-key-not-for-prod-use\"\n\n  # SSO via Authentik generic OIDC\n  GENERIC_CLIENT_ID: \"dev-litellm-oidc-client-id\"\n  GENERIC_CLIENT_SECRET: \"dev-litellm-oidc-client-secret-not-for-prod-use\"\n  # ponytail: browser-navigated endpoint must use Tailscale HTTPS (external).\n  # Token and userinfo are server-side calls — use in-cluster HTTP to avoid\n  # self-signed cert validation against homelab CA.\n  GENERIC_AUTHORIZATION_ENDPOINT: \"https://desktop-qv5aogf.tail60240b.ts.net:8443/application/o/authorize/\"\n  GENERIC_TOKEN_ENDPOINT: \"http://authentik-server.authentik.svc.cluster.local/application/o/token/\"\n  GENERIC_USERINFO_ENDPOINT: \"http://authentik-server.authentik.svc.cluster.local/application/o/userinfo/\"\n  GENERIC_SCOPE: \"openid profile email litellm_role\"\n  GENERIC_USER_ROLE_ATTRIBUTE: \"litellm_role\"\n  PROXY_BASE_URL: \"https://desktop-qv5aogf.tail60240b.ts.net:8453\"\n  PROXY_LOGOUT_URL: \"https://desktop-qv5aogf.tail60240b.ts.net:8443/application/o/litellm/end-session/\"\n  AUTO_REDIRECT_UI_LOGIN_TO_SSO: \"true\"\n\nresources:\n  requests:\n    cpu: 100m\n    memory: 512Mi\n  limits:\n    memory: 2Gi\n\npostgres:\n  image: postgres:16\n  database: litellm\n  username: litellm\n  password: \"dev-litellm-db-password\"\n  storageSize: 4Gi\n  resources:\n    requests:\n      cpu: 50m\n      memory: 128Mi\n    limits:\n      memory: 256Mi\n"],"verify":false,"version":"0.1.0","wait":true,"wait_for_jobs":false},"sensitive_attributes":[[{"type":"get_attr","value":"repository_password"}],[{"type":"get_attr","value":"values"},{"type":"index","value":{"value":0,"type":"number"}}]],"private":"eyJzY2hlbWFfdmVyc2lvbiI6IjEifQ==","dependencies":["kubernetes_namespace.litellm"]}]},{"mode":"managed","type":"helm_release","name":"mcp_servers","provider":"provider[\"registry.opentofu.org/hashicorp/helm\"]","instances":[{"schema_version":1,"attributes":{"atomic":false,"chart":"./../helm/mcp-servers","cleanup_on_fail":false,"create_namespace":false,"dependency_update":true,"description":null,"devel":null,"disable_crd_hooks":false,"disable_openapi_validation":false,"disable_webhooks":false,"force_update":false,"id":"mcp-servers","keyring":null,"lint":false,"manifest":null,"max_history":0,"metadata":[{"app_version":"","chart":"mcp-servers","first_deployed":1787812547,"last_deployed":1787812547,"name":"mcp-servers","namespace":"mcp-servers","notes":"","revision":1,"values":"{\"defaultResources\":{\"limits\":{\"memory\":\"256Mi\"},\"requests\":{\"cpu\":\"50m\",\"memory\":\"128Mi\"}},\"servers\":{\"gitlab\":{\"env\":{\"GITLAB_API_URL\":\"http://gitlab-webservice-default.gitlab.svc.cluster.local:8181/api/v4\",\"GITLAB_PERSONAL_ACCESS_TOKEN\":\"(sensitive value)\",\"HOST\":\"0.0.0.0\",\"PORT\":\"3002\",\"STREAMABLE_HTTP\":\"true\",\"STREAMABLE_HTTP_AUTH_TOKEN\":\"(sensitive value)\"},\"image\":\"zereight050/gitlab-mcp:latest\",\"port\":3002},\"grafana\":{\"args\":[\"-t\",\"streamable-http\",\"--address\",\":8000\"],\"env\":{\"GRAFANA_SERVICE_ACCOUNT_TOKEN\":\"(sensitive value)\",\"GRAFANA_URL\":\"http://observability-grafana.observability.svc.cluster.local\"},\"image\":\"grafana/mcp-grafana:latest\",\"port\":8000},\"nx\":{\"args\":[\"-y\",\"nx-mcp@latest\",\"--transport\",\"sse\",\"--port\",\"9921\"],\"command\":[\"npx\"],\"env\":{\"NX_CLOUD_ACCESS_TOKEN\":\"(sensitive value)\"},\"image\":\"node:20-alpine\",\"port\":9921},\"playwright\":{\"args\":[\"--headless\",\"--browser\",\"chromium\",\"--no-sandbox\",\"--port\",\"8931\",\"--host\",\"0.0.0.0\"],\"command\":[\"node\",\"/app/cli.js\"],\"image\":\"mcr.microsoft.com/playwright/mcp:latest\",\"port\":8931,\"resources\":{\"limits\":{\"memory\":\"1Gi\"},\"requests\":{\"cpu\":\"250m\",\"memory\":\"512Mi\"}}},\"sonarqube\":{\"env\":{\"SONARQUBE_HTTP_HOST\":\"0.0.0.0\",\"SONARQUBE_HTTP_PORT\":\"8080\",\"SONARQUBE_MCP_IN_CONTAINER\":\"true\",\"SONARQUBE_TOKEN\":\"(sensitive value)\",\"SONARQUBE_TRANSPORT\":\"http\",\"SONARQUBE_URL\":\"http://sonarqube-sonarqube.sonarqube.svc.cluster.local:9000\"},\"image\":\"sonarsource/sonarqube-mcp:latest\",\"port\":8080}}}","version":"0.1.0"}],"name":"mcp-servers","namespace":"mcp-servers","pass_credentials":false,"postrender":[],"recreate_pods":false,"render_subchart_notes":true,"replace":false,"repository":null,"repository_ca_file":null,"repository_cert_file":null,"repository_key_file":null,"repository_password":null,"repository_username":null,"reset_values":false,"reuse_values":false,"set":[],"set_list":[],"set_sensitive":[{"name":"servers.gitlab.env.GITLAB_PERSONAL_ACCESS_TOKEN","type":"","value":""},{"name":"servers.gitlab.env.STREAMABLE_HTTP_AUTH_TOKEN","type":"","value":"dev-gitlab-mcp-auth-token"},{"name":"servers.grafana.env.GRAFANA_SERVICE_ACCOUNT_TOKEN","type":"","value":""},{"name":"servers.nx.env.NX_CLOUD_ACCESS_TOKEN","type":"","value":""},{"name":"servers.sonarqube.env.SONARQUBE_TOKEN","type":"","value":""}],"skip_crds":false,"status":"deployed","timeout":300,"upgrade_install":null,"values":["# ponytail: one Deployment+Service template looped over this map instead of\n# 5 near-identical template files — every server here is the same shape\n# (image, optional command/args override, one HTTP port, env vars).\ndefaultResources:\n  requests:\n    cpu: 50m\n    memory: 128Mi\n  limits:\n    memory: 256Mi\n\nservers:\n  grafana:\n    image: grafana/mcp-grafana:latest\n    args: [\"-t\", \"streamable-http\", \"--address\", \":8000\"]\n    port: 8000\n    env:\n      GRAFANA_URL: http://observability-grafana.observability.svc.cluster.local\n      GRAFANA_SERVICE_ACCOUNT_TOKEN: \"\"  # set via Tiltfile/terraform\n\n  sonarqube:\n    image: sonarsource/sonarqube-mcp:latest\n    port: 8080\n    env:\n      SONARQUBE_TRANSPORT: \"http\"\n      SONARQUBE_HTTP_PORT: \"8080\"\n      SONARQUBE_HTTP_HOST: \"0.0.0.0\"\n      SONARQUBE_MCP_IN_CONTAINER: \"true\"\n      SONARQUBE_URL: http://sonarqube-sonarqube.sonarqube.svc.cluster.local:9000\n      SONARQUBE_TOKEN: \"\"  # set via Tiltfile/terraform\n\n  gitlab:\n    # ponytail: NOT mcp/gitlab (Docker's own catalog wrapper, stdio-only) —\n    # this is the actual zereight/gitlab-mcp project, which supports HTTP\n    # transport via env vars.\n    image: zereight050/gitlab-mcp:latest\n    port: 3002\n    env:\n      STREAMABLE_HTTP: \"true\"\n      HOST: \"0.0.0.0\"\n      PORT: \"3002\"\n      GITLAB_API_URL: http://gitlab-webservice-default.gitlab.svc.cluster.local:8181/api/v4\n      GITLAB_PERSONAL_ACCESS_TOKEN: \"\"  # set via Tiltfile/terraform\n      # ponytail: server holds a static PAT (not per-client OAuth), so this\n      # is the \"who's allowed to call this server\" bearer token — required\n      # by the image whenever STREAMABLE_HTTP + a static PAT are combined.\n      STREAMABLE_HTTP_AUTH_TOKEN: \"\"  # set via Tiltfile/terraform\n\n  playwright:\n    image: mcr.microsoft.com/playwright/mcp:latest\n    command: [\"node\", \"/app/cli.js\"]\n    args: [\"--headless\", \"--browser\", \"chromium\", \"--no-sandbox\", \"--port\", \"8931\", \"--host\", \"0.0.0.0\"]\n    port: 8931\n    # ponytail: real chromium instance, not a thin API wrapper — needs more\n    # than the other servers' default resources.\n    resources:\n      requests:\n        cpu: 250m\n        memory: 512Mi\n      limits:\n        memory: 1Gi\n\n  # ponytail: no official nx-mcp Docker image — runs via `npx` on a bare\n  # node image. It's designed to introspect a *live Nx workspace directory*,\n  # which isn't mounted here (this repo isn't an Nx workspace); expect only\n  # Nx Cloud-facing tools to work until/unless a workspace volume is added.\n  nx:\n    image: node:20-alpine\n    command: [\"npx\"]\n    args: [\"-y\", \"nx-mcp@latest\", \"--transport\", \"sse\", \"--port\", \"9921\"]\n    port: 9921\n    env:\n      NX_CLOUD_ACCESS_TOKEN: \"\"  # set via Tiltfile/terraform\n"],"verify":false,"version":"0.1.0","wait":false,"wait_for_jobs":false},"sensitive_attributes":[[{"type":"get_attr","value":"repository_password"}],[{"type":"get_attr","value":"set_sensitive"}]],"private":"eyJzY2hlbWFfdmVyc2lvbiI6IjEifQ==","dependencies":["kubernetes_namespace.mcp_servers"]}]},{"mode":"managed","type":"helm_release","name":"minio","provider":"provider[\"registry.opentofu.org/hashicorp/helm\"]","instances":[{"schema_version":1,"attributes":{"atomic":false,"chart":"./../helm/minio","cleanup_on_fail":false,"create_namespace":false,"dependency_update":true,"description":null,"devel":null,"disable_crd_hooks":false,"disable_openapi_validation":false,"disable_webhooks":false,"force_update":false,"id":"minio","keyring":null,"lint":false,"manifest":null,"max_history":0,"metadata":[{"app_version":"","chart":"minio","first_deployed":1787792562,"last_deployed":1787792562,"name":"minio","namespace":"minio","notes":"\nMinIO can be accessed via port 9000 on the following DNS name from within your cluster:\nminio.minio.cluster.local\n\nTo access MinIO from localhost, run the below commands:\n\n  1. export POD_NAME=$(kubectl get pods --namespace minio -l \"release=minio\" -o jsonpath=\"{.items[0].metadata.name}\")\n\n  2. kubectl port-forward $POD_NAME 9000 --namespace minio\n\nRead more about port forwarding here: http://kubernetes.io/docs/user-guide/kubectl/kubectl_port-forward/\n\nYou can now access MinIO server on http://localhost:9000. Follow the below steps to connect to MinIO server with mc client:\n\n  1. Download the MinIO mc client - https://min.io/docs/minio/linux/reference/minio-mc.html#quickstart\n\n  2. export MC_HOST_minio-local=http://$(kubectl get secret --namespace minio minio -o jsonpath=\"{.data.rootUser}\" | base64 --decode):$(kubectl get secret --namespace minio minio -o jsonpath=\"{.data.rootPassword}\" | base64 --decode)@localhost:9000\n\n  3. mc ls minio-local\n\n\n","revision":1,"values":"{\"minio\":{\"consoleIngress\":{\"annotations\":{\"cert-manager.io/cluster-issuer\":\"homelab-ca-issuer\"},\"enabled\":true,\"hosts\":[\"minio-console.local\"],\"ingressClassName\":\"traefik\",\"tls\":[{\"hosts\":[\"minio-console.local\"],\"secretName\":\"minio-console.local-tls\"}]},\"drivesPerNode\":1,\"environment\":{\"MINIO_BROWSER\":\"on\",\"MINIO_IDENTITY_OPENID_CLAIM_NAME\":\"policy\",\"MINIO_IDENTITY_OPENID_CLIENT_ID\":\"(sensitive value)\",\"MINIO_IDENTITY_OPENID_CLIENT_SECRET\":\"(sensitive value)\",\"MINIO_IDENTITY_OPENID_CONFIG_URL\":\"https://desktop-qv5aogf.tail60240b.ts.net:8443/application/o/minio/.well-known/openid-configuration\",\"MINIO_IDENTITY_OPENID_DISPLAY_NAME\":\"Authentik\",\"MINIO_IDENTITY_OPENID_REDIRECT_URI\":\"https://desktop-qv5aogf.tail60240b.ts.net:8445/oauth_callback\",\"MINIO_IDENTITY_OPENID_SCOPES\":\"openid,profile,email,policy\"},\"image\":{\"repository\":\"quay.io/minio/minio\",\"tag\":\"RELEASE.2024-11-07T00-52-20Z\"},\"ingress\":{\"annotations\":{\"cert-manager.io/cluster-issuer\":\"homelab-ca-issuer\"},\"enabled\":true,\"hosts\":[\"minio.local\"],\"ingressClassName\":\"traefik\",\"tls\":[{\"hosts\":[\"minio.local\"],\"secretName\":\"minio.local-tls\"}]},\"mode\":\"standalone\",\"persistence\":{\"size\":\"8Gi\"},\"pools\":1,\"replicas\":1,\"resources\":{\"limits\":{\"memory\":\"512Mi\"},\"requests\":{\"cpu\":\"50m\",\"memory\":\"256Mi\"}},\"rootPassword\":\"(sensitive value)\",\"rootUser\":\"admin\"}}","version":"0.1.0"}],"name":"minio","namespace":"minio","pass_credentials":false,"postrender":[],"recreate_pods":false,"render_subchart_notes":true,"replace":false,"repository":null,"repository_ca_file":null,"repository_cert_file":null,"repository_key_file":null,"repository_password":null,"repository_username":null,"reset_values":false,"reuse_values":false,"set":[],"set_list":[],"set_sensitive":[{"name":"minio.environment.MINIO_IDENTITY_OPENID_CLIENT_ID","type":"","value":"dev-minio-oidc-client-id"},{"name":"minio.environment.MINIO_IDENTITY_OPENID_CLIENT_SECRET","type":"","value":"dev-minio-oidc-client-secret-not-for-prod-use"},{"name":"minio.rootPassword","type":"","value":"dev-minio-root-password"}],"skip_crds":false,"status":"deployed","timeout":600,"upgrade_install":null,"values":["minio:\n  image:\n    repository: quay.io/minio/minio\n    # ponytail: pinned — newer builds (tried up through RELEASE.2025-09-07)\n    # have a regression where the WebUI never shows the SSO login button\n    # despite fully correct, live-verified server-side OIDC config. This tag\n    # matches a known-working reference project exactly. Re-test on chart/\n    # image bumps before moving off it.\n    tag: RELEASE.2024-11-07T00-52-20Z\n\n  mode: standalone\n  replicas: 1\n  drivesPerNode: 1\n  pools: 1\n\n  rootUser: admin\n  rootPassword: \"\"  # set via terraform variable\n\n  persistence:\n    size: 8Gi\n\n  resources:\n    requests:\n      cpu: 50m\n      memory: 256Mi\n    limits:\n      memory: 512Mi\n\n  # ponytail: fixed dev client_id/secret matching the Authentik OAuth2\n  # provider created via the API (same one-time-setup pattern as GitLab's).\n  # If minio boots before Authentik/tailscale-serve is reachable (e.g. after\n  # a full cluster/host restart), the discovery fetch below 502s once and\n  # OIDC stays disabled for that pod's lifetime — no retry. Fix: `kubectl\n  # rollout restart deploy/minio -n minio` once Authentik is up. Chart has\n  # no initContainers hook to wait-for-it automatically (only extraContainers,\n  # which doesn't block startup), not worth patching the chart for a homelab.\n  environment:\n    MINIO_BROWSER: \"on\"\n    MINIO_IDENTITY_OPENID_CONFIG_URL: \"https://desktop-qv5aogf.tail60240b.ts.net:8443/application/o/minio/.well-known/openid-configuration\"\n    # MINIO_IDENTITY_OPENID_CLIENT_ID / _CLIENT_SECRET set via Tiltfile/terraform (.env)\n    MINIO_IDENTITY_OPENID_CLAIM_NAME: \"policy\"\n    MINIO_IDENTITY_OPENID_SCOPES: \"openid,profile,email,policy\"\n    MINIO_IDENTITY_OPENID_REDIRECT_URI: \"https://desktop-qv5aogf.tail60240b.ts.net:8445/oauth_callback\"\n    MINIO_IDENTITY_OPENID_DISPLAY_NAME: \"Authentik\"\n\n  ingress:\n    enabled: true\n    ingressClassName: traefik\n    annotations:\n      cert-manager.io/cluster-issuer: homelab-ca-issuer\n    hosts:\n      - minio.local\n    tls:\n      - secretName: minio.local-tls\n        hosts:\n          - minio.local\n\n  consoleIngress:\n    enabled: true\n    ingressClassName: traefik\n    annotations:\n      cert-manager.io/cluster-issuer: homelab-ca-issuer\n    hosts:\n      - minio-console.local\n    tls:\n      - secretName: minio-console.local-tls\n        hosts:\n          - minio-console.local\n"],"verify":false,"version":"0.1.0","wait":true,"wait_for_jobs":false},"sensitive_attributes":[[{"type":"get_attr","value":"repository_password"}],[{"type":"get_attr","value":"set_sensitive"}]],"private":"eyJzY2hlbWFfdmVyc2lvbiI6IjEifQ==","dependencies":["kubernetes_namespace.minio"]}]},{"mode":"managed","type":"helm_release","name":"n8n","provider":"provider[\"registry.opentofu.org/hashicorp/helm\"]","instances":[{"schema_version":1,"attributes":{"atomic":false,"chart":"./../helm/n8n","cleanup_on_fail":false,"create_namespace":false,"dependency_update":true,"description":null,"devel":null,"disable_crd_hooks":false,"disable_openapi_validation":false,"disable_webhooks":false,"force_update":false,"id":"n8n","keyring":null,"lint":false,"manifest":null,"max_history":0,"metadata":[{"app_version":"","chart":"n8n","first_deployed":1787792562,"last_deployed":1787792562,"name":"n8n","namespace":"n8n","notes":"1. Get the application URL by running these commands:\n  export POD_NAME=$(kubectl get pods --namespace n8n -l \"app.kubernetes.io/name=n8n,app.kubernetes.io/instance=n8n\" -o jsonpath=\"{.items[0].metadata.name}\")\n  export CONTAINER_PORT=$(kubectl get pod --namespace n8n $POD_NAME -o jsonpath=\"{.spec.containers[0].ports[0].containerPort}\")\n  echo \"Visit http://127.0.0.1:8080 to use your application\"\n  kubectl --namespace n8n port-forward $POD_NAME 8080:$CONTAINER_PORT\n","revision":1,"values":"{\"n8n\":{\"encryptionKey\":\"(sensitive value)\",\"main\":{\"extraEnvVars\":{\"EXTERNAL_FRONTEND_HOOKS_URLS\":\"/assets/oidc-frontend-hook.js\",\"EXTERNAL_HOOK_FILES\":\"/hooks/hooks.js\",\"N8N_ADDITIONAL_NON_UI_ROUTES\":\"auth\",\"N8N_PROTOCOL\":\"https\",\"OIDC_CLIENT_ID\":\"(sensitive value)\",\"OIDC_CLIENT_SECRET\":\"(sensitive value)\",\"OIDC_ISSUER_URL\":\"https://desktop-qv5aogf.tail60240b.ts.net:8443/application/o/n8n/\",\"OIDC_REDIRECT_URI\":\"https://desktop-qv5aogf.tail60240b.ts.net:8447/auth/oidc/callback\"},\"livenessProbe\":{\"timeoutSeconds\":10},\"persistence\":{\"annotations\":{},\"enabled\":true},\"readinessProbe\":{\"timeoutSeconds\":10},\"resources\":{\"limits\":{\"memory\":\"1Gi\"},\"requests\":{\"cpu\":\"50m\",\"memory\":\"512Mi\"}},\"volumeMounts\":[{\"mountPath\":\"/hooks\",\"name\":\"oidc-hooks\",\"readOnly\":true}],\"volumes\":[{\"configMap\":{\"name\":\"n8n-oidc-hooks\"},\"name\":\"oidc-hooks\"}]}}}","version":"0.1.0"}],"name":"n8n","namespace":"n8n","pass_credentials":false,"postrender":[],"recreate_pods":false,"render_subchart_notes":true,"replace":false,"repository":null,"repository_ca_file":null,"repository_cert_file":null,"repository_key_file":null,"repository_password":null,"repository_username":null,"reset_values":false,"reuse_values":false,"set":[],"set_list":[],"set_sensitive":[{"name":"n8n.encryptionKey","type":"","value":"dev-n8n-encryption-key-not-for-prod-use"},{"name":"n8n.main.extraEnvVars.OIDC_CLIENT_ID","type":"","value":"dev-n8n-oidc-client-id"},{"name":"n8n.main.extraEnvVars.OIDC_CLIENT_SECRET","type":"","value":"dev-n8n-oidc-client-secret-not-for-prod-use"}],"skip_crds":false,"status":"deployed","timeout":600,"upgrade_install":null,"values":["n8n:\n  # ponytail: sqlite (chart default) instead of the bundled postgres subchart\n  # — one more app, one more moving part isn't worth it for a homelab\n  main:\n    persistence:\n      enabled: true\n      # ponytail: chart defaults this to \"helm.sh/resource-policy: keep\",\n      # which makes Tilt refuse to recreate the PVC after a manual delete\n      # (e.g. wiping it to reset the encryption key) — drop it so Tilt fully\n      # owns the PVC lifecycle like every other app's storage in this repo.\n      annotations: {}\n    resources:\n      requests:\n        cpu: 50m\n        memory: 512Mi\n      limits:\n        # ponytail: 512Mi wasn't enough headroom for Node's heap on top of\n        # n8n's own footprint — OOMKilled with \"JavaScript heap out of memory\"\n        memory: 1Gi\n\n    # ponytail: chart's 1s default probe timeout is too tight on this RPi\n    # under load (6 apps running concurrently) — caused a liveness-kill\n    # restart loop even though n8n was actually up. Same fix as sonarqube/\n    # seafile-mariadb's probe timeouts.\n    livenessProbe:\n      timeoutSeconds: 10\n    readinessProbe:\n      timeoutSeconds: 10\n\n    # ponytail: n8n gates native OIDC/SSO behind an Enterprise license.\n    # cweagans/n8n-oidc (MIT) bolts it on via n8n's external-hooks system\n    # instead — no license, no fork, just a JS file + env vars. hooks.js is\n    # mounted from a ConfigMap the Tiltfile builds from helm/n8n/hooks.js.\n    volumes:\n      - name: oidc-hooks\n        configMap:\n          name: n8n-oidc-hooks\n    volumeMounts:\n      - name: oidc-hooks\n        mountPath: /hooks\n        readOnly: true\n\n    # ponytail: fixed dev client_id/secret matching the Authentik OAuth2\n    # provider created via the API (same one-time-setup pattern as the\n    # other apps'). OIDC_ISSUER_URL uses the tailscale hostname so the\n    # server-side discovery fetch and the browser redirect agree on the\n    # same authority — same reasoning as minio/gitlab's OIDC wiring.\n    extraEnvVars:\n      EXTERNAL_HOOK_FILES: \"/hooks/hooks.js\"\n      N8N_ADDITIONAL_NON_UI_ROUTES: \"auth\"\n      EXTERNAL_FRONTEND_HOOKS_URLS: \"/assets/oidc-frontend-hook.js\"\n      N8N_PROTOCOL: \"https\"\n      OIDC_ISSUER_URL: \"https://desktop-qv5aogf.tail60240b.ts.net:8443/application/o/n8n/\"\n      # OIDC_CLIENT_ID / OIDC_CLIENT_SECRET set via Tiltfile/terraform (.env)\n      OIDC_REDIRECT_URI: \"https://desktop-qv5aogf.tail60240b.ts.net:8447/auth/oidc/callback\"\n"],"verify":false,"version":"0.1.0","wait":true,"wait_for_jobs":false},"sensitive_attributes":[[{"type":"get_attr","value":"repository_password"}],[{"type":"get_attr","value":"set_sensitive"}]],"private":"eyJzY2hlbWFfdmVyc2lvbiI6IjEifQ==","dependencies":["kubernetes_config_map.n8n_oidc_hooks","kubernetes_namespace.n8n"]}]},{"mode":"managed","type":"helm_release","name":"nx_cloud","provider":"provider[\"registry.opentofu.org/hashicorp/helm\"]","instances":[{"schema_version":1,"attributes":{"atomic":false,"chart":"./../helm/nx-cloud","cleanup_on_fail":false,"create_namespace":false,"dependency_update":true,"description":null,"devel":null,"disable_crd_hooks":false,"disable_openapi_validation":false,"disable_webhooks":false,"force_update":false,"id":"nx-cloud","keyring":null,"lint":false,"manifest":null,"max_history":0,"metadata":[{"app_version":"","chart":"nx-cloud","first_deployed":1787796625,"last_deployed":1787796625,"name":"nx-cloud","namespace":"nx-cloud","notes":"CHART NAME: mongodb\nCHART VERSION: 19.1.36\nAPP VERSION: 8.3.8\n\n⚠ WARNING: Since August 28th, 2025, only a limited subset of images/charts are available for free.\n    Subscribe to Bitnami Secure Images to receive continued support and security updates.\n    More info at https://bitnami.com and https://github.com/bitnami/containers/issues/83267\n\n** Please be patient while the chart is being deployed **\n\nMongoDB\u0026reg; can be accessed on the following DNS name(s) and ports from within your cluster:\n\n    nx-cloud-mongodb-0.nx-cloud-mongodb-headless.nx-cloud.svc.cluster.local:27017\n\nTo get the root password run:\n\n    export MONGODB_ROOT_PASSWORD=$(kubectl get secret --namespace nx-cloud nx-cloud-mongodb -o jsonpath=\"{.data.mongodb-root-password}\" | base64 -d)\n\nTo get the password for \"nx-cloud\" run:\n\n    export MONGODB_PASSWORD=$(kubectl get secret --namespace nx-cloud nx-cloud-mongodb -o jsonpath=\"{.data.mongodb-passwords}\" | base64 -d | awk -F',' '{print $1}')\n\nTo connect to your database, create a MongoDB\u0026reg; client container:\n\n    kubectl run --namespace nx-cloud nx-cloud-mongodb-client --rm --tty -i --restart='Never' --env=\"MONGODB_ROOT_PASSWORD=$MONGODB_ROOT_PASSWORD\" --image registry-1.docker.io/bitnami/mongodb:latest --command -- bash\n\nThen, run the following command:\n    mongosh admin --host \"nx-cloud-mongodb-0.nx-cloud-mongodb-headless.nx-cloud.svc.cluster.local:27017\" --authenticationDatabase admin -u $MONGODB_ROOT_USER -p $MONGODB_ROOT_PASSWORD\nWARNING: Rolling tag detected (bitnami/mongodb:latest), please note that it is strongly recommended to avoid using rolling tags in a production environment.\n+info https://techdocs.broadcom.com/us/en/vmware-tanzu/bitnami-secure-images/bitnami-secure-images/services/bsi-doc/apps-tutorials-understand-rolling-tags-containers-index.html\nWARNING: Rolling tag detected (bitnami/mongodb-exporter:latest), please note that it is strongly recommended to avoid using rolling tags in a production environment.\n+info https://techdocs.broadcom.com/us/en/vmware-tanzu/bitnami-secure-images/bitnami-secure-images/services/bsi-doc/apps-tutorials-understand-rolling-tags-containers-index.html\nWARNING: Rolling tag detected (bitnami/kubectl:latest), please note that it is strongly recommended to avoid using rolling tags in a production environment.\n+info https://techdocs.broadcom.com/us/en/vmware-tanzu/bitnami-secure-images/bitnami-secure-images/services/bsi-doc/apps-tutorials-understand-rolling-tags-containers-index.html\nWARNING: Rolling tag detected (bitnami/os-shell:latest), please note that it is strongly recommended to avoid using rolling tags in a production environment.\n+info https://techdocs.broadcom.com/us/en/vmware-tanzu/bitnami-secure-images/bitnami-secure-images/services/bsi-doc/apps-tutorials-understand-rolling-tags-containers-index.html\nWARNING: Rolling tag detected (bitnami/nginx:latest), please note that it is strongly recommended to avoid using rolling tags in a production environment.\n+info https://techdocs.broadcom.com/us/en/vmware-tanzu/bitnami-secure-images/bitnami-secure-images/services/bsi-doc/apps-tutorials-understand-rolling-tags-containers-index.html\n\nWARNING: There are \"resources\" sections in the chart not set. Using \"resourcesPreset\" is not recommended for production. For production installations, please set the following values according to your workload needs:\n  - mcp.auth.resources\n+info https://kubernetes.io/docs/concepts/configuration/manage-resources-containers/\n\n1. Get the application URL by running these commands:\n\nCHART NAME: valkey\nCHART VERSION: 6.2.12\nAPP VERSION: 9.1.1\n\n⚠ WARNING: Since August 28th, 2025, only a limited subset of images/charts are available for free.\n    Subscribe to Bitnami Secure Images to receive continued support and security updates.\n    More info at https://bitnami.com and https://github.com/bitnami/containers/issues/83267\n\n** Please be patient while the chart is being deployed **\n\nValkey can be accessed via port 6379 on the following DNS name from within your cluster:\n\n    nx-cloud-valkey-primary.nx-cloud.svc.cluster.local\n\nTo get your password run:\n\n    export VALKEY_PASSWORD=$(kubectl get secret --namespace nx-cloud nx-cloud-valkey -o jsonpath=\"{.data.valkey-password}\" | base64 -d)\n\nTo connect to your Valkey server:\n\n1. Run a Valkey pod that you can use as a client:\n\n   kubectl run --namespace nx-cloud valkey-client --restart='Never'  --env VALKEY_PASSWORD=$VALKEY_PASSWORD  --image registry-1.docker.io/bitnami/valkey:latest --command -- sleep infinity\n\n   Use the following command to attach to the pod:\n\n   kubectl exec --tty -i valkey-client \\\n   --namespace nx-cloud -- bash\n\n2. Connect using the Valkey CLI:\n   REDISCLI_AUTH=\"$VALKEY_PASSWORD\" valkey-cli -h nx-cloud-valkey-primary\n\nTo connect to your database from outside the cluster execute the following commands:\n\n    kubectl port-forward --namespace nx-cloud svc/nx-cloud-valkey-primary 6379:6379 \u0026\n    REDISCLI_AUTH=\"$VALKEY_PASSWORD\" valkey-cli -h 127.0.0.1 -p 6379\nWARNING: Rolling tag detected (bitnami/valkey:latest), please note that it is strongly recommended to avoid using rolling tags in a production environment.\n+info https://techdocs.broadcom.com/us/en/vmware-tanzu/bitnami-secure-images/bitnami-secure-images/services/bsi-doc/apps-tutorials-understand-rolling-tags-containers-index.html\nWARNING: Rolling tag detected (bitnami/valkey-sentinel:latest), please note that it is strongly recommended to avoid using rolling tags in a production environment.\n+info https://techdocs.broadcom.com/us/en/vmware-tanzu/bitnami-secure-images/bitnami-secure-images/services/bsi-doc/apps-tutorials-understand-rolling-tags-containers-index.html\nWARNING: Rolling tag detected (bitnami/redis-exporter:latest), please note that it is strongly recommended to avoid using rolling tags in a production environment.\n+info https://techdocs.broadcom.com/us/en/vmware-tanzu/bitnami-secure-images/bitnami-secure-images/services/bsi-doc/apps-tutorials-understand-rolling-tags-containers-index.html\nWARNING: Rolling tag detected (bitnami/os-shell:latest), please note that it is strongly recommended to avoid using rolling tags in a production environment.\n+info https://techdocs.broadcom.com/us/en/vmware-tanzu/bitnami-secure-images/bitnami-secure-images/services/bsi-doc/apps-tutorials-understand-rolling-tags-containers-index.html\n\nWARNING: There are \"resources\" sections in the chart not set. Using \"resourcesPreset\" is not recommended for production. For production installations, please set the following values according to your workload needs:\n  - replica.resources\n  - primary.resources\n+info https://kubernetes.io/docs/concepts/configuration/manage-resources-containers/\n","revision":1,"values":"{\"mongodb\":{\"arbiter\":{\"enabled\":false},\"architecture\":\"replicaset\",\"auth\":{\"databases\":[\"nx-cloud\"],\"enabled\":true,\"passwords\":[\"dev-nx-cloud-mongo-password\"],\"passwords[0]\":\"(sensitive value)\",\"rootPassword\":\"(sensitive value)\",\"usernames\":[\"nx-cloud\"]},\"initdbScripts\":{\"grant-nrwl-api.js\":\"db = db.getSiblingDB('nx-cloud');\\ndb.grantRolesToUser('nx-cloud', [{role: 'readWrite', db: 'nrwl-api'}]);\\n\"},\"persistence\":{\"size\":\"8Gi\"},\"replicaCount\":1,\"resources\":{\"requests\":{\"cpu\":\"100m\",\"memory\":\"256Mi\"}}},\"nx-cloud\":{\"aggregator\":{\"cronjob\":{\"env\":{\"NX_CLOUD_LOG_OUTPUT_FORMAT\":\"json\"},\"envValueFrom\":{\"ADMIN_PASSWORD\":{\"secretKeyRef\":{\"key\":\"ADMIN_PASSWORD\",\"name\":\"nx-cloud-secrets\"}}},\"resources\":{\"requests\":{\"cpu\":\"200m\",\"memory\":\"512Mi\"}}}},\"api\":{\"deployment\":{\"env\":{\"AWS_DEFAULT_REGION\":\"us-east-1\",\"AWS_REGION\":\"us-east-1\",\"AWS_S3_ACCESS_KEY_ID\":\"(sensitive value)\",\"AWS_S3_BUCKET\":\"nx-cloud\",\"AWS_S3_ENABLE_PATH_STYLE_ACCESS\":\"TRUE\",\"AWS_S3_ENDPOINT\":\"http://minio.minio.svc.cluster.local:9000\",\"AWS_S3_SECRET_ACCESS_KEY\":\"(sensitive value)\"},\"resources\":{\"requests\":{\"cpu\":\"200m\",\"memory\":\"512Mi\"}}},\"valkey\":{\"clientProvider\":\"redisson\",\"passwordSecret\":{\"key\":\"VALKEY_PASSWORD\",\"name\":\"nx-cloud-secrets\"},\"port\":6379,\"primaryAddress\":\"nx-cloud-valkey-primary\",\"useSentinel\":false,\"username\":\"default\"}},\"fileServer\":{\"enabled\":false},\"frontend\":{\"deployment\":{\"env\":{\"NX_API_INTERNAL_BASE_URL\":\"http://nx-cloud-nx-api-service\"},\"envValueFrom\":{\"SAML_CERT\":{\"secretKeyRef\":{\"key\":\"SAML_CERT\",\"name\":\"nx-cloud-secrets\",\"optional\":true}},\"SAML_ENTRY_POINT\":{\"secretKeyRef\":{\"key\":\"SAML_ENTRY_POINT\",\"name\":\"nx-cloud-secrets\",\"optional\":true}}},\"resources\":{\"requests\":{\"cpu\":\"100m\",\"memory\":\"256Mi\"}}}},\"global\":{\"mongodbConnectionString\":{\"secretKey\":\"NX_CLOUD_MONGO_SERVER_ENDPOINT\",\"secretName\":\"nx-cloud-secrets\"},\"nxCloudAppURL\":\"https://desktop-qv5aogf.tail60240b.ts.net:8454\"},\"ingress\":{\"annotations\":{\"cert-manager.io/cluster-issuer\":\"homelab-ca-issuer\"},\"className\":\"traefik\",\"enabled\":true,\"host\":\"nx-cloud.local\",\"tls\":{\"enabled\":true,\"hosts\":[\"nx-cloud.local\"],\"secretName\":\"nx-cloud.local-tls\"}}},\"valkey\":{\"architecture\":\"standalone\",\"auth\":{\"enabled\":true,\"password\":\"(sensitive value)\"},\"primary\":{\"persistence\":{\"enabled\":false}},\"resources\":{\"requests\":{\"cpu\":\"50m\",\"memory\":\"64Mi\"}}}}","version":"0.1.0"}],"name":"nx-cloud","namespace":"nx-cloud","pass_credentials":false,"postrender":[],"recreate_pods":false,"render_subchart_notes":true,"replace":false,"repository":null,"repository_ca_file":null,"repository_cert_file":null,"repository_key_file":null,"repository_password":null,"repository_username":null,"reset_values":false,"reuse_values":false,"set":[{"name":"nx-cloud.global.nxCloudAppURL","type":"","value":"https://desktop-qv5aogf.tail60240b.ts.net:8454"}],"set_list":[],"set_sensitive":[{"name":"mongodb.auth.passwords[0]","type":"","value":"dev-nx-cloud-mongo-password"},{"name":"mongodb.auth.rootPassword","type":"","value":"dev-nx-cloud-mongo-password"},{"name":"nx-cloud.api.deployment.env.AWS_S3_ACCESS_KEY_ID","type":"","value":"admin"},{"name":"nx-cloud.api.deployment.env.AWS_S3_SECRET_ACCESS_KEY","type":"","value":"dev-minio-root-password"},{"name":"valkey.auth.password","type":"","value":"dev-nx-cloud-valkey-password"}],"skip_crds":false,"status":"deployed","timeout":600,"upgrade_install":null,"values":["nx-cloud:\n  global:\n    # ponytail: set via Tiltfile/terraform; placeholder here\n    nxCloudAppURL: \"\"\n    mongodbConnectionString:\n      secretName: nx-cloud-secrets\n      secretKey: NX_CLOUD_MONGO_SERVER_ENDPOINT\n\n  ingress:\n    enabled: true\n    className: traefik\n    annotations:\n      cert-manager.io/cluster-issuer: homelab-ca-issuer\n    host: nx-cloud.local\n    tls:\n      enabled: true\n      secretName: nx-cloud.local-tls\n      hosts:\n        - nx-cloud.local\n\n  # ponytail: file server disabled — S3 (minio) used instead via api env vars.\n  # awsS3.* was removed in chart 1.0.0; env vars on api.deployment are the replacement.\n  fileServer:\n    enabled: false\n\n  api:\n    valkey:\n      clientProvider: \"redisson\"\n      useSentinel: false\n      # ponytail: service name from bitnami valkey standalone = \u003crelease\u003e-valkey-primary\n      primaryAddress: \"nx-cloud-valkey-primary\"\n      port: 6379\n      username: \"default\"\n      passwordSecret:\n        name: nx-cloud-secrets\n        key: VALKEY_PASSWORD\n    deployment:\n      env:\n        AWS_S3_BUCKET: \"nx-cloud\"\n        AWS_S3_ENDPOINT: \"http://minio.minio.svc.cluster.local:9000\"\n        # ponytail: minio requires path-style URLs\n        AWS_S3_ENABLE_PATH_STYLE_ACCESS: \"TRUE\"\n        # ponytail: required for late-2025 nx-api builds; any non-empty value works for non-AWS endpoints\n        AWS_REGION: \"us-east-1\"\n        AWS_DEFAULT_REGION: \"us-east-1\"\n        # ponytail: S3 creds injected as plain env (not k8s Secret) via Tiltfile helm set.\n        # Keeps them out of Tilt's secret redaction list — short values like \"admin\"\n        # would otherwise get redacted from unrelated command output (e.g. promote-admin.sh).\n        AWS_S3_ACCESS_KEY_ID: \"\"\n        AWS_S3_SECRET_ACCESS_KEY: \"\"\n      resources:\n        requests:\n          cpu: 200m\n          memory: 512Mi\n\n  frontend:\n    deployment:\n      env:\n        # ponytail: internal service name, not the ingress host\n        NX_API_INTERNAL_BASE_URL: \"http://nx-cloud-nx-api-service\"\n      envValueFrom:\n        # ponytail: SAML_ENTRY_POINT + SAML_CERT injected via nx-cloud-secrets.\n        # Set TF_VAR_nx_cloud_saml_cert in .env (Authentik IdP signing cert PEM).\n        # SAML_ENTRY_POINT is constructed from TS_HOST in Tiltfile.\n        # Empty values = SAML SSO disabled until .env is configured.\n        SAML_ENTRY_POINT:\n          secretKeyRef:\n            name: nx-cloud-secrets\n            key: SAML_ENTRY_POINT\n            optional: true\n        SAML_CERT:\n          secretKeyRef:\n            name: nx-cloud-secrets\n            key: SAML_CERT\n            optional: true\n      resources:\n        requests:\n          cpu: 100m\n          memory: 256Mi\n\n  aggregator:\n    cronjob:\n      env:\n        NX_CLOUD_LOG_OUTPUT_FORMAT: \"json\"\n      envValueFrom:\n        ADMIN_PASSWORD:\n          secretKeyRef:\n            name: nx-cloud-secrets\n            key: ADMIN_PASSWORD\n      resources:\n        requests:\n          cpu: 200m\n          memory: 512Mi\n\nmongodb:\n  architecture: replicaset\n  replicaCount: 1\n  arbiter:\n    enabled: false\n  auth:\n    enabled: true\n    rootPassword: \"\"  # set via Tiltfile/terraform\n    databases:\n      - nx-cloud\n    usernames:\n      - nx-cloud\n    passwords:\n      - \"\"  # set via Tiltfile/terraform\n  resources:\n    requests:\n      cpu: 100m\n      memory: 256Mi\n  persistence:\n    size: 8Gi\n  # ponytail: nx-api writes to `nrwl-api` db (hardcoded), user is created on `nx-cloud` db.\n  # Grant runs on fresh PVC init only — existing PVC already has the grant applied manually.\n  initdbScripts:\n    grant-nrwl-api.js: |\n      db = db.getSiblingDB('nx-cloud');\n      db.grantRolesToUser('nx-cloud', [{role: 'readWrite', db: 'nrwl-api'}]);\n\nvalkey:\n  architecture: standalone\n  auth:\n    enabled: true\n    password: \"\"  # set via Tiltfile/terraform\n  resources:\n    requests:\n      cpu: 50m\n      memory: 64Mi\n  primary:\n    persistence:\n      enabled: false\n"],"verify":false,"version":"0.1.0","wait":false,"wait_for_jobs":false},"sensitive_attributes":[[{"type":"get_attr","value":"repository_password"}],[{"type":"get_attr","value":"set_sensitive"}]],"private":"eyJzY2hlbWFfdmVyc2lvbiI6IjEifQ==","dependencies":["kubernetes_namespace.nx_cloud","kubernetes_secret.nx_cloud_secrets"]}]},{"mode":"managed","type":"helm_release","name":"observability","provider":"provider[\"registry.opentofu.org/hashicorp/helm\"]","instances":[{"schema_version":1,"attributes":{"atomic":false,"chart":"./../helm/observability","cleanup_on_fail":false,"create_namespace":false,"dependency_update":true,"description":null,"devel":null,"disable_crd_hooks":false,"disable_openapi_validation":false,"disable_webhooks":false,"force_update":false,"id":"observability","keyring":null,"lint":false,"manifest":null,"max_history":0,"metadata":[{"app_version":"","chart":"observability","first_deployed":1787800692,"last_deployed":1787801410,"name":"observability","namespace":"observability","notes":"***********************************************************************\n Welcome to Grafana Loki\n Chart version: 7.3.0\n Chart Name: loki\n Loki version: 3.6.12\n***********************************************************************\n\n** Please be patient while the chart is being deployed **\n\nTip:\n\n  Watch the deployment status using the command: kubectl get pods -w --namespace observability\n\nIf pods are taking too long to schedule make sure pod affinity can be fulfilled in the current cluster.\n\n***********************************************************************\nInstalled components:\n***********************************************************************\n* loki\n\nLoki has been deployed as a single binary.\nThis means a single pod is handling reads and writes. You can scale that pod vertically by adding more CPU and memory resources.\n\n\n***********************************************************************\nSending logs to Loki\n***********************************************************************\n\nYou can send logs from inside the cluster using the cluster DNS:\n\nhttp://observability-loki.observability.svc.cluster.local:3100/loki/api/v1/push\n\nYou can test to send data from outside the cluster by port-forwarding the gateway to your local machine:\n\n  kubectl port-forward --namespace observability svc/observability-loki 3100:3100 \u0026\n\nAnd then using http://127.0.0.1:3100/loki/api/v1/push URL as shown below:\n\n```\ncurl -H \"Content-Type: application/json\" -XPOST -s \"http://127.0.0.1:3100/loki/api/v1/push\"  \\\n--data-raw \"{\\\"streams\\\": [{\\\"stream\\\": {\\\"job\\\": \\\"test\\\"}, \\\"values\\\": [[\\\"$(date +%s)000000000\\\", \\\"fizzbuzz\\\"]]}]}\"\n```\n\nThen verify that Loki did receive the data using the following command:\n\n```\ncurl \"http://127.0.0.1:3100/loki/api/v1/query_range\" --data-urlencode 'query={job=\"test\"}' | jq .data.result\n```\n\n***********************************************************************\nConnecting Grafana to Loki\n***********************************************************************\n\nIf Grafana operates within the cluster, you'll set up a new Loki datasource by utilizing the following URL:\n\nhttp://observability-loki.observability.svc.cluster.local:3100/\n\nWelcome to Grafana Mimir!\nRemote write endpoints for Prometheus or Grafana Agent:\nIngress is not enabled, see the gateway.ingress values.\nFrom inside the cluster:\n  http://observability-mimir-gateway.observability.svc:80/api/v1/push\n\nRead address, Grafana data source (Prometheus) URL:\nIngress is not enabled, see the gateway.ingress values.\nFrom inside the cluster:\n  http://observability-mimir-gateway.observability.svc:80/prometheus\n\n**IMPORTANT**: Always consult CHANGELOG.md file at https://github.com/grafana/mimir/blob/main/operations/helm/charts/mimir-distributed/CHANGELOG.md and the deprecation list there to learn about breaking changes that require action during upgrade.\n\nkube-state-metrics is a simple service that listens to the Kubernetes API server and generates metrics about the state of the objects.\nThe exposed metrics can be found here:\nhttps://github.com/kubernetes/kube-state-metrics/blob/master/docs/README.md#exposed-metrics\n\nThe metrics are exported on the HTTP endpoint /metrics on the listening port.\nIn your case, observability-kube-state-metrics.observability.svc.cluster.local:8080/metrics\n\nThey are served either as plaintext or protobuf depending on the Accept header.\nThey are designed to be consumed either by Prometheus itself or by a scraper that is compatible with scraping a Prometheus client endpoint.\n\nWelcome to Grafana Alloy!\n\n1. Get the application URL by running these commands:\n  export POD_NAME=$(kubectl get pods --namespace observability -l \"app.kubernetes.io/name=prometheus-node-exporter,app.kubernetes.io/instance=observability\" -o jsonpath=\"{.items[0].metadata.name}\")\n  echo \"Visit http://127.0.0.1:9100 to use your application\"\n  kubectl port-forward --namespace observability $POD_NAME 9100\nThe Prometheus server can be accessed via port 80 on the following DNS name from within your cluster:\nobservability-prometheus-server.observability.svc.cluster.local\n\n\nGet the Prometheus server URL by running these commands in the same shell:\n  export POD_NAME=$(kubectl get pods --namespace observability -l \"app.kubernetes.io/name=prometheus,app.kubernetes.io/instance=observability\" -o jsonpath=\"{.items[0].metadata.name}\")\n  kubectl --namespace observability port-forward $POD_NAME 9090\n\n\n\n\n\nFor more information on running Prometheus, visit:\nhttps://prometheus.io/\n\n1. Get your 'admin' user password by running:\n\n   kubectl get secret --namespace observability observability-grafana -o jsonpath=\"{.data.admin-password}\" | base64 --decode ; echo\n\n\n2. The Grafana server can be accessed via port 80 on the following DNS name from within your cluster:\n\n   observability-grafana.observability.svc.cluster.local\n\n   If you bind grafana to 80, please update values in values.yaml and reinstall:\n   ```\n   securityContext:\n     runAsUser: 0\n     runAsGroup: 0\n     fsGroup: 0\n\n   command:\n   - \"setcap\"\n   - \"'cap_net_bind_service=+ep'\"\n   - \"/usr/sbin/grafana-server \u0026\u0026\"\n   - \"sh\"\n   - \"/run.sh\"\n   ```\n   Details refer to https://grafana.com/docs/installation/configuration/#http-port.\n   Or grafana would always crash.\n\n   From outside the cluster, the server URL(s) are:\n     http://grafana.local\n\n3. Login with the password from step 1 and the username: admin\n","revision":6,"values":"{\"alloy\":{\"alloy\":{\"configMap\":{\"content\":\"// ── K8s pod logs → Loki ──────────────────────────────────────────────\\ndiscovery.kubernetes \\\"pods\\\" {\\n  role = \\\"pod\\\"\\n}\\n\\ndiscovery.relabel \\\"pod_logs\\\" {\\n  targets = discovery.kubernetes.pods.targets\\n  rule {\\n    source_labels = [\\\"__meta_kubernetes_pod_node_name\\\"]\\n    target_label  = \\\"node\\\"\\n  }\\n  rule {\\n    source_labels = [\\\"__meta_kubernetes_namespace\\\"]\\n    target_label  = \\\"namespace\\\"\\n  }\\n  rule {\\n    source_labels = [\\\"__meta_kubernetes_pod_name\\\"]\\n    target_label  = \\\"pod\\\"\\n  }\\n  rule {\\n    source_labels = [\\\"__meta_kubernetes_pod_container_name\\\"]\\n    target_label  = \\\"container\\\"\\n  }\\n  rule {\\n    source_labels = [\\\"__meta_kubernetes_pod_label_app_kubernetes_io_name\\\"]\\n    target_label  = \\\"app\\\"\\n  }\\n}\\n\\nloki.source.kubernetes \\\"pods\\\" {\\n  targets    = discovery.relabel.pod_logs.output\\n  forward_to = [loki.write.default.receiver]\\n}\\n\\nloki.write \\\"default\\\" {\\n  endpoint {\\n    url = \\\"http://observability-loki.observability.svc.cluster.local:3100/loki/api/v1/push\\\"\\n  }\\n}\\n\\n// ── OTLP receiver (apps → Alloy) ─────────────────────────────────────\\notelcol.receiver.otlp \\\"default\\\" {\\n  http { endpoint = \\\"0.0.0.0:4318\\\" }\\n  grpc { endpoint = \\\"0.0.0.0:4317\\\" }\\n  output {\\n    metrics = [otelcol.exporter.prometheus.mimir.input]\\n    logs    = [otelcol.exporter.loki.default.input]\\n    traces  = [otelcol.exporter.otlp.tempo.input]\\n  }\\n}\\n\\n// ── OTLP metrics → Mimir ─────────────────────────────────────────────\\notelcol.exporter.prometheus \\\"mimir\\\" {\\n  forward_to = [prometheus.remote_write.mimir.receiver]\\n}\\n\\nprometheus.remote_write \\\"mimir\\\" {\\n  endpoint {\\n    url = \\\"http://observability-mimir-distributed-distributor.observability.svc.cluster.local:8080/api/v1/push\\\"\\n  }\\n}\\n\\n// ── OTLP logs → Loki ─────────────────────────────────────────────────\\notelcol.exporter.loki \\\"default\\\" {\\n  forward_to = [loki.write.default.receiver]\\n}\\n\\n// ── OTLP traces → Tempo ──────────────────────────────────────────────\\notelcol.exporter.otlp \\\"tempo\\\" {\\n  client {\\n    endpoint = \\\"observability-tempo.observability.svc.cluster.local:4317\\\"\\n    tls { insecure = true }\\n  }\\n}\\n\"},\"extraPorts\":[{\"name\":\"otlp-grpc\",\"port\":4317,\"protocol\":\"TCP\",\"targetPort\":4317},{\"name\":\"otlp-http\",\"port\":4318,\"protocol\":\"TCP\",\"targetPort\":4318}]},\"clustering\":{\"enabled\":false},\"rbac\":{\"create\":true},\"serviceAccount\":{\"create\":true}},\"grafana\":{\"adminPassword\":\"dev-grafana-admin-password\",\"assertNoLeakedSecrets\":false,\"datasources\":{\"datasources.yaml\":{\"apiVersion\":1,\"datasources\":[{\"isDefault\":true,\"jsonData\":{\"timeInterval\":\"15s\"},\"name\":\"Mimir\",\"type\":\"prometheus\",\"uid\":\"mimir\",\"url\":\"http://observability-mimir-distributed-query-frontend.observability.svc.cluster.local:8080/prometheus\"},{\"jsonData\":{\"timeInterval\":\"15s\"},\"name\":\"Prometheus\",\"type\":\"prometheus\",\"uid\":\"prometheus\",\"url\":\"http://observability-prometheus-server.observability.svc.cluster.local\"},{\"name\":\"Loki\",\"type\":\"loki\",\"uid\":\"loki\",\"url\":\"http://observability-loki.observability.svc.cluster.local:3100\"},{\"jsonData\":{\"serviceMap\":{\"datasourceUid\":\"mimir\"},\"tracesToLogsV2\":{\"datasourceUid\":\"loki\"}},\"name\":\"Tempo\",\"type\":\"tempo\",\"uid\":\"tempo\",\"url\":\"http://observability-tempo.observability.svc.cluster.local:3100\"}]}},\"grafana.ini\":{\"auth\":{\"disable_login_form\":\"false\"},\"auth.generic_oauth\":{\"allow_sign_up\":\"true\",\"api_url\":\"http://authentik-server.authentik.svc.cluster.local/application/o/userinfo/\",\"auth_url\":\"https://desktop-qv5aogf.tail60240b.ts.net:8443/application/o/authorize/\",\"client_id\":\"dev-grafana-oidc-client-id\",\"client_secret\":\"dev-grafana-oidc-client-secret-not-for-prod-use\",\"enabled\":\"true\",\"name\":\"Authentik\",\"role_attribute_path\":\"email == 'edwardlimkoksiong1994@gmail.com' \\u0026\\u0026 'Admin' || 'Viewer'\",\"scopes\":\"openid profile email\",\"token_url\":\"http://authentik-server.authentik.svc.cluster.local/application/o/token/\"},\"server\":{\"root_url\":\"https://desktop-qv5aogf.tail60240b.ts.net:8451\"}},\"ingress\":{\"annotations\":{\"cert-manager.io/cluster-issuer\":\"homelab-ca-issuer\"},\"enabled\":true,\"hosts\":[\"grafana.local\"],\"ingressClassName\":\"traefik\",\"tls\":[{\"hosts\":[\"grafana.local\"],\"secretName\":\"grafana.local-tls\"}]},\"persistence\":{\"enabled\":true,\"size\":\"2Gi\"},\"resources\":{\"limits\":{\"memory\":\"256Mi\"},\"requests\":{\"cpu\":\"50m\",\"memory\":\"128Mi\"}}},\"loki\":{\"backend\":{\"replicas\":0},\"chunksCache\":{\"enabled\":false},\"deploymentMode\":\"SingleBinary\",\"gateway\":{\"enabled\":false},\"loki\":{\"auth_enabled\":false,\"commonConfig\":{\"replication_factor\":1},\"schemaConfig\":{\"configs\":[{\"from\":\"2024-01-01\",\"index\":{\"period\":\"24h\",\"prefix\":\"index_\"},\"object_store\":\"filesystem\",\"schema\":\"v13\",\"store\":\"tsdb\"}]},\"storage\":{\"type\":\"filesystem\"}},\"lokiCanary\":{\"enabled\":false},\"read\":{\"replicas\":0},\"resultsCache\":{\"enabled\":false},\"singleBinary\":{\"persistence\":{\"enabled\":true,\"size\":\"10Gi\"},\"replicas\":1,\"resources\":{\"limits\":{\"memory\":\"512Mi\"},\"requests\":{\"cpu\":\"50m\",\"memory\":\"256Mi\"}}},\"test\":{\"enabled\":false},\"write\":{\"replicas\":0}},\"mimir-distributed\":{\"alertmanager\":{\"enabled\":false},\"compactor\":{\"persistentVolume\":{\"enabled\":true,\"size\":\"10Gi\"},\"replicas\":1,\"resources\":{\"limits\":{\"memory\":\"256Mi\"},\"requests\":{\"cpu\":\"50m\",\"memory\":\"128Mi\"}}},\"distributor\":{\"replicas\":1,\"resources\":{\"limits\":{\"memory\":\"256Mi\"},\"requests\":{\"cpu\":\"50m\",\"memory\":\"128Mi\"}}},\"ingester\":{\"persistentVolume\":{\"enabled\":true,\"size\":\"10Gi\"},\"replicas\":1,\"resources\":{\"limits\":{\"memory\":\"512Mi\"},\"requests\":{\"cpu\":\"50m\",\"memory\":\"256Mi\"}},\"zoneAwareReplication\":{\"enabled\":false}},\"kafka\":{\"enabled\":false},\"mimir\":{\"structuredConfig\":{\"blocks_storage\":{\"backend\":\"filesystem\",\"filesystem\":{\"dir\":\"/data/blocks\"}},\"common\":{\"storage\":{\"backend\":\"filesystem\",\"filesystem\":{\"dir\":\"/data\"}}},\"compactor\":{\"data_dir\":\"/data/compactor\"},\"ingest_storage\":{\"enabled\":false},\"ingester\":{\"push_grpc_method_enabled\":true},\"multitenancy_enabled\":false,\"usage_stats\":{\"enabled\":false}}},\"minio\":{\"enabled\":false},\"overrides_exporter\":{\"enabled\":false},\"querier\":{\"replicas\":1,\"resources\":{\"limits\":{\"memory\":\"256Mi\"},\"requests\":{\"cpu\":\"50m\",\"memory\":\"128Mi\"}}},\"query_frontend\":{\"replicas\":1,\"resources\":{\"limits\":{\"memory\":\"256Mi\"},\"requests\":{\"cpu\":\"50m\",\"memory\":\"128Mi\"}}},\"query_scheduler\":{\"enabled\":false},\"rollout_operator\":{\"enabled\":false},\"ruler\":{\"enabled\":false},\"store_gateway\":{\"persistentVolume\":{\"enabled\":true,\"size\":\"10Gi\"},\"replicas\":1,\"resources\":{\"limits\":{\"memory\":\"256Mi\"},\"requests\":{\"cpu\":\"50m\",\"memory\":\"128Mi\"}},\"zoneAwareReplication\":{\"enabled\":false}}},\"prometheus\":{\"alertmanager\":{\"enabled\":false},\"kube-state-metrics\":{\"enabled\":true},\"prometheus-node-exporter\":{\"enabled\":true},\"prometheus-pushgateway\":{\"enabled\":false},\"server\":{\"global\":{\"evaluation_interval\":\"15s\",\"scrape_interval\":\"15s\"},\"persistentVolume\":{\"enabled\":true,\"size\":\"10Gi\"},\"remoteWrite\":[{\"url\":\"http://observability-mimir-distributed-distributor.observability.svc.cluster.local:8080/api/v1/push\"}],\"resources\":{\"limits\":{\"memory\":\"512Mi\"},\"requests\":{\"cpu\":\"50m\",\"memory\":\"256Mi\"}},\"retention\":\"7d\"}},\"tempo\":{\"persistence\":{\"enabled\":true,\"size\":\"10Gi\"},\"resources\":{\"limits\":{\"memory\":\"512Mi\"},\"requests\":{\"cpu\":\"50m\",\"memory\":\"256Mi\"}},\"tempo\":{\"receivers\":{\"otlp\":{\"protocols\":{\"grpc\":{\"endpoint\":\"0.0.0.0:4317\"},\"http\":{\"endpoint\":\"0.0.0.0:4318\"}}}},\"storage\":{\"trace\":{\"backend\":\"local\",\"local\":{\"path\":\"/var/tempo/traces\"},\"wal\":{\"path\":\"/var/tempo/wal\"}}}}}}","version":"0.1.0"}],"name":"observability","namespace":"observability","pass_credentials":false,"postrender":[],"recreate_pods":false,"render_subchart_notes":true,"replace":false,"repository":null,"repository_ca_file":null,"repository_cert_file":null,"repository_key_file":null,"repository_password":null,"repository_username":null,"reset_values":false,"reuse_values":false,"set":[],"set_list":[],"set_sensitive":[],"skip_crds":false,"status":"deployed","timeout":900,"upgrade_install":null,"values":["grafana:\n  # ponytail: chart refuses to render any sensitive key (client_secret,\n  # adminPassword, etc.) in plain values as a guard against accidental\n  # secret commits. Our placeholder-replacement approach handles this at\n  # Tiltfile load time — disable the guard so helm template succeeds.\n  assertNoLeakedSecrets: false\n\n  adminPassword: \"dev-grafana-admin-password\"\n\n  grafana.ini:\n    server:\n      root_url: \"https://desktop-qv5aogf.tail60240b.ts.net:8451\"\n    auth:\n      # ponytail: keep login form so local admin still works as fallback\n      disable_login_form: \"false\"\n    auth.generic_oauth:\n      enabled: \"true\"\n      name: \"Authentik\"\n      client_id: \"dev-grafana-oidc-client-id\"\n      client_secret: \"dev-grafana-oidc-client-secret-not-for-prod-use\"\n      scopes: \"openid profile email\"\n      auth_url: \"https://desktop-qv5aogf.tail60240b.ts.net:8443/application/o/authorize/\"\n      # ponytail: token/userinfo use in-cluster DNS — browser never touches\n      # these endpoints so no need for the Tailscale HTTPS port here.\n      token_url: \"http://authentik-server.authentik.svc.cluster.local/application/o/token/\"\n      api_url: \"http://authentik-server.authentik.svc.cluster.local/application/o/userinfo/\"\n      role_attribute_path: \"email == 'edwardlimkoksiong1994@gmail.com' \u0026\u0026 'Admin' || 'Viewer'\"\n      allow_sign_up: \"true\"\n\n  datasources:\n    datasources.yaml:\n      apiVersion: 1\n      datasources:\n        - name: Mimir\n          uid: mimir\n          type: prometheus\n          url: http://observability-mimir-distributed-query-frontend.observability.svc.cluster.local:8080/prometheus\n          isDefault: true\n          jsonData:\n            timeInterval: 15s\n        - name: Prometheus\n          uid: prometheus\n          type: prometheus\n          url: http://observability-prometheus-server.observability.svc.cluster.local\n          jsonData:\n            timeInterval: 15s\n        - name: Loki\n          uid: loki\n          type: loki\n          url: http://observability-loki.observability.svc.cluster.local:3100\n        - name: Tempo\n          uid: tempo\n          type: tempo\n          url: http://observability-tempo.observability.svc.cluster.local:3100\n          jsonData:\n            tracesToLogsV2:\n              datasourceUid: loki\n            serviceMap:\n              datasourceUid: mimir\n\n  ingress:\n    enabled: true\n    ingressClassName: traefik\n    annotations:\n      cert-manager.io/cluster-issuer: homelab-ca-issuer\n    hosts:\n      - grafana.local\n    tls:\n      - secretName: grafana.local-tls\n        hosts:\n          - grafana.local\n\n  persistence:\n    enabled: true\n    size: 2Gi\n\n  resources:\n    requests:\n      cpu: 50m\n      memory: 128Mi\n    limits:\n      memory: 256Mi\n\n# ── Loki ──────────────────────────────────────────────────────────────────────\nloki:\n  # ponytail: SingleBinary = one pod, no object storage, no kafka, no cache.\n  # SimpleScalable (chart default) needs 3 write + 3 read + 3 backend pods —\n  # far too heavy for a single-node homelab.\n  deploymentMode: SingleBinary\n\n  loki:\n    auth_enabled: false\n    commonConfig:\n      replication_factor: 1\n    storage:\n      type: filesystem\n    schemaConfig:\n      configs:\n        - from: \"2024-01-01\"\n          store: tsdb\n          object_store: filesystem\n          schema: v13\n          index:\n            prefix: index_\n            period: 24h\n\n  singleBinary:\n    replicas: 1\n    persistence:\n      enabled: true\n      size: 10Gi\n    resources:\n      requests:\n        cpu: 50m\n        memory: 256Mi\n      limits:\n        memory: 512Mi\n\n  # ponytail: zero out the scalable-mode components that SingleBinary doesn't use\n  read:\n    replicas: 0\n  write:\n    replicas: 0\n  backend:\n    replicas: 0\n\n  gateway:\n    enabled: false\n  lokiCanary:\n    enabled: false\n  test:\n    enabled: false\n  # ponytail: caches need memcached sub-charts — overkill for homelab\n  chunksCache:\n    enabled: false\n  resultsCache:\n    enabled: false\n\n# ── Tempo ─────────────────────────────────────────────────────────────────────\ntempo:\n  tempo:\n    storage:\n      trace:\n        backend: local\n        local:\n          path: /var/tempo/traces\n        wal:\n          path: /var/tempo/wal\n    receivers:\n      otlp:\n        protocols:\n          grpc:\n            endpoint: 0.0.0.0:4317\n          http:\n            endpoint: 0.0.0.0:4318\n\n  persistence:\n    enabled: true\n    size: 10Gi\n\n  resources:\n    requests:\n      cpu: 50m\n      memory: 256Mi\n    limits:\n      memory: 512Mi\n\n# ── Mimir ─────────────────────────────────────────────────────────────────────\nmimir-distributed:\n  # ponytail: chart defaults to ingest-storage architecture (Kafka between\n  # distributor and ingester) — one more stateful thing to babysit for no\n  # benefit on a single-node homelab. Classic push-based ingesters instead.\n  kafka:\n    enabled: false\n\n  mimir:\n    structuredConfig:\n      multitenancy_enabled: false\n      # ponytail: usage-stats reporter defaults to its own S3 bucket client\n      # regardless of common.storage.backend — fails hard with no S3 endpoint\n      # configured. No need for anonymous telemetry on a homelab anyway.\n      usage_stats:\n        enabled: false\n      common:\n        storage:\n          backend: filesystem\n          filesystem:\n            dir: /data\n      # ponytail: chart's base config hardcodes blocks_storage.backend: s3\n      # (for its bundled minio demo) — component-specific config always wins\n      # over `common`, so filesystem must be set here explicitly too.\n      blocks_storage:\n        backend: filesystem\n        # ponytail: must differ from tsdb.dir (chart default /data/tsdb) —\n        # filesystem.dir is the simulated \"bucket\", tsdb.dir is local WAL/head.\n        filesystem:\n          dir: /data/blocks\n      # ponytail: chart default compactor.data_dir is \"/data\", which is a\n      # parent of blocks_storage.filesystem.dir above — must be a sibling.\n      compactor:\n        data_dir: /data/compactor\n      ingest_storage:\n        enabled: false\n      ingester:\n        push_grpc_method_enabled: true\n\n  # ponytail: single replicas throughout — no HA, no zone awareness.\n  # The rollout_operator and zone-aware replication exist for production\n  # multi-zone clusters, not a one-node homelab.\n  rollout_operator:\n    enabled: false\n\n  ingester:\n    replicas: 1\n    zoneAwareReplication:\n      enabled: false\n    persistentVolume:\n      enabled: true\n      size: 10Gi\n    resources:\n      requests:\n        cpu: 50m\n        memory: 256Mi\n      limits:\n        memory: 512Mi\n\n  distributor:\n    replicas: 1\n    resources:\n      requests:\n        cpu: 50m\n        memory: 128Mi\n      limits:\n        memory: 256Mi\n\n  querier:\n    replicas: 1\n    resources:\n      requests:\n        cpu: 50m\n        memory: 128Mi\n      limits:\n        memory: 256Mi\n\n  query_frontend:\n    replicas: 1\n    resources:\n      requests:\n        cpu: 50m\n        memory: 128Mi\n      limits:\n        memory: 256Mi\n\n  compactor:\n    replicas: 1\n    persistentVolume:\n      enabled: true\n      size: 10Gi\n    resources:\n      requests:\n        cpu: 50m\n        memory: 128Mi\n      limits:\n        memory: 256Mi\n\n  store_gateway:\n    replicas: 1\n    zoneAwareReplication:\n      enabled: false\n    persistentVolume:\n      enabled: true\n      size: 10Gi\n    resources:\n      requests:\n        cpu: 50m\n        memory: 128Mi\n      limits:\n        memory: 256Mi\n\n  # ponytail: disable optional components not needed for basic metrics ingestion\n  alertmanager:\n    enabled: false\n  ruler:\n    enabled: false\n  query_scheduler:\n    enabled: false\n  overrides_exporter:\n    enabled: false\n\n  # ponytail: mimir-distributed bundles its own minio subchart for demos;\n  # we use the already-deployed MinIO in the minio namespace instead.\n  minio:\n    enabled: false\n\n# ── Alloy ─────────────────────────────────────────────────────────────────────\nalloy:\n  alloy:\n    # ponytail: extraPorts needed so the Service exposes OTLP endpoints\n    # for apps to send traces/metrics/logs to. Without this, only Alloy's\n    # own UI port (12345) is in the Service spec.\n    extraPorts:\n      - name: otlp-grpc\n        port: 4317\n        targetPort: 4317\n        protocol: TCP\n      - name: otlp-http\n        port: 4318\n        targetPort: 4318\n        protocol: TCP\n\n    configMap:\n      content: |\n        // ── K8s pod logs → Loki ──────────────────────────────────────────────\n        discovery.kubernetes \"pods\" {\n          role = \"pod\"\n        }\n\n        discovery.relabel \"pod_logs\" {\n          targets = discovery.kubernetes.pods.targets\n          rule {\n            source_labels = [\"__meta_kubernetes_pod_node_name\"]\n            target_label  = \"node\"\n          }\n          rule {\n            source_labels = [\"__meta_kubernetes_namespace\"]\n            target_label  = \"namespace\"\n          }\n          rule {\n            source_labels = [\"__meta_kubernetes_pod_name\"]\n            target_label  = \"pod\"\n          }\n          rule {\n            source_labels = [\"__meta_kubernetes_pod_container_name\"]\n            target_label  = \"container\"\n          }\n          rule {\n            source_labels = [\"__meta_kubernetes_pod_label_app_kubernetes_io_name\"]\n            target_label  = \"app\"\n          }\n        }\n\n        loki.source.kubernetes \"pods\" {\n          targets    = discovery.relabel.pod_logs.output\n          forward_to = [loki.write.default.receiver]\n        }\n\n        loki.write \"default\" {\n          endpoint {\n            url = \"http://observability-loki.observability.svc.cluster.local:3100/loki/api/v1/push\"\n          }\n        }\n\n        // ── OTLP receiver (apps → Alloy) ─────────────────────────────────────\n        otelcol.receiver.otlp \"default\" {\n          http { endpoint = \"0.0.0.0:4318\" }\n          grpc { endpoint = \"0.0.0.0:4317\" }\n          output {\n            metrics = [otelcol.exporter.prometheus.mimir.input]\n            logs    = [otelcol.exporter.loki.default.input]\n            traces  = [otelcol.exporter.otlp.tempo.input]\n          }\n        }\n\n        // ── OTLP metrics → Mimir ─────────────────────────────────────────────\n        otelcol.exporter.prometheus \"mimir\" {\n          forward_to = [prometheus.remote_write.mimir.receiver]\n        }\n\n        prometheus.remote_write \"mimir\" {\n          endpoint {\n            url = \"http://observability-mimir-distributed-distributor.observability.svc.cluster.local:8080/api/v1/push\"\n          }\n        }\n\n        // ── OTLP logs → Loki ─────────────────────────────────────────────────\n        otelcol.exporter.loki \"default\" {\n          forward_to = [loki.write.default.receiver]\n        }\n\n        // ── OTLP traces → Tempo ──────────────────────────────────────────────\n        otelcol.exporter.otlp \"tempo\" {\n          client {\n            endpoint = \"observability-tempo.observability.svc.cluster.local:4317\"\n            tls { insecure = true }\n          }\n        }\n\n  clustering:\n    enabled: false\n\n  rbac:\n    create: true\n\n  serviceAccount:\n    create: true\n\n# ── Prometheus ────────────────────────────────────────────────────────────────\nprometheus:\n  server:\n    global:\n      scrape_interval: 15s\n      evaluation_interval: 15s\n    # ponytail: remote_write to Mimir so metrics survive beyond Prometheus's\n    # own retention window and are queryable from Grafana's Mimir datasource.\n    remoteWrite:\n      - url: \"http://observability-mimir-distributed-distributor.observability.svc.cluster.local:8080/api/v1/push\"\n    persistentVolume:\n      enabled: true\n      size: 10Gi\n    retention: \"7d\"\n    resources:\n      requests:\n        cpu: 50m\n        memory: 256Mi\n      limits:\n        memory: 512Mi\n\n  alertmanager:\n    enabled: false\n  prometheus-pushgateway:\n    enabled: false\n  kube-state-metrics:\n    enabled: true\n  prometheus-node-exporter:\n    enabled: true\n"],"verify":false,"version":"0.1.0","wait":false,"wait_for_jobs":false},"sensitive_attributes":[[{"type":"get_attr","value":"repository_password"}],[{"type":"get_attr","value":"values"},{"type":"index","value":{"value":0,"type":"number"}}]],"private":"eyJzY2hlbWFfdmVyc2lvbiI6IjEifQ==","dependencies":["kubernetes_namespace.observability"]}]},{"mode":"managed","type":"helm_release","name":"openwebui","provider":"provider[\"registry.opentofu.org/hashicorp/helm\"]","instances":[{"schema_version":1,"attributes":{"atomic":false,"chart":"./../helm/openwebui","cleanup_on_fail":false,"create_namespace":false,"dependency_update":true,"description":null,"devel":null,"disable_crd_hooks":false,"disable_openapi_validation":false,"disable_webhooks":false,"force_update":false,"id":"openwebui","keyring":null,"lint":false,"manifest":null,"max_history":0,"metadata":[{"app_version":"","chart":"openwebui","first_deployed":1787798862,"last_deployed":1787798862,"name":"openwebui","namespace":"openwebui","notes":"","revision":1,"values":"{\"env\":{\"ENABLE_LOGIN_FORM\":\"False\",\"ENABLE_OAUTH_ROLE_MANAGEMENT\":\"true\",\"ENABLE_OAUTH_SIGNUP\":\"true\",\"ENABLE_PERSISTENT_CONFIG\":\"False\",\"OAUTH_ADMIN_ROLES\":\"admin\",\"OAUTH_CLIENT_ID\":\"dev-openwebui-oidc-client-id\",\"OAUTH_CLIENT_SECRET\":\"dev-openwebui-oidc-client-secret-not-for-prod-use\",\"OAUTH_PROVIDER_NAME\":\"Authentik\",\"OAUTH_ROLES_CLAIM\":\"roles\",\"OAUTH_SCOPES\":\"openid profile email openwebui_roles\",\"OLLAMA_BASE_URL\":\"\",\"OPENAI_API_BASE_URL\":\"http://litellm.litellm.svc.cluster.local:4000\",\"OPENAI_API_KEY\":\"sk-dev-litellm-master-key-not-for-prod-use\",\"OPENID_PROVIDER_URL\":\"https://desktop-qv5aogf.tail60240b.ts.net:8443/application/o/openwebui/.well-known/openid-configuration\",\"RESET_CONFIG_ON_START\":\"True\",\"SSL_CERT_FILE\":\"/certs/ca.crt\",\"WEBUI_URL\":\"https://desktop-qv5aogf.tail60240b.ts.net:8452\"},\"image\":{\"repository\":\"ghcr.io/open-webui/open-webui\",\"tag\":\"main\"},\"resources\":{\"limits\":{\"memory\":\"2Gi\"},\"requests\":{\"cpu\":\"100m\",\"memory\":\"512Mi\"}},\"storageSize\":\"5Gi\"}","version":"0.1.0"}],"name":"openwebui","namespace":"openwebui","pass_credentials":false,"postrender":[],"recreate_pods":false,"render_subchart_notes":true,"replace":false,"repository":null,"repository_ca_file":null,"repository_cert_file":null,"repository_key_file":null,"repository_password":null,"repository_username":null,"reset_values":false,"reuse_values":false,"set":[],"set_list":[],"set_sensitive":[],"skip_crds":false,"status":"deployed","timeout":600,"upgrade_install":null,"values":["image:\n  repository: ghcr.io/open-webui/open-webui\n  tag: main\n\nstorageSize: 5Gi\n\nenv:\n  # LiteLLM as OpenAI-compatible backend\n  OPENAI_API_BASE_URL: \"http://litellm.litellm.svc.cluster.local:4000\"\n  OPENAI_API_KEY: \"sk-dev-litellm-master-key-not-for-prod-use\"\n  OLLAMA_BASE_URL: \"\"\n\n  # OIDC / Authentik\n  ENABLE_OAUTH_SIGNUP: \"true\"\n  OAUTH_PROVIDER_NAME: \"Authentik\"\n  OPENID_PROVIDER_URL: \"https://desktop-qv5aogf.tail60240b.ts.net:8443/application/o/openwebui/.well-known/openid-configuration\"\n  OAUTH_CLIENT_ID: \"dev-openwebui-oidc-client-id\"\n  OAUTH_CLIENT_SECRET: \"dev-openwebui-oidc-client-secret-not-for-prod-use\"\n  OAUTH_SCOPES: \"openid profile email openwebui_roles\"\n  ENABLE_OAUTH_ROLE_MANAGEMENT: \"true\"\n  OAUTH_ROLES_CLAIM: \"roles\"\n  OAUTH_ADMIN_ROLES: \"admin\"\n  WEBUI_URL: \"https://desktop-qv5aogf.tail60240b.ts.net:8452\"\n\n  # ponytail: ENABLE_LOGIN_FORM=False — SSO only. First SSO login by admin\n  # gets Admin role via openwebui_roles claim from Authentik.\n  ENABLE_LOGIN_FORM: \"False\"\n  ENABLE_PERSISTENT_CONFIG: \"False\"\n  RESET_CONFIG_ON_START: \"True\"\n\n  # ponytail: server-side OIDC calls go to Tailscale HTTPS; SSL_CERT_FILE\n  # trusts the homelab self-signed CA mounted from the homelab-ca Secret.\n  SSL_CERT_FILE: \"/certs/ca.crt\"\n\nresources:\n  requests:\n    cpu: 100m\n    memory: 512Mi\n  limits:\n    memory: 2Gi\n"],"verify":false,"version":"0.1.0","wait":true,"wait_for_jobs":false},"sensitive_attributes":[[{"type":"get_attr","value":"repository_password"}],[{"type":"get_attr","value":"values"},{"type":"index","value":{"value":0,"type":"number"}}]],"private":"eyJzY2hlbWFfdmVyc2lvbiI6IjEifQ==","dependencies":["data.kubernetes_secret.homelab_ca","helm_release.cert_manager","kubectl_manifest.homelab_ca","kubectl_manifest.selfsigned_bootstrap","kubernetes_namespace.cert_manager","kubernetes_namespace.openwebui","kubernetes_secret.openwebui_homelab_ca"]}]},{"mode":"managed","type":"helm_release","name":"seafile","provider":"provider[\"registry.opentofu.org/hashicorp/helm\"]","instances":[{"schema_version":1,"attributes":{"atomic":false,"chart":"./../helm/seafile","cleanup_on_fail":false,"create_namespace":false,"dependency_update":false,"description":null,"devel":null,"disable_crd_hooks":false,"disable_openapi_validation":false,"disable_webhooks":false,"force_update":false,"id":"seafile","keyring":null,"lint":false,"manifest":null,"max_history":0,"metadata":[{"app_version":"","chart":"seafile","first_deployed":1787792562,"last_deployed":1787809188,"name":"seafile","namespace":"seafile","notes":"CHART NAME: mariadb\nCHART VERSION: 11.4.2\nAPP VERSION: 10.6.11\n\n** Please be patient while the chart is being deployed **\n\nTip:\n\n  Watch the deployment status using the command: kubectl get pods -w --namespace seafile -l app.kubernetes.io/instance=seafile\n\nServices:\n\n  echo Primary: seafile-mariadb.seafile.svc.cluster.local:3306\n\nAdministrator credentials:\n\n  Username: root\n  Password : $(kubectl get secret --namespace seafile seafile-mariadb -o jsonpath=\"{.data.mariadb-root-password}\" | base64 -d)\n\nTo connect to your database:\n\n  1. Run a pod that you can use as a client:\n\n      kubectl run seafile-mariadb-client --rm --tty -i --restart='Never' --image  docker.io/bitnamilegacy/mariadb:11.8.3-debian-12-r0 --namespace seafile --command -- bash\n\n  2. To connect to primary service (read/write):\n\n      mysql -h seafile-mariadb.seafile.svc.cluster.local -uroot -p seafile\n\nTo upgrade this helm chart:\n\n  1. Obtain the password as described on the 'Administrator credentials' section and set the 'auth.rootPassword' parameter as shown below:\n\n      ROOT_PASSWORD=$(kubectl get secret --namespace seafile seafile-mariadb -o jsonpath=\"{.data.mariadb-root-password}\" | base64 -d)\n      helm upgrade --namespace seafile seafile my-repo/mariadb --set auth.rootPassword=$ROOT_PASSWORD\n\n\n1. Access the application by visiting one of these URL's:\n\n  - http://seafile.local/","revision":4,"values":"{\"seafile\":{\"env\":{\"INIT_SEAFILE_ADMIN_EMAIL\":\"admin@seafile.local\",\"INIT_SEAFILE_ADMIN_PASSWORD\":\"(sensitive value)\",\"INIT_SEAFILE_MYSQL_ROOT_PASSWORD\":\"(sensitive value)\",\"JWT_PRIVATE_KEY\":\"(sensitive value)\",\"OAUTHLIB_INSECURE_TRANSPORT\":\"1\",\"REDIS_HOST\":\"seafile-redis\",\"REDIS_PORT\":\"6379\",\"SEAFILE_MYSQL_DB_CCNET_DB_NAME\":\"ccnet_db\",\"SEAFILE_MYSQL_DB_HOST\":\"seafile-mariadb\",\"SEAFILE_MYSQL_DB_PASSWORD\":\"(sensitive value)\",\"SEAFILE_MYSQL_DB_SEAFILE_DB_NAME\":\"seafile_db\",\"SEAFILE_MYSQL_DB_SEAHUB_DB_NAME\":\"seahub_db\",\"SEAFILE_MYSQL_DB_USER\":\"seafile\",\"SEAFILE_SERVER_HOSTNAME\":\"desktop-qv5aogf.tail60240b.ts.net:8449\",\"SEAFILE_SERVER_LETSENCRYPT\":false,\"SEAFILE_SERVER_PROTOCOL\":\"https\",\"TIME_ZONE\":\"Asia/Singapore\"},\"image\":{\"tag\":\"13.0.25\"},\"ingress\":{\"main\":{\"annotations\":{\"cert-manager.io/cluster-issuer\":\"homelab-ca-issuer\"},\"enabled\":true,\"hosts\":[{\"host\":\"seafile.local\",\"paths\":[{\"path\":\"/\",\"pathType\":\"Prefix\"}]}],\"ingressClassName\":\"traefik\",\"tls\":[{\"hosts\":[\"seafile.local\"],\"secretName\":\"seafile.local-tls\"}]}},\"lifecycle\":{\"postStart\":{\"exec\":{\"command\":[\"/bin/sh\",\"-c\",\"i=0; while [ ! -f /shared/seafile/conf/seahub_settings.py ] \\u0026\\u0026 [ $i -lt 240 ]; do sleep 1; i=$((i+1)); done; if [ -f /shared/seafile/conf/seahub_settings.py ] \\u0026\\u0026 ! grep -q 'Authentik OIDC login' /shared/seafile/conf/seahub_settings.py; then printf '%s\\\\n' '' '# Authentik OIDC login' 'CSRF_TRUSTED_ORIGINS = [\\\"https://desktop-qv5aogf.tail60240b.ts.net:8449\\\"]' 'ENABLE_OAUTH = True' 'OAUTH_CLIENT_ID = \\\"dev-seafile-oidc-client-id\\\"' 'OAUTH_CLIENT_SECRET = \\\"dev-seafile-oidc-client-secret-not-for-prod-use\\\"' 'OAUTH_REDIRECT_URL = \\\"https://desktop-qv5aogf.tail60240b.ts.net:8449/oauth/callback/\\\"' 'OAUTH_PROVIDER = \\\"authentik\\\"' 'OAUTH_PROVIDER_DOMAIN = \\\"authentik\\\"' 'OAUTH_AUTHORIZATION_URL = \\\"https://desktop-qv5aogf.tail60240b.ts.net:8443/application/o/authorize/\\\"' 'OAUTH_TOKEN_URL = \\\"http://authentik-server.authentik.svc.cluster.local/application/o/token/\\\"' 'OAUTH_USER_INFO_URL = \\\"http://authentik-server.authentik.svc.cluster.local/application/o/userinfo/\\\"' 'OAUTH_SCOPE = [\\\"openid\\\", \\\"profile\\\", \\\"email\\\"]' 'OAUTH_ATTRIBUTE_MAP = {\\\"sub\\\": (True, \\\"uid\\\"), \\\"name\\\": (False, \\\"name\\\"), \\\"email\\\": (False, \\\"contact_email\\\")}' 'LOGIN_URL = \\\"/oauth/login/\\\"' 'CLIENT_SSO_VIA_LOCAL_BROWSER = True' \\u003e\\u003e /shared/seafile/conf/seahub_settings.py; fi\\n\"]}}},\"mariadb\":{\"auth\":{\"database\":\"seafile\",\"password\":\"(sensitive value)\",\"rootPassword\":\"(sensitive value)\",\"username\":\"seafile\"},\"enabled\":true,\"image\":{\"repository\":\"bitnamilegacy/mariadb\",\"tag\":\"11.8.3-debian-12-r0\"},\"primary\":{\"livenessProbe\":{\"timeoutSeconds\":10},\"persistence\":{\"enabled\":true,\"size\":\"4Gi\"},\"readinessProbe\":{\"timeoutSeconds\":10},\"resources\":{\"limits\":{\"memory\":\"512Mi\"},\"requests\":{\"cpu\":\"50m\",\"memory\":\"256Mi\"}}}},\"persistence\":{\"data\":{\"accessMode\":\"ReadWriteOnce\",\"enabled\":true,\"mountPath\":\"/shared\",\"size\":\"20Gi\",\"type\":\"pvc\"}},\"resources\":{\"limits\":{\"memory\":\"1536Mi\"},\"requests\":{\"cpu\":\"100m\",\"memory\":\"512Mi\"}}}}","version":"0.1.0"}],"name":"seafile","namespace":"seafile","pass_credentials":false,"postrender":[],"recreate_pods":false,"render_subchart_notes":true,"replace":false,"repository":null,"repository_ca_file":null,"repository_cert_file":null,"repository_key_file":null,"repository_password":null,"repository_username":null,"reset_values":false,"reuse_values":false,"set":[],"set_list":[],"set_sensitive":[{"name":"seafile.env.INIT_SEAFILE_ADMIN_PASSWORD","type":"","value":"dev-seafile-admin-password"},{"name":"seafile.env.INIT_SEAFILE_MYSQL_ROOT_PASSWORD","type":"","value":"dev-seafile-db-root-password"},{"name":"seafile.env.JWT_PRIVATE_KEY","type":"","value":"dev-seafile-jwt-private-key-not-for-prod-use"},{"name":"seafile.env.SEAFILE_MYSQL_DB_PASSWORD","type":"","value":"dev-seafile-db-password"},{"name":"seafile.mariadb.auth.password","type":"","value":"dev-seafile-db-password"},{"name":"seafile.mariadb.auth.rootPassword","type":"","value":"dev-seafile-db-root-password"}],"skip_crds":false,"status":"deployed","timeout":600,"upgrade_install":null,"values":["seafile:\n  # ponytail: chart defaults to 8.0.7, which is amd64-only on this arm64\n  # (RPi) host — pinned to the newest tag that ships an arm64 manifest.\n  image:\n    tag: \"13.0.25\"\n\n  # ponytail: the chart's default env keys (DB_HOST, DB_ROOT_PASSWD,\n  # SEAFILE_ADMIN_EMAIL/PASSWORD) are for the old pre-9.x seafile-mc image\n  # (matches the chart's default 8.0.7 tag). Image 13.0.25 above renamed all\n  # of these (SEAFILE_MYSQL_DB_*, INIT_SEAFILE_*) — using the old names here\n  # silently no-ops and the bootstrap hangs forever in wait_for_mysql().\n  env:\n    OAUTHLIB_INSECURE_TRANSPORT: \"1\"\n    TIME_ZONE: Asia/Singapore\n    SEAFILE_MYSQL_DB_HOST: seafile-mariadb\n    SEAFILE_MYSQL_DB_USER: seafile\n    SEAFILE_MYSQL_DB_PASSWORD: \"\"  # set via Tiltfile/terraform, matches mariadb.auth.password\n    SEAFILE_MYSQL_DB_CCNET_DB_NAME: ccnet_db\n    SEAFILE_MYSQL_DB_SEAFILE_DB_NAME: seafile_db\n    SEAFILE_MYSQL_DB_SEAHUB_DB_NAME: seahub_db\n    INIT_SEAFILE_MYSQL_ROOT_PASSWORD: \"\"  # set via Tiltfile/terraform, matches mariadb.auth.rootPassword\n    INIT_SEAFILE_ADMIN_EMAIL: admin@seafile.local\n    INIT_SEAFILE_ADMIN_PASSWORD: \"\"  # set via Tiltfile/terraform\n    # ponytail: matches the actual access URL (tailscale https on 8449, same\n    # port CSRF_TRUSTED_ORIGINS/OAUTH_REDIRECT_URL below use) — hardcoded\n    # plain-http seafile.local caused seahub's generated absolute links to\n    # point at an unreachable http address, browser flagged page not secure.\n    SEAFILE_SERVER_HOSTNAME: \"desktop-qv5aogf.tail60240b.ts.net:8449\"\n    SEAFILE_SERVER_PROTOCOL: https\n    SEAFILE_SERVER_LETSENCRYPT: false\n    REDIS_HOST: seafile-redis\n    REDIS_PORT: \"6379\"\n    # ponytail: seafile 13.x added JWT-signed internal auth between\n    # seafile/seahub/fileserver. Without this, first boot's upgrade step\n    # (which always runs once, even on a fresh install) demands a\n    # docker-compose-style .env file that doesn't apply to this single-\n    # container deployment — setting the env var directly skips that check.\n    # JWT_PRIVATE_KEY set via Tiltfile/terraform (.env)\n\n  # ponytail: bitnami moved old image tags to bitnamilegacy on docker.io,\n  # same fix as gitlab/sonarqube's postgres/mariadb subcharts. Chart's\n  # pinned 10.6.11 tag is amd64-only in bitnamilegacy (exec format error\n  # on this arm64 host) — pinned to a tag with arm64 support, same fix as\n  # gitlab's redis image.\n  mariadb:\n    enabled: true\n    image:\n      repository: bitnamilegacy/mariadb\n      tag: 11.8.3-debian-12-r0\n    auth:\n      database: seafile\n      username: seafile\n      password: \"\"  # set via Tiltfile/terraform\n      rootPassword: \"\"  # set via Tiltfile/terraform\n    primary:\n      persistence:\n        enabled: true\n        size: 4Gi\n      # ponytail: chart's 1s probe timeout is too tight on this RPi under\n      # load (image pulls / other apps booting concurrently) — mysql client\n      # startup alone can exceed it, causing probe \"timed out\" false negatives.\n      livenessProbe:\n        timeoutSeconds: 10\n      readinessProbe:\n        timeoutSeconds: 10\n      resources:\n        requests:\n          cpu: 50m\n          memory: 256Mi\n        limits:\n          memory: 512Mi\n\n  persistence:\n    data:\n      enabled: true\n      type: pvc\n      mountPath: /shared\n      accessMode: ReadWriteOnce\n      size: 20Gi\n\n  # ponytail: seahub_settings.py is generated fresh by the main container's\n  # own bootstrap script on first boot (with computed DB creds/secret key),\n  # so there's no initContainer hook-point to inject static OAuth config\n  # before it exists. postStart runs concurrently with the main process\n  # instead — polls until the file appears (fresh install: ~1-3min schema\n  # setup) then appends once, guarded by a sentinel so restarts don't\n  # duplicate it. Matches https://integrations.goauthentik.io/media/seafile/\n  # except the login template only renders a button for SAML SSO, not\n  # generic OAuth — so LOGIN_URL auto-redirect is required too (same\n  # autoSignInWithProvider pattern as this repo's gitlab/Tiltfile).\n  # dev-seafile-oidc-client-id/dev-seafile-oidc-client-secret-not-for-prod-use are replaced\n  # by the Tiltfile via string substitution on the rendered YAML (not\n  # --set — this script is one big multi-line string, and --set with a\n  # value that size is a shell-escaping nightmare). Values come from `.env`.\n  lifecycle:\n    postStart:\n      exec:\n        command:\n          - /bin/sh\n          - -c\n          - \u003e\n            i=0;\n            while [ ! -f /shared/seafile/conf/seahub_settings.py ] \u0026\u0026 [ $i -lt 240 ]; do sleep 1; i=$((i+1)); done;\n            if [ -f /shared/seafile/conf/seahub_settings.py ] \u0026\u0026 ! grep -q 'Authentik OIDC login' /shared/seafile/conf/seahub_settings.py; then\n            printf '%s\\n' '' '# Authentik OIDC login'\n            'CSRF_TRUSTED_ORIGINS = [\"https://desktop-qv5aogf.tail60240b.ts.net:8449\"]'\n            'ENABLE_OAUTH = True'\n            'OAUTH_CLIENT_ID = \"dev-seafile-oidc-client-id\"'\n            'OAUTH_CLIENT_SECRET = \"dev-seafile-oidc-client-secret-not-for-prod-use\"'\n            'OAUTH_REDIRECT_URL = \"https://desktop-qv5aogf.tail60240b.ts.net:8449/oauth/callback/\"'\n            'OAUTH_PROVIDER = \"authentik\"'\n            'OAUTH_PROVIDER_DOMAIN = \"authentik\"'\n            'OAUTH_AUTHORIZATION_URL = \"https://desktop-qv5aogf.tail60240b.ts.net:8443/application/o/authorize/\"'\n            'OAUTH_TOKEN_URL = \"http://authentik-server.authentik.svc.cluster.local/application/o/token/\"'\n            'OAUTH_USER_INFO_URL = \"http://authentik-server.authentik.svc.cluster.local/application/o/userinfo/\"'\n            'OAUTH_SCOPE = [\"openid\", \"profile\", \"email\"]'\n            'OAUTH_ATTRIBUTE_MAP = {\"sub\": (True, \"uid\"), \"name\": (False, \"name\"), \"email\": (False, \"contact_email\")}'\n            'LOGIN_URL = \"/oauth/login/\"'\n            'CLIENT_SSO_VIA_LOCAL_BROWSER = True'\n            \u003e\u003e /shared/seafile/conf/seahub_settings.py;\n            fi\n\n  resources:\n    requests:\n      cpu: 100m\n      memory: 512Mi\n    limits:\n      memory: 1536Mi\n\n  ingress:\n    main:\n      enabled: true\n      ingressClassName: traefik\n      annotations:\n        cert-manager.io/cluster-issuer: homelab-ca-issuer\n      hosts:\n        - host: seafile.local\n          paths:\n            - path: /\n              pathType: Prefix\n      tls:\n        - secretName: seafile.local-tls\n          hosts:\n            - seafile.local\n"],"verify":false,"version":"0.1.0","wait":true,"wait_for_jobs":false},"sensitive_attributes":[[{"type":"get_attr","value":"repository_password"}],[{"type":"get_attr","value":"set_sensitive"}],[{"type":"get_attr","value":"values"},{"type":"index","value":{"value":0,"type":"number"}}]],"private":"eyJzY2hlbWFfdmVyc2lvbiI6IjEifQ==","dependencies":["kubernetes_namespace.seafile","kubernetes_service.seafile_redis"]}]},{"mode":"managed","type":"helm_release","name":"sonarqube","provider":"provider[\"registry.opentofu.org/hashicorp/helm\"]","instances":[{"schema_version":1,"attributes":{"atomic":false,"chart":"./../helm/sonarqube","cleanup_on_fail":false,"create_namespace":false,"dependency_update":true,"description":null,"devel":null,"disable_crd_hooks":false,"disable_openapi_validation":false,"disable_webhooks":false,"force_update":false,"id":"sonarqube","keyring":null,"lint":false,"manifest":null,"max_history":0,"metadata":[{"app_version":"","chart":"sonarqube","first_deployed":1787792562,"last_deployed":1787792562,"name":"sonarqube","namespace":"sonarqube","notes":"1. Get the application URL by running these commands:\n  http://sonarqube.local\nWARNING: \n         Please note that the SonarQube image runs with a non-root user (uid=1000) belonging to the root group (guid=0). In this way, the chart can support arbitrary user ids as recommended in OpenShift.\n         Please visit https://docs.openshift.com/container-platform/4.14/openshift_images/create-images.html#use-uid_create-images for more information.\n\n\nWARNING: Setting the deployment strategy type is deprecated and will be removed in a future release. It will be hard-coded to Recreate.\n\nWARNING: The deploymentType value is deprecated and won't be supported anymore. SonarQube will be deployed as a Deployment by default.\n\n\nCHART NAME: postgresql\nCHART VERSION: 16.7.27\nAPP VERSION: 17.6.0\n\n⚠ WARNING: Since August 28th, 2025, only a limited subset of images/charts are available for free.\n    Subscribe to Bitnami Secure Images to receive continued support and security updates.\n    More info at https://bitnami.com and https://github.com/bitnami/containers/issues/83267\n\n** Please be patient while the chart is being deployed **\n\nPostgreSQL can be accessed via port 5432 on the following DNS names from within your cluster:\n\n    sonarqube-postgresql.sonarqube.svc.cluster.local - Read/Write connection\n\nTo get the password for \"postgres\" run:\n\n    export POSTGRES_ADMIN_PASSWORD=$(kubectl get secret --namespace sonarqube sonarqube-postgresql -o jsonpath=\"{.data.postgres-password}\" | base64 -d)\n\nTo get the password for \"sonarqube\" run:\n\n    export POSTGRES_PASSWORD=$(kubectl get secret --namespace sonarqube sonarqube-postgresql -o jsonpath=\"{.data.password}\" | base64 -d)\n\nTo connect to your database run the following command:\n\n    kubectl run sonarqube-postgresql-client --rm --tty -i --restart='Never' --namespace sonarqube --image docker.io/bitnamilegacy/postgresql:17.6.0-debian-12-r4 --env=\"PGPASSWORD=$POSTGRES_PASSWORD\" \\\n      --command -- psql --host sonarqube-postgresql -U sonarqube -d sonarqube -p 5432\n\n    \u003e NOTE: If you access the container using bash, make sure that you execute \"/opt/bitnami/scripts/postgresql/entrypoint.sh /bin/bash\" in order to avoid the error \"psql: local user with ID 1001} does not exist\"\n\nTo connect to your database from outside the cluster execute the following commands:\n\n    kubectl port-forward --namespace sonarqube svc/sonarqube-postgresql 5432:5432 \u0026\n    PGPASSWORD=\"$POSTGRES_PASSWORD\" psql --host 127.0.0.1 -U sonarqube -d sonarqube -p 5432\n\nWARNING: The configured password will be ignored on new installation in case when previous PostgreSQL release was deleted through the helm command. In that case, old PVC will have an old password, and setting it through helm won't take effect. Deleting persistent volumes (PVs) will solve the issue.\n\nWARNING: There are \"resources\" sections in the chart not set. Using \"resourcesPreset\" is not recommended for production. For production installations, please set the following values according to your workload needs:\n  - readReplicas.resources\n+info https://kubernetes.io/docs/concepts/configuration/manage-resources-containers/\n\n⚠ SECURITY WARNING: Original containers have been substituted. This Helm chart was designed, tested, and validated on multiple platforms using a specific set of Bitnami and Tanzu Application Catalog containers. Substituting other containers is likely to cause degraded security and performance, broken chart features, and missing environment variables.\n\nSubstituted images detected:\n  - docker.io/bitnamilegacy/postgresql:17.6.0-debian-12-r4\n\n⚠ WARNING: Original containers have been substituted for unrecognized ones. Deploying this chart with non-standard containers is likely to cause degraded security and performance, broken chart features, and missing environment variables.\n\nUnrecognized images:\n  - docker.io/bitnamilegacy/postgresql:17.6.0-debian-12-r4\n","revision":1,"values":"{\"postgresql\":{\"auth\":{\"database\":\"sonarqube\",\"password\":\"(sensitive value)\",\"username\":\"sonarqube\"},\"image\":{\"repository\":\"bitnamilegacy/postgresql\"},\"primary\":{\"resources\":{\"limits\":{\"memory\":\"512Mi\"},\"requests\":{\"cpu\":\"50m\",\"memory\":\"256Mi\"}}}},\"sonarqube\":{\"community\":{\"enabled\":true},\"ingress\":{\"annotations\":{\"cert-manager.io/cluster-issuer\":\"homelab-ca-issuer\"},\"enabled\":true,\"hosts\":[{\"name\":\"sonarqube.local\"}],\"ingressClassName\":\"traefik\",\"tls\":[{\"hosts\":[\"sonarqube.local\"],\"secretName\":\"sonarqube.local-tls\"}]},\"initSysctl\":{\"enabled\":false},\"jdbcOverwrite\":{\"enabled\":true,\"jdbcPassword\":\"(sensitive value)\",\"jdbcUrl\":\"jdbc:postgresql://sonarqube-postgresql:5432/sonarqube\",\"jdbcUsername\":\"sonarqube\"},\"livenessProbe\":{\"timeoutSeconds\":10},\"monitoringPasscode\":\"(sensitive value)\",\"persistence\":{\"enabled\":true,\"size\":\"5Gi\"},\"plugins\":{\"install\":[\"https://github.com/sonar-auth-oidc/sonar-auth-oidc/releases/download/v3.0.0/sonar-auth-oidc-plugin-3.0.0.jar\"]},\"readinessProbe\":{\"timeoutSeconds\":10},\"resources\":{\"limits\":{\"memory\":\"3072M\"},\"requests\":{\"cpu\":\"200m\",\"memory\":\"1536M\"}},\"sonarProperties\":{\"sonar.auth.oidc.enabled\":\"true\",\"sonar.auth.oidc.issuerUri\":\"https://desktop-qv5aogf.tail60240b.ts.net:8443/application/o/sonarqube/\",\"sonar.auth.oidc.loginButtonText\":\"Log in with Authentik\",\"sonar.core.serverBaseURL\":\"https://desktop-qv5aogf.tail60240b.ts.net:8448\"},\"sonarSecretProperties\":\"sonarqube-oidc-secret\",\"startupProbe\":{\"timeoutSeconds\":10}}}","version":"0.1.0"}],"name":"sonarqube","namespace":"sonarqube","pass_credentials":false,"postrender":[],"recreate_pods":false,"render_subchart_notes":true,"replace":false,"repository":null,"repository_ca_file":null,"repository_cert_file":null,"repository_key_file":null,"repository_password":null,"repository_username":null,"reset_values":false,"reuse_values":false,"set":[],"set_list":[],"set_sensitive":[{"name":"postgresql.auth.password","type":"","value":"dev-sonarqube-db-password"},{"name":"sonarqube.jdbcOverwrite.jdbcPassword","type":"","value":"dev-sonarqube-db-password"},{"name":"sonarqube.monitoringPasscode","type":"","value":"dev-sonarqube-monitoring-passcode"}],"skip_crds":false,"status":"deployed","timeout":900,"upgrade_install":null,"values":["sonarqube:\n  community:\n    enabled: true\n\n  # ponytail: vm.max_map_count for the bundled Elasticsearch needs raising\n  # host-side once (`sudo sysctl -w vm.max_map_count=262144` on the k3d\n  # node/host, persist in /etc/sysctl.d/ if you want it to survive reboots).\n  # Chart's own initSysctl needs a privileged initContainer; skipping that\n  # in favor of the one-time host command.\n  initSysctl:\n    enabled: false\n\n  # monitoringPasscode set via Tiltfile/terraform (.env)\n\n  # ponytail: chart's 1s probe timeout is too tight on this RPi under load\n  # (JVM GC pauses, concurrent image pulls) — caused a liveness-kill restart\n  # loop even though the server was actually up. Same fix as seafile's mariadb.\n  readinessProbe:\n    timeoutSeconds: 10\n  livenessProbe:\n    timeoutSeconds: 10\n  startupProbe:\n    timeoutSeconds: 10\n\n  resources:\n    requests:\n      cpu: 200m\n      memory: 1536M\n    limits:\n      memory: 3072M\n\n  persistence:\n    enabled: true\n    size: 5Gi\n\n  # ponytail: SonarQube Community has no native SSO — this OSS plugin\n  # (sonar-auth-oidc, MIT-ish/Apache) bolts on generic OpenID Connect via\n  # the marketplace-jar mechanism, same \"no license, no fork\" pattern as\n  # n8n's cweagans/n8n-oidc. Its own settings (sonar.auth.oidc.*) are\n  # regular SonarQube global settings, so they load from sonarProperties\n  # below — no manual admin-UI step needed after first boot.\n  plugins:\n    install:\n      - \"https://github.com/sonar-auth-oidc/sonar-auth-oidc/releases/download/v3.0.0/sonar-auth-oidc-plugin-3.0.0.jar\"\n\n  # ponytail: fixed dev client_id/secret matching the Authentik OAuth2\n  # provider created via the API (same one-time-setup pattern as the other\n  # apps). Server base URL uses the tailscale hostname so the browser\n  # redirect and the plugin's own redirect URI agree on the same authority.\n  sonarProperties:\n    sonar.core.serverBaseURL: \"https://desktop-qv5aogf.tail60240b.ts.net:8448\"\n    sonar.auth.oidc.enabled: \"true\"\n    sonar.auth.oidc.issuerUri: \"https://desktop-qv5aogf.tail60240b.ts.net:8443/application/o/sonarqube/\"\n    # sonar.auth.oidc.clientId.secured set via Tiltfile/terraform (.env)\n    sonar.auth.oidc.loginButtonText: \"Log in with Authentik\"\n\n  # ponytail: sonarSecretProperties is a *reference* to an existing Secret\n  # (key \"secret.properties\"), not inline content — the chart concatenates\n  # it after sonarProperties above, so it can override the same keys.\n  # Secret itself is created in the Tiltfile alongside the other apps'\n  # dev-fixed OIDC secrets.\n  sonarSecretProperties: sonarqube-oidc-secret\n\n  jdbcOverwrite:\n    enabled: true\n    jdbcUrl: \"jdbc:postgresql://sonarqube-postgresql:5432/sonarqube\"\n    jdbcUsername: \"sonarqube\"\n\n  ingress:\n    enabled: true\n    ingressClassName: traefik\n    annotations:\n      cert-manager.io/cluster-issuer: homelab-ca-issuer\n    hosts:\n      - name: sonarqube.local\n    tls:\n      - secretName: sonarqube.local-tls\n        hosts:\n          - sonarqube.local\n\npostgresql:\n  # ponytail: bitnami moved old image tags to bitnamilegacy on docker.io,\n  # same fix as gitlab's postgresql subchart.\n  image:\n    repository: bitnamilegacy/postgresql\n  auth:\n    username: sonarqube\n    database: sonarqube\n  primary:\n    resources:\n      requests:\n        cpu: 50m\n        memory: 256Mi\n      limits:\n        memory: 512Mi\n"],"verify":false,"version":"0.1.0","wait":true,"wait_for_jobs":false},"sensitive_attributes":[[{"type":"get_attr","value":"repository_password"}],[{"type":"get_attr","value":"set_sensitive"}]],"private":"eyJzY2hlbWFfdmVyc2lvbiI6IjEifQ==","dependencies":["kubernetes_namespace.sonarqube","kubernetes_secret.sonarqube_oidc"]}]},{"mode":"managed","type":"kubectl_manifest","name":"homelab_ca","provider":"provider[\"registry.opentofu.org/gavinbunney/kubectl\"]","instances":[{"schema_version":1,"attributes":{"api_version":"cert-manager.io/v1","apply_only":false,"force_conflicts":false,"force_new":false,"id":"/apis/cert-manager.io/v1/namespaces/cert-manager/certificates/homelab-ca","ignore_fields":null,"kind":"Certificate","live_manifest_incluster":"2293a6c29bc84d331f2f460beec69520cd9d7874ec036463c1ce6964873201a9","live_uid":"66faaf73-182b-4e06-81b5-bf4f0bd96a76","name":"homelab-ca","namespace":"cert-manager","override_namespace":null,"sensitive_fields":null,"server_side_apply":false,"timeouts":null,"uid":"66faaf73-182b-4e06-81b5-bf4f0bd96a76","validate_schema":true,"wait":null,"wait_for_rollout":true,"yaml_body":"apiVersion: cert-manager.io/v1\r\nkind: Certificate\r\nmetadata:\r\n  name: homelab-ca\r\n  namespace: cert-manager\r\nspec:\r\n  isCA: true\r\n  commonName: homelab-ca\r\n  secretName: homelab-ca-secret\r\n  privateKey:\r\n    algorithm: ECDSA\r\n    size: 256\r\n  issuerRef:\r\n    name: selfsigned-bootstrap\r\n    kind: ClusterIssuer\r\n    group: cert-manager.io\r\n","yaml_body_parsed":"apiVersion: cert-manager.io/v1\nkind: Certificate\nmetadata:\n  name: homelab-ca\n  namespace: cert-manager\nspec:\n  commonName: homelab-ca\n  isCA: true\n  issuerRef:\n    group: cert-manager.io\n    kind: ClusterIssuer\n    name: selfsigned-bootstrap\n  privateKey:\n    algorithm: ECDSA\n    size: 256\n  secretName: homelab-ca-secret\n","yaml_incluster":"2293a6c29bc84d331f2f460beec69520cd9d7874ec036463c1ce6964873201a9"},"sensitive_attributes":[[{"type":"get_attr","value":"live_manifest_incluster"}],[{"type":"get_attr","value":"yaml_body"}],[{"type":"get_attr","value":"yaml_incluster"}]],"private":"eyJlMmJmYjczMC1lY2FhLTExZTYtOGY4OC0zNDM2M2JjN2M0YzAiOnsiY3JlYXRlIjo2MDAwMDAwMDAwMDB9LCJzY2hlbWFfdmVyc2lvbiI6IjEifQ==","dependencies":["helm_release.cert_manager","kubectl_manifest.selfsigned_bootstrap","kubernetes_namespace.cert_manager"]}]},{"mode":"managed","type":"kubectl_manifest","name":"homelab_ca_issuer","provider":"provider[\"registry.opentofu.org/gavinbunney/kubectl\"]","instances":[{"schema_version":1,"attributes":{"api_version":"cert-manager.io/v1","apply_only":false,"force_conflicts":false,"force_new":false,"id":"/apis/cert-manager.io/v1/clusterissuers/homelab-ca-issuer","ignore_fields":null,"kind":"ClusterIssuer","live_manifest_incluster":"041ef58d91f7b7ea369899972067d781026d88bd980c8b812aa2d1ed59b9689a","live_uid":"336aafd5-20fd-448c-b108-5bd43251a075","name":"homelab-ca-issuer","namespace":null,"override_namespace":null,"sensitive_fields":null,"server_side_apply":false,"timeouts":null,"uid":"336aafd5-20fd-448c-b108-5bd43251a075","validate_schema":true,"wait":null,"wait_for_rollout":true,"yaml_body":"apiVersion: cert-manager.io/v1\r\nkind: ClusterIssuer\r\nmetadata:\r\n  name: homelab-ca-issuer\r\nspec:\r\n  ca:\r\n    secretName: homelab-ca-secret\r\n","yaml_body_parsed":"apiVersion: cert-manager.io/v1\nkind: ClusterIssuer\nmetadata:\n  name: homelab-ca-issuer\nspec:\n  ca:\n    secretName: homelab-ca-secret\n","yaml_incluster":"041ef58d91f7b7ea369899972067d781026d88bd980c8b812aa2d1ed59b9689a"},"sensitive_attributes":[[{"type":"get_attr","value":"live_manifest_incluster"}],[{"type":"get_attr","value":"yaml_body"}],[{"type":"get_attr","value":"yaml_incluster"}]],"private":"eyJlMmJmYjczMC1lY2FhLTExZTYtOGY4OC0zNDM2M2JjN2M0YzAiOnsiY3JlYXRlIjo2MDAwMDAwMDAwMDB9LCJzY2hlbWFfdmVyc2lvbiI6IjEifQ==","dependencies":["helm_release.cert_manager","kubectl_manifest.homelab_ca","kubectl_manifest.selfsigned_bootstrap","kubernetes_namespace.cert_manager"]}]},{"mode":"managed","type":"kubectl_manifest","name":"selfsigned_bootstrap","provider":"provider[\"registry.opentofu.org/gavinbunney/kubectl\"]","instances":[{"schema_version":1,"attributes":{"api_version":"cert-manager.io/v1","apply_only":false,"force_conflicts":false,"force_new":false,"id":"/apis/cert-manager.io/v1/clusterissuers/selfsigned-bootstrap","ignore_fields":null,"kind":"ClusterIssuer","live_manifest_incluster":"60cc61e6a82f8ef2f351310629b8e98cf45de2fbabd729d2e8be4272f176cd48","live_uid":"a285bdcf-c26d-4737-86f1-4b5fda8e0c93","name":"selfsigned-bootstrap","namespace":null,"override_namespace":null,"sensitive_fields":null,"server_side_apply":false,"timeouts":null,"uid":"a285bdcf-c26d-4737-86f1-4b5fda8e0c93","validate_schema":true,"wait":null,"wait_for_rollout":true,"yaml_body":"apiVersion: cert-manager.io/v1\r\nkind: ClusterIssuer\r\nmetadata:\r\n  name: selfsigned-bootstrap\r\nspec:\r\n  selfSigned: {}\r\n","yaml_body_parsed":"apiVersion: cert-manager.io/v1\nkind: ClusterIssuer\nmetadata:\n  name: selfsigned-bootstrap\nspec:\n  selfSigned: {}\n","yaml_incluster":"60cc61e6a82f8ef2f351310629b8e98cf45de2fbabd729d2e8be4272f176cd48"},"sensitive_attributes":[[{"type":"get_attr","value":"live_manifest_incluster"}],[{"type":"get_attr","value":"yaml_body"}],[{"type":"get_attr","value":"yaml_incluster"}]],"private":"eyJlMmJmYjczMC1lY2FhLTExZTYtOGY4OC0zNDM2M2JjN2M0YzAiOnsiY3JlYXRlIjo2MDAwMDAwMDAwMDB9LCJzY2hlbWFfdmVyc2lvbiI6IjEifQ==","dependencies":["helm_release.cert_manager","kubernetes_namespace.cert_manager"]}]},{"mode":"managed","type":"kubernetes_config_map","name":"n8n_oidc_hooks","provider":"provider[\"registry.opentofu.org/hashicorp/kubernetes\"]","instances":[{"schema_version":0,"attributes":{"binary_data":{},"data":{"hooks.js":"/**\r\n * n8n External Hooks for OIDC Authentication\r\n *\r\n * This file implements OIDC authentication support for n8n using only built-in Node.js modules.\r\n * It provides:\r\n * - OIDC discovery endpoint support\r\n * - Authorization code flow\r\n * - User provisioning (JIT - Just In Time)\r\n * - Frontend customization to show OIDC login button\r\n *\r\n * Environment Variables Required:\r\n * - OIDC_ISSUER_URL: The OIDC provider's issuer URL (e.g., https://auth.example.com)\r\n * - OIDC_CLIENT_ID: OAuth2 client ID\r\n * - OIDC_CLIENT_SECRET: OAuth2 client secret\r\n * - OIDC_REDIRECT_URI: The callback URL (e.g., https://n8n.example.com/auth/oidc/callback)\r\n *\r\n * Optional:\r\n * - OIDC_SCOPES: Space-separated list of scopes (default: \"openid email profile\")\r\n */\r\n\r\nconst https = require('https');\r\nconst http = require('http');\r\nconst crypto = require('crypto');\r\nconst { URL, URLSearchParams } = require('url');\r\n\r\n// Configuration from environment\r\nconst config = {\r\n  issuerUrl: process.env.OIDC_ISSUER_URL,\r\n  clientId: process.env.OIDC_CLIENT_ID,\r\n  clientSecret: process.env.OIDC_CLIENT_SECRET,\r\n  redirectUri: process.env.OIDC_REDIRECT_URI,\r\n  scopes: process.env.OIDC_SCOPES || 'openid email profile',\r\n};\r\n\r\n// Validate configuration\r\nfunction validateConfig() {\r\n  const missing = [];\r\n  if (!config.issuerUrl) missing.push('OIDC_ISSUER_URL');\r\n  if (!config.clientId) missing.push('OIDC_CLIENT_ID');\r\n  if (!config.clientSecret) missing.push('OIDC_CLIENT_SECRET');\r\n  if (!config.redirectUri) missing.push('OIDC_REDIRECT_URI');\r\n  return missing;\r\n}\r\n\r\n// Cache for OIDC discovery document\r\nlet discoveryCache = null;\r\nlet discoveryCacheTime = 0;\r\nconst DISCOVERY_CACHE_TTL = 3600000; // 1 hour\r\n\r\n/**\r\n * Make an HTTP/HTTPS request\r\n * @param {string} url - The URL to request\r\n * @param {object} options - Request options\r\n * @returns {Promise\u003c{statusCode: number, headers: object, body: string}\u003e}\r\n */\r\nfunction makeRequest(url, options = {}) {\r\n  return new Promise((resolve, reject) =\u003e {\r\n    const parsedUrl = new URL(url);\r\n    const protocol = parsedUrl.protocol === 'https:' ? https : http;\r\n\r\n    const reqOptions = {\r\n      hostname: parsedUrl.hostname,\r\n      port: parsedUrl.port || (parsedUrl.protocol === 'https:' ? 443 : 80),\r\n      path: parsedUrl.pathname + parsedUrl.search,\r\n      method: options.method || 'GET',\r\n      headers: options.headers || {},\r\n    };\r\n\r\n    const req = protocol.request(reqOptions, (res) =\u003e {\r\n      let body = '';\r\n      res.on('data', (chunk) =\u003e (body += chunk));\r\n      res.on('end', () =\u003e {\r\n        resolve({\r\n          statusCode: res.statusCode,\r\n          headers: res.headers,\r\n          body,\r\n        });\r\n      });\r\n    });\r\n\r\n    req.on('error', reject);\r\n\r\n    if (options.body) {\r\n      req.write(options.body);\r\n    }\r\n\r\n    req.end();\r\n  });\r\n}\r\n\r\n/**\r\n * Fetch OIDC discovery document\r\n * @returns {Promise\u003cobject\u003e}\r\n */\r\nasync function fetchDiscoveryDocument() {\r\n  const now = Date.now();\r\n  if (discoveryCache \u0026\u0026 now - discoveryCacheTime \u003c DISCOVERY_CACHE_TTL) {\r\n    return discoveryCache;\r\n  }\r\n\r\n  const discoveryUrl = config.issuerUrl.replace(/\\/$/, '') + '/.well-known/openid-configuration';\r\n  const response = await makeRequest(discoveryUrl);\r\n\r\n  if (response.statusCode !== 200) {\r\n    throw new Error(`Failed to fetch OIDC discovery document: ${response.statusCode}`);\r\n  }\r\n\r\n  discoveryCache = JSON.parse(response.body);\r\n  discoveryCacheTime = now;\r\n  return discoveryCache;\r\n}\r\n\r\n/**\r\n * Generate a random string for state/nonce\r\n * @param {number} length\r\n * @returns {string}\r\n */\r\nfunction generateRandomString(length = 32) {\r\n  return crypto.randomBytes(length).toString('hex');\r\n}\r\n\r\n/**\r\n * Base64URL encode\r\n * @param {Buffer|string} input\r\n * @returns {string}\r\n */\r\nfunction base64UrlEncode(input) {\r\n  const base64 = Buffer.isBuffer(input) ? input.toString('base64') : Buffer.from(input).toString('base64');\r\n  return base64.replace(/\\+/g, '-').replace(/\\//g, '_').replace(/=/g, '');\r\n}\r\n\r\n/**\r\n * Base64URL decode\r\n * @param {string} input\r\n * @returns {Buffer}\r\n */\r\nfunction base64UrlDecode(input) {\r\n  let base64 = input.replace(/-/g, '+').replace(/_/g, '/');\r\n  while (base64.length % 4) {\r\n    base64 += '=';\r\n  }\r\n  return Buffer.from(base64, 'base64');\r\n}\r\n\r\n/**\r\n * Decode JWT without verification (for extracting claims)\r\n * @param {string} token\r\n * @returns {object}\r\n */\r\nfunction decodeJwt(token) {\r\n  const parts = token.split('.');\r\n  if (parts.length !== 3) {\r\n    throw new Error('Invalid JWT format');\r\n  }\r\n\r\n  const payload = JSON.parse(base64UrlDecode(parts[1]).toString('utf8'));\r\n  return payload;\r\n}\r\n\r\n/**\r\n * Exchange authorization code for tokens\r\n * @param {string} code\r\n * @param {object} discovery\r\n * @returns {Promise\u003cobject\u003e}\r\n */\r\nasync function exchangeCodeForTokens(code, discovery) {\r\n  const params = new URLSearchParams({\r\n    grant_type: 'authorization_code',\r\n    code,\r\n    redirect_uri: config.redirectUri,\r\n    client_id: config.clientId,\r\n    client_secret: config.clientSecret,\r\n  });\r\n\r\n  const response = await makeRequest(discovery.token_endpoint, {\r\n    method: 'POST',\r\n    headers: {\r\n      'Content-Type': 'application/x-www-form-urlencoded',\r\n    },\r\n    body: params.toString(),\r\n  });\r\n\r\n  if (response.statusCode !== 200) {\r\n    console.error('Token exchange failed:', response.body);\r\n    throw new Error(`Token exchange failed: ${response.statusCode}`);\r\n  }\r\n\r\n  return JSON.parse(response.body);\r\n}\r\n\r\n/**\r\n * Fetch user info from OIDC provider\r\n * @param {string} accessToken\r\n * @param {object} discovery\r\n * @returns {Promise\u003cobject\u003e}\r\n */\r\nasync function fetchUserInfo(accessToken, discovery) {\r\n  const response = await makeRequest(discovery.userinfo_endpoint, {\r\n    headers: {\r\n      Authorization: `Bearer ${accessToken}`,\r\n    },\r\n  });\r\n\r\n  if (response.statusCode !== 200) {\r\n    console.error('UserInfo fetch failed:', response.body);\r\n    throw new Error(`UserInfo fetch failed: ${response.statusCode}`);\r\n  }\r\n\r\n  return JSON.parse(response.body);\r\n}\r\n\r\n/**\r\n * Create a signed JWT for state/nonce storage\r\n * We use the JWT service from n8n when available, but for cookies we just use HMAC\r\n * @param {object} payload\r\n * @param {string} secret\r\n * @param {number} expiresInSeconds\r\n * @returns {string}\r\n */\r\nfunction createSignedCookie(payload, secret, expiresInSeconds = 900) {\r\n  const exp = Math.floor(Date.now() / 1000) + expiresInSeconds;\r\n  const data = JSON.stringify({ ...payload, exp });\r\n  const hmac = crypto.createHmac('sha256', secret);\r\n  hmac.update(data);\r\n  const signature = hmac.digest('hex');\r\n  return base64UrlEncode(data) + '.' + signature;\r\n}\r\n\r\n/**\r\n * Verify and decode a signed cookie\r\n * @param {string} cookie\r\n * @param {string} secret\r\n * @returns {object|null}\r\n */\r\nfunction verifySignedCookie(cookie, secret) {\r\n  try {\r\n    const [dataB64, signature] = cookie.split('.');\r\n    const data = base64UrlDecode(dataB64).toString('utf8');\r\n\r\n    const hmac = crypto.createHmac('sha256', secret);\r\n    hmac.update(data);\r\n    const expectedSignature = hmac.digest('hex');\r\n\r\n    if (signature !== expectedSignature) {\r\n      return null;\r\n    }\r\n\r\n    const payload = JSON.parse(data);\r\n    if (payload.exp \u0026\u0026 payload.exp \u003c Date.now() / 1000) {\r\n      return null;\r\n    }\r\n\r\n    return payload;\r\n  } catch {\r\n    return null;\r\n  }\r\n}\r\n\r\n/**\r\n * Get or create the cookie signing secret\r\n * We derive it from the n8n encryption key if available\r\n * @param {object} context\r\n * @returns {string}\r\n */\r\nfunction getCookieSecret(context) {\r\n  // Use a combination of environment variables to create a stable secret\r\n  const baseKey = process.env.N8N_ENCRYPTION_KEY || process.env.OIDC_CLIENT_SECRET || 'n8n-oidc-hook-secret';\r\n  const hash = crypto.createHash('sha256').update(baseKey + '-oidc-state').digest('hex');\r\n  return hash;\r\n}\r\n\r\n/**\r\n * Create the n8n auth cookie using n8n's JwtService\r\n * @param {object} user\r\n * @param {object} jwtService - n8n's JwtService instance\r\n * @returns {string}\r\n */\r\nfunction createAuthToken(user, jwtService) {\r\n  // n8n's JWT contains: { id, hash, browserId?, usedMfa? }\r\n  const payload = {\r\n    id: user.id,\r\n    hash: createUserHash(user),\r\n    usedMfa: false,\r\n  };\r\n\r\n  return jwtService.sign(payload, { expiresIn: '7d' });\r\n}\r\n\r\n/**\r\n * Create user hash for JWT (mimics n8n's AuthService.createJWTHash)\r\n * @param {object} user\r\n * @returns {string}\r\n */\r\nfunction createUserHash(user) {\r\n  const payload = [user.email, user.password || ''];\r\n  if (user.mfaEnabled \u0026\u0026 user.mfaSecret) {\r\n    payload.push(user.mfaSecret.substring(0, 3));\r\n  }\r\n  return crypto.createHash('sha256').update(payload.join(':')).digest('base64').substring(0, 10);\r\n}\r\n\r\n/**\r\n * Check if email is valid\r\n * @param {string} email\r\n * @returns {boolean}\r\n */\r\nfunction isValidEmail(email) {\r\n  const emailRegex = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\r\n  return emailRegex.test(email);\r\n}\r\n\r\n// n8n module paths (specific to the Docker image)\r\nconst N8N_DI_PATH = '/usr/local/lib/node_modules/n8n/node_modules/@n8n/di';\r\nconst N8N_JWT_SERVICE_PATH = '/usr/local/lib/node_modules/n8n/dist/services/jwt.service.js';\r\n\r\n// Export the hooks\r\nmodule.exports = {\r\n  n8n: {\r\n    /**\r\n     * Called when n8n is ready\r\n     * We use this to register custom routes for OIDC\r\n     */\r\n    ready: [\r\n      async function (server, n8nConfig) {\r\n        const missing = validateConfig();\r\n        if (missing.length \u003e 0) {\r\n          console.warn(`[OIDC Hook] Missing configuration: ${missing.join(', ')}. OIDC disabled.`);\r\n          return;\r\n        }\r\n\r\n        console.log('[OIDC Hook] Initializing OIDC authentication...');\r\n\r\n        // Get n8n's JwtService from the DI container\r\n        const { Container } = require(N8N_DI_PATH);\r\n        const { JwtService } = require(N8N_JWT_SERVICE_PATH);\r\n        const jwtService = Container.get(JwtService);\r\n\r\n        const { app } = server;\r\n        const cookieSecret = getCookieSecret();\r\n\r\n        // Cookie settings\r\n        const cookieOptions = {\r\n          httpOnly: true,\r\n          secure: process.env.N8N_PROTOCOL === 'https',\r\n          sameSite: 'lax',\r\n          maxAge: 15 * 60 * 1000, // 15 minutes\r\n        };\r\n\r\n        const authCookieOptions = {\r\n          httpOnly: true,\r\n          secure: process.env.N8N_PROTOCOL === 'https',\r\n          sameSite: 'lax',\r\n          maxAge: 7 * 24 * 60 * 60 * 1000, // 7 days\r\n        };\r\n\r\n        /**\r\n         * OIDC Login endpoint - redirects to the OIDC provider\r\n         */\r\n        app.get('/auth/oidc/login', async (req, res) =\u003e {\r\n          try {\r\n            const discovery = await fetchDiscoveryDocument();\r\n\r\n            const state = generateRandomString();\r\n            const nonce = generateRandomString();\r\n\r\n            // Store state and nonce in signed cookies\r\n            const stateCookie = createSignedCookie({ state }, cookieSecret);\r\n            const nonceCookie = createSignedCookie({ nonce }, cookieSecret);\r\n\r\n            res.cookie('n8n-oidc-state', stateCookie, cookieOptions);\r\n            res.cookie('n8n-oidc-nonce', nonceCookie, cookieOptions);\r\n\r\n            // Build authorization URL\r\n            const authUrl = new URL(discovery.authorization_endpoint);\r\n            authUrl.searchParams.set('client_id', config.clientId);\r\n            authUrl.searchParams.set('redirect_uri', config.redirectUri);\r\n            authUrl.searchParams.set('response_type', 'code');\r\n            authUrl.searchParams.set('scope', config.scopes);\r\n            authUrl.searchParams.set('state', state);\r\n            authUrl.searchParams.set('nonce', nonce);\r\n\r\n            res.redirect(authUrl.toString());\r\n          } catch (error) {\r\n            console.error('[OIDC Hook] Login error:', error);\r\n            res.status(500).send('OIDC configuration error. Please check the logs.');\r\n          }\r\n        });\r\n\r\n        /**\r\n         * OIDC Callback endpoint - handles the authorization code\r\n         */\r\n        app.get('/auth/oidc/callback', async (req, res) =\u003e {\r\n          try {\r\n            const { code, state, error, error_description } = req.query;\r\n\r\n            // Handle OIDC errors\r\n            if (error) {\r\n              console.error('[OIDC Hook] OIDC error:', error, error_description);\r\n              return res.redirect('/signin?error=' + encodeURIComponent(error_description || error));\r\n            }\r\n\r\n            if (!code || !state) {\r\n              return res.redirect('/signin?error=' + encodeURIComponent('Missing authorization code or state'));\r\n            }\r\n\r\n            // Verify state\r\n            const stateCookie = req.cookies['n8n-oidc-state'];\r\n            const nonceCookie = req.cookies['n8n-oidc-nonce'];\r\n\r\n            if (!stateCookie || !nonceCookie) {\r\n              return res.redirect('/signin?error=' + encodeURIComponent('Missing state cookies - session expired'));\r\n            }\r\n\r\n            const statePayload = verifySignedCookie(stateCookie, cookieSecret);\r\n            const noncePayload = verifySignedCookie(nonceCookie, cookieSecret);\r\n\r\n            if (!statePayload || statePayload.state !== state) {\r\n              return res.redirect('/signin?error=' + encodeURIComponent('Invalid state - possible CSRF attack'));\r\n            }\r\n\r\n            // Clear state cookies\r\n            res.clearCookie('n8n-oidc-state');\r\n            res.clearCookie('n8n-oidc-nonce');\r\n\r\n            // Exchange code for tokens\r\n            const discovery = await fetchDiscoveryDocument();\r\n            const tokens = await exchangeCodeForTokens(code, discovery);\r\n\r\n            // Verify nonce in ID token if present\r\n            if (tokens.id_token) {\r\n              const idTokenClaims = decodeJwt(tokens.id_token);\r\n              if (noncePayload \u0026\u0026 idTokenClaims.nonce !== noncePayload.nonce) {\r\n                return res.redirect('/signin?error=' + encodeURIComponent('Invalid nonce - possible replay attack'));\r\n              }\r\n            }\r\n\r\n            // Get user info\r\n            let userInfo;\r\n            try {\r\n              userInfo = await fetchUserInfo(tokens.access_token, discovery);\r\n            } catch (e) {\r\n              // Fall back to ID token claims if userinfo endpoint fails\r\n              if (tokens.id_token) {\r\n                userInfo = decodeJwt(tokens.id_token);\r\n              } else {\r\n                throw e;\r\n              }\r\n            }\r\n\r\n            // Validate we have an email\r\n            if (!userInfo.email || !isValidEmail(userInfo.email)) {\r\n              return res.redirect('/signin?error=' + encodeURIComponent('No valid email in OIDC response'));\r\n            }\r\n\r\n            // Find or create user in n8n database\r\n            const { User, Settings, Credentials, Workflow } = this.dbCollections;\r\n\r\n            // Try to find existing user by email\r\n            let user = await User.findOne({\r\n              where: { email: userInfo.email },\r\n              relations: ['role'],\r\n            });\r\n\r\n            if (!user) {\r\n              // Check if this is the first user (should be owner)\r\n              const userCount = await User.count();\r\n\r\n              const userData = {\r\n                email: userInfo.email,\r\n                firstName: userInfo.given_name || userInfo.name?.split(' ')[0] || 'User',\r\n                lastName: userInfo.family_name || userInfo.name?.split(' ').slice(1).join(' ') || '',\r\n                password: crypto.randomBytes(32).toString('hex'), // Random password, can't be used\r\n                role: { slug: userCount === 0 ? 'global:owner' : 'global:member' },\r\n              };\r\n\r\n              // Use createUserWithProject to create both user and personal project\r\n              const result = await User.createUserWithProject(userData);\r\n              user = result.user;\r\n\r\n              console.log(`[OIDC Hook] Created ${userCount === 0 ? 'owner' : 'member'} user with personal project: ${userInfo.email}`);\r\n            }\r\n\r\n            if (!user) {\r\n              return res.redirect('/signin?error=' + encodeURIComponent('Failed to create or find user'));\r\n            }\r\n\r\n            // Create auth token using n8n's JwtService\r\n            const authToken = createAuthToken(user, jwtService);\r\n\r\n            // Set the n8n auth cookie\r\n            res.cookie('n8n-auth', authToken, authCookieOptions);\r\n\r\n            // Redirect to home\r\n            res.redirect('/');\r\n          } catch (error) {\r\n            console.error('[OIDC Hook] Callback error:', error);\r\n            res.redirect('/signin?error=' + encodeURIComponent('Authentication failed: ' + error.message));\r\n          }\r\n        });\r\n\r\n        /**\r\n         * Serve the frontend customization script\r\n         * This script will replace the login form with an OIDC button\r\n         *\r\n         * NOTE: The route must be under /assets/ or another non-UI route prefix\r\n         * to avoid being intercepted by n8n's history API handler which would\r\n         * serve index.html instead of our JavaScript file.\r\n         */\r\n        app.get('/assets/oidc-frontend-hook.js', (req, res) =\u003e {\r\n          // Use res.type() for proper MIME type handling with nosniff\r\n          res.type('text/javascript; charset=utf-8');\r\n          res.set('Cache-Control', 'public, max-age=3600');\r\n          res.send(getFrontendScript());\r\n        });\r\n\r\n        console.log('[OIDC Hook] OIDC routes registered:');\r\n        console.log('  - GET /auth/oidc/login');\r\n        console.log('  - GET /auth/oidc/callback');\r\n        console.log('  - GET /assets/oidc-frontend-hook.js');\r\n      },\r\n    ],\r\n  },\r\n\r\n  frontend: {\r\n    /**\r\n     * Modify frontend settings to configure SSO display\r\n     */\r\n    settings: [\r\n      async function (frontendSettings) {\r\n        const missing = validateConfig();\r\n        if (missing.length \u003e 0) {\r\n          return; // OIDC not configured, don't modify settings\r\n        }\r\n\r\n        // Enable OIDC login button by setting these properties\r\n        // This tells the frontend that OIDC is available\r\n        frontendSettings.sso = frontendSettings.sso || {};\r\n        frontendSettings.sso.oidc = {\r\n          loginEnabled: true,\r\n          loginUrl: '/auth/oidc/login',\r\n          callbackUrl: config.redirectUri,\r\n        };\r\n\r\n        // Set authentication method to OIDC so the frontend knows SSO is primary\r\n        frontendSettings.userManagement = frontendSettings.userManagement || {};\r\n        frontendSettings.userManagement.authenticationMethod = 'oidc';\r\n\r\n        // Enable enterprise OIDC feature flag so the SSO button shows\r\n        frontendSettings.enterprise = frontendSettings.enterprise || {};\r\n        frontendSettings.enterprise.oidc = true;\r\n\r\n        console.log('[OIDC Hook] Frontend settings configured for OIDC');\r\n      },\r\n    ],\r\n  },\r\n};\r\n\r\n/**\r\n * Generate the frontend customization script\r\n * This script runs in the browser and customizes the login page\r\n */\r\nfunction getFrontendScript() {\r\n  return `\r\n/**\r\n * n8n OIDC Frontend Customization\r\n *\r\n * This script surgically modifies the login form to show an SSO button.\r\n * To access the normal login form, add ?showLogin=true to the URL.\r\n */\r\n(function() {\r\n\t'use strict';\r\n\r\n\tfunction shouldShowNormalLogin() {\r\n\t\treturn new URLSearchParams(window.location.search).get('showLogin') === 'true';\r\n\t}\r\n\r\n\tfunction isSigninPage() {\r\n\t\treturn window.location.pathname === '/signin' || window.location.pathname === '/login';\r\n\t}\r\n\r\n\tfunction displayError(form) {\r\n\t\tvar error = new URLSearchParams(window.location.search).get('error');\r\n\t\tif (!error || !form || form.querySelector('#oidc-error')) return;\r\n\r\n\t\tvar errorDiv = document.createElement('div');\r\n\t\terrorDiv.id = 'oidc-error';\r\n\t\terrorDiv.style.cssText = 'background: var(--color-danger-tint-1, #fee); border: 1px solid var(--color-danger, #fcc); color: var(--color-danger, #c00); padding: 12px; border-radius: 4px; margin: 16px 0;';\r\n\t\terrorDiv.textContent = decodeURIComponent(error);\r\n\r\n\t\tvar heading = form.querySelector('div[class*=\"_heading_\"]');\r\n\t\tif (heading) heading.after(errorDiv);\r\n\t\telse form.prepend(errorDiv);\r\n\t}\r\n\r\n\tfunction injectSsoButton() {\r\n\t\tif (shouldShowNormalLogin()) return;\r\n\t\tif (!isSigninPage()) return;\r\n\r\n\t\tvar form = document.querySelector('[data-test-id=\"auth-form\"]');\r\n\t\tif (!form || form.querySelector('#oidc-sso-button')) return;\r\n\r\n\t\t// Find existing button to clone its classes\r\n\t\tvar existingButton = form.querySelector('[data-test-id=\"form-submit-button\"]');\r\n\t\tvar buttonClasses = existingButton ? existingButton.className : '';\r\n\r\n\t\t// Hide the form elements (inputs, buttons, forgot password)\r\n\t\tform.querySelectorAll('div[class*=\"_inputsContainer_\"], div[class*=\"_buttonsContainer_\"], div[class*=\"_actionContainer_\"]')\r\n\t\t\t.forEach(function(el) { el.style.display = 'none'; });\r\n\r\n\t\t// Create SSO button container\r\n\t\tvar ssoContainer = document.createElement('div');\r\n\t\tssoContainer.id = 'oidc-sso-container';\r\n\t\tssoContainer.style.cssText = 'text-align: center;';\r\n\r\n\t\t// Create button - use cloned classes or fallback styles\r\n\t\tvar button = document.createElement('button');\r\n\t\tbutton.id = 'oidc-sso-button';\r\n\t\tbutton.type = 'button';\r\n\t\tbutton.textContent = 'Sign in with SSO';\r\n\t\tbutton.onclick = function() { window.location.href = '/auth/oidc/login'; };\r\n\r\n\t\tif (buttonClasses) {\r\n\t\t\tbutton.className = buttonClasses;\r\n\t\t\tbutton.style.width = '100%';\r\n\t\t} else {\r\n\t\t\tbutton.style.cssText = 'width: 100%; padding: 12px 24px; font-size: 14px; font-weight: 600; color: white; background: var(--color-primary, #ea4b30); border: none; border-radius: 4px; cursor: pointer;';\r\n\t\t}\r\n\r\n\t\t// Create admin link\r\n\t\tvar adminLink = document.createElement('p');\r\n\t\tadminLink.style.cssText = 'margin-top: 16px; font-size: 12px; color: var(--color-text-light, #666);';\r\n\t\tadminLink.innerHTML = 'Admin? \u003ca href=\"?showLogin=true\" style=\"color: var(--color-primary, #ea4b30);\"\u003eSign in with email\u003c/a\u003e';\r\n\r\n\t\tssoContainer.appendChild(button);\r\n\t\tssoContainer.appendChild(adminLink);\r\n\r\n\t\t// Insert after the heading\r\n\t\tvar heading = form.querySelector('div[class*=\"_heading_\"]');\r\n\t\tif (heading) heading.after(ssoContainer);\r\n\t\telse form.prepend(ssoContainer);\r\n\r\n\t\tdisplayError(form);\r\n\t}\r\n\r\n\tfunction observeAndInject() {\r\n\t\tif (shouldShowNormalLogin() || !isSigninPage()) return;\r\n\r\n\t\tinjectSsoButton();\r\n\r\n\t\tvar observer = new MutationObserver(function() {\r\n\t\t\tif (isSigninPage() \u0026\u0026 !shouldShowNormalLogin()) {\r\n\t\t\t\tvar form = document.querySelector('[data-test-id=\"auth-form\"]');\r\n\t\t\t\tif (form \u0026\u0026 !form.querySelector('#oidc-sso-button')) {\r\n\t\t\t\t\tinjectSsoButton();\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t});\r\n\r\n\t\tobserver.observe(document.body, { childList: true, subtree: true });\r\n\t\tsetTimeout(function() { observer.disconnect(); }, 10000);\r\n\t}\r\n\r\n\tfunction handleNavigation() {\r\n\t\tvar origPush = history.pushState;\r\n\t\tvar origReplace = history.replaceState;\r\n\r\n\t\thistory.pushState = function() {\r\n\t\t\torigPush.apply(this, arguments);\r\n\t\t\tsetTimeout(observeAndInject, 100);\r\n\t\t};\r\n\r\n\t\thistory.replaceState = function() {\r\n\t\t\torigReplace.apply(this, arguments);\r\n\t\t\tsetTimeout(observeAndInject, 100);\r\n\t\t};\r\n\r\n\t\twindow.addEventListener('popstate', function() {\r\n\t\t\tsetTimeout(observeAndInject, 100);\r\n\t\t});\r\n\t}\r\n\r\n\tif (document.readyState === 'loading') {\r\n\t\tdocument.addEventListener('DOMContentLoaded', function() {\r\n\t\t\tobserveAndInject();\r\n\t\t\thandleNavigation();\r\n\t\t});\r\n\t} else {\r\n\t\tobserveAndInject();\r\n\t\thandleNavigation();\r\n\t}\r\n\r\n\tsetTimeout(observeAndInject, 500);\r\n\tsetTimeout(observeAndInject, 1000);\r\n\r\n\tconsole.log('[OIDC Hook] Frontend customization loaded');\r\n})();\r\n`;\r\n}\r\n"},"id":"n8n/n8n-oidc-hooks","immutable":false,"metadata":[{"annotations":{},"generate_name":"","generation":0,"labels":{},"name":"n8n-oidc-hooks","namespace":"n8n","resource_version":"830","uid":"e476b385-d247-4fab-bdea-4f6c28525af9"}]},"sensitive_attributes":[],"private":"bnVsbA==","dependencies":["kubernetes_namespace.n8n"],"identity":{"api_version":"v1","kind":"ConfigMap","name":"n8n-oidc-hooks","namespace":"n8n"},"identity_schema_version":1}]},{"mode":"managed","type":"kubernetes_deployment","name":"seafile_redis","provider":"provider[\"registry.opentofu.org/hashicorp/kubernetes\"]","instances":[{"schema_version":1,"attributes":{"id":"seafile/seafile-redis","metadata":[{"annotations":{},"generate_name":"","generation":1,"labels":{},"name":"seafile-redis","namespace":"seafile","resource_version":"30397","uid":"042c30ce-2012-410f-954d-bc1e44a37064"}],"spec":[{"min_ready_seconds":0,"paused":false,"progress_deadline_seconds":600,"replicas":"1","revision_history_limit":10,"selector":[{"match_expressions":[],"match_labels":{"app":"seafile-redis"}}],"strategy":[{"rolling_update":[{"max_surge":"25%","max_unavailable":"25%"}],"type":"RollingUpdate"}],"template":[{"metadata":[{"annotations":{},"generate_name":"","generation":0,"labels":{"app":"seafile-redis"},"name":"","namespace":"","resource_version":"","uid":""}],"spec":[{"active_deadline_seconds":0,"affinity":[],"automount_service_account_token":true,"container":[{"args":[],"command":[],"env":[],"env_from":[],"image":"redis:7-alpine","image_pull_policy":"IfNotPresent","lifecycle":[],"liveness_probe":[],"name":"redis","port":[{"container_port":6379,"host_ip":"","host_port":0,"name":"","protocol":"TCP"}],"readiness_probe":[],"resources":[{"limits":{},"requests":{}}],"security_context":[],"startup_probe":[],"stdin":false,"stdin_once":false,"termination_message_path":"/dev/termination-log","termination_message_policy":"File","tty":false,"volume_device":[],"volume_mount":[],"working_dir":""}],"dns_config":[],"dns_policy":"ClusterFirst","enable_service_links":true,"host_aliases":[],"host_ipc":false,"host_network":false,"host_pid":false,"hostname":"","image_pull_secrets":[],"init_container":[],"node_name":"","node_selector":{},"os":[],"priority_class_name":"","readiness_gate":[],"restart_policy":"Always","runtime_class_name":"","scheduler_name":"default-scheduler","security_context":[],"service_account_name":"","share_process_namespace":false,"subdomain":"","termination_grace_period_seconds":30,"toleration":[],"topology_spread_constraint":[],"volume":[]}]}]}],"timeouts":null,"wait_for_rollout":true},"sensitive_attributes":[],"private":"eyJlMmJmYjczMC1lY2FhLTExZTYtOGY4OC0zNDM2M2JjN2M0YzAiOnsiY3JlYXRlIjo2MDAwMDAwMDAwMDAsImRlbGV0ZSI6NjAwMDAwMDAwMDAwLCJ1cGRhdGUiOjYwMDAwMDAwMDAwMH0sInNjaGVtYV92ZXJzaW9uIjoiMSJ9","dependencies":["kubernetes_namespace.seafile"],"identity":{"api_version":"app