,"upgrade_install":null,"values":null,"verify":false,"version":"0.1.0","wait":true,"wait_for_jobs":false},"sensitive_attributes":[[{"type":"get_attr","value":"repository_password"}]],"private":"eyJzY2hlbWFfdmVyc2lvbiI6IjEifQ==","dependencies":["module.platform_apps.kubernetes_namespace.redis"]}]},{"module":"module.platform_apps","mode":"managed","type":"helm_release","name":"traefik","provider":"provider[\"registry.opentofu.org/hashicorp/helm\"]","instances":[{"index_key":0,"schema_version":1,"attributes":{"atomic":false,"chart":"../modules/platform-apps/../../../helm/traefik","cleanup_on_fail":false,"create_namespace":false,"dependency_update":true,"description":null,"devel":null,"disable_crd_hooks":false,"disable_openapi_validation":false,"disable_webhooks":false,"force_update":false,"id":"traefik","keyring":null,"lint":false,"manifest":null,"max_history":0,"metadata":[{"app_version":"","chart":"traefik","first_deployed":1790139885,"last_deployed":1790139885,"name":"traefik","namespace":"traefik","notes":"\n\ntraefik with docker.io/traefik:v3.3.2 has been deployed successfully on traefik namespace !\n","revision":1,"values":"{\"traefik\":{\"deployment\":{\"replicas\":1},\"ports\":{\"web\":{\"port\":80},\"websecure\":{\"port\":443}},\"service\":{\"type\":\"LoadBalancer\"}}}","version":"0.1.0"}],"name":"traefik","namespace":"traefik","pass_credentials":false,"postrender":[],"recreate_pods":false,"render_subchart_notes":true,"replace":false,"repository":null,"repository_ca_file":null,"repository_cert_file":null,"repository_key_file":null,"repository_password":null,"repository_username":null,"reset_values":false,"reuse_values":false,"set":[],"set_list":[],"set_sensitive":[],"skip_crds":false,"status":"deployed","timeout":300,"upgrade_install":null,"values":["# ponytail: only used on the sit/uat/production phase clusters. The\n# \"internal\" cluster keeps k3s's own bundled traefik (kube-system) - unrelated\n# terraform/cert-manager/coredns wiring already depends on that one, don't\n# touch it. Phase clusters have k3s's traefik add-on disabled at cluster\n# creation (create-cluster.sh --k3s-arg disable=traefik) so this one owns\n# ports 80/443 instead.\ntraefik:\n  deployment:\n    replicas: 1\n\n  service:\n    type: LoadBalancer\n\n  ports:\n    web:\n      port: 80\n    websecure:\n      port: 443\n"],"verify":false,"version":"0.1.0","wait":true,"wait_for_jobs":false},"sensitive_attributes":[[{"type":"get_attr","value":"repository_password"}]],"private":"eyJzY2hlbWFfdmVyc2lvbiI6IjEifQ==","dependencies":["module.platform_apps.kubernetes_namespace.traefik"]}]},{"module":"module.platform_apps","mode":"managed","type":"helm_release","name":"unleash","provider":"provider[\"registry.opentofu.org/hashicorp/helm\"]","instances":[{"index_key":0,"schema_version":1,"attributes":{"atomic":false,"chart":"../modules/platform-apps/../../../helm/unleash","cleanup_on_fail":false,"create_namespace":false,"dependency_update":true,"description":null,"devel":null,"disable_crd_hooks":false,"disable_openapi_validation":false,"disable_webhooks":false,"force_update":false,"id":"unleash","keyring":null,"lint":false,"manifest":null,"max_history":0,"metadata":[{"app_version":"","chart":"unleash","first_deployed":1790139882,"last_deployed":1790139882,"name":"unleash","namespace":"unleash","notes":"CHART NAME: postgresql\nCHART VERSION: 13.4.4\nAPP VERSION: 16.1.0\n\n** Please be patient while the chart is being deployed **\n\nPostgreSQL can be accessed via port 5432 on the following DNS names from within your cluster:\n\n    unleash-postgresql.unleash.svc.cluster.local - Read/Write connection\n\nTo get the password for \"postgres\" run:\n\n    export POSTGRES_ADMIN_PASSWORD=$(kubectl get secret --namespace unleash unleash-postgresql -o jsonpath=\"{.data.postgres-password}\" | base64 -d)\n\nTo get the password for \"unleash\" run:\n\n    export POSTGRES_PASSWORD=$(kubectl get secret --namespace unleash unleash-postgresql -o jsonpath=\"{.data.password}\" | base64 -d)\n\nTo connect to your database run the following command:\n\n    kubectl run unleash-postgresql-client --rm --tty -i --restart='Never' --namespace unleash --image docker.io/postgres:18-alpine --env=\"PGPASSWORD=$POSTGRES_PASSWORD\" \\\n      --command -- psql --host unleash-postgresql -U unleash -d unleash -p 5432\n\n    \u003e NOTE: If you access the container using bash, make sure that you execute \"/opt/bitnami/scripts/postgresql/entrypoint.sh /bin/bash\" in order to avoid the error \"psql: local user with ID 1001} does not exist\"\n\nTo connect to your database from outside the cluster execute the following commands:\n\n    kubectl port-forward --namespace unleash svc/unleash-postgresql 5432:5432 \u0026\n    PGPASSWORD=\"$POSTGRES_PASSWORD\" psql --host 127.0.0.1 -U unleash -d unleash -p 5432\n\nWARNING: The configured password will be ignored on new installation in case when previous PostgreSQL release was deleted through the helm command. In that case, old PVC will have an old password, and setting it through helm won't take effect. Deleting persistent volumes (PVs) will solve the issue.\n\n1. Get the application URL by running these commands:\n  export POD_NAME=$(kubectl get pods --namespace unleash -l \"app.kubernetes.io/name=unleash,app.kubernetes.io/instance=unleash\" -o jsonpath=\"{.items[0].metadata.name}\")\n  export CONTAINER_PORT=$(kubectl get pod --namespace unleash $POD_NAME -o jsonpath=\"{.spec.containers[0].ports[0].containerPort}\")\n  echo \"Visit http://127.0.0.1:8080 to use your application\"\n  kubectl --namespace unleash port-forward $POD_NAME 8080:$CONTAINER_PORT\n","revision":1,"values":"{\"unleash\":{\"env\":[{\"name\":\"INIT_ADMIN_API_TOKENS\",\"value\":\"*:*.dev-phase-unleash-admin-password-not-for-prod-use\"}],\"postgresql\":{\"enabled\":true},\"replicaCount\":1}}","version":"0.1.0"}],"name":"unleash","namespace":"unleash","pass_credentials":false,"postrender":[],"recreate_pods":false,"render_subchart_notes":true,"replace":false,"repository":null,"repository_ca_file":null,"repository_cert_file":null,"repository_key_file":null,"repository_password":null,"repository_username":null,"reset_values":false,"reuse_values":false,"set":[{"name":"unleash.env[0].name","type":"","value":"INIT_ADMIN_API_TOKENS"}],"set_list":[],"set_sensitive":[{"name":"unleash.env[0].value","type":"","value":"*:*.dev-phase-unleash-admin-password-not-for-prod-use"}],"skip_crds":false,"status":"deployed","timeout":600,"upgrade_install":null,"values":["# ponytail: bundled postgresql subchart (own DB, not the shared homelab one -\n# these phase clusters have no shared postgres). Admin bootstrap token set\n# via terraform `set_sensitive` (unleash.tf, INIT_ADMIN_API_TOKENS env var),\n# not in this file.\nunleash:\n  replicaCount: 1\n\n  postgresql:\n    enabled: true\n"],"verify":false,"version":"0.1.0","wait":true,"wait_for_jobs":false},"sensitive_attributes":[[{"type":"get_attr","value":"repository_password"}],[{"type":"get_attr","value":"set_sensitive"}]],"private":"eyJzY2hlbWFfdmVyc2lvbiI6IjEifQ==","dependencies":["module.platform_apps.kubernetes_namespace.unleash"]}]},{"module":"module.platform_apps","mode":"managed","type":"helm_release","name":"vault","provider":"provider[\"registry.opentofu.org/hashicorp/helm\"]","instances":[{"index_key":0,"schema_version":1,"attributes":{"atomic":false,"chart":"../modules/platform-apps/../../../helm/vault","cleanup_on_fail":false,"create_namespace":false,"dependency_update":true,"description":null,"devel":null,"disable_crd_hooks":false,"disable_openapi_validation":false,"disable_webhooks":false,"force_update":false,"id":"vault","keyring":null,"lint":false,"manifest":null,"max_history":0,"metadata":[{"app_version":"","chart":"vault","first_deployed":1790139882,"last_deployed":1790139882,"name":"vault","namespace":"vault","notes":"\nThank you for installing HashiCorp Vault!\n\nNow that you have deployed Vault, you should look over the docs on using\nVault with Kubernetes available here:\n\nhttps://developer.hashicorp.com/vault/docs\n\n\nYour release is named vault. To learn more about the release, try:\n\n  $ helm status vault\n  $ helm get manifest vault\n\n","revision":1,"values":"{\"vault\":{\"injector\":{\"enabled\":false},\"server\":{\"dev\":{\"devRootToken\":\"(sensitive value)\",\"enabled\":true},\"ha\":{\"enabled\":false}}}}","version":"0.1.0"}],"name":"vault","namespace":"vault","pass_credentials":false,"postrender":[],"recreate_pods":false,"render_subchart_notes":true,"replace":false,"repository":null,"repository_ca_file":null,"repository_cert_file":null,"repository_key_file":null,"repository_password":null,"repository_username":null,"reset_values":false,"reuse_values":false,"set":[],"set_list":[],"set_sensitive":[{"name":"vault.server.dev.devRootToken","type":"","value":"dev-phase-vault-root-token-not-for-prod-use"}],"skip_crds":false,"status":"deployed","timeout":600,"upgrade_install":null,"values":["# ponytail: dev mode - in-memory, single known root token, no unseal, data\n# lost on pod restart. Fine for testing \"does my app read a secret from Vault\n# at boot\" - not a real secret store. Swap server.dev.enabled for\n# server.standalone.enabled + a file/raft storage block before this holds\n# anything that matters. devRootToken set via terraform `set_sensitive`\n# (vault.tf), not in this file.\nvault:\n  server:\n    dev:\n      enabled: true\n    ha:\n      enabled: false\n\n  injector:\n    enabled: false\n"],"verify":false,"version":"0.1.0","wait":true,"wait_for_jobs":false},"sensitive_attributes":[[{"type":"get_attr","value":"repository_password"}],[{"type":"get_attr","value":"set_sensitive"}]],"private":"eyJzY2hlbWFfdmVyc2lvbiI6IjEifQ==","dependencies":["module.platform_apps.kubernetes_namespace.vault"]}]},{"module":"module.platform_apps","mode":"managed","type":"kubernetes_namespace","name":"apicurio","provider":"provider[\"registry.opentofu.org/hashicorp/kubernetes\"]","instances":[{"index_key":0,"schema_version":0,"attr