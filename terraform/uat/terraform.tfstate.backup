{"version":4,"terraform_version":"1.12.5","serial":7,"lineage":"988506b7-278f-8a2a-aaf1-cc5df76d2d76","outputs":{},"resources":[{"module":"module.platform_apps","mode":"managed","type":"helm_release","name":"apicurio","provider":"provider[\"registry.opentofu.org/hashicorp/helm\"]","instances":[{"index_key":0,"schema_version":1,"attributes":{"atomic":false,"chart":"../modules/platform-apps/../../../helm/apicurio-registry","cleanup_on_fail":false,"create_namespace":false,"dependency_update":true,"description":null,"devel":null,"disable_crd_hooks":false,"disable_openapi_validation":false,"disable_webhooks":false,"force_update":false,"id":"apicurio-registry","keyring":null,"lint":false,"manifest":null,"max_history":0,"metadata":[{"app_version":"","chart":"apicurio-registry","first_deployed":1790139882,"last_deployed":1790139882,"name":"apicurio-registry","namespace":"apicurio","notes":"","revision":1,"values":"{\"apicurio-registry\":{\"registry\":{\"enabled\":true}}}","version":"0.1.0"}],"name":"apicurio-registry","namespace":"apicurio","pass_credentials":false,"postrender":[],"recreate_pods":false,"render_subchart_notes":true,"replace":false,"repository":null,"repository_ca_file":null,"repository_cert_file":null,"repository_key_file":null,"repository_password":null,"repository_username":null,"reset_values":false,"reuse_values":false,"set":[],"set_list":[],"set_sensitive":[],"skip_crds":false,"status":"deployed","timeout":600,"upgrade_install":null,"values":["# ponytail: chart defaults already do what we want - registry.enabled=true,\n# in-memory storage (kafka/postgres persistence block left commented in the\n# upstream chart = mem image variant). Chart also ships a \"sync\" sidecar\n# component (k8s-resource sync) enabled by default - harmless, left as-is.\n# Migrate to the kafka-backed persistence block (against helm_release.kafka)\n# before production actually depends on schemas surviving a restart.\napicurio-registry:\n  registry:\n    enabled: true\n"],"verify":false,"version":"0.1.0","wait":true,"wait_for_jobs":false},"sensitive_attributes":[[{"type":"get_attr","value":"repository_password"}]],"private":"eyJzY2hlbWFfdmVyc2lvbiI6IjEifQ==","dependencies":["module.platform_apps.kubernetes_namespace.apicurio"]}]},{"module":"module.platform_apps","mode":"managed","type":"helm_release","name":"authentik","provider":"provider[\"registry.opentofu.org/hashicorp/helm\"]","instances":[{"index_key":0,"schema_version":1,"attributes":{"atomic":false,"chart":"../modules/platform-apps/../../../helm/authentik","cleanup_on_fail":false,"create_namespace":false,"dependency_update":true,"description":null,"devel":null,"disable_crd_hooks":false,"disable_openapi_validation":false,"disable_webhooks":false,"force_update":false,"id":"authentik","keyring":null,"lint":false,"manifest":null,"max_history":0,"metadata":[{"app_version":"","chart":"authentik","first_deployed":1790140045,"last_deployed":1790140045,"name":"authentik","namespace":"authentik","notes":"Run the commands below to get a kubeconfig file for authentik:\n\nKUBE_API=$(kubectl config view --minify --output jsonpath=\"{.clusters[*].cluster.server}\")\nNAMESPACE=authentik\nSECRET_NAME=$(kubectl get serviceaccount authentik -o jsonpath='{.secrets[0].name}' 2\u003e/dev/null || echo -n \"authentik\")\nKUBE_CA=$(kubectl -n $NAMESPACE get secret/$SECRET_NAME -o jsonpath='{.data.ca\\.crt}')\nKUBE_TOKEN=$(kubectl -n $NAMESPACE get secret/$SECRET_NAME -o jsonpath='{.data.token}' | base64 --decode)\n\necho \"apiVersion: v1\nkind: Config\nclusters:\n- name: default-cluster\n  cluster:\n    certificate-authority-data: ${KUBE_CA}\n    server: ${KUBE_API}\ncontexts:\n- name: default-context\n  context:\n    cluster: default-cluster\n    namespace: $NAMESPACE\n    user: authentik-user\ncurrent-context: default-context\nusers:\n- name: authentik-user\n  user:\n    token: ${KUBE_TOKEN}\"\n","revision":1,"values":"{\"authentik\":{\"authentik\":{\"log_level\":\"info\",\"postgresql\":{\"host\":\"postgres.postgres.svc.cluster.local\",\"name\":\"authentik\",\"password\":\"(sensitive value)\",\"user\":\"authentik\"},\"redis\":{\"host\":\"redis.redis.svc.cluster.local\"},\"secret_key\":\"(sensitive value)\"},\"global\":{\"env\":[{\"name\":\"AUTHENTIK_BOOTSTRAP_TOKEN\",\"value\":\"dev-phase-authentik-bootstrap-token-not-for-prod-use\"},{\"name\":\"AUTHENTIK_BOOTSTRAP_PASSWORD\",\"value\":\"Admin1234!\"}]},\"postgresql\":{\"enabled\":false},\"redis\":{\"enabled\":false},\"server\":{\"ingress\":{\"enabled\":false},\"replicas\":1},\"worker\":{\"replicas\":1}}}","version":"0.1.0"}],"name":"authentik","namespace":"authentik","pass_credentials":false,"postrender":[],"recreate_pods":false,"render_subchart_notes":true,"replace":false,"repository":null,"repository_ca_file":null,"repository_cert_file":null,"repository_key_file":null,"repository_password":null,"repository_username":null,"reset_values":false,"reuse_values":false,"set":[{"name":"authentik.global.env[0].name","type":"","value":"AUTHENTIK_BOOTSTRAP_TOKEN"},{"name":"authentik.global.env[1].name","type":"","value":"AUTHENTIK_BOOTSTRAP_PASSWORD"}],"set_list":[],"set_sensitive":[{"name":"authentik.authentik.postgresql.password","type":"","value":"dev-phase-shared-db-password-not-for-prod-use"},{"name":"authentik.authentik.secret_key","type":"","value":"dev-phase-authentik-secret-key-not-for-prod-use"},{"name":"authentik.global.env[0].value","type":"","value":"dev-phase-authentik-bootstrap-token-not-for-prod-use"},{"name":"authentik.global.env[1].value","type":"","value":"Admin1234!"}],"skip_crds":false,"status":"deployed","timeout":900,"upgrade_install":null,"values":["# ponytail: sit/uat/production only. Unlike values.yaml (internal cluster -\n# shared postgres/redis, tailscale/OIDC/traefik-local ingress wiring) these\n# phase clusters get their own dedicated postgres/redis pods instead (see\n# postgres.tf/redis.tf) - no ingress (reached via port-forward/in-cluster\n# only for now).\n# secret_key / bootstrap token+password are set via terraform `set_sensitive`\n# (same pattern as internal's authentik.tf), not in this file.\nauthentik:\n  authentik:\n    log_level: info\n\n    # ponytail: dedicated postgres:16 / redis:7-alpine per phase cluster\n    # (postgres.tf / redis.tf in platform-apps, same official images as\n    # internal's helm/postgres / helm/redis) — avoids the goauthentik chart's\n    # bundled bitnami postgresql/redis subcharts entirely.\n    postgresql:\n      host: \"postgres.postgres.svc.cluster.local\"\n      name: \"authentik\"\n      user: \"authentik\"\n      password: \"\"  # set via terraform (phase_shared_db_password)\n    redis:\n      host: \"redis.redis.svc.cluster.local\"\n\n  postgresql:\n    enabled: false\n  redis:\n    enabled: false\n\n  server:\n    replicas: 1\n    ingress:\n      enabled: false\n\n  worker:\n    replicas: 1\n"],"verify":false,"version":"0.1.0","wait":true,"wait_for_jobs":false},"sensitive_attributes":[[{"type":"get_attr","value":"repository_password"}],[{"type":"get_attr","value":"set_sensitive"}]],"private":"eyJzY2hlbWFfdmVyc2lvbiI6IjEifQ==","dependencies":["module.platform_apps.helm_release.postgres","module.platform_apps.helm_release.redis","module.platform_apps.kubernetes_namespace.authentik","module.platform_apps.kubernetes_namespace.postgres","module.platform_apps.kubernetes_namespace.redis"]}]},{"module":"module.platform_apps","mode":"managed","type":"helm_release","name":"kafka","provider":"provider[\"registry.opentofu.org/hashicorp/helm\"]","instances":[{"index_key":0,"schema_version":1,"attributes":{"atomic":false,"chart":"../modules/platform-apps/../../../helm/kafka","cleanup_on_fail":false,"create_namespace":false,"dependency_update":true,"description":null,"devel":null,"disable_crd_hooks":false,"disable_openapi_validation":false,"disable_webhooks":false,"force_update":false,"id":"kafka","keyring":null,"lint":false,"manifest":null,"max_history":0,"metadata":[{"app_version":"","chart":"kafka","first_deployed":1790139882,"last_deployed":1790139882,"name":"kafka","namespace":"kafka","notes":"","revision":1,"values":"{\"image\":\"apache/kafka:4.3.0\",\"resources\":{\"limits\":{\"memory\":\"1Gi\"},\"requests\":{\"cpu\":\"100m\",\"memory\":\"512Mi\"}},\"storageSize\":\"2Gi\"}","version":"0.1.0"}],"name":"kafka","namespace":"kafka","pass_credentials":false,"postrender":[],"recreate_pods":false,"render_subchart_notes":true,"replace":false,"repository":null,"repository_ca_file":null,"repository_cert_file":null,"repository_key_file":null,"repository_password":null,"repository_username":null,"reset_values":false,"reuse_values":false,"set":[],"set_list":[],"set_sensitive":[],"skip_crds":false,"status":"deployed","timeout":600,"upgrade_install":null,"values":["# ponytail: single-node KRaft (combined broker+controller), PLAINTEXT\n# listener (no SASL/TLS) - fine for cluster-internal-only traffic in a lab.\n# Official apache/kafka image (no bitnami). Add SASL/TLS + more nodes before\n# anything outside the cluster needs to reach it.\nimage: apache/kafka:4.3.0\n\nstorageSize: 2Gi\n\nresources:\n  requests:\n    cpu: 100m\n    memory: 512Mi\n  limits:\n    memory: 1Gi\n"],"verify":false,"version":"0.1.0","wait":true,"wait_for_jobs":false},"sensitive_attributes":[[{"type":"get_attr","value":"repository_password"}]],"private":"eyJzY2hlbWFfdmVyc2lvbiI6IjEifQ==","dependencies":["module.platform_apps.kubernetes_namespace.kafka"]}]},{"module":"module.platform_apps","mode":"managed","type":"helm_release","name":"kubecost","provider":"provider[\"registry.opentofu.org/hashicorp/helm\"]","instances":[{"index_key":0,"schema_version":1,"attributes":{"atomic":false,"chart":"../modules/platform-apps/../../../helm/kubecost","cleanup_on_fail":false,"create_namespace":false,"dependency_update":true,"description":null,"devel":null,"disable_crd_hooks":false,"disable_openapi_validation":false,"disable_webhooks":false,"force_update":false,"id":"kubecost","keyring":null,"lint":false,"manifest":null,"max_history":0,"metadata":[{"app_version":"","chart":"kubecost","first_deployed":1790139882,"last_deployed":1790139882,"name":"kubecost","namespace":"kubecost","notes":"--------------------------------------------------\nKubecost 2.8.7 has been successfully installed.\n\nKubecost 2.x is a major upgrade from previous versions and includes major new features including a brand new API Backend. Please review the following documentation to ensure a smooth transition: https://www.ibm.com/docs/en/kubecost/self-hosted/2.x?topic=installation-kubecost-v2-installupgrade\n\nWhen pods are Ready, you can enable port-forwarding with the following command:\n\n    kubectl port-forward --namespace kubecost deployment/kubecost-cost-analyzer 9090\n\nThen, navigate to http://localhost:9090 in a web browser.\n\nPlease allow 25 minutes for Kubecost to gather metrics. A progress indicator will appear at the top of the UI.\n\nHaving installation issues? View our Troubleshooting Guide at https://www.ibm.com/docs/en/kubecost/self-hosted/2.x?topic=troubleshoot-install","revision":1,"values":"{\"cost-analyzer\":{\"global\":{\"clusterId\":\"uat\",\"grafana\":{\"enabled\":false},\"prometheus\":{\"enabled\":true}},\"prometheus\":{\"server\":{\"global\":{\"external_labels\":{\"cluster_id\":\"uat\"}},\"persistentVolume\":{\"size\":\"2Gi\"},\"remoteWrite\":[{\"url\":\"http://host.docker.internal:30510/api/v1/push\"}]}}}}","version":"0.1.0"}],"name":"kubecost","namespace":"kubecost","pass_credentials":false,"postrender":[],"recreate_pods":false,"render_subchart_notes":true,"replace":false,"repository":null,"repository_ca_file":null,"repository_cert_file":null,"repository_key_file":null,"repository_password":null,"repository_username":null,"reset_values":false,"reuse_values":false,"set":[{"name":"cost-analyzer.global.clusterId","type":"","value":"uat"},{"name":"cost-analyzer.prometheus.server.global.external_labels.cluster_id","type":"","value":"uat"},{"name":"cost-analyzer.prometheus.server.remoteWrite[0].url","type":"","value":"http://host.docker.internal:30510/api/v1/push"}],"set_list":[],"set_sensitive":[],"skip_crds":false,"status":"deployed","timeout":600,"upgrade_install":null,"values":["# ponytail: shared across all 4 clusters (internal + sit/uat/production).\n# clusterId and prometheus.server.remoteWrite differ per cluster - set via\n# terraform `set{}` in each cluster's kubecost.tf, not in this file.\ncost-analyzer:\n  global:\n    grafana:\n      # ponytail: we wire kubecost's metrics into the existing internal\n      # Grafana (helm/observability) via Mimir remote_write instead of\n      # running a redundant Grafana per cluster.\n      enabled: false\n    prometheus:\n      enabled: true\n\n  prometheus:\n    server:\n      persistentVolume:\n        size: 2Gi\n      global:\n        external_labels: {}\n"],"verify":false,"version":"0.1.0","wait":true,"wait_for_jobs":false},"sensitive_attributes":[[{"type":"get_attr","value":"repository_password"}]],"private":"eyJzY2hlbWFfdmVyc2lvbiI6IjEifQ==","dependencies":["module.platform_apps.kubernetes_namespace.kubecost"]}]},{"module":"module.platform_apps","mode":"managed","type":"helm_release","name":"meilisearch","provider":"provider[\"registry.opentofu.org/hashicorp/helm\"]","instances":[{"index_key":0,"schema_version":1,"attributes":{"atomic":false,"chart":"../modules/platform-apps/../../../helm/meilisearch","cleanup_on_fail":false,"create_namespace":false,"dependency_update":true,"description":null,"devel":null,"disable_crd_hooks":false,"disable_openapi_validation":false,"disable_webhooks":false,"force_update":false,"id":"meilisearch","keyring":null,"lint":false,"manifest":null,"max_history":0,"metadata":[{"app_version":"","chart":"meilisearch","first_deployed":1790139882,"last_deployed":1790139882,"name":"meilisearch","namespace":"meilisearch","notes":"1. Get the application URL by running these commands:\n  kubectl port-forward --namespace meilisearch svc/meilisearch 7700:7700 \u0026\n  echo \"Visit http://127.0.0.1:7700 to use your application\"","revision":1,"values":"{\"meilisearch\":{\"environment\":{\"MEILI_MASTER_KEY\":\"(sensitive value)\"},\"persistence\":{\"enabled\":true,\"size\":\"1Gi\"}}}","version":"0.1.0"}],"name":"meilisearch","namespace":"meilisearch","pass_credentials":false,"postrender":[],"recreate_pods":false,"render_subchart_notes":true,"replace":false,"repository":null,"repository_ca_file":null,"repository_cert_file":null,"repository_key_file":null,"repository_password":null,"repository_username":null,"reset_values":false,"reuse_values":false,"set":[],"set_list":[],"set_sensitive":[{"name":"meilisearch.environment.MEILI_MASTER_KEY","type":"","value":"dev-phase-meilisearch-master-key-not-for-prod-use"}],"skip_crds":false,"status":"deployed","timeout":600,"upgrade_install":null,"values":["# ponytail: MEILI_MASTER_KEY set via terraform `set_sensitive`\n# (meilisearch.tf), not in this file.\nmeilisearch:\n  persistence:\n    enabled: true\n    size: 1Gi\n"],"verify":false,"version":"0.1.0","wait":true,"wait_for_jobs":false},"sensitive_attributes":[[{"type":"get_attr","value":"repository_password"}],[{"type":"get_attr","value":"set_sensitive"}]],"private":"eyJzY2hlbWFfdmVyc2lvbiI6IjEifQ==","dependencies":["module.platform_apps.kubernetes_namespace.meilisearch"]}]},{"module":"module.platform_apps","mode":"managed","type":"helm_release","name":"minio","provider":"provider[\"registry.opentofu.org/hashicorp/helm\"]","instances":[{"index_key":0,"schema_version":1,"attributes":{"atomic":false,"chart":"../modules/platform-apps/../../../helm/minio","cleanup_on_fail":false,"create_namespace":false,"dependency_update":true,"description":null,"devel":null,"disable_crd_hooks":false,"disable_openapi_validation":false,"disable_webhooks":false,"force_update":false,"id":"minio","keyring":null,"lint":false,"manifest":null,"max_history":0,"metadata":[{"app_version":"","chart":"minio","first_deployed":1790139882,"last_deployed":1790139882,"name":"minio","namespace":"minio","notes":"\nMinIO can be accessed via port 9000 on the following DNS name from within your cluster:\nminio.minio.cluster.local\n\nTo access MinIO from localhost, run the below commands:\n\n  1. export POD_NAME=$(kubectl get pods --namespace minio -l \"release=minio\" -o jsonpath=\"{.items[0].metadata.name}\")\n\n  2. kubectl port-forward $POD_NAME 9000 --namespace minio\n\nRead more about port forwarding here: http://kubernetes.io/docs/user-guide/kubectl/kubectl_port-forward/\n\nYou can now access MinIO server on http://localhost:9000. Follow the below steps to connect to MinIO server with mc client:\n\n  1. Download the MinIO mc client - https://min.io/docs/minio/linux/reference/minio-mc.html#quickstart\n\n  2. export MC_HOST_minio-local=http://$(kubectl get secret --namespace minio minio -o jsonpath=\"{.data.rootUser}\" | base64 --decode):$(kubectl get secret --namespace minio minio -o jsonpath=\"{.data.rootPassword}\" | base64 --decode)@localhost:9000\n\n  3. mc ls minio-local\n\n\n","revision":1,"values":"{\"minio\":{\"consoleIngress\":{\"enabled\":false},\"drivesPerNode\":1,\"ingress\":{\"enabled\":false},\"mode\":\"standalone\",\"persistence\":{\"size\":\"2Gi\"},\"pools\":1,\"replicas\":1,\"rootPassword\":\"(sensitive value)\",\"rootUser\":\"admin\",\"trustedCertsSecret\":\"\"}}","version":"0.1.0"}],"name":"minio","namespace":"minio","pass_credentials":false,"postrender":[],"recreate_pods":false,"render_subchart_notes":true,"replace":false,"repository":null,"repository_ca_file":null,"repository_cert_file":null,"repository_key_file":null,"repository_password":null,"repository_username":null,"reset_values":false,"reuse_values":false,"set":[{"name":"minio.rootUser","type":"","value":"admin"}],"set_list":[],"set_sensitive":[{"name":"minio.rootPassword","type":"","value":"dev-phase-minio-root-password-not-for-prod-use"}],"skip_crds":false,"status":"deployed","timeout":600,"upgrade_install":null,"values":["# ponytail: sit/uat/production only. No OIDC (no reachable Authentik-for-\n# discovery path set up here the way values.yaml's does on internal), no\n# homelab-CA trust, no local-domain ingress - just object storage. rootUser/\n# rootPassword set via terraform `set_sensitive`, not in this file.\nminio:\n  # ponytail: chart default is the __MINIO_TRUSTED_CA_SECRET__ placeholder\n  # (internal substitutes it via terraform); phase clusters have no homelab\n  # CA, empty disables the volume mount entirely (mirrors the Tiltfile).\n  trustedCertsSecret: \"\"\n  mode: standalone\n  replicas: 1\n  drivesPerNode: 1\n  pools: 1\n\n  persistence:\n    size: 2Gi\n\n  ingress:\n    enabled: false\n  consoleIngress:\n    enabled: false\n"],"verify":false,"version":"0.1.0","wait":true,"wait_for_jobs":false},"sensitive_attributes":[[{"type":"get_attr","value":"repository_password"}],[{"type":"get_attr","value":"set_sensitive"}]],"private":"eyJzY2hlbWFfdmVyc2lvbiI6IjEifQ==","dependencies":["module.platform_apps.kubernetes_namespace.minio"]}]},{"module":"module.platform_apps","mode":"managed","type":"helm_release","name":"postgres","provider":"provider[\"registry.opentofu.org/hashicorp/helm\"]","instances":[{"index_key":0,"schema_version":1,"attributes":{"atomic":false,"chart":"../modules/platform-apps/../../../helm/postgres","cleanup_on_fail":false,"create_namespace":false,"dependency_update":true,"description":null,"devel":null,"disable_crd_hooks":false,"disable_openapi_validation":false,"disable_webhooks":false,"force_update":false,"id":"postgres","keyring":null,"lint":false,"manifest":null,"max_history":0,"metadata":[{"app_version":"","chart":"postgres","first_deployed":1790139882,"last_deployed":1790139882,"name":"postgres","namespace":"postgres","notes":"","revision":1,"values":"{\"databases\":[\"authentik\"],\"gitlabDatabase\":\"\",\"password\":\"(sensitive value)\"}","version":"0.1.0"}],"name":"postgres","namespace":"postgres","pass_credentials":false,"postrender":[],"recreate_pods":false,"render_subchart_notes":true,"replace":false,"repository":