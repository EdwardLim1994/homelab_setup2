# ponytail: the one shared postgres. Every app Tiltfile that used to render its
# own postgres now depends on this resource instead.
k8s_yaml(blob('apiVersion: v1\nkind: Namespace\nmetadata:\n  name: postgres'))

shared_db_password = os.getenv('TF_VAR_shared_db_password', 'dev-shared-db-password-not-for-prod-use')

k8s_yaml(helm(
  '.',
  name='postgres',
  namespace='postgres',
  set=['password=' + shared_db_password],
))

k8s_resource('postgres')
