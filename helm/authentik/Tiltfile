# ponytail: local_resource cmd cwd is this Tiltfile's own directory, not repo root
local_resource(
  'authentik-helm-deps',
  cmd='helm dependency update .',
  deps=['Chart.yaml'],
)

k8s_yaml(blob('apiVersion: v1\nkind: Namespace\nmetadata:\n  name: authentik'))

# ponytail: read from `.env` (see .env.example — same TF_VAR_-prefixed
# names terraform uses, so `source .env` before `tilt up` is the one place
# both tools' secrets come from). Falls back to the old dev-fixed values so
# `tilt up` still works with zero setup. Fixed (not regenerated) because
# any file change under the Tiltfile tree triggers a full reload, and a
# re-randomized db password would no longer match the already-initialized
# postgres data dir. Fine, throwaway cluster.
authentik_secret_key = os.getenv('TF_VAR_authentik_secret_key', 'dev-authentik-secret-key-not-for-prod-use')
authentik_db_password = os.getenv('TF_VAR_authentik_db_password', 'dev-authentik-db-password')
# ponytail: bootstrap token lets Tilt/terraform drive the Authentik API
# directly (create OAuth2 providers, sources, etc.) without a manual
# admin-password setup flow. https://docs.goauthentik.io/docs/installation/configuration#bootstrap
authentik_bootstrap_token = os.getenv('TF_VAR_authentik_bootstrap_token', 'dev-authentik-bootstrap-token-not-for-prod-use')
authentik_bootstrap_password = os.getenv('TF_VAR_authentik_bootstrap_password', 'Admin1234!')

# ponytail: real external credential (actual GitHub OAuth App), not a
# throwaway dev value like the rest of this file — MUST come from `.env`
# (gitignored), never hardcoded here. This repo's cluster has already lost
# its Authentik DB once to an infra-level PVC wipe (k3d node container
# recreated), so keeping this only as a one-off ak shell command means
# redoing it by hand every time that happens. Setting it as env vars on
# the authentik pods + provisioning via API on every Tilt reload makes
# GitHub login self-healing across wipes, matching how every other app's
# OAuth provider here is already Tilt-managed.
github_oauth_client_id = os.getenv('TF_VAR_github_oauth_client_id', 'changeme')
github_oauth_client_secret = os.getenv('TF_VAR_github_oauth_client_secret', 'changeme')

k8s_yaml(helm(
  '.',
  name='authentik',
  namespace='authentik',
  set=[
    'authentik.authentik.secret_key=' + authentik_secret_key,
    'authentik.authentik.postgresql.password=' + authentik_db_password,
    'authentik.postgresql.auth.password=' + authentik_db_password,
    'authentik.global.env[0].name=AUTHENTIK_BOOTSTRAP_TOKEN',
    'authentik.global.env[0].value=' + authentik_bootstrap_token,
    'authentik.global.env[1].name=AUTHENTIK_BOOTSTRAP_PASSWORD',
    'authentik.global.env[1].value=' + authentik_bootstrap_password,
    'authentik.global.env[2].name=AUTHENTIK_BOOTSTRAP_EMAIL',
    'authentik.global.env[2].value=akadmin@authentik.local',
    'authentik.global.env[3].name=GITHUB_OAUTH_CLIENT_ID',
    'authentik.global.env[3].value=' + github_oauth_client_id,
    'authentik.global.env[4].name=GITHUB_OAUTH_CLIENT_SECRET',
    'authentik.global.env[4].value=' + github_oauth_client_secret,
  ],
))

k8s_resource(
  'authentik-server',
  port_forwards=['9000:9000'],
  resource_deps=['authentik-helm-deps'],
)

# ponytail: idempotent — creates the GitHub source only if it doesn't
# already exist, so re-running on every Tilt reload / cluster wipe just
# no-ops once it's there. Runs after authentik-server so `ak shell` has a
# live pod to exec into.
local_resource(
  'authentik-github-source',
  cmd="kubectl exec -i -n authentik deploy/authentik-server -- env GITHUB_OAUTH_CLIENT_ID=%s GITHUB_OAUTH_CLIENT_SECRET=%s ADMIN_EMAIL=%s ak shell < provision-github-source.py" % (os.getenv('TF_VAR_github_oauth_client_id', 'changeme'), os.getenv('TF_VAR_github_oauth_client_secret', 'changeme'), os.getenv('TF_VAR_admin_email', 'edwardlimkoksiong1994@gmail.com')),
  deps=['provision-github-source.py'],
  resource_deps=['authentik-server'],
)

# ponytail: same self-healing pattern as the GitHub source above, but for
# the 5 apps' own OAuth2 providers/applications — these used to be created
# once by hand and silently vanish on every full cluster/PVC wipe (has
# already happened more than once), leaving every app's "Log in with
# Authentik" broken until someone notices and re-runs the same ak shell
# command manually. Fallback values match each app's own Tiltfile exactly.
local_resource(
  'authentik-app-providers',
  cmd='''kubectl exec -i -n authentik deploy/authentik-server -- env \
GITLAB_OIDC_CLIENT_ID=%s GITLAB_OIDC_CLIENT_SECRET=%s \
MINIO_OIDC_CLIENT_ID=%s MINIO_OIDC_CLIENT_SECRET=%s \
N8N_OIDC_CLIENT_ID=%s N8N_OIDC_CLIENT_SECRET=%s \
SONARQUBE_OIDC_CLIENT_ID=%s SONARQUBE_OIDC_CLIENT_SECRET=%s \
SEAFILE_OIDC_CLIENT_ID=%s SEAFILE_OIDC_CLIENT_SECRET=%s \
ARGOCD_OIDC_CLIENT_ID=%s ARGOCD_OIDC_CLIENT_SECRET=%s \
GRAFANA_OIDC_CLIENT_ID=%s GRAFANA_OIDC_CLIENT_SECRET=%s \
OPENWEBUI_OIDC_CLIENT_ID=%s OPENWEBUI_OIDC_CLIENT_SECRET=%s \
LITELLM_OIDC_CLIENT_ID=%s LITELLM_OIDC_CLIENT_SECRET=%s \
ADMIN_EMAIL=%s TS_HOST=%s \
ak shell < provision-app-providers.py''' % (
    os.getenv('TF_VAR_gitlab_oidc_client_id', 'dev-gitlab-oidc-client-id'),
    os.getenv('TF_VAR_gitlab_oidc_client_secret', 'dev-gitlab-oidc-client-secret-not-for-prod-use'),
    os.getenv('TF_VAR_minio_oidc_client_id', 'dev-minio-oidc-client-id'),
    os.getenv('TF_VAR_minio_oidc_client_secret', 'dev-minio-oidc-client-secret-not-for-prod-use'),
    os.getenv('TF_VAR_n8n_oidc_client_id', 'dev-n8n-oidc-client-id'),
    os.getenv('TF_VAR_n8n_oidc_client_secret', 'dev-n8n-oidc-client-secret-not-for-prod-use'),
    os.getenv('TF_VAR_sonarqube_oidc_client_id', 'dev-sonarqube-oidc-client-id'),
    os.getenv('TF_VAR_sonarqube_oidc_client_secret', 'dev-sonarqube-oidc-client-secret-not-for-prod-use'),
    os.getenv('TF_VAR_seafile_oidc_client_id', 'dev-seafile-oidc-client-id'),
    os.getenv('TF_VAR_seafile_oidc_client_secret', 'dev-seafile-oidc-client-secret-not-for-prod-use'),
    os.getenv('TF_VAR_argocd_oidc_client_id', 'dev-argocd-oidc-client-id'),
    os.getenv('TF_VAR_argocd_oidc_client_secret', 'dev-argocd-oidc-client-secret-not-for-prod-use'),
    os.getenv('TF_VAR_grafana_oidc_client_id', 'dev-grafana-oidc-client-id'),
    os.getenv('TF_VAR_grafana_oidc_client_secret', 'dev-grafana-oidc-client-secret-not-for-prod-use'),
    os.getenv('TF_VAR_openwebui_oidc_client_id', 'dev-openwebui-oidc-client-id'),
    os.getenv('TF_VAR_openwebui_oidc_client_secret', 'dev-openwebui-oidc-client-secret-not-for-prod-use'),
    os.getenv('TF_VAR_litellm_oidc_client_id', 'dev-litellm-oidc-client-id'),
    os.getenv('TF_VAR_litellm_oidc_client_secret', 'dev-litellm-oidc-client-secret-not-for-prod-use'),
    os.getenv('TF_VAR_admin_email', 'edwardlimkoksiong1994@gmail.com'),
    os.getenv('TS_HOST', ''),
  ),
  deps=['provision-app-providers.py'],
  resource_deps=['authentik-server'],
)
