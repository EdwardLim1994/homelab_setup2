# ponytail: local_resource cmd cwd is this Tiltfile's own directory, not repo root
local_resource(
  'minio-helm-deps',
  cmd='helm dependency update .',
  deps=['Chart.yaml'],
)

k8s_yaml(blob('apiVersion: v1\nkind: Namespace\nmetadata:\n  name: minio'))

# ponytail: read from `.env` (see .env.example), same TF_VAR_-prefixed
# names terraform uses. Falls back to the old dev-fixed values so `tilt up`
# still works with zero setup. Fixed (not regenerated) because any Tiltfile-
# tree change triggers reload, and a re-randomized password would no longer
# match the already-initialized data dir.
minio_root_password = os.getenv('TF_VAR_minio_root_password', 'dev-minio-root-password')
# ponytail: fixed dev client_id/secret matching the Authentik OAuth2
# provider created via the API (same one-time-setup pattern as GitLab's).
minio_oidc_client_id = os.getenv('TF_VAR_minio_oidc_client_id', 'dev-minio-oidc-client-id')
minio_oidc_client_secret = os.getenv('TF_VAR_minio_oidc_client_secret', 'dev-minio-oidc-client-secret-not-for-prod-use')

k8s_yaml(helm(
  '.',
  name='minio',
  namespace='minio',
  set=[
    'minio.rootPassword=' + minio_root_password,
    'minio.environment.MINIO_IDENTITY_OPENID_CLIENT_ID=' + minio_oidc_client_id,
    'minio.environment.MINIO_IDENTITY_OPENID_CLIENT_SECRET=' + minio_oidc_client_secret,
  ],
))

k8s_resource(
  'minio',
  # ponytail: local 9000 is already claimed by authentik-server's port-forward.
  # 9001 is the console/WebUI, separate from the S3 API on 9000.
  port_forwards=['9002:9000', '9003:9001'],
  resource_deps=['minio-helm-deps'],
)
