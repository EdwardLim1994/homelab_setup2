# ponytail: local_resource cmd cwd is this Tiltfile's own directory, not repo root
local_resource(
  'argocd-helm-deps',
  cmd='helm dependency update .',
  deps=['Chart.yaml'],
)

k8s_yaml(blob('apiVersion: v1\nkind: Namespace\nmetadata:\n  name: argocd'))

# ponytail: read from `.env` (see .env.example), same TF_VAR_-prefixed
# names terraform uses. Falls back to dev-fixed values so `tilt up` still
# works with zero setup.
argocd_oidc_client_id = os.getenv('TF_VAR_argocd_oidc_client_id', 'dev-argocd-oidc-client-id')
argocd_oidc_client_secret = os.getenv('TF_VAR_argocd_oidc_client_secret', 'dev-argocd-oidc-client-secret-not-for-prod-use')
argocd_server_secret_key = os.getenv('TF_VAR_argocd_server_secret_key', 'dev-argocd-server-secret-key-not-for-prod-use')
ts_host = os.getenv('TS_HOST', '')
admin_email = os.getenv('TF_VAR_admin_email', 'edwardlimkoksiong1994@gmail.com')

rendered = str(helm('.', name='argocd', namespace='argocd'))
rendered = rendered.replace('__ARGOCD_OIDC_CLIENT_ID__', argocd_oidc_client_id)
rendered = rendered.replace('__ARGOCD_OIDC_CLIENT_SECRET__', argocd_oidc_client_secret)
rendered = rendered.replace('__TS_HOST__', ts_host)
rendered = rendered.replace('__ADMIN_EMAIL__', admin_email)
k8s_yaml(blob(rendered))

# ponytail: argocd-secret.server.secretkey must be stable across restarts or
# every pod restart invalidates all sessions. The chart renders an empty
# argocd-secret (no data field) so strategic merge patch preserves existing
# data — but on a fresh cluster the secret starts empty and ArgoCD generates
# a random key. This local_resource overwrites it with a stable value from
# .env after the server pod exists. The create+dry-run|apply replaces data,
# which is fine since we don't use local admin (SSO only).
local_resource(
  'argocd-seed-secretkey',
  cmd='kubectl create secret generic argocd-secret --namespace=argocd --from-literal=server.secretkey=' + argocd_server_secret_key + ' --dry-run=client -o yaml | kubectl apply -f - && kubectl rollout restart deployment/argocd-server -n argocd',
  resource_deps=['argocd-server'],
)

k8s_resource(
  'argocd-server',
  port_forwards=['9001:8080'],
  resource_deps=['argocd-helm-deps'],
)
