    {
      "parameters": {
        "jsCode": "const revisionCount = $workflow.staticData.revisionCount || 0;\nif (revisionCount >= 3) {\n  return [{ json: { escalate: true, reason: 'Max arch revisions reached', revisions: revisionCount } }];\n}\n$workflow.staticData.revisionCount = revisionCount + 1;\nreturn [{ json: { escalate: false, revisionCount: revisionCount + 1 } }];"
      },
      "id": "check-arch-revision",
      "name": "Check: arch revision needed? (max 3)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "leftValue": "={{ $json.escalate }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ]
        }
      },
      "id": "escalate-check",
      "name": "Escalate or re-arch?",
