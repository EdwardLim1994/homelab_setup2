      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.N8N_WEBHOOK_BASE }}/spawn-role",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ role: 'solution-architect', task: 'gate-A-planning', version: $json.body.version, project: $json.body.project, openspec_path: 'openspec/architecture.md' }) }}",
        "options": {}
      },
      "id": "spawn-architect-pod",
      "name": "Spawn Architect Pod (gate A)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        480,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
