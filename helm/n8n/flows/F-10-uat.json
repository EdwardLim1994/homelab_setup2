  "nodes": [
    { "parameters": { "httpMethod": "POST", "path": "uat", "responseMode": "lastNode", "options": {} }, "id": "webhook-uat", "name": "Webhook: /uat command", "type": "n8n-nodes-base.webhook", "typeVersion": 1, "position": [240, 300] },
    { "parameters": { "url": "={{ $env.GITLAB_URL }}/api/v4/projects/{{ $json.body.project_id }}/issues?milestone={{ $json.body.version }}&labels=type:user-story&per_page=100", "authentication": "predefinedCredentialType", "nodeCredentialType": "gitlabApi", "sendHeaders": true, "headerParameters": { "parameters": [{ "name": "PRIVATE-TOKEN", "value": "={{ $env.GITLAB_TOKEN }}" }] } }, "id": "query-milestone-stories", "name": "Safeguard: query sprint milestone for all stories", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [480, 300] },
    { "parameters": { "jsCode": "const stories = $json;\nconst unmerged = stories.filter(s => !s.labels.includes('merged-to-release'));\nif (unmerged.length > 0) {\n  return [{ json: { safe: false, unmergedStories: unmerged.map(s => ({ id: s.iid, title: s.title })), count: unmerged.length } }];\n}\nreturn [{ json: { safe: true, totalStories: stories.length } }];" }, "id": "check-all-merged", "name": "Check: all stories have merged-to-release label?", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [720, 300] },
    { "parameters": { "conditions": { "conditions": [{ "leftValue": "={{ $json.safe }}", "rightValue": true, "operator": { "type": "boolean", "operation": "equals" } }] } }, "id": "safeguard-gate", "name": "Safeguard: all stories merged?", "type": "n8n-nodes-base.if", "typeVersion": 2, "position": [960, 300] },
    { "parameters": { "url": "={{ $env.N8N_WEBHOOK_BASE }}/f10-feedback", "sendBody": true, "bodyParameters": { "parameters": [{ "name": "message", "value": "UAT blocked: unfinished stories" }, { "name": "unmerged", "value": "={{ JSON.stringify($json.unmergedStories) }}" }] } }, "id": "feedback-unfinished", "name": "Feedback to Edward: unfinished stories", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [1200, 440] },
    { "parameters": { "url": "={{ $env.GITLAB_URL }}/api/v4/projects/{{ $json.body.project_id }}/pipelines", "sendBody": true, "bodyParameters": { "parameters": [{ "name": "ref", "value": "={{ 'release/' + $json.body.version }}" }, { "name": "variables[DEPLOY_ENV]", "value": "uat" }] }, "authentication": "predefinedCredentialType", "nodeCredentialType": "gitlabApi", "sendHeaders": true, "headerParameters": { "parameters": [{ "name": "PRIVATE-TOKEN", "value": "={{ $env.GITLAB_TOKEN }}" }] } }, "id": "trigger-manual-pipeline", "name": "Trigger manual CI pipeline on release branch", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [1200, 200] },
    { "parameters": { "url": "={{ $env.N8N_WEBHOOK_BASE }}/cluster-wake", "sendBody": true, "bodyParameters": { "parameters": [{ "name": "cluster", "value": "uat" }, { "name": "version", "value": "={{ $json.body.version }}" }] } }, "id": "wake-uat-cluster", "name": "Wake UAT cluster (F-27)", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [1440, 200] },
    { "parameters": { "command": "=echo 'ArgoCD sync UAT with rc images from pipeline detect-versions output'" }, "id": "argocd-sync-uat", "name": "ArgoCD sync: changed services with rc tags", "type": "n8n-nodes-base.executeCommand", "typeVersion": 1, "position": [1680, 200] },
    { "parameters": { "url": "={{ $env.N8N_WEBHOOK_BASE }}/uat-qa-start", "sendBody": true, "bodyParameters": { "parameters": [{ "name": "version", "value": "={{ $json.body.version }}" }, { "name": "project", "value": "={{ $json.body.project }}" }] } }, "id": "trigger-f11", "name": "Create QA Pod: UAT stage 1 (F-11)", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [1920, 200] }
