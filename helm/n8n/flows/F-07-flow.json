{
  "name": "F-07 Story MR Opened",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "story-mr-open",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "webhook-story-mr",
      "name": "Webhook: story MR open trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "command": "=echo '{\"role\":\"tech-lead\",\"task\":\"open-story-mr\",\"story_id\":\"{{ $json.body.story_id }}\",\"version\":\"{{ $json.body.version }}\",\"project\":\"{{ $json.body.project }}\"}' > /tmp/story-mr.json && opencode run --print \"$(cat /tmp/story-mr.json)\""
      },
      "id": "tl-opens-story-mr",
      "name": "TL opens [story] MR per repo (opencode+glab)",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        480,
        300
      ]
    },
    {
      "parameters": {
        "command": "=echo 'CI fires on story MR - builds rc images and deploys to QA cluster' && sleep 30"
      },
      "id": "wait-qa-deploy",
      "name": "Wait: CI deploys rc images to QA cluster",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        720,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.N8N_WEBHOOK_BASE }}/spawn-role",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ role: 'qa-engineer', task: 'story-testing', version: $json.body.version, project: $json.body.project }) }}",
        "options": {}
      },
      "id": "spawn-qa-story",
      "name": "Spawn QA Pod: story-level testing",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        960,
        200
      ]
    },
    {
      "parameters": {
        "url": "={{ $env.N8N_WEBHOOK_BASE }}/f07-notify-edward",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "message",
              "value": "Story MR ready for your review"
            },
            {
              "name": "story_id",
              "value": "={{ $json.body.story_id }}"
            }
          ]
        }
      },
      "id": "notify-edward-story-mr",
      "name": "Notify Edward: story MR ready for review",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        960,
        400
      ]
    }
  ],
  "connections": {
    "Webhook: story MR open trigger": {
      "main": [
        [
          {
            "node": "TL opens [story] MR per repo (opencode+glab)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "TL opens [story] MR per repo (opencode+glab)": {
      "main": [
        [
          {
            "node": "Wait: CI deploys rc images to QA cluster",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Wait: CI deploys rc images to QA cluster": {
      "main": [
        [
          {
            "node": "Spawn QA Pod: story-level testing",
            "type": "main",
            "index": 0
          },
          {
            "node": "Notify Edward: story MR ready for review",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [
    {
      "name": "development"
    },
    {
      "name": "phase-2"
    }
  ]
}
