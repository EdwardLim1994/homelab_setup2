k8s_yaml(blob('apiVersion: v1\nkind: Namespace\nmetadata:\n  name: mcp-servers'))

# ponytail: read from `.env` (see .env.example), same TF_VAR_-prefixed
# names terraform will use once this graduates out of Tilt-only. Falls
# back to empty — servers boot either way, tools just fail auth until a
# real token is set.
grafana_mcp_token = os.getenv('TF_VAR_grafana_mcp_token', '')
sonarqube_mcp_token = os.getenv('TF_VAR_sonarqube_mcp_token', '')
gitlab_mcp_token = os.getenv('TF_VAR_gitlab_mcp_token', '')
gitlab_mcp_auth_token = os.getenv('TF_VAR_gitlab_mcp_auth_token', 'dev-gitlab-mcp-auth-token')
nx_cloud_mcp_token = os.getenv('TF_VAR_nx_cloud_mcp_token', '')

k8s_yaml(helm(
  '.',
  name='mcp-servers',
  namespace='mcp-servers',
  set=[
    'servers.grafana.env.GRAFANA_SERVICE_ACCOUNT_TOKEN=' + grafana_mcp_token,
    'servers.sonarqube.env.SONARQUBE_TOKEN=' + sonarqube_mcp_token,
    'servers.gitlab.env.GITLAB_PERSONAL_ACCESS_TOKEN=' + gitlab_mcp_token,
    'servers.gitlab.env.STREAMABLE_HTTP_AUTH_TOKEN=' + gitlab_mcp_auth_token,
    'servers.nx.env.NX_CLOUD_ACCESS_TOKEN=' + nx_cloud_mcp_token,
  ],
))

# ponytail: local ports picked past the other apps' 9000s range so nothing
# collides with an already-running Tilt session.
k8s_resource('mcp-servers-grafana', port_forwards=['9101:8000'])
k8s_resource('mcp-servers-sonarqube', port_forwards=['9102:8080'])
k8s_resource('mcp-servers-gitlab', port_forwards=['9103:3002'])
k8s_resource('mcp-servers-playwright', port_forwards=['9104:8931'])
k8s_resource('mcp-servers-nx', port_forwards=['9105:9921'])
