# ponytail: local_resource cmd cwd is this Tiltfile's own directory, not repo root
local_resource(
  'tailscale-operator-helm-deps',
  cmd='helm dependency update .',
  deps=['Chart.yaml'],
)

k8s_yaml(blob('apiVersion: v1\nkind: Namespace\nmetadata:\n  name: tailscale'))

# ponytail: read from `.env`, same TF_VAR_-prefixed names terraform uses.
# No dev fallback — the operator is useless without a real OAuth client, and
# a bogus one just crashloops noisily instead of failing fast.
ts_oauth_client_id = os.getenv('TF_VAR_tailscale_oauth_client_id', '')
ts_oauth_client_secret = os.getenv('TF_VAR_tailscale_oauth_client_secret', '')

k8s_yaml(helm(
  '.',
  name='tailscale-operator',
  namespace='tailscale',
  set=[
    'tailscale-operator.oauth.clientId=' + ts_oauth_client_id,
    'tailscale-operator.oauth.clientSecret=' + ts_oauth_client_secret,
  ],
))

k8s_resource(
  'tailscale-operator',
  resource_deps=['tailscale-operator-helm-deps'],
)
