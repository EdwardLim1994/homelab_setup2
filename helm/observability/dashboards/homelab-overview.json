{
  "annotations": {
    "list": []
  },
  "editable": true,
  "graphTooltip": 0,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "title": "Homelab Overview",
  "uid": "homelab-overview",
  "tags": [
    "homelab"
  ],
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "homelab"
      ],
      "title": "Homelab",
      "asDropdown": true,
      "keepTime": true,
      "icon": "apps"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(kube_pod_info{namespace!~\"omp|ansible|observability|kube-system|kube-node-lease|kube-public|cert-manager|local-path-storage\"}, namespace)",
        "includeAll": true,
        "multi": true,
        "refresh": 2,
        "sort": 1,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "title": "App links",
      "type": "text",
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "html",
        "content": "<a href=\"https://argocd.__TAILNET_DOMAIN__\" target=\"_blank\" rel=\"noopener\">argocd</a> &nbsp;&middot;&nbsp; <a href=\"https://authentik.__TAILNET_DOMAIN__\" target=\"_blank\" rel=\"noopener\">authentik</a> &nbsp;&middot;&nbsp; <a href=\"https://gitlab.__TAILNET_DOMAIN__\" target=\"_blank\" rel=\"noopener\">gitlab</a> &nbsp;&middot;&nbsp; <a href=\"https://grafana.__TAILNET_DOMAIN__\" target=\"_blank\" rel=\"noopener\">grafana</a> &nbsp;&middot;&nbsp; <a href=\"https://litellm.__TAILNET_DOMAIN__/ui\" target=\"_blank\" rel=\"noopener\">litellm</a> &nbsp;&middot;&nbsp; <a href=\"https://minio.__TAILNET_DOMAIN__\" target=\"_blank\" rel=\"noopener\">minio-api</a> &nbsp;&middot;&nbsp; <a href=\"https://minio-console.__TAILNET_DOMAIN__\" target=\"_blank\" rel=\"noopener\">minio-console</a> &nbsp;&middot;&nbsp; <a href=\"https://n8n.__TAILNET_DOMAIN__\" target=\"_blank\" rel=\"noopener\">n8n</a> &nbsp;&middot;&nbsp; <a href=\"https://mattermost.__TAILNET_DOMAIN__\" target=\"_blank\" rel=\"noopener\">mattermost</a> &nbsp;&middot;&nbsp; <a href=\"https://nextcloud.__TAILNET_DOMAIN__\" target=\"_blank\" rel=\"noopener\">nextcloud</a> &nbsp;&middot;&nbsp; <a href=\"https://sonarqube.__TAILNET_DOMAIN__\" target=\"_blank\" rel=\"noopener\">sonarqube</a>"
      }
    },
    {
      "title": "Health summary",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 3
      }
    },
    {
      "title": "Pods ready",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 0,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(kube_pod_status_ready{namespace=~\"$namespace\", condition=\"true\"})"
        }
      ]
    },
    {
      "title": "Pods not running",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 5,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(kube_pod_status_phase{namespace=~\"$namespace\", phase!~\"Running|Succeeded\"}) or vector(0)"
        }
      ]
    },
    {
      "title": "Restarts (1h)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 10,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(kube_pod_container_status_restarts_total{namespace=~\"$namespace\"}[1h])) or vector(0)"
        }
      ]
    },
    {
      "title": "Apps serving 5xx",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 15,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(sum by (service) (rate(traefik_service_requests_total{code=~\"5..\"}[5m])) > 0) or vector(0)"
        }
      ]
    },
    {
      "title": "Deployments available",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 19,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.5
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(kube_deployment_status_replicas_available{namespace=~\"$namespace\"}) / clamp_min(sum(kube_deployment_spec_replicas{namespace=~\"$namespace\"}), 1)"
        }
      ]
    },
    {
      "title": "Apps",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 8
      }
    },
    {
      "title": "Site health by app",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 15,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "description": "Click an app to open its detail dashboard.",
      "targets": [
        {
          "refId": "READY",
          "instant": true,
          "format": "table",
          "expr": "sum by (namespace) (kube_pod_status_ready{namespace=~\"$namespace\", condition=\"true\"}) / count by (namespace) (kube_pod_info{namespace=~\"$namespace\"})"
        },
        {
          "refId": "PODS",
          "instant": true,
          "format": "table",
          "expr": "count by (namespace) (kube_pod_info{namespace=~\"$namespace\"})"
        },
        {
          "refId": "RESTARTS",
          "instant": true,
          "format": "table",
          "expr": "sum by (namespace) (increase(kube_pod_container_status_restarts_total{namespace=~\"$namespace\"}[1h]))"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "endpoint": true,
              "container": true,
              "pod": true,
              "uid": true
            },
            "renameByName": {
              "namespace": "App",
              "Value #READY": "Health",
              "Value #PODS": "Pods",
              "Value #RESTARTS": "Restarts (1h)"
            },
            "indexByName": {
              "namespace": 0,
              "Value #READY": 1,
              "Value #PODS": 2,
              "Value #RESTARTS": 3
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "App"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open ${__value.text} detail",
                    "url": "/d/homelab-app-detail/homelab-app-detail?var-namespace=${__value.text}&${__url_time_range}",
                    "targetBlank": true
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Health"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 0.5
                    },
                    {
                      "color": "green",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Restarts (1h)"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 1
                    },
                    {
                      "color": "red",
                      "value": 5
                    }
                  ]
                }
              }
            ]
          }
        ]
      }
    },
    {
      "title": "omp agents",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 24
      }
    },
    {
      "title": "omp pods (scale-to-zero - 'asleep' is normal)",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 16,
        "w": 24,
        "x": 0,
        "y": 25
      },
      "description": "Every omp Deployment (role pods, spawn slots, adapter, base). Wake one: kubectl -n omp scale deploy/<name> --replicas=1",
      "targets": [
        {
          "refId": "DESIRED",
          "instant": true,
          "format": "table",
          "expr": "sum by (deployment) (kube_deployment_spec_replicas{namespace=\"omp\"})"
        },
        {
          "refId": "AVAIL",
          "instant": true,
          "format": "table",
          "expr": "sum by (deployment) (kube_deployment_status_replicas_available{namespace=\"omp\"})"
        },
        {
          "refId": "STATE",
          "instant": true,
          "format": "table",
          "expr": "clamp_max(sum by (deployment) (kube_deployment_status_replicas_available{namespace=\"omp\"}), 1)"
        },
        {
          "refId": "RESTARTS",
          "instant": true,
          "format": "table",
          "expr": "sum by (deployment) (label_replace(increase(kube_pod_container_status_restarts_total{namespace=\"omp\"}[1h]), \"deployment\", \"$1\", \"pod\", \"(.+)-[a-z0-9]+-[a-z0-9]+\")) or (sum by (deployment) (kube_deployment_spec_replicas{namespace=\"omp\"}) * 0)"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "namespace": true,
              "container": true,
              "pod": true,
              "uid": true,
              "endpoint": true
            },
            "renameByName": {
              "deployment": "Pod",
              "Value #DESIRED": "Desired",
              "Value #AVAIL": "Available",
              "Value #STATE": "State",
              "Value #RESTARTS": "Restarts (1h)"
            },
            "indexByName": {
              "deployment": 0,
              "Value #STATE": 1,
              "Value #DESIRED": 2,
              "Value #AVAIL": 3,
              "Value #RESTARTS": 4
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Pod"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open omp detail (logs filtered to ${__value.text})",
                    "url": "/d/homelab-app-detail/homelab-app-detail?var-namespace=omp&var-search=${__value.text}&${__url_time_range}",
                    "targetBlank": true
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "State"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "asleep",
                        "color": "text"
                      },
                      "1": {
                        "text": "awake",
                        "color": "green"
                      }
                    }
                  }
                ]
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "transparent",
                      "value": null
                    },
                    {
                      "color": "green",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Available"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "steps": [
                    {
                      "color": "text",
                      "value": null
                    },
                    {
                      "color": "green",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Restarts (1h)"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 1
                    },
                    {
                      "color": "red",
                      "value": 5
                    }
                  ]
                }
              }
            ]
          }
        ]
      }
    }
  ],
  "schemaVersion": 39
}
