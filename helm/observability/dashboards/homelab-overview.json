{
  "annotations": {
    "list": []
  },
  "editable": true,
  "graphTooltip": 0,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "title": "Homelab Overview",
  "uid": "homelab-overview",
  "tags": [
    "homelab"
  ],
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "homelab"
      ],
      "title": "Homelab",
      "asDropdown": true,
      "keepTime": true,
      "icon": "apps"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "cluster_id",
        "label": "Cluster",
        "type": "custom",
        "query": "internal,sit,uat,production",
        "includeAll": true,
        "multi": false,
        "sort": 1,
        "current": {
          "text": "internal",
          "value": "internal"
        }
      },
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "mimir"
        },
        "query": "label_values(kube_pod_info{cluster_id=~\"$cluster_id\", namespace!~\"omp|sdlc|ansible|observability|kube-system|kube-node-lease|kube-public|cert-manager|local-path-storage|sit|uat|production\"}, namespace)",
        "includeAll": true,
        "multi": true,
        "refresh": 2,
        "sort": 1,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "title": "Cluster status",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "title": "Cluster live",
      "type": "stat",
      "description": "Seconds since this cluster last pushed metrics into Mimir. internal scrapes its own Prometheus directly; sit/uat/production remote-write in - if their k3d cluster is stopped, this goes stale/red.",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "mappings": [
            {
              "type": "range",
              "options": {
                "from": 180,
                "to": 1000000000,
                "result": { "text": "DOWN" }
              }
            }
          ],
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 60 },
              { "color": "red", "value": 180 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(time() - max by (cluster_id) (timestamp(kube_pod_info{cluster_id=~\"$cluster_id\"}))) or (label_replace(vector(1000000000), \"cluster_id\", \"$cluster_id\", \"\", \"\"))",
          "legendFormat": "{{cluster_id}}"
        }
      ]
    },
    {
      "title": "Health summary",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      }
    },
    {
      "title": "Pods ready",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 0,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(kube_pod_status_ready{namespace=~\"$namespace\", cluster_id=~\"$cluster_id\", condition=\"true\"})"
        }
      ]
    },
    {
      "title": "Pods not running",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 5,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(kube_pod_status_phase{namespace=~\"$namespace\", cluster_id=~\"$cluster_id\", phase!~\"Running|Succeeded\"}) or vector(0)"
        }
      ]
    },
    {
      "title": "Restarts (1h)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 10,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(kube_pod_container_status_restarts_total{namespace=~\"$namespace\", cluster_id=~\"$cluster_id\"}[1h])) or vector(0)"
        }
      ]
    },
    {
      "title": "Apps serving 5xx",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 15,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(sum by (service) (rate(traefik_service_requests_total{code=~\"5..\"}[5m])) > 0) or vector(0)"
        }
      ]
    },
    {
      "title": "Workloads available",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 19,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.5
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(kube_deployment_status_replicas_available{namespace=~\"$namespace\", cluster_id=~\"$cluster_id\"}) + sum(kube_statefulset_status_replicas_ready{namespace=~\"$namespace\", cluster_id=~\"$cluster_id\"})) / clamp_min(sum(kube_deployment_spec_replicas{namespace=~\"$namespace\", cluster_id=~\"$cluster_id\"}) + sum(kube_statefulset_replicas{namespace=~\"$namespace\", cluster_id=~\"$cluster_id\"}), 1)"
        }
      ]
    },
    {
      "title": "Apps",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 10
      }
    },
    {
      "title": "Site health by app",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 15,
        "w": 24,
        "x": 0,
        "y": 11
      },
      "description": "Click an app to open its detail dashboard.",
      "targets": [
        {
          "refId": "READY",
          "instant": true,
          "format": "table",
          "expr": "sum by (namespace, cluster_id) (kube_pod_status_ready{namespace=~\"$namespace\", cluster_id=~\"$cluster_id\", condition=\"true\"}) / count by (namespace, cluster_id) (kube_pod_info{namespace=~\"$namespace\", cluster_id=~\"$cluster_id\"})"
        },
        {
          "refId": "PODS",
          "instant": true,
          "format": "table",
          "expr": "count by (namespace, cluster_id) (kube_pod_info{namespace=~\"$namespace\", cluster_id=~\"$cluster_id\"})"
        },
        {
          "refId": "RESTARTS",
          "instant": true,
          "format": "table",
          "expr": "sum by (namespace, cluster_id) (increase(kube_pod_container_status_restarts_total{namespace=~\"$namespace\", cluster_id=~\"$cluster_id\"}[1h]))"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "endpoint": true,
              "container": true,
              "pod": true,
              "uid": true
            },
            "renameByName": {
              "namespace": "App",
              "cluster_id": "Cluster",
              "Value #READY": "Health",
              "Value #PODS": "Pods",
              "Value #RESTARTS": "Restarts (1h)"
            },
            "indexByName": {
              "namespace": 0,
              "cluster_id": 1,
              "Value #READY": 2,
              "Value #PODS": 3,
              "Value #RESTARTS": 4
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "App"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open ${__value.text} detail",
                    "url": "/d/homelab-app-detail/homelab-app-detail?var-namespace=${__value.text}&${__url_time_range}",
                    "targetBlank": true
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Health"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 0.5
                    },
                    {
                      "color": "green",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Restarts (1h)"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 1
                    },
                    {
                      "color": "red",
                      "value": 5
                    }
                  ]
                }
              }
            ]
          }
        ]
      }
    }
  ],
  "schemaVersion": 39
}
