k8s_yaml(blob('apiVersion: v1\nkind: Namespace\nmetadata:\n  name: opencode'))

docker_build('opencode-box:dev', '.', dockerfile='./Dockerfile')

k8s_yaml(helm(
  '.',
  name='opencode',
  namespace='opencode',
  # ponytail: Tilt always wants it running; the chart itself defaults to 0.
  set=['replicas=1'],
))

k8s_resource('opencode', port_forwards=['9110:4096'])
