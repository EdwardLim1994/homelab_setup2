# ponytail: local_resource cmd cwd is this Tiltfile's own directory, not repo root
local_resource(
  'nx-cloud-helm-deps',
  cmd='helm dependency update .',
  deps=['Chart.yaml'],
)

k8s_yaml(blob('apiVersion: v1\nkind: Namespace\nmetadata:\n  name: nx-cloud'))

# ponytail: read from `.env` (see .env.example), same TF_VAR_-prefixed
# names terraform uses. Falls back to dev-fixed values so `tilt up` works
# with zero setup.
nx_cloud_admin_password = os.getenv('TF_VAR_nx_cloud_admin_password', 'dev-nx-cloud-admin-password')
nx_cloud_mongo_password = os.getenv('TF_VAR_nx_cloud_mongo_password', 'dev-nx-cloud-mongo-password')
nx_cloud_valkey_password = os.getenv('TF_VAR_nx_cloud_valkey_password', 'dev-nx-cloud-valkey-password')
# ponytail: S3 creds reuse minio root creds in dev; prod should use a
# dedicated minio service account scoped to the nx-cloud bucket.
nx_cloud_s3_access_key = os.getenv('TF_VAR_minio_root_user', 'admin')
nx_cloud_s3_secret_key = os.getenv('TF_VAR_minio_root_password', 'dev-minio-root-password')
# ponytail: SAML_CERT is the Authentik IdP signing cert (PEM). Get it once after first boot:
#   kubectl exec -n authentik deploy/authentik-server -- ak shell < /dev/stdin <<'EOF'
#   from authentik.crypto.models import CertificateKeyPair
#   kp = CertificateKeyPair.objects.filter(name__icontains='authentik Self-signed').first()
#   print(kp.certificate_data)
#   EOF
# Then set TF_VAR_nx_cloud_saml_cert in .env (cert is stable across restarts).
# provision-app-providers.py also prints it between NX_CLOUD_SAML_CERT_START/END markers.
nx_cloud_saml_cert = os.getenv('TF_VAR_nx_cloud_saml_cert', '')
ts_host = os.getenv('TS_HOST', '')

# ponytail: connection string uses the bitnami mongodb service name
# (<release>-mongodb) with the nx-cloud db user created by the chart.
mongo_conn = 'mongodb://nx-cloud:' + nx_cloud_mongo_password + '@nx-cloud-mongodb-0.nx-cloud-mongodb-headless:27017/nx-cloud?replicaSet=rs0'

saml_entry_point = 'https://' + ts_host + ':8443/application/saml/nx-cloud/sso/binding/redirect/' if ts_host else ''
nx_cloud_app_url = 'https://' + ts_host + ':8454' if ts_host else 'https://nx-cloud.local'

# ponytail: S3 creds NOT in this Secret — passed as plain Deployment env via helm set below.
# Putting short values like 'admin' in k8s Secrets causes Tilt to redact that string
# everywhere in command output, breaking unrelated scripts (e.g. gitlab promote-admin.sh).
k8s_yaml(blob("""
apiVersion: v1
kind: Secret
metadata:
  name: nx-cloud-secrets
  namespace: nx-cloud
type: Opaque
stringData:
  NX_CLOUD_MONGO_SERVER_ENDPOINT: """ + mongo_conn + """
  VALKEY_PASSWORD: """ + nx_cloud_valkey_password + """
  ADMIN_PASSWORD: """ + nx_cloud_admin_password + """
  SAML_ENTRY_POINT: """ + saml_entry_point + """
  SAML_CERT: """ + nx_cloud_saml_cert + """
"""))

rendered = str(helm(
  '.',
  name='nx-cloud',
  namespace='nx-cloud',
  set=[
    'nx-cloud.global.nxCloudAppURL=' + nx_cloud_app_url,
    'mongodb.auth.rootPassword=' + nx_cloud_mongo_password,
    'mongodb.auth.passwords[0]=' + nx_cloud_mongo_password,
    'valkey.auth.password=' + nx_cloud_valkey_password,
    'nx-cloud.api.deployment.env.AWS_S3_ACCESS_KEY_ID=' + nx_cloud_s3_access_key,
    'nx-cloud.api.deployment.env.AWS_S3_SECRET_ACCESS_KEY=' + nx_cloud_s3_secret_key,
  ],
))
rendered = rendered.replace('__TS_HOST__', ts_host)
k8s_yaml(blob(rendered))

k8s_resource(
  'nx-cloud-frontend',
  port_forwards=['8086:4202'],
  resource_deps=['nx-cloud-helm-deps', 'authentik-app-providers'],
)

k8s_resource(
  'nx-cloud-nx-api',
  port_forwards=['4203:4203'],
  resource_deps=['nx-cloud-helm-deps'],
)
