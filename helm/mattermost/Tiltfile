mattermost_oidc_client_id     = os.getenv('TF_VAR_mattermost_oidc_client_id', 'dev-mattermost-oidc-client-id')
mattermost_oidc_client_secret = os.getenv('TF_VAR_mattermost_oidc_client_secret', 'dev-mattermost-oidc-client-secret-not-for-prod-use')
mattermost_db_password        = os.getenv('TF_VAR_mattermost_db_password', 'dev-mattermost-db-password')
tailnet_domain                = os.getenv('TF_VAR_tailnet_domain', '') or os.getenv('TS_HOST', '').split('.', 1)[-1]
app_url                       = 'https://mattermost.' + tailnet_domain if tailnet_domain else 'https://mattermost.local'
authentik_url                 = 'https://authentik.' + tailnet_domain if tailnet_domain else 'https://authentik.local'

# ponytail: extract CA cert (already base64-encoded in Secret data) and inject
# into mattermost namespace so Mattermost can trust homelab's self-signed TLS
# when making server-side OAuth calls to Authentik over Tailscale HTTPS.
ca_cert_b64 = str(local(
  'kubectl get secret homelab-ca-secret -n cert-manager -o jsonpath={.data.tls\\.crt} 2>nul || echo.',
  quiet=True,
)).strip()

k8s_yaml(blob('apiVersion: v1\nkind: Namespace\nmetadata:\n  name: mattermost'))

if ca_cert_b64 != '':
  k8s_yaml(blob("""apiVersion: v1
kind: Secret
metadata:
  name: homelab-ca
  namespace: mattermost
data:
  ca.crt: """ + ca_cert_b64 + """
"""))

rendered = str(helm('.', name='mattermost', namespace='mattermost'))
rendered = rendered.replace('__MATTERMOST_OIDC_CLIENT_ID__', mattermost_oidc_client_id)
rendered = rendered.replace('__MATTERMOST_OIDC_CLIENT_SECRET__', mattermost_oidc_client_secret)
rendered = rendered.replace('__MM_DB_PASSWORD__', mattermost_db_password)
rendered = rendered.replace('__AUTHENTIK_URL__', authentik_url)
rendered = rendered.replace('__APP_URL__', app_url)

k8s_yaml(blob(rendered))

k8s_resource(
  'mattermost',
  port_forwards=['8065:8065'],
  resource_deps=['authentik-app-providers'],
)
