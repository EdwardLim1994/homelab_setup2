# ponytail: mirrors helm/n8n/Tiltfile. The runner CronJob stays suspended;
# trigger playbooks with scripts/ansible-run.sh. Nothing here needs a
# port_forward or a readiness wait — there's no long-running service.

k8s_yaml(blob('apiVersion: v1\nkind: Namespace\nmetadata:\n  name: ansible'))

# Same TF_VAR_-prefixed names terraform uses; dev fallbacks so `tilt up` works
# with zero setup.
secret_keys = {
  'n8n_owner_email': os.getenv('TF_VAR_admin_email', 'admin@example.com'),
  'n8n_owner_password': os.getenv('TF_VAR_n8n_owner_password', 'Homelab-n8n-Dev-2026'),
  'grafana_mcp_token': os.getenv('TF_VAR_grafana_mcp_token', ''),
  'sonarqube_mcp_token': os.getenv('TF_VAR_sonarqube_mcp_token', ''),
  'gitlab_mcp_token': os.getenv('TF_VAR_gitlab_mcp_token', ''),
  'gitlab_mcp_auth_token': os.getenv('TF_VAR_gitlab_mcp_auth_token', ''),
  'omp_gitlab_token': os.getenv('TF_VAR_omp_gitlab_token', ''),
  'litellm_master_key': os.getenv('TF_VAR_litellm_master_key', 'sk-dev-litellm-master-key-not-for-prod-use'),
}
k8s_yaml(blob(
  'apiVersion: v1\nkind: Secret\nmetadata:\n  name: ansible-secrets\n  namespace: ansible\n'
  + 'stringData:\n'
  + '\n'.join(['  ' + k + ': "' + v + '"' for k, v in secret_keys.items()]) + '\n'
))

# n8n SDLC flows + seed.sh, mounted at /flows in the runner (see runner.yaml).
k8s_yaml(local(
  'kubectl create configmap ansible-n8n-flows -n ansible '
  + '--from-file ./flows --dry-run=client -o yaml',
  quiet=True,
))

k8s_yaml(helm('.', name='ansible', namespace='ansible'))

# CronJob is suspended — mark it so Tilt doesn't show it as "waiting".
k8s_resource('ansible-runner', objects=[
  'ansible-runner:serviceaccount',
  'ansible-runner:cronjob',
  'ansible-playbooks:configmap',
])
