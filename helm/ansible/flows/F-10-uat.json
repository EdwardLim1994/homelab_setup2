{
  "name": "F-10 /uat",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "mm-uat",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "slack-trigger",
      "name": "Mattermost: trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\"response_type\": \"ephemeral\", \"text\": \":hourglass_flowing_sand: Running `/uat`...\"}"
      },
      "id": "mm-ack-slack-trigger",
      "name": "Mattermost: ack command",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        480,
        200
      ]
    },
    {
      "parameters": {
        "channelId": "={{ $('Mattermost: trigger').item.json.body.channel_id }}",
        "message": "@{{ $('Mattermost: trigger').item.json.body.user_name }} :hourglass: *UAT started* for `{{ $json.text }}`\nRunning milestone safeguard...",
        "otherOptions": {}
      },
      "id": "ack-10",
      "name": "Mattermost: UAT started",
      "type": "n8n-nodes-base.mattermost",
      "typeVersion": 1,
      "position": [
        480,
        300
      ],
      "credentials": {
        "mattermostApi": {
          "id": "mm-creds",
          "name": "Mattermost SDLC Bot"
        }
      }
    },
    {
      "parameters": {
        "url": "={{ $env.GITLAB_URL }}/api/v4/projects/{{ $env.GITLAB_PROJECT_ID }}/issues?milestone={{ $('Slack: trigger').item.json.text }}&labels=type:user-story&per_page=100",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "PRIVATE-TOKEN",
              "value": "={{ $env.GITLAB_TOKEN }}"
            }
          ]
        }
      },
      "id": "query-stories",
      "name": "Query sprint milestone stories",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        720,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const stories=$json;\nconst unmerged=stories.filter(s=>!s.labels.includes('merged-to-release'));\nreturn [{json:{safe:unmerged.length===0,unmerged:unmerged.map(s=>({id:s.iid,title:s.title})),total:stories.length}}];"
      },
      "id": "safeguard",
      "name": "Check: all stories merged-to-release?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "leftValue": "={{ $json.safe }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ]
        }
      },
      "id": "safe-gate",
      "name": "Safeguard passed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1200,
        300
      ]
    },
    {
      "parameters": {
        "channelId": "={{ $('Mattermost: trigger').item.json.body.channel_id }}",
        "message": "@{{ $('Mattermost: trigger').item.json.body.user_name }} :x: *UAT blocked* — stories not yet merged to release. Check release branch.",
        "otherOptions": {}
      },
      "id": "slack-blocked",
      "name": "Mattermost: UAT blocked",
      "type": "n8n-nodes-base.mattermost",
      "typeVersion": 1,
      "position": [
        1440,
        440
      ],
      "credentials": {
        "mattermostApi": {
          "id": "mm-creds",
          "name": "Mattermost SDLC Bot"
        }
      }
    },
    {
      "parameters": {
        "url": "={{ $env.GITLAB_URL }}/api/v4/projects/{{ $env.GITLAB_PROJECT_ID }}/pipelines",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "ref",
              "value": "={{ 'release/' + $('Slack: trigger').item.json.text }}"
            },
            {
              "name": "variables[DEPLOY_ENV]",
              "value": "uat"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "PRIVATE-TOKEN",
              "value": "={{ $env.GITLAB_TOKEN }}"
            }
          ]
        }
      },
      "id": "trig-ci",
      "name": "Trigger manual CI on release branch",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        1440,
        200
      ]
    },
    {
      "parameters": {
        "url": "={{ $env.N8N_WEBHOOK_BASE }}/cluster-wake",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "cluster",
              "value": "uat"
            }
          ]
        }
      },
      "id": "wake-uat",
      "name": "Wake UAT cluster",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        1680,
        200
      ]
    },
    {
      "parameters": {
        "command": "=argocd app sync {{ $env.ARGOCD_PROJECT }}-uat --server $ARGOCD_URL"
      },
      "id": "argocd",
      "name": "ArgoCD sync: rc images to UAT",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        1920,
        200
      ]
    },
    {
      "parameters": {
        "url": "={{ $env.N8N_WEBHOOK_BASE }}/uat-qa-start",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "version",
              "value": "={{ $('Slack: trigger').item.json.text }}"
            },
            {
              "name": "release_ticket_id",
              "value": "={{ $env.RELEASE_TICKET_ID }}"
            }
          ]
        }
      },
      "id": "trig-f11",
      "name": "Trigger F-11: QA UAT stage 1",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        2160,
        200
      ]
    },
    {
      "parameters": {
        "channelId": "={{ $('Mattermost: trigger').item.json.body.channel_id }}",
        "message": "@{{ $('Mattermost: trigger').item.json.body.user_name }} :white_check_mark: Safeguard passed · UAT cluster deploying · QA stage 1 started.\n\nYou'll be notified when all 3 stages complete.",
        "otherOptions": {}
      },
      "id": "slack-uat-running",
      "name": "Mattermost: UAT underway",
      "type": "n8n-nodes-base.mattermost",
      "typeVersion": 1,
      "position": [
        2400,
        200
      ],
      "credentials": {
        "mattermostApi": {
          "id": "mm-creds",
          "name": "Mattermost SDLC Bot"
        }
      }
    }
  ],
  "connections": {
    "Mattermost: trigger": {
      "main": [
        [
          {
            "node": "Mattermost: UAT started",
            "type": "main",
            "index": 0
          },
          {
            "node": "Mattermost: ack command",
            "type": "main",
            "index": 0
          }
        ]
      ]
