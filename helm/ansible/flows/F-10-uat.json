    "Wake UAT cluster": {
      "main": [
        [
          {
            "node": "ArgoCD sync: rc images to UAT",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "ArgoCD sync: rc images to UAT": {
      "main": [
        [
          {
            "node": "Trigger F-11: QA UAT stage 1",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Trigger F-11: QA UAT stage 1": {
      "main": [
        [
          {
            "node": "Mattermost: UAT underway",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [
    {
      "name": "uat"
    },
    {
      "name": "phase-3"
    },
    {
      "name": "mattermost"
    }
  ]
}
