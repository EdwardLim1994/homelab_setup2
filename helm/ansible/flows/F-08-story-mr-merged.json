{
  "name": "F-08 Story MR Merged",
  "nodes": [
    {
      "id": "ee6c5ffd-4374-4ef1-90b0-4397637f65ad",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "parameters": {
        "path": "gitlab-story-mr-merged",
        "httpMethod": "POST",
        "responseMode": "onReceived",
        "responseData": "allEntries"
      },
      "webhookId": "e1932c5d-0bc4-42c3-8723-236fccec563a"
    },
    {
      "id": "f08000001-0000-0000-0000-000000000001",
      "name": "Extract Story IID",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        300
      ],
      "parameters": {
        "jsCode": "const branch = ($json.body?.object_attributes?.source_branch) || ($json.object_attributes?.source_branch) || '';\nconst m = branch.match(/^us\\/GL-(\\d+)$/);\nreturn [{ json: { ...$json, story_work_package_id: m ? m[1] : null, source_branch: branch } }];"
      }
    },
    {
      "id": "e9c0b402-3e0c-4df5-873f-2b9760d50ef2",
      "name": "Close Story Ticket",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        200
      ],
      "parameters": {
        "jsCode": "const auth = { Authorization: `Bearer ${$env.TAIGA_TOKEN}` };\nconst id = $node['Extract Story IID'].json.story_work_package_id;\nif (!id) return [{ json: $json }];\nconst us = await this.helpers.httpRequest({ method: 'GET', url: `${$env.TAIGA_URL}/api/v1/userstories/${id}`, headers: auth, json: true });\nconst statuses = await this.helpers.httpRequest({ method: 'GET', url: `${$env.TAIGA_URL}/api/v1/userstory-statuses?project=${$env.TAIGA_PROJECT_ID}`, headers: auth, json: true });\nconst statusId = statuses.find(s => s.name === 'Closed')?.id;\nawait this.helpers.httpRequest({ method: 'PATCH', url: `${$env.TAIGA_URL}/api/v1/userstories/${id}`, headers: { ...auth, 'Content-Type': 'application/json' }, body: { version: us.version, status: statusId }, json: true });\nreturn [{ json: $json }];"
      }
    },
    {
      "id": "ced58661-afae-44e6-a50f-a463c1ffd36d",
      "name": "All Stories Merged?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        300
      ],
      "parameters": {
        "jsCode": "const auth = { Authorization: `Bearer ${$env.TAIGA_TOKEN}` };\nconst res = await this.helpers.httpRequest({ method: 'GET', url: `${$env.TAIGA_URL}/api/v1/userstories?project=${$env.TAIGA_PROJECT_ID}&tags=${$env.RELEASE_VERSION}`, headers: auth, json: true });\nconst openStories = (res || []).filter(s => !s.is_closed);\nreturn [{ json: { ...$json, length: openStories.length } }];"
      }
    },
    {
      "id": "d6a68429-049f-41bd-ae3d-0e73d63f725f",
      "name": "All Done?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1120,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "leftValue": "={{ $json.length }}",
            "operation": "equals",
            "rightValue": "0"
          }
        }
      }
    },
    {
      "id": "9d8cfb43-de7c-4cb9-b093-1568ada2507b",
      "name": "Notify: All stories done",
