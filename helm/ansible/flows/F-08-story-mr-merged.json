{
  "name": "F-08 Story MR Merged",
  "nodes": [
    {
      "id": "ee6c5ffd-4374-4ef1-90b0-4397637f65ad",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "parameters": {
        "path": "gitlab-story-mr-merged",
        "httpMethod": "POST",
        "responseMode": "onReceived",
        "responseData": "allEntries"
      },
      "webhookId": "e1932c5d-0bc4-42c3-8723-236fccec563a"
    },
    {
      "id": "e9c0b402-3e0c-4df5-873f-2b9760d50ef2",
      "name": "Close Story Tickets",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
        200
      ],
      "parameters": {
        "method": "PUT",
        "url": "={{ $env.GITLAB_URL }}/api/v4/projects/{{ $env.GITLAB_PROJECT_ID }}/issues?labels=type:task,us={{ $json.object_attributes.source_branch }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "PRIVATE-TOKEN",
              "value": "={{ $env.GITLAB_TOKEN }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "__json",
              "value": "{\"state_event\":\"close\"}"
            }
          ]
        }
      }
    },
    {
      "id": "e4d9cac1-ca92-4e65-9c41-011e42d5ea7a",
      "name": "Sleep QA Cluster",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
        400
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.N8N_WEBHOOK_BASE }}/cluster-lifecycle",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "action",
              "value": "sleep"
            },
            {
              "name": "cluster",
              "value": "qa"
            }
          ]
        }
      }
    },
    {
      "id": "ced58661-afae-44e6-a50f-a463c1ffd36d",
      "name": "All Stories Merged?",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        900,
        300
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $env.GITLAB_URL }}/api/v4/projects/{{ $env.GITLAB_PROJECT_ID }}/issues?labels=type:user-story,milestone={{ $env.RELEASE_VERSION }}&state=opened",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "PRIVATE-TOKEN",
              "value": "={{ $env.GITLAB_TOKEN }}"
            }
          ]
        }
      }
    },
    {
      "id": "d6a68429-049f-41bd-ae3d-0e73d63f725f",
      "name": "All Done?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1120,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "leftValue": "={{ $json.length }}",
            "operation": "equals",
            "rightValue": "0"
          }
        }
      }
    },
    {
      "id": "9d8cfb43-de7c-4cb9-b093-1568ada2507b",
      "name": "Notify: All stories done",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1340,
        200
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.OPENWEBUI_CALLBACK_URL }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "flow_id",
              "value": "={{ $json.flow_id ?? '' }}"
            },
            {
              "name": "message",
              "value": "🎉 All stories merged — release ready for /uat"
            },
            {
              "name": "notes",
              "value": ""
            }
          ]
        }
      }
    },
    {
      "id": "238b6c61-6e62-49b6-ae85-8bd3283a024a",
      "name": "Notify: More stories pending",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1340,
        400
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.OPENWEBUI_CALLBACK_URL }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "flow_id",
              "value": "={{ $json.flow_id ?? '' }}"
            },
            {
              "name": "message",
              "value": "=✅ Story merged — {{ $json.length }} stories still open"
            },
            {
              "name": "notes",
              "value": ""
            }
          ]
        }
      }
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [
          {
            "node": "Close Story Tickets",
            "type": "main",
            "index": 0
          },
          {
            "node": "Sleep QA Cluster",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Close Story Tickets": {
      "main": [
        [
          {
            "node": "All Stories Merged?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Sleep QA Cluster": {
      "main": [
        [
          {
            "node": "All Stories Merged?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "All Stories Merged?": {
      "main": [
        [
          {
            "node": "All Done?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "All Done?": {
