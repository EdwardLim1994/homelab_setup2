      "parameters": {
        "jsCode": "const taigaAuth = { Authorization: `Bearer ${$env.TAIGA_TOKEN}` };\n// branch is 'us/GL-{story id}' — GL- is branch-naming vocabulary only, {N} is the Taiga userstory id\nconst storyId = $json.object_attributes.source_branch.split('/')[1].split('-')[1];\nconst story = await this.helpers.httpRequest({ method: 'GET', url: `${$env.TAIGA_URL}/api/v1/userstories/${storyId}`, headers: taigaAuth, json: true });\nconst statusesRes = await this.helpers.httpRequest({ method: 'GET', url: `${$env.TAIGA_URL}/api/v1/userstory-statuses`, qs: { project: $env.TAIGA_PROJECT_ID }, headers: taigaAuth, json: true });\nconst deferredStatusId = statusesRes.find(s => s.name === 'Deferred').id;\nawait this.helpers.httpRequest({\n  method: 'PATCH',\n  url: `${$env.TAIGA_URL}/api/v1/userstories/${storyId}`,\n  headers: { ...taigaAuth, 'Content-Type': 'application/json' },\n  body: { version: story.version, status: deferredStatusId },\n  json: true,\n});\nreturn [{ json: { ...$json, story_id: storyId } }];"
      }
    },
