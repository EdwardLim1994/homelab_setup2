            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Spawn DevOps Pod: infra+webhook+CI vars": {
      "main": [
        [
          {
            "node": "All 3 tracks complete?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "All 3 tracks complete?": {
      "main": [
        [
          {
            "node": "Mattermost: kickoff complete",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
