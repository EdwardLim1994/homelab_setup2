{
  "name": "F-02 /kickoff",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "mm-kickoff",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "slack-trigger",
      "name": "Mattermost: trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\"response_type\": \"ephemeral\", \"text\": \":hourglass_flowing_sand: Running `/kickoff`...\"}"
      },
      "id": "mm-ack-slack-trigger",
      "name": "Mattermost: ack command",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        480,
        200
      ]
    },
    {
      "parameters": {
        "channelId": "={{ $('Mattermost: trigger').item.json.body.channel_id }}",
        "message": "@{{ $('Mattermost: trigger').item.json.body.user_name }} :rocket: *Kickoff started* for `{{ $json.text }}`\nSpawning 3 parallel tracks: TL branches · PM GitLab artifacts · DevOps infra + webhook...",
        "otherOptions": {}
      },
      "id": "ack-02",
      "name": "Mattermost: kickoff started",
      "type": "n8n-nodes-base.mattermost",
      "typeVersion": 1,
      "position": [
        480,
        300
      ],
      "credentials": {
        "mattermostApi": {
          "id": "mm-creds",
          "name": "Mattermost SDLC Bot"
        }
      }
    },
    {
      "parameters": {
        "command": "=echo '{\"role\":\"tech-lead\",\"task\":\"kickoff-branches\",\"version\":\"{{ $('Slack: trigger').item.json.text }}\"}' > /tmp/tl.json && omp run --mode json --role slow @/tmp/tl.json"
      },
      "id": "spawn-tl",
      "name": "Spawn TL Pod: branches+openspec+pseudocode",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        720,
        160
      ]
    },
    {
      "parameters": {
        "command": "=echo '{\"role\":\"pm\",\"task\":\"kickoff-gitlab-artifacts\",\"version\":\"{{ $('Slack: trigger').item.json.text }}\"}' > /tmp/pm.json && opencode run --print \"$(cat /tmp/pm.json)\""
      },
      "id": "spawn-pm",
      "name": "Spawn PM Pod: GitLab artifacts (opencode)",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        720,
        300
      ]
    },
    {
      "parameters": {
        "command": "=echo '{\"role\":\"devops\",\"task\":\"kickoff-infra-webhook\",\"version\":\"{{ $('Slack: trigger').item.json.text }}\"}' > /tmp/do.json && omp run --mode json --role default @/tmp/do.json"
      },
      "id": "spawn-do",
      "name": "Spawn DevOps Pod: infra+webhook+CI vars",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        720,
        440
      ]
    },
    {
      "parameters": {
        "jsCode": "const tl=$node['Spawn TL Pod: branches+openspec+pseudocode'].json.exitCode;\nconst pm=$node['Spawn PM Pod: GitLab artifacts (opencode)'].json.exitCode;\nconst dv=$node['Spawn DevOps Pod: infra+webhook+CI vars'].json.exitCode;\nreturn [{json:{ok:tl===0&&pm===0&&dv===0,tl,pm,dv}}];"
      },
      "id": "all-done-02",
      "name": "All 3 tracks complete?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        300
      ]
    },
    {
      "parameters": {
        "channelId": "={{ $('Mattermost: trigger').item.json.body.channel_id }}",
        "message": "@{{ $('Mattermost: trigger').item.json.body.user_name }} :white_check_mark: *Kickoff complete* for `{{ $('Slack: trigger').item.json.text }}`\n• Branches created + openspec + pseudocode committed\n• GitLab milestone, stories, tasks, release ticket created\n• Infra provisioned · GitLab group webhook registered\n\nReview branches and openspec, then run `/develop` to start.",
        "otherOptions": {}
      },
      "id": "notify-02",
      "name": "Mattermost: kickoff complete",
      "type": "n8n-nodes-base.mattermost",
      "typeVersion": 1,
      "position": [
        1200,
        300
      ],
      "credentials": {
        "mattermostApi": {
          "id": "mm-creds",
          "name": "Mattermost SDLC Bot"
        }
      }
    }
  ],
  "connections": {
    "Mattermost: trigger": {
      "main": [
        [
          {
            "node": "Mattermost: kickoff started",
            "type": "main",
            "index": 0
