            "type": "main",
            "index": 0
          },
          {
            "node": "Spawn DevOps Pod: infra+webhook+CI vars",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Spawn TL Pod: branches+openspec+pseudocode": {
      "main": [
