{
  "name": "F-02 /kickoff",
  "nodes": [
    {
      "id": "516ef61b-d041-49ae-824a-d528608d6980",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "parameters": {
        "path": "kickoff",
        "httpMethod": "POST",
        "responseMode": "onReceived",
        "responseData": "allEntries"
      },
      "webhookId": "61ec943e-86b1-4118-b28b-fda8049c924d"
    },
    {
      "id": "d277cfaa-f9ce-4419-852c-ad0eea13f7ca",
      "name": "Respond OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        460,
        300
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\"status\":\"accepted\"}"
      }
    },
    {
      "id": "90948b75-fde9-49d4-8339-dbf4dd3edd4a",
      "name": "Notify: Kickoff started",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.OPENWEBUI_CALLBACK_URL }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "flow_id",
              "value": "={{ $json.flow_id ?? '' }}"
            },
            {
              "name": "message",
              "value": "\ud83d\ude80 kickoff started \u2014 3 parallel tracks"
            },
            {
              "name": "notes",
              "value": ""
            }
          ]
        }
      }
    },
    {
      "id": "b02da329-9a7e-45ca-a098-30860e5e762d",
      "name": "TL: Branches + Pseudocode",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        900,
        160
      ],
      "parameters": {
        "command": "omp --role tech-lead --model slow --project {{ $env.REPO_DIR }} --prompt 'Kickoff for {{ $json.body.version }}. Create story branches from release/{{ $json.body.version }}, write openspec pseudocode per task, label openspec:ready.' --non-interactive"
      }
    },
    {
      "id": "e1dc6899-3754-4706-ade7-ae3a5bc076ac",
      "name": "PM: GitLab Artifacts",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        900,
        320
      ],
      "parameters": {
        "command": "opencode --role pm --model haiku --prompt 'Create GitLab user-story issues and task issues for {{ $json.body.version }} milestone.' --non-interactive"
      }
    },
    {
      "id": "e80b2745-2d8d-4624-b99d-17eba1e6cddd",
      "name": "DevOps: Infra + Webhook",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        900,
        480
      ],
      "parameters": {
        "command": "omp --role devops-engineer --model default --project {{ $env.REPO_DIR }} --prompt 'Register GitLab group webhook (idempotent), set CI env vars, verify SIT cluster healthy for {{ $json.body.version }}.' --non-interactive"
      }
    },
    {
      "id": "190355fa-88b0-41e7-ba40-da302eecf355",
      "name": "Merge 3 Tracks",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [
        1120,
        320
      ],
      "parameters": {
        "mode": "waitForAll"
      }
    },
    {
      "id": "c6510faf-ce27-45a1-a886-63f8d1e8e394",
      "name": "Notify: Kickoff complete",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1340,
        320
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.OPENWEBUI_CALLBACK_URL }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "flow_id",
              "value": "={{ $json.flow_id ?? '' }}"
            },
            {
              "name": "message",
              "value": "\u2705 kickoff complete \u2014 branches created, tickets open, infra ready"
            },
            {
              "name": "notes",
              "value": ""
            }
          ]
        }
      }
    }
  ],
