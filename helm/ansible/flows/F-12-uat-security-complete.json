{
  "name": "F-12-uat-security-complete",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "security-scan-start",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "wh-F-12-uat-security-complete",
      "name": "Webhook: security-scan-start",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "command": "echo '{\"role\":\"security-engineer\",\"task\":\"uat-stage-2\"}' > /tmp/F-12-uat-security-complete.json && omp run --mode json --role smol @/tmp/F-12-uat-security-complete.json"
      },
      "id": "spawn-F-12-uat-security-complete",
      "name": "Spawn security-engineer: uat-stage-2",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        480,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "leftValue": "={{ $json.exitCode }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "equals"
              }
            }
          ]
        }
      },
      "id": "pass-F-12-uat-security-complete",
      "name": "Passed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        720,
        300
      ]
    },
    {
      "parameters": {
        "command": "glab issue update {{ $json.body.release_ticket_id }} --label-add 'security:cleared'"
      },
      "id": "label-F-12-uat-security-complete",
      "name": "Apply security:cleared on release ticket",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        960,
        200
      ]
    },
    {
      "parameters": {
        "url": "={{ $env.N8N_WEBHOOK_BASE }}/po-validation-start",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "version",
              "value": "={{ $json.body.version }}"
            },
            {
              "name": "release_ticket_id",
              "value": "={{ $json.body.release_ticket_id }}"
            }
          ]
        }
      },
      "id": "next-F-12-uat-security-complete",
      "name": "Trigger next stage",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        1200,
        200
      ]
    },
    {
      "parameters": {
        "channelId": "={{ $env.MM_SDLC_CHANNEL }}",
        "message": ":shield: *UAT Security* sign-off. Moving to next stage.",
        "otherOptions": {}
      },
      "id": "slack-pass2-F-12-uat-security-complete",
      "name": "Mattermost: UAT Security sign-off",
      "type": "n8n-nodes-base.mattermost",
      "typeVersion": 1,
      "position": [
        1440,
        200
      ],
      "credentials": {
        "mattermostApi": {
          "id": "mm-creds",
          "name": "Mattermost SDLC Bot"
        }
      }
    },
    {
      "parameters": {
        "command": "glab issue create --title '[bugfix] security-engineer finding in uat-stage-2' --label 'type:bugfix,role:security-engineer' --milestone '{{ $json.body.version }}' --description 'Found during UAT.'"
      },
      "id": "bug-F-12-uat-security-complete",
      "name": "Create bug ticket",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        960,
        440
      ]
    },
    {
      "parameters": {
        "channelId": "={{ $env.MM_SDLC_CHANNEL }}",
        "message": ":warning: *UAT Security finding* — bug ticket created. Fix and re-run UAT.",
        "otherOptions": {}
      },
      "id": "slack-bug-F-12-uat-security-complete",
      "name": "Mattermost: UAT Security bug",
      "type": "n8n-nodes-base.mattermost",
      "typeVersion": 1,
      "position": [
        1200,
        440
      ],
      "credentials": {
        "mattermostApi": {
          "id": "mm-creds",
          "name": "Mattermost SDLC Bot"
        }
      }
    }
  ],
  "connections": {
    "Webhook: security-scan-start": {
      "main": [
        [
          {
            "node": "Spawn security-engineer: uat-stage-2",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Spawn security-engineer: uat-stage-2": {
      "main": [
        [
          {
            "node": "Passed?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Passed?": {
      "main": [
        [
          {
            "node": "Apply security:cleared on release ticket",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Create bug ticket",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Apply security:cleared on release ticket": {
      "main": [
        [
          {
            "node": "Trigger next stage",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Create bug ticket": {
      "main": [
        [
          {
            "node": "Mattermost: UAT Security bug",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Trigger next stage": {
      "main": [
        [
          {
            "node": "Mattermost: UAT Security sign-off",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [
    {
      "name": "uat"
    },
    {
      "name": "phase-3"
