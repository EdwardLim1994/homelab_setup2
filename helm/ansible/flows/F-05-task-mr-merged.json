{
  "name": "F-05 Task MR Merged",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "gitlab-mr-merged",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "wh-05",
      "name": "Webhook: gitlab-mr-merged",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const dag=$workflow.staticData.dagState||{};\nconst mrId=$json.body.mr_id||$json.body.object_attributes?.iid;\nif(dag.openMRs&&dag.openMRs[mrId])dag.openMRs[mrId].status='merged';\nconst storyId=$json.body.story_id;\nconst all=Object.values(dag.openMRs||{}).filter(m=>m.storyId===storyId).every(m=>m.status==='merged');\n$workflow.staticData.dagState=dag;\nreturn [{json:{mrId,storyId,allTasksMerged:all}}];"
      },
      "id": "upd-dag",
      "name": "Update DAG: task merged",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "leftValue": "={{ $json.allTasksMerged }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ]
        }
      },
      "id": "all-merged",
      "name": "All story tasks merged?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        720,
        300
      ]
    },
    {
      "parameters": {
        "url": "={{ $env.N8N_WEBHOOK_BASE }}/dod-check",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "story_id",
              "value": "={{ $json.storyId }}"
            }
          ]
        }
      },
      "id": "trig-f06",
      "name": "Trigger F-06: DoD check",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        960,
        200
      ]
    },
    {
      "parameters": {
        "channelId": "={{ $env.MM_SDLC_CHANNEL }}",
        "message": ":white_check_mark: All tasks merged for story `{{ $json.storyId }}`. Running DoD check...",
        "otherOptions": {}
      },
      "id": "slack-05",
      "name": "Mattermost: all tasks merged",
      "type": "n8n-nodes-base.mattermost",
      "typeVersion": 1,
      "position": [
        960,
        200
      ],
      "credentials": {
        "mattermostApi": {
          "id": "mm-creds",
          "name": "Mattermost SDLC Bot"
        }
      }
    }
  ],
  "connections": {
    "Webhook: gitlab-mr-merged": {
      "main": [
        [
          {
            "node": "Update DAG: task merged",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Update DAG: task merged": {
      "main": [
        [
          {
            "node": "All story tasks merged?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "All story tasks merged?": {
      "main": [
        [
          {
            "node": "Mattermost: all tasks merged",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Mattermost: all tasks merged": {
      "main": [
        [
          {
            "node": "Trigger F-06: DoD check",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [
    {
      "name": "development"
    },
    {
      "name": "phase-2"
    },
    {
      "name": "mattermost"
    }
  ]
}
