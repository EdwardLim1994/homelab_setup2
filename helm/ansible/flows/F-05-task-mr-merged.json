      "position": [
        900,
        300
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $env.GITLAB_URL }}/api/v4/projects/{{ $env.GITLAB_PROJECT_ID }}/issues?labels=type:task,status:open&milestone={{ $env.RELEASE_VERSION }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "PRIVATE-TOKEN",
              "value": "={{ $env.GITLAB_TOKEN }}"
            }
          ]
        }
      }
    },
    {
      "id": "9b62d1f1-9a5a-40ee-b9a0-859966ac85e5",
