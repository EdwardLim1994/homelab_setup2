      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1120,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "leftValue": "={{ $json.length }}",
            "operation": "equals",
            "rightValue": "0"
          }
        }
      }
    },
    {
      "id": "c16a2450-10cf-4cfa-8ff6-b0f3e72d09a9",
