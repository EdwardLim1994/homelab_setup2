{
  "name": "F-05 Task MR Merged",
  "nodes": [
    {
      "id": "f6d90ca8-33d9-4d9d-9dc9-85e3accbf919",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "parameters": {
        "path": "gitlab-task-mr-merged",
        "httpMethod": "POST",
        "responseMode": "onReceived",
        "responseData": "allEntries"
      },
      "webhookId": "be0ec9eb-7225-4d1e-a824-eff2f4c1e226"
    },
    {
      "id": "b453a6f3-c578-401c-a8cd-4bc72e4dc3c1",
      "name": "Update DAG State",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        680,
        300
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "f040fb47-aec2-4173-8509-e24468e0a34d",
              "name": "event",
              "value": "task_merged",
              "type": "string"
            },
            {
              "id": "1a559a8c-2f91-4920-bb69-64a9162496e2",
              "name": "mr_iid",
              "value": "={{ $json.body.object_attributes.iid }}",
              "type": "string"
            },
            {
              "id": "d2ea9e0d-c2de-4d30-a817-9b25facee345",
              "name": "branch",
              "value": "={{ $json.body.object_attributes.source_branch }}",
              "type": "string"
            },
            {
              "id": "e3f5a6b7-1234-4abc-9def-0123456789ab",
              "name": "story_branch",
              "value": "={{ $json.body.object_attributes.target_branch }}",
              "type": "string"
            },
            {
              "id": "f4a6b7c8-2345-4bcd-8ef0-123456789abc",
              "name": "story_id",
              "value": "={{ $json.body.object_attributes.target_branch.replace('story/', '') }}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "id": "2ba76ce2-cdb6-4d7b-92ba-a9a2b10d3726",
      "name": "All Story Tasks Done?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        300
      ],
      "parameters": {
        "jsCode": "const storyBranch = $json.story_branch;\nconst url = `${$env.GITLAB_URL}/api/v4/projects/${$json.body.project?.id ?? $env.GITLAB_PROJECT_PATH}/merge_requests?target_branch=${encodeURIComponent(storyBranch)}&state=opened`;\nconst res = await this.helpers.httpRequest({\n  method: 'GET',\n  url,\n  headers: { 'PRIVATE-TOKEN': $env.GITLAB_TOKEN },\n  json: true,\n});\nreturn [{ json: { ...$json, remaining: Array.isArray(res) ? res.length : 0 } }];"
      }
    },
    {
      "id": "9b62d1f1-9a5a-40ee-b9a0-859966ac85e5",
      "name": "Tasks Remaining?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1120,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "leftValue": "={{ $json.remaining }}",
            "operation": "equals",
            "rightValue": "0"
          }
        }
      }
    },
    {
      "id": "c16a2450-10cf-4cfa-8ff6-b0f3e72d09a9",
      "name": "→ F-06 DoD Check",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1340,
        200
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.N8N_WEBHOOK_BASE }}/dod-check",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "story_id",
              "value": "={{ $json.story_id }}"
            },
            {
              "name": "story_branch",
              "value": "={{ $json.story_branch }}"
            },
            {
              "name": "gitlab_project_path",
              "value": "={{ $node['Webhook Trigger'].json.body.project?.path_with_namespace ?? $env.GITLAB_PROJECT_PATH.replace('%2F', '/') }}"
            }
          ]
        }
      }
    },
    {
      "id": "8894680b-c5a1-4500-ad0c-85ae9b1ed167",
      "name": "Notify: Task merged",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1340,
        400
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.OPENWEBUI_CALLBACK_URL }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "flow_id",
              "value": "={{ $json.body?.flow_id ?? $json.flow_id ?? '' }}"
            },
            {
              "name": "message",
              "value": "✅ Task MR merged — more tasks pending"
            },
            {
              "name": "notes",
              "value": ""
            }
          ]
        }
      }
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [
          {
