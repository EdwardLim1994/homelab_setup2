{
  "name": "F-08 Story MR Merged",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "story-mr-merged",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "wh-08",
      "name": "Webhook: story-mr-merged",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "command": "=glab issue update {{ $json.body.story_id }} --label-add 'merged-to-release' && glab issue close {{ $json.body.story_id }}"
      },
      "id": "close-story",
      "name": "Close story ticket + label merged-to-release",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        480,
        200
      ]
    },
    {
      "parameters": {
        "command": "=echo 'Closing child tasks for {{ $json.body.story_id }}'"
      },
      "id": "close-tasks",
      "name": "Close all child task tickets",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        480,
        320
      ]
    },
    {
      "parameters": {
        "command": "=glab issue comment {{ $json.body.release_ticket_id }} --message 'Story GL-{{ $json.body.story_id }} merged to release. Time: {{ new Date().toISOString() }}'"
      },
      "id": "update-rel",
      "name": "Update release ticket: deployment log",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        480,
        440
      ]
    },
    {
      "parameters": {
        "url": "={{ $env.N8N_WEBHOOK_BASE }}/cluster-sleep",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "cluster",
              "value": "qa"
            }
          ]
        }
      },
      "id": "sleep-qa",
      "name": "Sleep QA cluster (F-27)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        480,
        560
      ]
    },
    {
      "parameters": {
        "jsCode": "const dag=$workflow.staticData.dagState||{};\ndag.mergedStories=dag.mergedStories||[];\ndag.mergedStories.push($json.body.story_id);\n$workflow.staticData.dagState=dag;\nconst all=(dag.mergedStories.length>=(dag.totalStories||999));\nreturn [{json:{allMerged:all,merged:dag.mergedStories.length,total:dag.totalStories||'?',version:dag.version}}];"
      },
      "id": "check-all-stories",
      "name": "All stories merged?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        380
      ]
    },
    {
      "parameters": {
        "channelId": "={{ $env.MM_SDLC_CHANNEL }}",
        "message": ":tada: *All stories merged* to `release/{{ $json.version }}`!\n\nRun `/uat {{ $json.version }}` when ready to start UAT.",
        "otherOptions": {}
      },
      "id": "slack-all-done",
      "name": "Mattermost: all stories merged — ready for UAT",
      "type": "n8n-nodes-base.mattermost",
      "typeVersion": 1,
      "position": [
        1200,
        260
      ],
      "credentials": {
        "mattermostApi": {
          "id": "mm-creds",
          "name": "Mattermost SDLC Bot"
        }
      }
    },
    {
      "parameters": {
        "channelId": "={{ $env.MM_SDLC_CHANNEL }}",
        "message": "✅ Story `{{ $json.body.story_id }}` merged to release branch. Remaining: {{ (($json.total||0)-($json.merged||0)) }} stories.",
        "otherOptions": {}
      },
      "id": "slack-one-merged",
      "name": "Mattermost: story merged",
      "type": "n8n-nodes-base.mattermost",
      "typeVersion": 1,
      "position": [
        1200,
        500
      ],
      "credentials": {
        "mattermostApi": {
          "id": "mm-creds",
          "name": "Mattermost SDLC Bot"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "leftValue": "={{ $json.allMerged }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ]
        }
      },
      "id": "all-merged-f08",
      "name": "All stories merged? [if check]",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1200,
        380
      ]
    }
  ],
  "connections": {
