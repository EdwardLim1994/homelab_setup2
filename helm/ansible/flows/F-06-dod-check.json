{
  "name": "F-06 DoD Check",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "dod-check",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "wh-06",
      "name": "Webhook: dod-check",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "command": "=echo '{\"role\":\"tech-lead\",\"task\":\"dod-check\",\"story_id\":\"{{ $json.body.story_id }}\"}' > /tmp/dod.json && omp run --mode json --role slow @/tmp/dod.json"
      },
      "id": "spawn-tl-dod",
      "name": "Spawn TL Pod: DoD check",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        480,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "leftValue": "={{ $json.exitCode }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "equals"
              }
            }
          ]
        }
      },
      "id": "dod-pass",
      "name": "DoD satisfied?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        720,
        300
      ]
    },
    {
      "parameters": {
        "url": "={{ $env.N8N_WEBHOOK_BASE }}/story-mr-open",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "story_id",
              "value": "={{ $json.body.story_id }}"
            }
          ]
        }
      },
      "id": "trig-f07",
      "name": "Trigger F-07: open story MR",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        960,
        200
      ]
    },
    {
      "parameters": {
        "channelId": "={{ $env.MM_SDLC_CHANNEL }}",
        "message": ":white_check_mark: DoD passed for `{{ $json.body.story_id }}`. Opening story MR...",
        "otherOptions": {}
      },
      "id": "slack-dod-pass",
      "name": "Mattermost: DoD passed",
      "type": "n8n-nodes-base.mattermost",
      "typeVersion": 1,
      "position": [
        960,
        200
      ],
      "credentials": {
        "mattermostApi": {
          "id": "mm-creds",
          "name": "Mattermost SDLC Bot"
        }
      }
    },
    {
      "parameters": {
        "channelId": "={{ $env.MM_SDLC_CHANNEL }}",
        "message": ":x: DoD *failed* for `{{ $json.body.story_id }}`. Feedback sent to developer. Fix cycle restarting...",
        "otherOptions": {}
      },
      "id": "slack-dod-fail",
      "name": "Mattermost: DoD failed",
      "type": "n8n-nodes-base.mattermost",
      "typeVersion": 1,
      "position": [
        960,
        440
      ],
      "credentials": {
        "mattermostApi": {
          "id": "mm-creds",
          "name": "Mattermost SDLC Bot"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const dag=$workflow.staticData.dagState||{};\nconst sid=$json.body.story_id;\ndag.dodRetries=dag.dodRetries||{};\ndag.dodRetries[sid]=(dag.dodRetries[sid]||0)+1;\n$workflow.staticData.dagState=dag;\nreturn [{json:{retries:dag.dodRetries[sid],storyId:sid}}];"
      },
      "id": "dod-retry",
      "name": "DoD fail: feedback + re-trigger F-04",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        440
      ]
    }
  ],
  "connections": {
    "Webhook: dod-check": {
      "main": [
        [
          {
            "node": "Spawn TL Pod: DoD check",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Spawn TL Pod: DoD check": {
      "main": [
        [
          {
            "node": "DoD satisfied?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "DoD satisfied?": {
      "main": [
        [
          {
            "node": "Mattermost: DoD passed",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Mattermost: DoD failed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Mattermost: DoD passed": {
      "main": [
        [
          {
            "node": "Trigger F-07: open story MR",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Mattermost: DoD failed": {
      "main": [
        [
          {
            "node": "DoD fail: feedback + re-trigger F-04",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [
    {
      "name": "development"
    },
    {
      "name": "phase-2"
    },
    {
      "name": "mattermost"
    }
  ]
}
