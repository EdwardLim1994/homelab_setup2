{
  "name": "F-06 DoD Check",
  "nodes": [
    {
      "id": "eda43cdc-9e98-484e-83dd-ff7fc3d2f7ef",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "parameters": {
        "path": "dod-check",
        "httpMethod": "POST",
        "responseMode": "onReceived",
        "responseData": "allEntries"
      },
      "webhookId": "89d8e361-ddcc-4216-b410-f969b0827ce2"
    },
    {
      "id": "fcd2cdf3-42fa-43fc-98aa-089bc5a012b8",
      "name": "Respond OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        460,
        300
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\"status\":\"accepted\"}"
      }
    },
    {
      "id": "a590f7ba-c7e8-4d7e-b928-2e53ed38c051",
      "name": "Notify: DoD check",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.OPENWEBUI_CALLBACK_URL }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "flow_id",
              "value": "={{ $json.flow_id ?? '' }}"
            },
            {
              "name": "message",
              "value": "\ud83d\udd2c DoD check running for story"
            },
            {
              "name": "notes",
              "value": ""
            }
          ]
        }
      }
    },
    {
      "id": "1c5e32cb-eeda-4422-bd5b-80546a7143a3",
      "name": "TL: DoD Evaluation",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        900,
        300
      ],
      "parameters": {
        "command": "omp --role tech-lead --model slow --project {{ $env.REPO_DIR }} --prompt 'Evaluate Definition of Done for story tasks in {{ $json.body.version }}. Check: all tests pass, coverage \u226580%, no critical lint, pseudocode implemented fully. Output JSON: {pass: bool, notes: string}' --non-interactive"
      }
    },
    {
      "id": "ac914dd1-65f2-4505-ba31-0f16a13feca7",
      "name": "DoD Pass?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1120,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "leftValue": "={{ JSON.parse($json.stdout).pass }}",
            "operation": "equals",
            "rightValue": "true"
          }
        }
      }
    },
    {
      "id": "14598c3c-4bcb-42da-a706-88e04456e5f3",
      "name": "\u2192 F-07 Story MR",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1340,
        200
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.N8N_WEBHOOK_BASE }}/webhook/story-mr-open",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "version",
              "value": "={{ $json.body.version }}"
            }
          ]
        }
      }
    },
    {
      "id": "73274a11-99a5-4946-8a9b-fcf129e509e4",
      "name": "Notify: DoD fail feedback",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1340,
        400
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.OPENWEBUI_CALLBACK_URL }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "flow_id",
              "value": "={{ $json.flow_id ?? '' }}"
            },
            {
              "name": "message",
              "value": "\u274c DoD failed \u2014 feedback posted to task branches, re-triggering F-04"
            },
            {
              "name": "notes",
              "value": ""
            }
          ]
        }
      }
    },
    {
      "id": "bb1a533a-181e-4bba-8c29-5fd0fad2d6e3",
      "name": "Re-trigger F-04 pods",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1560,
        400
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.N8N_WEBHOOK_BASE }}/webhook/gitlab-task-mr-opened",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "retry",
              "value": "true"
            },
            {
              "name": "version",
              "value": "={{ $json.body.version }}"
            }
          ]
        }
      }
    }
  ],
