    {
      "parameters": {
        "command": "glab issue update {{ $json.body.story_id }} --label-add 'deferred:{{ $json.body.version }}' && glab issue comment {{ $json.body.story_id }} --message 'Deferred from {{ $json.body.version }}. Reason: {{ $json.body.reason }}. Story preserved for future release. Revert MR: {{ $json.body.revert_mr_url }}'"
      },
      "id": "update-story-23",
