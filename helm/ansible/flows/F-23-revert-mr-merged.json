      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        480,
        200
      ]
    },
    {
      "parameters": {
        "command": "echo 'Update all child task tickets of GL-{{ $json.body.story_id }} with deferred label, keep open'"
