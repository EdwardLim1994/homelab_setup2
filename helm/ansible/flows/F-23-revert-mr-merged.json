              "value": "={{ $json.body.version }}"
            },
            {
              "name": "project",
              "value": "={{ $json.body.project }}"
            },
            {
              "name": "note",
              "value": "Re-triggered after story deferral"
            }
          ]
        }
      },
      "id": "retrigger-uat",
