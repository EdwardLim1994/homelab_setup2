        "command": "=glab issue update {{ $json.body.story_id }} --label-add 'deferred:{{ $json.body.version }}' && glab issue comment {{ $json.body.story_id }} --message 'Deferred from {{ $json.body.version }}. Child tasks preserved.'"
      },
      "id": "defer-story",
      "name": "Story ticket: Deferred + label",
