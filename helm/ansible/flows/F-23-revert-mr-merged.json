      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        480,
        340
      ]
    },
    {
      "parameters": {
        "command": "=glab issue comment {{ $json.body.release_ticket_id }} --message 'GL-{{ $json.body.story_id }} deferred from {{ $json.body.version }}. Reduced scope.'"
