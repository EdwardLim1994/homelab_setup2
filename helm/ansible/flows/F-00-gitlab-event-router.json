{
  "name": "F-00 GitLab Event Router",
  "nodes": [
    {
      "id": "947c03cc-3079-4f4a-ac72-3275192a12b1",
      "name": "GitLab Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "parameters": {
        "path": "gitlab-events",
        "httpMethod": "POST",
        "responseMode": "onReceived",
        "responseData": "allEntries"
      },
      "webhookId": "02734fda-29c5-4225-89f3-7df481136716"
    },
    {
      "id": "76381f6a-c728-47ad-b2f5-36cb589a34da",
      "name": "Verify Token",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        460,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "leftValue": "={{ $request.headers['x-gitlab-token'] }}",
            "operation": "equals",
            "rightValue": "={{ $env.GITLAB_WEBHOOK_SECRET }}"
          }
        }
      }
    },
    {
      "id": "3ff27062-0971-4209-b2de-9956be6a0348",
      "name": "Route by Event+Branch",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [
        680,
        300
      ],
      "parameters": {
        "mode": "rules",
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "leftValue": "={{ $json.object_kind }}",
                  "operation": "equals",
                  "rightValue": "merge_request"
                }
              },
              "outputKey": "mr"
            },
            {
              "conditions": {
                "options": {
                  "leftValue": "={{ $json.object_kind }}",
                  "operation": "equals",
                  "rightValue": "pipeline"
                }
              },
              "outputKey": "pipeline"
            }
          ]
        }
      }
    },
    {
      "id": "7b3ff4c6-eb66-4d45-8c62-5c175c3122ea",
      "name": "MR Open Branch Prefix",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [
        900,
        160
      ],
      "parameters": {
        "mode": "rules",
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "leftValue": "={{ $json.object_attributes.source_branch }}",
                  "operation": "startsWith",
                  "rightValue": "task/"
                }
              },
              "outputKey": "task"
            },
            {
              "conditions": {
                "options": {
                  "leftValue": "={{ $json.object_attributes.source_branch }}",
                  "operation": "startsWith",
                  "rightValue": "us/"
                }
              },
              "outputKey": "story"
            }
          ]
        }
      }
    },
    {
      "id": "a0120684-478f-46ba-843f-859098b7d210",
      "name": "MR Merge Branch Prefix",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [
        900,
        360
      ],
      "parameters": {
        "mode": "rules",
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "leftValue": "={{ $json.object_attributes.source_branch }}",
                  "operation": "startsWith",
                  "rightValue": "task/"
                }
              },
              "outputKey": "task"
            },
            {
              "conditions": {
                "options": {
                  "leftValue": "={{ $json.object_attributes.source_branch }}",
                  "operation": "startsWith",
                  "rightValue": "us/"
                }
              },
              "outputKey": "story"
            },
            {
              "conditions": {
                "options": {
                  "leftValue": "={{ $json.object_attributes.source_branch }}",
                  "operation": "startsWith",
                  "rightValue": "bugfix/"
                }
              },
              "outputKey": "revert"
            },
            {
              "conditions": {
                "options": {
                  "leftValue": "={{ $json.object_attributes.source_branch }}",
                  "operation": "startsWith",
                  "rightValue": "promote/"
                }
              },
              "outputKey": "promote"
            }
          ]
        }
      }
    },
