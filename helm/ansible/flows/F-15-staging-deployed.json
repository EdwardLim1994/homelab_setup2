      "typeVersion": 1,
      "position": [
        900,
        200
      ],
      "parameters": {
        "command": "omp --role qa-engineer --model smol --project {{ $env.REPO_DIR }} --prompt 'Run k6 load test suite against UAT for {{ $json.body.version }} — the full-version image just promoted there (no separate staging cluster). Output: p95 latency, error rate, pass/fail.' --non-interactive"
      }
    },
    {
