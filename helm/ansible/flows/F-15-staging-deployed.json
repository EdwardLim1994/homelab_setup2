{
  "name": "F-15 Staging Deployed",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "ci-staging-deployed",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "wh-15",
      "name": "Webhook: ci-staging-deployed",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "command": "=glab issue comment {{ $json.body.release_ticket_id }} --message 'Staging deployed: {{ $json.body.version }}'"
      },
      "id": "upd-rt",
      "name": "Update release ticket",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        480,
        300
      ]
    },
    {
      "parameters": {
        "command": "=echo '{\"role\":\"qa-engineer\",\"task\":\"staging-performance\"}' > /tmp/qa-stg.json && omp run --mode json --role smol @/tmp/qa-stg.json"
      },
      "id": "qa-stg",
      "name": "Spawn QA: k6 performance tests",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        720,
        200
      ]
    },
    {
      "parameters": {
        "command": "=echo '{\"role\":\"security-engineer\",\"task\":\"staging-zap\"}' > /tmp/sec-stg.json && omp run --mode json --role smol @/tmp/sec-stg.json"
      },
      "id": "sec-stg",
      "name": "Spawn Security: ZAP full scan",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        720,
        400
      ]
    },
    {
      "parameters": {
        "command": "=echo '{\"role\":\"release-manager\",\"task\":\"go-nogo\",\"version\":\"{{ $json.body.version }}\",\"release_ticket_id\":\"{{ $json.body.release_ticket_id }}\"}' > /tmp/rm-gng.json && omp run --mode json --role default @/tmp/rm-gng.json"
      },
      "id": "rm-gng",
      "name": "Spawn RM: go/no-go assessment",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        960,
        300
      ]
    },
    {
      "parameters": {
        "channelId": "={{ $env.MM_SDLC_CHANNEL }}",
        "message": ":rocket: *Staging deployed* — `{{ $json.body.version }}`\nQA k6 + Security ZAP running in parallel · RM go/no-go assessment in progress.\n\nYou'll be notified with the decision.",
        "otherOptions": {}
      },
      "id": "slack-15",
      "name": "Mattermost: staging deployed",
      "type": "n8n-nodes-base.mattermost",
      "typeVersion": 1,
      "position": [
        1200,
        300
      ],
      "credentials": {
        "mattermostApi": {
          "id": "mm-creds",
          "name": "Mattermost SDLC Bot"
        }
      }
    }
  ],
  "connections": {
    "Webhook: ci-staging-deployed": {
      "main": [
        [
          {
            "node": "Update release ticket",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Update release ticket": {
      "main": [
        [
          {
            "node": "Spawn QA: k6 performance tests",
            "type": "main",
            "index": 0
          },
          {
            "node": "Spawn Security: ZAP full scan",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Spawn QA: k6 performance tests": {
      "main": [
        [
          {
            "node": "Spawn RM: go/no-go assessment",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Spawn Security: ZAP full scan": {
      "main": [
        [
          {
            "node": "Spawn RM: go/no-go assessment",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Spawn RM: go/no-go assessment": {
      "main": [
        [
          {
            "node": "Mattermost: staging deployed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [
    {
      "name": "staging"
    },
    {
      "name": "phase-4"
    },
    {
      "name": "mattermost"
    }
  ]
}
