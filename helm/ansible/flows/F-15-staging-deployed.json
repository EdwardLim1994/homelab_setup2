        900,
        400
      ],
      "parameters": {
        "command": "omp --role security-engineer --model smol --project {{ $env.REPO_DIR }} --prompt 'Run OWASP ZAP DAST scan against UAT for {{ $json.body.version }} — the full-version image just promoted there (no separate staging cluster). Output: critical/high findings list.' --non-interactive"
      }
    },
    {
      "id": "3d3b1485-fae6-4ed9-a1c6-eebad98c4db1",
