    {
      "id": "d0342401-24c5-437f-a35c-d26606bdeba7",
      "name": "Query DAG State",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        300
      ],
      "parameters": {
        "jsCode": "// ponytail: Kaneo collapses Taiga's epic/userstory/task/issue into one\n// task resource -- single list call instead of separate userstory+task\n// fetches. label is the closest equivalent to Taiga's release-grouping\n// tags; verify both against the deployed Kaneo version.\nconst kaneoAuth = { Authorization: `Bearer ${$env.KANEO_TOKEN}` };\nconst tasks = await this.helpers.httpRequest({ method: 'GET', url: `${$env.KANEO_URL}/api/task/tasks/${$env.KANEO_PROJECT_ID}`, qs: { label: $env.RELEASE_VERSION }, headers: kaneoAuth, json: true });\nreturn tasks.map(t => ({ json: t }));"
      }
    },
    {
      "id": "7dc9f5b9-02e2-4b3d-9819-7e36e3cca501",
      "name": "Build DAG Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        300
      ],
      "parameters": {
        "jsCode": "// ponytail: Kaneo has one ticket resource (task) -- no more\n// stories-vs-tasks split to report separately.\nconst items = $input.all().map(i => i.json);\nconst open = items.filter(t => t.status !== 'done').length;\nconst closed = items.filter(t => t.status === 'done').length;\nreturn [{json: {\n  version: $env.RELEASE_VERSION,\n  tasks_total: items.length,\n  tasks_open: open,\n  tasks_closed: closed,\n  dag_paused: $env.DAG_PAUSED ?? false,\n  summary: `${closed}/${items.length} tasks closed, ${open} open`\n}}];\n"
      }
    },
    {
      "id": "d3ff71cd-fc3f-4906-b479-7c0a23df6e68",
      "name": "Notify: DAG state",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1120,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.OPENWEBUI_CALLBACK_URL }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "flow_id",
              "value": "={{ $json.body?.flow_id ?? $json.flow_id ?? '' }}"
            },
            {
              "name": "message",
              "value": "📊 DAG state {{ $env.RELEASE_VERSION }}: {{ $json.summary }} | paused={{ $json.dag_paused }}"
            },
            {
              "name": "notes",
              "value": ""
            }
          ]
        }
      }
    }
  ],
