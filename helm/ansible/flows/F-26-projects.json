{
  "name": "F-26 /projects",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "mm-projects",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "slack-trigger",
      "name": "Mattermost: trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\"response_type\": \"ephemeral\", \"text\": \":hourglass_flowing_sand: Running `/projects`...\"}"
      },
      "id": "mm-ack-slack-trigger",
      "name": "Mattermost: ack command",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        480,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "const dag=$workflow.staticData.dagState||{};\nconst summary={\n  version:dag.version||'(none)',\n  phase:dag.currentPhase||'idle',\n  storiesTotal:dag.totalStories||0,\n  storiesMerged:(dag.mergedStories||[]).length,\n  openMRs:Object.keys(dag.openMRs||{}).length,\n  clusterStates:dag.clusterStates||{},\n  pausedTasks:(dag.pausedTasks||[]).length,\n  lastActivity:dag.lastActivity||'—'\n};\nreturn [{json:summary}];"
      },
      "id": "read-dag",
      "name": "Read n8n DAG state",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        300
      ]
    },
    {
      "parameters": {
        "channelId": "={{ $('Mattermost: trigger').item.json.body.channel_id }}",
        "message": "@{{ $('Mattermost: trigger').item.json.body.user_name }} :bar_chart: *SDLC Status*\n*Version:* `{{ $json.version }}`\n*Phase:* {{ $json.phase }}\n*Stories:* {{ $json.storiesMerged }}/{{ $json.storiesTotal }} merged\n*Open MRs:* {{ $json.openMRs }}\n*Paused tasks:* {{ $json.pausedTasks }}\n*Clusters:* {{ JSON.stringify($json.clusterStates) }}\n*Last activity:* {{ $json.lastActivity }}",
        "otherOptions": {}
      },
      "id": "slack-status",
      "name": "Mattermost: project status report",
      "type": "n8n-nodes-base.mattermost",
      "typeVersion": 1,
      "position": [
        720,
        300
      ],
      "credentials": {
        "mattermostApi": {
          "id": "mm-creds",
          "name": "Mattermost SDLC Bot"
        }
      }
    }
  ],
  "connections": {
    "Mattermost: trigger": {
      "main": [
        [
          {
            "node": "Read n8n DAG state",
            "type": "main",
            "index": 0
          },
          {
            "node": "Mattermost: ack command",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read n8n DAG state": {
      "main": [
        [
          {
            "node": "Mattermost: project status report",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [
    {
      "name": "cross-cutting"
    },
    {
      "name": "mattermost"
    }
  ]
}
