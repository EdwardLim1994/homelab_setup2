{
  "name": "F-26 /projects",
  "nodes": [
    {
      "id": "012cb2a3-5712-42eb-9cc7-d7bbe6112a6a",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "parameters": {
        "path": "projects",
        "httpMethod": "GET",
        "responseMode": "onReceived",
        "responseData": "allEntries"
      },
      "webhookId": "0ba3c35a-7646-4360-b4fd-d570efdb6283"
    },
    {
      "id": "d0342401-24c5-437f-a35c-d26606bdeba7",
      "name": "Query DAG State",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
        300
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $env.GITLAB_URL }}/api/v4/projects/{{ $env.GITLAB_PROJECT_ID }}/issues?milestone={{ $env.RELEASE_VERSION }}&per_page=100",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "PRIVATE-TOKEN",
              "value": "={{ $env.GITLAB_TOKEN }}"
            }
          ]
        }
      }
    },
    {
      "id": "7dc9f5b9-02e2-4b3d-9819-7e36e3cca501",
      "name": "Build DAG Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        300
      ],
      "parameters": {
        "jsCode": "\nconst issues = $input.all().map(i => i.json);\nconst stories = issues.filter(i => i.labels.includes('type:user-story'));\nconst tasks = issues.filter(i => i.labels.includes('type:task'));\nconst open = stories.filter(i => i.state === 'opened').length;\nconst merged = stories.filter(i => i.labels.includes('merged-to-release')).length;\nreturn [{json: {\n  version: $env.RELEASE_VERSION,\n  stories_total: stories.length,\n  stories_open: open,\n  stories_merged: merged,\n  tasks_open: tasks.filter(i => i.state === 'opened').length,\n  tasks_closed: tasks.filter(i => i.state === 'closed').length,\n  dag_paused: $env.DAG_PAUSED ?? false,\n  summary: `${merged}/${stories.length} stories merged, ${tasks.filter(i=>i.state==='opened').length} tasks open`\n}}];\n"
      }
    },
    {
      "id": "d3ff71cd-fc3f-4906-b479-7c0a23df6e68",
      "name": "Notify: DAG state",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1120,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.OPENWEBUI_CALLBACK_URL }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "flow_id",
              "value": "={{ $json.flow_id ?? '' }}"
            },
            {
              "name": "message",
              "value": "📊 DAG state {{ $env.RELEASE_VERSION }}: {{ $json.summary }} | paused={{ $json.dag_paused }}"
            },
            {
              "name": "notes",
              "value": ""
            }
          ]
        }
      }
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [
          {
            "node": "Query DAG State",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Query DAG State": {
      "main": [
        [
          {
            "node": "Build DAG Summary",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build DAG Summary": {
      "main": [
        [
          {
            "node": "Notify: DAG state",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "tags": [],
  "settings": {
    "executionOrder": "v1"
  }
}
