{
  "name": "F-16 Release Manager Go/No-Go",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "go-nogo-result",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "wh-16",
      "name": "Webhook: go-nogo-result",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "leftValue": "={{ $json.body.decision }}",
              "rightValue": "go",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ]
        }
      },
      "id": "go-check",
      "name": "GO or NO-GO?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        480,
        300
      ]
    },
    {
      "parameters": {
        "command": "=glab issue update {{ $json.body.release_ticket_id }} --label-add 'rm:go'"
      },
      "id": "apply-go",
      "name": "Apply rm:go label",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        720,
        160
      ]
    },
    {
      "parameters": {
        "channelId": "={{ $env.MM_SDLC_CHANNEL }}",
        "message": ":green_circle: *Staging GO* — `rm:go` applied.\n\n{{ $json.body.validation_table }}\n\nRun `/release_production {{ $json.body.version }}` to deploy.",
        "otherOptions": {}
      },
      "id": "slack-go",
      "name": "Mattermost: GO — ready for production",
      "type": "n8n-nodes-base.mattermost",
      "typeVersion": 1,
      "position": [
        960,
        160
      ],
      "credentials": {
        "mattermostApi": {
          "id": "mm-creds",
          "name": "Mattermost SDLC Bot"
        }
      }
    },
    {
      "parameters": {
        "command": "=glab issue comment {{ $json.body.release_ticket_id }} --message 'NO-GO: {{ $json.body.reason }}\\n\\nOptions: A) {{ $json.body.suggestion_a }} B) {{ $json.body.suggestion_b }} C) {{ $json.body.suggestion_c }}'"
      },
      "id": "post-nogo",
      "name": "Post NO-GO report on release ticket",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        720,
        440
      ]
    },
    {
      "parameters": {
        "channelId": "={{ $env.MM_SDLC_CHANNEL }}",
        "message": ":red_circle: *Staging NO-GO* — `{{ $json.body.reason }}`\n\n*Options:*\n• A) {{ $json.body.suggestion_a }}\n• B) {{ $json.body.suggestion_b }}\n• C) {{ $json.body.suggestion_c }}\n\nReview release ticket and reply with your decision.",
        "otherOptions": {}
      },
      "id": "slack-nogo",
      "name": "Mattermost: NO-GO — decision required",
      "type": "n8n-nodes-base.mattermost",
      "typeVersion": 1,
      "position": [
        960,
        440
      ],
      "credentials": {
        "mattermostApi": {
          "id": "mm-creds",
          "name": "Mattermost SDLC Bot"
        }
      }
    }
  ],
  "connections": {
    "Webhook: go-nogo-result": {
      "main": [
        [
          {
            "node": "GO or NO-GO?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "GO or NO-GO?": {
      "main": [
        [
          {
            "node": "Apply rm:go label",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Post NO-GO report on release ticket",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Apply rm:go label": {
      "main": [
        [
          {
            "node": "Mattermost: GO — ready for production",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Post NO-GO report on release ticket": {
      "main": [
        [
          {
            "node": "Mattermost: NO-GO — decision required",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [
    {
      "name": "staging"
    },
    {
      "name": "phase-4"
    },
    {
      "name": "mattermost"
    }
  ]
}
