{
  "name": "F-16 Go/No-Go",
  "nodes": [
    {
      "id": "fef63188-40c7-4a14-a411-0aad71b25dce",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "parameters": {
        "path": "go-nogo",
        "httpMethod": "POST",
        "responseMode": "onReceived",
        "responseData": "allEntries"
      },
      "webhookId": "29d43455-5a2c-487c-8985-91a20aa4edb3"
    },
    {
      "id": "b16000001-0000-0000-0000-000000000001",
      "name": "Find Release Ticket",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        300
      ],
      "parameters": {
        "jsCode": "// ponytail: label query param is the closest Kaneo equivalent to Taiga's\n// release-grouping tags -- verify against the deployed Kaneo version.\nconst auth = { Authorization: `Bearer ${$env.KANEO_TOKEN}` };\nconst res = await this.helpers.httpRequest({ method: 'GET', url: `${$env.KANEO_URL}/api/task/tasks/${$env.KANEO_PROJECT_ID}`, qs: { label: $env.RELEASE_VERSION }, headers: auth, json: true });\nconst ticket = (res || []).find(t => (t.title || '').startsWith('[release]'));\nif (!ticket) throw new Error(`No release ticket found for ${$env.RELEASE_VERSION} — UAT sign-off must complete before go/no-go runs`);\nreturn [{ json: { ...$json, release_ticket_id: ticket.id } }];"
      }
    },
    {
      "id": "e1c93f14-a8c2-465a-975a-4387f7790798",
      "name": "RM: Go/No-Go Decision",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        680,
        300
      ],
      "parameters": {
        "command": "omp --role release-manager --model default --project {{ $env.REPO_DIR }} --prompt 'Evaluate k6 and ZAP results for {{ $json.body.version }}. Apply release criteria thresholds. Output JSON: {decision: GO|NO-GO, reason: string, options: [...]}' --non-interactive"
      }
    },
    {
      "id": "33f03cb9-dccf-499d-b346-6e6c074bbd1e",
      "name": "GO?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        900,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "leftValue": "={{ JSON.parse($json.stdout).decision }}",
            "operation": "equals",
            "rightValue": "GO"
          }
        }
      }
    },
    {
      "id": "7a44622a-d6c8-4a4f-8b10-23a776c9a275",
      "name": "Set RM Go Status",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        200
      ],
      "parameters": {
        "jsCode": "// ponytail: Kaneo task has a plain status field, no separate status-id\n// lookup, and no combined status+comment PATCH -- two calls instead of one.\n// Verify both the status value and comment path against the deployed Kaneo version.\nconst auth = { Authorization: `Bearer ${$env.KANEO_TOKEN}` };\nconst id = $node['Find Release Ticket'].json.release_ticket_id;\nawait this.helpers.httpRequest({ method: 'PATCH', url: `${$env.KANEO_URL}/api/task/${id}`, headers: { ...auth, 'Content-Type': 'application/json' }, body: { status: 'rm-go' }, json: true });\nawait this.helpers.httpRequest({ method: 'POST', url: `${$env.KANEO_URL}/api/task/${id}/comment`, headers: { ...auth, 'Content-Type': 'application/json' }, body: { content: 'GO decision — cleared for /release_production.' }, json: true });\nreturn [{ json: $json }];"
      }
    },
    {
      "id": "301ba7b5-f5f8-43fa-ac96-df8a4e380f5f",
      "name": "Notify: GO",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1340,
        200
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.OPENWEBUI_CALLBACK_URL }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "flow_id",
              "value": "={{ $json.body?.flow_id ?? $json.flow_id ?? '' }}"
            },
            {
              "name": "message",
              "value": "✅ GO — {{ $env.RELEASE_VERSION }} cleared for /release_production"
            },
            {
              "name": "notes",
              "value": ""
            }
          ]
        }
      }
    },
    {
      "id": "b9f6e564-bf48-4afd-baf6-2113f9d9445e",
      "name": "Notify: NO-GO options",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1120,
        400
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.OPENWEBUI_CALLBACK_URL }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "flow_id",
              "value": "={{ $json.body?.flow_id ?? $json.flow_id ?? '' }}"
            },
            {
              "name": "message",
              "value": "🚨 NO-GO — {{ $env.RELEASE_VERSION }} blocked. Options: 1) fix & re-stage 2) rollback story 3) defer release. Details: {{ JSON.parse($json.stdout).reason }}"
            },
            {
              "name": "notes",
              "value": ""
            }
          ]
        }
      }
    }
  ],
  "connections": {
