{
  "name": "F-14 /release_staging",
  "nodes": [
    {
      "id": "6be2386d-220c-416d-aa45-ff7597498aa3",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "parameters": {
        "path": "release-staging",
        "httpMethod": "POST",
        "responseMode": "onReceived",
        "responseData": "allEntries"
      },
      "webhookId": "a4252b67-7ea8-4bfd-8894-e613a7b3c86c"
    },
    {
      "id": "574de774-cf51-4be9-ad69-eedf5b6c17ce",
      "name": "UAT Safeguard",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
        300
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $env.GITLAB_URL }}/api/v4/projects/{{ $env.GITLAB_PROJECT_ID }}/issues/{{ $env.RELEASE_TICKET_ID }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "PRIVATE-TOKEN",
              "value": "={{ $env.GITLAB_TOKEN }}"
            }
          ]
        }
      }
    },
    {
      "id": "94b7463d-558e-4d36-b9d0-4ebd90fda8a3",
      "name": "All UAT Labels?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        900,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "leftValue": "={{ $json.labels.includes('po:uat-approved') && $json.labels.includes('security:cleared') && $json.labels.includes('qa:uat-approved') }}",
            "operation": "equals",
            "rightValue": "true"
          }
        }
      }
    },
    {
      "id": "2759c45d-c7cc-4400-86b1-b888794704b3",
      "name": "Notify: Staging blocked",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1120,
        400
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.OPENWEBUI_CALLBACK_URL }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "flow_id",
              "value": "={{ $json.flow_id ?? '' }}"
            },
            {
              "name": "message",
              "value": "🚫 /release_staging blocked — UAT labels missing on release ticket"
            },
            {
              "name": "notes",
              "value": ""
            }
          ]
        }
      }
    },
    {
      "id": "b14000001-0000-0000-0000-000000000001",
      "name": "RM Input",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1120,
        120
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            { "id": "1", "name": "role", "value": "release-manager", "type": "string" },
            { "id": "2", "name": "prompt", "value": "=Create a release-plan child ticket for {{ $env.RELEASE_VERSION }} under release ticket {{ $env.RELEASE_TICKET_ID }} via glab. Include a go-live checklist.", "type": "string" },
            { "id": "3", "name": "story", "value": "={{ $env.RELEASE_VERSION }}", "type": "string" }
          ]
        }
      }
    },
    {
      "id": "3ebdd3bd-7d83-4eff-a970-27c4e24e8a4e",
      "name": "RM: Create Release Plan Ticket",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.1,
      "position": [
        1300,
        200
      ],
      "parameters": {
        "source": "database",
        "workflowId": { "mode": "id", "value": "jAv16SAzGy9fA5G4" },
        "mode": "once"
      }
    },
    {
      "id": "ff579f3b-661a-417b-9ffe-bb6608d5d5cb",
      "name": "Create promote/ branch",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1340,
        200
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.GITLAB_URL }}/api/v4/projects/{{ $env.GITLAB_PROJECT_ID }}/repository/branches",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "PRIVATE-TOKEN",
              "value": "={{ $env.GITLAB_TOKEN }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "__json",
              "value": "={\"branch\":\"promote/{{ $env.RELEASE_VERSION }}\",\"ref\":\"release/{{ $env.RELEASE_VERSION }}\"}"
            }
          ]
        }
      }
    },
    {
      "id": "5ffa83c3-ccf7-4d5f-b669-012b5aac7f72",
      "name": "Notify: Staging CI triggered",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1560,
        200
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.OPENWEBUI_CALLBACK_URL }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "flow_id",
              "value": "={{ $json.flow_id ?? '' }}"
            },
            {
              "name": "message",
              "value": "🚀 promote/ branch created — promotion CI triggered"
            },
            {
              "name": "notes",
              "value": ""
            }
          ]
        }
      }
    }
  ],
