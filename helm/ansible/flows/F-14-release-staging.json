            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Safeguard passed?": {
      "main": [
        [
          {
            "node": "RM creates release-plan ticket",
            "type": "main",
            "index": 0
          },
          {
            "node": "Create promote/ branch",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Mattermost: staging blocked",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "RM creates release-plan ticket": {
      "main": [
        [
          {
            "node": "Trigger promotion CI",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Create promote/ branch": {
      "main": [
        [
          {
            "node": "Trigger promotion CI",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Trigger promotion CI": {
      "main": [
        [
          {
            "node": "Mattermost: staging pipeline running",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [
