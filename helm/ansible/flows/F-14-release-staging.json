      "name": "Find Release Ticket",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        300
      ],
      "parameters": {
        "jsCode": "const taigaAuth = { Authorization: `Bearer ${$env.TAIGA_TOKEN}` };\nconst tasks = await this.helpers.httpRequest({ method: 'GET', url: `${$env.TAIGA_URL}/api/v1/tasks`, qs: { project: $env.TAIGA_PROJECT_ID, tags: $env.RELEASE_VERSION }, headers: taigaAuth, json: true });\nconst ticket = tasks.find(t => t.subject.startsWith('[release]')) || null;\n// Ticket only exists once all 3 UAT sign-offs landed (F-13 creates it with\n// status \"PO UAT Approved\" at creation) — existence alone is the safeguard,\n// no need to re-check the status.\nreturn [{ json: { ...$json, found: !!ticket, release_ticket_id: ticket ? ticket.id : null } }];"
      }
    },
    {
      "id": "94b7463d-558e-4d36-b9d0-4ebd90fda8a3",
      "name": "Found?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        900,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "leftValue": "={{ $json.found }}",
            "operation": "equals",
            "rightValue": "true"
          }
        }
      }
    },
    {
      "id": "2759c45d-c7cc-4400-86b1-b888794704b3",
