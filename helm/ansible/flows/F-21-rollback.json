{
  "name": "F-21 /rollback",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "mm-rollback",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "slack-trigger",
      "name": "Mattermost: trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\"response_type\": \"ephemeral\", \"text\": \":hourglass_flowing_sand: Running `/rollback`...\"}"
      },
      "id": "mm-ack-slack-trigger",
      "name": "Mattermost: ack command",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        480,
        200
      ]
    },
    {
      "parameters": {
        "channelId": "={{ $('Mattermost: trigger').item.json.body.channel_id }}",
        "message": "@{{ $('Mattermost: trigger').item.json.body.user_name }} :rotating_light: *Production rollback initiated* for `{{ $json.text }}`\nArgoCD rolling back now...",
        "otherOptions": {}
      },
      "id": "ack-21",
      "name": "Mattermost: rollback started",
      "type": "n8n-nodes-base.mattermost",
      "typeVersion": 1,
      "position": [
        480,
        300
      ],
      "credentials": {
        "mattermostApi": {
          "id": "mm-creds",
          "name": "Mattermost SDLC Bot"
        }
      }
    },
    {
      "parameters": {
        "command": "=argocd app rollback {{ $env.ARGOCD_PROJECT }}-production --server $ARGOCD_URL && echo 'Rollback initiated'"
      },
      "id": "rb",
      "name": "ArgoCD rollback production",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        720,
        300
      ]
    },
    {
      "parameters": {
        "command": "=glab issue create --title '[incident] Production rollback {{ $('Slack: trigger').item.json.text }}' --label 'type:incident' --description 'Production rollback executed. Time: {{ new Date().toISOString() }}. Reason: manual rollback command.'"
      },
      "id": "incident-ticket",
      "name": "Create incident ticket",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        960,
        300
      ]
    },
    {
      "parameters": {
        "command": "=echo '{\"role\":\"release-manager\",\"task\":\"monitor-rollback\",\"version\":\"{{ $('Slack: trigger').item.json.text }}\"}' > /tmp/rm-rb.json && omp run --mode json --role default @/tmp/rm-rb.json"
      },
      "id": "rm-mon",
      "name": "Spawn RM: monitor rollback health",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        1200,
        300
      ]
    },
    {
      "parameters": {
        "channelId": "={{ $('Mattermost: trigger').item.json.body.channel_id }}",
        "message": "@{{ $('Mattermost: trigger').item.json.body.user_name }} :white_check_mark: Rollback initiated · incident ticket created · RM monitoring health.\n\nYou'll be notified when the rollback is confirmed stable.",
        "otherOptions": {}
      },
      "id": "slack-rb-done",
      "name": "Mattermost: rollback underway",
      "type": "n8n-nodes-base.mattermost",
      "typeVersion": 1,
      "position": [
        1440,
        300
      ],
      "credentials": {
        "mattermostApi": {
          "id": "mm-creds",
          "name": "Mattermost SDLC Bot"
        }
      }
    }
  ],
  "connections": {
    "Mattermost: trigger": {
      "main": [
        [
          {
            "node": "Mattermost: rollback started",
            "type": "main",
            "index": 0
          },
          {
            "node": "Mattermost: ack command",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Mattermost: rollback started": {
      "main": [
        [
          {
            "node": "ArgoCD rollback production",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "ArgoCD rollback production": {
      "main": [
        [
          {
            "node": "Create incident ticket",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Create incident ticket": {
      "main": [
        [
          {
            "node": "Spawn RM: monitor rollback health",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Spawn RM: monitor rollback health": {
      "main": [
        [
          {
            "node": "Mattermost: rollback underway",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [
    {
      "name": "production"
    },
    {
      "name": "phase-5"
    },
    {
      "name": "mattermost"
    }
  ]
}
