{
  "name": "F-20 Monitoring Window",
  "nodes": [
    {
      "id": "db6dd6c8-77ef-44e2-95d5-50b767b747c2",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "parameters": {
        "path": "monitoring-window",
        "httpMethod": "POST",
        "responseMode": "onReceived",
        "responseData": "allEntries"
      },
      "webhookId": "cf9059c5-1dae-409b-b3e0-650168406fce"
    },
    {
      "id": "e4239007-5910-4c82-8ae6-7e6ab426dee4",
      "name": "Respond OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        460,
        300
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\"status\":\"accepted\"}"
      }
    },
    {
      "id": "a35ccb4d-33f5-476c-ae0a-874ee366d5ba",
      "name": "Notify: Monitoring window open",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.OPENWEBUI_CALLBACK_URL }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "flow_id",
              "value": "={{ $json.flow_id ?? '' }}"
            },
            {
              "name": "message",
              "value": "\ud83d\udd2d Monitoring window open for {{ $json.body.version }} \u2014 30 min"
            },
            {
              "name": "notes",
              "value": ""
            }
          ]
        }
      }
    },
    {
      "id": "8704c10e-889a-433d-a3aa-d81992f0ac4e",
      "name": "Wait 30 min",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1,
      "position": [
        900,
        300
      ],
      "parameters": {
        "resume": "timeInterval",
        "unit": "minutes",
        "value": 30
      }
    },
    {
      "id": "98993320-da0e-4a00-bcdd-f52cb3d9a37c",
      "name": "RM: Health Check",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        1120,
        300
      ],
      "parameters": {
        "command": "omp --role release-manager --model default --project {{ $env.REPO_DIR }} --prompt 'Check Grafana/Prometheus for {{ $json.body.version }}: error rate, latency p95, pod restarts. Output JSON: {status: clean|incident, findings: string}' --non-interactive"
      }
    },
    {
      "id": "4518fc25-58b0-4850-b0aa-9d76359a1eb5",
      "name": "Clean?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1340,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "leftValue": "={{ JSON.parse($json.stdout).status }}",
            "operation": "equals",
            "rightValue": "clean"
          }
        }
      }
    },
    {
      "id": "efd21463-12b5-4e0e-bbcd-26cd50c3f334",
      "name": "Notify: Release confirmed",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1560,
        200
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.OPENWEBUI_CALLBACK_URL }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "flow_id",
              "value": "={{ $json.flow_id ?? '' }}"
            },
            {
              "name": "message",
              "value": "\ud83c\udf89 {{ $env.RELEASE_VERSION }} production confirmed clean \u2014 release complete"
            },
            {
              "name": "notes",
              "value": ""
            }
          ]
        }
      }
    },
    {
      "id": "79aa36f9-d463-4b94-9e2b-cc58d4064815",
      "name": "PM: Release Comms",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        1780,
        200
      ],
      "parameters": {
        "command": "opencode --role pm --model haiku --prompt 'Post release comms for {{ $json.body.version }}: changelog summary, what changed, who to contact.' --non-interactive"
      }
    },
    {
      "id": "92d4e149-dcac-4fd2-8901-6200e8a17f2e",
      "name": "Sleep Staging Cluster",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2000,
        200
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.N8N_WEBHOOK_BASE }}/webhook/cluster-lifecycle",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "action",
              "value": "sleep"
            },
            {
              "name": "cluster",
              "value": "staging"
            }
          ]
        }
      }
    },
    {
      "id": "2a2e3751-6b2e-42b1-96dd-3ae59acc461d",
      "name": "Notify: Incident detected",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1560,
        400
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.OPENWEBUI_CALLBACK_URL }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "flow_id",
              "value": "={{ $json.flow_id ?? '' }}"
            },
            {
              "name": "message",
              "value": "\ud83d\udea8 Incident detected post-deploy for {{ $env.RELEASE_VERSION }} \u2014 escalating"
            },
            {
              "name": "notes",
              "value": ""
            }
          ]
        }
      }
    },
    {
      "id": "c11d69d0-24b7-4449-a6b8-d6387ed60585",
      "name": "\u2192 Escalate Incident",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1780,
        400
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.N8N_WEBHOOK_BASE }}/webhook/escalate",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "reason",
              "value": "Post-deploy incident: {{ JSON.parse($json.stdout).findings }}"
            }
          ]
        }
      }
    }
  ],
