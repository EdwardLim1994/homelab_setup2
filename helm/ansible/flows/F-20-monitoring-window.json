{
  "name": "F-20 Monitoring Window Complete",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "monitoring-complete",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "wh-20",
      "name": "Webhook: monitoring-complete",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "leftValue": "={{ $json.body.incident }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ]
        }
      },
      "id": "incident-check",
      "name": "Incident detected?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        480,
        300
      ]
    },
    {
      "parameters": {
        "channelId": "={{ $env.MM_SDLC_CHANNEL }}",
        "message": ":rotating_light: *PRODUCTION INCIDENT* — `{{ $json.body.version }}`\n*Metric:* {{ $json.body.metric }} = {{ $json.body.value }} (threshold breached)\n*Trend:* {{ $json.body.trend }}\n\n*RM recommendation:*\n{{ $json.body.recommended_action }}\n\nReply with your decision.",
        "otherOptions": {}
      },
      "id": "slack-incident",
      "name": "Mattermost: PRODUCTION INCIDENT",
      "type": "n8n-nodes-base.mattermost",
      "typeVersion": 1,
      "position": [
        720,
        160
      ],
      "credentials": {
        "mattermostApi": {
          "id": "mm-creds",
          "name": "Mattermost SDLC Bot"
        }
      }
    },
    {
      "parameters": {
        "command": "=glab issue update {{ $json.body.release_ticket_id }} --label-add 'monitoring:passed' && glab issue close {{ $json.body.release_ticket_id }}"
      },
      "id": "close-rt",
      "name": "Update release ticket: monitoring passed + close",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        720,
        440
      ]
    },
    {
      "parameters": {
        "command": "=echo '{\"role\":\"pm\",\"task\":\"release-communication\",\"version\":\"{{ $json.body.version }}\"}' > /tmp/pm-comm.json && opencode run --print \"$(cat /tmp/pm-comm.json)\""
      },
      "id": "pm-comms",
      "name": "Spawn PM: release communication",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        960,
        440
      ]
    },
    {
      "parameters": {
        "url": "={{ $env.N8N_WEBHOOK_BASE }}/cluster-sleep",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "cluster",
              "value": "staging"
            }
          ]
        }
      },
      "id": "sleep-stg",
      "name": "Sleep staging cluster",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        1200,
        440
      ]
    },
    {
      "parameters": {
        "channelId": "={{ $env.MM_SDLC_CHANNEL }}",
        "message": ":tada: *Release `{{ $json.body.version }}` confirmed stable!*\nMonitoring window complete · no incidents · release ticket closed.\nRelease notes posted. Staging cluster sleeping.\n\nRun `/retro {{ $json.body.version }}` to complete the sprint.",
        "otherOptions": {}
      },
      "id": "slack-confirmed",
      "name": "Mattermost: release confirmed",
      "type": "n8n-nodes-base.mattermost",
      "typeVersion": 1,
      "position": [
        1440,
        440
      ],
      "credentials": {
        "mattermostApi": {
          "id": "mm-creds",
          "name": "Mattermost SDLC Bot"
        }
      }
    }
  ],
  "connections": {
    "Webhook: monitoring-complete": {
      "main": [
        [
          {
            "node": "Incident detected?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Incident detected?": {
      "main": [
        [
          {
            "node": "Mattermost: PRODUCTION INCIDENT",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Update release ticket: monitoring passed + close",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Update release ticket: monitoring passed + close": {
      "main": [
        [
          {
            "node": "Spawn PM: release communication",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Spawn PM: release communication": {
      "main": [
        [
          {
            "node": "Sleep staging cluster",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Sleep staging cluster": {
      "main": [
        [
          {
            "node": "Mattermost: release confirmed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [
    {
      "name": "production"
    },
    {
      "name": "phase-5"
    },
    {
      "name": "mattermost"
    }
  ]
}
