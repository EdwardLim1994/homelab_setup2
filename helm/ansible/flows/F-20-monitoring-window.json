{
  "name": "F-20 Monitoring Window",
  "nodes": [
    {
      "id": "db6dd6c8-77ef-44e2-95d5-50b767b747c2",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "parameters": {
        "path": "monitoring-window",
        "httpMethod": "POST",
        "responseMode": "onReceived",
        "responseData": "allEntries"
      },
      "webhookId": "cf9059c5-1dae-409b-b3e0-650168406fce"
    },
    {
      "id": "a35ccb4d-33f5-476c-ae0a-874ee366d5ba",
      "name": "Notify: Monitoring window open",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.OPENWEBUI_CALLBACK_URL }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "flow_id",
              "value": "={{ $json.flow_id ?? '' }}"
            },
            {
              "name": "message",
              "value": "=🔭 Monitoring window open for {{ $json.body.version }} — 30 min"
            },
            {
              "name": "notes",
              "value": ""
            }
          ]
        }
      }
    },
    {
      "id": "8704c10e-889a-433d-a3aa-d81992f0ac4e",
      "name": "Wait 30 min",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1,
      "position": [
        900,
        300
      ],
      "parameters": {
        "resume": "timeInterval",
        "unit": "minutes",
        "value": 30
      }
    },
    {
      "id": "b20000001-0000-0000-0000-000000000001",
      "name": "RM Input",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        900,
        300
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            { "id": "1", "name": "role", "value": "release-manager", "type": "string" },
            { "id": "2", "name": "prompt", "value": "=Check Grafana/Prometheus for {{ $node['Webhook Trigger'].json.body.body.version }}: error rate, latency p95, pod restarts. Output JSON only: {\"status\": \"clean\"|\"incident\", \"findings\": \"string\"}", "type": "string" },
            { "id": "3", "name": "story", "value": "={{ $node['Webhook Trigger'].json.body.body.version }}", "type": "string" }
          ]
        }
      }
    },
    {
      "id": "98993320-da0e-4a00-bcdd-f52cb3d9a37c",
      "name": "RM: Health Check",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.1,
      "position": [
        1120,
        300
      ],
      "parameters": {
        "source": "database",
        "workflowId": { "mode": "id", "value": "jAv16SAzGy9fA5G4" },
        "mode": "once"
      }
    },
    {
      "id": "4518fc25-58b0-4850-b0aa-9d76359a1eb5",
      "name": "Clean?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1340,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "leftValue": "={{ $json.output.includes('\"status\"') && $json.output.includes('\"clean\"') }}",
            "operation": "equals",
            "rightValue": "true"
          }
        }
      }
    },
    {
      "id": "efd21463-12b5-4e0e-bbcd-26cd50c3f334",
      "name": "Notify: Release confirmed",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1560,
        200
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.OPENWEBUI_CALLBACK_URL }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "flow_id",
              "value": "={{ $json.flow_id ?? '' }}"
            },
            {
              "name": "message",
              "value": "=🎉 {{ $env.RELEASE_VERSION }} production confirmed clean — release complete"
            },
            {
              "name": "notes",
              "value": ""
            }
          ]
        }
      }
    },
    {
      "id": "b20000001-0000-0000-0000-000000000002",
      "name": "PM Input",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1780,
        140
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            { "id": "1", "name": "role", "value": "pm", "type": "string" },
            { "id": "2", "name": "prompt", "value": "=Post release comms for {{ $node['Webhook Trigger'].json.body.body.version }}: changelog summary, what changed, who to contact.", "type": "string" },
            { "id": "3", "name": "story", "value": "={{ $node['Webhook Trigger'].json.body.body.version }}", "type": "string" }
          ]
        }
      }
    },
    {
      "id": "79aa36f9-d463-4b94-9e2b-cc58d4064815",
      "name": "PM: Release Comms",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.1,
      "position": [
        1960,
        200
      ],
      "parameters": {
        "source": "database",
        "workflowId": { "mode": "id", "value": "jAv16SAzGy9fA5G4" },
        "mode": "once"
      }
    },
    {
      "id": "92d4e149-dcac-4fd2-8901-6200e8a17f2e",
      "name": "Sleep Staging Cluster",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2000,
        200
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.N8N_WEBHOOK_BASE }}/cluster-lifecycle",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "action",
              "value": "sleep"
            },
            {
              "name": "cluster",
              "value": "staging"
            }
          ]
        }
      }
    },
    {
      "id": "2a2e3751-6b2e-42b1-96dd-3ae59acc461d",
      "name": "Notify: Incident detected",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1560,
        400
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.OPENWEBUI_CALLBACK_URL }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "flow_id",
              "value": "={{ $json.flow_id ?? '' }}"
            },
            {
              "name": "message",
              "value": "=🚨 Incident detected post-deploy for {{ $env.RELEASE_VERSION }} — escalating"
            },
            {
              "name": "notes",
              "value": ""
            }
          ]
        }
      }
    },
    {
      "id": "c11d69d0-24b7-4449-a6b8-d6387ed60585",
      "name": "→ Escalate Incident",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1780,
        400
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.N8N_WEBHOOK_BASE }}/escalate",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "reason",
              "value": "=Post-deploy incident: {{ $node['RM: Health Check'].json.output }}"
            }
          ]
        }
      }
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [
          {
            "node": "Notify: Monitoring window open",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Notify: Monitoring window open": {
      "main": [
        [
          {
            "node": "Wait 30 min",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Wait 30 min": {
      "main": [
        [
          {
            "node": "RM Input",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "RM Input": {
      "main": [
        [
          {
            "node": "RM: Health Check",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "RM: Health Check": {
      "main": [
        [
          {
            "node": "Clean?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Clean?": {
      "main": [
        [
          {
            "node": "Notify: Release confirmed",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Notify: Incident detected",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Notify: Release confirmed": {
      "main": [
        [
          {
            "node": "PM Input",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "PM Input": {
      "main": [
        [
          {
            "node": "PM: Release Comms",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "PM: Release Comms": {
      "main": [
        [
          {
            "node": "Sleep Staging Cluster",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Notify: Incident detected": {
      "main": [
        [
          {
            "node": "→ Escalate Incident",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "tags": [],
  "settings": {
    "executionOrder": "v1"
  }
}
