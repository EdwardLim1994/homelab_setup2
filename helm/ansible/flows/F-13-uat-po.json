    {
      "id": "0b98ca9f-5b6c-4acc-aef8-3af92dc4171d",
      "name": "PO Approved?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1300, 300],
      "parameters": {
        "conditions": {
          "options": {
            "leftValue": "={{ $json.output.includes('\"status\"') && $json.output.includes('\"approved\"') }}",
            "operation": "equals",
            "rightValue": "true"
          }
        }
