{
  "name": "F-13 UAT PO Stage",
  "nodes": [
    {
      "id": "1d8a6901-e45b-4cb1-b75b-ee1001277fd0",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "parameters": {
        "path": "uat-po",
        "httpMethod": "POST",
        "responseMode": "onReceived",
        "responseData": "allEntries"
      },
      "webhookId": "40bc3ed3-4f21-4728-9a24-0a35f3156c7f"
    },
    {
      "id": "48f56846-0558-423c-aac6-7d120c3bef59",
      "name": "Respond OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        460,
        300
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\"status\":\"accepted\"}"
      }
    },
    {
      "id": "62bdc645-e1d2-428a-9b39-2b1221c85a84",
      "name": "Notify: UAT PO review",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.OPENWEBUI_CALLBACK_URL }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "flow_id",
              "value": "={{ $json.flow_id ?? '' }}"
            },
            {
              "name": "message",
              "value": "\ud83d\udce6 UAT PO sign-off stage"
            },
            {
              "name": "notes",
              "value": ""
            }
          ]
        }
      }
    },
    {
      "id": "44a34d9c-38a8-4db9-b1da-4548dec02614",
      "name": "PO: UAT Acceptance",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        900,
        300
      ],
      "parameters": {
        "command": "omp --role product-owner --model smol --project {{ $env.REPO_DIR }} --prompt 'Review UAT results for {{ $json.body.version }}. Verify all acceptance criteria met. Output: approved/rejected with notes.' --non-interactive"
      }
    },
    {
      "id": "0b98ca9f-5b6c-4acc-aef8-3af92dc4171d",
      "name": "PO Approved?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1120,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "leftValue": "={{ JSON.parse($json.stdout).status }}",
            "operation": "equals",
            "rightValue": "approved"
          }
        }
      }
    },
    {
      "id": "8494549e-9d8f-44ca-b852-a008f9bae0f1",
      "name": "Label: po:uat-approved",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1340,
        200
      ],
      "parameters": {
        "method": "PUT",
        "url": "={{ $env.GITLAB_URL }}/api/v4/projects/{{ $env.GITLAB_PROJECT_ID }}/issues/{{ $env.RELEASE_TICKET_ID }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "PRIVATE-TOKEN",
              "value": "={{ $env.GITLAB_TOKEN }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "__json",
              "value": "{\"add_labels\":\"po:uat-approved\"}"
            }
          ]
        }
      }
    },
    {
      "id": "e377a389-6e7f-4146-9d8d-170c4522bee7",
      "name": "Notify: UAT complete",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1560,
        200
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.OPENWEBUI_CALLBACK_URL }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "flow_id",
              "value": "={{ $json.flow_id ?? '' }}"
            },
            {
              "name": "message",
              "value": "\u2705 UAT complete \u2014 all stages approved. Ready for /release_staging"
            },
            {
              "name": "notes",
              "value": ""
            }
          ]
        }
      }
    },
    {
      "id": "d1cac5de-4fed-4046-b992-21e9dce8171b",
      "name": "Notify: PO rejected UAT",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1340,
        400
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.OPENWEBUI_CALLBACK_URL }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "flow_id",
              "value": "={{ $json.flow_id ?? '' }}"
            },
            {
              "name": "message",
              "value": "\u274c PO rejected UAT \u2014 review acceptance criteria gaps"
            },
            {
              "name": "notes",
              "value": ""
            }
          ]
        }
      }
    }
  ],
