      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "parameters": {
        "path": "release-production",
        "httpMethod": "POST",
        "responseMode": "onReceived",
        "responseData": "allEntries"
