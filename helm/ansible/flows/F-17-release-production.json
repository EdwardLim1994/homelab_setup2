    {
      "id": "40bb0ef7-c057-436b-b123-c9de5c9d2271",
      "name": "Find Release Ticket",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        300
      ],
      "parameters": {
        "jsCode": "// ponytail: label query param is the closest Kaneo equivalent to Taiga's\n// release-grouping tags, and Kaneo's task.status is a plain string (no\n// status_extra_info indirection) -- verify both against the deployed Kaneo version.\nconst kaneoAuth = { Authorization: `Bearer ${$env.KANEO_TOKEN}` };\nconst tasks = await this.helpers.httpRequest({ method: 'GET', url: `${$env.KANEO_URL}/api/task/tasks/${$env.KANEO_PROJECT_ID}`, qs: { label: $env.RELEASE_VERSION }, headers: kaneoAuth, json: true });\nconst ticket = tasks.find(t => t.title.startsWith('[release]')) || null;\nreturn [{ json: { ...$json, rm_go: !!ticket && ticket.status === 'rm-go', release_ticket_id: ticket ? ticket.id : null } }];"
      }
    },
    {
      "id": "457bfee4-1b22-4ab0-b34a-b6f18184f771",
      "name": "rm:go label present?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        900,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "leftValue": "={{ $json.rm_go }}",
            "operation": "equals",
            "rightValue": "true"
          }
        }
      }
    },
    {
      "id": "3e5da2ec-23b6-4643-8d13-fa95a32f1c7f",
      "name": "Notify: Production blocked",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1120,
        400
      ],
      "parameters": {
