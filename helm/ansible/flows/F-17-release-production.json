{
  "name": "F-17 /release-production",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "mm-release_production",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "slack-trigger",
      "name": "Mattermost: trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\"response_type\": \"ephemeral\", \"text\": \":hourglass_flowing_sand: Running `/release_production`...\"}"
      },
      "id": "mm-ack-slack-trigger",
      "name": "Mattermost: ack command",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        480,
        200
      ]
    },
    {
      "parameters": {
        "channelId": "={{ $('Mattermost: trigger').item.json.body.channel_id }}",
        "message": "@{{ $('Mattermost: trigger').item.json.body.user_name }} :hourglass: *Production release* for `={{ $('Slack: trigger').item.json.text }}`\nVerifying rm:go...",
        "otherOptions": {}
      },
      "id": "ack-17",
      "name": "Mattermost: production release started",
      "type": "n8n-nodes-base.mattermost",
      "typeVersion": 1,
      "position": [
        480,
        300
      ],
      "credentials": {
        "mattermostApi": {
          "id": "mm-creds",
          "name": "Mattermost SDLC Bot"
        }
      }
    },
    {
      "parameters": {
        "url": "={{ $env.GITLAB_URL }}/api/v4/projects/{{ $env.GITLAB_PROJECT_ID }}/issues/{{ $env.RELEASE_TICKET_ID }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "PRIVATE-TOKEN",
              "value": "={{ $env.GITLAB_TOKEN }}"
            }
          ]
        }
      },
      "id": "chk-rmgo",
      "name": "Check rm:go on release ticket",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        720,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const labels=$json.labels||[];\nreturn [{json:{safe:labels.includes('rm:go')}}];"
      },
      "id": "validate-go",
      "name": "rm:go confirmed?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "leftValue": "={{ $json.safe }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ]
        }
      },
      "id": "go-gate",
      "name": "rm:go present?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1200,
        300
      ]
    },
    {
      "parameters": {
        "channelId": "={{ $('Mattermost: trigger').item.json.body.channel_id }}",
        "message": "@{{ $('Mattermost: trigger').item.json.body.user_name }} :x: *Production blocked* — `rm:go` not found on release ticket.\nRun `/release_staging` first.",
        "otherOptions": {}
      },
      "id": "slack-no-go",
      "name": "Mattermost: production blocked",
      "type": "n8n-nodes-base.mattermost",
      "typeVersion": 1,
      "position": [
        1440,
        440
      ],
      "credentials": {
        "mattermostApi": {
          "id": "mm-creds",
          "name": "Mattermost SDLC Bot"
        }
      }
    },
    {
      "parameters": {
        "url": "={{ $env.GITLAB_URL }}/api/v4/projects/{{ $env.GITLAB_PROJECT_ID }}/merge_requests",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "source_branch",
              "value": "={{ 'promote/' + $('Slack: trigger').item.json.text }}"
            },
            {
              "name": "target_branch",
              "value": "main"
            },
            {
              "name": "title",
              "value": "={{ '[release] ' + $('Slack: trigger').item.json.text }}"
            },
            {
              "name": "labels",
              "value": "type:release"
            },
            {
              "name": "description",
              "value": "Release MR for `={{ $('Slack: trigger').item.json.text }}`. CI validates no rc versions."
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "PRIVATE-TOKEN",
              "value": "={{ $env.GITLAB_TOKEN }}"
            }
          ]
        }
      },
      "id": "create-mr",
      "name": "Create promote→main MR via GitLab API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        1440,
        200
      ]
    },
    {
      "parameters": {
        "channelId": "={{ $('Mattermost: trigger').item.json.body.channel_id }}",
        "message": "@{{ $('Mattermost: trigger').item.json.body.user_name }} :eyes: *Release MR created* — `{{ $json.web_url }}`\n\n*Your action:* review, approve, and merge to deploy to production.",
        "otherOptions": {}
      },
      "id": "slack-mr-ready",
      "name": "Mattermost: release MR ready",
      "type": "n8n-nodes-base.mattermost",
      "typeVersion": 1,
      "position": [
        1680,
        200
      ],
      "credentials": {
        "mattermostApi": {
          "id": "mm-creds",
          "name": "Mattermost SDLC Bot"
        }
      }
    }
  ],
  "connections": {
    "Mattermost: trigger": {
      "main": [
        [
          {
            "node": "Mattermost: production release started",
            "type": "main",
            "index": 0
          },
          {
            "node": "Mattermost: ack command",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Mattermost: production release started": {
      "main": [
        [
          {
            "node": "Check rm:go on release ticket",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check rm:go on release ticket": {
      "main": [
        [
          {
            "node": "rm:go confirmed?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "rm:go confirmed?": {
      "main": [
        [
          {
            "node": "rm:go present?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "rm:go present?": {
      "main": [
        [
          {
            "node": "Create promote→main MR via GitLab API",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Mattermost: production blocked",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Create promote→main MR via GitLab API": {
      "main": [
        [
          {
            "node": "Mattermost: release MR ready",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [
    {
      "name": "production"
    },
    {
      "name": "phase-5"
    },
    {
      "name": "mattermost"
    }
  ]
}
