        "url": "={{ $env.OPENWEBUI_CALLBACK_URL }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "flow_id",
              "value": "={{ $json.body?.flow_id ?? $json.flow_id ?? '' }}"
            },
            {
              "name": "message",
              "value": "🚫 /release_production blocked — release ticket not at RM Go status"
            },
            {
              "name": "notes",
              "value": ""
            }
          ]
        }
      }
    },
    {
      "id": "f17000001-0000-0000-0000-000000000001",
      "name": "Find Edward's User ID",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        980,
        200
      ],
      "parameters": {
        "jsCode": "const res = await this.helpers.httpRequest({ method: 'GET', url: `${$env.GITLAB_URL}/api/v4/users?search=edwardlimkoksiong1994@gmail.com`, headers: { 'PRIVATE-TOKEN': $env.GITLAB_TOKEN }, json: true });\nconst user = Array.isArray(res) ? res[0] : null;\nreturn [{ json: { ...$json, edward_user_id: user ? user.id : null } }];"
      }
    },
    {
      "id": "0b27e754-868c-4d20-8a5a-147072921e7f",
      "name": "Create promote→main MR",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1120,
        200
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.GITLAB_URL }}/api/v4/projects/{{ $node['Webhook Trigger'].json.body.gitlab_project_id ?? $env.GITLAB_PROJECT_ID }}/merge_requests",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "PRIVATE-TOKEN",
              "value": "={{ $env.GITLAB_TOKEN }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "__json",
              "value": "={\"source_branch\":\"promote/{{ $env.RELEASE_VERSION }}\",\"target_branch\":\"main\",\"title\":\"[release] {{ $env.RELEASE_VERSION }}\",\"description\":\"## Ticket\\n{{ $env.KANEO_URL }}/task/{{ $node[\"Find Release Ticket\"].json.release_ticket_id }}\\n\\n## What's done\\nAll UAT + staging sign-offs passed (QA UAT Approved, Security Cleared, PO UAT Approved, Staging QA Passed, Staging Security Passed, RM Go — tracked as the release ticket's Kaneo status, not GitLab labels). Promotes rc images to full version v{{ $env.RELEASE_VERSION }} by retag, no rebuild.\\n\\n## Proof of success\\nSee release ticket for k6/ZAP staging confirmation reports and go/no-go assessment.\\n\\n## Potential risk\\nSee release ticket's rollback target and monitoring thresholds.\",\"labels\":\"type:release\",\"assignee_id\":{{ $node[\"Find Edward's User ID\"].json.edward_user_id }},\"reviewer_ids\":[{{ $node[\"Find Edward's User ID\"].json.edward_user_id }}]}"
            }
          ]
        }
      }
