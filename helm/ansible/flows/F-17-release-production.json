      "typeVersion": 1,
      "position": [
        460,
        300
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\"status\":\"accepted\"}"
      }
    },
    {
      "id": "40bb0ef7-c057-436b-b123-c9de5c9d2271",
      "name": "rm:go Safeguard",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
        300
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $env.GITLAB_URL }}/api/v4/projects/{{ $env.GITLAB_PROJECT_ID }}/issues/{{ $env.RELEASE_TICKET_ID }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "PRIVATE-TOKEN",
              "value": "={{ $env.GITLAB_TOKEN }}"
            }
          ]
        }
      }
    },
    {
      "id": "457bfee4-1b22-4ab0-b34a-b6f18184f771",
      "name": "rm:go label present?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        900,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "leftValue": "={{ $json.labels.includes('rm:go') }}",
            "operation": "equals",
            "rightValue": "true"
          }
        }
      }
    },
    {
      "id": "3e5da2ec-23b6-4643-8d13-fa95a32f1c7f",
      "name": "Notify: Production blocked",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1120,
        400
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.OPENWEBUI_CALLBACK_URL }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "flow_id",
              "value": "={{ $json.flow_id ?? '' }}"
            },
            {
              "name": "message",
              "value": "\ud83d\udeab /release_production blocked \u2014 rm:go label missing"
            },
            {
              "name": "notes",
              "value": ""
            }
          ]
        }
      }
    },
    {
      "id": "0b27e754-868c-4d20-8a5a-147072921e7f",
      "name": "Create promote\u2192main MR",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1120,
        200
      ],
      "parameters": {
        "method": "POST",
