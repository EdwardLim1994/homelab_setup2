{
  "name": "F-09 Version Built (CI Webhook)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "ci-version-built",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "wh-09",
      "name": "Webhook: ci-version-built",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const dag=$workflow.staticData.dagState||{};\ndag.builtImages=dag.builtImages||{};\ndag.builtImages[$json.body.service]={rcTag:$json.body.rc_tag,image:$json.body.image,builtAt:new Date().toISOString()};\n$workflow.staticData.dagState=dag;\nreturn [{json:{service:$json.body.service,rcTag:$json.body.rc_tag}}];"
      },
      "id": "upd-img",
      "name": "Update n8n state: rc image built",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        300
      ]
    },
    {
      "parameters": {
        "channelId": "={{ $env.MM_SDLC_CHANNEL }}",
        "message": ":package: RC image built — `{{ $json.body.service }}:{{ $json.body.rc_tag }}`\nArgoCD Image Updater deploying to SIT automatically.",
        "otherOptions": {}
      },
      "id": "slack-09",
      "name": "Mattermost: rc image built",
      "type": "n8n-nodes-base.mattermost",
      "typeVersion": 1,
      "position": [
        720,
        300
      ],
      "credentials": {
        "mattermostApi": {
          "id": "mm-creds",
          "name": "Mattermost SDLC Bot"
        }
      }
    }
  ],
  "connections": {
    "Webhook: ci-version-built": {
      "main": [
        [
          {
            "node": "Update n8n state: rc image built",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Update n8n state: rc image built": {
      "main": [
        [
          {
            "node": "Mattermost: rc image built",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [
    {
      "name": "development"
    },
    {
      "name": "phase-2"
    },
    {
      "name": "mattermost"
    }
  ]
}
