      ],
      "parameters": {
        "jsCode": "const names = [\"Security: UAT Scan\"];\nconst failures = names.flatMap(name => { const result = $(name).first().json; return result.failed === true || result.succeeded === false ? [`${name}: ${result.error || result.message || JSON.stringify(result)}`] : []; });\nif (failures.length) throw new Error(`Child flow failed: ${failures.join(\"; \")}`);\nconst result = $input.first().json;\nlet report; try { report = JSON.parse(result.output || \"\"); } catch { report = {}; }\nreturn [{ json: { ...result, uat_security_cleared: report.status === \"cleared\" } }];"
      }
    }
