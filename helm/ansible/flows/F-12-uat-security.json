{
  "name": "F-12 UAT Security Stage",
  "nodes": [
    {
      "id": "85430670-4c10-42a6-9ef6-57f18f7683a1",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "parameters": {
        "path": "uat-security",
        "httpMethod": "POST",
        "responseMode": "onReceived",
        "responseData": "allEntries"
      },
      "webhookId": "a46cc09a-cd08-436e-9c07-c6adf5ee6e6f"
    },
    {
      "id": "cbc26af0-47a0-4816-a868-f8041b76c916",
      "name": "Notify: UAT Security running",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 300],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.OPENWEBUI_CALLBACK_URL }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "Content-Type", "value": "application/json" }]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "flow_id", "value": "={{ $json.flow_id ?? '' }}" },
            { "name": "message", "value": "🔐 UAT Security stage running" },
            { "name": "notes", "value": "" }
          ]
        }
      }
    },
    {
      "id": "b12000001-0000-0000-0000-000000000001",
      "name": "Security Input",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [900, 300],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            { "id": "1", "name": "role", "value": "security-engineer", "type": "string" },
            { "id": "2", "name": "prompt", "value": "=Run DAST and a dependency audit against the UAT environment for {{ $node['Webhook Trigger'].json.body.version }}. Output JSON only: {\"status\": \"cleared\"|\"blocked\", \"findings\": \"string\"}", "type": "string" },
            { "id": "3", "name": "story", "value": "={{ $node['Webhook Trigger'].json.body.version }}", "type": "string" }
          ]
        }
      }
    },
    {
      "id": "c597df3c-75f5-4741-b92f-596f81d49fa2",
      "name": "Security: UAT Scan",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.1,
      "position": [1080, 300],
      "parameters": {
        "source": "database",
        "workflowId": { "mode": "id", "value": "jAv16SAzGy9fA5G4" },
        "mode": "once"
      }
    },
    {
      "id": "67e07137-eaf7-46a6-9824-09911972c3c4",
      "name": "Security Cleared?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1300, 300],
      "parameters": {
        "conditions": {
          "options": {
            "leftValue": "={{ $json.output.includes('\"status\"') && $json.output.includes('\"cleared\"') }}",
            "operation": "equals",
            "rightValue": "true"
          }
        }
      }
    },
    {
      "id": "e23bbdf9-1b15-4db9-98c5-ef749da6215e",
      "name": "Label: security:cleared",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1520, 200],
      "parameters": {
        "method": "PUT",
        "url": "={{ $env.GITLAB_URL }}/api/v4/projects/{{ $env.GITLAB_PROJECT_ID }}/issues/{{ $env.RELEASE_TICKET_ID }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "PRIVATE-TOKEN", "value": "={{ $env.GITLAB_TOKEN }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [{ "name": "__json", "value": "={\"add_labels\":\"security:cleared\"}" }]
        }
      }
    },
    {
      "id": "e62ade73-9f21-46d1-983e-6e7ed652fe43",
      "name": "→ F-13 PO UAT",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1740, 200],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.N8N_WEBHOOK_BASE }}/uat-po",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "version", "value": "={{ $node['Webhook Trigger'].json.body.version }}" }
          ]
        }
      }
    },
    {
      "id": "eba2e308-8ffe-40e6-8289-22dc2abeea27",
      "name": "Notify: Security UAT blocked",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1520, 400],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.OPENWEBUI_CALLBACK_URL }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "Content-Type", "value": "application/json" }]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "flow_id", "value": "={{ $node['Webhook Trigger'].json.body.flow_id ?? '' }}" },
            { "name": "message", "value": "=🚨 UAT Security blocked — {{ $node['Security: UAT Scan'].json.output }}" },
            { "name": "notes", "value": "" }
          ]
        }
      }
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [[{ "node": "Notify: UAT Security running", "type": "main", "index": 0 }]]
    },
    "Notify: UAT Security running": {
      "main": [[{ "node": "Security Input", "type": "main", "index": 0 }]]
    },
    "Security Input": {
      "main": [[{ "node": "Security: UAT Scan", "type": "main", "index": 0 }]]
    },
    "Security: UAT Scan": {
      "main": [[{ "node": "Security Cleared?", "type": "main", "index": 0 }]]
    },
    "Security Cleared?": {
      "main": [
        [{ "node": "Label: security:cleared", "type": "main", "index": 0 }],
        [{ "node": "Notify: Security UAT blocked", "type": "main", "index": 0 }]
      ]
    },
    "Label: security:cleared": {
      "main": [[{ "node": "→ F-13 PO UAT", "type": "main", "index": 0 }]]
    }
  },
  "active": true,
  "tags": [],
  "settings": {
    "executionOrder": "v1"
  }
}
