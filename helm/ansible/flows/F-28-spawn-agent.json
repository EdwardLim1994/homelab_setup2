{
  "name": "F-28 Spawn / Despawn Agent Pod",
  "_comment": "Three ways in: /spawn-agent + /despawn-agent claim a generic slot from the omp-slot-N pool and clone a skillsRepo into it; /spawn-role + /despawn-role scale a pre-built per-role Deployment (omp-<role>, skill baked in via ConfigMap by the omp chart). Flows that need a specific role call /spawn-role.",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "spawn-agent",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "wh-spawn",
      "name": "Webhook: /spawn-agent",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        240,
        200
      ]
    },
    {
      "parameters": {
        "command": "cat /var/run/secrets/kubernetes.io/serviceaccount/token"
      },
      "id": "tok-spawn",
      "name": "K8s Token",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        460,
        200
      ]
    },
    {
      "parameters": {
        "url": "https://kubernetes.default.svc/apis/apps/v1/namespaces/omp/deployments",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "labelSelector",
              "value": "omp.slot=free"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $node[\"K8s Token\"].json.stdout.trim() }}"
            }
          ]
        },
        "options": {
          "allowUnauthorizedCerts": true
        }
      },
      "id": "list-free",
      "name": "List Free Slots",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        680,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "const body = $node['Webhook: /spawn-agent'].json.body || {};\nconst name = String(body.name || '').toLowerCase().replace(/[^a-z0-9-]/g, '').slice(0, 40);\nif (!name) throw new Error('body.name required (a-z0-9-)');\nconst skillsRepo = body.skillsRepo || 'https://github.com/dietrichgebert/ponytail';\nconst free = ($json.items || []).filter(d => (d.spec.replicas || 0) === 0);\nif (!free.length) throw new Error('no free omp slot — raise slots.count or despawn one');\nreturn [{ json: { slot: free[0].metadata.name, name, skillsRepo } }];"
      },
      "id": "pick-slot",
      "name": "Pick Slot",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        200
      ]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "=https://kubernetes.default.svc/apis/apps/v1/namespaces/omp/deployments/{{ $json.slot }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $node[\"K8s Token\"].json.stdout.trim() }}"
            },
            {
              "name": "Content-Type",
              "value": "application/strategic-merge-patch+json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ metadata: { labels: { 'omp.slot': $json.name } }, spec: { replicas: 1, template: { spec: { initContainers: [ { name: 'fetch-skills', args: ['clone','--depth','1', $json.skillsRepo, '/skills-src'] } ] } } } }) }}",
        "options": {
          "allowUnauthorizedCerts": true
        }
      },
      "id": "patch-up",
      "name": "Claim + Scale Up",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        1120,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "return [{ json: { spawned: $node['Pick Slot'].json.name, slot: $node['Pick Slot'].json.slot, service: `http://${$node['Pick Slot'].json.slot}.omp.svc:4096`, skillsRepo: $node['Pick Slot'].json.skillsRepo } }];"
      },
      "id": "resp-spawn",
      "name": "Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1340,
        200
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "despawn-agent",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "wh-despawn",
      "name": "Webhook: /despawn-agent",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        240,
        460
      ]
    },
    {
      "parameters": {
        "command": "cat /var/run/secrets/kubernetes.io/serviceaccount/token"
      },
      "id": "tok-despawn",
      "name": "K8s Token (despawn)",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        460,
        460
      ]
    },
    {
      "parameters": {
        "jsCode": "const body = $node['Webhook: /despawn-agent'].json.body || {};\nconst name = String(body.name || body.slot || '').toLowerCase().replace(/[^a-z0-9-]/g, '');\nif (!name) throw new Error('body.name or body.slot required');\nreturn [{ json: { name } }];"
      },
      "id": "despawn-arg",
      "name": "Despawn Arg",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        460
      ]
    },
    {
      "parameters": {
        "url": "https://kubernetes.default.svc/apis/apps/v1/namespaces/omp/deployments",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "labelSelector",
              "value": "=omp.slot={{ $json.name }}"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $node[\"K8s Token (despawn)\"].json.stdout.trim() }}"
            }
          ]
        },
        "options": {
          "allowUnauthorizedCerts": true
        }
      },
      "id": "find-claimed",
      "name": "Find Claimed Slot",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        900,
        460
      ]
    },
    {
      "parameters": {
        "jsCode": "const items = $json.items || [];\nif (!items.length) throw new Error('no slot labelled omp.slot=' + $node['Despawn Arg'].json.name);\nreturn [{ json: { slot: items[0].metadata.name } }];"
      },
      "id": "despawn-pick",
      "name": "Resolve Slot",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        460
      ]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "=https://kubernetes.default.svc/apis/apps/v1/namespaces/omp/deployments/{{ $json.slot }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $node[\"K8s Token (despawn)\"].json.stdout.trim() }}"
            },
            {
              "name": "Content-Type",
              "value": "application/strategic-merge-patch+json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ metadata: { labels: { 'omp.slot': 'free' } }, spec: { replicas: 0 } }) }}",
        "options": {
          "allowUnauthorizedCerts": true
        }
      },
      "id": "patch-down",
      "name": "Release + Scale Down",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        1340,
        460
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "spawn-role",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "wh-spawn-role",
      "name": "Webhook: /spawn-role",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        240,
        720
      ]
    },
    {
      "parameters": {
        "command": "cat /var/run/secrets/kubernetes.io/serviceaccount/token"
      },
      "id": "tok-spawn-role",
      "name": "K8s Token (role)",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        460,
        720
      ]
    },
    {
      "parameters": {
        "jsCode": "// ponytail: allowlist mirrors helm/omp/values.yaml `roles:` — n8n\n// can't read the chart. Keep in sync, or a typo'd role scales nothing.\nconst ROLES = ['backend-developer','data-engineer','devops-engineer','frontend-developer','product-owner','project-manager','qa-engineer','release-manager','security-engineer','solution-architect','tech-lead','uiux-designer'];\nconst body = $node['Webhook: /spawn-role'].json.body || {};\nconst role = String(body.role || '').toLowerCase().replace(/[^a-z0-9-]/g, '');\nif (!ROLES.includes(role)) throw new Error(`body.role must be one of: ${ROLES.join(', ')}`);\nreturn [{ json: { role, deployment: `omp-${role}`, service: `http://omp-${role}.omp.svc:4096` } }];"
      },
      "id": "validate-role",
      "name": "Validate Role",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        720
      ]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "=https://kubernetes.default.svc/apis/apps/v1/namespaces/omp/deployments/{{ $json.deployment }}/scale",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $node[\"K8s Token (role)\"].json.stdout.trim() }}"
            },
            {
              "name": "Content-Type",
              "value": "application/merge-patch+json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ spec: { replicas: 1 } }) }}",
        "options": {
          "allowUnauthorizedCerts": true
        }
      },
      "id": "scale-up-role",
      "name": "Scale Up Role",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        900,
        720
      ]
    },
    {
      "parameters": {
        "jsCode": "// ponytail: exitCode:0 keeps the omp-era `$json.exitCode === 0` gate\n// checks working. Scales the pod up — does NOT run the task inside it yet.\n// service = direct Service DNS; litellm = same pod via the LiteLLM\n// pass-through route (central auth + request logging).\nconst v = $node['Validate Role'].json;\nreturn [{ json: {\n  spawned: v.role,\n  deployment: v.deployment,\n  service: v.service,\n  litellm: 'http://litellm.litellm.svc.cluster.local:4000/omp-' + v.role,\n  replicas: 1,\n  exitCode: 0\n} }];"
      },
      "id": "resp-spawn-role",
      "name": "Role Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        720
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "despawn-role",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "wh-despawn-role",
      "name": "Webhook: /despawn-role",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        240,
        960
      ]
    },
    {
      "parameters": {
        "command": "cat /var/run/secrets/kubernetes.io/serviceaccount/token"
      },
      "id": "tok-despawn-role",
      "name": "K8s Token (role despawn)",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        460,
        960
      ]
    },
    {
      "parameters": {
        "jsCode": "const ROLES = ['backend-developer','data-engineer','devops-engineer','frontend-developer','product-owner','project-manager','qa-engineer','release-manager','security-engineer','solution-architect','tech-lead','uiux-designer'];\nconst body = $node['Webhook: /despawn-role'].json.body || {};\nconst role = String(body.role || '').toLowerCase().replace(/[^a-z0-9-]/g, '');\nif (!ROLES.includes(role)) throw new Error(`body.role must be one of: ${ROLES.join(', ')}`);\nreturn [{ json: { role, deployment: `omp-${role}` } }];"
      },
      "id": "validate-role-d",
      "name": "Validate Role (despawn)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        960
      ]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "=https://kubernetes.default.svc/apis/apps/v1/namespaces/omp/deployments/{{ $json.deployment }}/scale",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $node[\"K8s Token (role despawn)\"].json.stdout.trim() }}"
            },
            {
              "name": "Content-Type",
              "value": "application/merge-patch+json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ spec: { replicas: 0 } }) }}",
        "options": {
          "allowUnauthorizedCerts": true
        }
      },
      "id": "scale-down-role",
      "name": "Scale Down Role",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        900,
        960
      ]
    }
  ],
  "connections": {
    "Webhook: /spawn-agent": {
      "main": [
