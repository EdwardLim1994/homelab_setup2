{
  "name": "F-11-uat-qa-complete",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "uat-qa-start",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "wh-F-11-uat-qa-complete",
      "name": "Webhook: uat-qa-start",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "command": "echo '{\"role\":\"qa-engineer\",\"task\":\"uat-stage-1\"}' > /tmp/F-11-uat-qa-complete.json && omp run --mode json --role smol @/tmp/F-11-uat-qa-complete.json"
      },
      "id": "spawn-F-11-uat-qa-complete",
      "name": "Spawn qa-engineer: uat-stage-1",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        480,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "leftValue": "={{ $json.exitCode }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "equals"
              }
            }
          ]
        }
      },
      "id": "pass-F-11-uat-qa-complete",
      "name": "Passed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        720,
        300
      ]
    },
    {
      "parameters": {
        "command": "glab issue update {{ $json.body.release_ticket_id }} --label-add 'qa:uat-approved'"
      },
      "id": "label-F-11-uat-qa-complete",
      "name": "Apply qa:uat-approved on release ticket",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        960,
        200
      ]
    },
    {
      "parameters": {
        "url": "={{ $env.N8N_WEBHOOK_BASE }}/security-scan-start",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "version",
              "value": "={{ $json.body.version }}"
            },
            {
              "name": "release_ticket_id",
              "value": "={{ $json.body.release_ticket_id }}"
            }
          ]
        }
      },
      "id": "next-F-11-uat-qa-complete",
      "name": "Trigger next stage",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        1200,
        200
      ]
    },
    {
      "parameters": {
        "channelId": "={{ $env.MM_SDLC_CHANNEL }}",
        "message": ":test_tube: *UAT QA* sign-off. Moving to next stage.",
        "otherOptions": {}
      },
      "id": "slack-pass2-F-11-uat-qa-complete",
      "name": "Mattermost: UAT QA sign-off",
      "type": "n8n-nodes-base.mattermost",
      "typeVersion": 1,
      "position": [
        1440,
        200
      ],
      "credentials": {
        "mattermostApi": {
          "id": "mm-creds",
          "name": "Mattermost SDLC Bot"
        }
      }
    },
    {
      "parameters": {
        "command": "glab issue create --title '[bugfix] qa-engineer finding in uat-stage-1' --label 'type:bugfix,role:qa-engineer' --milestone '{{ $json.body.version }}' --description 'Found during UAT.'"
      },
      "id": "bug-F-11-uat-qa-complete",
      "name": "Create bug ticket",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        960,
        440
      ]
    },
    {
      "parameters": {
        "channelId": "={{ $env.MM_SDLC_CHANNEL }}",
        "message": ":warning: *UAT QA finding* — bug ticket created. Fix and re-run UAT.",
        "otherOptions": {}
      },
      "id": "slack-bug-F-11-uat-qa-complete",
      "name": "Mattermost: UAT QA bug",
      "type": "n8n-nodes-base.mattermost",
      "typeVersion": 1,
