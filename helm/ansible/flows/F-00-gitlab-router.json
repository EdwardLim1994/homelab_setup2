{
  "name": "F-00 GitLab Event Router",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "gitlab-events",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "webhook-gitlab-events",
      "name": "Webhook: gitlab-events",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const secret = $env.GITLAB_WEBHOOK_SECRET;\nconst header = $json.headers['x-gitlab-token'];\nif (header !== secret) throw new Error('Invalid webhook secret');\nconst body = $json.body;\nconst eventType = $json.headers['x-gitlab-event'];\nconst obj = body.object_attributes || {};\nconst src = obj.source_branch || '';\nconst ref = body.ref || '';\nconst action = obj.action || obj.state || '';\nlet route = null;\nconst taskPrefixes = ['task/','api/','qa/','security/','devops/','bugfix/'];\nconst isTask = taskPrefixes.some(p => src.startsWith(p));\nif (eventType === 'Merge Request Hook') {\n  if (action === 'open' || action === 'reopen') { if (isTask) route='task-mr-opened'; }\n  else if (action === 'merge') {\n    if (isTask) route='task-mr-merged';\n    else if (src.startsWith('us/')) route='story-mr-merged';\n    else if (src.startsWith('promote/')) route='release-mr-merged';\n    else if (src.startsWith('revert-')) route='revert-mr-merged';\n  }\n} else if (eventType === 'Pipeline Hook') {\n  const status = body.object_attributes?.status;\n  if (status === 'success') {\n    if (ref.startsWith('promote/')) route='ci-staging-deployed';\n    else if (ref === 'main') route='ci-production-deployed';\n    else if (ref.startsWith('us/')) route='ci-version-built';\n  }\n}\nreturn [{ json: { ...body, _route: route, _event: eventType, _src: src, _ref: ref } }];"
      },
      "id": "detect-route",
      "name": "Verify token + detect route",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        300
      ]
    },
    {
      "parameters": {
        "dataType": "string",
        "value1": "={{ $json._route }}",
        "rules": {
          "rules": [
            {
              "value2": "task-mr-opened"
            },
            {
              "value2": "task-mr-merged"
            },
            {
              "value2": "story-mr-merged"
            },
            {
              "value2": "release-mr-merged"
            },
            {
              "value2": "revert-mr-merged"
            },
            {
              "value2": "ci-version-built"
            },
            {
              "value2": "ci-staging-deployed"
            },
            {
              "value2": "ci-production-deployed"
            }
          ]
        },
        "fallbackOutput": "extra"
      },
      "id": "route-switch",
      "name": "Route by event + branch",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [
        720,
        300
      ]
    },
    {
      "parameters": {
        "url": "={{ $env.N8N_WEBHOOK_BASE }}/gitlab-mr-opened",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "payload",
              "value": "={{ JSON.stringify($json) }}"
            }
          ]
        }
      },
