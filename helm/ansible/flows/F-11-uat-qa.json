      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 300],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.OPENWEBUI_CALLBACK_URL }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "Content-Type", "value": "application/json" }]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "flow_id", "value": "={{ $json.body?.flow_id ?? $json.flow_id ?? '' }}" },
            { "name": "message", "value": "🧪 UAT QA stage running" },
            { "name": "notes", "value": "" }
          ]
        }
      }
    },
    {
      "id": "b11000001-0000-0000-0000-000000000001",
      "name": "QA Input",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [900, 300],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            { "id": "1", "name": "role", "value": "qa-engineer", "type": "string" },
            { "id": "2", "name": "prompt", "value": "=Run the full UAT test suite against the UAT environment for {{ $node['Webhook Trigger'].json.body.version }} — functional pass/fail plus a load/performance test (response times under representative concurrent load, error rate under load). UAT is now the only environment performance testing runs against (no separate QA/staging cluster). Output JSON only: {\"pass\": true|false, \"coverage\": \"string\", \"performance\": {\"p95_ms\": number, \"error_rate\": number, \"notes\": \"string\"}}", "type": "string" },
            { "id": "3", "name": "story", "value": "={{ $node['Webhook Trigger'].json.body.version }}", "type": "string" }
          ]
        }
      }
    },
    {
      "id": "db07fada-4a52-4a73-837e-954b1ab5db37",
      "name": "QA: UAT Test Suite",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.1,
      "position": [1080, 300],
      "parameters": {
        "source": "database",
        "workflowId": { "mode": "id", "value": "jAv16SAzGy9fA5G4" },
        "mode": "once"
      }
    },
    {
      "id": "c77b337c-e632-467b-8904-bac2f22bb6b7",
      "name": "QA Pass?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1300, 300],
      "parameters": {
        "conditions": {
          "options": {
            "leftValue": "={{ $json.output.includes('\"pass\"') && $json.output.includes('true') }}",
            "operation": "equals",
            "rightValue": "true"
          }
        }
      }
    },
    {
      "id": "03d59e9f-a54f-462e-8baa-ef1d0002026b",
      "name": "→ F-12 Security UAT",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1740, 200],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.N8N_WEBHOOK_BASE }}/uat-security",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "version", "value": "={{ $node['Webhook Trigger'].json.body.version }}" }
          ]
        }
      }
    },
    {
      "id": "7e12f7b9-659c-423b-8590-61c4f1f9f7d7",
