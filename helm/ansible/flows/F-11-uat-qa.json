        "headerParameters": {
          "parameters": [{ "name": "Content-Type", "value": "application/json" }]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "flow_id", "value": "={{ $node['Webhook Trigger'].json.body.flow_id ?? '' }}" },
            { "name": "message", "value": "=❌ UAT QA failed — {{ $node['QA: UAT Test Suite'].json.output }}" },
            { "name": "notes", "value": "" }
          ]
        }
      }
    }
  ],
  "connections": {
    "Webhook Trigger": {
