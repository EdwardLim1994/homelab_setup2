{
  "name": "F-22 /rollback-story",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "mm-rollback_story",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "slack-trigger",
      "name": "Mattermost: trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\"response_type\": \"ephemeral\", \"text\": \":hourglass_flowing_sand: Running `/rollback_story`...\"}"
      },
      "id": "mm-ack-slack-trigger",
      "name": "Mattermost: ack command",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        480,
        200
      ]
    },
    {
      "parameters": {
        "channelId": "={{ $('Mattermost: trigger').item.json.body.channel_id }}",
        "message": "@{{ $('Mattermost: trigger').item.json.body.user_name }} :hourglass: *Story rollback* for `{{ $json.text }}`\nChecking dependency graph...",
        "otherOptions": {}
      },
      "id": "ack-22",
      "name": "Mattermost: rollback-story started",
      "type": "n8n-nodes-base.mattermost",
      "typeVersion": 1,
      "position": [
        480,
        300
      ],
      "credentials": {
        "mattermostApi": {
          "id": "mm-creds",
          "name": "Mattermost SDLC Bot"
        }
      }
    },
    {
      "parameters": {
        "url": "={{ $env.GITLAB_URL }}/api/v4/projects/{{ $env.GITLAB_PROJECT_ID }}/issues/{{ $('Slack: trigger').item.json.text }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "PRIVATE-TOKEN",
              "value": "={{ $env.GITLAB_TOKEN }}"
            }
          ]
        }
      },
      "id": "verify-merged",
      "name": "Verify story is merged",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        720,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const labels=$json.labels||[];\nconst isMerged=labels.includes('merged-to-release');\nreturn [{json:{isMerged,hasDependents:false,storyId:$json.iid}}];"
      },
      "id": "dep-check",
      "name": "Check dependency graph",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "leftValue": "={{ $json.hasDependents }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ]
        }
      },
      "id": "dep-gate",
      "name": "Dependent stories?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1200,
        300
      ]
    },
    {
      "parameters": {
        "channelId": "={{ $('Mattermost: trigger').item.json.body.channel_id }}",
        "message": "@{{ $('Mattermost: trigger').item.json.body.user_name }} :warning: *Cascade warning* — other stories depend on GL-`{{ $json.storyId }}`.\nConfirm scope before proceeding. Reply to confirm.",
        "otherOptions": {}
      },
      "id": "cascade-warn",
      "name": "Mattermost: cascade warning",
      "type": "n8n-nodes-base.mattermost",
      "typeVersion": 1,
      "position": [
        1440,
        160
      ],
      "credentials": {
        "mattermostApi": {
          "id": "mm-creds",
          "name": "Mattermost SDLC Bot"
        }
      }
    },
    {
      "parameters": {
        "url": "={{ $env.GITLAB_URL }}/api/v4/projects/{{ $env.GITLAB_PROJECT_ID }}/merge_requests",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "source_branch",
              "value": "={{ 'revert-GL-' + $('Slack: trigger').item.json.text + '/' + $env.RELEASE_VERSION }}"
            },
            {
              "name": "target_branch",
              "value": "={{ 'release/' + $env.RELEASE_VERSION }}"
            },
            {
              "name": "title",
              "value": "={{ '[revert] GL-' + $('Slack: trigger').item.json.text + ' from ' + $env.RELEASE_VERSION }}"
            },
            {
              "name": "description",
              "value": "Story rollback revert MR."
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "PRIVATE-TOKEN",
              "value": "={{ $env.GITLAB_TOKEN }}"
            }
          ]
        }
      },
      "id": "create-revert-mr",
      "name": "Create revert MR on release branch",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        1440,
        440
      ]
    },
    {
      "parameters": {
        "command": "=echo '{\"role\":\"tech-lead\",\"task\":\"review-revert-mr\",\"story_id\":\"{{ $('Slack: trigger').item.json.text }}\"}' > /tmp/tl-rv.json && omp run --mode json --role slow @/tmp/tl-rv.json"
      },
      "id": "tl-review",
      "name": "TL Pod: review revert MR",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        1680,
        440
      ]
    },
    {
      "parameters": {
        "channelId": "={{ $('Mattermost: trigger').item.json.body.channel_id }}",
        "message": "@{{ $('Mattermost: trigger').item.json.body.user_name }} :eyes: *Revert MR ready* — GL-`{{ $('Slack: trigger').item.json.text }}`\nTL reviewed. Merge the revert MR to defer this story.\n<{{ $json.web_url }}|View revert MR>",
        "otherOptions": {}
      },
      "id": "slack-revert-ready",
      "name": "Mattermost: revert MR ready for review",
      "type": "n8n-nodes-base.mattermost",
      "typeVersion": 1,
      "position": [
        1920,
        440
      ],
      "credentials": {
        "mattermostApi": {
          "id": "mm-creds",
          "name": "Mattermost SDLC Bot"
        }
      }
    }
  ],
  "connections": {
    "Mattermost: trigger": {
      "main": [
        [
          {
            "node": "Mattermost: rollback-story started",
            "type": "main",
            "index": 0
          },
          {
            "node": "Mattermost: ack command",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Mattermost: rollback-story started": {
      "main": [
        [
          {
            "node": "Verify story is merged",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Verify story is merged": {
      "main": [
        [
          {
            "node": "Check dependency graph",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check dependency graph": {
      "main": [
        [
          {
            "node": "Dependent stories?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Dependent stories?": {
      "main": [
        [
          {
            "node": "Mattermost: cascade warning",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Create revert MR on release branch",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Create revert MR on release branch": {
      "main": [
        [
          {
            "node": "TL Pod: review revert MR",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "TL Pod: review revert MR": {
      "main": [
        [
          {
            "node": "Mattermost: revert MR ready for review",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [
    {
      "name": "production"
    },
    {
      "name": "phase-5"
    },
    {
      "name": "mattermost"
    }
  ]
}
