{
  "name": "F-22 /rollback_story",
  "nodes": [
    {
      "id": "fad1f1c4-8a4f-4088-8a6f-09f0aa09e331",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "parameters": {
        "path": "rollback-story",
        "httpMethod": "POST",
        "responseMode": "onReceived",
        "responseData": "allEntries"
      },
      "webhookId": "a4896378-3cae-46f1-863a-2e798a4879d8"
    },
    {
      "id": "9e00da93-455c-423e-9e11-d7f91658e720",
      "name": "Respond OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        460,
        300
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\"status\":\"accepted\"}"
      }
    },
    {
      "id": "09ac856d-3d58-4321-b07d-ce705b364c9a",
      "name": "Notify: Story rollback started",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.OPENWEBUI_CALLBACK_URL }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "flow_id",
              "value": "={{ $json.flow_id ?? '' }}"
            },
            {
              "name": "message",
              "value": "\u23ea Story rollback initiated for {{ $json.body.story_id }}"
            },
            {
              "name": "notes",
              "value": ""
            }
          ]
        }
      }
    },
    {
      "id": "47c483dc-4cf8-4115-87b0-c692f9512572",
      "name": "TL: Dependency Check",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        900,
        300
      ],
      "parameters": {
        "command": "omp --role tech-lead --model slow --project {{ $env.REPO_DIR }} --prompt 'Check if story {{ $json.body.story_id }} has downstream dependents already merged. Output: safe/blocked with list.' --non-interactive"
      }
    },
    {
      "id": "26772671-af9c-4ef6-b1cb-86213621a230",
      "name": "Safe to Revert?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1120,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "leftValue": "={{ JSON.parse($json.stdout).status }}",
            "operation": "equals",
            "rightValue": "safe"
          }
        }
      }
    },
    {
      "id": "6eec7698-ac02-4554-b95e-15786702d88e",
      "name": "TL: Open Revert MR",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        1340,
        200
      ],
      "parameters": {
        "command": "opencode --role tech-lead --model sonnet --prompt 'Open revert MR for us/{{ $json.body.story_id }} via glab. Notify Edward for merge.' --non-interactive"
      }
    },
    {
      "id": "18aa5a88-e841-418f-ac64-474d92749e96",
      "name": "Notify: Revert MR ready",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1560,
        200
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.OPENWEBUI_CALLBACK_URL }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "flow_id",
              "value": "={{ $json.flow_id ?? '' }}"
            },
            {
              "name": "message",
              "value": "\ud83d\udc64 Revert MR ready \u2014 Edward please merge to complete rollback"
            },
            {
              "name": "notes",
              "value": ""
            }
          ]
        }
      }
    },
    {
      "id": "f7e91a1d-f23f-450b-81f7-f2dc6a064ed8",
      "name": "Notify: Rollback blocked",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1340,
        400
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.OPENWEBUI_CALLBACK_URL }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "flow_id",
              "value": "={{ $json.flow_id ?? '' }}"
            },
            {
              "name": "message",
              "value": "\ud83d\udeab Story rollback blocked \u2014 dependents found: {{ JSON.parse($node['TL: Dependency Check'].json.stdout).list }}"
            },
            {
              "name": "notes",
              "value": ""
            }
          ]
        }
      }
    }
  ],
