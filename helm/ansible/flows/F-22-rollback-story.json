    {
      "id": "bbd7e234-6344-47ca-89a7-851bdea51f0e",
      "name": "Assert Dependency Check",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1240,
        300
      ],
      "parameters": {
        "jsCode": "const names = [\"TL: Dependency Check\"];\nconst failures = names.flatMap(name => { const result = $(name).first().json; return result.failed === true || result.succeeded === false ? [`${name}: ${result.error || result.message || JSON.stringify(result)}`] : []; });\nif (failures.length) throw new Error(`Child flow failed: ${failures.join(\"; \")}`);\nconst result = $input.first().json;\nlet report; try { report = JSON.parse(result.output || \"\"); } catch { report = {}; }\nreturn [{ json: { ...result, safe_to_revert: report.status === \"safe\" } }];"
      }
    },
    {
      "id": "1e8cff70-82a8-40b5-90a2-fb5dc9465237",
      "name": "Assert Revert MR",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1880,
        300
      ],
      "parameters": {
        "jsCode": "const names = [\"TL: Open Revert MR\"];\nconst failures = names.flatMap(name => {\n  const result = $(name).first().json;\n  return result.failed === true || result.succeeded === false ? [`${name}: ${result.error || result.message || JSON.stringify(result)}`] : [];\n});\nif (failures.length) throw new Error(`Child flow failed: ${failures.join(\"; \")}`);\nreturn $input.all();"
      }
    }
