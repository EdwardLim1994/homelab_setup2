      "typeVersion": 3,
      "position": [
        680,
        300
      ],
      "parameters": {
        "mode": "rules",
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "leftValue": "={{ $json.body.action }}",
                  "operation": "equals",
                  "rightValue": "wake"
                }
              },
              "outputKey": "wake"
            },
            {
              "conditions": {
                "options": {
                  "leftValue": "={{ $json.body.action }}",
                  "operation": "equals",
                  "rightValue": "sleep"
                }
              },
              "outputKey": "sleep"
            }
          ]
        }
      }
    },
    {
      "id": "79e04b85-1fa7-40b2-b7f3-044e08807cf6",
      "name": "kubectl: Scale Up",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        900,
        200
      ],
      "parameters": {
        "command": "=kubectl scale deploy --all --replicas=1 -n {{ $node['Webhook Trigger'].json.body.deploy_namespace ?? $env.DEPLOY_NAMESPACE }} --context=k3d-{{ $json.body.cluster }} && kubectl wait --for=condition=available deployment --all -n {{ $node['Webhook Trigger'].json.body.deploy_namespace ?? $env.DEPLOY_NAMESPACE }} --timeout=180s --context=k3d-{{ $json.body.cluster }}"
      }
    },
    {
      "id": "ba42f8d6-7b37-40f0-94aa-1c024c22f67c",
