{
  "name": "F-27 Cluster Lifecycle",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "cluster-wake",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "wh-wake",
      "name": "Webhook: cluster-wake",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "cluster-sleep",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "wh-sleep",
      "name": "Webhook: cluster-sleep",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "leftValue": "={{ $json.body.cluster }}",
              "rightValue": "sit",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ]
        }
      },
      "id": "not-sit-wake",
      "name": "Not SIT? (always on)",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        480,
        200
      ]
    },
    {
      "parameters": {
        "command": "=kubectl scale deployment --all --replicas=1 -n {{ $json.body.cluster }} && kubectl rollout status deployment --all -n {{ $json.body.cluster }}"
      },
      "id": "wake-cmd",
      "name": "kubectl scale up: wake cluster",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        720,
        200
      ]
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "leftValue": "={{ $json.body.cluster }}",
              "rightValue": "production",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ]
        }
      },
      "id": "not-prod-sleep",
      "name": "Not production? (never sleeps)",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        480,
        440
      ]
    },
    {
      "parameters": {
        "command": "=kubectl scale deployment --all --replicas=0 -n {{ $json.body.cluster }}-server && kubectl scale deployment --all --replicas=0 -n {{ $json.body.cluster }}-frontend"
      },
      "id": "sleep-cmd",
      "name": "kubectl scale down: sleep cluster",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        720,
        440
      ]
    },
    {
      "parameters": {
        "jsCode": "const dag=$workflow.staticData.dagState||{};\ndag.clusterStates=dag.clusterStates||{};\ndag.clusterStates[$json.body.cluster]=$json.body.cluster?'awake':'sleeping';\ndag.lastActivity=new Date().toISOString();\n$workflow.staticData.dagState=dag;\nreturn [{json:{updated:true,cluster:$json.body.cluster}}];"
      },
      "id": "upd-state",
      "name": "Update cluster state in DAG",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        320
      ]
    },
    {
      "parameters": {
        "channelId": "={{ $env.MM_SDLC_CHANNEL }}",
        "message": "={{ $json.body.cluster === 'cluster-wake' ? ':green_circle:' : ':zzz:' }} *Cluster `{{ $json.body.cluster }}`* state updated.",
        "otherOptions": {}
      },
      "id": "slack-cluster",
      "name": "Mattermost: cluster state updated",
      "type": "n8n-nodes-base.mattermost",
      "typeVersion": 1,
      "position": [
        1200,
        320
      ],
      "credentials": {
        "mattermostApi": {
          "id": "mm-creds",
          "name": "Mattermost SDLC Bot"
        }
      }
    }
  ],
  "connections": {
    "Webhook: cluster-wake": {
      "main": [
        [
          {
            "node": "Not SIT? (always on)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Not SIT? (always on)": {
      "main": [
        [
          {
            "node": "kubectl scale up: wake cluster",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "kubectl scale up: wake cluster": {
      "main": [
        [
          {
            "node": "Update cluster state in DAG",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Webhook: cluster-sleep": {
      "main": [
        [
          {
            "node": "Not production? (never sleeps)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Not production? (never sleeps)": {
      "main": [
        [
          {
            "node": "kubectl scale down: sleep cluster",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "kubectl scale down: sleep cluster": {
      "main": [
        [
          {
            "node": "Update cluster state in DAG",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Update cluster state in DAG": {
      "main": [
        [
          {
            "node": "Mattermost: cluster state updated",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [
    {
      "name": "cross-cutting"
    },
    {
      "name": "mattermost"
    }
  ]
}
