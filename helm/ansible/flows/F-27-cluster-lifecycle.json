{
  "name": "F-27 Cluster Lifecycle",
  "nodes": [
    {
      "id": "7bbb5a9d-514f-4fcd-a13d-5a5096eb05bc",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "parameters": {
        "path": "cluster-lifecycle",
        "httpMethod": "POST",
        "responseMode": "onReceived",
        "responseData": "allEntries"
      },
      "webhookId": "8ae0992e-3a28-46f4-91e8-01d980907f1b"
    },
    {
      "id": "3577a959-a560-4bf1-9492-d9b6075873b7",
      "name": "Respond OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        460,
        300
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\"status\":\"accepted\"}"
      }
    },
    {
      "id": "e39e2cb4-1ffd-4765-b6a4-950d36a4a3a0",
      "name": "Action?",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [
        680,
        300
      ],
      "parameters": {
        "mode": "rules",
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "leftValue": "={{ $json.body.action }}",
                  "operation": "equals",
                  "rightValue": "wake"
                }
              },
              "outputKey": "wake"
            },
            {
              "conditions": {
                "options": {
                  "leftValue": "={{ $json.body.action }}",
                  "operation": "equals",
                  "rightValue": "sleep"
                }
              },
              "outputKey": "sleep"
            }
          ]
        }
      }
    },
    {
      "id": "79e04b85-1fa7-40b2-b7f3-044e08807cf6",
      "name": "ArgoCD: Scale Up",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        900,
        200
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.ARGOCD_URL }}/api/v1/applications/{{ $env.ARGOCD_PROJECT }}-{{ $json.body.cluster }}/sync",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.ARGOCD_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "revision",
              "value": "HEAD"
            }
          ]
        }
      }
    },
    {
      "id": "ba42f8d6-7b37-40f0-94aa-1c024c22f67c",
      "name": "kubectl: Scale Down",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        900,
        400
      ],
      "parameters": {
        "command": "kubectl scale deploy --all --replicas=0 -n {{ $json.body.cluster }} --context={{ $json.body.cluster }}-ctx"
      }
    },
    {
      "id": "a5c05c09-27ae-4c83-b4f4-7269e29d94a7",
      "name": "Notify: Cluster woken",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1120,
        200
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.OPENWEBUI_CALLBACK_URL }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "flow_id",
              "value": "={{ $json.flow_id ?? '' }}"
            },
            {
              "name": "message",
              "value": "\u2600\ufe0f {{ $json.body.cluster }} cluster woken"
            },
            {
              "name": "notes",
              "value": ""
            }
          ]
        }
      }
    },
    {
      "id": "af49003d-1c6a-488a-85be-342cb7b386df",
      "name": "Notify: Cluster sleeping",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1120,
        400
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.OPENWEBUI_CALLBACK_URL }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "flow_id",
              "value": "={{ $json.flow_id ?? '' }}"
            },
            {
              "name": "message",
              "value": "\ud83c\udf19 {{ $json.body.cluster }} cluster sleeping"
            },
            {
              "name": "notes",
              "value": ""
            }
          ]
        }
      }
    }
  ],
