{
  "name": "F-07 Story MR Opened",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "story-mr-open",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "wh-07",
      "name": "Webhook: story-mr-open",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "command": "=echo '{\"role\":\"tech-lead\",\"task\":\"open-story-mr\",\"story_id\":\"{{ $json.body.story_id }}\"}' > /tmp/smr.json && opencode run --print \"$(cat /tmp/smr.json)\""
      },
      "id": "tl-story-mr",
      "name": "TL opens story MR (opencode+glab)",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        480,
        300
      ]
    },
    {
      "parameters": {
        "command": "=sleep 30 && echo 'QA cluster deployment complete'"
      },
      "id": "wait-qa-deploy",
      "name": "Wait: CI deploys rc to QA cluster",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        720,
        300
      ]
    },
    {
      "parameters": {
        "command": "=echo '{\"role\":\"qa-engineer\",\"task\":\"story-testing\",\"story_id\":\"{{ $json.body.story_id }}\"}' > /tmp/qa-s.json && omp run --mode json --role smol @/tmp/qa-s.json"
      },
      "id": "spawn-qa",
      "name": "Spawn QA Pod: story-level testing",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        960,
        300
      ]
    },
    {
      "parameters": {
        "channelId": "={{ $env.MM_SDLC_CHANNEL }}",
        "message": ":eyes: *Story MR ready for your review* — `{{ $json.body.story_id }}`\nQA story-level tests running on QA cluster.\n\n*Your action:* review + approve + merge the story MR.",
        "otherOptions": {}
      },
      "id": "slack-07",
      "name": "Mattermost: story MR ready for review",
      "type": "n8n-nodes-base.mattermost",
      "typeVersion": 1,
      "position": [
        1200,
        300
      ],
      "credentials": {
        "mattermostApi": {
          "id": "mm-creds",
          "name": "Mattermost SDLC Bot"
        }
      }
    }
  ],
  "connections": {
    "Webhook: story-mr-open": {
      "main": [
