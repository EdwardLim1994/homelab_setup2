{
  "name": "F-04 Task MR Opened",
  "nodes": [
    {
      "id": "f7b685ac-b6b3-48a9-abbe-40447f4381d4",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "parameters": {
        "path": "gitlab-task-mr-opened",
        "httpMethod": "POST",
        "responseMode": "onReceived",
        "responseData": "allEntries"
      },
      "webhookId": "1bedb63f-c0bb-4844-8ac9-f02ab71fd289"
    },
    {
      "id": "19f5aa68-7bca-452d-9ac0-eb0148fb49a7",
      "name": "Respond OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        460,
        300
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\"status\":\"accepted\"}"
      }
    },
    {
      "id": "2af57f60-e829-44b7-86c2-c0b297b48990",
      "name": "Notify: Task MR opened",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.OPENWEBUI_CALLBACK_URL }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "flow_id",
              "value": "={{ $json.flow_id ?? '' }}"
            },
            {
              "name": "message",
              "value": "\ud83d\udd0e Task MR opened \u2014 TL review + CI parallel"
            },
            {
              "name": "notes",
              "value": ""
            }
          ]
        }
      }
    },
    {
      "id": "daddf81f-124d-4c3d-9762-6b66c98649cf",
      "name": "TL: MR Review",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        900,
        200
      ],
      "parameters": {
        "command": "omp --role tech-lead --model slow --project {{ $env.REPO_DIR }} --prompt 'Review MR {{ $json.object_attributes.iid }} against pseudocode. Check correctness, style, test coverage. Output: APPROVE or REQUEST_CHANGES with notes.' --non-interactive"
      }
    },
    {
      "id": "a0f3dfde-0892-429f-9fc9-96f2d31289d5",
      "name": "Wait CI Result",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1,
      "position": [
        900,
        400
      ],
      "parameters": {
        "resume": "webhook"
      }
    },
    {
      "id": "6d2aaa6d-9851-4042-afa4-ec3c7337ee11",
      "name": "Merge TL+CI",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [
        1120,
        300
      ],
      "parameters": {
        "mode": "waitForAll"
      }
    },
    {
      "id": "e4024f3c-704d-498f-8ae0-e3a7c504191a",
      "name": "All Passed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1340,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "leftValue": "={{ $json.tl_result }}",
            "operation": "equals",
            "rightValue": "APPROVE"
          }
        }
      }
    },
    {
      "id": "0005a06a-44ce-4e2e-a29f-72d5cf885594",
      "name": "GitLab: Approve MR",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1560,
        200
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.GITLAB_URL }}/api/v4/projects/{{ $env.GITLAB_PROJECT_ID }}/merge_requests/{{ $json.mr_iid }}/approve",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "PRIVATE-TOKEN",
              "value": "={{ $env.GITLAB_TOKEN }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        }
      }
    },
    {
      "id": "d0a7a36e-9e01-4236-8b03-c4f4505130d7",
      "name": "Retry < 3?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1560,
        400
      ],
      "parameters": {
        "conditions": {
          "options": {
            "leftValue": "={{ $json.retry_count ?? 0 }}",
            "operation": "smallerEqual",
            "rightValue": "2"
          }
        }
      }
    },
    {
      "id": "026275d2-92c9-4a4f-a9a8-888bbe28b92d",
      "name": "Notify: Review feedback",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1780,
        480
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.OPENWEBUI_CALLBACK_URL }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "flow_id",
              "value": "={{ $json.flow_id ?? '' }}"
            },
            {
              "name": "message",
              "value": "\ud83d\udd04 MR {{ $json.mr_iid }} needs changes \u2014 retry {{ $json.retry_count }}/3"
            },
            {
              "name": "notes",
              "value": ""
            }
          ]
        }
      }
    },
    {
      "id": "bca280de-b215-4aaf-b10b-4fb7c032d3bb",
      "name": "\u2192 Escalate",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1780,
        560
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.N8N_WEBHOOK_BASE }}/webhook/escalate",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "reason",
              "value": "MR {{ $json.mr_iid }} exceeded 3 review retries"
            }
          ]
        }
      }
    },
    {
      "id": "9f7b1556-3932-4a73-9cc3-c991ff062f64",
      "name": "Notify: MR approved",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1780,
        200
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.OPENWEBUI_CALLBACK_URL }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "flow_id",
              "value": "={{ $json.flow_id ?? '' }}"
            },
            {
              "name": "message",
              "value": "\u2705 Task MR {{ $json.mr_iid }} approved"
            },
            {
              "name": "notes",
              "value": ""
            }
          ]
        }
      }
    }
  ],
