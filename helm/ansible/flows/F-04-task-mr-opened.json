{
  "name": "F-04 Task MR Opened",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "gitlab-mr-opened",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "wh-04",
      "name": "Webhook: gitlab-mr-opened",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "leftValue": "={{ ['task/','api/','qa/','security/','devops/','bugfix/'].some(p=>$json.body.object_attributes.source_branch.startsWith(p)) }}",
              "rightValue": true,
              "operator": {
                "type": "number",
                "operation": "equals"
              }
            }
          ]
        }
      },
      "id": "is-task",
      "name": "Is task/api/qa/security/devops MR?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        480,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const dag=$workflow.staticData.dagState||{};\nconst mrId=$json.body.object_attributes.iid;\ndag.retryCounters=dag.retryCounters||{};\ndag.retryCounters[mrId]=0;\ndag.openMRs=dag.openMRs||{};\ndag.openMRs[mrId]={branch:$json.body.object_attributes.source_branch,status:'open'};\n$workflow.staticData.dagState=dag;\nreturn [{json:{mrId,retryCount:0,branch:$json.body.object_attributes.source_branch,mrUrl:$json.body.object_attributes.url}}];"
      },
      "id": "reg-dag",
      "name": "Register MR + init retry counter",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        200
      ]
    },
    {
      "parameters": {
        "command": "=echo '{\"role\":\"tech-lead\",\"task\":\"mr-review\",\"mr_id\":\"{{ $json.body.object_attributes.iid }}\",\"mr_url\":\"{{ $json.body.object_attributes.url }}\"}' > /tmp/tl-rev.json && omp run --mode json --role slow @/tmp/tl-rev.json"
      },
      "id": "spawn-tl-review",
      "name": "Spawn TL Pod: MR review (omp slow+LSP+advisor)",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        960,
        160
      ]
    },
    {
      "parameters": {
        "url": "={{ $env.GITLAB_URL }}/api/v4/projects/{{ $json.body.project.id }}/merge_requests/{{ $json.body.object_attributes.iid }}/pipelines",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "per_page",
              "value": "1"
            }
          ]
        }
      },
      "id": "poll-ci",
      "name": "Poll CI pipeline status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        960,
        360
      ]
    },
    {
      "parameters": {
        "jsCode": "const tl=$node['Spawn TL Pod: MR review (omp slow+LSP+advisor)'].json.exitCode;\nconst ci=$node['Poll CI pipeline status'].json[0]?.status;\nreturn [{json:{ok:tl===0&&ci==='success',tl,ci,mrUrl:$('Webhook: gitlab-mr-opened').item.json.body.object_attributes.url}}];"
      },
      "id": "both-pass",
      "name": "Both CI + TL passed?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        260
      ]
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "leftValue": "={{ $json.ok }}",
              "rightValue": true,
              "operator": {
                "type": "number",
                "operation": "equals"
              }
            }
          ]
        }
      },
      "id": "pass-check",
      "name": "Both pass?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1440,
        260
      ]
    },
    {
      "parameters": {
        "command": "=glab mr merge {{ $('Webhook: gitlab-mr-opened').item.json.body.object_attributes.iid }} --auto-merge"
      },
      "id": "merge-mr",
      "name": "Tech Lead merges task MR via glab",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        1680,
        160
      ]
    },
    {
      "parameters": {
        "channelId": "={{ $env.MM_SDLC_CHANNEL }}",
        "message": ":merged: *Task MR merged* — `{{ $('Webhook: gitlab-mr-opened').item.json.body.object_attributes.source_branch }}`\nCI :white_check_mark: · TL review :white_check_mark:\n<{{ $('Webhook: gitlab-mr-opened').item.json.body.object_attributes.url }}|View MR>",
        "otherOptions": {}
      },
      "id": "slack-merged",
      "name": "Mattermost: task MR merged",
      "type": "n8n-nodes-base.mattermost",
      "typeVersion": 1,
      "position": [
        1920,
        160
      ],
      "credentials": {
        "mattermostApi": {
          "id": "mm-creds",
          "name": "Mattermost SDLC Bot"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const dag=$workflow.staticData.dagState||{};\nconst mrId=$('Webhook: gitlab-mr-opened').item.json.body.object_attributes.iid;\nconst count=(dag.retryCounters[mrId]||0)+1;\ndag.retryCounters[mrId]=count;\n$workflow.staticData.dagState=dag;\nreturn [{json:{escalate:count>=3,count,mrId}}];"
      },
      "id": "retry-counter",
      "name": "Increment retry counter",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1680,
        380
      ]
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "leftValue": "={{ $json.escalate }}",
              "rightValue": true,
              "operator": {
                "type": "number",
                "operation": "equals"
              }
            }
          ]
        }
      },
      "id": "escalate-chk",
      "name": "Escalate?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1920,
        380
      ]
    },
    {
      "parameters": {
        "channelId": "={{ $env.MM_SDLC_CHANNEL }}",
        "message": ":warning: *Fix required* on `{{ $('Webhook: gitlab-mr-opened').item.json.body.object_attributes.source_branch }}`\nCI or TL review needs attention. Developer: check inline comments and push a fix.\n<{{ $('Webhook: gitlab-mr-opened').item.json.body.object_attributes.url }}|View MR>",
        "otherOptions": {}
      },
      "id": "slack-fix",
      "name": "Mattermost: fix required",
      "type": "n8n-nodes-base.mattermost",
      "typeVersion": 1,
      "position": [
        2160,
        440
      ],
      "credentials": {
        "mattermostApi": {
          "id": "mm-creds",
          "name": "Mattermost SDLC Bot"
        }
      }
    },
    {
      "parameters": {
        "channelId": "={{ $env.MM_SDLC_CHANNEL }}",
        "message": ":rotating_light: *Escalation* — MR `{{ $('Webhook: gitlab-mr-opened').item.json.body.object_attributes.source_branch }}` has failed 3 fix attempts.\nManual review required.\n<{{ $('Webhook: gitlab-mr-opened').item.json.body.object_attributes.url }}|View MR>",
        "otherOptions": {}
      },
      "id": "slack-escalate-04",
      "name": "Mattermost: MR escalation",
      "type": "n8n-nodes-base.mattermost",
      "typeVersion": 1,
      "position": [
        2160,
        300
      ],
      "credentials": {
        "mattermostApi": {
          "id": "mm-creds",
          "name": "Mattermost SDLC Bot"
        }
      }
    }
  ],
