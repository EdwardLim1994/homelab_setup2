{
  "name": "F-19 Production Deployed",
  "nodes": [
    {
      "id": "f732978e-2db5-4b01-9094-cad52864492e",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "parameters": {
        "path": "production-deployed",
        "httpMethod": "POST",
        "responseMode": "onReceived",
        "responseData": "allEntries"
      },
      "webhookId": "f2d74deb-a248-48d0-97b8-f93be9a5ade4"
    },
    {
      "id": "d899a4d5-8cff-4530-aead-641e94b66c03",
      "name": "Respond OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        460,
        300
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\"status\":\"accepted\"}"
      }
    },
    {
      "id": "cff4c956-5c06-4912-82ba-b8f42ee1eddf",
      "name": "Notify: Production deployed",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.OPENWEBUI_CALLBACK_URL }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "flow_id",
              "value": "={{ $json.flow_id ?? '' }}"
            },
            {
              "name": "message",
              "value": "\ud83d\ude80 Production deployed \u2014 running smoke tests"
            },
            {
              "name": "notes",
              "value": ""
            }
          ]
        }
      }
    },
    {
      "id": "3f72ac1b-b047-4e0e-8fd7-d8fb5a316ce4",
      "name": "RM: Smoke Tests",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        900,
        300
      ],
      "parameters": {
        "command": "omp --role release-manager --model default --project {{ $env.REPO_DIR }} --prompt 'Run smoke test suite against production for {{ $json.body.version }}. Output: pass/fail + key metrics.' --non-interactive"
      }
    },
    {
      "id": "b9d92087-de88-4598-9823-93d378b07284",
      "name": "Smoke Pass?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1120,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "leftValue": "={{ JSON.parse($json.stdout).pass }}",
            "operation": "equals",
            "rightValue": "true"
          }
        }
      }
    },
    {
      "id": "ab88ce6a-cb54-4cc5-b95f-7d90685804fe",
      "name": "\u2192 F-20 Monitoring",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1340,
        200
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.N8N_WEBHOOK_BASE }}/webhook/monitoring-window",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "version",
              "value": "={{ $json.body.version }}"
            }
          ]
        }
      }
    },
    {
      "id": "33dff7c1-a45e-4baf-a08d-389062ef0b5d",
      "name": "Notify: Smoke failed \u2014 escalating",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1340,
        400
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.OPENWEBUI_CALLBACK_URL }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "flow_id",
              "value": "={{ $json.flow_id ?? '' }}"
            },
            {
              "name": "message",
              "value": "\ud83d\udea8 Smoke tests FAILED on production \u2014 escalating immediately"
            },
            {
              "name": "notes",
              "value": ""
            }
          ]
        }
      }
    },
    {
      "id": "968aac0b-40f9-4ae6-adaf-b47ec455be75",
      "name": "\u2192 Escalate",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1560,
        400
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.N8N_WEBHOOK_BASE }}/webhook/escalate",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "reason",
              "value": "Production smoke tests failed for {{ $json.body.version }}"
            }
          ]
        }
      }
    }
  ],
