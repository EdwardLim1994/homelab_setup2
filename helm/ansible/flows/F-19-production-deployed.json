{
  "name": "F-19 Production Deployed",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "ci-production-deployed",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "wh-19",
      "name": "Webhook: ci-production-deployed",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "command": "=glab issue comment {{ $json.body.release_ticket_id }} --message 'Production deployed: {{ $json.body.version }} at {{ new Date().toISOString() }}'"
      },
      "id": "upd-rt",
      "name": "Update release ticket: prod deployed",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        480,
        300
      ]
    },
    {
      "parameters": {
        "command": "=echo '{\"role\":\"qa-engineer\",\"task\":\"smoke-tests\",\"version\":\"{{ $json.body.version }}\",\"base_url\":\"https://production.{{ $json.body.project }}\"}' > /tmp/smoke.json && omp run --mode json --role smol @/tmp/smoke.json"
      },
      "id": "smoke",
      "name": "Run smoke tests from QA smoke plan ticket",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        720,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "leftValue": "={{ $json.exitCode }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "equals"
              }
            }
          ]
        }
      },
      "id": "smoke-pass",
      "name": "Smoke tests pass?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        960,
        300
      ]
    },
    {
      "parameters": {
        "channelId": "={{ $env.MM_SDLC_CHANNEL }}",
        "message": ":rotating_light: *Production smoke tests FAILED* — `{{ $json.body.version }}`\n{{ $json.stdout }}\n\nImmediate action required. Consider `/rollback {{ $json.body.version }}`.",
        "otherOptions": {}
      },
      "id": "slack-smoke-fail",
      "name": "Mattermost: smoke tests FAILED",
      "type": "n8n-nodes-base.mattermost",
      "typeVersion": 1,
      "position": [
        1200,
        440
      ],
      "credentials": {
        "mattermostApi": {
          "id": "mm-creds",
          "name": "Mattermost SDLC Bot"
        }
      }
    },
    {
      "parameters": {
        "command": "=echo '{\"role\":\"release-manager\",\"task\":\"production-monitoring\",\"version\":\"{{ $json.body.version }}\",\"release_ticket_id\":\"{{ $json.body.release_ticket_id }}\"}' > /tmp/rm-mon.json && omp run --mode json --role default @/tmp/rm-mon.json"
      },
      "id": "spawn-rm",
      "name": "Spawn RM: production monitoring window",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        1200,
        200
      ]
    },
    {
      "parameters": {
        "command": "=glab release create {{ $json.body.version }} --title 'Release {{ $json.body.version }}' --notes 'See wiki for release notes.'"
      },
      "id": "git-release",
      "name": "Create GitLab release object + schedule cleanup",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        1200,
        320
      ]
    },
    {
      "parameters": {
        "channelId": "={{ $env.MM_SDLC_CHANNEL }}",
        "message": ":white_check_mark: *Production deployed* — `{{ $json.body.version }}`\nSmoke tests passed. RM monitoring window active.\n\nYou'll be notified when the monitoring window completes.",
        "otherOptions": {}
      },
      "id": "slack-prod-up",
      "name": "Mattermost: production healthy — monitoring",
      "type": "n8n-nodes-base.mattermost",
      "typeVersion": 1,
      "position": [
        1440,
        260
      ],
      "credentials": {
        "mattermostApi": {
          "id": "mm-creds",
          "name": "Mattermost SDLC Bot"
        }
      }
    }
  ],
  "connections": {
    "Webhook: ci-production-deployed": {
      "main": [
        [
          {
            "node": "Update release ticket: prod deployed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Update release ticket: prod deployed": {
      "main": [
        [
          {
            "node": "Run smoke tests from QA smoke plan ticket",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run smoke tests from QA smoke plan ticket": {
      "main": [
        [
          {
            "node": "Smoke tests pass?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Smoke tests pass?": {
      "main": [
        [
          {
            "node": "Spawn RM: production monitoring window",
            "type": "main",
            "index": 0
          },
          {
            "node": "Create GitLab release object + schedule cleanup",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Mattermost: smoke tests FAILED",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Spawn RM: production monitoring window": {
      "main": [
        [
          {
            "node": "Mattermost: production healthy — monitoring",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Create GitLab release object + schedule cleanup": {
      "main": [
        [
          {
            "node": "Mattermost: production healthy — monitoring",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [
    {
      "name": "production"
    },
    {
      "name": "phase-5"
    },
    {
      "name": "mattermost"
    }
  ]
}
