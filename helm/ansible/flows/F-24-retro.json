        "command": "echo '{\"role\":\"pm\",\"task\":\"retro-synthesis\",\"version\":\"{{ $json.body.version }}\",\"tl_input\":\"{{ $node['Spawn TL Pod: code quality metrics (smart model)'].json.stdout }}\",\"qa_input\":\"{{ $node['Spawn QA Pod: test metrics'].json.stdout }}\",\"sec_input\":\"{{ $node['Spawn Security Pod: security metrics'].json.stdout }}\",\"rm_input\":\"{{ $node['Spawn RM Pod: release metrics'].json.stdout }}\"}' > /tmp/r-pm.json && omp -p \"$(cat /tmp/r-pm.json)\""
      },
      "id": "spawn-pm-retro",
      "name": "Spawn PM Pod: synthesise 11-section retro report",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
