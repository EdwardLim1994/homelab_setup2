{
  "name": "F-24 /retro",
  "nodes": [
    {
      "id": "01128661-b98e-41e0-8695-c091872ecb72",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "parameters": {
        "path": "retro",
        "httpMethod": "POST",
        "responseMode": "onReceived",
        "responseData": "allEntries"
      },
      "webhookId": "24ebe495-943d-482b-9d32-c57d92cb11ca"
    },
    {
      "id": "42754aeb-fe7c-44e5-ba70-6bc0314df99c",
      "name": "Respond OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        460,
        300
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\"status\":\"accepted\"}"
      }
    },
    {
      "id": "9bd2dfa9-1743-4d85-ad08-83329e3dc5cd",
      "name": "Notify: Retro started",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.OPENWEBUI_CALLBACK_URL }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "flow_id",
              "value": "={{ $json.flow_id ?? '' }}"
            },
            {
              "name": "message",
              "value": "\ud83d\udd04 Retro started \u2014 4 pods compiling in parallel"
            },
            {
              "name": "notes",
              "value": ""
            }
          ]
        }
      }
    },
    {
      "id": "0c7322e9-f26b-4356-a4f6-76e9ccc579a3",
      "name": "TL: Tech Retro",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        900,
        160
      ],
      "parameters": {
        "command": "omp --role tech-lead --model slow --project {{ $env.REPO_DIR }} --prompt 'Compile technical retrospective for {{ $json.body.version }}: code quality, architecture decisions, technical debt incurred, pseudocode accuracy.' --non-interactive"
      }
    },
    {
      "id": "298c9e5c-59ae-4481-9264-a11cc043a469",
      "name": "QA: Quality Retro",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        900,
        300
      ],
      "parameters": {
        "command": "omp --role qa-engineer --model smol --project {{ $env.REPO_DIR }} --prompt 'Compile QA retrospective for {{ $json.body.version }}: test coverage, defect escape rate, UAT findings.' --non-interactive"
      }
    },
    {
      "id": "4587422c-f0a2-4819-81e8-aa34af664a0a",
      "name": "Sec: Security Retro",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        900,
        440
      ],
      "parameters": {
        "command": "omp --role security-engineer --model smol --project {{ $env.REPO_DIR }} --prompt 'Compile security retrospective for {{ $json.body.version }}: vulnerabilities found, SAST/DAST findings, remediation time.' --non-interactive"
      }
    },
    {
      "id": "dca7ebc4-641e-4a8f-86d5-c93c6c7ae414",
      "name": "RM: Process Retro",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        900,
        580
      ],
      "parameters": {
        "command": "omp --role release-manager --model default --project {{ $env.REPO_DIR }} --prompt 'Compile release process retrospective for {{ $json.body.version }}: timeline, gate durations, go/no-go history.' --non-interactive"
      }
    },
    {
      "id": "1ebfe007-62ed-4fa7-bd56-a1262b89fc35",
      "name": "Merge 4 Retros",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [
        1120,
        360
      ],
      "parameters": {
        "mode": "waitForAll"
      }
    },
    {
      "id": "9c4eda4e-da49-464d-b76c-64a4a310f4e9",
      "name": "Notify: Synthesising",
      "type": "n8n-nodes-base.httpRequest",
