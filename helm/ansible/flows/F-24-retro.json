            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "flow_id",
              "value": "={{ $json.flow_id ?? '' }}"
            },
            {
              "name": "message",
              "value": "\ud83d\udcdd All retro inputs gathered \u2014 PM synthesising 11-section report"
            },
            {
              "name": "notes",
              "value": ""
            }
          ]
        }
      }
    },
    {
      "id": "2bbbccbc-3a9f-40eb-a4cc-d8b4e71b554b",
      "name": "PM: Synthesise Report",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        1560,
        360
      ],
      "parameters": {
        "command": "opencode --role pm --model haiku --prompt 'Synthesise 11-section retrospective report for {{ $json.body.version }} from TL, QA, Security, RM inputs. Create GitLab wiki page and post summary.' --non-interactive"
      }
    },
    {
      "id": "c5c0189c-3622-493b-8c22-8580b88558bf",
