      "typeVersion": 1,
      "position": [
        900,
        360
      ],
      "parameters": {
        "command": "omp --role data-engineer --model default --project {{ $env.REPO_DIR }} --prompt 'Analyse schema migration impact for {{ $json.body.version }}. Output: migrations needed, Apicurio schema changes.' --non-interactive"
      }
    },
    {
