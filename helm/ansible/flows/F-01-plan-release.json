{
  "name": "F-01 /plan-release",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "mm-plan_release",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "slack-trigger",
      "name": "Mattermost: trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\"response_type\": \"ephemeral\", \"text\": \":hourglass_flowing_sand: Running `/plan_release`...\"}"
      },
      "id": "mm-ack-slack-trigger",
      "name": "Mattermost: ack command",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        480,
        200
      ]
    },
    {
      "parameters": {
        "channelId": "={{ $('Mattermost: trigger').item.json.body.channel_id }}",
        "message": "@{{ $('Mattermost: trigger').item.json.body.user_name }} :hourglass: *Plan-release started* for `{{ $json.text }}`\nGate A: Architect + Data Engineer pods spawning...",
        "otherOptions": {}
      },
      "id": "ack-01",
      "name": "Mattermost: ack received",
      "type": "n8n-nodes-base.mattermost",
      "typeVersion": 1,
      "position": [
        480,
        300
      ],
      "credentials": {
        "mattermostApi": {
          "id": "mm-creds",
          "name": "Mattermost SDLC Bot"
        }
      }
    },
    {
      "parameters": {
        "command": "=echo '{\"role\":\"architect\",\"task\":\"gate-A-planning\",\"version\":\"{{ $json.text }}\"}' > /tmp/arch.json && omp run --mode json --role slow @/tmp/arch.json"
      },
      "id": "spawn-arch",
      "name": "Spawn Architect Pod (gate A)",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        720,
        200
      ]
    },
    {
      "parameters": {
        "command": "=echo '{\"role\":\"data-engineer\",\"task\":\"gate-A-planning\",\"version\":\"{{ $json.text }}\"}' > /tmp/de.json && omp run --mode json --role slow @/tmp/de.json"
      },
      "id": "spawn-de",
      "name": "Spawn Data Engineer Pod (gate A)",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        720,
        400
      ]
    },
    {
      "parameters": {
        "jsCode": "const a=$node['Spawn Architect Pod (gate A)'].json.exitCode;\nconst d=$node['Spawn Data Engineer Pod (gate A)'].json.exitCode;\nreturn [{json:{ok:a===0&&d===0}}];"
      },
      "id": "gate-a-check",
      "name": "Gate A complete?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        300
      ]
    },
    {
      "parameters": {
        "channelId": "={{ $('Mattermost: trigger').item.json.body.channel_id }}",
        "message": "@{{ $('Mattermost: trigger').item.json.body.user_name }} :white_check_mark: Gate A done. Spawning QA · Security · UX pods (gate B)...",
        "otherOptions": {}
      },
      "id": "ack-gate-a",
      "name": "Mattermost: gate A complete",
      "type": "n8n-nodes-base.mattermost",
      "typeVersion": 1,
      "position": [
        1200,
        300
      ],
      "credentials": {
        "mattermostApi": {
          "id": "mm-creds",
          "name": "Mattermost SDLC Bot"
        }
      }
    },
    {
      "parameters": {
        "command": "=echo '{\"role\":\"qa\",\"task\":\"gate-B-challenge\",\"version\":\"{{ $('Slack: trigger').item.json.text }}\"}' > /tmp/qa.json && omp run --mode json --role default @/tmp/qa.json"
      },
      "id": "spawn-qa",
      "name": "Spawn QA Pod (gate B)",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        1440,
        160
      ]
    },
    {
      "parameters": {
        "command": "=echo '{\"role\":\"security\",\"task\":\"gate-B-threat-model\",\"version\":\"{{ $('Slack: trigger').item.json.text }}\"}' > /tmp/sec.json && omp run --mode json --role default @/tmp/sec.json"
      },
      "id": "spawn-sec",
      "name": "Spawn Security Pod (gate B)",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        1440,
        300
      ]
    },
    {
      "parameters": {
        "command": "=echo '{\"role\":\"ui-ux\",\"task\":\"gate-B-ux-spec\",\"version\":\"{{ $('Slack: trigger').item.json.text }}\"}' > /tmp/ux.json && omp run --mode json --role default @/tmp/ux.json"
      },
      "id": "spawn-ux",
      "name": "Spawn UX Pod (gate B)",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        1440,
        440
      ]
    },
    {
      "parameters": {
        "jsCode": "const dag=$workflow.staticData;\ndag.revisions=(dag.revisions||0)+1;\nif(dag.revisions>=3) return [{json:{escalate:true,count:dag.revisions}}];\nreturn [{json:{escalate:false,count:dag.revisions}}];"
      },
      "id": "revision-check",
      "name": "Arch revision check (max 3)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1680,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "leftValue": "={{ $json.escalate }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ]
        }
      },
      "id": "escalate-if",
      "name": "Escalate?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1920,
        300
      ]
    },
    {
      "parameters": {
        "command": "=echo '{\"role\":\"pm\",\"task\":\"prd-scoring\",\"version\":\"{{ $('Slack: trigger').item.json.text }}\"}' > /tmp/pm.json && omp run --mode json --role slow @/tmp/pm.json"
      },
      "id": "spawn-pm",
      "name": "Spawn PM Pod (gate C)",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        2160,
        200
      ]
    },
    {
      "parameters": {
        "channelId": "={{ $('Mattermost: trigger').item.json.body.channel_id }}",
        "message": "@{{ $('Mattermost: trigger').item.json.body.user_name }} :rocket: *Sprint plan ready* for `{{ $('Slack: trigger').item.json.text }}`\nPRD + task breakdown complete. Review and run `/kickoff` when ready.",
        "otherOptions": {}
      },
      "id": "notify-done-01",
      "name": "Mattermost: plan-release complete",
      "type": "n8n-nodes-base.mattermost",
      "typeVersion": 1,
      "position": [
        2400,
        200
      ],
      "credentials": {
        "mattermostApi": {
          "id": "mm-creds",
          "name": "Mattermost SDLC Bot"
        }
      }
    },
    {
      "parameters": {
        "channelId": "={{ $('Mattermost: trigger').item.json.body.channel_id }}",
        "message": "@{{ $('Mattermost: trigger').item.json.body.user_name }} :warning: *Architecture revision limit reached* (3 rounds)\nManual review required before continuing. Check release ticket for details.",
        "otherOptions": {}
      },
      "id": "notify-escalate-01",
      "name": "Mattermost: escalation",
      "type": "n8n-nodes-base.mattermost",
      "typeVersion": 1,
      "position": [
        2160,
        440
      ],
      "credentials": {
        "mattermostApi": {
          "id": "mm-creds",
          "name": "Mattermost SDLC Bot"
        }
      }
    }
  ],
