{
  "name": "F-01 /plan_release",
  "nodes": [
    {
      "id": "640b5fba-4d3c-4c1e-9ca3-34b4278d83ad",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "parameters": {
        "path": "plan-release",
        "httpMethod": "POST",
        "responseMode": "onReceived",
        "responseData": "allEntries"
      },
      "webhookId": "aa24848e-da89-4e4d-b81c-6b167ad2b6d2"
    },
    {
      "id": "bf072095-3a82-4456-bd45-01a2f53dafb4",
      "name": "Respond OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        460,
        300
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\"status\":\"accepted\"}"
      }
    },
    {
      "id": "3e881a0f-4cee-4076-806c-97c39841b19f",
      "name": "Notify: Starting plan_release",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.OPENWEBUI_CALLBACK_URL }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "flow_id",
              "value": "={{ $json.flow_id ?? '' }}"
            },
            {
              "name": "message",
              "value": "\ud83d\udd0d plan_release started \u2014 Arch+DE gate A running"
            },
            {
              "name": "notes",
              "value": ""
            }
          ]
        }
      }
    },
    {
      "id": "3a736ffc-34c4-4ee2-acc7-b4c34d0dc4fc",
      "name": "Architect Analysis",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        900,
        240
      ],
      "parameters": {
        "command": "omp --role architect --model slow --project {{ $env.REPO_DIR }} --prompt 'Analyse release scope for {{ $json.body.version }}. Output: components affected, risk surface, API contract changes.' --non-interactive"
      }
    },
    {
      "id": "e754cd32-92b1-4106-948c-6c959f268573",
      "name": "DE Schema Impact",
