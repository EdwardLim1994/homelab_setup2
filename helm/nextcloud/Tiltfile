# ponytail: local_resource cmd cwd is this Tiltfile's own directory, not repo root
local_resource(
  'nextcloud-helm-deps',
  cmd='helm dependency update .',
  deps=['Chart.yaml'],
)

k8s_yaml(blob('apiVersion: v1\nkind: Namespace\nmetadata:\n  name: nextcloud'))

# ponytail: read from `.env` (see .env.example), same TF_VAR_-prefixed names
# terraform uses. Fixed dev fallbacks so `tilt up` works with zero setup —
# helm() is stateless `helm template`, a randomised password would desync from
# the already-initialised mariadb data dir / admin account on every reload.
nextcloud_db_password = os.getenv('TF_VAR_nextcloud_db_password', 'dev-nextcloud-db-password')
nextcloud_db_root_password = os.getenv('TF_VAR_nextcloud_db_root_password', 'dev-nextcloud-db-root-password')
nextcloud_admin_password = os.getenv('TF_VAR_nextcloud_admin_password', 'dev-nextcloud-admin-password')
nextcloud_oidc_client_id = os.getenv('TF_VAR_nextcloud_oidc_client_id', 'dev-nextcloud-oidc-client-id')
nextcloud_oidc_client_secret = os.getenv('TF_VAR_nextcloud_oidc_client_secret', 'dev-nextcloud-oidc-client-secret-not-for-prod-use')
tailnet_domain = os.getenv('TF_VAR_tailnet_domain', '') or os.getenv('TS_HOST', '').split('.', 1)[-1]
app_host = 'nextcloud.' + tailnet_domain if tailnet_domain else 'nextcloud.local'

rendered = str(helm(
  '.',
  name='nextcloud',
  namespace='nextcloud',
  set=[
    'nextcloud.nextcloud.password=' + nextcloud_admin_password,
    'nextcloud.externalDatabase.password=' + nextcloud_db_password,
    'mariadb.password=' + nextcloud_db_password,
    'mariadb.rootPassword=' + nextcloud_db_root_password,
  ],
))
# ponytail: postStart script + hostnames use placeholder tokens, not --set —
# it's one big multi-line shell string (see values.yaml comment).
rendered = rendered.replace('__NEXTCLOUD_OIDC_CLIENT_ID__', nextcloud_oidc_client_id)
rendered = rendered.replace('__NEXTCLOUD_OIDC_CLIENT_SECRET__', nextcloud_oidc_client_secret)
rendered = rendered.replace('__AUTHENTIK_URL__', 'https://authentik.' + tailnet_domain if tailnet_domain else 'https://authentik.local')
rendered = rendered.replace('__APP_URL__', 'https://' + app_host)
rendered = rendered.replace('__APP_HOST__', app_host)
k8s_yaml(blob(rendered))

k8s_resource(
  'nextcloud',
  port_forwards=['8082:8080'],
  resource_deps=['nextcloud-helm-deps'],
)

# ponytail: no-op until ADMIN_EMAIL has logged in via SSO at least once.
admin_email = os.getenv('TF_VAR_admin_email', 'edwardlimkoksiong1994@gmail.com')
local_resource(
  'nextcloud-promote-admin',
  cmd="kubectl exec -i -n nextcloud deploy/nextcloud -- env ADMIN_EMAIL=%s bash < promote-admin.sh" % admin_email,
  deps=['promote-admin.sh'],
  resource_deps=['nextcloud'],
)
