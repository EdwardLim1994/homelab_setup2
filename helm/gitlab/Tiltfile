# ponytail: local_resource cmd cwd is this Tiltfile's own directory, not repo root
local_resource(
  'gitlab-helm-deps',
  cmd='helm dependency update .',
  deps=['Chart.yaml'],
)

k8s_yaml(blob('apiVersion: v1\nkind: Namespace\nmetadata:\n  name: gitlab'))

# ponytail: read from `.env` (see .env.example), same TF_VAR_-prefixed
# names terraform uses — `source .env` before `tilt up` is the one place
# both tools' secrets come from. Falls back to the old dev-fixed values so
# `tilt up` still works with zero setup. Fixed (not regenerated) because
# any file change under the Tiltfile tree triggers a full reload, and a
# re-randomized db password would no longer match the already-initialized
# postgres data dir. Fine, throwaway cluster.
gitlab_root_password = os.getenv('TF_VAR_gitlab_root_password', 'dev-gitlab-root-password')
gitlab_db_password = os.getenv('TF_VAR_gitlab_db_password', 'dev-gitlab-db-password')

k8s_yaml(blob('''apiVersion: v1
kind: Secret
metadata:
  name: gitlab-initial-root-password
  namespace: gitlab
stringData:
  password: ''' + gitlab_root_password))

# ponytail: dev-fixed client_id/secret matching the Authentik OAuth2 provider
# created via the API (see homelab-ca-issuer-style one-time setup notes).
# Split endpoints because GitLab's backend (in-cluster) and the browser
# (Tailscale) can't reach Authentik the same way: the authorization redirect
# has to be browser-reachable, token/userinfo/jwks are backend-to-backend and
# use the in-cluster Service DNS. discovery:false since the two paths would
# otherwise return conflicting endpoint sets depending on which Host header
# hit Authentik first.
gitlab_oidc_client_id = os.getenv('TF_VAR_gitlab_oidc_client_id', 'dev-gitlab-oidc-client-id')
gitlab_oidc_client_secret = os.getenv('TF_VAR_gitlab_oidc_client_secret', 'dev-gitlab-oidc-client-secret-not-for-prod-use')
ts_host = os.getenv('TS_HOST', '')

k8s_yaml(blob('''apiVersion: v1
kind: Secret
metadata:
  name: gitlab-omniauth-authentik
  namespace: gitlab
stringData:
  provider: |
    name: openid_connect
    label: "Authentik"
    args:
      name: openid_connect
      scope: [openid, profile, email]
      response_type: code
      issuer: "http://authentik-server.authentik.svc.cluster.local/application/o/gitlab/"
      discovery: false
      uid_field: "preferred_username"
      client_options:
        identifier: "''' + gitlab_oidc_client_id + '''"
        secret: "''' + gitlab_oidc_client_secret + '''"
        redirect_uri: "https://''' + ts_host + '''/users/auth/openid_connect/callback"
        authorization_endpoint: "https://''' + ts_host + ''':8443/application/o/authorize/"
        token_endpoint: "http://authentik-server.authentik.svc.cluster.local/application/o/token/"
        userinfo_endpoint: "http://authentik-server.authentik.svc.cluster.local/application/o/userinfo/"
        jwks_uri: "http://authentik-server.authentik.svc.cluster.local/application/o/gitlab/jwks/"
'''))

# ponytail: dev-fixed creds matching minio's Tiltfile (helm/minio/Tiltfile's
# minio_root_password) — GitLab talks to MinIO's S3 API purely server-to-
# server via in-cluster Service DNS, no browser involved, so no tailscale/
# ingress hostname juggling needed here (unlike the OIDC provider above).
minio_root_password = os.getenv('TF_VAR_minio_root_password', 'dev-minio-root-password')

k8s_yaml(blob('''apiVersion: v1
kind: Secret
metadata:
  name: gitlab-object-storage
  namespace: gitlab
stringData:
  connection: |
    provider: AWS
    region: us-east-1
    endpoint: http://minio.minio.svc.cluster.local:9000
    path_style: true
    aws_access_key_id: admin
    aws_secret_access_key: ''' + minio_root_password + '''
'''))

# ponytail: gitlab-runner distributed cache -> MinIO S3. Runner subchart's
# cache secret expects literal keys accesskey/secretkey (not the fog YAML
# blob above). Reuses minio root creds like gitlab-object-storage does.
k8s_yaml(blob('''apiVersion: v1
kind: Secret
metadata:
  name: gitlab-runner-cache-credentials
  namespace: gitlab
stringData:
  accesskey: admin
  secretkey: ''' + minio_root_password))

k8s_yaml(helm(
  '.',
  name='gitlab',
  namespace='gitlab',
  set=[
    'gitlab.global.initialRootPassword.secret=gitlab-initial-root-password',
    'postgres.password=' + gitlab_db_password,
    # ponytail: GitLab bakes its own external URL into generated links,
    # including the internally-managed "GitLab Web IDE" OAuth app's callback
    # (https://<host>/-/ide/oauth_redirect). The chart has NO non-standard
    # port support here, so GitLab is served on the tailnet's 443 (Tailscale
    # k8s operator, terraform/tailscale-ingress.tf) and only the host needs setting.
    'gitlab.global.hosts.https=true',
    'gitlab.global.hosts.gitlab.name=' + ts_host,
    'gitlab.global.hosts.gitlab.https=true',
    'gitlab.global.appConfig.omniauth.enabled=true',
    'gitlab.global.appConfig.omniauth.blockAutoCreatedUsers=false',
    'gitlab.global.appConfig.omniauth.allowSingleSignOn[0]=openid_connect',
    # ponytail: auto-redirects to Authentik on visiting /users/sign_in instead
    # of showing GitLab's own login form first
    'gitlab.global.appConfig.omniauth.autoSignInWithProvider=openid_connect',
    'gitlab.global.appConfig.omniauth.providers[0].secret=gitlab-omniauth-authentik',
    'gitlab.global.appConfig.omniauth.providers[0].key=provider',
    'gitlab.global.appConfig.object_store.connection.secret=gitlab-object-storage',
    'gitlab.global.appConfig.object_store.connection.key=connection',
  ],
))

k8s_resource(
  'gitlab-webservice-default',
  port_forwards=['8181:8181'],
  resource_deps=['gitlab-helm-deps'],
)

# ponytail: no-op until ADMIN_EMAIL has logged in via SSO at least once
# (creates the GitLab user row) — safe to re-run on every Tilt reload, and
# means the admin promotion survives a full data wipe without a manual
# re-run once the account exists again.
admin_email = os.getenv('TF_VAR_admin_email', 'edwardlimkoksiong1994@gmail.com')
local_resource(
  'gitlab-promote-admin',
  cmd="kubectl exec -i -n gitlab deploy/gitlab-webservice-default -c webservice -- env ADMIN_EMAIL=%s sh < promote-admin.sh" % admin_email,
  deps=['promote-admin.sh'],
  resource_deps=['gitlab-webservice-default'],
)

# ponytail: GitLab 18 dropped runner registration tokens. Mint a modern
# glrt- authentication token, write it into gitlab-gitlab-runner-secret, and
# restart the runner. Idempotent; the runner may crashloop for a minute
# before this lands on the first deploy.
local_resource(
  'gitlab-runner-auth-token',
  cmd='bash setup-runner-token.sh',
  deps=['setup-runner-token.sh', 'runner-auth-token.sh'],
  # ponytail: only webservice — NOT gitlab-gitlab-runner. The runner can't
  # become ready until this step gives it a token, so depending on it
  # deadlocks.
  resource_deps=['gitlab-webservice-default'],
)
