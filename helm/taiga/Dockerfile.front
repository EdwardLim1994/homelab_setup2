# ponytail: taiga-front has no built-in OIDC login button — that lives in
# taiga-contrib-oidc-auth's separate front/ plugin (old gulp4/jade/coffee
# toolchain, still builds clean on node:16 — verified). conf.json's
# oidcMountPoint alone (what back.yaml's plugin README implied) only points
# an already-visible button at the right URL; the button itself only
# exists once this plugin bundle is copied into dist/plugins/oidc-auth and
# listed in conf.json's contribPlugins (see templates/front.yaml).
FROM node:16-alpine AS builder
RUN apk add --no-cache git
RUN git clone --depth 1 https://github.com/taigaio/taiga-contrib-oidc-auth.git /src
WORKDIR /src/front
RUN npm install && npx gulp build

FROM taigaio/taiga-front:latest
COPY --from=builder /src/front/dist /usr/share/nginx/html/plugins/oidc-auth
