function fromEnv(name: string, fallback?: string): string {
  const value = process.env[name] ?? fallback;
  if (!value) throw new Error(`Missing required env var: ${name}`);
  return value;
}

/**
 * Base URLs of every API the suite talks to. `HEAD /` on each must be reachable
 * before the suite runs (see tests/setup.ts).
 */
export const config = {
  services: {
    api: fromEnv('API_BASE_URL', 'http://localhost:3000'),
    // add downstream services the API depends on, e.g.:
    // downstream: fromEnv('DOWNSTREAM_API_URL', 'http://localhost:4000'),
  },
} as const;
