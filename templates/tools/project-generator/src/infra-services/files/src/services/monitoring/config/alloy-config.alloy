discovery.kubernetes "pods" {
	role = "pod"
}

discovery.relabel "pods" {
	targets = discovery.kubernetes.pods.targets

	// Only the namespaces this stack's own services/apps land in (see root CLAUDE.md) —
	// kube-system/etc. would otherwise flood Loki with nothing any dashboard here queries.
	rule {
		source_labels = ["__meta_kubernetes_namespace"]
		regex         = "infra|server-apps|server-infra"
		action        = "keep"
	}

	rule {
		source_labels = ["__meta_kubernetes_namespace"]
		target_label  = "namespace"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_name"]
		target_label  = "pod"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_container_name"]
		target_label  = "container"
	}
	// Standard kubelet log path: /var/log/pods/<namespace>_<pod>_<uid>/<container>/*.log — the
	// glob only needs the uid+container suffix to be unique, no need to also match the
	// namespace_pod prefix segment by hand.
	rule {
		source_labels = ["__meta_kubernetes_pod_uid", "__meta_kubernetes_pod_container_name"]
		separator     = "/"
		target_label  = "__path__"
		replacement   = "/var/log/pods/*$1/*.log"
	}
}

local.file_match "pods" {
	path_targets = discovery.relabel.pods.output
}

loki.source.file "pods" {
	targets    = local.file_match.pods.targets
	forward_to = [loki.process.pods.receiver]
}

loki.process "pods" {
	forward_to = [loki.write.default.receiver]

	// CRI log lines are "<time> <stream> <flags> <message>" — this stage splits that into
	// .stream (stdout/stderr) and .output (the actual message) for the stages below.
	stage.cri { }

	// No app in this repo writes structured/leveled logs yet (console.log/console.error only —
	// see packages/server's own driver/plugin code) — stderr vs stdout is the only signal
	// available today, so that's the info/error baseline. Upgrade to a real "warn" vs "error"
	// split once anything adopts structured logging; until then this is a best-effort label,
	// not a guarantee.
	stage.template {
		source   = "level"
		template = "{{ if eq .stream \"stderr\" }}error{{ else }}info{{ end }}"
	}

	// Promotes anything that already happens to mention "warn" (case-insensitive) in its own
	// message text to a distinct "warning" level, regardless of which stream it came from —
	// covers the day something does start writing real WARN-prefixed lines without waiting on
	// a structured-logging migration first.
	stage.regex {
		expression = "(?i)(?P<iswarn>warn)"
		source     = "output"
	}

	stage.template {
		source   = "level"
		template = "{{ if .iswarn }}warning{{ else }}{{ .level }}{{ end }}"
	}

	stage.labels {
		values = {
			level = null,
		}
	}
}

loki.write "default" {
	endpoint {
		url = "http://loki:3100/loki/api/v1/push"
	}
}
