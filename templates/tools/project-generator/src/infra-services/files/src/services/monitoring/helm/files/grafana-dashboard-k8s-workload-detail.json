{
  "title": "Service detail: $app",
  "uid": "k8s-workload-detail",
  "editable": true,
  "timezone": "browser",
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "30s",
  "schemaVersion": 39,
  "templating": {
    "list": [
      {
        "name": "namespace",
        "type": "textbox",
        "label": "Namespace",
        "current": { "text": "infra", "value": "infra" },
        "query": "infra"
      },
      {
        "name": "app",
        "type": "textbox",
        "label": "Service",
        "current": { "text": "", "value": "" },
        "query": ""
      },
      {
        "name": "level",
        "type": "custom",
        "label": "Log level",
        "multi": true,
        "includeAll": true,
        "options": [
          { "text": "All", "value": "$__all", "selected": true },
          { "text": "info", "value": "info" },
          { "text": "warning", "value": "warning" },
          { "text": "error", "value": "error" }
        ],
        "current": { "text": "All", "value": ["$__all"] },
        "query": "info,warning,error"
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Pods ready",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum(kube_pod_status_ready{namespace=\"$namespace\", condition=\"true\", pod=~\"^$app-.*\"})", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": { "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        }
      }
    },
    {
      "type": "stat",
      "title": "Pods not ready",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum(kube_pod_status_ready{namespace=\"$namespace\", condition=\"false\", pod=~\"^$app-.*\"}) or vector(0)", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Restarts (rate, 15m)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (pod) (rate(kube_pod_container_status_restarts_total{namespace=\"$namespace\", pod=~\"^$app-.*\"}[15m]))",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ]
    },
    { "type": "row", "title": "Resource usage", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 8 } },
    {
      "type": "timeseries",
      "title": "CPU usage by pod",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "targets": [
        {
          "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"$namespace\", pod=~\"^$app-.*\", container!=\"\", container!=\"POD\"}[5m]))",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Memory usage by pod",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "targets": [
        {
          "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"$namespace\", pod=~\"^$app-.*\", container!=\"\", container!=\"POD\"})",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "table",
      "title": "up{job=~\".*$app.*\"} — matching app-level Prometheus jobs, if any",
      "description": "Catches services with their own dedicated scrape job (e.g. kafka, meilisearch) whose job name happens to contain this service's name.",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "up{job=~\".*$app.*\"}", "format": "table", "instant": true, "refId": "A" }],
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true, "__name__": true } } }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "down", "color": "red" }, "1": { "text": "up", "color": "green" } } }
          ],
          "custom": { "cellOptions": { "type": "color-background" } }
        }
      }
    },
    {
      "type": "row",
      "title": "Requests & traces (OtelPlugin)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 24 }
    },
    {
      "type": "text",
      "title": "",
      "gridPos": { "h": 2, "w": 24, "x": 0, "y": 25 },
      "options": {
        "mode": "markdown",
        "content": "Empty panels below mean this service either doesn't have OtelPlugin wired (see packages/server/src/plugin/OtelPlugin.ts — opt-in per server, added via `.plugins([...])`), or has received no traffic yet. These are span-derived RED metrics (Tempo's metrics_generator, see services/monitoring/helm/files/tempo.yaml), not from GrpcInstrumentation/GraphQLInstrumentation's automatic hooks — those don't reliably patch anything under Bun. Spans instead come from packages/server/src/otel-span.ts's manual withServerSpan() wrapper in GrpcRouter/GraphqlRouter."
      }
    },
    {
      "type": "timeseries",
      "title": "Request rate (by span)",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 27 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [
        {
          "expr": "sum by (span_name) (rate(traces_spanmetrics_calls_total{service=\"$app\"}[5m]))",
          "legendFormat": "{{span_name}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Error rate (by span)",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 27 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [
        {
          "expr": "sum by (span_name) (rate(traces_spanmetrics_calls_total{service=\"$app\", status_code=\"STATUS_CODE_ERROR\"}[5m]))",
          "legendFormat": "{{span_name}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "p95 latency (by span)",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 27 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, span_name) (rate(traces_spanmetrics_latency_bucket{service=\"$app\"}[5m])))",
          "legendFormat": "{{span_name}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "traces",
      "title": "Recent traces",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 35 },
      "datasource": { "type": "tempo", "uid": "tempo" },
      "targets": [
        {
          "queryType": "traceql",
          "query": "{ resource.service.name = \"$app\" }",
          "limit": 20,
          "refId": "A"
        }
      ]
    },
    { "type": "row", "title": "Logs", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 45 } },
    {
      "type": "logs",
      "title": "Logs ($level)",
      "description": "info/error come from stdout vs stderr (alloy-config.alloy's stage.cri) — no app here writes leveled logs yet, so this is a best-effort split, not a guarantee. Anything whose own message text contains \"warn\" is promoted to warning regardless of stream.",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 46 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      },
      "targets": [
        {
          "expr": "{namespace=\"$namespace\", pod=~\"^$app-.*\"} | level=~\"${level:regex}\"",
          "refId": "A"
        }
      ]
    }
  ]
}
