# Copy to .env and fill in. `.env` is gitignored — it's the single source of
# truth for both `tilt up` and `terraform apply`:
#   set -a; source .env; set +a; tilt up
#   set -a; source .env; set +a; terraform -chdir=terraform apply
#
# TF_VAR_ prefix is required even for Tilt's variables — Terraform only
# picks up env vars with that prefix automatically, and Tiltfiles read the
# same names via os.getenv() so both tools share one file.
#
# Everything below is a throwaway dev-cluster value except the two marked
# REAL — those are genuine external credentials, keep them out of git.

# --- cluster bootstrap (scripts/{linux,windows}/create-cluster only, no TF_VAR_ prefix) ---
K3D_CLUSTER_NAME=internal
K3D_STORAGE_PATH=./k3d-storage
TS_HOST=                        # your-machine.tail60240b.ts.net (per-device, no quotes)
TF_VAR_ts_host=                 # same value as TS_HOST — terraform reads TF_VAR_ prefix
TF_VAR_bash_bin=                # blank = auto-detect Git Bash; set only if it's not at the default Windows path

# --- tailscale k8s operator (apps reachable at <app>.<tailnet_domain>) ---
TF_VAR_tailnet_domain=                    # e.g. tail60240b.ts.net — blank = derived from ts_host
TF_VAR_tailscale_oauth_client_id=        # admin console -> Settings -> OAuth clients
TF_VAR_tailscale_oauth_client_secret=    # scopes: Devices/Core=write, Keys/Auth Keys=write; tag:k8s-operator

# --- authentik ---
TF_VAR_authentik_secret_key=dev-authentik-secret-key-not-for-prod-use
TF_VAR_authentik_db_password=dev-authentik-db-password
TF_VAR_authentik_bootstrap_token=dev-authentik-bootstrap-token-not-for-prod-use
TF_VAR_authentik_bootstrap_password=Admin1234!
# REAL — GitHub OAuth App used for Authentik's own admin login
TF_VAR_github_oauth_client_id=changeme
TF_VAR_github_oauth_client_secret=changeme
TF_VAR_admin_email=edwardlimkoksiong1994@gmail.com

# --- gitlab ---
TF_VAR_gitlab_root_password=dev-gitlab-root-password
TF_VAR_gitlab_db_password=dev-gitlab-db-password
TF_VAR_gitlab_oidc_client_id=dev-gitlab-oidc-client-id
TF_VAR_gitlab_oidc_client_secret=dev-gitlab-oidc-client-secret-not-for-prod-use

# --- minio ---
TF_VAR_minio_root_password=dev-minio-root-password
TF_VAR_minio_oidc_client_id=dev-minio-oidc-client-id
TF_VAR_minio_oidc_client_secret=dev-minio-oidc-client-secret-not-for-prod-use

# --- n8n ---
TF_VAR_n8n_encryption_key=dev-n8n-encryption-key-not-for-prod-use
TF_VAR_n8n_oidc_client_id=dev-n8n-oidc-client-id
TF_VAR_n8n_oidc_client_secret=dev-n8n-oidc-client-secret-not-for-prod-use
# Create once in n8n: Settings -> API Keys. Empty = SDLC flows not auto-seeded.
TF_VAR_n8n_api_key=
TF_VAR_n8n_db_password=dev-n8n-db-password-not-for-prod-use
# owner account the ansible n8n.yml playbook creates (email = admin_email).
# n8n requires an uppercase letter + a digit.
TF_VAR_n8n_owner_password=Homelab-n8n-Dev-2026

# --- sonarqube ---
TF_VAR_sonarqube_db_password=dev-sonarqube-db-password
TF_VAR_sonarqube_monitoring_passcode=dev-sonarqube-monitoring-passcode
TF_VAR_sonarqube_oidc_client_id=dev-sonarqube-oidc-client-id
TF_VAR_sonarqube_oidc_client_secret=dev-sonarqube-oidc-client-secret-not-for-prod-use

# --- nextcloud ---
TF_VAR_nextcloud_db_password=dev-nextcloud-db-password
TF_VAR_nextcloud_db_root_password=dev-nextcloud-db-root-password
TF_VAR_nextcloud_admin_password=dev-nextcloud-admin-password
TF_VAR_nextcloud_oidc_client_id=dev-nextcloud-oidc-client-id
TF_VAR_nextcloud_oidc_client_secret=dev-nextcloud-oidc-client-secret-not-for-prod-use

# --- argocd ---
TF_VAR_argocd_oidc_client_id=dev-argocd-oidc-client-id
TF_VAR_argocd_oidc_client_secret=dev-argocd-oidc-client-secret-not-for-prod-use
TF_VAR_argocd_server_secret_key=dev-argocd-server-secret-key-not-for-prod-use

# --- observability (grafana / loki / tempo / mimir / alloy / prometheus) ---
TF_VAR_grafana_admin_password=dev-grafana-admin-password
TF_VAR_grafana_oidc_client_id=dev-grafana-oidc-client-id
TF_VAR_grafana_oidc_client_secret=dev-grafana-oidc-client-secret-not-for-prod-use

# --- openwebui ---
TF_VAR_openwebui_oidc_client_id=dev-openwebui-oidc-client-id
TF_VAR_openwebui_oidc_client_secret=dev-openwebui-oidc-client-secret-not-for-prod-use

# --- litellm ---
TF_VAR_litellm_oidc_client_id=dev-litellm-oidc-client-id
TF_VAR_litellm_oidc_client_secret=dev-litellm-oidc-client-secret-not-for-prod-use
TF_VAR_litellm_master_key=sk-dev-litellm-master-key-not-for-prod-use
TF_VAR_litellm_salt_key=sk-dev-litellm-salt-key-not-for-prod-use
TF_VAR_litellm_db_password=dev-litellm-db-password

# --- mcp-servers ---
# REAL — these 3 are per-app tokens generated from the target app's own UI,
# no dev-fixed value makes sense. Server pods boot fine with them blank
# (except gitlab, which hard-refuses to start) but every tool call 401s
# until set.
#   grafana:   Grafana > Administration > Service accounts > Add service account token
#   sonarqube: SonarQube > My Account > Security > Generate Token
#   gitlab:    GitLab > Edit profile > Access Tokens (scope: api)
#   playwright: no token — it's local browser automation (own headless
#              Chromium), nothing external to authenticate against
TF_VAR_grafana_mcp_token=
TF_VAR_sonarqube_mcp_token=
TF_VAR_gitlab_mcp_token=
# not a real credential — just a bearer token this repo invents, clients
# must send it to call the gitlab MCP server over HTTP
TF_VAR_gitlab_mcp_auth_token=dev-gitlab-mcp-auth-token

# --- omp (oh-my-pi) ---
# REAL — long-lived Claude Code OAuth token for the omp pods when they
# run the `claude` CLI instead of `omp`. Generate on your machine with
#   claude setup-token
# (needs a Pro/Max subscription; ~1yr, revocable). Injected into every
# omp pod as CLAUDE_CODE_OAUTH_TOKEN via the omp-claude-auth Secret.
# Blank = pods still start, `claude` just has no auth.
TF_VAR_claude_code_token=
# REAL — GitLab token (scope: api) pushed into every omp pod by the
# ansible omp.yml playbook. Blank = omp has no GitLab access.
TF_VAR_omp_gitlab_token=
