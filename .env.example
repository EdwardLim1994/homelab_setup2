# Copy to .env and fill in. `.env` is gitignored — it's the single source of
# truth for `terraform apply`:
#   set -a; source .env; set +a; terraform -chdir=terraform apply
#
# TF_VAR_ prefix is required — Terraform only picks up env vars with that
# prefix automatically.
#
# Every value below is left blank on purpose — fill in a real value for
# anything marked REAL or BOOTSTRAP; everything else is a dev-cluster
# password Terraform is happy to receive empty too (Authentik providers are
# provisioned automatically regardless of value chosen), but pick something
# non-empty if you don't want blank passwords on the deployed apps.
# This file only lists what an actual working setup needs to touch;
# terraform/variables.tf is the full list with every default (nextcloud,
# grafana, litellm, gitlab-webhook, ... — fine unset). See README.md for how
# to generate each REAL credential and the bootstrap-once API keys (n8n,
# openwebui, taiga).

# --- cluster bootstrap (scripts/{linux,windows}/create-cluster only) ---
K3D_CLUSTER_NAME=internal
TS_HOST=                        # your-machine.tail60240b.ts.net (per-device, no quotes)

# --- tailscale k8s operator (apps reachable at <app>.<tailnet_domain>) ---
TF_VAR_tailscale_oauth_client_id=       # admin console -> Settings -> OAuth clients
TF_VAR_tailscale_oauth_client_secret=   # scopes: Devices/Core=write, Keys/Auth Keys=write, Services=write; tag:k8s-operator

# --- shared postgres (authentik / gitlab / litellm / n8n / sonarqube) ---
TF_VAR_shared_db_password=

# --- authentik ---
TF_VAR_authentik_secret_key=
TF_VAR_authentik_bootstrap_token=
TF_VAR_authentik_bootstrap_password=
# REAL — GitHub OAuth App used for Authentik's own admin login
TF_VAR_github_oauth_client_id=
TF_VAR_github_oauth_client_secret=
TF_VAR_admin_email=

# --- gitlab ---
TF_VAR_gitlab_root_password=
TF_VAR_gitlab_oidc_client_id=
TF_VAR_gitlab_oidc_client_secret=
# REAL — GitLab PAT, scope api. Powers the gitlab MCP server (hard-refuses to
# start without it) and is reused as omp_gitlab_token below.
TF_VAR_gitlab_mcp_token=

# --- minio ---
TF_VAR_minio_root_password=
TF_VAR_minio_oidc_client_id=
TF_VAR_minio_oidc_client_secret=

# --- n8n ---
TF_VAR_n8n_encryption_key=
TF_VAR_n8n_oidc_client_id=
TF_VAR_n8n_oidc_client_secret=
# n8n requires an uppercase letter + a digit.
TF_VAR_n8n_owner_password=
# BOOTSTRAP — leave blank on first run; playbooks/n8n.yml mints one and
# prints it, paste it here so later runs reuse it instead of minting again.
TF_VAR_n8n_mcp_api_key=

# --- argocd ---
# REAL — minted via /api/v1/account/admin/token after argocd-cm
# accounts.admin: "apiKey, login" (ArgoCD must already be up).
TF_VAR_argocd_token=

# --- sonarqube ---
TF_VAR_sonarqube_monitoring_passcode=
TF_VAR_sonarqube_oidc_client_id=
TF_VAR_sonarqube_oidc_client_secret=
# REAL — SonarQube user token (My Account > Security > Generate Token).
TF_VAR_sonarqube_mcp_token=

# --- kafka-ui (kafbat), views sit/uat/production's kafka ---
TF_VAR_kafka_ui_oidc_client_id=
TF_VAR_kafka_ui_oidc_client_secret=

# --- harbor (container registry, replaces gitlab-registry) ---
TF_VAR_harbor_admin_password=
TF_VAR_harbor_oidc_client_id=
TF_VAR_harbor_oidc_client_secret=

# --- taiga (ticket/wiki tracker, replaces gitlab issues+wiki for SDLC flows) ---
TF_VAR_taiga_admin_password=
TF_VAR_taiga_secret_key=
TF_VAR_taiga_rabbitmq_password=
TF_VAR_taiga_oidc_client_id=
TF_VAR_taiga_oidc_client_secret=
# BOOTSTRAP — leave blank on first run; log into Taiga via the browser (SSO),
# user settings -> generate an API token (admin user), paste here.
TF_VAR_taiga_api_token=
# per-caller bearer for the taiga MCP server (invented, not a real credential
# — same pattern as gitlab_mcp_auth_token/n8n_mcp_auth_token).
TF_VAR_taiga_mcp_auth_token=

TF_VAR_ts_host=                 # same value as TS_HOST — terraform reads the TF_VAR_ prefix

# --- omp (oh-my-pi) coding-agent pods ---
# REAL — long-lived Claude Code OAuth token for the `claude` CLI inside omp
# pods. Generate on your machine with `claude setup-token` (needs Pro/Max).
TF_VAR_claude_code_token=
# REAL — GitLab PAT (scope api), pushed into every omp pod for `glab`/git
# clone. Fine to reuse the same value as gitlab_mcp_token above.
TF_VAR_omp_gitlab_token=

# --- openwebui ---
# BOOTSTRAP — leave blank on first run; log into OpenWebUI via the browser
# (SSO), Settings -> Account -> API Keys -> generate one, paste here.
TF_VAR_openwebui_api_key=

# --- terraform/sit, terraform/uat, terraform/production platform apps ---
# (authentik/unleash/vault/kafka/meilisearch/minio/apicurio-registry — one
# secret set reused across all 3 phase clusters, see terraform/modules/platform-apps)
TF_VAR_phase_authentik_secret_key=
TF_VAR_phase_authentik_bootstrap_token=
TF_VAR_phase_authentik_bootstrap_password=
TF_VAR_phase_shared_db_password=
TF_VAR_phase_unleash_admin_password=
TF_VAR_phase_vault_root_token=
TF_VAR_phase_meilisearch_master_key=
TF_VAR_phase_minio_root_password=
