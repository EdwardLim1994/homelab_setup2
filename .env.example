# Copy to .env and fill in. `.env` is gitignored — it's the single source of
# truth for both `tilt up` and `terraform apply`:
#   set -a; source .env; set +a; tilt up
#   set -a; source .env; set +a; terraform -chdir=terraform apply
#
# TF_VAR_ prefix is required even for Tilt's variables — Terraform only
# picks up env vars with that prefix automatically, and Tiltfiles read the
# same names via os.getenv() so both tools share one file.
#
# Everything below is a throwaway dev-cluster value except the two marked
# REAL — those are genuine external credentials, keep them out of git.

# --- cluster bootstrap (scripts/create-cluster.sh only, no TF_VAR_ prefix) ---
K3D_CLUSTER_NAME=internal
K3D_STORAGE_PATH=./k3d-storage

# --- authentik ---
TF_VAR_authentik_secret_key=dev-authentik-secret-key-not-for-prod-use
TF_VAR_authentik_db_password=dev-authentik-db-password
TF_VAR_authentik_bootstrap_token=dev-authentik-bootstrap-token-not-for-prod-use
TF_VAR_authentik_bootstrap_password=Admin1234!
# REAL — GitHub OAuth App used for Authentik's own admin login
TF_VAR_github_oauth_client_id=changeme
TF_VAR_github_oauth_client_secret=changeme
TF_VAR_admin_email=edwardlimkoksiong1994@gmail.com

# --- gitlab ---
TF_VAR_gitlab_root_password=dev-gitlab-root-password
TF_VAR_gitlab_db_password=dev-gitlab-db-password
TF_VAR_gitlab_oidc_client_id=dev-gitlab-oidc-client-id
TF_VAR_gitlab_oidc_client_secret=dev-gitlab-oidc-client-secret-not-for-prod-use

# --- minio ---
TF_VAR_minio_root_password=dev-minio-root-password
TF_VAR_minio_oidc_client_id=dev-minio-oidc-client-id
TF_VAR_minio_oidc_client_secret=dev-minio-oidc-client-secret-not-for-prod-use

# --- n8n ---
TF_VAR_n8n_encryption_key=dev-n8n-encryption-key-not-for-prod-use
TF_VAR_n8n_oidc_client_id=dev-n8n-oidc-client-id
TF_VAR_n8n_oidc_client_secret=dev-n8n-oidc-client-secret-not-for-prod-use

# --- sonarqube ---
TF_VAR_sonarqube_db_password=dev-sonarqube-db-password
TF_VAR_sonarqube_monitoring_passcode=dev-sonarqube-monitoring-passcode
TF_VAR_sonarqube_oidc_client_id=dev-sonarqube-oidc-client-id
TF_VAR_sonarqube_oidc_client_secret=dev-sonarqube-oidc-client-secret-not-for-prod-use

# --- seafile ---
TF_VAR_seafile_db_password=dev-seafile-db-password
TF_VAR_seafile_db_root_password=dev-seafile-db-root-password
TF_VAR_seafile_admin_password=dev-seafile-admin-password
TF_VAR_seafile_oidc_client_id=dev-seafile-oidc-client-id
TF_VAR_seafile_oidc_client_secret=dev-seafile-oidc-client-secret-not-for-prod-use
TF_VAR_seafile_jwt_private_key=dev-seafile-jwt-private-key-not-for-prod-use
