# Copy to .env and fill in. `.env` is gitignored — it's the single source of
# truth for both `tilt up` and `terraform apply`:
#   set -a; source .env; set +a; tilt up
#   set -a; source .env; set +a; terraform -chdir=terraform apply
#
# TF_VAR_ prefix is required even for Tilt's variables — Terraform only picks
# up env vars with that prefix automatically, and the Tiltfiles read the same
# names via os.getenv() so both tools share one file.
#
# Every value below is a throwaway dev-cluster placeholder except the ones
# marked REAL — those are genuine external credentials, keep them out of git.
# You can delete any line whose default you're keeping; terraform falls back
# to the same value from terraform/variables.tf.

# --- cluster bootstrap (scripts/{linux,windows}/create-cluster only) ---
K3D_CLUSTER_NAME=internal
# TF_VAR_kube_context — leave unset: defaults to "k3d-internal" (matches
# K3D_CLUSTER_NAME=internal). Set only for a differently-named cluster.
#TF_VAR_kube_context=k3d-internal
# K3D_STORAGE_PATH — leave unset: defaults to <repo-root>/k3d-storage. Set only
# to relocate the PV bind-mount; a relative value resolves against the repo root.
TS_HOST=                        # your-machine.tail60240b.ts.net (per-device, no quotes)
TF_VAR_ts_host=                 # same value as TS_HOST — terraform reads the TF_VAR_ prefix
TF_VAR_bash_bin=                # blank = auto-detect Git Bash; set only if it's elsewhere

# --- tailscale k8s operator (apps reachable at <app>.<tailnet_domain>) ---
TF_VAR_tailnet_domain=                  # e.g. tail60240b.ts.net — blank = derived from ts_host
TF_VAR_tailscale_oauth_client_id=       # admin console -> Settings -> OAuth clients
TF_VAR_tailscale_oauth_client_secret=   # scopes: Devices/Core=write, Keys/Auth Keys=write, Services=write; tag:k8s-operator

# --- shared postgres + redis ---
# one role+db per app on the single shared postgres pod (authentik / gitlab /
# litellm / n8n / sonarqube). nextcloud keeps its own MariaDB;
# authentik + gitlab share the single redis pod (different logical DBs).
TF_VAR_shared_db_password=dev-shared-db-password-not-for-prod-use

# --- authentik ---
TF_VAR_authentik_secret_key=dev-authentik-secret-key-not-for-prod-use
TF_VAR_authentik_bootstrap_token=dev-authentik-bootstrap-token-not-for-prod-use
TF_VAR_authentik_bootstrap_password=Admin1234!
# REAL — GitHub OAuth App used for Authentik's own admin login
TF_VAR_github_oauth_client_id=changeme
TF_VAR_github_oauth_client_secret=changeme
TF_VAR_admin_email=you@example.com

# --- gitlab ---
# GitLab rejects weak first-admin passwords ("commonly used combinations") —
# use a random string, not dictionary words.
TF_VAR_gitlab_root_password=dev-gitlab-root-password-change-me
TF_VAR_gitlab_oidc_client_id=dev-gitlab-oidc-client-id
TF_VAR_gitlab_oidc_client_secret=dev-gitlab-oidc-client-secret-not-for-prod-use
# REAL — GitLab PAT, scope api. Powers the gitlab MCP server (which hard-refuses
# to start without it). Create: GitLab > Edit profile > Access Tokens.
TF_VAR_gitlab_mcp_token=

# --- minio ---
TF_VAR_minio_root_password=dev-minio-root-password
TF_VAR_minio_oidc_client_id=dev-minio-oidc-client-id
TF_VAR_minio_oidc_client_secret=dev-minio-oidc-client-secret-not-for-prod-use

# --- n8n ---
TF_VAR_n8n_encryption_key=dev-n8n-encryption-key-not-for-prod-use
TF_VAR_n8n_oidc_client_id=dev-n8n-oidc-client-id
TF_VAR_n8n_oidc_client_secret=dev-n8n-oidc-client-secret-not-for-prod-use
# owner account the ansible n8n.yml playbook creates (email = admin_email);
# n8n requires an uppercase letter + a digit.
TF_VAR_n8n_owner_password=Homelab-n8n-Dev-2026
# bearer the n8n MCP server (mcp-servers-n8n) checks; this repo invents it.
TF_VAR_n8n_mcp_auth_token=dev-n8n-mcp-auth-token-not-for-prod-use-000
# n8n's own API key (mcp-servers-n8n's N8N_API_KEY, calls INTO n8n) — leave
# blank on first run; playbooks/n8n.yml mints one and prints it, paste it
# here so future runs reuse it instead of minting a new key every time.
TF_VAR_n8n_mcp_api_key=

# --- sonarqube ---
TF_VAR_sonarqube_monitoring_passcode=dev-sonarqube-monitoring-passcode
TF_VAR_sonarqube_oidc_client_id=dev-sonarqube-oidc-client-id
TF_VAR_sonarqube_oidc_client_secret=dev-sonarqube-oidc-client-secret-not-for-prod-use
# REAL — SonarQube user token (My Account > Security > Generate Token). The
# sonarqube MCP server boots without it but every tool call 401s.
TF_VAR_sonarqube_mcp_token=

# --- nextcloud (own MariaDB) ---
TF_VAR_nextcloud_db_password=dev-nextcloud-db-password
TF_VAR_nextcloud_db_root_password=dev-nextcloud-db-root-password
TF_VAR_nextcloud_admin_password=dev-nextcloud-admin-password
TF_VAR_nextcloud_oidc_client_id=dev-nextcloud-oidc-client-id
TF_VAR_nextcloud_oidc_client_secret=dev-nextcloud-oidc-client-secret-not-for-prod-use

# --- argocd ---
TF_VAR_argocd_oidc_client_id=dev-argocd-oidc-client-id
TF_VAR_argocd_oidc_client_secret=dev-argocd-oidc-client-secret-not-for-prod-use
TF_VAR_argocd_server_secret_key=dev-argocd-server-secret-key-not-for-prod-use

# --- observability (grafana / loki / tempo / mimir / alloy / prometheus) ---
TF_VAR_grafana_admin_password=dev-grafana-admin-password
TF_VAR_grafana_oidc_client_id=dev-grafana-oidc-client-id
TF_VAR_grafana_oidc_client_secret=dev-grafana-oidc-client-secret-not-for-prod-use
# REAL — Grafana service-account token (Administration > Service accounts).
# The grafana MCP server boots without it but every tool call 401s.
TF_VAR_grafana_mcp_token=

# --- litellm ---
TF_VAR_litellm_oidc_client_id=dev-litellm-oidc-client-id
TF_VAR_litellm_oidc_client_secret=dev-litellm-oidc-client-secret-not-for-prod-use
TF_VAR_litellm_master_key=sk-dev-litellm-master-key-not-for-prod-use
TF_VAR_litellm_salt_key=sk-dev-litellm-salt-key-not-for-prod-use

# --- openwebui ---
TF_VAR_openwebui_oidc_client_id=dev-openwebui-oidc-client-id
TF_VAR_openwebui_oidc_client_secret=dev-openwebui-oidc-client-secret-not-for-prod-use

# --- mcp-servers (bearer tokens this repo invents; playwright needs none) ---
TF_VAR_gitlab_mcp_auth_token=dev-gitlab-mcp-auth-token

# --- omp (oh-my-pi) coding-agent pods ---
# REAL — long-lived Claude Code OAuth token for the `claude` CLI inside omp
# pods. Generate on your machine with `claude setup-token` (needs Pro/Max,
# ~1yr, revocable). Blank = pods still start, omp-via-Ollama still works.
TF_VAR_claude_code_token=
# REAL — GitLab PAT (scope api) pushed into every omp pod by playbooks/omp.yml
# so `glab` / git clone work. Blank = omp has no GitLab access.
TF_VAR_omp_gitlab_token=
# REAL — clone URL of microservice-rnd1, e.g.
# https://gitlab.<ts_host>/group/microservice-rnd1.git — used by omp-agent
# Job pods' git-clone init container.
TF_VAR_omp_gitlab_repo_url=

# --- gitlab -> n8n SDLC webhook (playbooks/gitlab-webhook.yml) ---
# Shared secret F-00 checks against the X-GitLab-Token header. The playbook
# mints its own GitLab PAT via rails, so no api token is needed here.
TF_VAR_gitlab_webhook_secret=dev-gitlab-webhook-secret-not-for-prod-use
# Group to hook (id or path). Blank = the `sdlc` group, created if missing.
TF_VAR_gitlab_group_id=
